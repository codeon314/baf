// Advance to next page if more pages remain                    if (page \u003C totalPagesToScrape \u0026\u0026 definition.EnablePagination)                    {                        bool advanced = false;                        if (!string.IsNullOrWhiteSpace(definition.PaginationSequenceName) \u0026\u0026                            sequenceLookup.TryGetValue(definition.PaginationSequenceName, out var pageSeq))                        {                            await _runner.RunSequenceAsync(client, pageSeq, cancellationToken);                            advanced = true;                        }                        else if (!string.IsNullOrWhiteSpace(definition.NextPageSelector))                        {                            try                            {                                await client.ClickReactElementAsync(definition.NextPageSelector, cancellationToken);                                advanced = true;                            }                            catch                            {                                // Next page element not found or no longer clickable; stop pagination cleanly                                break;                            }                        }                        if (!advanced)                            break;                        if (definition.PageDelayMs \u003E 0)                        {                            await Task.Delay(definition.PageDelayMs, cancellationToken);                        }                    }                }==== REPLACE                // 1. Run Pre-Scrape Automation Sequence if configured                if (!string.IsNullOrWhiteSpace(definition.PreScrapeSequenceName) \u0026\u0026                    sequenceLookup.TryGetValue(definition.PreScrapeSequenceName, out var preSeq))                {                    string? beforePreLoadId = client.CurrentPageLoadId;                    await _runner.RunSequenceAsync(client, preSeq, cancellationToken);                    await client.WaitForPageTransitionAsync(beforePreLoadId, expectNavigation: false, cancellationToken: cancellationToken);                }                // Ensure initial page is completely loaded                await client.WaitForPageLoadAsync(cancellationToken: cancellationToken);                int totalPagesToScrape = definition.EnablePagination ? Math.Max(1, definition.MaxPages) : 1;                int startPageNum = Math.Max(1, definition.PaginationStartPage);                int pageIncrement = Math.Max(1, definition.PaginationPageIncrement);                // If URL pagination is configured, ensure Page 1 starts on the initial resolved URL                if (definition.EnablePagination \u0026\u0026 !string.IsNullOrWhiteSpace(definition.PaginationUrlPattern))                {                    string firstPageUrl = SelectorHelper.ResolvePaginationUrl(definition.PaginationUrlPattern, startPageNum);                    if (!string.IsNullOrWhiteSpace(firstPageUrl) \u0026\u0026 !IsSamePageUrl(client.CurrentUrl, firstPageUrl))                    {                        await client.NavigateToUrlAsync(firstPageUrl, cancellationToken: cancellationToken);                    }                }                if (definition.WaitBeforeScrapeMs \u003E 0)                {                    await Task.Delay(definition.WaitBeforeScrapeMs, cancellationToken);                }                var seenFingerprints = new HashSet\u003Cstring\u003E();                // 2. Scrape Page Loop                for (int page = 1; page \u003C= totalPagesToScrape; page\u002B\u002B)                {                    cancellationToken.ThrowIfCancellationRequested();                    await client.WaitForPageLoadAsync(cancellationToken: cancellationToken);                    var pageRecords = await ExecuteSinglePageScrapeInternalAsync(client, definition, cancellationToken);                    var addedPageRecords = new List\u003CDictionary\u003Cstring, string?\u003E\u003E();                    foreach (var record in pageRecords)                    {                        if (definition.DeduplicateRows)                        {                            string fp = ScrapeResult.GetRecordFingerprint(record);                            if (!seenFingerprints.Add(fp))                                continue;                        }                        aggregateResult.Records.Add(record);                        addedPageRecords.Add(record);                    }                    aggregateResult.PagesScraped = page;                    OnScrapePageCompleted?.Invoke(this, new ScrapePageEventArgs(definition, page, addedPageRecords));                    // Advance to next page if more pages remain                    if (page \u003C totalPagesToScrape \u0026\u0026 definition.EnablePagination)                    {                        bool advanced = false;                        if (!string.IsNullOrWhiteSpace(definition.PaginationUrlPattern))                        {                            int nextTargetPage = startPageNum \u002B (page * pageIncrement);                            string nextUrl = SelectorHelper.ResolvePaginationUrl(definition.PaginationUrlPattern, nextTargetPage);                            if (!string.IsNullOrWhiteSpace(nextUrl))                            {                                await client.NavigateToUrlAsync(nextUrl, cancellationToken: cancellationToken);                                advanced = true;                            }                        }                        else if (!string.IsNullOrWhiteSpace(definition.PaginationSequenceName) \u0026\u0026                                 sequenceLookup.TryGetValue(definition.PaginationSequenceName, out var pageSeq))                        {                            string? beforePageLoadId = client.CurrentPageLoadId;                            await _runner.RunSequenceAsync(client, pageSeq, cancellationToken);                            await client.WaitForPageTransitionAsync(beforePageLoadId, expectNavigation: false, cancellationToken: cancellationToken);                            advanced = true;                        }                        else if (!string.IsNullOrWhiteSpace(definition.NextPageSelector))                        {                            try                            {                                string? beforePageLoadId = client.CurrentPageLoadId;                                var clickRes = await client.ClickReactElementAsync(definition.NextPageSelector, cancellationToken);                                bool isFullNavigation = clickRes.Output != null \u0026\u0026                                                        clickRes.Output.StartsWith(\u0022Link click executed\u0022, StringComparison.OrdinalIgnoreCase);                                await client.WaitForPageTransitionAsync(beforePageLoadId, expectNavigation: isFullNavigation, cancellationToken: cancellationToken);                                advanced = true;                            }                            catch                            {                                // Next page element not found or no longer clickable; stop pagination cleanly                                break;                            }                        }                        if (!advanced)                            break;                        if (definition.PageDelayMs \u003E 0)                        {                            await Task.Delay(definition.PageDelayMs, cancellationToken);                        }                    }                }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        internal static List\u003CDictionary\u003Cstring, string?\u003E\u003E ParseRecordsFromCommandOutput(string? output)==== REPLACE        private static bool IsSamePageUrl(string? currentUrl, string targetUrl)        {            if (string.IsNullOrWhiteSpace(currentUrl) || string.IsNullOrWhiteSpace(targetUrl))                return false;            if (string.Equals(currentUrl.Trim(), targetUrl.Trim(), StringComparison.OrdinalIgnoreCase))                return true;            if (Uri.TryCreate(currentUrl, UriKind.Absolute, out var currentUri))            {                if (Uri.TryCreate(targetUrl, UriKind.Absolute, out var targetUri))                {                    return Uri.Compare(currentUri, targetUri, UriComponents.HttpRequestUrl, UriFormat.SafeUnescaped, StringComparison.OrdinalIgnoreCase) == 0;                }                if (Uri.TryCreate(currentUri, targetUrl, out var resolvedUri))                {                    return Uri.Compare(currentUri, resolvedUri, UriComponents.HttpRequestUrl, UriFormat.SafeUnescaped, StringComparison.OrdinalIgnoreCase) == 0;                }            }            return false;        }        internal static List\u003CDictionary\u003Cstring, string?\u003E\u003E ParseRecordsFromCommandOutput(string? output)\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Scraping\\ScrapeBuilder.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH        /// \u003Csummary\u003E        /// Enables multi-page scraping using a custom \u003Csee cref=\u0022AutomationSequence\u0022/\u003E to advance pages.        /// \u003C/summary\u003E==== REPLACE        /// \u003Csummary\u003E        /// Enables multi-page scraping by navigating directly to a URL pattern for each page (e.g., \u0022https://example.com/items?page={page}\u0022).        /// \u003C/summary\u003E        public ScrapeBuilder WithUrlPagination(string urlPattern, int maxPages = 5, int startPage = 1, int pageDelayMs = 1000, bool deduplicateRows = false)        {            _definition.EnablePagination = true;            _definition.PaginationUrlPattern = urlPattern;            _definition.PaginationStartPage = startPage;            _definition.MaxPages = maxPages;            _definition.PageDelayMs = pageDelayMs;            _definition.DeduplicateRows = deduplicateRows;            return this;        }        /// \u003Csummary\u003E        /// Enables multi-page scraping using a custom \u003Csee cref=\u0022AutomationSequence\u0022/\u003E to advance pages.        /// \u003C/summary\u003E\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Server\\AutomationServer.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH        private void CleanupStaleClients(object? state)        {            var threshold = DateTime.UtcNow.AddSeconds(-10);            foreach (var kvp in _clients)            {                if (kvp.Value.Mode == IpcMode.HttpPolling \u0026\u0026 kvp.Value.LastSeen \u003C threshold)                {                    if (_clients.TryRemove(kvp.Key, out var removedClient))                    {                        OnClientDisconnected?.Invoke(this, removedClient);                    }                }            }        }==== REPLACE        private void CleanupStaleClients(object? state)        {            var now = DateTime.UtcNow;            var httpThreshold = now.AddSeconds(-10);            var wsThreshold = now.AddSeconds(-15);            foreach (var kvp in _clients)            {                var client = kvp.Value;                bool isStale = (client.Mode == IpcMode.HttpPolling \u0026\u0026 client.LastSeen \u003C httpThreshold) ||                               (client.Mode == IpcMode.WebSocket \u0026\u0026 !client.IsWebSocketConnected \u0026\u0026 client.LastSeen \u003C wsThreshold);                if (isStale)                {                    if (_clients.TryRemove(kvp.Key, out var removedClient))                    {                        OnClientDisconnected?.Invoke(this, removedClient);                    }                }            }        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private async Task HandleWebSocketAsync(HttpListenerContext context, CancellationToken cancellationToken)        {            var wsContext = await context.AcceptWebSocketAsync(null);            var webSocket = wsContext.WebSocket;                        string instanceId = context.Request.QueryString[\u0022instanceId\u0022] ?? Guid.NewGuid().ToString();            var client = new BrowserClient(instanceId, IpcMode.WebSocket, webSocket);            _clients[instanceId] = client;            OnClientConnected?.Invoke(this, client);            var buffer = new byte[1024 * 64];            try            {                while (webSocket.State == WebSocketState.Open \u0026\u0026 !cancellationToken.IsCancellationRequested)                {                    using var ms = new MemoryStream();                    WebSocketReceiveResult result;                                        do                    {                        result = await webSocket.ReceiveAsync(new ArraySegment\u003Cbyte\u003E(buffer), cancellationToken);                        if (result.MessageType == WebSocketMessageType.Close)                        {                            await webSocket.CloseAsync(WebSocketCloseStatus.NormalClosure, \u0022\u0022, cancellationToken);                            break;                        }                        ms.Write(buffer, 0, result.Count);                    } while (!result.EndOfMessage);                    if (result.MessageType == WebSocketMessageType.Close)                        break;                    string message = Encoding.UTF8.GetString(ms.ToArray());                    using var doc = JsonDocument.Parse(message);                    if (doc.RootElement.TryGetProperty(\u0022event\u0022, out _))                    {                        var evt = JsonSerializer.Deserialize\u003CEventMessage\u003E(message);                        if (evt != null)                        {                            client.HandleEvent(evt);                        }                    }                    else                    {                        var cmdResult = JsonSerializer.Deserialize\u003CCommandResult\u003E(message);                        if (cmdResult != null)                        {                            client.HandleResult(cmdResult);                        }                    }                }            }            catch (Exception ex)            {                Console.WriteLine($\u0022[AutomationServer] WebSocket error: {ex.Message}\u0022);            }            finally            {                if (_clients.TryRemove(instanceId, out var removedClient))                {                    OnClientDisconnected?.Invoke(this, removedClient);                }                if (webSocket.State != WebSocketState.Closed \u0026\u0026 webSocket.State != WebSocketState.Aborted)                {                    webSocket.Dispose();                }            }        }==== REPLACE        private async Task HandleWebSocketAsync(HttpListenerContext context, CancellationToken cancellationToken)        {            var wsContext = await context.AcceptWebSocketAsync(null);            var webSocket = wsContext.WebSocket;                        string instanceId = context.Request.QueryString[\u0022instanceId\u0022] ?? Guid.NewGuid().ToString();            bool isNewClient = false;            var client = _clients.GetOrAdd(instanceId, id =\u003E            {                isNewClient = true;                return new BrowserClient(id, IpcMode.WebSocket, webSocket);            });            if (isNewClient)            {                OnClientConnected?.Invoke(this, client);            }            else            {                await client.AttachWebSocketAsync(webSocket, cancellationToken);            }            var buffer = new byte[1024 * 64];            try            {                while (webSocket.State == WebSocketState.Open \u0026\u0026 !cancellationToken.IsCancellationRequested)                {                    using var ms = new MemoryStream();                    WebSocketReceiveResult result;                                        do                    {                        result = await webSocket.ReceiveAsync(new ArraySegment\u003Cbyte\u003E(buffer), cancellationToken);                        if (result.MessageType == WebSocketMessageType.Close)                        {                            await webSocket.CloseAsync(WebSocketCloseStatus.NormalClosure, \u0022\u0022, cancellationToken);                            break;                        }                        ms.Write(buffer, 0, result.Count);                    } while (!result.EndOfMessage);                    if (result.MessageType == WebSocketMessageType.Close)                        break;                    client.LastSeen = DateTime.UtcNow;                    string message = Encoding.UTF8.GetString(ms.ToArray());                    using var doc = JsonDocument.Parse(message);                    if (doc.RootElement.TryGetProperty(\u0022event\u0022, out _))                    {                        var evt = JsonSerializer.Deserialize\u003CEventMessage\u003E(message);                        if (evt != null)                        {                            client.HandleEvent(evt);                        }                    }                    else                    {                        var cmdResult = JsonSerializer.Deserialize\u003CCommandResult\u003E(message);                        if (cmdResult != null)                        {                            client.HandleResult(cmdResult);                        }                    }                }            }            catch (Exception ex)            {                Console.WriteLine($\u0022[AutomationServer] WebSocket error: {ex.Message}\u0022);            }            finally            {                client.DetachWebSocket(webSocket);                if (webSocket.State != WebSocketState.Closed \u0026\u0026 webSocket.State != WebSocketState.Aborted)                {                    webSocket.Dispose();                }            }        }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Server\\BrowserClient.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH        public string InstanceId { get; }        public IpcMode Mode { get; }        public DateTime LastSeen { get; internal set; } = DateTime.UtcNow;                private readonly WebSocket? _webSocket;        private readonly ConcurrentQueue\u003CCommandMessage\u003E _httpCommandQueue = new();        private readonly ConcurrentDictionary\u003Cstring, TaskCompletionSource\u003CCommandResult\u003E\u003E _pendingCommands = new();        /// \u003Csummary\u003E        /// Triggered when the browser script streams partial data back for a long-running task.        /// \u003C/summary\u003E        public event EventHandler\u003CCommandResult\u003E? OnStreamDataReceived;        /// \u003Csummary\u003E        /// Triggered when the browser script sends an event.        /// \u003C/summary\u003E        public event EventHandler\u003CEventMessage\u003E? OnEventReceived;        /// \u003Csummary\u003E        /// Triggered when the page DOM mutates.        /// \u003C/summary\u003E        public event EventHandler\u003CDomChangedEventArgs\u003E? OnDomChanged;        /// \u003Csummary\u003E        /// Triggered when the currently highlighted element is removed from the page DOM.        /// \u003C/summary\u003E        public event EventHandler? OnHighlightedElementRemoved;        /// \u003Csummary\u003E        /// Triggered when an element is selected in the browser via middle-click.        /// \u003C/summary\u003E        public event EventHandler\u003CElementClickedEventArgs\u003E? OnElementClicked;        public BrowserClient(string instanceId, IpcMode mode, WebSocket? webSocket = null)        {            InstanceId = instanceId;            Mode = mode;            _webSocket = webSocket;        }        /// \u003Csummary\u003E        /// Sends a command to the browser and awaits the final result.        /// \u003C/summary\u003E        public async Task\u003CCommandResult\u003E SendCommandAsync(string type, object? payload = null, CancellationToken cancellationToken = default)        {            var cmd = new CommandMessage { Type = type, Payload = payload };            var tcs = new TaskCompletionSource\u003CCommandResult\u003E();            _pendingCommands.TryAdd(cmd.Id, tcs);            if (Mode == IpcMode.WebSocket \u0026\u0026 _webSocket != null \u0026\u0026 _webSocket.State == WebSocketState.Open)            {                var json = JsonSerializer.Serialize(cmd);                var bytes = Encoding.UTF8.GetBytes(json);                await _webSocket.SendAsync(new ArraySegment\u003Cbyte\u003E(bytes), WebSocketMessageType.Text, true, cancellationToken);            }            else if (Mode == IpcMode.HttpPolling)            {                _httpCommandQueue.Enqueue(cmd);            }            else            {                throw new InvalidOperationException(\u0022Client is disconnected or invalid IPC mode.\u0022);            }            await using (cancellationToken.Register(() =\u003E tcs.TrySetCanceled()))            {                return await tcs.Task;            }        }==== REPLACE        public string InstanceId { get; }        public IpcMode Mode { get; }        public DateTime LastSeen { get; internal set; } = DateTime.UtcNow;        public string? CurrentUrl { get; private set; }        public string? CurrentPageLoadId { get; private set; }        internal bool IsWebSocketConnected =\u003E _webSocket != null \u0026\u0026 _webSocket.State == WebSocketState.Open;        private WebSocket? _webSocket;        private readonly SemaphoreSlim _wsSendLock = new(1, 1);        private TaskCompletionSource\u003Cbool\u003E _wsReconnectTcs = new(TaskCreationOptions.RunContinuationsAsynchronously);        private readonl