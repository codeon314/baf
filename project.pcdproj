      "UserPrompt": "The root directory for this project is: C:\\Users\\Devtop1\\Documents\\GitHub\\baf\nThe following directories are currently tracked/active for this project (place new files in these directories unless otherwise specified):\n- C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\n- C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\n\nPlease look over this project and ensure that all the code in the winforms app is strictly a UI wrapper around the dll project. Once you have verified such, look over the dll code and ensure that the entire API is documented.",
      "ModelResponse": "Anti-Agent v1.0\n\n### Summary of Changes\n\n1. **Verified and Tightened WinForms UI Wrapper (\u0060TestBedApp\u0060)**:\n   - Updated \u0060MainForm\u0060 and \u0060DomTreeView\u0060 so that all domain/model operations delegate directly to \u0060BrowserAutomationFramework\u0060:\n     - \u0060DomTreeView.ApplySnapshot\u0060 now delegates expansion state restoration, default root/body expansion, and target ancestor expansion to \u0060DomTreeSnapshot.PrepareExpandedState\u0060.\n     - \u0060MainForm.BtnAddStep_Click\u0060 and \u0060MainForm.BtnAddScrapeField_Click\u0060 now use \u0060AutomationSequence.AddStep\u0060 and \u0060ScrapeDefinition.AddField\u0060.\n     - \u0060MainForm.BtnRunAutomation_Click\u0060, \u0060MainForm.BtnPreviewScrape_Click\u0060, and \u0060MainForm.BtnRunAllScrapes_Click\u0060 now delegate directly to \u0060BrowserClient\u0060 extension methods (\u0060ExecuteProjectAsync\u0060, \u0060ExecuteScrapeAsync\u0060, \u0060ExecuteProjectScrapesCombinedAsync\u0060) and \u0060AutomationProject.GetActiveSequences()\u0060 / \u0060GetActiveScrapes()\u0060.\n     - \u0060MainForm.BuildSiteDumpOptionsFromUi\u0060 and \u0060MainForm.GetActiveDumpViewerText\u0060 now delegate to \u0060SiteDumpOptions.Create\u0060 and \u0060SiteDumpResult.GetViewContent\u0060.\n\n2. **Full XML API Documentation (\u0060BrowserAutomationFramework\u0060)**:\n   - Added complete XML documentation (\u0060\u003Csummary\u003E\u0060, \u0060\u003Cparam\u003E\u0060, \u0060\u003Creturns\u003E\u0060, \u0060\u003Ctypeparam\u003E\u0060) to every public class, struct, enum, enum value, delegate, event, property, constructor, and method across all namespaces (\u0060Automation\u0060, \u0060Extensions\u0060, \u0060Generators\u0060, \u0060Models\u0060, \u0060ReverseEngineering\u0060, \u0060Scraping\u0060, and \u0060Server\u0060).\n   - Removed the \u0060CS1591\u0060 suppression from \u0060BrowserAutomationFramework.csproj\u0060 so the compiler enforces 100% XML documentation coverage on build.\n\n### How to Test\n1. Build the solution (\u0060dotnet build\u0060) and verify that \u0060BrowserAutomationFramework.xml\u0060 is generated with zero \u0060CS1591\u0060 warnings.\n2. Run \u0060TestBedApp\u0060 and verify that DOM exploration, Automation Editor sequences, Data Scraper previews/runs, and Reverse Engineering dumps operate as expected.\n\n--CODESTART--\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\BrowserAutomationFramework.csproj**\n\u0060\u0060\u0060csproj\n\u003C\u003C\u003C\u003C SEARCH\n    \u003CGenerateDocumentationFile\u003Etrue\u003C/GenerateDocumentationFile\u003E\n    \u003CNoWarn\u003E$(NoWarn);1591\u003C/NoWarn\u003E\n  \u003C/PropertyGroup\u003E\n==== REPLACE\n    \u003CGenerateDocumentationFile\u003Etrue\u003C/GenerateDocumentationFile\u003E\n  \u003C/PropertyGroup\u003E\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Automation\\AutomationRunner.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n    public class AutomationRunner\n    {\n        public delegate Task\u003CCommandResult?\u003E StepHandlerDelegate(BrowserClient client, AutomationStep step, CancellationToken cancellationToken);\n\n        private readonly ConcurrentDictionary\u003CAutomationActionType, StepHandlerDelegate\u003E _stepHandlers = new();\n        private readonly ConcurrentDictionary\u003Cstring, StepHandlerDelegate\u003E _customCommandHandlers = new(StringComparer.OrdinalIgnoreCase);\n        private readonly ConcurrentDictionary\u003Cstring, ScrapeDefinition\u003E _registeredScrapes = new(StringComparer.OrdinalIgnoreCase);\n\n        public event EventHandler\u003CAutomationSequenceEventArgs\u003E? OnSequenceStarted;\n        public event EventHandler\u003CAutomationSequenceEventArgs\u003E? OnSequenceCompleted;\n        public event EventHandler\u003CAutomationStepEventArgs\u003E? OnStepStarted;\n        public event EventHandler\u003CAutomationStepEventArgs\u003E? OnStepCompleted;\n        public event EventHandler\u003CAutomationStepEventArgs\u003E? OnStepFailed;\n        public event EventHandler\u003CScrapeEventArgs\u003E? OnScrapeCompleted;\n        public event EventHandler\u003CSiteDumpEventArgs\u003E? OnSiteDumpCompleted;\n\n        public AutomationRunner()\n        {\n            RegisterDefaultHandlers();\n        }\n==== REPLACE\n    public class AutomationRunner\n    {\n        /// \u003Csummary\u003E\n        /// Represents an asynchronous handler that executes a single \u003Csee cref=\u0022AutomationStep\u0022/\u003E against a connected \u003Csee cref=\u0022BrowserClient\u0022/\u003E.\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022client\u0022\u003EThe target browser client.\u003C/param\u003E\n        /// \u003Cparam name=\u0022step\u0022\u003EThe automation step to execute.\u003C/param\u003E\n        /// \u003Cparam name=\u0022cancellationToken\u0022\u003EA token to monitor for cancellation requests.\u003C/param\u003E\n        /// \u003Creturns\u003EA task representing the asynchronous operation, containing the optional \u003Csee cref=\u0022CommandResult\u0022/\u003E.\u003C/returns\u003E\n        public delegate Task\u003CCommandResult?\u003E StepHandlerDelegate(BrowserClient client, AutomationStep step, CancellationToken cancellationToken);\n\n        private readonly ConcurrentDictionary\u003CAutomationActionType, StepHandlerDelegate\u003E _stepHandlers = new();\n        private readonly ConcurrentDictionary\u003Cstring, StepHandlerDelegate\u003E _customCommandHandlers = new(StringComparer.OrdinalIgnoreCase);\n        private readonly ConcurrentDictionary\u003Cstring, ScrapeDefinition\u003E _registeredScrapes = new(StringComparer.OrdinalIgnoreCase);\n\n        /// \u003Csummary\u003E\n        /// Raised when an \u003Csee cref=\u0022AutomationSequence\u0022/\u003E begins execution.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CAutomationSequenceEventArgs\u003E? OnSequenceStarted;\n\n        /// \u003Csummary\u003E\n        /// Raised when an \u003Csee cref=\u0022AutomationSequence\u0022/\u003E finishes executing all of its steps.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CAutomationSequenceEventArgs\u003E? OnSequenceCompleted;\n\n        /// \u003Csummary\u003E\n        /// Raised immediately before an individual \u003Csee cref=\u0022AutomationStep\u0022/\u003E is executed.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CAutomationStepEventArgs\u003E? OnStepStarted;\n\n        /// \u003Csummary\u003E\n        /// Raised when an individual \u003Csee cref=\u0022AutomationStep\u0022/\u003E completes successfully.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CAutomationStepEventArgs\u003E? OnStepCompleted;\n\n        /// \u003Csummary\u003E\n        /// Raised when an individual \u003Csee cref=\u0022AutomationStep\u0022/\u003E throws an exception during execution.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CAutomationStepEventArgs\u003E? OnStepFailed;\n\n        /// \u003Csummary\u003E\n        /// Raised when an \u003Csee cref=\u0022AutomationActionType.Scrape\u0022/\u003E step finishes extracting data.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CScrapeEventArgs\u003E? OnScrapeCompleted;\n\n        /// \u003Csummary\u003E\n        /// Raised when an \u003Csee cref=\u0022AutomationActionType.DumpSite\u0022/\u003E step finishes dumping site resources.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CSiteDumpEventArgs\u003E? OnSiteDumpCompleted;\n\n        /// \u003Csummary\u003E\n        /// Initializes a new instance of the \u003Csee cref=\u0022AutomationRunner\u0022/\u003E class with all built-in step handlers registered.\n        /// \u003C/summary\u003E\n        public AutomationRunner()\n        {\n            RegisterDefaultHandlers();\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Extensions\\ReactExtensions.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nnamespace BrowserAutomationFramework.Extensions\n{\n    public static class ReactExtensions\n    {\n==== REPLACE\nnamespace BrowserAutomationFramework.Extensions\n{\n    /// \u003Csummary\u003E\n    /// Provides high-level extension methods on \u003Csee cref=\u0022BrowserClient\u0022/\u003E for React-compatible DOM interaction,\n    /// page navigation, DOM tree snapshots, element highlighting, data scraping, automation workflows, and reverse-engineering site dumps.\n    /// \u003C/summary\u003E\n    public static class ReactExtensions\n    {\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Generators\\ChromeExtensionGenerator.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        public static string GenerateManifestJson()\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Generates the Manifest V3 \u003Cc\u003Emanifest.json\u003C/c\u003E content for the BAF Chrome Extension.\n        /// \u003C/summary\u003E\n        public static string GenerateManifestJson()\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        public static string GenerateContentRelayJs()\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Generates the \u003Cc\u003Econtent_relay.js\u003C/c\u003E script that runs in the \u003Cc\u003EISOLATED\u003C/c\u003E world and relays \u003Cc\u003EGM_xmlhttpRequest\u003C/c\u003E calls to the extension service worker.\n        /// \u003C/summary\u003E\n        public static string GenerateContentRelayJs()\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        public static string GenerateBackgroundJs(int defaultPort = 9999, IpcMode defaultMode = IpcMode.WebSocket)\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Generates the Manifest V3 \u003Cc\u003Ebackground.js\u003C/c\u003E service worker script configured for the specified default port and IPC mode.\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022defaultPort\u0022\u003EThe default local server port to connect to.\u003C/param\u003E\n        /// \u003Cparam name=\u0022defaultMode\u0022\u003EThe default IPC mode (\u003Csee cref=\u0022IpcMode.WebSocket\u0022/\u003E or \u003Csee cref=\u0022IpcMode.HttpPolling\u0022/\u003E).\u003C/param\u003E\n        public static string GenerateBackgroundJs(int defaultPort = 9999, IpcMode defaultMode = IpcMode.WebSocket)\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        public static string GeneratePopupHtml()\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Generates the HTML markup for the Chrome Extension\u0027s toolbar popup (\u003Cc\u003Epopup.html\u003C/c\u003E).\n        /// \u003C/summary\u003E\n        public static string GeneratePopupHtml()\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        public static string GeneratePopupJs(int defaultPort = 9999)\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Generates the JavaScript logic for the Chrome Extension\u0027s toolbar popup (\u003Cc\u003Epopup.js\u003C/c\u003E).\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022defaultPort\u0022\u003EThe default local server port displayed in the popup UI.\u003C/param\u003E\n        public static string GeneratePopupJs(int defaultPort = 9999)\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\AutomationProject.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n    public class AutomationProject\n    {\n        [JsonPropertyName(\u0022matchAnySite\u0022)]\n        public bool MatchAnySite { get; set; } = true;\n\n        [JsonPropertyName(\u0022matchUrls\u0022)]\n        public List\u003Cstring\u003E MatchUrls { get; set; } = new();\n\n        [JsonPropertyName(\u0022sequences\u0022)]\n        public List\u003CAutomationSequence\u003E Sequences { get; set; } = new();\n\n        [JsonPropertyName(\u0022scrapes\u0022)]\n        public List\u003CScrapeDefinition\u003E Scrapes { get; set; } = new();\n==== REPLACE\n    public class AutomationProject\n    {\n        /// \u003Csummary\u003E\n        /// Gets or sets whether the generated userscript should match all URLs (\u003Cc\u003E*://*/*\u003C/c\u003E).\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022matchAnySite\u0022)]\n        public bool MatchAnySite { get; set; } = true;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the list of explicit URL match patterns when \u003Csee cref=\u0022MatchAnySite\u0022/\u003E is \u003Cc\u003Efalse\u003C/c\u003E.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022matchUrls\u0022)]\n        public List\u003Cstring\u003E MatchUrls { get; set; } = new();\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the ordered collection of \u003Csee cref=\u0022AutomationSequence\u0022/\u003E workflows in this project.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022sequences\u0022)]\n        public List\u003CAutomationSequence\u003E Sequences { get; set; } = new();\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the ordered collection of \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E configurations in this project.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022scrapes\u0022)]\n        public List\u003CScrapeDefinition\u003E Scrapes { get; set; } = new();\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        public string ToJson(bool writeIndented = true)\n        {\n            return JsonSerializer.Serialize(this, new JsonSerializerOptions { WriteIndented = writeIndented });\n        }\n\n        public static AutomationProject FromJson(string json)\n        {\n            if (string.IsNullOrWhiteSpace(json))\n                throw new ArgumentException(\u0022Project JSON cannot be empty.\u0022, nameof(json));\n\n            try\n            {\n                var project = JsonSerializer.Deserialize\u003CAutomationProject\u003E(json);\n                if (project != null \u0026\u0026 project.Sequences != null)\n                {\n                    return project;\n                }\n            }\n            catch\n            {\n                // Fallback to legacy format (List\u003CAutomationSequence\u003E)\n            }\n\n            var legacySequences = JsonSerializer.Deserialize\u003CList\u003CAutomationSequence\u003E\u003E(json);\n            if (legacySequences != null)\n            {\n                return new AutomationProject\n                {\n                    MatchAnySite = true,\n                    Sequences = legacySequences\n                };\n            }\n\n            throw new InvalidDataException(\u0022Unable to deserialize AutomationProject from JSON.\u0022);\n        }\n\n        public void SaveToFile(string filePath)\n        {\n            File.WriteAllText(filePath, ToJson(true));\n        }\n\n        public Task SaveToFileAsync(string filePath, CancellationToken cancellationToken = default)\n        {\n            return File.WriteAllTextAsync(filePath, ToJson(true), cancellationToken);\n        }\n\n        public static AutomationProject LoadFromFile(string filePath)\n        {\n            string json = File.ReadAllText(filePath);\n            return FromJson(json);\n        }\n\n        public static async Task\u003CAutomationProject\u003E LoadFromFileAsync(string filePath, CancellationToken cancellationToken = default)\n        {\n            string json = await File.ReadAllTextAsync(filePath, cancellationToken);\n            return FromJson(json);\n        }\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Serializes this \u003Csee cref=\u0022AutomationProject\u0022/\u003E to a JSON string.\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022writeIndented\u0022\u003EWhether to format the JSON output with indentation.\u003C/param\u003E\n        public string ToJson(bool writeIndented = true)\n        {\n            return JsonSerializer.Serialize(this, new JsonSerializerOptions { WriteIndented = writeIndented });\n        }\n\n        /// \u003Csummary\u003E\n        /// Deserializes an \u003Csee cref=\u0022AutomationProject\u0022/\u003E from a JSON string (supporting both current project JSON and legacy sequence-list JSON).\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022json\u0022\u003EThe JSON string to deserialize.\u003C/param\u003E\n        public static AutomationProject FromJson(string json)\n        {\n            if (string.IsNullOrWhiteSpace(json))\n                throw new ArgumentException(\u0022Project JSON cannot be empty.\u0022, nameof(json));\n\n            try\n            {\n                var project = JsonSerializer.Deserialize\u003CAutomationProject\u003E(json);\n                if (project != null \u0026\u0026 project.Sequences != null)\n                {\n                    return project;\n                }\n            }\n            catch\n            {\n                // Fallback to legacy format (List\u003CAutomationSequence\u003E)\n            }\n\n            var legacySequences = JsonSerializer.Deserialize\u003CList\u003CAutomationSequence\u003E\u003E(json);\n            if (legacySequences != null)\n            {\n                return new AutomationProject\n                {\n                    MatchAnySite = true,\n                    Sequences = legacySequences\n                };\n            }\n\n            throw new InvalidDataException(\u0022Unable to deserialize AutomationProject from JSON.\u0022);\n        }\n\n        /// \u003Csummary\u003E\n        /// Saves this \u003Csee cref=\u0022AutomationProject\u0022/\u003E as indented JSON to the specified file path.\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022filePath\u0022\u003EThe destination file path.\u003C/param\u003E\n        public void SaveToFile(string filePath)\n        {\n            File.WriteAllText(filePath, ToJson(true));\n        }\n\n        /// \u003Csummary\u003E\n        /// Asynchronously saves this \u003Csee cref=\u0022AutomationProject\u0022/\u003E as indented JSON to the specified file path.\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022filePath\u0022\u003EThe destination file path.\u003C/param\u003E\n        /// \u003Cparam name=\u0022cancellationToken\u0022\u003EA token to monitor for cancellation requests.\u003C/param\u003E\n        public Task SaveToFileAsync(string filePath, CancellationToken cancellationToken = default)\n        {\n            return File.WriteAllTextAsync(filePath, ToJson(true), cancellationToken);\n        }\n\n        /// \u003Csummary\u003E\n        /// Loads an \u003Csee cref=\u0022AutomationProject\u0022/\u003E from a JSON file on disk.\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022filePath\u0022\u003EThe path to the JSON project file.\u003C/param\u003E\n        public static AutomationProject LoadFromFile(string filePath)\n        {\n            string json = File.ReadAllText(filePath);\n            return FromJson(json);\n        }\n\n        /// \u003Csummary\u003E\n        /// Asynchronously loads an \u003Csee cref=\u0022AutomationProject\u0022/\u003E from a JSON file on disk.\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022filePath\u0022\u003EThe path to the JSON project file.\u003C/param\u003E\n        /// \u003Cparam name=\u0022cancellationToken\u0022\u003EA token to monitor for cancellation requests.\u003C/param\u003E\n        public static async Task\u003CAutomationProject\u003E LoadFromFileAsync(string filePath, CancellationToken cancellationToken = default)\n        {\n            string json = await File.ReadAllTextAsync(filePath, cancellationToken);\n            return FromJson(json);\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\AutomationSequence.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n    public class AutomationSequence\n    {\n        [JsonPropertyName(\u0022id\u0022)]\n        public string Id { get; set; } = Guid.NewGuid().ToString();\n\n        [JsonPropertyName(\u0022name\u0022)]\n        public string Name { get; set; } = \u0022New Sequence\u0022;\n\n        [JsonPropertyName(\u0022isActive\u0022)]\n        public bool IsActive { get; set; } = true;\n\n        [JsonPropertyName(\u0022steps\u0022)]\n        public List\u003CAutomationStep\u003E Steps { get; set; } = new();\n\n        /// \u003Csummary\u003E\n        /// Creates an \u003Csee cref=\u0022AutomationStep\u0022/\u003E targeting \u003Cparamref name=\u0022domNode\u0022/\u003E and appends it to \u003Csee cref=\u0022Steps\u0022/\u003E.\n        /// \u003C/summary\u003E\n        public AutomationStep AddStepFromDomNode(\n            DomNode domNode,\n            AutomationActionType actionType,\n            string value = \u0022\u0022,\n            bool overwrite = true)\n        {\n            if (domNode == null) throw new ArgumentNullException(nameof(domNode));\n            var step = domNode.CreateStep(actionType, value, overwrite);\n            Steps.Add(step);\n            return step;\n        }\n\n        /// \u003Csummary\u003E\n        /// Moves the step at \u003Cparamref name=\u0022index\u0022/\u003E one position earlier in the sequence.\n        /// \u003C/summary\u003E\n        public bool MoveStepUp(int index)\n        {\n            if (index \u003C= 0 || index \u003E= Steps.Count) return false;\n            var step = Steps[index];\n            Steps.RemoveAt(index);\n            Steps.Insert(index - 1, step);\n            return true;\n        }\n\n        public bool MoveStepDown(int index)\n        {\n            if (index \u003C 0 || index \u003E= Steps.Count - 1) return false;\n            var step = Steps[index];\n            Steps.RemoveAt(index);\n            Steps.Insert(index \u002B 1, step);\n            return true;\n        }\n\n        public override string ToString() =\u003E Name;\n    }\n==== REPLACE\n    public class AutomationSequence\n    {\n        /// \u003Csummary\u003E\n        /// Gets or sets the unique identifier for this automation sequence.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022id\u0022)]\n        public string Id { get; set; } = Guid.NewGuid().ToString();\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the display name of this automation sequence.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022name\u0022)]\n        public string Name { get; set; } = \u0022New Sequence\u0022;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets whether this sequence is enabled when running all active sequences in a project.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022isActive\u0022)]\n        public bool IsActive { get; set; } = true;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the ordered list of \u003Csee cref=\u0022AutomationStep\u0022/\u003E actions in this sequence.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022steps\u0022)]\n        public List\u003CAutomationStep\u003E Steps { get; set; } = new();\n\n        /// \u003Csummary\u003E\n        /// Creates a new \u003Csee cref=\u0022AutomationStep\u0022/\u003E and appends it to \u003Csee cref=\u0022Steps\u0022/\u003E.\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022name\u0022\u003EDisplay name for the step.\u003C/param\u003E\n        /// \u003Cparam name=\u0022actionType\u0022\u003EThe action type to execute.\u003C/param\u003E\n        /// \u003Cparam name=\u0022selector\u0022\u003ETarget CSS selector.\u003C/param\u003E\n        /// \u003Cparam name=\u0022value\u0022\u003EStep value or payload.\u003C/param\u003E\n        /// \u003Cparam name=\u0022overwrite\u0022\u003EWhether to overwrite existing text on input steps.\u003C/param\u003E\n        /// \u003Creturns\u003EThe newly created \u003Csee cref=\u0022AutomationStep\u0022/\u003E.\u003C/returns\u003E\n        public AutomationStep AddStep(\n            string name = \u0022New Step\u0022,\n            AutomationActionType actionType = AutomationActionType.Click,\n            string selector = \u0022\u0022,\n            string value = \u0022\u0022,\n            bool overwrite = true)\n        {\n            var step = new AutomationStep\n            {\n                Name = string.IsNullOrWhiteSpace(name) ? \u0022New Step\u0022 : name,\n                ActionType = actionType,\n                Selector = selector ?? string.Empty,\n                Value = value ?? string.Empty,\n                Overwrite = overwrite\n            };\n            Steps.Add(step);\n            return step;\n        }\n\n        /// \u003Csummary\u003E\n        /// Creates an \u003Csee cref=\u0022AutomationStep\u0022/\u003E targeting \u003Cparamref name=\u0022domNode\u0022/\u003E and appends it to \u003Csee cref=\u0022Steps\u0022/\u003E.\n        /// \u003C/summary\u003E\n        public AutomationStep AddStepFromDomNode(\n            DomNode domNode,\n            AutomationActionType actionType,\n            string value = \u0022\u0022,\n            bool overwrite = true)\n        {\n            if (domNode == null) throw new ArgumentNullException(nameof(domNode));\n            var step = domNode.CreateStep(actionType, value, overwrite);\n            Steps.Add(step);\n            return step;\n        }\n\n        /// \u003Csummary\u003E\n        /// Moves the step at \u003Cparamref name=\u0022index\u0022/\u003E one position earlier in the sequence.\n        /// \u003C/summary\u003E\n        public bool MoveStepUp(int index)\n        {\n            if (index \u003C= 0 || index \u003E= Steps.Count) return false;\n            var step = Steps[index];\n            Steps.RemoveAt(index);\n            Steps.Insert(index - 1, step);\n            return true;\n        }\n\n        /// \u003Csummary\u003E\n        /// Moves the step at \u003Cparamref name=\u0022index\u0022/\u003E one position later in the sequence.\n        /// \u003C/summary\u003E\n        public bool MoveStepDown(int index)\n        {\n            if (index \u003C 0 || index \u003E= Steps.Count - 1) return false;\n            var step = Steps[index];\n            Steps.RemoveAt(index);\n            Steps.Insert(index \u002B 1, step);\n            return true;\n        }\n\n        /// \u003Csummary\u003E\n        /// Returns the display name of this sequence.\n        /// \u003C/summary\u003E\n        public override string ToString() =\u003E Name;\n    }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\AutomationStep.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n    public enum AutomationActionType\n    {\n        Click,\n        SetValue,\n        Navigate,\n        EvaluateScript,\n        Scrape,\n        Custom,\n        DumpSite\n    }\n\n    /// \u003Csummary\u003E\n    /// Represents a single automation step within an \u003Csee cref=\u0022AutomationSequence\u0022/\u003E.\n    /// \u003C/summary\u003E\n    public class AutomationStep\n    {\n        [Category(\u00221. General\u0022)]\n        [Description(\u0022Display name for this automation step.\u0022)]\n        public string Name { get; set; } = \u0022New Step\u0022;\n\n        [Category(\u00221. General\u0022)]\n        [Description(\u0022The type of browser action to execute.\u0022)]\n        public AutomationActionType ActionType { get; set; }\n\n        [Category(\u00222. Target \u0026 Payload\u0022)]\n        [Description(\u0022CSS selector of the target DOM element (for Click, SetValue, or ad-hoc Scrape steps).\u0022)]\n        public string Selector { get; set; } = string.Empty;\n\n        [Category(\u00222. Target \u0026 Payload\u0022)]\n        [Description(\u0022Input text, target URL, JavaScript code, Scrape list name, or dump output folder path.\u0022)]\n        public string Value { get; set; } = string.Empty;\n\n        [Category(\u00222. Target \u0026 Payload\u0022)]\n        [Description(\u0022Custom command identifier, ScrapeExtractionType, or SiteDumpType depending on ActionType.\u0022)]\n        public string CustomCommandType { get; set; } = string.Empty;\n\n        [Category(\u00223. Behavior\u0022)]\n        [Description(\u0022When true on SetValue, replaces existing input text instead of appending.\u0022)]\n        public bool Overwrite { get; set; } = true;\n\n        [Category(\u00223. Behavior\u0022)]\n        [Description(\u0022Delay in milliseconds to wait after this step completes.\u0022)]\n        public int DelayAfterMs { get; set; } = 500;\n\n        public override string ToString() =\u003E $\u0022{Name} ({ActionType})\u0022;\n    }\n==== REPLACE\n    public enum AutomationActionType\n    {\n        /// \u003Csummary\u003E\n        /// Simulates a trusted React or native click on the target element.\n        /// \u003C/summary\u003E\n        Click,\n\n        /// \u003Csummary\u003E\n        /// Sets the value of an input or textarea element, bypassing React\u0027s native value tracker.\n        /// \u003C/summary\u003E\n        SetValue,\n\n        /// \u003Csummary\u003E\n        /// Navigates the browser tab to a target URL and waits for the page transition to complete.\n        /// \u003C/summary\u003E\n        Navigate,\n\n        /// \u003Csummary\u003E\n        /// Evaluates custom JavaScript code in the context of the page.\n        /// \u003C/summary\u003E\n        EvaluateScript,\n\n        /// \u003Csummary\u003E\n        /// Executes a registered \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E or an ad-hoc single-field scrape.\n        /// \u003C/summary\u003E\n        Scrape,\n\n        /// \u003Csummary\u003E\n        /// Executes a custom command handler or sends a raw command type to the browser bridge.\n        /// \u003C/summary\u003E\n        Custom,\n\n        /// \u003Csummary\u003E\n        /// Executes a reverse-engineering site dump (\u003Csee cref=\u0022SiteDumpType\u0022/\u003E) and optionally saves the output to disk.\n        /// \u003C/summary\u003E\n        DumpSite\n    }\n\n    /// \u003Csummary\u003E\n    /// Represents a single automation step within an \u003Csee cref=\u0022AutomationSequence\u0022/\u003E.\n    /// \u003C/summary\u003E\n    public class AutomationStep\n    {\n        /// \u003Csummary\u003E\n        /// Gets or sets the display name for this automation step.\n        /// \u003C/summary\u003E\n        [Category(\u00221. General\u0022)]\n        [Description(\u0022Display name for this automation step.\u0022)]\n        public string Name { get; set; } = \u0022New Step\u0022;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the type of browser action to execute.\n        /// \u003C/summary\u003E\n        [Category(\u00221. General\u0022)]\n        [Description(\u0022The type of browser action to execute.\u0022)]\n        public AutomationActionType ActionType { get; set; }\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the CSS selector of the target DOM element (for Click, SetValue, or ad-hoc Scrape steps).\n        /// \u003C/summary\u003E\n        [Category(\u00222. Target \u0026 Payload\u0022)]\n        [Description(\u0022CSS selector of the target DOM element (for Click, SetValue, or ad-hoc Scrape steps).\u0022)]\n        public string Selector { get; set; } = string.Empty;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the input text, target URL, JavaScript code, Scrape list name, or dump output folder path.\n        /// \u003C/summary\u003E\n        [Category(\u00222. Target \u0026 Payload\u0022)]\n        [Description(\u0022Input text, target URL, JavaScript code, Scrape list name, or dump output folder path.\u0022)]\n        public string Value { get; set; } = string.Empty;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the custom command identifier, \u003Csee cref=\u0022ScrapeExtractionType\u0022/\u003E, or \u003Csee cref=\u0022SiteDumpType\u0022/\u003E depending on \u003Csee cref=\u0022ActionType\u0022/\u003E.\n        /// \u003C/summary\u003E\n        [Category(\u00222. Target \u0026 Payload\u0022)]\n        [Description(\u0022Custom command identifier, ScrapeExtractionType, or SiteDumpType depending on ActionType.\u0022)]\n        public string CustomCommandType { get; set; } = string.Empty;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets whether to replace existing input text instead of appending when \u003Csee cref=\u0022ActionType\u0022/\u003E is \u003Csee cref=\u0022AutomationActionType.SetValue\u0022/\u003E.\n        /// \u003C/summary\u003E\n        [Category(\u00223. Behavior\u0022)]\n        [Description(\u0022When true on SetValue, replaces existing input text instead of appending.\u0022)]\n        public bool Overwrite { get; set; } = true;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the delay in milliseconds to wait after this step completes.\n        /// \u003C/summary\u003E\n        [Category(\u00223. Behavior\u0022)]\n        [Description(\u0022Delay in milliseconds to wait after this step completes.\u0022)]\n        public int DelayAfterMs { get; set; } = 500;\n\n        /// \u003Csummary\u003E\n        /// Returns a formatted string representation of this step and its action type.\n        /// \u003C/summary\u003E\n        public override string ToString() =\u003E $\u0022{Name} ({ActionType})\u0022;\n    }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\BrowserEventArgs.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n    public class DomChangedEventArgs : EventArgs\n    {\n        public string? HighlightedPath { get; }\n        public bool HasHighlightedPath { get; }\n\n        public DomChangedEventArgs(string? highlightedPath, bool hasHighlightedPath)\n        {\n            HighlightedPath = highlightedPath;\n            HasHighlightedPath = hasHighlightedPath;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when the user middle-clicks an element in the connected browser tab.\n    /// \u003C/summary\u003E\n    public class ElementClickedEventArgs : EventArgs\n    {\n        public string Path { get; }\n\n        public ElementClickedEventArgs(string path)\n        {\n            Path = path;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when a page load or in-place navigation completes in the browser tab.\n    /// \u003C/summary\u003E\n    public class PageLoadedEventArgs : EventArgs\n    {\n        public string PageLoadId { get; }\n        public string Url { get; }\n        public string ReadyState { get; }\n        public int StatusCode { get; }\n        public string? RetryAfter { get; }\n\n        public PageLoadedEventArgs(string pageLoadId, string url, string readyState, int statusCode = 200, string? retryAfter = null)\n        {\n            PageLoadId = pageLoadId;\n            Url = url;\n            ReadyState = readyState;\n            StatusCode = statusCode;\n            RetryAfter = retryAfter;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised before waiting between paginated scrape pages.\n    /// \u003C/summary\u003E\n    public class ScrapePageDelayEventArgs : EventArgs\n    {\n        public ScrapeDefinition Definition { get; }\n        public int NextPageNumber { get; }\n        public int DelayMs { get; }\n\n        public ScrapePageDelayEventArgs(ScrapeDefinition definition, int nextPageNumber, int delayMs)\n        {\n            Definition = definition;\n            NextPageNumber = nextPageNumber;\n            DelayMs = delayMs;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when an HTTP 429 rate-limit response is detected during scraping.\n    /// \u003C/summary\u003E\n    public class ScrapeRateLimitEventArgs : EventArgs\n    {\n        public ScrapeDefinition Definition { get; }\n        public int PageNumber { get; }\n        public string? RetryAfterHeader { get; }\n        public DateTimeOffset RetryAtUtc { get; }\n        public TimeSpan WaitDuration { get; }\n        public bool IsDateHeader { get; }\n        public int NewPageDelayMs { get; }\n\n        public ScrapeRateLimitEventArgs(\n            ScrapeDefinition definition,\n            int pageNumber,\n            string? retryAfterHeader,\n            DateTimeOffset retryAtUtc,\n            TimeSpan waitDuration,\n            bool isDateHeader,\n            int newPageDelayMs)\n        {\n            Definition = definition;\n            PageNumber = pageNumber;\n            RetryAfterHeader = retryAfterHeader;\n            RetryAtUtc = retryAtUtc;\n            WaitDuration = waitDuration;\n            IsDateHeader = isDateHeader;\n            NewPageDelayMs = newPageDelayMs;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when an \u003Csee cref=\u0022AutomationSequence\u0022/\u003E starts or completes.\n    /// \u003C/summary\u003E\n    public class AutomationSequenceEventArgs : EventArgs\n    {\n        public AutomationSequence Sequence { get; }\n\n        public AutomationSequenceEventArgs(AutomationSequence sequence)\n        {\n            Sequence = sequence;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when an \u003Csee cref=\u0022AutomationStep\u0022/\u003E starts, completes, or fails.\n    /// \u003C/summary\u003E\n    public class AutomationStepEventArgs : EventArgs\n    {\n        public AutomationSequence? Sequence { get; }\n        public AutomationStep Step { get; }\n        public CommandResult? Result { get; }\n        public Exception? Error { get; }\n\n        public AutomationStepEventArgs(AutomationSequence? sequence, AutomationStep step, CommandResult? result = null, Exception? error = null)\n        {\n            Sequence = sequence;\n            Step = step;\n            Result = result;\n            Error = error;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when a \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E starts, completes, or fails.\n    /// \u003C/summary\u003E\n    public class ScrapeEventArgs : EventArgs\n    {\n        public ScrapeDefinition Definition { get; }\n        public ScrapeResult? Result { get; }\n        public Exception? Error { get; }\n\n        public ScrapeEventArgs(ScrapeDefinition definition, ScrapeResult? result = null, Exception? error = null)\n        {\n            Definition = definition;\n            Result = result;\n            Error = error;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when a single page of a \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E finishes extracting records.\n    /// \u003C/summary\u003E\n    public class ScrapePageEventArgs : EventArgs\n    {\n        public ScrapeDefinition Definition { get; }\n        public int PageNumber { get; }\n        public System.Collections.Generic.IReadOnlyList\u003CSystem.Collections.Generic.Dictionary\u003Cstring, string?\u003E\u003E PageRecords { get; }\n\n        public ScrapePageEventArgs(\n            ScrapeDefinition definition,\n            int pageNumber,\n            System.Collections.Generic.IReadOnlyList\u003CSystem.Collections.Generic.Dictionary\u003Cstring, string?\u003E\u003E pageRecords)\n        {\n            Definition = definition;\n            PageNumber = pageNumber;\n            PageRecords = pageRecords;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when a reverse-engineering site dump starts, completes, or fails.\n    /// \u003C/summary\u003E\n    public class SiteDumpEventArgs : EventArgs\n    {\n        public SiteDumpType DumpType { get; }\n        public SiteDumpResult? Result { get; }\n        public Exception? Error { get; }\n\n        public SiteDumpEventArgs(SiteDumpType dumpType, SiteDumpResult? result = null, Exception? error = null)\n        {\n            DumpType = dumpType;\n            Result = result;\n            Error = error;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when the BAF Chrome Extension reports an updated list of open browser tabs.\n    /// \u003C/summary\u003E\n    public class ExtensionTabsEventArgs : EventArgs\n    {\n        public System.Collections.Generic.IReadOnlyList\u003CBrowserTabInfo\u003E Tabs { get; }\n        public int? ActiveAttachedTabId { get; }\n\n        public ExtensionTabsEventArgs(\n            System.Collections.Generic.IReadOnlyList\u003CBrowserTabInfo\u003E tabs,\n            int? activeAttachedTabId = null)\n        {\n            Tabs = tabs;\n            ActiveAttachedTabId = activeAttachedTabId;\n        }\n    }\n==== REPLACE\n    public class DomChangedEventArgs : EventArgs\n    {\n        /// \u003Csummary\u003E\n        /// Gets the updated CSS path of the currently highlighted element on the page, if any.\n        /// \u003C/summary\u003E\n        public string? HighlightedPath { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets whether the DOM change event payload included a highlighted path property.\n        /// \u003C/summary\u003E\n        public bool HasHighlightedPath { get; }\n\n        /// \u003Csummary\u003E\n        /// Initializes a new instance of the \u003Csee cref=\u0022DomChangedEventArgs\u0022/\u003E class.\n        /// \u003C/summary\u003E\n        public DomChangedEventArgs(string? highlightedPath, bool hasHighlightedPath)\n        {\n            HighlightedPath = highlightedPath;\n            HasHighlightedPath = hasHighlightedPath;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when the user middle-clicks an element in the connected browser tab.\n    /// \u003C/summary\u003E\n    public class ElementClickedEventArgs : EventArgs\n    {\n        /// \u003Csummary\u003E\n        /// Gets the CSS selector path of the middle-clicked DOM element.\n        /// \u003C/summary\u003E\n        public string Path { get; }\n\n        /// \u003Csummary\u003E\n        /// Initializes a new instance of the \u003Csee cref=\u0022ElementClickedEventArgs\u0022/\u003E class.\n        /// \u003C/summary\u003E\n        public ElementClickedEventArgs(string path)\n        {\n            Path = path;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when a page load or in-place navigation completes in the browser tab.\n    /// \u003C/summary\u003E\n    public class PageLoadedEventArgs : EventArgs\n    {\n        /// \u003Csummary\u003E\n        /// Gets the unique identifier generated for this page load instance.\n        /// \u003C/summary\u003E\n        public string PageLoadId { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the URL of the loaded page.\n        /// \u003C/summary\u003E\n        public string Url { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the document readyState reported by the browser (typically \u003Cc\u003Ecomplete\u003C/c\u003E).\n        /// \u003C/summary\u003E\n        public string ReadyState { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the HTTP status code detected for the page load (e.g., 200 or 429).\n        /// \u003C/summary\u003E\n        public int StatusCode { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the raw \u003Cc\u003ERetry-After\u003C/c\u003E header or value if the page returned HTTP 429.\n        /// \u003C/summary\u003E\n        public string? RetryAfter { get; }\n\n        /// \u003Csummary\u003E\n        /// Initializes a new instance of the \u003Csee cref=\u0022PageLoadedEventArgs\u0022/\u003E class.\n        /// \u003C/summary\u003E\n        public PageLoadedEventArgs(string pageLoadId, string url, string readyState, int statusCode = 200, string? retryAfter = null)\n        {\n            PageLoadId = pageLoadId;\n            Url = url;\n            ReadyState = readyState;\n            StatusCode = statusCode;\n            RetryAfter = retryAfter;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised before waiting between paginated scrape pages.\n    /// \u003C/summary\u003E\n    public class ScrapePageDelayEventArgs : EventArgs\n    {\n        /// \u003Csummary\u003E\n        /// Gets the \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E currently executing.\n        /// \u003C/summary\u003E\n        public ScrapeDefinition Definition { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the 1-based page number that will be scraped after the delay finishes.\n        /// \u003C/summary\u003E\n        public int NextPageNumber { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the configured delay in milliseconds before turning to the next page.\n        /// \u003C/summary\u003E\n        public int DelayMs { get; }\n\n        /// \u003Csummary\u003E\n        /// Initializes a new instance of the \u003Csee cref=\u0022ScrapePageDelayEventArgs\u0022/\u003E class.\n        /// \u003C/summary\u003E\n        public ScrapePageDelayEventArgs(ScrapeDefinition definition, int nextPageNumber, int delayMs)\n        {\n            Definition = definition;\n            NextPageNumber = nextPageNumber;\n            DelayMs = delayMs;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when an HTTP 429 rate-limit response is detected during scraping.\n    /// \u003C/summary\u003E\n    public class ScrapeRateLimitEventArgs : EventArgs\n    {\n        /// \u003Csummary\u003E\n        /// Gets the \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E that encountered the HTTP 429 response.\n        /// \u003C/summary\u003E\n        public ScrapeDefinition Definition { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the 1-based page number on which rate limiting occurred.\n        /// \u003C/summary\u003E\n        public int PageNumber { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the raw \u003Cc\u003ERetry-After\u003C/c\u003E header value if provided by the server.\n        /// \u003C/summary\u003E\n        public string? RetryAfterHeader { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the UTC timestamp when the scraper will retry the request.\n        /// \u003C/summary\u003E\n        public DateTimeOffset RetryAtUtc { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the calculated duration to wait before retrying.\n        /// \u003C/summary\u003E\n        public TimeSpan WaitDuration { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets whether the \u003Cc\u003ERetry-After\u003C/c\u003E value was parsed as an exact date/timestamp rather than a relative delay in seconds.\n        /// \u003C/summary\u003E\n        public bool IsDateHeader { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the updated \u003Csee cref=\u0022ScrapeDefinition.PageDelayMs\u0022/\u003E applied for subsequent pages.\n        /// \u003C/summary\u003E\n        public int NewPageDelayMs { get; }\n\n        /// \u003Csummary\u003E\n        /// Initializes a new instance of the \u003Csee cref=\u0022ScrapeRateLimitEventArgs\u0022/\u003E class.\n        /// \u003C/summary\u003E\n        public ScrapeRateLimitEventArgs(\n            ScrapeDefinition definition,\n            int pageNumber,\n            string? retryAfterHeader,\n            DateTimeOffset retryAtUtc,\n            TimeSpan waitDuration,\n            bool isDateHeader,\n            int newPageDelayMs)\n        {\n            Definition = definition;\n            PageNumber = pageNumber;\n            RetryAfterHeader = retryAfterHeader;\n            RetryAtUtc = retryAtUtc;\n            WaitDuration = waitDuration;\n            IsDateHeader = isDateHeader;\n            NewPageDelayMs = newPageDelayMs;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when an \u003Csee cref=\u0022AutomationSequence\u0022/\u003E starts or completes.\n    /// \u003C/summary\u003E\n    public class AutomationSequenceEventArgs : EventArgs\n    {\n        /// \u003Csummary\u003E\n        /// Gets the \u003Csee cref=\u0022AutomationSequence\u0022/\u003E associated with the event.\n        /// \u003C/summary\u003E\n        public AutomationSequence Sequence { get; }\n\n        /// \u003Csummary\u003E\n        /// Initializes a new instance of the \u003Csee cref=\u0022AutomationSequenceEventArgs\u0022/\u003E class.\n        /// \u003C/summary\u003E\n        public AutomationSequenceEventArgs(AutomationSequence sequence)\n        {\n            Sequence = sequence;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when an \u003Csee cref=\u0022AutomationStep\u0022/\u003E starts, completes, or fails.\n    /// \u003C/summary\u003E\n    public class AutomationStepEventArgs : EventArgs\n    {\n        /// \u003Csummary\u003E\n        /// Gets the parent \u003Csee cref=\u0022AutomationSequence\u0022/\u003E if the step is running as part of a sequence.\n        /// \u003C/summary\u003E\n        public AutomationSequence? Sequence { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the \u003Csee cref=\u0022AutomationStep\u0022/\u003E being executed.\n        /// \u003C/summary\u003E\n        public AutomationStep Step { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the \u003Csee cref=\u0022CommandResult\u0022/\u003E returned by the step when completed.\n        /// \u003C/summary\u003E\n        public CommandResult? Result { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the exception thrown if the step failed.\n        /// \u003C/summary\u003E\n        public Exception? Error { get; }\n\n        /// \u003Csummary\u003E\n        /// Initializes a new instance of the \u003Csee cref=\u0022AutomationStepEventArgs\u0022/\u003E class.\n        /// \u003C/summary\u003E\n        public AutomationStepEventArgs(AutomationSequence? sequence, AutomationStep step, CommandResult? result = null, Exception? error = null)\n        {\n            Sequence = sequence;\n            Step = step;\n            Result = result;\n            Error = error;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments raised when a \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E starts, completes, or fails.\n    /// \u003C/summary\u003E\n    public class ScrapeEventArgs : EventArgs\n    {\n        /// \u003Csummary\u003E\n        /// Gets the \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E associated with the event.\n        /// \u003C/summary\u003E\n        public ScrapeDefinition Definition { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the \u003Csee cref=\u0022ScrapeResult\u0022/\u003E produced by the scrape operation.\n        /// \u003C/summary\u003E\n        public ScrapeResult? Result { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the exception thrown if the scrape operation failed.\n        /// \u003C/summary\u003E\n        public Exception? Error { get; }\n\n        /// \u003Csummary\u003E\n        /// Initializes a new instance of the \u003Csee cref=\u0022ScrapeEventArgs\u0022/\u003E class.\n        /// \u003C/summary\u003E\n        public ScrapeEventArgs(ScrapeDefinition definition, ScrapeResult? result = null, Exception? error = null)\n        {\n            Definition = definition;\n            Result = result;\n            Error = error;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Event arguments