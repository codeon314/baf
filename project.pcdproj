Gets or sets whether dynamically loaded scripts discovered via the Performance Resource Timing API are fetched.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022includePerformanceResourceScripts\u0022)]        public bool IncludePerformanceResourceScripts { get; set; } = true;        /// \u003Csummary\u003E        /// Gets or sets whether accessible \u003Cc\u003E\u0026lt;iframe\u0026gt;\u003C/c\u003E documents are included when dumping HTML.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022includeIframes\u0022)]        public bool IncludeIframes { get; set; } = true;        /// \u003Csummary\u003E        /// Gets or sets the timeout in milliseconds for fetching individual external CSS/JS assets.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022fetchTimeoutMs\u0022)]        public int FetchTimeoutMs { get; set; } = 15000;        /// \u003Csummary\u003E        /// Creates a \u003Csee cref=\u0022SiteDumpOptions\u0022/\u003E instance configured from high-level inclusion flags.        /// \u003C/summary\u003E        public static SiteDumpOptions Create(            bool includeExternal = true,            bool includeInline = true,            bool includeDynamicScripts = true,            bool includeIframes = true,            int fetchTimeoutMs = 15000)        {            return new SiteDumpOptions            {                IncludeExternalCss = includeExternal,                IncludeExternalScripts = includeExternal,                IncludeInlineCss = includeInline,                IncludeConstructedCss = includeInline,                IncludeInlineScripts = includeInline,                IncludePerformanceResourceScripts = includeDynamicScripts,                IncludeIframes = includeIframes,                FetchTimeoutMs = fetchTimeoutMs            };        }        /// \u003Csummary\u003E        /// Creates a shallow copy of this \u003Csee cref=\u0022SiteDumpOptions\u0022/\u003E instance.        /// \u003C/summary\u003E        public SiteDumpOptions Clone()        {            return new SiteDumpOptions            {                IncludeHtml = IncludeHtml,                IncludeCss = IncludeCss,                IncludeJavaScript = IncludeJavaScript,                IncludeInlineCss = IncludeInlineCss,                IncludeExternalCss = IncludeExternalCss,                IncludeConstructedCss = IncludeConstructedCss,                IncludeInlineScripts = IncludeInlineScripts,                IncludeExternalScripts = IncludeExternalScripts,                IncludePerformanceResourceScripts = IncludePerformanceResourceScripts,                IncludeIframes = IncludeIframes,                FetchTimeoutMs = FetchTimeoutMs            };        }        /// \u003Csummary\u003E        /// Returns a \u003Csee cref=\u0022SiteDumpOptions\u0022/\u003E copy with \u003Csee cref=\u0022IncludeHtml\u0022/\u003E, \u003Csee cref=\u0022IncludeCss\u0022/\u003E, and \u003Csee cref=\u0022IncludeJavaScript\u0022/\u003E set according to \u003Cparamref name=\u0022dumpType\u0022/\u003E.        /// \u003C/summary\u003E        public static SiteDumpOptions ForType(SiteDumpType dumpType, SiteDumpOptions? baseOptions = null)        {            var opts = baseOptions?.Clone() ?? new SiteDumpOptions();            opts.IncludeHtml = dumpType == SiteDumpType.Html || dumpType == SiteDumpType.All;            opts.IncludeCss = dumpType == SiteDumpType.Css || dumpType == SiteDumpType.All;            opts.IncludeJavaScript = dumpType == SiteDumpType.JavaScript || dumpType == SiteDumpType.All;            return opts;        }    }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\SiteDumpResult.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH    public class SiteDumpResult    {        [JsonPropertyName(\u0022dumpType\u0022)]        public SiteDumpType DumpType { get; set; } = SiteDumpType.All;        [JsonPropertyName(\u0022pageUrl\u0022)]        public string PageUrl { get; set; } = string.Empty;        [JsonPropertyName(\u0022pageTitle\u0022)]        public string PageTitle { get; set; } = string.Empty;        [JsonPropertyName(\u0022timestampUtc\u0022)]        public DateTime TimestampUtc { get; set; } = DateTime.UtcNow;        [JsonPropertyName(\u0022success\u0022)]        public bool Success { get; set; } = true;        [JsonPropertyName(\u0022errorMessage\u0022)]        public string? ErrorMessage { get; set; }        [JsonPropertyName(\u0022html\u0022)]        public string Html { get; set; } = string.Empty;        [JsonPropertyName(\u0022htmlResources\u0022)]        public List\u003CSiteResourceItem\u003E HtmlResources { get; set; } = new();        [JsonPropertyName(\u0022cssResources\u0022)]        public List\u003CSiteResourceItem\u003E CssResources { get; set; } = new();        [JsonPropertyName(\u0022javascriptResources\u0022)]        public List\u003CSiteResourceItem\u003E JavaScriptResources { get; set; } = new();        [JsonIgnore]        public int TotalResourceCount =\u003E HtmlResources.Count \u002B CssResources.Count \u002B JavaScriptResources.Count;        [JsonIgnore]        public long TotalSizeBytes =\u003E GetAllResources().Sum(r =\u003E r.SizeBytes \u003E 0 ? r.SizeBytes : Encoding.UTF8.GetByteCount(r.Content ?? string.Empty));==== REPLACE    public class SiteDumpResult    {        /// \u003Csummary\u003E        /// Gets or sets the \u003Csee cref=\u0022SiteDumpType\u0022/\u003E that was requested for this dump.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022dumpType\u0022)]        public SiteDumpType DumpType { get; set; } = SiteDumpType.All;        /// \u003Csummary\u003E        /// Gets or sets the URL of the page from which resources were dumped.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022pageUrl\u0022)]        public string PageUrl { get; set; } = string.Empty;        /// \u003Csummary\u003E        /// Gets or sets the document title of the dumped page.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022pageTitle\u0022)]        public string PageTitle { get; set; } = string.Empty;        /// \u003Csummary\u003E        /// Gets or sets the UTC timestamp when the dump completed.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022timestampUtc\u0022)]        public DateTime TimestampUtc { get; set; } = DateTime.UtcNow;        /// \u003Csummary\u003E        /// Gets or sets whether the dump operation succeeded.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022success\u0022)]        public bool Success { get; set; } = true;        /// \u003Csummary\u003E        /// Gets or sets the error message if \u003Csee cref=\u0022Success\u0022/\u003E is \u003Cc\u003Efalse\u003C/c\u003E.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022errorMessage\u0022)]        public string? ErrorMessage { get; set; }        /// \u003Csummary\u003E        /// Gets or sets the primary serialized HTML of the main document.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022html\u0022)]        public string Html { get; set; } = string.Empty;        /// \u003Csummary\u003E        /// Gets or sets the list of extracted HTML resources (main document and accessible iframes).        /// \u003C/summary\u003E        [JsonPropertyName(\u0022htmlResources\u0022)]        public List\u003CSiteResourceItem\u003E HtmlResources { get; set; } = new();        /// \u003Csummary\u003E        /// Gets or sets the list of extracted CSS stylesheet resources (external, inline, and constructed).        /// \u003C/summary\u003E        [JsonPropertyName(\u0022cssResources\u0022)]        public List\u003CSiteResourceItem\u003E CssResources { get; set; } = new();        /// \u003Csummary\u003E        /// Gets or sets the list of extracted JavaScript resources (external, inline, and dynamically loaded).        /// \u003C/summary\u003E        [JsonPropertyName(\u0022javascriptResources\u0022)]        public List\u003CSiteResourceItem\u003E JavaScriptResources { get; set; } = new();        /// \u003Csummary\u003E        /// Gets the total number of HTML, CSS, and JavaScript resources captured in this dump.        /// \u003C/summary\u003E        [JsonIgnore]        public int TotalResourceCount =\u003E HtmlResources.Count \u002B CssResources.Count \u002B JavaScriptResources.Count;        /// \u003Csummary\u003E        /// Gets the combined size in bytes across all captured resources.        /// \u003C/summary\u003E        [JsonIgnore]        public long TotalSizeBytes =\u003E GetAllResources().Sum(r =\u003E r.SizeBytes \u003E 0 ? r.SizeBytes : Encoding.UTF8.GetByteCount(r.Content ?? string.Empty));\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        /// \u003Csummary\u003E        /// Returns a default file name (such as \u003Cc\u003E\u0022combined.html\u0022\u003C/c\u003E, \u003Cc\u003E\u0022combined.css\u0022\u003C/c\u003E, or \u003Cc\u003E\u0022combined.js\u0022\u003C/c\u003E) for the given \u003Csee cref=\u0022SiteDumpType\u0022/\u003E.        /// \u003C/summary\u003E        public static string GetSuggestedCombinedFileName(SiteDumpType viewType)        {            return viewType switch            {                SiteDumpType.Html =\u003E \u0022combined.html\u0022,                SiteDumpType.Css =\u003E \u0022combined.css\u0022,                SiteDumpType.JavaScript =\u003E \u0022combined.js\u0022,                _ =\u003E \u0022combined_dump.txt\u0022            };        }==== REPLACE        /// \u003Csummary\u003E        /// Returns a default file name (such as \u003Cc\u003E\u0022combined.html\u0022\u003C/c\u003E, \u003Cc\u003E\u0022combined.css\u0022\u003C/c\u003E, or \u003Cc\u003E\u0022combined.js\u0022\u003C/c\u003E) for the given \u003Csee cref=\u0022SiteDumpType\u0022/\u003E.        /// \u003C/summary\u003E        public static string GetSuggestedCombinedFileName(SiteDumpType viewType)        {            return viewType switch            {                SiteDumpType.Html =\u003E \u0022combined.html\u0022,                SiteDumpType.Css =\u003E \u0022combined.css\u0022,                SiteDumpType.JavaScript =\u003E \u0022combined.js\u0022,                _ =\u003E \u0022combined_dump.txt\u0022            };        }        /// \u003Csummary\u003E        /// Resolves the source text and suggested export filename for either a specific \u003Cparamref name=\u0022selectedResource\u0022/\u003E or a combined \u003Cparamref name=\u0022viewType\u0022/\u003E.        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022viewType\u0022\u003EThe combined dump type to view if \u003Cparamref name=\u0022selectedResource\u0022/\u003E is null.\u003C/param\u003E        /// \u003Cparam name=\u0022selectedResource\u0022\u003EAn optional individual resource item to view instead of combined output.\u003C/param\u003E        /// \u003Cparam name=\u0022suggestedFileName\u0022\u003EOutputs the recommended filename for saving the returned content.\u003C/param\u003E        /// \u003Creturns\u003EThe resolved resource or combined source text.\u003C/returns\u003E        public string GetViewContent(SiteDumpType? viewType, SiteResourceItem? selectedResource, out string suggestedFileName)        {            if (selectedResource != null)            {                suggestedFileName = string.IsNullOrWhiteSpace(selectedResource.Name) ? \u0022resource.txt\u0022 : selectedResource.Name;                return selectedResource.Content;            }            var resolvedType = viewType ?? DumpType;            suggestedFileName = GetSuggestedCombinedFileName(resolvedType);            return GetCombinedContent(resolvedType);        }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\SiteResourceItem.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nnamespace BrowserAutomationFramework.Models\n{\n    public enum SiteResourceType\n    {\n        Html,\n        Css,\n        JavaScript\n    }\n\n    public enum SiteDumpType\n    {\n        Html,\n        Css,\n        JavaScript,\n        All\n    }\n\n    public class SiteResourceItem\n    {\n        [JsonPropertyName(\u0022name\u0022)]\n        public string Name { get; set; } = string.Empty;\n\n        [JsonPropertyName(\u0022category\u0022)]\n        public SiteResourceType Category { get; set; } = SiteResourceType.Html;\n\n        [JsonPropertyName(\u0022sourceType\u0022)]\n        public string SourceType { get; set; } = string.Empty;\n\n        [JsonPropertyName(\u0022url\u0022)]\n        public string Url { get; set; } = string.Empty;\n\n        [JsonPropertyName(\u0022content\u0022)]\n        public string Content { get; set;",
      "ModelExplanation": "### Summary of Changes\n\n1. **Verified and Tightened WinForms UI Wrapper (\u0060TestBedApp\u0060)**:\n   - Updated \u0060MainForm\u0060 and \u0060DomTreeView\u0060 so that all domain/model operations delegate directly to \u0060BrowserAutomationFramework\u0060:\n     - \u0060DomTreeView.ApplySnapshot\u0060 now delegates expansion state restoration, default root/body expansion, and target ancestor expansion to \u0060DomTreeSnapshot.PrepareExpandedState\u0060.\n     - \u0060MainForm.BtnAddStep_Click\u0060 and \u0060MainForm.BtnAddScrapeField_Click\u0060 now use \u0060AutomationSequence.AddStep\u0060 and \u0060ScrapeDefinition.AddField\u0060.\n     - \u0060MainForm.BtnRunAutomation_Click\u0060, \u0060MainForm.BtnPreviewScrape_Click\u0060, and \u0060MainForm.BtnRunAllScrapes_Click\u0060 now delegate directly to \u0060BrowserClient\u0060 extension methods (\u0060ExecuteProjectAsync\u0060, \u0060ExecuteScrapeAsync\u0060, \u0060ExecuteProjectScrapesCombinedAsync\u0060) and \u0060AutomationProject.GetActiveSequences()\u0060 / \u0060GetActiveScrapes()\u0060.\n     - \u0060MainForm.BuildSiteDumpOptionsFromUi\u0060 and \u0060MainForm.GetActiveDumpViewerText\u0060 now delegate to \u0060SiteDumpOptions.Create\u0060 and \u0060SiteDumpResult.GetViewContent\u0060.\n\n2. **Full XML API Documentation (\u0060BrowserAutomationFramework\u0060)**:\n   - Added complete XML documentation (\u0060\u003Csummary\u003E\u0060, \u0060\u003Cparam\u003E\u0060, \u0060\u003Creturns\u003E\u0060, \u0060\u003Ctypeparam\u003E\u0060) to every public class, struct, enum, enum value, delegate, event, property, constructor, and method across all namespaces (\u0060Automation\u0060, \u0060Extensions\u0060, \u0060Generators\u0060, \u0060Models\u0060, \u0060ReverseEngineering\u0060, \u0060Scraping\u0060, and \u0060Server\u0060).\n   - Removed the \u0060CS1591\u0060 suppression from \u0060BrowserAutomationFramework.csproj\u0060 so the compiler enforces 100% XML documentation coverage on build.\n\n### How to Test\n1. Build the solution (\u0060dotnet build\u0060) and verify that \u0060BrowserAutomationFramework.xml\u0060 is generated with zero \u0060CS1591\u0060 warnings.\n2. Run \u0060TestBedApp\u0060 and verify that DOM exploration, Automation Editor sequences, Data Scraper previews/runs, and Reverse Engineering dumps operate as expected.",
