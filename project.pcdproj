      "ModelResponse": "Anti-Agent v1.0\n\n--CODESTART--\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Generators\\ScriptGenerator.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n            foreach (var url in options.MatchUrls)\n            {\n                sb.AppendLine($\u0022// @match        {url}\u0022);\n            }\n            sb.AppendLine(\u0022// @grant        GM_xmlhttpRequest\u0022);\n            sb.AppendLine(\u0022// @grant        GM_addElement\u0022);\n            sb.AppendLine(\u0022// @run-at       document-idle\u0022);\n            sb.AppendLine(\u0022// ==/UserScript==\u0022);\n==== REPLACE\n            foreach (var url in options.MatchUrls)\n            {\n                sb.AppendLine($\u0022// @match        {url}\u0022);\n            }\n            sb.AppendLine(\u0022// @connect      127.0.0.1\u0022);\n            sb.AppendLine(\u0022// @connect      localhost\u0022);\n            sb.AppendLine(\u0022// @connect      *\u0022);\n            sb.AppendLine(\u0022// @grant        GM_xmlhttpRequest\u0022);\n            sb.AppendLine(\u0022// @grant        GM_addElement\u0022);\n            sb.AppendLine(\u0022// @run-at       document-idle\u0022);\n            sb.AppendLine(\u0022// ==/UserScript==\u0022);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                if (gmRes \u0026\u0026 (gmRes.retryAfter || gmRes.status === 429)) {\n                    return gmRes;\n                }\n            } catch (e) {}\n        }\n==== REPLACE\n                if (gmRes \u0026\u0026 gmRes.status \u003E 0) {\n                    return gmRes;\n                }\n            } catch (e) {}\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n    registerAction(\u0027EVAL\u0027, async (payload) =\u003E {\n        return new Promise((resolve, reject) =\u003E {\n            const id = \u0027eval_\u0027 \u002B Math.random().toString(36).substr(2, 9);\n            \n            const listener = (e) =\u003E {\n                document.removeEventListener(id, listener);\n                try {\n                    const data = JSON.parse(e.detail);\n                    if (data.err) reject(new Error(data.err));\n                    else resolve(data.res);\n                } catch (err) {\n                    reject(err);\n                }\n            };\n            document.addEventListener(id, listener);\n            \n            const code = \u0060\n                (async function() {\n                    let result = { err: null, res: null };\n                    try {\n                        result.res = await (async function() { ${payload.code} })();\n                    } catch (e) {\n                        result.err = e.message || String(e);\n                    } finally {\n                        document.dispatchEvent(new CustomEvent(\u0027${id}\u0027, { detail: JSON.stringify(result) }));\n                        const s = document.getElementById(\u0027${id}_script\u0027);\n                        if (s) s.remove();\n                    }\n                })();\n            \u0060;\n            \n            try {\n                if (typeof GM_addElement === \u0027function\u0027) {\n                    GM_addElement(\u0027script\u0027, { id: id \u002B \u0027_script\u0027, textContent: code });\n                } else {\n                    const script = document.createElement(\u0027script\u0027);\n                    script.id = id \u002B \u0027_script\u0027;\n                    script.textContent = code;\n                    document.body.appendChild(script);\n                }\n            } catch (e) {\n                document.removeEventListener(id, listener);\n                reject(new Error(\u0027Script injection failed: \u0027 \u002B e.message));\n            }\n        });\n    });\n==== REPLACE\n    registerAction(\u0027EVAL\u0027, async (payload) =\u003E {\n        const evalFallback = async () =\u003E {\n            const AsyncFunction = Object.getPrototypeOf(async function() {}).constructor;\n            const fn = new AsyncFunction(payload.code);\n            return await fn();\n        };\n\n        return new Promise((resolve, reject) =\u003E {\n            const id = \u0027eval_\u0027 \u002B Math.random().toString(36).substr(2, 9);\n            let started = false;\n            let settled = false;\n\n            const cleanup = () =\u003E {\n                document.removeEventListener(id, listener);\n                document.removeEventListener(id \u002B \u0027_start\u0027, startListener);\n                const s = document.getElementById(id \u002B \u0027_script\u0027);\n                if (s) s.remove();\n            };\n\n            const startListener = () =\u003E {\n                started = true;\n            };\n\n            const listener = (e) =\u003E {\n                if (settled) return;\n                settled = true;\n                cleanup();\n                try {\n                    const data = JSON.parse(e.detail);\n                    if (data.err) reject(new Error(data.err));\n                    else resolve(data.res);\n                } catch (err) {\n                    reject(err);\n                }\n            };\n\n            document.addEventListener(id \u002B \u0027_start\u0027, startListener, { once: true });\n            document.addEventListener(id, listener, { once: true });\n\n            const code = \u0060\n                (async function() {\n                    document.dispatchEvent(new CustomEvent(\u0027${id}_start\u0027));\n                    let result = { err: null, res: null };\n                    try {\n                        result.res = await (async function() { ${payload.code} })();\n                    } catch (e) {\n                        result.err = e.message || String(e);\n                    } finally {\n                        document.dispatchEvent(new CustomEvent(\u0027${id}\u0027, { detail: JSON.stringify(result) }));\n                        const s = document.getElementById(\u0027${id}_script\u0027);\n                        if (s) s.remove();\n                    }\n                })();\n            \u0060;\n\n            try {\n                if (typeof GM_addElement === \u0027function\u0027) {\n                    GM_addElement(\u0027script\u0027, { id: id \u002B \u0027_script\u0027, textContent: code });\n                } else {\n                    const script = document.createElement(\u0027script\u0027);\n                    script.id = id \u002B \u0027_script\u0027;\n                    script.textContent = code;\n                    (document.body || document.documentElement).appendChild(script);\n                }\n\n                setTimeout(async () =\u003E {\n                    if (!started \u0026\u0026 !settled) {\n                        settled = true;\n                        cleanup();\n                        try {\n                            const res = await evalFallback();\n                            resolve(res);\n                        } catch (fallbackErr) {\n                            reject(new Error(\u0027Script execution blocked by CSP: \u0027 \u002B (fallbackErr.message || String(fallbackErr))));\n                        }\n                    }\n                }, 60);\n            } catch (e) {\n                if (!settled) {\n                    settled = true;\n                    cleanup();\n                    evalFallback().then(resolve).catch(err =\u003E reject(new Error(\u0027Script injection failed: \u0027 \u002B (err.message || e.message))));\n                }\n            }\n        });\n    });\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            // IPC Logic\n            if (options.Mode == IpcMode.HttpPolling)\n            {\n                sb.AppendLine(@\u0022\n    // --- HTTP Polling IPC ---\n    const API_BASE = \u0060http://127.0.0.1:${PORT}/api\u0060;\n\n    function tmFetch(url, options = {}) {\n        return new Promise((resolve, reject) =\u003E {\n            GM_xmlhttpRequest({\n                method: options.method || \u0027GET\u0027,\n                url: url,\n                data: options.body,\n                headers: { \u0027Content-Type\u0027: \u0027application/json\u0027 },\n                onload: (res) =\u003E resolve(JSON.parse(res.responseText || \u0027{}\u0027)),\n                onerror: reject\n            });\n        });\n    }\n\n    async function sendResult(taskId, status, output) {\n        const outStr = typeof output === \u0027object\u0027 ? JSON.stringify(output) : String(output);\n        await tmFetch(\u0060${API_BASE}/result/${INSTANCE_ID}\u0060, {\n            method: \u0027POST\u0027,\n            body: JSON.stringify({ task_id: taskId, status: status, output: outStr })\n        });\n    }\n\n    async function sendEvent(eventName, payload) {\n        await tmFetch(\u0060${API_BASE}/event/${INSTANCE_ID}\u0060, {\n            method: \u0027POST\u0027,\n            body: JSON.stringify({ event: eventName, payload: payload })\n        });\n    }\n\n    // Expose streaming capability to handlers\n    window.streamData = async function(taskId, data) {\n        await sendResult(taskId, \u0027streaming\u0027, data);\n    };\n\n    async function pollServer() {\n        try {\n            const data = await tmFetch(\u0060${API_BASE}/command/${INSTANCE_ID}\u0060);\n            if (data \u0026\u0026 data.command) {\n                const { id, type, payload } = data.command;\n                const handler = actionHandlers[type];\n                \n                if (handler) {\n                    try {\n                        const result = await handler(payload);\n                        await sendResult(id, \u0027completed\u0027, result);\n                    } catch (err) {\n                        await sendResult(id, \u0027error\u0027, err.message);\n                    }\n                } else {\n                    await sendResult(id, \u0027error\u0027, \u0027Unknown command: \u0027 \u002B type);\n                }\n            }\n        } catch (e) {\n            // Server offline or timeout\n        } finally {\n            setTimeout(pollServer, \u0022 \u002B options.PollingIntervalMs \u002B @\u0022);\n        }\n    }\n\n    waitForDocumentComplete(30000).then(state =\u003E {\n        sendEvent(\u0027PAGE_LOADED\u0027, state);\n        sendEvent(\u0027DOM_CHANGED\u0027, { highlightedPath: null });\n    });\n\n    pollServer();\n\u0022);\n            }\n            else if (options.Mode == IpcMode.WebSocket)\n            {\n                sb.AppendLine(@\u0022\n    // --- WebSocket IPC ---\n    let ws;\n\n    function connectWebSocket() {\n        ws = new WebSocket(\u0060ws://127.0.0.1:${PORT}/?instanceId=${INSTANCE_ID}\u0060);\n        \n        ws.onopen = async () =\u003E {\n            console.log(\u0027WebSocket connected\u0027);\n            const state = await waitForDocumentComplete(30000);\n            sendEvent(\u0027PAGE_LOADED\u0027, state);\n            sendEvent(\u0027DOM_CHANGED\u0027, { highlightedPath: null });\n        };\n        \n        ws.onmessage = async (event) =\u003E {\n            const cmd = JSON.parse(event.data);\n            const { id, type, payload } = cmd;\n            const handler = actionHandlers[type];\n            \n            if (handler) {\n                try {\n                    const result = await handler(payload);\n                    sendResult(id, \u0027completed\u0027, result);\n                } catch (err) {\n                    sendResult(id, \u0027error\u0027, err.message);\n                }\n            } else {\n                sendResult(id, \u0027error\u0027, \u0027Unknown command: \u0027 \u002B type);\n            }\n        };\n\n        ws.onclose = () =\u003E {\n            console.log(\u0027WebSocket disconnected, reconnecting...\u0027);\n            setTimeout(connectWebSocket, 2000);\n        };\n    }\n\n    function sendResult(taskId, status, output) {\n        if (ws \u0026\u0026 ws.readyState === WebSocket.OPEN) {\n            const outStr = typeof output === \u0027object\u0027 ? JSON.stringify(output) : String(output);\n            ws.send(JSON.stringify({ task_id: taskId, status: status, output: outStr }));\n        }\n    }\n\n    function sendEvent(eventName, payload) {\n        if (ws \u0026\u0026 ws.readyState === WebSocket.OPEN) {\n            ws.send(JSON.stringify({ event: eventName, payload: payload }));\n        }\n    }\n\n    // Expose streaming capability to handlers\n    window.streamData = async function(taskId, data) {\n        sendResult(taskId, \u0027streaming\u0027, data);\n    };\n\n    connectWebSocket();\n\u0022);\n            }\n==== REPLACE\n            // IPC Logic (Unified WebSocket \u002B CSP-safe GM_xmlhttpRequest fallback)\n            string preferredMode = options.Mode == IpcMode.WebSocket ? \u0022ws\u0022 : \u0022http\u0022;\n            int configuredPollMs = options.Mode == IpcMode.WebSocket\n                ? System.Math.Min(options.PollingIntervalMs, 150)\n                : options.PollingIntervalMs;\n\n            sb.AppendLine(@\u0022\n    // --- Unified IPC Engine (WebSocket \u002B CSP-Safe GM_xmlhttpRequest Transport) ---\n    const API_BASE = \u0060http://127.0.0.1:${PORT}/api\u0060;\n    const PREFERRED_MODE = \u0027\u0022 \u002B preferredMode \u002B @\u0022\u0027;\n    const HTTP_POLL_INTERVAL_MS = \u0022 \u002B configuredPollMs \u002B @\u0022;\n    let activeTransport = PREFERRED_MODE;\n    let ws = null;\n    let wsBlockedByCsp = false;\n    let httpPollingActive = false;\n    let httpServerConnected = false;\n\n    function tmFetch(url, options = {}) {\n        return new Promise((resolve, reject) =\u003E {\n            const reqFn = (typeof GM_xmlhttpRequest === \u0027function\u0027)\n                ? GM_xmlhttpRequest\n                : (typeof GM !== \u0027undefined\u0027 \u0026\u0026 typeof GM.xmlHttpRequest === \u0027function\u0027 ? GM.xmlHttpRequest.bind(GM) : null);\n\n            if (!reqFn) {\n                fetch(url, {\n                    method: options.method || \u0027GET\u0027,\n                    body: options.body,\n                    headers: { \u0027Content-Type\u0027: \u0027application/json\u0027 }\n                })\n                .then(r =\u003E r.text())\n                .then(t =\u003E {\n                    try { resolve(JSON.parse(t || \u0027{}\u0027)); }\n                    catch (err) { resolve({}); }\n                })\n                .catch(reject);\n                return;\n            }\n\n            reqFn({\n                method: options.method || \u0027GET\u0027,\n                url: url,\n                data: options.body,\n                headers: { \u0027Content-Type\u0027: \u0027application/json\u0027 },\n                timeout: options.timeout || 10000,\n                onload: (res) =\u003E {\n                    if (res.status \u003E= 200 \u0026\u0026 res.status \u003C 300) {\n                        try {\n                            resolve(JSON.parse(res.responseText || \u0027{}\u0027));\n                        } catch (err) {\n                            resolve({});\n                        }\n                    } else {\n                        reject(new Error(\u0027HTTP \u0027 \u002B res.status));\n                    }\n                },\n                onerror: (err) =\u003E reject(err || new Error(\u0027Network error\u0027)),\n                ontimeout: () =\u003E reject(new Error(\u0027Request timeout\u0027)),\n                onabort: () =\u003E reject(new Error(\u0027Request aborted\u0027))\n            });\n        });\n    }\n\n    async function sendHttpResult(taskId, status, outStr) {\n        try {\n            await tmFetch(\u0060${API_BASE}/result/${INSTANCE_ID}\u0060, {\n                method: \u0027POST\u0027,\n                body: JSON.stringify({ task_id: taskId, status: status, output: outStr })\n            });\n        } catch (e) {}\n    }\n\n    async function sendHttpEvent(eventName, payload) {\n        try {\n            await tmFetch(\u0060${API_BASE}/event/${INSTANCE_ID}\u0060, {\n                method: \u0027POST\u0027,\n                body: JSON.stringify({ event: eventName, payload: payload })\n            });\n        } catch (e) {}\n    }\n\n    async function sendResult(taskId, status, output) {\n        const outStr = typeof output === \u0027object\u0027 ? JSON.stringify(output) : String(output);\n        if (activeTransport === \u0027ws\u0027 \u0026\u0026 ws \u0026\u0026 ws.readyState === WebSocket.OPEN) {\n            try {\n                ws.send(JSON.stringify({ task_id: taskId, status: status, output: outStr }));\n                return;\n            } catch (e) {}\n        }\n        await sendHttpResult(taskId, status, outStr);\n    }\n\n    async function sendEvent(eventName, payload) {\n        if (activeTransport === \u0027ws\u0027 \u0026\u0026 ws \u0026\u0026 ws.readyState === WebSocket.OPEN) {\n            try {\n                ws.send(JSON.stringify({ event: eventName, payload: payload }));\n                return;\n            } catch (e) {}\n        }\n        if (activeTransport === \u0027http\u0027) {\n            await sendHttpEvent(eventName, payload);\n        }\n    }\n\n    window.streamData = async function(taskId, data) {\n        await sendResult(taskId, \u0027streaming\u0027, data);\n    };\n\n    async function announcePageReady() {\n        const state = await waitForDocumentComplete(30000);\n        await sendEvent(\u0027PAGE_LOADED\u0027, state);\n        const currentHighlightedPath = (highlightedElement \u0026\u0026 highlightedElement.isConnected)\n            ? getElementPath(highlightedElement)\n            : null;\n        await sendEvent(\u0027DOM_CHANGED\u0027, { highlightedPath: currentHighlightedPath });\n    }\n\n    function markWebSocketBlockedByCsp() {\n        wsBlockedByCsp = true;\n        try { sessionStorage.setItem(\u0027__baf_ws_csp_blocked\u0027, \u00271\u0027); } catch (e) {}\n        try { localStorage.setItem(\u0027__baf_ws_csp_blocked\u0027, \u00271\u0027); } catch (e) {}\n    }\n\n    function isWebSocketLikelyBlockedByCsp() {\n        if (wsBlockedByCsp) return true;\n        try {\n            if (sessionStorage.getItem(\u0027__baf_ws_csp_blocked\u0027) === \u00271\u0027 ||\n                localStorage.getItem(\u0027__baf_ws_csp_blocked\u0027) === \u00271\u0027) {\n                wsBlockedByCsp = true;\n                return true;\n            }\n            const metaTags = document.querySelectorAll(\u0027meta[http-equiv=\u0022\u0022Content-Security-Policy\u0022\u0022 i]\u0027);\n            for (const meta of metaTags) {\n                const content = (meta.getAttribute(\u0027content\u0027) || \u0027\u0027).toLowerCase();\n                if (content.includes(\u0027connect-src\u0027) || content.includes(\u0027default-src\u0027)) {\n                    if (!content.includes(\u0027127.0.0.1\u0027) \u0026\u0026 !content.includes(\u0027localhost\u0027) \u0026\u0026 !content.includes(\u0027ws:\u0027) \u0026\u0026 !content.includes(\u0027connect-src *\u0027)) {\n                        markWebSocketBlockedByCsp();\n                        return true;\n                    }\n                }\n            }\n        } catch (e) {}\n        return false;\n    }\n\n    function startHttpPolling(reason) {\n        activeTransport = \u0027http\u0027;\n        if (httpPollingActive) return;\n        httpPollingActive = true;\n        if (reason) {\n            console.log(\u0027[Automation Bridge] Using HTTP GM_xmlhttpRequest IPC (\u0027 \u002B reason \u002B \u0027)\u0027);\n        }\n        pollServer();\n    }\n\n    async function pollServer() {\n        if (activeTransport !== \u0027http\u0027) {\n            httpPollingActive = false;\n            return;\n        }\n        let hadCommand = false;\n        try {\n            const data = await tmFetch(\u0060${API_BASE}/command/${INSTANCE_ID}\u0060);\n            if (!httpServerConnected) {\n                httpServerConnected = true;\n                announcePageReady();\n            }\n            if (data \u0026\u0026 data.command) {\n                hadCommand = true;\n                const { id, type, payload } = data.command;\n                const handler = actionHandlers[type];\n\n                if (handler) {\n                    try {\n                        const result = await handler(payload);\n                        await sendResult(id, \u0027completed\u0027, result);\n                    } catch (err) {\n                        await sendResult(id, \u0027error\u0027, err \u0026\u0026 err.message ? err.message : String(err));\n                    }\n                } else {\n                    await sendResult(id, \u0027error\u0027, \u0027Unknown command: \u0027 \u002B type);\n                }\n            }\n        } catch (e) {\n            httpServerConnected = false;\n        } finally {\n            if (activeTransport === \u0027http\u0027) {\n                setTimeout(pollServer, hadCommand ? 10 : HTTP_POLL_INTERVAL_MS);\n            } else {\n                httpPollingActive = false;\n            }\n        }\n    }\n\n    const onCspViolation = (e) =\u003E {\n        const directive = ((e \u0026\u0026 (e.effectiveDirective || e.violatedDirective)) || \u0027\u0027).toLowerCase();\n        const blockedUri = ((e \u0026\u0026 e.blockedURI) || \u0027\u0027).toLowerCase();\n        if (directive.startsWith(\u0027connect-src\u0027) || directive.startsWith(\u0027default-src\u0027) ||\n            blockedUri.includes(\u0027127.0.0.1\u0027) || blockedUri.includes(\u0027localhost\u0027) || blockedUri.startsWith(\u0027ws\u0027)) {\n            if (PREFERRED_MODE === \u0027ws\u0027 \u0026\u0026 activeTransport !== \u0027http\u0027) {\n                markWebSocketBlockedByCsp();\n                if (ws) {\n                    try { ws.onclose = null; ws.onerror = null; ws.close(); } catch (err) {}\n                    ws = null;\n                }\n                startHttpPolling(\u0027WebSocket blocked by page Content-Security-Policy\u0027);\n            }\n        }\n    };\n    window.addEventListener(\u0027securitypolicyviolation\u0027, onCspViolation, true);\n    document.addEventListener(\u0027securitypolicyviolation\u0027, onCspViolation, true);\n\n    function connectWebSocket() {\n        if (activeTransport === \u0027http\u0027 || isWebSocketLikelyBlockedByCsp()) {\n            startHttpPolling(\u0027CSP fallback\u0027);\n            return;\n        }\n\n        let wsOpened = false;\n        try {\n            ws = new WebSocket(\u0060ws://127.0.0.1:${PORT}/?instanceId=${INSTANCE_ID}\u0060);\n        } catch (err) {\n            markWebSocketBlockedByCsp();\n            startHttpPolling(\u0027WebSocket constructor blocked: \u0027 \u002B (err.message || err));\n            return;\n        }\n\n        ws.onopen = async () =\u003E {\n            wsOpened = true;\n            activeTransport = \u0027ws\u0027;\n            console.log(\u0027[Automation Bridge] WebSocket connected\u0027);\n            await announcePageReady();\n        };\n\n        ws.onmessage = async (event) =\u003E {\n            const cmd = JSON.parse(event.data);\n            const { id, type, payload } = cmd;\n            const handler = actionHandlers[type];\n\n            if (handler) {\n                try {\n                    const result = await handler(payload);\n                    await sendResult(id, \u0027completed\u0027, result);\n                } catch (err) {\n                    await sendResult(id, \u0027error\u0027, err \u0026\u0026 err.message ? err.message : String(err));\n                }\n            } else {\n                await sendResult(id, \u0027error\u0027, \u0027Unknown command: \u0027 \u002B type);\n            }\n        };\n\n        ws.onclose = async () =\u003E {\n            if (activeTransport === \u0027http\u0027 || isWebSocketLikelyBlockedByCsp()) {\n                startHttpPolling(\u0027CSP fallback\u0027);\n                return;\n            }\n            if (!wsOpened) {\n                try {\n                    await tmFetch(\u0060${API_BASE}/event/${INSTANCE_ID}\u0060, {\n                        method: \u0027POST\u0027,\n                        body: JSON.stringify({ event: \u0027PING\u0027, payload: null }),\n                        timeout: 2500\n                    });\n                    markWebSocketBlockedByCsp();\n                    startHttpPolling(\u0027WebSocket blocked while HTTP server is reachable\u0027);\n                    return;\n                } catch (probeErr) {\n                    // Server offline; retry WebSocket\n                }\n            }\n            console.log(\u0027[Automation Bridge] WebSocket disconnected, reconnecting...\u0027);\n            setTimeout(connectWebSocket, 2000);\n        };\n    }\n\n    if (PREFERRED_MODE === \u0027ws\u0027 \u0026\u0026 !isWebSocketLikelyBlockedByCsp()) {\n        connectWebSocket();\n    } else {\n        startHttpPolling(PREFERRED_MODE === \u0027ws\u0027 ? \u0027Cached CSP fallback\u0027 : null);\n    }\n\u0022);\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Server\\BrowserClient.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n    public class BrowserClient\n    {\n        public string InstanceId { get; }\n        public IpcMode Mode { get; }\n        public DateTime LastSeen { get; internal set; } = DateTime.UtcNow;\n==== REPLACE\n    public class BrowserClient\n    {\n        public string InstanceId { get; }\n        public IpcMode Mode { get; private set; }\n        public DateTime LastSeen { get; internal set; } = DateTime.UtcNow;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        /// \u003Csummary\u003E\n        /// Triggered when a page finishes loading (document.readyState === \u0027complete\u0027).\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CPageLoadedEventArgs\u003E? OnPageLoaded;\n\n        public BrowserClient(string instanceId, IpcMode mode, WebSocket? webSocket = null)\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Triggered when a page finishes loading (document.readyState === \u0027complete\u0027).\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CPageLoadedEventArgs\u003E? OnPageLoaded;\n\n        /// \u003Csummary\u003E\n        /// Triggered when the client switches IPC transport modes (e.g., WebSocket to HttpPolling CSP fallback).\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CIpcMode\u003E? OnModeChanged;\n\n        public BrowserClient(string instanceId, IpcMode mode, WebSocket? webSocket = null)\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        internal async Task AttachWebSocketAsync(WebSocket webSocket, CancellationToken cancellationToken = default)\n        {\n            _webSocket = webSocket;\n            LastSeen = DateTime.UtcNow;\n\n            var oldTcs = Interlocked.Exchange(ref _wsReconnectTcs, new TaskCompletionSource\u003Cbool\u003E(TaskCreationOptions.RunContinuationsAsynchronously));\n            oldTcs.TrySetResult(true);\n            _wsReconnectTcs.TrySetResult(true);\n\n            // Complete any navigation/click commands that triggered the page unload rather than re-sending them to the new page\n            foreach (var entry in _pendingCommands.Values)\n            {\n                if (!entry.Tcs.Task.IsCompleted)\n                {\n                    string cmdType = entry.Command.Type ?? string.Empty;\n                    if (string.Equals(cmdType, \u0022REACT_CLICK\u0022, StringComparison.OrdinalIgnoreCase) ||\n                        string.Equals(cmdType, \u0022NAVIGATE\u0022, StringComparison.OrdinalIgnoreCase) ||\n                        string.Equals(cmdType, \u0022RELOAD_PAGE\u0022, StringComparison.OrdinalIgnoreCase))\n                    {\n                        entry.Tcs.TrySetResult(new CommandResult\n                        {\n                            TaskId = entry.Command.Id,\n                            Status = \u0022completed\u0022,\n                            Output = \u0022Link click executed (page navigated)\u0022\n                        });\n                        continue;\n                    }\n\n                    try\n                    {\n                        await SendWebSocketMessageAsync(webSocket, entry.Command, cancellationToken);\n                    }\n                    catch\n                    {\n                        // Will be retried on next reconnect if socket dropped\n                    }\n                }\n            }\n        }\n==== REPLACE\n        internal async Task AttachWebSocketAsync(WebSocket webSocket, CancellationToken cancellationToken = default)\n        {\n            bool modeChanged = Mode != IpcMode.WebSocket;\n            Mode = IpcMode.WebSocket;\n            _webSocket = webSocket;\n            LastSeen = DateTime.UtcNow;\n\n            if (modeChanged)\n            {\n                OnModeChanged?.Invoke(this, Mode);\n            }\n\n            var oldTcs = Interlocked.Exchange(ref _wsReconnectTcs, new TaskCompletionSource\u003Cbool\u003E(TaskCreationOptions.RunContinuationsAsynchronously));\n            oldTcs.TrySetResult(true);\n            _wsReconnectTcs.TrySetResult(true);\n\n            // Complete any navigation/click commands that triggered the page unload rather than re-sending them to the new page\n            foreach (var entry in _pendingCommands.Values)\n            {\n                if (!entry.Tcs.Task.IsCompleted)\n                {\n                    string cmdType = entry.Command.Type ?? string.Empty;\n                    if (string.Equals(cmdType, \u0022REACT_CLICK\u0022, StringComparison.OrdinalIgnoreCase) ||\n                        string.Equals(cmdType, \u0022NAVIGATE\u0022, StringComparison.OrdinalIgnoreCase) ||\n                        string.Equals(cmdType, \u0022RELOAD_PAGE\u0022, StringComparison.OrdinalIgnoreCase))\n                    {\n                        entry.Tcs.TrySetResult(new CommandResult\n                        {\n                            TaskId = entry.Command.Id,\n                            Status = \u0022completed\u0022,\n                            Output = \u0022Link click executed (page navigated)\u0022\n                        });\n                        continue;\n                    }\n\n                    try\n                    {\n                        await SendWebSocketMessageAsync(webSocket, entry.Command, cancellationToken);\n                    }\n                    catch\n                    {\n                        // Will be retried on next reconnect if socket dropped\n                    }\n                }\n            }\n        }\n\n        internal void TouchHttpPolling()\n        {\n            LastSeen = DateTime.UtcNow;\n            if (!IsWebSocketConnected)\n            {\n                bool modeChanged = Mode != IpcMode.HttpPolling;\n                if (modeChanged)\n                {\n                    Mode = IpcMode.HttpPolling;\n                    OnModeChanged?.Invoke(this, Mode);\n\n                    var oldTcs = Interlocked.Exchange(ref _wsReconnectTcs, new TaskCompletionSource\u003Cbool\u003E(TaskCreationOptions.RunContinuationsAsynchronously));\n                    oldTcs.TrySetResult(true);\n                    _wsReconnectTcs.TrySetResult(true);\n\n                    foreach (var entry in _pendingCommands.Values)\n                    {\n                        if (!entry.Tcs.Task.IsCompleted)\n                        {\n                            string cmdType = entry.Command.Type ?? string.Empty;\n                            if (string.Equals(cmdType, \u0022REACT_CLICK\u0022, StringComparison.OrdinalIgnoreCase) ||\n                                string.Equals(cmdType, \u0022NAVIGATE\u0022, StringComparison.OrdinalIgnoreCase) ||\n                                string.Equals(cmdType, \u0022RELOAD_PAGE\u0022, StringComparison.OrdinalIgnoreCase))\n                            {\n                                entry.Tcs.TrySetResult(new CommandResult\n                                {\n                                    TaskId = entry.Command.Id,\n                                    Status = \u0022completed\u0022,\n                                    Output = \u0022Link click executed (page navigated)\u0022\n                                });\n                                continue;\n                            }\n\n                            EnqueueHttpCommandIfNotPresent(entry.Command);\n                        }\n                    }\n                }\n            }\n        }\n\n        private void EnqueueHttpCommandIfNotPresent(CommandMessage cmd)\n        {\n            foreach (var existing in _httpCommandQueue)\n            {\n                if (string.Equals(existing.Id, cmd.Id, StringComparison.Ordinal))\n                    return;\n            }\n            _httpCommandQueue.Enqueue(cmd);\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private async Task\u003CWebSocket\u003E WaitForActiveWebSocketAsync(int timeoutMs, CancellationToken cancellationToken)\n        {\n            var current = _webSocket;\n            if (current != null \u0026\u0026 current.State == WebSocketState.Open)\n                return current;\n\n            using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);\n            timeoutCts.CancelAfter(timeoutMs);\n\n            await using (timeoutCts.Token.Register(() =\u003E _wsReconnectTcs.TrySetCanceled()))\n            {\n                try\n                {\n                    await _wsReconnectTcs.Task;\n                }\n                catch (OperationCanceledException) when (!cancellationToken.IsCancellationRequested)\n                {\n                    throw new TimeoutException(\u0022Timed out waiting for browser client WebSocket to reconnect after navigation.\u0022);\n                }\n            }\n\n            current = _webSocket;\n            if (current != null \u0026\u0026 current.State == WebSocketState.Open)\n                return current;\n\n            throw new InvalidOperationException(\u0022Client is disconnected.\u0022);\n        }\n\n        /// \u003Csummary\u003E\n        /// Sends a command to the browser and awaits the final result.\n        /// Automatically handles transient WebSocket reconnections during full-page navigations.\n        /// \u003C/summary\u003E\n        public async Task\u003CCommandResult\u003E SendCommandAsync(string type, object? payload = null, CancellationToken cancellationToken = default)\n        {\n            var cmd = new CommandMessage { Type = type, Payload = payload };\n            var tcs = new TaskCompletionSource\u003CCommandResult\u003E(TaskCreationOptions.RunContinuationsAsynchronously);\n            _pendingCommands.TryAdd(cmd.Id, (cmd, tcs));\n\n            try\n            {\n                if (Mode == IpcMode.WebSocket)\n                {\n                    var socket = await WaitForActiveWebSocketAsync(15000, cancellationToken);\n                    try\n                    {\n                        await SendWebSocketMessageAsync(socket, cmd, cancellationToken);\n                    }\n                    catch when (!cancellationToken.IsCancellationRequested)\n                    {\n                        // If the socket closed mid-send due to page unload, AttachWebSocketAsync will re-transmit cmd\n                    }\n                }\n                else if (Mode == IpcMode.HttpPolling)\n                {\n                    _httpCommandQueue.Enqueue(cmd);\n                }\n                else\n                {\n                    throw new InvalidOperationException(\u0022Client is disconnected or invalid IPC mode.\u0022);\n                }\n==== REPLACE\n        private async Task\u003CWebSocket?\u003E WaitForActiveWebSocketOrFallbackAsync(int timeoutMs, CancellationToken cancellationToken)\n        {\n            var current = _webSocket;\n            if (current != null \u0026\u0026 current.State == WebSocketState.Open)\n                return current;\n\n            if (Mode == IpcMode.HttpPolling)\n                return null;\n\n            using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);\n            timeoutCts.CancelAfter(timeoutMs);\n\n            await using (timeoutCts.Token.Register(() =\u003E _wsReconnectTcs.TrySetCanceled()))\n            {\n                try\n                {\n                    await _wsReconnectTcs.Task;\n                }\n                catch (OperationCanceledException) when (!cancellationToken.IsCancellationRequested)\n                {\n                    if (Mode == IpcMode.HttpPolling)\n                        return null;\n\n                    throw new TimeoutException(\u0022Timed out waiting for browser client WebSocket to reconnect after navigation.\u0022);\n                }\n            }\n\n            current = _webSocket;\n            if (current != null \u0026\u0026 current.State == WebSocketState.Open)\n                return current;\n\n            if (Mode == IpcMode.HttpPolling)\n                return null;\n\n            throw new InvalidOperationException(\u0022Client is disconnected.\u0022);\n        }\n\n        /// \u003Csummary\u003E\n        /// Sends a command to the browser and awaits the final result.\n        /// Automatically handles transient WebSocket reconnections and CSP HTTP fallback during full-page navigations.\n        /// \u003C/summary\u003E\n        public async Task\u003CCommandResult\u003E SendCommandAsync(string type, object? payload = null, CancellationToken cancellationToken = default)\n        {\n            var cmd = new CommandMessage { Type = type, Payload = payload };\n            var tcs = new TaskCompletionSource\u003CCommandResult\u003E(TaskCreationOptions.RunContinuationsAsynchronously);\n            _pendingCommands.TryAdd(cmd.Id, (cmd, tcs));\n\n            try\n            {\n                if (Mode == IpcMode.WebSocket)\n                {\n                    var socket = await WaitForActiveWebSocketOrFallbackAsync(15000, cancellationToken);\n                    if (socket != null)\n                    {\n                        try\n                        {\n                            await SendWebSocketMessageAsync(socket, cmd, cancellationToken);\n                        }\n                        catch when (!cancellationToken.IsCancellationRequested)\n                        {\n                            if (Mode == IpcMode.HttpPolling)\n                            {\n                                EnqueueHttpCommandIfNotPresent(cmd);\n                            }\n                        }\n                    }\n                    else\n                    {\n                        EnqueueHttpCommandIfNotPresent(cmd);\n                    }\n                }\n                else if (Mode == IpcMode.HttpPolling)\n                {\n                    EnqueueHttpCommandIfNotPresent(cmd);\n                }\n                else\n                {\n                    throw new InvalidOperationException(\u0022Client is disconnected or invalid IPC mode.\u0022);\n                }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Server\\AutomationServer.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        private void CleanupStaleClients(object? state)\n        {\n            var now = DateTime.UtcNow;\n            var httpThreshold = now.AddSeconds(-10);\n            var wsThreshold = now.AddSeconds(-15);\n==== REPLACE\n        private void CleanupStaleClients(object? state)\n        {\n            var now = DateTime.UtcNow;\n            var httpThreshold = now.AddSeconds(-15);\n            var wsThreshold = now.AddSeconds(-15);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                if (path.StartsWith(\u0022/api/command/\u0022))\n                {\n                    string instanceId = path.Substring(\u0022/api/command/\u0022.Length);\n                    var client = GetOrAddClient(instanceId, IpcMode.HttpPolling);\n                    client.LastSeen = DateTime.UtcNow;\n\n                    if (client.TryGetNextHttpCommand(out var cmd))\n                    {\n                        await SendJsonAsync(response, new { command = cmd });\n                    }\n                    else\n                    {\n                        await SendJsonAsync(response, new { status = \u0022idle\u0022 });\n                    }\n                }\n                else if (path.StartsWith(\u0022/api/result/\u0022))\n                {\n                    string instanceId = path.Substring(\u0022/api/result/\u0022.Length);\n                    var client = GetOrAddClient(instanceId, IpcMode.HttpPolling);\n                    client.LastSeen = DateTime.UtcNow;\n\n                    using var reader = new StreamReader(request.InputStream);\n                    string body = await reader.ReadToEndAsync(cancellationToken);\n                    var result = JsonSerializer.Deserialize\u003CCommandResult\u003E(body);\n\n                    if (result != null)\n                    {\n                        client.HandleResult(result);\n                    }\n\n                    await SendJsonAsync(response, new { status = \u0022acknowledged\u0022 });\n                }\n                else if (path.StartsWith(\u0022/api/event/\u0022))\n                {\n                    string instanceId = path.Substring(\u0022/api/event/\u0022.Length);\n                    var client = GetOrAddClient(instanceId, IpcMode.HttpPolling);\n                    client.LastSeen = DateTime.UtcNow;\n==== REPLACE\n                if (path.StartsWith(\u0022/api/command/\u0022))\n                {\n                    string instanceId = path.Substring(\u0022/api/command/\u0022.Length);\n                    var client = GetOrAddClient(instanceId, IpcMode.HttpPolling);\n                    client.TouchHttpPolling();\n\n                    if (client.TryGetNextHttpCommand(out var cmd))\n                    {\n                        await SendJsonAsync(response, new { command = cmd });\n                    }\n                    else\n                    {\n                        await SendJsonAsync(response, new { status = \u0022idle\u0022 });\n                    }\n                }\n                else if (path.StartsWith(\u0022/api/result/\u0022))\n                {\n                    string instanceId = path.Substring(\u0022/api/result/\u0022.Length);\n                    var client = GetOrAddClient(instanceId, IpcMode.HttpPolling);\n                    client.TouchHttpPolling();\n\n                    using var reader = new StreamReader(request.InputStream);\n                    string body = await reader.ReadToEndAsync(cancellationToken);\n                    var result = JsonSerializer.Deserialize\u003CCommandResult\u003E(body);\n\n                    if (result != null)\n                    {\n                        client.HandleResult(result);\n                    }\n\n                    await SendJsonAsync(response, new { status = \u0022acknowledged\u0022 });\n                }\n                else if (path.StartsWith(\u0022/api/event/\u0022))\n                {\n                    string instanceId = path.Substring(\u0022/api/event/\u0022.Length);\n                    var client = GetOrAddClient(instanceId, IpcMode.HttpPolling);\n                    client.TouchHttpPolling();\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        private void Server_OnClientConnected(object? sender, BrowserClient client)\n        {\n            Log($\u0022[SYS] Client Connected: {client.InstanceId} via {client.Mode}\u0022, Color.LimeGreen);\n            \n            client.OnStreamDataReceived \u002B= (s, res) =\u003E\n==== REPLACE\n        private void Server_OnClientConnected(object? sender, BrowserClient client)\n        {\n            Log($\u0022[SYS] Client Connected: {client.InstanceId} via {client.Mode}\u0022, Color.LimeGreen);\n\n            client.OnModeChanged \u002B= (s, newMode) =\u003E\n            {\n                Log($\u0022[SYS] Client {client.InstanceId} switched IPC transport to {newMode}.\u0022, Color.Cyan);\n            };\n            \n            client.OnStreamDataReceived \u002B= (s, res) =\u003E\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
