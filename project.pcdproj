nToken cancellationToken = default)        {            _webSocket = webSocket;            LastSeen = DateTime.UtcNow;            var oldTcs = Interlocked.Exchange(ref _wsReconnectTcs, new TaskCompletionSource\u003Cbool\u003E(TaskCreationOptions.RunContinuationsAsynchronously));            oldTcs.TrySetResult(true);            _wsReconnectTcs.TrySetResult(true);            // Re-send any pending commands that were interrupted during page navigation            foreach (var entry in _pendingCommands.Values)            {                if (!entry.Tcs.Task.IsCompleted)                {                    try                    {                        await SendWebSocketMessageAsync(webSocket, entry.Command, cancellationToken);                    }                    catch                    {                        // Will be retried on next reconnect if socket dropped                    }                }            }        }        internal void DetachWebSocket(WebSocket webSocket)        {            LastSeen = DateTime.UtcNow;            if (ReferenceEquals(_webSocket, webSocket))            {                _webSocket = null;                Interlocked.Exchange(ref _wsReconnectTcs, new TaskCompletionSource\u003Cbool\u003E(TaskCreationOptions.RunContinuationsAsynchronously));            }        }        private async Task SendWebSocketMessageAsync(WebSocket socket, CommandMessage cmd, CancellationToken cancellationToken)        {            var json = JsonSerializer.Serialize(cmd);            var bytes = Encoding.UTF8.GetBytes(json);            await _wsSendLock.WaitAsync(cancellationToken);            try            {                if (socket.State == WebSocketState.Open)                {                    await socket.SendAsync(new ArraySegment\u003Cbyte\u003E(bytes), WebSocketMessageType.Text, true, cancellationToken);                }            }            finally            {                _wsSendLock.Release();            }        }        private asyn