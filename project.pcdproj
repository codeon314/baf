  UpsertClientInListUi(activeClient);\n            }\n\n            _isUpdatingClientsList = true;\n            try\n            {\n                lstClients.SelectedItem = activeClient;\n            }\n            finally\n            {\n                _isUpdatingClientsList = false;\n            }\n\n            if (activeClient != null)\n            {\n                await RefreshDomAsync(activeClient);\n            }\n            else\n            {\n                tvDom.Clear();\n                txtElementDetails.Text = string.Empty;\n            }\n        }\n\n        private void Server_OnClientDisconnected(object? sender, BrowserClient client)\n        {\n            Log($\u0022[SYS] Client Disconnected: {client.InstanceId}\u0022, Color.Orange);\n            if (InvokeRequired)\n            {\n                BeginInvoke(new Action(() =\u003E HandleClientRemovedFromUi(client)));\n            }\n            else\n            {\n                HandleClientRemovedFromUi(client);\n            }\n        }\n\n        private void HandleClientRemovedFromUi(BrowserClient client)\n        {\n            _isUpdatingClientsList = true;\n            try\n            {\n                for (int i = lstClients.Items.Count - 1; i \u003E= 0; i--)\n                {\n                    if (lstClients.Items[i] is BrowserClient item \u0026\u0026 item.InstanceId == client.InstanceId)\n                    {\n                        lstClients.Items.RemoveAt(i);\n                    }\n                }\n            }\n            finally\n            {\n                _isUpdatingClientsList = false;\n            }\n\n            if (lstClients.Items.Count == 0)\n            {\n                tvDom.Clear();\n                txtElementDetails.Text = string.Empty;\n            }\n        }\n\n        private void LstClients_SelectedIndexChanged(object? sender, EventArgs e)\n        {\n            if (_isUpdatingClientsList) return;\n\n            var selected = lstClients.SelectedItem as BrowserClient;\n            if (_server != null)\n            {\n                _server.ActiveClient = selected;\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            if (_project.GetActiveSequences().Count == 0)\n            {\n                Log(\u0022[WARN] No active automation lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n==== REPLACE\n            if (!_project.HasActiveSequences)\n            {\n                Log(\u0022[WARN] No active automation lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            chkExclusiveTab = new CheckBox\n            {\n                Text = \u0022Auto-switch (single active tab)\u0022,\n                Checked = true,\n                AutoSize = true,\n                Margin = new Padding(0, ScaleDpi(2), 0, ScaleDpi(4))\n            };\n==== REPLACE\n            chkExclusiveTab = new CheckBox\n            {\n                Text = \u0022Auto-switch (single active tab)\u0022,\n                Checked = true,\n                AutoSize = true,\n                Margin = new Padding(0, ScaleDpi(2), 0, ScaleDpi(4))\n            };\n            chkExclusiveTab.CheckedChanged \u002B= (s, e) =\u003E\n            {\n                if (_server != null)\n                {\n                    _server.ExclusiveTabMode = chkExclusiveTab.Checked;\n                }\n            };\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            UpdateExtensionStatusLabel(true, e.Tabs.Count);\n            RefreshBrowserTabsListUi();\n\n            foreach (BrowserClient client in lstClients.Items.Cast\u003CBrowserClient\u003E().ToList())\n            {\n                RefreshClientListItemDisplay(client);\n            }\n        }\n==== REPLACE\n            UpdateExtensionStatusLabel(true, e.Tabs.Count);\n            RefreshBrowserTabsListUi();\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            try\n            {\n                var existingClient = await _server.SwitchToExtensionTabAsync(tab, focusBrowserTab, detachOthers, mode);\n                if (existingClient != null)\n                {\n                    if (lstClients.SelectedItem != existingClient)\n                    {\n                        lstClients.SelectedItem = existingClient;\n                    }\n                    else\n                    {\n                        _ = RefreshDomAsync(existingClient);\n                    }\n                }\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to switch to tab #{tab.TabId}: {ex.Message}\u0022, Color.Red);\n            }\n==== REPLACE\n            try\n            {\n                var existingClient = await _server.SwitchToExtensionTabAsync(tab, focusBrowserTab, detachOthers, mode);\n                if (existingClient != null \u0026\u0026 lstClients.SelectedItem == existingClient)\n                {\n                    _ = RefreshDomAsync(existingClient);\n                }\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to switch to tab #{tab.TabId}: {ex.Message}\u0022, Color.Red);\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                cmbPreScrapeSeq.Items.Clear();\n                cmbPostScrapeSeq.Items.Clear();\n\n                cmbPreScrapeSeq.Items.Add(\u0022(None)\u0022);\n                cmbPostScrapeSeq.Items.Add(\u0022(None)\u0022);\n\n                foreach (string seqName in _project.GetSequenceNames())\n                {\n                    cmbPreScrapeSeq.Items.Add(seqName);\n                    cmbPostScrapeSeq.Items.Add(seqName);\n                }\n\n                cmbPreScrapeSeq.SelectedItem = cmbPreScrapeSeq.Items.Contains(prevPre) ? prevPre : \u0022(None)\u0022;\n                cmbPostScrapeSeq.SelectedItem = cmbPostScrapeSeq.Items.Contains(prevPost) ? prevPost : \u0022(None)\u0022;\n\n                if (chkLstScrapes?.SelectedItem is ScrapeDefinition def)\n                {\n                    cmbPreScrapeSeq.SelectedItem = !string.IsNullOrWhiteSpace(def.PreScrapeSequenceName) \u0026\u0026 cmbPreScrapeSeq.Items.Contains(def.PreScrapeSequenceName)\n                        ? def.PreScrapeSequenceName\n                        : \u0022(None)\u0022;\n                    cmbPostScrapeSeq.SelectedItem = !string.IsNullOrWhiteSpace(def.PostScrapeSequenceName) \u0026\u0026 cmbPostScrapeSeq.Items.Contains(def.PostScrapeSequenceName)\n                        ? def.PostScrapeSequenceName\n                        : \u0022(None)\u0022;\n                }\n==== REPLACE\n                cmbPreScrapeSeq.Items.Clear();\n                cmbPostScrapeSeq.Items.Clear();\n\n                foreach (string option in _project.GetSequenceDropdownOptions())\n                {\n                    cmbPreScrapeSeq.Items.Add(option);\n                    cmbPostScrapeSeq.Items.Add(option);\n                }\n\n                if (chkLstScrapes?.SelectedItem is ScrapeDefinition def)\n                {\n                    cmbPreScrapeSeq.SelectedItem = _project.ResolveSequenceDropdownSelection(def.PreScrapeSequenceName);\n                    cmbPostScrapeSeq.SelectedItem = _project.ResolveSequenceDropdownSelection(def.PostScrapeSequenceName);\n                }\n                else\n                {\n                    cmbPreScrapeSeq.SelectedItem = _project.ResolveSequenceDropdownSelection(prevPre);\n                    cmbPostScrapeSeq.SelectedItem = _project.ResolveSequenceDropdownSelection(prevPost);\n                }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)\n                {\n                    txtContainerSelector.Text = scrape.ContainerSelector;\n                    cmbPreScrapeSeq.SelectedItem = !string.IsNullOrWhiteSpace(scrape.PreScrapeSequenceName) \u0026\u0026 cmbPreScrapeSeq.Items.Contains(scrape.PreScrapeSequenceName)\n                        ? scrape.PreScrapeSequenceName\n                        : \u0022(None)\u0022;\n                    cmbPostScrapeSeq.SelectedItem = !string.IsNullOrWhiteSpace(scrape.PostScrapeSequenceName) \u0026\u0026 cmbPostScrapeSeq.Items.Contains(scrape.PostScrapeSequenceName)\n                        ? scrape.PostScrapeSequenceName\n                        : \u0022(None)\u0022;\n==== REPLACE\n                if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)\n                {\n                    txtContainerSelector.Text = scrape.ContainerSelector;\n                    cmbPreScrapeSeq.SelectedItem = _project.ResolveSequenceDropdownSelection(scrape.PreScrapeSequenceName);\n                    cmbPostScrapeSeq.SelectedItem = _project.ResolveSequenceDropdownSelection(scrape.PostScrapeSequenceName);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private DomNode? GetCurrentRootDomNode() =\u003E\n            (lstClients.SelectedItem as BrowserClient)?.CurrentDomRoot ?? tvDom.RootDomNode;\n==== REPLACE\n        private DomNode? GetCurrentRootDomNode() =\u003E\n            (lstClients.SelectedItem as BrowserClient)?.ResolveDomRoot(tvDom.RootDomNode) ?? tvDom.RootDomNode;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            if (scrape.Fields.Count == 0)\n            {\n                Log(\u0022[WARN] The selected scrape list has no fields defined.\u0022, Color.Orange);\n                return;\n            }\n==== REPLACE\n            if (!scrape.HasFields)\n            {\n                Log(\u0022[WARN] The selected scrape list has no fields defined.\u0022, Color.Orange);\n                return;\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            if (_project.GetActiveScrapes().Count == 0)\n            {\n                Log(\u0022[WARN] No active scrape lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n==== REPLACE\n            if (!_project.HasActiveScrapes)\n            {\n                Log(\u0022[WARN] No active scrape lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnCopyScrapeJson_Click(object? sender, EventArgs e)\n        {\n            if (_lastScrapeResult == null || _lastScrapeResult.RecordCount == 0)\n            {\n                Log(\u0022[WARN] No scrape results available to copy.\u0022, Color.Orange);\n                return;\n            }\n\n            Clipboard.SetText(_lastScrapeResult.ToJson(true, true));\n            Log(\u0022[SCRAPE] Copied scraped JSON records to clipboard.\u0022, Color.Lime);\n        }\n\n        private void BtnExportScrapeJson_Click(object? sender, EventArgs e)\n        {\n            if (_lastScrapeResult == null || _lastScrapeResult.RecordCount == 0)\n            {\n                Log(\u0022[WARN] No scrape results available to export.\u0022, Color.Orange);\n                return;\n            }\n==== REPLACE\n        private void BtnCopyScrapeJson_Click(object? sender, EventArgs e)\n        {\n            if (_lastScrapeResult == null || !_lastScrapeResult.HasRecords)\n            {\n                Log(\u0022[WARN] No scrape results available to copy.\u0022, Color.Orange);\n                return;\n            }\n\n            Clipboard.SetText(_lastScrapeResult.ToJson(true, true));\n            Log(\u0022[SCRAPE] Copied scraped JSON records to clipboard.\u0022, Color.Lime);\n        }\n\n        private void BtnExportScrapeJson_Click(object? sender, EventArgs e)\n        {\n            if (_lastScrapeResult == null || !_lastScrapeResult.HasRecords)\n            {\n                Log(\u0022[WARN] No scrape results available to export.\u0022, Color.Orange);\n                return;\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnExportScrapeCsv_Click(object? sender, EventArgs e)\n        {\n            if (_lastScrapeResult == null || _lastScrapeResult.RecordCount == 0)\n            {\n                Log(\u0022[WARN] No scrape results available to export.\u0022, Color.Orange);\n                return;\n            }\n==== REPLACE\n        private void BtnExportScrapeCsv_Click(object? sender, EventArgs e)\n        {\n            if (_lastScrapeResult == null || !_lastScrapeResult.HasRecords)\n            {\n                Log(\u0022[WARN] No scrape results available to export.\u0022, Color.Orange);\n                return;\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            RefreshDumpedResourcesList();\n\n            if (result.DumpType == SiteDumpType.Html)\n            {\n                tabDumpViewers.SelectedTab = tabCombinedHtmlView;\n            }\n            else if (result.DumpType == SiteDumpType.Css)\n            {\n                tabDumpViewers.SelectedTab = tabCombinedCssView;\n            }\n            else if (result.DumpType == SiteDumpType.JavaScript)\n            {\n                tabDumpViewers.SelectedTab = tabCombinedJsView;\n            }\n            else if (lstDumpedResources.Items.Count \u003E 0)\n            {\n                tabDumpViewers.SelectedTab = tabSelectedResourceView;\n            }\n        }\n==== REPLACE\n            RefreshDumpedResourcesList();\n\n            tabDumpViewers.SelectedTab = result.GetDefaultViewMode() switch\n            {\n                SiteDumpViewMode.CombinedHtml =\u003E tabCombinedHtmlView,\n                SiteDumpViewMode.CombinedCss =\u003E tabCombinedCssView,\n                SiteDumpViewMode.CombinedJavaScript =\u003E tabCombinedJsView,\n                _ =\u003E tabSelectedResourceView\n            };\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private SiteDumpType GetSelectedCombinedViewerDumpType()\n        {\n            if (tabDumpViewers.SelectedTab == tabCombinedHtmlView) return SiteDumpType.Html;\n            if (tabDumpViewers.SelectedTab == tabCombinedCssView) return SiteDumpType.Css;\n            if (tabDumpViewers.SelectedTab == tabCombinedJsView) return SiteDumpType.JavaScript;\n            return _lastSiteDumpResult?.DumpType ?? SiteDumpType.All;\n        }\n\n        private string GetActiveDumpViewerText(out string suggestedFileName)\n        {\n            suggestedFileName = \u0022dump.txt\u0022;\n            if (_lastSiteDumpResult == null)\n                return string.Empty;\n\n            var selectedRes = tabDumpViewers.SelectedTab == tabSelectedResourceView\n                ? lstDumpedResources.SelectedItem as SiteResourceItem\n                : null;\n\n            return _lastSiteDumpResult.GetViewContent(GetSelectedCombinedViewerDumpType(), selectedRes, out suggestedFileName);\n        }\n\n        private void BtnCopyCurrentDumpView_Click(object? sender, EventArgs e)\n        {\n            string content = GetActiveDumpViewerText(out string name);\n            if (string.IsNullOrEmpty(content))\n            {\n                Log(\u0022[WARN] No dumped source content in the active view to copy.\u0022, Color.Orange);\n                return;\n            }\n\n            Clipboard.SetText(content);\n            Log($\u0022[REV-ENG] Copied \u0027{name}\u0027 ({content.Length:N0} chars) to clipboard.\u0022, Color.Lime);\n        }\n\n        private void BtnSaveActiveDumpFile_Click(object? sender, EventArgs e)\n        {\n            if (_lastSiteDumpResult == null)\n            {\n                Log(\u0022[WARN] Please run a dump operation first.\u0022, Color.Orange);\n                return;\n            }\n\n            var selectedResource = tabDumpViewers.SelectedTab == tabSelectedResourceView\n                ? lstDumpedResources.SelectedItem as SiteResourceItem\n                : null;\n            var viewType = GetSelectedCombinedViewerDumpType();\n            string content = _lastSiteDumpResult.GetViewContent(viewType, selectedResource, out string defaultFileName);\n\n            if (selectedResource == null \u0026\u0026 string.IsNullOrEmpty(content))\n            {\n                Log(\u0022[WARN] Active dump view is empty.\u0022, Color.Orange);\n                return;\n            }\n\n            using var sfd = new SaveFileDialog\n            {\n                Filter = \u0022All Files (*.*)|*.*|HTML Files (*.html)|*.html|CSS Files (*.css)|*.css|JavaScript Files (*.js)|*.js\u0022,\n                Title = selectedResource !=Anti-Agent v1.0\n\n### Summary of Migrated Logic \u0026 Refactoring\n\n1. **Server Lifecycle \u0026 Active Client State (\u0060AutomationServer\u0060 \u0026 \u0060BrowserClient\u0060)**:\n   - Implemented \u0060IDisposable\u0060, \u0060IsRunning\u0060, \u0060ExclusiveTabMode\u0060, \u0060ActiveClient\u0060, \u0060OnActiveClientChanged\u0060, and \u0060OnClientMetadataUpdated\u0060 in \u0060AutomationServer\u0060, plus internal \u0060CancellationTokenSource\u0060 management so callers do not need external cancellation tokens or UI polling timers.\n   - Added \u0060BrowserClient.ResolveDomRoot(...)\u0060 to resolve the active DOM tree root directly from the client.\n2. **DOM Tree Virtualization Math, Measurement Cache \u0026 Syntax Colors (\u0060DomTreeSnapshot\u0060 \u0026 \u0060DomTreeViewportState\u0060)**:\n   - Added \u0060DomTokenColorExtensions.GetDefaultRgb(...)\u0060, \u0060DomRowMeasureCache\u0060, and \u0060DomScrollBarMetrics\u0060 to \u0060BrowserAutomationFramework.Models\u0060.\n   - Migrated row token width caching (\u0060EnsureItemMeasured\u0060), content width calculation (\u0060RecalculateContentWidth\u0060), two-pass scrollbar visibility/range calculation (\u0060CalculateScrollBarMetrics\u0060), visible row range calculation (\u0060GetVisibleRowRange\u0060), and mouse wheel scrolling (\u0060ApplyMouseWheel\u0060) into \u0060DomTreeViewportState\u0060.\n   - Refactored \u0060TestBedApp.Controls.DomTreeView\u0060 to delegate all measurement caching and scroll math to \u0060DomTreeViewportState\u0060.\n3. **Reverse Engineering View Mode \u0026 Validation Helpers (\u0060SiteDumpResult\u0060, \u0060SiteResourceItem\u0060, \u0060AutomationProject\u0060, \u0060ScrapeDefinition\u0060, \u0060ScrapeResult\u0060)**:\n   - Added \u0060SiteDumpViewMode\u0060 (\u0060SelectedResource\u0060, \u0060CombinedHtml\u0060, \u0060CombinedCss\u0060, \u0060CombinedJavaScript\u0060, \u0060CombinedAll\u0060) and updated \u0060SiteDumpResult.GetViewContent\u0060 / \u0060SaveViewContentToFile\u0060 / \u0060GetDefaultViewMode\u0060 so unselected resources return empty strings rather than falling back to the full combined dump.\n   - Added \u0060AutomationProject.HasActiveSequences\u0060, \u0060AutomationProject.HasActiveScrapes\u0060, \u0060AutomationProject.GetSequenceDropdownOptions\u0060, \u0060AutomationProject.ResolveSequenceDropdownSelection\u0060, \u0060ScrapeDefinition.HasFields\u0060, \u0060ScrapeResult.HasRecords\u0060, and \u0060SiteDumpResult.HasResources\u0060.\n4. **File Association \u0026 Utility Cleanup (\u0060FileAssociationHelper\u0060 \u0026 \u0060ReThemer\u0060)**:\n   - Migrated the Windows Registry file association logic to \u0060BrowserAutomationFramework.Utils.FileAssociationHelper\u0060 and turned \u0060TestBedApp.Utils.FileAssociationHelper\u0060 into a thin wrapper.\n   - Removed the unused \u0060RestartExplorer()\u0060 method from \u0060TestBedApp.Utils.ReThemer\u0060.\n   - Refactored \u0060TestBedApp.MainForm\u0060 to consume the new DLL APIs and removed \u0060_cts\u0060 and \u0060_clientRefreshTimer\u0060.\n\n### How to Test\n\n1. Build the solution (\u0060dotnet build\u0060) and verify both \u0060BrowserAutomationFramework\u0060 and \u0060TestBedApp\u0060 compile with zero warnings or errors.\n2. Launch \u0060TestBedApp\u0060, start and stop the server, switch tabs via the Chrome Extension list, inspect the DOM tree (scrolling, expanding/collapsing, selecting elements), configure/run scrapes, and run Reverse Engineering dumps.\n\n--CODESTART--\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Utils\\FileAssociationHelper.cs**\n\n\u0060\u0060\u0060\ncsusing System;using System.Runtime.InteropServices;using System.Runtime.Versioning;using Microsoft.Win32;namespace BrowserAutomationFramework.Utils{    /// \u003Csummary\u003E    /// Provides Windows shell file-extension association utilities for registering project file types with an application executable.    /// \u003C/summary\u003E    [SupportedOSPlatform(\u0022windows\u0022)]    public static class FileAssociationHelper    {        [DllImport(\u0022shell32.dll\u0022, CharSet = CharSet.Auto, SetLastError = true)]        private static extern void SHChangeNotify(uint wEventId, uint uFlags, IntPtr dwItem1, IntPtr dwItem2);        private const uint SHCNE_ASSOCCHANGED = 0x08000000;        private const uint SHCNF_IDLIST = 0x0000;        /// \u003Csummary\u003E        /// Ensures that the specified file extension is associated with the given ProgID and application executable in the current user\u0027s Windows Registry.        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022extension\u0022\u003EThe file extension including the leading period (e.g., \u003Cc\u003E\u0022.baf\u0022\u003C/c\u003E).\u003C/param\u003E        /// \u003Cparam name=\u0022progId\u0022\u003EThe programmatic identifier for the file type.\u003C/param\u003E        /// \u003Cparam name=\u0022description\u0022\u003EThe human-readable description of the file type.\u003C/param\u003E        /// \u003Cparam name=\u0022applicationFilePath\u0022\u003EThe full path to the application executable that opens the file.\u003C/param\u003E        public static void EnsureAssociation(string extension, string progId, string description, string applicationFilePath)        {            if (!OperatingSystem.IsWindows())                return;            try            {                bool needsUpdate = false;                using (var key = Registry.CurrentUser.OpenSubKey($@\u0022Software\\Classes\\{extension}\u0022))                {                    if (key?.GetValue(\u0022\u0022) as string != progId) needsUpdate = true;                }                using (var key = Registry.CurrentUser.OpenSubKey($@\u0022Software\\Classes\\{progId}\\shell\\open\\command\u0022))                {                    string expectedCommand = $\u0022\\\u0022{applicationFilePath}\\\u0022 \\\u0022%1\\\u0022\u0022;                    if (key?.GetValue(\u0022\u0022) as string != expectedCommand) needsUpdate = true;                }                if (!needsUpdate) return;                using (var key = Registry.CurrentUser.CreateSubKey($@\u0022Software\\Classes\\{extension}\u0022))                {                    key.SetValue(\u0022\u0022, progId);                }                using (var key = Registry.CurrentUser.CreateSubKey($@\u0022Software\\Classes\\{progId}\u0022))                {                    key.SetValue(\u0022\u0022, description);                }                using (var key = Registry.CurrentUser.CreateSubKey($@\u0022Software\\Classes\\{progId}\\DefaultIcon\u0022))                {                    key.SetValue(\u0022\u0022, $\u0022\\\u0022{applicationFilePath}\\\u0022,0\u0022);                }                using (var key = Registry.CurrentUser.CreateSubKey($@\u0022Software\\Classes\\{progId}\\shell\\open\\command\u0022))                {                    key.SetValue(\u0022\u0022, $\u0022\\\u0022{applicationFilePath}\\\u0022 \\\u0022%1\\\u0022\u0022);                }                SHChangeNotify(SHCNE_ASSOCCHANGED, SHCNF_IDLIST, IntPtr.Zero, IntPtr.Zero);            }            catch            {                // Silently ignore if registry permissions are restricted            }        }    }}\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\AutomationProject.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH        /// \u003Csummary\u003E        /// Gets whether this project has valid URL match rules configured (either \u003Csee cref=\u0022MatchAnySite\u0022/\u003E is true or at least one URL is present in \u003Csee cref=\u0022MatchUrls\u0022/\u003E).        /// \u003C/summary\u003E        [JsonIgnore]        public bool HasValidMatchRules =\u003E MatchAnySite || (MatchUrls != null \u0026\u0026 MatchUrls.Any(u =\u003E !string.IsNullOrWhiteSpace(u)));==== REPLACE        /// \u003Csummary\u003E        /// Gets whether this project has at least one active \u003Csee cref=\u0022AutomationSequence\u0022/\u003E.        /// \u003C/summary\u003E        [JsonIgnore]        public bool HasActiveSequences =\u003E Sequences != null \u0026\u0026 Sequences.Any(s =\u003E s.IsActive);        /// \u003Csummary\u003E        /// Gets whether this project has at least one active \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E.        /// \u003C/summary\u003E        [JsonIgnore]        public bool HasActiveScrapes =\u003E Scrapes != null \u0026\u0026 Scrapes.Any(s =\u003E s.IsActive);        /// \u003Csummary\u003E        /// Gets whether this project has valid URL match rules configured (either \u003Csee cref=\u0022MatchAnySite\u0022/\u003E is true or at least one URL is present in \u003Csee cref=\u0022MatchUrls\u0022/\u003E).        /// \u003C/summary\u003E        [JsonIgnore]        public bool HasValidMatchRules =\u003E MatchAnySite || (MatchUrls != null \u0026\u0026 MatchUrls.Any(u =\u003E !string.IsNullOrWhiteSpace(u)));\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        /// \u003Csummary\u003E        /// Returns the names of all configured \u003Csee cref=\u0022AutomationSequence\u0022/\u003E items in the project.        /// \u003C/summary\u003E        public IReadOnlyList\u003Cstring\u003E GetSequenceNames()        {            return Sequences                .Where(s =\u003E !string.IsNullOrWhiteSpace(s.Name))                .Select(s =\u003E s.Name)                .ToList();        }==== REPLACE        /// \u003Csummary\u003E        /// Returns the names of all configured \u003Csee cref=\u0022AutomationSequence\u0022/\u003E items in the project.        /// \u003C/summary\u003E        public IReadOnlyList\u003Cstring\u003E GetSequenceNames()        {            return Sequences                .Where(s =\u003E !string.IsNullOrWhiteSpace(s.Name))                .Select(s =\u003E s.Name)                .ToList();        }        /// \u003Csummary\u003E        /// Returns a list of sequence names prefixed with \u003Cparamref name=\u0022noneLabel\u0022/\u003E suitable for populating pre/post-scrape sequence dropdown controls.        /// \u003C/summary\u003E        public IReadOnlyList\u003Cstring\u003E GetSequenceDropdownOptions(string noneLabel = \u0022(None)\u0022)        {            var options = new List\u003Cstring\u003E(Sequences.Count \u002B 1) { noneLabel };            options.AddRange(GetSequenceNames());            return options;        }        /// \u003Csummary\u003E        /// Resolves a configured sequence name against the sequences currently present in this project, returning \u003Cparamref name=\u0022noneLabel\u0022/\u003E if not found.        /// \u003C/summary\u003E        public string ResolveSequenceDropdownSelection(string? sequenceName, string noneLabel = \u0022(None)\u0022)        {            if (string.IsNullOrWhiteSpace(sequenceName))                return noneLabel;            string trimmed = sequenceName.Trim();            bool exists = Sequences.Any(s =\u003E string.Equals(s.Name, trimmed, StringComparison.OrdinalIgnoreCase));            return exists ? trimmed : noneLabel;        }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\ScrapeDef