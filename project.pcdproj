ontalEndX, rowLayout.CenterY);                            }                        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH            if (_vScrollBar.Visible \u0026\u0026 _hScrollBar.Visible)            {                Rectangle corner = new Rectangle(                    _vScrollBar.Left,                    _hScrollBar.Top,                    _vScrollBar.Width,                    _hScrollBar.Height);                using var cornerBrush = new SolidBrush(BackColor);                g.FillRectangle(cornerBrush, corner);            }==== REPLACE            DomTreeViewportState.CalculateScrollBarLayout(                ClientSize.Width,                ClientSize.Height,                BorderInset,                _vScrollBar.Width,                _hScrollBar.Height,                _vScrollBar.Visible,                _hScrollBar.Visible,                out _,                out _,                out var cornerRect);            if (!cornerRect.IsEmpty)            {                using var cornerBrush = new SolidBrush(BackColor);                g.FillRectangle(cornerBrush, ToRectangle(cornerRect));            }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        protected override void OnMouseWheel(MouseEventArgs e)        {            base.OnMouseWheel(e);            if ((ModifierKeys \u0026 Keys.Shift) == Keys.Shift)            {                if (_hScrollBar.Visible)                {                    int maxScrollX = Math.Max(0, _hScrollBar.Maximum - _hScrollBar.LargeChange \u002B 1);                    if (_state.ApplyMouseWheel(e.Delta, horizontal: true, maxScrollX, _itemHeight))                    {                        _updatingScrollBars = true;                        _hScrollBar.Value = _state.ScrollX;                        _updatingScrollBars = false;                        Invalidate();                    }                }                return;            }            if (_vScrollBar.Visible)            {                int maxScrollY = Math.Max(0, _vScrollBar.Maximum - _vScrollBar.LargeChange \u002B 1);                if (_state.ApplyMouseWheel(e.Delta, horizontal: false, maxScrollY, _itemHeight, SystemInformation.MouseWheelScrollLines))                {                    _updatingScrollBars = true;                    _vScrollBar.Value = _state.ScrollY;                    _updatingScrollBars = false;                    Invalidate();                }            }        }==== REPLACE        protected override void OnMouseWheel(MouseEventArgs e)        {            base.OnMouseWheel(e);            Rectangle view = GetViewportBounds();            bool horizontal = (ModifierKeys \u0026 Keys.Shift) == Keys.Shift;            if (horizontal)            {                if (_hScrollBar.Visible \u0026\u0026 _state.ApplyMouseWheel(e.Delta, horizontal: true, view.Width, view.Height, _itemHeight))                {                    _updatingScrollBars = true;                    _hScrollBar.Value = _state.ScrollX;                    _updatingScrollBars = false;                    Invalidate();                }                return;            }            if (_vScrollBar.Visible \u0026\u0026 _state.ApplyMouseWheel(e.Delta, horizontal: false, view.Width, view.Height, _itemHeight, SystemInformation.MouseWheelScrollLines))            {                _updatingScrollBars = true;                _vScrollBar.Value = _state.ScrollY;                _updatingScrollBars = false;                Invalidate();            }        }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH    public partial class MainForm : Form    {        private AutomationServer? _server;        private AutomationProject _project = new();        private readonly AutomationRunner _runner;        private readonly DataScraper _scraper;        private readonly SiteDumper _siteDumper;        private ScrapeResult? _lastScrapeResult;        private SiteDumpResult? _lastSiteDumpResult;        private bool _isUpdatingScrapeUi;==== REPLACE    public partial class MainForm : Form    {        private readonly AutomationStudioSession _session = new();        private bool _isUpdatingScrapeUi;\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        public MainForm()        {            InitializeComponent();            InitializeExtensionTabsSidebarUi();            InitializeScraperTabUi();            InitializeReverseEngineeringTabUi();            ApplyFixedSingleBorders(this);            try            {                ChromeExtensionGenerator.SyncDefaultDirectory((int)numPort.Value, IpcMode.WebSocket);            }            catch { }            tabMain.SelectedIndexChanged \u002B= (s, e) =\u003E EnsureTabSplittersConfigured();            Shown \u002B= (s, e) =\u003E EnsureTabSplittersConfigured();                        cmbMode.DataSource = Enum.GetValues(typeof(IpcMode));            cmbMode.SelectedIndex = 1;            _runner = new AutomationRunner();            _scraper = _runner.Scraper;            _siteDumper = _runner.SiteDumper;            _runner.OnSequenceStarted \u002B= (s, e) =\u003E Log($\u0022[AUTO] {e.GetStartedLogMessage()}\u0022, Color.Magenta);            _runner.OnStepStarted \u002B= (s, e) =\u003E Log($\u0022[AUTO] {e.GetStartedLogMessage()}\u0022, Color.Plum);            _runner.OnStepCompleted \u002B= (s, e) =\u003E            {                if (e.Result != null)                {                    Log($\u0022[AUTO-RX] {e.GetCompletedLogMessage()}\u0022, Color.White);                }            };            _scraper.OnScrapeStarted \u002B= (s, e) =\u003E Log($\u0022[SCRAPE] {e.GetStartedLogMessage()}\u0022, Color.SpringGreen);            _scraper.OnScrapePageCompleted \u002B= (s, e) =\u003E Log($\u0022[SCRAPE] {e.GetLogMessage()}\u0022, Color.LightGreen);            _scraper.OnPageTurnDelay \u002B= (s, e) =\u003E            {                string msg = e.GetStatusMessage();                Log($\u0022[SCRAPE] {msg}\u0022, Color.Khaki);                Invoke(new Action(() =\u003E lblScrapeStatus.Text = msg));            };            _scraper.OnRateLimitDetected \u002B= (s, e) =\u003E            {                Log($\u0022[RATE-LIMIT 429] {e.GetLogMessage()}\u0022, Color.Orange);                Invoke(new Action(() =\u003E                {                    if (!e.IsDateHeader \u0026\u0026 chkLstScrapes.SelectedItem == e.Definition)                    {                        _isUpdatingScrapeUi = true;                        try                        {                            numPageDelayMs.Value = Math.Clamp(e.NewPageDelayMs, (int)numPageDelayMs.Minimum, (int)numPageDelayMs.Maximum);                        }                        finally                        {                            _isUpdatingScrapeUi = false;                        }                    }                    lblScrapeStatus.Text = e.GetStatusMessage();                }));            };            _scraper.OnScrapeCompleted \u002B= (s, e) =\u003E            {                if (e.Result != null)                {                    Log($\u0022[SCRAPE] {e.GetCompletedLogMessage()}\u0022, Color.Lime);                    Invoke(new Action(() =\u003E DisplayScrapeResult(e.Result)));                }            };            _scraper.OnScrapeFailed \u002B= (s, e) =\u003E Log($\u0022[SCRAPE-ERR] {e.GetFailedLogMessage()}\u0022, Color.Red);            _siteDumper.OnDumpStarted \u002B= (s, e) =\u003E Log($\u0022[REV-ENG] {e.GetStartedLogMessage()}\u0022, Color.DeepSkyBlue);            _siteDumper.OnDumpCompleted \u002B= (s, e) =\u003E            {                if (e.Result != null)                {                    Log($\u0022[REV-ENG] {e.GetCompletedLogMessage()}\u0022, Color.Lime);                    Invoke(new Action(() =\u003E DisplaySiteDumpResult(e.Result)));                }            };            _siteDumper.OnDumpFailed \u002B= (s, e) =\u003E Log($\u0022[REV-ENG-ERR] {e.GetFailedLogMessage()}\u0022, Color.Red);        }        private void Log(string message, Color? color = null)        {            if (InvokeRequired)            {                Invoke(new Action(() =\u003E Log(message, color)));                return;            }            rtbLogs.SelectionStart = rtbLogs.TextLength;            rtbLogs.SelectionLength = 0;            rtbLogs.SelectionColor = color ?? Color.LightGray;            rtbLogs.AppendText($\u0022[{DateTime.Now:HH:mm:ss.fff}] {message}{Environment.NewLine}\u0022);            rtbLogs.ScrollToCaret();        }        private async void BtnStart_Click(object sender, EventArgs e)        {            int port = (int)numPort.Value;            var selectedMode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;            _server?.Dispose();            _server = new AutomationServer(port)            {                ExclusiveTabMode = chkExclusiveTab.Checked            };            try            {                string defaultExtDir = _server.SyncDefaultChromeExtension(selectedMode);                Log($\u0022[EXT] Synced Chrome Extension files (Port {port}) at: {defaultExtDir}\u0022, Color.MediumSpringGreen);            }            catch (Exception ex)            {                Log($\u0022[WARN] Could not auto-sync default ChromeExtension folder: {ex.Message}\u0022, Color.Orange);            }            _server.OnClientConnected \u002B= Server_OnClientConnected;            _server.OnClientDisconnected \u002B= Server_OnClientDisconnected;            _server.OnClientMetadataUpdated \u002B= Server_OnClientMetadataUpdated;            _server.OnActiveClientChanged \u002B= Server_OnActiveClientChanged;            _server.OnClientModeChanged \u002B= (s, c) =\u003E Log($\u0022[SYS] Client {c.InstanceId} switched IPC transport to {c.Mode}.\u0022, Color.Cyan);            _server.OnClientStreamDataReceived \u002B= (s, ev) =\u003E Log($\u0022[STREAM \u003C- {ev.Client.InstanceId}] {ev.Result.Output}\u0022, Color.MediumPurple);            _server.OnClientPageLoaded \u002B= (s, ev) =\u003E Log(ev.Args.GetLogMessage(ev.Client.InstanceId), ev.Args.IsRateLimited ? Color.Orange : Color.Aqua);            _server.OnActiveClientPageLoaded \u002B= Server_OnActiveClientPageLoaded;            _server.OnActiveClientDomChanged \u002B= Server_OnActiveClientDomChanged;            _server.OnActiveClientHighlightedElementRemoved \u002B= Server_OnActiveClientHighlightedElementRemoved;            _server.OnActiveClientElementClicked \u002B= Server_OnActiveClientElementClicked;            _server.OnExtensionConnected \u002B= Server_OnExtensionConnected;            _server.OnExtensionDisconnected \u002B= Server_OnExtensionDisconnected;            _server.OnExtensionTabsUpdated \u002B= Server_OnExtensionTabsUpdated;                        Log($\u0022[SYS] Starting Automation Server on port {port}...\u0022, Color.Cyan);            btnStart.Enabled = false;            btnStop.Enabled = true;            numPort.Enabled = false;            UpdateExtensionStatusLabel(false, 0);            try            {                await _server.StartAsync();            }            catch (Exception ex) when (ex is not OperationCanceledException)            {                Log($\u0022[ERR] Server error: {ex.Message}\u0022, Color.Red);                BtnStop_Click(null, EventArgs.Empty);            }        }        private void BtnStop_Click(object? sender, EventArgs e)        {            _server?.Stop();                        Log(\u0022[SYS] Server stopped.\u0022, Color.Yellow);                        btnStart.Enabled = true;            btnStop.Enabled = false;            numPort.Enabled = true;            lstClients.Items.Clear();            lstBrowserTabs.Items.Clear();            UpdateExtensionStatusLabel(false, 0);        }        private void ChkMatchAnySite_CheckedChanged(object? sender, EventArgs e)        {            _project.MatchAnySite = chkMatchAnySite.Checked;            lblMatchUrls.Visible = !_project.MatchAnySite;            pnlMatchUrls.Visible = !_project.MatchAnySite;        }        private void BtnAddMatchUrl_Click(object? sender, EventArgs e)        {            string url = PromptForValue(\u0022Enter Match URL (e.g., https://.example.com/):\u0022, \u0022Add Match URL\u0022);            string? added = _project.AddMatchUrl(url);            if (added != null)            {                lstMatchUrls.Items.Add(added);            }        }        private void BtnEditMatchUrl_Click(object? sender, EventArgs e)        {            if (lstMatchUrls.SelectedItem is string currentUrl)            {                int idx = lstMatchUrls.SelectedIndex;                string url = PromptForValue(\u0022Edit Match URL:\u0022, \u0022Edit Match URL\u0022, currentUrl);                if (_project.UpdateMatchUrl(idx, url))                {                    lstMatchUrls.Items[idx] = _project.MatchUrls[idx];                }            }        }        private void BtnRemoveMatchUrl_Click(object? sender, EventArgs e)        {            if (lstMatchUrls.SelectedItem is string selectedUrl)            {                _project.RemoveMatchUrl(selectedUrl);                lstMatchUrls.Items.Remove(selectedUrl);            }        }        private void ApplyProjectToUi(AutomationProject project)        {            _project = project ?? new AutomationProject();            chkMatchAnySite.Checked = _project.MatchAnySite;            lstMatchUrls.Items.Clear();            foreach (var url in _project.MatchUrls)            {                lstMatchUrls.Items.Add(url);            }            chkLstSequences.Items.Clear();            lstSteps.Items.Clear();            foreach (var seq in _project.Sequences)            {                chkLstSequences.Items.Add(seq, seq.IsActive);            }            if (chkLstSequences.Items.Count \u003E 0)            {                chkLstSequences.SelectedIndex = 0;            }            RefreshAutomationSequenceDropdowns();            chkLstScrapes.Items.Clear();            lstScrapeFields.Items.Clear();            pgScrapeFieldDetails.SelectedObject = null;            foreach (var scrape in _project.Scrapes)            {                chkLstScrapes.Items.Add(scrape, scrape.IsActive);            }            if (chkLstScrapes.Items.Count \u003E 0)            {                chkLstScrapes.SelectedIndex = 0;            }            else            {                LoadSelectedScrapeToUi();            }        }        private void BtnGenerate_Click(object sender, EventArgs e)        {            if (!_project.HasValidMatchRules)            {                Log(\u0022[WARN] No Match URLs provided. Defaulting to match any site.\u0022, Color.Orange);            }            var mode = (IpcMode)cmbMode.SelectedItem!;            string script = ScriptGenerator.Generate(_project, (int)numPort.Value, mode);            Clipboard.SetText(script);            Log($\u0022[SYS] Tampermonkey script generated for {mode} and copied to clipboard!\u0022, Color.Lime);        }        private void BtnExportExtension_Click(object? sender, EventArgs e)        {            string defaultDir = ChromeExtensionGenerator.GetDefaultExtensionDirectory();            using var fbd = new FolderBrowserDialog            {                Description = \u0022Select a folder to export the unpacked BAF Chrome Extension\u0022,                UseDescriptionForTitle = true,                SelectedPath = System.IO.Directory.Exists(defaultDir) ? defaultDir : string.Empty            };            if (fbd.ShowDialog() == DialogResult.OK \u0026\u0026 !string.IsNullOrWhiteSpace(fbd.SelectedPath))            {                try                {                    int port = (int)numPort.Value;                    var mode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;                    string savedPath = ChromeExtensionGenerator.ExportToDirectory(fbd.SelectedPath, port, mode);                    Log($\u0022[EXT] Exported unpacked Chrome Extension (Port {port}, {mode}) to: {savedPath}\u0022, Color.Lime);                    DarkMessageBox.Show(                        this,                        ChromeExtensionGenerator.GetLoadInstructions(savedPath),                        \u0022Chrome Extension Exported\u0022,                        MessageBoxButtons.OK,                        MessageBoxIcon.Information);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Failed to export Chrome Extension: {ex.Message}\u0022, Color.Red);                }            }        }        private void Server_OnClientConnected(object? sender, BrowserClient client)        {            Log($\u0022[SYS] Client Connected: {client.InstanceId} via {client.Mode}\u0022, Color.LimeGreen);            BeginInvoke(new Action(() =\u003E            {                UpsertClientInListUi(client);                if (_server?.ActiveClient != null \u0026\u0026 _server.ActiveClient.InstanceId == client.InstanceId)                {                    SyncActiveClientSelectionToUi(_server.ActiveClient);                }            }));        }        private void Server_OnActiveClientPageLoaded(object? sender, PageLoadedEventArgs e)        {            if (sender is BrowserClient client)            {                BeginInvoke(new Action(async () =\u003E await RefreshDomAsync(client)));            }        }        private void Server_OnActiveClientDomChanged(object? sender, DomChangedEventArgs e)        {            if (sender is BrowserClient client)            {                BeginInvoke(new Action(async () =\u003E await RefreshDomAsync(client, e.HighlightedPath, e.HasHighlightedPath)));            }        }        private void Server_OnActiveClientHighlightedElementRemoved(object? sender, EventArgs e)        {            BeginInvoke(new Action(() =\u003E            {                tvDom.ClearSelection();                txtElementDetails.Text = string.Empty;            }));        }        private void Server_OnActiveClientElementClicked(object? sender, ElementClickedEventArgs e)        {            if (sender is BrowserClient client)            {                BeginInvoke(new Action(async () =\u003E                {                    if (tvDom.SelectNodeByPath(e.Path, ensureVisible: true, raiseAfterSelect: false))                    {                        txtElementDetails.Text = tvDom.SelectedDomNode?.GetFormattedDetails() ?? string.Empty;                    }                    else                    {                        await RefreshDomAsync(client, e.Path, hasTargetPath: true);                    }                }));            }        }        private void Server_OnClientMetadataUpdated(object? sender, BrowserClient client)        {            if (InvokeRequired)            {                BeginInvoke(new Action(() =\u003E RefreshClientListItemDisplay(client)));            }            else            {                RefreshClientListItemDisplay(client);            }        }        private void Server_OnActiveClientChanged(object? sender, BrowserClient? activeClient)        {            if (InvokeRequired)            {                BeginInvoke(new Action(() =\u003E SyncActiveClientSelectionToUi(activeClient)));            }            else            {                SyncActiveClientSelectionToUi(activeClient);            }        }        private void UpsertClientInListUi(BrowserClient client)        {            int existingIdx = -1;            for (int i = 0; i \u003C lstClients.Items.Count; i\u002B\u002B)            {                if (lstClients.Items[i] is BrowserClient item \u0026\u0026 item.InstanceId == client.InstanceId)                {                    existingIdx = i;                    break;                }            }            _isUpdatingClientsList = true;            try            {                if (existingIdx \u003E= 0)                {                    lstClients.Items[existingIdx] = client;                }                else                {                    lstClients.Items.Add(client);                }            }            finally            {                _isUpdatingClientsList = false;            }        }        private async void SyncActiveClientSelectionToUi(BrowserClient? activeClient)        {            if (activeClient != null)            {                UpsertClientInListUi(activeClient);            }            _isUpdatingClientsList = true;            try            {                lstClients.SelectedItem = activeClient;            }            finally            {                _isUpdatingClientsList = false;            }            if (activeClient != null)            {                await RefreshDomAsync(activeClient);            }            else            {                tvDom.Clear();                txtElementDetails.Text = string.Empty;            }        }        private void Server_OnClientDisconnected(object? sender, BrowserClient client)        {            Log($\u0022[SYS] Client Disconnected: {client.InstanceId}\u0022, Color.Orange);            if (InvokeRequired)            {                BeginInvoke(new Action(() =\u003E HandleClientRemovedFromUi(client)));            }            else            {                HandleClientRemovedFromUi(client);            }        }        private void HandleClientRemovedFromUi(BrowserClient client)        {            _isUpdatingClientsList = true;            try            {                for (int i = lstClients.Items.Count - 1; i \u003E= 0; i--)                {                    if (lstClients.Items[i] is BrowserClient item \u0026\u0026 item.InstanceId == client.InstanceId)                    {                        lstClients.Items.RemoveAt(i);                    }                }            }            finally            {                _isUpdatingClientsList = false;            }            if (lstClients.Items.Count == 0)            {                tvDom.Clear();                txtElementDetails.Text = string.Empty;            }        }        private void LstClients_SelectedIndexChanged(object? sender, EventArgs e)        {            if (_isUpdatingClientsList) return;            var selected = lstClients.SelectedItem as BrowserClient;            if (_server != null)            {                _server.ActiveClient = selected;            }        }        private async void BtnSend_Click(object sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a client from the list first.\u0022, Color.Orange);                return;            }            string type = txtCmdType.Text;            string payloadStr = txtPayload.Text;            Log($\u0022[TX -\u003E {client.InstanceId}] {type} | Payload: {payloadStr}\u0022, Color.DeepSkyBlue);                        try            {                var result = await client.SendRawCommandAsync(type, payloadStr);                Log($\u0022[RX \u003C- {client.InstanceId}] Status: {result.Status} | Output: {result.Output}\u0022, Color.White);            }            catch (Exception ex)            {                Log($\u0022[ERR \u003C- {client.InstanceId}] {ex.Message}\u0022, Color.Red);            }        }        private async void BtnReactClick_Click(object sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client) return;            string selector = txtPayload.Text.Trim();                        Log($\u0022[TX -\u003E {client.InstanceId}] REACT_CLICK | Selector: {selector}\u0022, Color.DeepSkyBlue);            try            {                var result = await client.ClickReactElementAsync(selector);                Log($\u0022[RX \u003C- {client.InstanceId}] Status: {result.Status} | Output: {result.Output}\u0022, Color.White);            }            catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }        }        private async void BtnEval_Click(object sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client) return;            string code = txtPayload.Text.Trim();                        Log($\u0022[TX -\u003E {client.InstanceId}] EVAL | Code: {code}\u0022, Color.DeepSkyBlue);            try            {                var result = await client.EvaluateJavaScriptAsync(code);                Log($\u0022[RX \u003C- {client.InstanceId}] Status: {result.Status} | Output: {result.Output}\u0022, Color.White);            }            catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }        }        private async Task RefreshDomAsync(BrowserClient client, string? targetSelectedPath = null, bool hasTargetPath = false)        {            try            {                await client.RefreshDomSnapshotCoalescedAsync(                    getCurrentSelectedPath: () =\u003E tvDom.SelectedPath,                    onSnapshotReady: result =\u003E                    {                        if (lstClients.SelectedItem is not BrowserClient selectedClient ||                            selectedClient.InstanceId != client.InstanceId)                        {                            return;                        }                        var expandedPaths = tvDom.GetExpandedPathsSnapshot();                        tvDom.ApplySnapshot(                            result.Snapshot,                            expandedPaths,                            result.ResolvedSelectedPath,                            ensureSelectedVisible: result.ScrollSelectionIntoView,                            raiseAfterSelect: false);                        string details = tvDom.SelectedDomNode?.GetFormattedDetails() ?? string.Empty;                        if (!string.Equals(txtElementDetails.Text, details, StringComparison.Ordinal))                        {                            txtElementDetails.Text = details;                        }                    },                    targetSelectedPath: targetSelectedPath,                    hasTargetPath: hasTargetPath);            }            catch (Exception ex)            {                Log($\u0022[ERR] Failed to fetch DOM: {ex.Message}\u0022, Color.Red);            }        }        private void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)        {            if (e.Node?.Tag is DomNode domNode)            {                txtElementDetails.Text = domNode.GetFormattedDetails();                (lstClients.SelectedItem as BrowserClient)?.SelectDomNode(domNode);            }        }        private void TvDom_NodeMouseClick(object? sender, TreeNodeMouseClickEventArgs e)        {            if (e.Button == MouseButtons.Right \u0026\u0026 e.Node?.Tag is DomNode domNode \u0026\u0026 domNode.Type == \u0022element\u0022)            {                ctxDomNode.Show(tvDom, e.Location);            }        }        private async void MnuClickElement_Click(object? sender, EventArgs e)        {            if (tvDom.SelectedDomNode is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)            {                Log($\u0022[SYS] Testing click on {domNode.Path}\u0022, Color.Cyan);                try                {                    var res = await client.ClickReactElementAsync(domNode);                    Log($\u0022[RX] {res.Output}\u0022, Color.White);                }                catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }            }        }==== REPLACE        public MainForm()        {            InitializeComponent();            InitializeExtensionTabsSidebarUi();            InitializeScraperTabUi();            InitializeReverseEngineeringTabUi();            ApplyFixedSingleBorders(this);            _session.TrySyncDefaultChromeExtensionQuietly((int)numPort.Value, IpcMode.WebSocket);            tabMain.SelectedIndexChanged \u002B= (s, e) =\u003E EnsureTabSplittersConfigured();            Shown \u002B= (s, e) =\u003E EnsureTabSplittersConfigured();            cmbMode.DataSource = Enum.GetValues(typeof(IpcMode));            cmbMode.SelectedIndex = 1;            _session.OnLog \u002B= (s, e) =\u003E AppendLogLine(e.FormattedMessage, Color.FromArgb(e.ColorRgb.R, e.ColorRgb.G, e.ColorRgb.B));            _session.OnScrapeStatusChanged \u002B= (s, msg) =\u003E InvokeOnUi(() =\u003E lblScrapeStatus.Text = msg);            _session.OnDumpStatusChanged \u002B= (s, msg) =\u003E InvokeOnUi(() =\u003E lblDumpStatus.Text = msg);            _session.OnRateLimitDetected \u002B= (s, e) =\u003E InvokeOnUi(() =\u003E            {                if (!e.IsDateHeader \u0026\u0026 chkLstScrapes.SelectedItem == e.Definition)                {                    _isUpdatingScrapeUi = true;                    try                    {                        numPageDelayMs.Value = Math.Clamp(e.NewPageDelayMs, (int)numPageDelayMs.Minimum, (int)numPageDelayMs.Maximum);                    }                    finally                    {                        _isUpdatingScrapeUi = false;                    }                }            });            _session.OnScrapeResultAvailable \u002B= (s, result) =\u003E InvokeOnUi(() =\u003E DisplayScrapeResult(result));            _session.OnSiteDumpResultAvailable \u002B= (s, result) =\u003E InvokeOnUi(() =\u003E DisplaySiteDumpResult(result));            _session.OnClientConnected \u002B= Server_OnClientConnected;            _session.OnClientDisconnected \u002B= Server_OnClientDisconnected;            _session.OnClientMetadataUpdated \u002B= Server_OnClientMetadataUpdated;            _session.OnActiveClientChanged \u002B= Server_OnActiveClientChanged;            _session.OnActiveClientPageLoaded \u002B= Server_OnActiveClientPageLoaded;            _session.OnActiveClientDomChanged \u002B= Server_OnActiveClientDomChanged;            _session.OnActiveClientHighlightedElementRemoved \u002B= Server_OnActiveClientHighlightedElementRemoved;            _session.OnActiveClientElementClicked \u002B= Server_OnActiveClientElementClicked;            _session.OnExtensionStateChanged \u002B= (s, e) =\u003E InvokeOnUi(UpdateExtensionStatusLabel);            _session.OnExtensionTabsUpdated \u002B= Server_OnExtensionTabsUpdated;        }        private void InvokeOnUi(Action action)        {            if (InvokeRequired)                BeginInvoke(action);            else                action();        }        private void AppendLogLine(string formattedLine, Color color)        {            if (InvokeRequired)            {                BeginInvoke(new Action(() =\u003E AppendLogLine(formattedLine, color)));                return;            }            rtbLogs.SelectionStart = rtbLogs.TextLength;            rtbLogs.SelectionLength = 0;            rtbLogs.SelectionColor = color;            rtbLogs.AppendText($\u0022{formattedLine}{Environment.NewLine}\u0022);            rtbLogs.ScrollToCaret();        }        private async void BtnStart_Click(object sender, EventArgs e)        {            int port = (int)numPort.Value;            var selectedMode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;            _session.ExclusiveTabMode = chkExclusiveTab.Checked;            btnStart.Enabled = false;            btnStop.Enabled = true;            numPort.Enabled = false;            try            {                await _session.StartServerAsync(port, selectedMode);            }            catch (Exception ex) when (ex is not OperationCanceledException)            {                BtnStop_Click(null, EventArgs.Empty);            }        }        private void BtnStop_Click(object? sender, EventArgs e)        {            _session.StopServer();            btnStart.Enabled = true;            btnStop.Enabled = false;            numPort.Enabled = true;            lstClients.Items.Clear();            lstBrowserTabs.Items.Clear();            UpdateExtensionStatusLabel();        }        private void ChkMatchAnySite_CheckedChanged(object? sender, EventArgs e)        {            _session.Project.MatchAnySite = chkMatchAnySite.Checked;            lblMatchUrls.Visible = !_session.Project.MatchAnySite;            pnlMatchUrls.Visible = !_session.Project.MatchAnySite;        }        private void BtnAddMatchUrl_Click(object? sender, EventArgs e)        {            string url = PromptForValue(\u0022Enter Match URL (e.g., https://.example.com/):\u0022, \u0022Add Match URL\u0022);            string? added = _session.Project.AddMatchUrl(url);            if (added != null)            {                lstMatchUrls.Items.Add(added);            }        }        private void BtnEditMatchUrl_Click(object? sender, EventArgs e)        {            if (lstMatchUrls.SelectedItem is string currentUrl)            {                int idx = lstMatchUrls.SelectedIndex;                string url = PromptForValue(\u0022Edit Match URL:\u0022, \u0022Edit Match URL\u0022, currentUrl);                if (_session.Project.UpdateMatchUrl(idx, url))                {                    lstMatchUrls.Items[idx] = _session.Project.MatchUrls[idx];                }            }        }        private void BtnRemoveMatchUrl_Click(object? sender, EventArgs e)        {            if (lstMatchUrls.SelectedItem is string selectedUrl)            {                _session.Project.RemoveMatchUrl(selectedUrl);                lstMatchUrls.Items.Remove(selectedUrl);            }        }        private void ApplyProjectToUi(AutomationProject project)        {            chkMatchAnySite.Checked = project.MatchAnySite;            lstMatchUrls.Items.Clear();            foreach (var url in project.MatchUrls)            {                lstMatchUrls.Items.Add(url);            }            chkLstSequences.Items.Clear();            lstSteps.Items.Clear();            foreach (var seq in project.Sequences)            {                chkLstSequences.Items.Add(seq, seq.IsActive);            }            if (chkLstSequences.Items.Count \u003E 0)            {                chkLstSequences.SelectedIndex = 0;            }            RefreshAutomationSequenceDropdowns();            chkLstScrapes.Items.Clear();            lstScrapeFields.Items.Clear();            pgScrapeFieldDetails.SelectedObject = null;            foreach (var scrape in project.Scrapes)            {                chkLstScrapes.Items.Add(scrape, scrape.IsActive);            }            if (chkLstScrapes.Items.Count \u003E 0)            {                chkLstScrapes.SelectedIndex = 0;            }            else            {                LoadSelectedScrapeToUi();            }        }        private void BtnGenerate_Click(object sender, EventArgs e)        {            var mode = (IpcMode)cmbMode.SelectedItem!;            string script = _session.GenerateUserscript((int)numPort.Value, mode);            Clipboard.SetText(script);        }        private void BtnExportExtension_Click(object? sender, EventArgs e)        {            string defaultDir = ChromeExtensionGenerator.GetDefaultExtensionDirectory();            using var fbd = new FolderBrowserDialog            {                Description = \u0022Select a folder to export the unpacked BAF Chrome Extension\u0022,                UseDescriptionForTitle = true,                SelectedPath = System.IO.Directory.Exists(defaultDir) ? defaultDir : string.Empty            };            if (fbd.ShowDialog() == DialogResult.OK \u0026\u0026 !string.IsNullOrWhiteSpace(fbd.SelectedPath))            {                try                {                    int port = (int)numPort.Value;                    var mode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;                    string instructions = _session.ExportChromeExtension(fbd.SelectedPath, port, mode);                    DarkMessageBox.Show(                        this,                        instructions,                        \u0022Chrome Extension Exported\u0022,                        MessageBoxButtons.OK,                        MessageBoxIcon.Information);                }                catch (Exception ex)                {                    _session.Log(\u0022ERR\u0022, $\u0022Failed to export Chrome Extension: {ex.Message}\u0022, AutomationLogLevel.Error);                }            }        }        private void Server_OnClientConnected(object? sender, BrowserClient client)        {            BeginInvoke(new Action(() =\u003E            {                UpsertClientInListUi(client);                if (_session.ActiveClient != null \u0026\u0026 _session.ActiveClient.InstanceId == client.InstanceId)                {                    SyncActiveClientSelectionToUi(_session.ActiveClient);                }            }));        }        private void Server_OnActiveClientPageLoaded(object? sender, PageLoadedEventArgs e)        {            if (sender is BrowserClient client)            {                BeginInvoke(new Action(async () =\u003E await RefreshDomAsync(client)));            }        }        private void Server_OnActiveClientDomChanged(object? sender, DomChangedEventArgs e)        {            if (sender is BrowserClient client)            {                BeginInvoke(new Action(async () =\u003E await RefreshDomAsync(client, e.HighlightedPath, e.HasHighlightedPath)));            }        }        private void Server_OnActiveClientHighlightedElementRemoved(object? sender, EventArgs e)        {            BeginInvoke(new Action(() =\u003E            {                tvDom.ClearSelection();                txtElementDetails.Text = string.Empty;            }));        }        private void Server_OnActiveClientElementClicked(object? sender, ElementClickedEventArgs e)        {            if (sender is BrowserClient client)            {                BeginInvoke(new Action(async () =\u003E                {                    await client.HandleElementClickedOrRefreshDomAsync(                        clickedPath: e.Path,                        trySelectExistingPath: path =\u003E tvDom.SelectNodeByPath(path, ensureVisible: true, raiseAfterSelect: false),                        onSelectedInExistingTree: () =\u003E txtElementDetails.Text = tvDom.SelectedDomNode?.GetFormattedDetails() ?? string.Empty,                        getCurrentSelectedPath: () =\u003E tvDom.SelectedPath,                        onSnapshotReady: result =\u003E ApplyDomSnapshotResultToUi(client, result));                }));            }        }        private void Server_OnClientMetadataUpdated(object? sender, BrowserClient client)        {            InvokeOnUi(() =\u003E RefreshClientListItemDisplay(client));        }        private void Server_OnActiveClientChanged(object? sender, BrowserClient? activeClient)        {            InvokeOnUi(() =\u003E SyncActiveClientSelectionToUi(activeClient));        }        private void UpsertClientInListUi(BrowserClient client)        {            _isUpdatingClientsList = true;            try            {                AutomationServer.UpsertClientInList(lstClients.Items, client);            }            finally            {                _isUpdatingClientsList = false;            }        }        private async void SyncActiveClientSelectionToUi(BrowserClient? activeClient)        {            if (activeClient != null)            {                UpsertClientInListUi(activeClient);            }            _isUpdatingClientsList = true;            try            {                lstClients.SelectedItem = activeClient;            }            finally            {                _isUpdatingClientsList = false;            }            if (activeClient != null)            {                await RefreshDomAsync(activeClient);            }            else            {                tvDom.Clear();                txtElementDetails.Text = string.Empty;            }        }        private void Server_OnClientDisconnected(object? sender, BrowserClient client)        {            InvokeOnUi(() =\u003E HandleClientRemovedFromUi(client));        }        private void HandleClientRemovedFromUi(BrowserClient client)        {            _isUpdatingClientsList = true;            try            {                AutomationServer.RemoveClientFromList(lstClients.Items, client);            }            finally            {                _isUpdatingClientsList = false;            }            if (lstClients.Items.Count == 0)            {                tvDom.Clear();                txtElementDetails.Text = string.Empty;            }        }        private void LstClients_SelectedIndexChanged(object? sender, EventArgs e)        {            if (_isUpdatingClientsList) return;            _session.ActiveClient = lstClients.SelectedItem as BrowserClient;        }        private async void BtnSend_Click(object sender, EventArgs e)        {            await _session.SendRawCommandAsync(txtCmdType.Text, txtPayload.Text, lstClients.SelectedItem as BrowserClient);        }        private async void BtnReactClick_Click(object sender, EventArgs e)        {            await _session.TestReactClickAsync(txtPayload.Text, lstClients.SelectedItem as BrowserClient);        }        private async void BtnEval_Click(object sender, EventArgs e)        {            await _session.TestEvalAsync(txtPayload.Text, lstClients.SelectedItem as BrowserClient);        }        private void ApplyDomSnapshotResultToUi(BrowserClient client, DomSnapshotRefreshResult result)        {            if (lstClients.SelectedItem is not BrowserClient selectedClient ||                selectedClient.InstanceId != client.InstanceId)            {                return;            }            var expandedPaths = tvDom.GetExpandedPathsSnapshot();            tvDom.ApplySnapshot(                result.Snapshot,                expandedPaths,                result.ResolvedSelectedPath,                ensureSelectedVisible: result.ScrollSelectionIntoView,                raiseAfterSelect: false);            string details = tvDom.SelectedDomNode?.GetFormattedDetails() ?? string.Empty;            if (!string.Equals(txtElementDetails.Text, details, StringComparison.Ordinal))            {                txtElementDetails.Text = details;            }        }        private async Task RefreshDomAsync(BrowserClient client, string? targetSelectedPath = null, bool hasTargetPath = false)        {            try            {                await client.RefreshDomSnapshotCoalescedAsync(                    getCurrentSelectedPath: () =\u003E tvDom.SelectedPath,                    onSnapshotReady: result =\u003E ApplyDomSnapshotResultToUi(client, result),                    targetSelectedPath: targetSelectedPath,                    hasTargetPath: hasTargetPath);            }            catch (Exception ex)            {                _session.Log(\u0022ERR\u0022, $\u0022Failed to fetch DOM: {ex.Message}\u0022, AutomationLogLevel.Error);            }        }        private void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)        {            if (e.Node?.Tag is DomNode domNode)            {                txtElementDetails.Text = domNode.GetFormattedDetails();                (lstClients.SelectedItem as BrowserClient)?.SelectDomNode(domNode);            }        }        private void TvDom_NodeMouseClick(object? sender, TreeNodeMouseClickEventArgs e)        {            if (e.Button == MouseButtons.Right \u0026\u0026 e.Node?.Tag is DomNode domNode \u0026\u0026 domNode.Type == \u0022element\u0022)            {                ctxDomNode.Show(tvDom, e.Location);            }        }        private async void MnuClickElement_Click(object? sender, EventArgs e)        {            await _session.ClickDomNodeAsync(tvDom.SelectedDomNode, lstClients.SelectedItem as BrowserClient);        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private async void MnuSetValue_Click(object? sender, EventArgs e)        {            if (tvDom.SelectedDomNode is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)            {                string value = PromptForValue(\u0022Enter value to set:\u0022, \u0022Set Value\u0022);                if (string.IsNullOrEmpty(value)) return;                Log($\u0022[SYS] Testing set value on {domNode.Path}\u0022, Color.Cyan);                try                {                    var res = await client.SetReactInputValueAsync(domNode, value);                    Log($\u0022[RX] {res.Output}\u0022, Color.White);                }                catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }            }        }==== REPLACE        private async void MnuSetValue_Click(object? sender, EventArgs e)        {            if (tvDom.SelectedDomNode is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)            {                string value = PromptForValue(\u0022Enter value to set:\u0022, \u0022Set Value\u0022);                await _session.SetDomNodeValueAsync(domNode, value, client);            }        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH            var createNewItem = new ToolStripMenuItem(\u0022(\u002B New Scrape List...)\u0022);            createNewItem.Click \u002B= (s, e) =\u003E            {                string defaultName = $\u0022Scrape {_project.Scrapes.Count \u002B 1}\u0022;                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022New Scrape List\u0022, defaultName);                if (!string.IsNullOrWhiteSpace(name))                {                    var newScrape = _project.AddScrape(name);                    chkLstScrapes.Items.Add(newScrape, newScrape.IsActive);                    chkLstScrapes.SelectedItem = newScrape;                    onSelect(newScrape);                }            };            parentMenu.DropDownItems.Add(createNewItem);        }        private void AddStepToSequence(AutomationSequence seq, AutomationActionType actionType)        {            if (tvDom.SelectedDomNode is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path))            {                var step = seq.AddStepFromDomNode(domNode, actionType);                                if (chkLstSequences.SelectedItem == seq)                {                    lstSteps.Items.Add(step);                    lstSteps.SelectedItem = step;                }                                tabMain.SelectedTab = tabEditor;                Log($\u0022[SYS] Added step to list \u0027{seq.Name}\u0027\u0022, Color.Cyan);            }        }        private void BtnAddStep_Click(object? sender, EventArgs e)        {            if (chkLstSequences.SelectedItem is AutomationSequence seq)            {                var step = seq.AddStep();                lstSteps.Items.Add(step);                lstSteps.SelectedItem = step;            }            else            {                Log(\u0022[WARN] Please select an automation list first.\u0022, Color.Orange);            }        }        private void BtnRemoveStep_Click(object? sender, EventArgs e)        {            if (chkLstSequences.SelectedItem is AutomationSequence seq \u0026\u0026 lstSteps.SelectedItem is AutomationStep step)            {                seq.RemoveStep(step);                lstSteps.Items.Remove(step);            }        }        private void LstSteps_SelectedIndexChanged(object? sender, EventArgs e)        {            pgStepDetails.SelectedObject = lstSteps.SelectedItem;        }        private void PgStepDetails_PropertyValueChanged(object? s, PropertyValueChangedEventArgs e)        {            int idx = lstSteps.SelectedIndex;            if (idx \u003E= 0)            {                var item = lstSteps.Items[idx];                lstSteps.Items[idx] = item;            }        }        private void MnuFileNew_Click(object? sender, EventArgs e)        {            _project.Reset();            ApplyProjectToUi(_project);            Log(\u0022[SYS] Started new automation project.\u0022, Color.Cyan);        }        private void MnuFileOpen_Click(object? sender, EventArgs e)        {            using var ofd = new OpenFileDialog            {                Filter = \u0022JSON Files (.json)|.json|All Files (.)|.\u0022,                Title = \u0022Open Automation Project\u0022            };            if (ofd.ShowDialog() == DialogResult.OK)            {                try                {                    var project = AutomationProject.LoadFromFile(ofd.FileName);                    ApplyProjectToUi(project);                    Log($\u0022[SYS] Loaded project from {ofd.FileName}\u0022, Color.Lime);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Failed to load project: {ex.Message}\u0022, Color.Red);                }            }        }        private void MnuFileSave_Click(object? sender, EventArgs e)        {            using var sfd = new SaveFileDialog            {                Filter = \u0022JSON Files (.json)|.json|All Files (.)|.\u0022,                Title = \u0022Save Automation Project\u0022,                DefaultExt = \u0022json\u0022            };            if (sfd.ShowDialog() == DialogResult.OK)            {                try                {                    _project.SaveToFile(sfd.FileName);                    Log($\u0022[SYS] Saved project to {sfd.FileName}\u0022, Color.Lime);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Failed to save project: {ex.Message}\u0022, Color.Red);                }            }        }==== REPLACE            var createNewItem = new ToolStripMenuItem(\u0022(\u002B New Scrape List...)\u0022);            createNewItem.Click \u002B= (s, e) =\u003E            {                string defaultName = $\u0022Scrape {_session.Project.Scrapes.Count \u002B 1}\u0022;                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022New Scrape List\u0022, defaultName);                if (!string.IsNullOrWhiteSpace(name))                {                    var newScrape = _session.Project.AddScrape(name);                    chkLstScrapes.Items.Add(newScrape, newScrape.IsActive);                    chkLstScrapes.SelectedItem = newScrape;                    onSelect(newScrape);                }            };            parentMenu.DropDownItems.Add(createNewItem);        }        private void AddStepToSequence(AutomationSequence seq, AutomationActionType actionType)        {            var step = _session.AddStepFromDomNode(seq, tvDom.SelectedDomNode, actionType);            if (step != null)            {                if (chkLstSequences.SelectedItem == seq)                {                    lstSteps.Items.Add(step);                    lstSteps.SelectedItem = step;                }                tabMain.SelectedTab = tabEditor;            }        }        private void BtnAddStep_Click(object? sender, EventArgs e)        {            if (chkLstSequences.SelectedItem is AutomationSequence seq)            {                var step = seq.AddStep();                lstSteps.Items.Add(step);                lstSteps.SelectedItem = step;            }            else            {                _session.Log(\u0022WARN\u0022, \u0022Please select an automation list first.\u0022, AutomationLogLevel.Warning);            }        }        private void BtnRemoveStep_Click(object? sender, EventArgs e)        {            if (chkLstSequences.SelectedItem is AutomationSequence seq \u0026\u0026 lstSteps.SelectedItem is AutomationStep step)            {                seq.RemoveStep(step);                lstSteps.Items.Remove(step);            }        }        private void LstSteps_SelectedIndexChanged(object? sender, EventArgs e)        {       