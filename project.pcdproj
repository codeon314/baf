      "UserPrompt": "PLease finish the response, do not include your summary of changes, only show the code. You didnt ifnish the ScriptGenerator.cs file so start there and show me the rest of the changes.",
      "ModelResponse": "Anti-Agent v1.0\n\nCompleting \u0060ScriptGenerator.cs\u0060 and applying the remaining changes for navigation, page-load synchronization, and URL-based pagination.\n\n--CODESTART--\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Generators\\ScriptGenerator.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n            sb.AppendLine($\u0022    const PORT = {options.Port};\u0022);\n            sb.AppendLine($\u0022    const INSTANCE_ID = \u0027bot_\u0027 \u002B Math.random().toString(36).substr(2, 9);\u0022);\n            sb.AppendLine();\n\n            // React \u0026 DOM Utilities\n            sb.AppendLine(@\u0022\n    // --- React \u0026 DOM Utilities ---\n    const ReactUtils = {\n        simulateClick: function(element) {\n            try {\n                const reactKey = Object.keys(element).find(k =\u003E k.startsWith(\u0027__reactProps$\u0027) || k.startsWith(\u0027__reactEventHandlers$\u0027));\n                if (reactKey \u0026\u0026 element[reactKey]) {\n                    const props = element[reactKey];\n                    if (typeof props.onClick === \u0027function\u0027) {\n                        const nativeEvent = new MouseEvent(\u0027click\u0027, { bubbles: true, cancelable: true, button: 1 });\n                        const fakeNativeEvent = new Proxy(nativeEvent, {\n                            get(target, prop) {\n                                if (prop === \u0027isTrusted\u0027) return true;\n                                const value = Reflect.get(target, prop);\n                                if (typeof value === \u0027function\u0027) return value.bind(target);\n                                return value;\n                            }\n                        });\n                        props.onClick({\n                            bubbles: true, cancelable: true, preventDefault: () =\u003E {}, stopPropagation: () =\u003E {},\n                            target: element, currentTarget: element, nativeEvent: fakeNativeEvent, button: 1\n                        });\n                        return \u0027React click simulated\u0027;\n                    }\n                }\n            } catch (e) { console.error(\u0027React click failed\u0027, e); }\n            \n            try {\n                if (typeof element.focus === \u0027function\u0027) element.focus();\n                element.dispatchEvent(new KeyboardEvent(\u0027keydown\u0027, { bubbles: true, cancelable: true, composed: true, key: \u0027Enter\u0027, code: \u0027Enter\u0027, keyCode: 13 }));\n                element.dispatchEvent(new KeyboardEvent(\u0027keyup\u0027, { bubbles: true, cancelable: true, composed: true, key: \u0027Enter\u0027, code: \u0027Enter\u0027, keyCode: 13 }));\n            } catch (e) {}\n\n            const tag = element.tagName.toLowerCase();\n            if (tag !== \u0027button\u0027 \u0026\u0026 tag !== \u0027a\u0027 \u0026\u0026 tag !== \u0027input\u0027) {\n                try {\n                    element.dispatchEvent(new MouseEvent(\u0027mousedown\u0027, { bubbles: true, cancelable: true, view: window, button: 1 }));\n                    element.dispatchEvent(new MouseEvent(\u0027mouseup\u0027, { bubbles: true, cancelable: true, view: window, button: 1 }));\n                    element.dispatchEvent(new MouseEvent(\u0027click\u0027, { bubbles: true, cancelable: true, view: window, button: 1 }));\n                    element.dispatchEvent(new MouseEvent(\u0027auxclick\u0027, { bubbles: true, cancelable: true, view: window, button: 1 }));\n                } catch (e) {}\n            } else {\n                try {\n                    element.dispatchEvent(new MouseEvent(\u0027mousedown\u0027, { bubbles: true, cancelable: true, view: window, button: 1 }));\n                    element.dispatchEvent(new MouseEvent(\u0027mouseup\u0027, { bubbles: true, cancelable: true, view: window, button: 1 }));\n                    element.dispatchEvent(new MouseEvent(\u0027click\u0027, { bubbles: true, cancelable: true, view: window, button: 1 }));\n                    element.dispatchEvent(new MouseEvent(\u0027auxclick\u0027, { bubbles: true, cancelable: true, view: window, button: 1 }));\n                } catch (e) {}\n            }\n\n            return \u0027Native/Fallback click executed\u0027;\n        },\n==== REPLACE\n            sb.AppendLine($\u0022    const PORT = {options.Port};\u0022);\n            sb.AppendLine(@\u0022    function getOrCreateInstanceId() {\n        const key = \u0027__baf_instance_id\u0027;\n        try {\n            if (window.name \u0026\u0026 window.name.startsWith(\u0027bot_\u0027)) {\n                sessionStorage.setItem(key, window.name);\n                return window.name;\n            }\n            const stored = sessionStorage.getItem(key);\n            if (stored \u0026\u0026 stored.startsWith(\u0027bot_\u0027)) {\n                window.name = stored;\n                return stored;\n            }\n        } catch (e) {}\n        const newId = \u0027bot_\u0027 \u002B Math.random().toString(36).substr(2, 9);\n        try {\n            window.name = newId;\n            sessionStorage.setItem(key, newId);\n        } catch (e) {}\n        return newId;\n    }\n    const INSTANCE_ID = getOrCreateInstanceId();\n    const PAGE_LOAD_ID = \u0027page_\u0027 \u002B Date.now() \u002B \u0027_\u0027 \u002B Math.random().toString(36).substr(2, 7);\n\n    function waitForDocumentComplete(timeoutMs = 30000) {\n        return new Promise((resolve) =\u003E {\n            const buildState = () =\u003E ({\n                pageLoadId: PAGE_LOAD_ID,\n                url: window.location.href,\n                readyState: document.readyState,\n                title: document.title || \u0027\u0027\n            });\n            if (document.readyState === \u0027complete\u0027) {\n                requestAnimationFrame(() =\u003E resolve(buildState()));\n                return;\n           