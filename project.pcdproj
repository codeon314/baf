BrowserTabAsync(BrowserTabInfo tab, bool focusBrowserTab)        {            if (_server == null)            {                Log(\u0022[WARN] Start the Automation Server first.\u0022, Color.Orange);                return;            }            var mode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;            bool detachOthers = chkExclusiveTab.Checked;            Log($\u0022[EXT] Injecting \u0026 switching to Tab #{tab.TabId}: {tab.Title} ({tab.Url})\u0022, Color.SpringGreen);            try            {                var existingClient = await _server.SwitchToExtensionTabAsync(tab, focusBrowserTab, detachOthers, mode);                if (existingClient != null \u0026\u0026 lstClients.SelectedItem == existingClient)                {                    _ = RefreshDomAsync(existingClient);                }            }            catch (Exception ex)            {                Log($\u0022[ERR] Failed to switch to tab #{tab.TabId}: {ex.Message}\u0022, Color.Red);            }        }        private async void BtnDetachTab_Click(object? sender, EventArgs e)        {            if (_server == null) return;            if (lstBrowserTabs.SelectedItem is not BrowserTabInfo selectedTab)            {                Log(\u0022[WARN] Please select a tab to detach.\u0022, Color.Orange);                return;            }            Log($\u0022[EXT] Detaching automation bridge from Tab #{selectedTab.TabId}...\u0022, Color.Yellow);            try            {                await _server.DetachExtensionTabAsync(selectedTab.TabId);            }            catch (Exception ex)            {                Log($\u0022[ERR] Failed to detach tab: {ex.Message}\u0022, Color.Red);            }        }        private async void BtnFocusTab_Click(object? sender, EventArgs e)        {            if (_server == null) return;            if (lstBrowserTabs.SelectedItem is not BrowserTabInfo selectedTab)            {                Log(\u0022[WARN] Please select a tab to focus in Chrome.\u0022, Color.Orange);                return;            }            try            {                await _server.FocusExtensionTabAsync(selectedTab.TabId);            }            catch (Exception ex)            {                Log($\u0022[ERR] Failed to focus tab: {ex.Message}\u0022, Color.Red);            }        }        private async void BtnRefreshTabs_Click(object? sender, EventArgs e)        {            if (_server == null) return;            try            {                await _server.RequestExtensionTabsRefreshAsync();            }            catch (Exception ex)            {                Log($\u0022[ERR] Failed to refresh tabs: {ex.Message}\u0022, Color.Red);            }        }==== REPLACE        private void RefreshClientListItemDisplay(BrowserClient client)        {            int idx = AutomationServer.FindClientIndex(lstClients.Items, client);            if (idx \u003E= 0)            {                bool wasSelected = lstClients.SelectedIndex == idx;                _isUpdatingClientsList = true;                try                {                    AutomationServer.RefreshClientInList(lstClients.Items, client);                    if (wasSelected)                    {                        lstClients.SelectedIndex = idx;                    }                }                finally                {                    _isUpdatingClientsList = false;                }            }        }        private void UpdateExtensionStatusLabel()        {            lblExtensionStatus.Text = _session.GetExtensionStatusMessage();            lblExtensionStatus.ForeColor = _session.IsExtensionConnected ? Color.LimeGreen : Color.Orange;        }        private void Server_OnExtensionTabsUpdated(object? sender, ExtensionTabsEventArgs e)        {            InvokeOnUi(RefreshBrowserTabsListUi);        }        private void RefreshBrowserTabsListUi()        {            if (_session.Server == null) return;            _isUpdatingBrowserTabsLis