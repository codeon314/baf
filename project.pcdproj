{\n                _pendingDomRefresh = (client, targetSelectedPath, hasTargetPath);\n                return;\n            }\n\n            try\n            {\n                BrowserClient currentClient = client;\n                string? currentTarget = targetSelectedPath;\n                bool currentHasTarget = hasTargetPath;\n\n                while (true)\n                {\n                    _pendingDomRefresh = null;\n                    DateTime fetchStartedUtc = DateTime.UtcNow;\n\n                    string? previousSelectedPath = tvDom.SelectedPath;\n                    var expandedPaths = tvDom.GetExpandedPathsSnapshot();\n\n                    // Fetch, deserialize, and index the entire DOM tree on a background thread with timeout protection\n                    using var fetchTimeoutCts = new CancellationTokenSource(TimeSpan.FromSeconds(10));\n                    var token = fetchTimeoutCts.Token;\n\n                    DomTreeSnapshot? snapshot = null;\n                    try\n                    {\n                        snapshot = await currentClient.GetDomSnapshotAsync(token);\n                    }\n                    catch (OperationCanceledException)\n                    {\n                        snapshot = null;\n                    }\n\n                    if (snapshot != null \u0026\u0026\n                        lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026\n                        selectedClient.InstanceId == currentClient.InstanceId)\n                    {\n                        bool userSelectedDuringFetch = _lastUserSelectionUtc \u003E fetchStartedUtc \u0026\u0026\n                                                       !string.IsNullOrEmpty(_lastUserSelectedDomPath);\n\n                        string? finalSelectedPath;\n                        if (userSelectedDuringFetch)\n                        {\n                            finalSelectedPath = _lastUserSelectedDomPath;\n                        }\n                        else if (currentHasTarget)\n                        {\n                            finalSelectedPath = !string.IsNullOrEmpty(currentTarget) ? currentTarget : previousSelectedPath;\n                        }\n                        else\n                        {\n                            finalSelectedPath = previousSelectedPath;\n                        }\n\n                        bool scrollSelectionIntoView = userSelectedDuringFetch ||\n                            (currentHasTarget \u0026\u0026 !string.IsNullOrEmpty(currentTarget) \u0026\u0026\n                             !string.Equals(currentTarget, previousSelectedPath, StringComparison.Ordinal));\n\n                        tvDom.ApplySnapshot(\n                            snapshot,\n                            expandedPaths,\n                            finalSelectedPath,\n                            ensureSelectedVisible: scrollSelectionIntoView,\n                            raiseAfterSelect: false);\n\n                        var selectedDom = tvDom.SelectedDomNode;\n                        if (selectedDom != null)\n                        {\n                            string details = selectedDom.GetFormattedDetails();\n                            if (!string.Equals(txtElementDetails.Text, details, StringComparison.Ordinal))\n                            {\n                                txtElementDetails.Text = details;\n                            }\n                        }\n                        else\n                        {\n                            txtElementDetails.Text = string.Empty;\n                        }\n                    }\n\n                    if (_pendingDomRefresh.HasValue)\n                    {\n                        var next = _pendingDomRefresh.Value;\n                        _pendingDomRefresh = null;\n                        currentClient = next.Client;\n                        currentTarget = next.TargetPath;\n                        currentHasTarget = next.HasTargetPath;\n                        await Task.Delay(150);\n                        continue;\n                    }\n\n                    break;\n                }\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to fetch DOM: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                Interlocked.Exchange(ref _domRefreshInFlight, 0);\n            }\n        }\n\n        private void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)\n        {\n            if (e.Node?.Tag is DomNode domNode)\n            {\n                _lastUserSelectedDomPath = domNode.Path;\n                _lastUserSelectionUtc = DateTime.UtcNow;\n                txtElementDetails.Text = domNode.GetFormattedDetails();\n\n                if (domNode.Type == \u0022element\u0022 \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n                {\n                    client.HighlightElementDebounced(domNode.Path);\n                }\n            }\n        }\n==== REPLACE\n        private async Task RefreshDomAsync(BrowserClient client, string? targetSelectedPath = null, bool hasTargetPath = false)\n        {\n            try\n            {\n                await client.RefreshDomSnapshotCoalescedAsync(\n                    getCurrentSelectedPath: () =\u003E tvDom.SelectedPath,\n                    onSnapshotReady: result =\u003E\n                    {\n                        if (lstClients.SelectedItem is not BrowserClient selectedClient ||\n                            selectedClient.InstanceId != client.InstanceId)\n                        {\n                            return;\n                        }\n\n                        var expandedPaths = tvDom.GetExpandedPathsSnapshot();\n                        tvDom.ApplySnapshot(\n                            result.Snapshot,\n                            expandedPaths,\n                            result.ResolvedSelectedPath,\n                            ensureSelectedVisible: result.ScrollSelectionIntoView,\n                            raiseAfterSelect: false);\n\n                        string details = tvDom.SelectedDomNode?.GetFormattedDetails() ?? string.Empty;\n                        if (!string.Equals(txtElementDetails.Text, details, StringComparison.Ordinal))\n                        {\n                            txtElementDetails.Text = details;\n                        }\n                    },\n                    targetSelectedPath: targetSelectedPath,\n                    hasTargetPath: hasTargetPath);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to fetch DOM: {ex.Message}\u0022, Color.Red);\n            }\n        }\n\n        private void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)\n        {\n            if (e.Node?.Tag is DomNode domNode)\n            {\n                txtElementDetails.Text = domNode.GetFormattedDetails();\n\n                if (lstClients.SelectedItem is BrowserClient client)\n                {\n                    client.RecordUserDomSelection(domNode.Path);\n                    if (domNode.Type == \u0022element\u0022 \u0026\u0026 !string.IsNullOrEmpty(domNode.Path))\n                    {\n                        client.HighlightElementDebounced(domNode.Path);\n                    }\n                }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            var createNewItem = new ToolStripMenuItem(\u0022(\u002B New Scrape List...)\u0022);\n            createNewItem.Click \u002B= (s, e) =\u003E\n            {\n                string defaultName = $\u0022Scrape {_project.Scrapes.Count \u002B 1}\u0022;\n                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022New Scrape List\u0022, defaultName);\n                if (!string.IsNullOrWhiteSpace(name))\n                {\n                    var newScrape = _project.AddScrape(name);\n                    chkLstScrapes.Items.Add(newScrape, newScrape.IsActive);\n                    chkLstScrapes.SelectedItem = newScrape;\n                    onSelect(newScrape);\n                }\n            };\n            parentMenu.DropDownItems.Add(createNewItem);\n==== REPLACE\n            var createNewItem = new ToolStripMenuItem(\u0022(\u002B New Scrape List...)\u0022);\n            createNewItem.Click \u002B= (s, e) =\u003E\n            {\n                string defaultName = $\u0022Scrape {_project.Scrapes.Count \u002B 1}\u0022;\n                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022New Scrape List\u0022, defaultName);\n                if (!string.IsNullOrWhiteSpace(name))\n                {\n                    var newScrape = _project.AddScrape(name);\n                    chkLstScrapes.Items.Add(newScrape, newScrape.IsActive);\n                    chkLstScrapes.SelectedItem = newScrape;\n                    onSelect(newScrape);\n                }\n            };\n            parentMenu.DropDownItems.Add(createNewItem);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            var createNewItem = new ToolStripMenuItem(\u0022(\u002B New Scrape List...)\u0022);\n            createNewItem.Click \u002B= (s, e) =\u003E\n            {\n                string defaultName = $\u0022Scrape {chkLstScrapes.Items.Count \u002B 1}\u0022;\n                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022New Scrape List\u0022, defaultName);\n                if (!string.IsNullOrWhiteSpace(name))\n                {\n                    var newScrape = new ScrapeDefinition { Name = name.Trim() };\n                    chkLstScrapes.Items.Add(newScrape, true);\n                    chkLstScrapes.SelectedItem = newScrape;\n                    onSelect(newScrape);\n                }\n            };\n            parentMenu.DropDownItems.Add(createNewItem);\n==== REPLACE\n            var createNewItem = new ToolStripMenuItem(\u0022(\u002B New Scrape List...)\u0022);\n            createNewItem.Click \u002B= (s, e) =\u003E\n            {\n                string defaultName = $\u0022Scrape {_project.Scrapes.Count \u002B 1}\u0022;\n                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022New Scrape List\u0022, defaultName);\n                if (!string.IsNullOrWhiteSpace(name))\n                {\n                    var newScrape = _project.AddScrape(name);\n                    chkLstScrapes.Items.Add(newScrape, newScrape.IsActive);\n                    chkLstScrapes.SelectedItem = newScrape;\n                    onSelect(newScrape);\n                }\n            };\n            parentMenu.DropDownItems.Add(createNewItem);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void MnuFileNew_Click(object? sender, EventArgs e)\n        {\n            chkMatchAnySite.Checked = true;\n            lstMatchUrls.Items.Clear();\n            chkLstSequences.Items.Clear();\n            lstSteps.Items.Clear();\n            chkLstScrapes.Items.Clear();\n            lstScrapeFields.Items.Clear();\n            pgScrapeFieldDetails.SelectedObject = null;\n            RefreshAutomationSequenceDropdowns();\n            LoadSelectedScrapeToUi();\n            Log(\u0022[SYS] Started new automation project.\u0022, Color.Cyan);\n        }\n==== REPLACE\n        private void MnuFileNew_Click(object? sender, EventArgs e)\n        {\n            _project.Reset();\n            ApplyProjectToUi(_project);\n            Log(\u0022[SYS] Started new automation project.\u0022, Color.Cyan);\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void MnuFileSave_Click(object? sender, EventArgs e)\n        {\n            using var sfd = new SaveFileDialog\n            {\n                Filter = \u0022JSON Files (*.json)|*.json|All Files (*.*)|*.*\u0022,\n                Title = \u0022Save Automation Project\u0022,\n                DefaultExt = \u0022json\u0022\n            };\n\n            if (sfd.ShowDialog() == DialogResult.OK)\n            {\n                try\n                {\n                    var project = BuildCurrentProjectFromUi();\n                    project.SaveToFile(sfd.FileName);\n                    Log($\u0022[SYS] Saved project to {sfd.FileName}\u0022, Color.Lime);\n                }\n                catch (Exception ex)\n                {\n                    Log($\u0022[ERR] Failed to save project: {ex.Message}\u0022, Color.Red);\n                }\n            }\n        }\n==== REPLACE\n        private void MnuFileSave_Click(object? sender, EventArgs e)\n        {\n            using var sfd = new SaveFileDialog\n            {\n                Filter = \u0022JSON Files (*.json)|*.json|All Files (*.*)|*.*\u0022,\n                Title = \u0022Save Automation Project\u0022,\n                DefaultExt = \u0022json\u0022\n            };\n\n            if (sfd.ShowDialog() == DialogResult.OK)\n            {\n                try\n                {\n                    _project.SaveToFile(sfd.FileName);\n                    Log($\u0022[SYS] Saved project to {sfd.FileName}\u0022, Color.Lime);\n                }\n                catch (Exception ex)\n                {\n                    Log($\u0022[ERR] Failed to save project: {ex.Message}\u0022, Color.Red);\n                }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnAddSequence_Click(object? sender, EventArgs e)\n        {\n            string name = PromptForValue(\u0022Enter new list name:\u0022, \u0022Add Automation List\u0022);\n            if (!string.IsNullOrWhiteSpace(name))\n            {\n                var seq = new AutomationSequence { Name = name };\n                chkLstSequences.Items.Add(seq, true);\n                chkLstSequences.SelectedItem = seq;\n                RefreshAutomationSequenceDropdowns();\n            }\n        }\n\n        private void BtnRemoveSequence_Click(object? sender, EventArgs e)\n        {\n            if (chkLstSequences.SelectedItem != null)\n            {\n                chkLstSequences.Items.Remove(chkLstSequences.SelectedItem);\n                RefreshAutomationSequenceDropdowns();\n            }\n        }\n\n        private void BtnMoveSeqUp_Click(object? sender, EventArgs e)\n        {\n            if (chkLstSequences.SelectedItem != null \u0026\u0026 chkLstSequences.SelectedIndex \u003E 0)\n            {\n                int idx = chkLstSequences.SelectedIndex;\n                var item = chkLstSequences.SelectedItem;\n                bool isChecked = chkLstSequences.GetItemChecked(idx);\n                \n                chkLstSequences.Items.RemoveAt(idx);\n                chkLstSequences.Items.Insert(idx - 1, item);\n                chkLstSequences.SetItemChecked(idx - 1, isChecked);\n                chkLstSequences.SelectedIndex = idx - 1;\n            }\n        }\n\n        private void BtnMoveSeqDown_Click(object? sender, EventArgs e)\n        {\n            if (chkLstSequences.SelectedItem != null \u0026\u0026 chkLstSequences.SelectedIndex \u003C chkLstSequences.Items.Count - 1)\n            {\n                int idx = chkLstSequences.SelectedIndex;\n                var item = chkLstSequences.SelectedItem;\n                bool isChecked = chkLstSequences.GetItemChecked(idx);\n                \n                chkLstSequences.Items.RemoveAt(idx);\n                chkLstSequences.Items.Insert(idx \u002B 1, item);\n                chkLstSequences.SetItemChecked(idx \u002B 1, isChecked);\n                chkLstSequences.SelectedIndex = idx \u002B 1;\n            }\n        }\n\n        private void BtnRenameSeq_Click(object? sender, EventArgs e)\n        {\n            if (chkLstSequences.SelectedItem is AutomationSequence seq)\n            {\n                string name = PromptForValue(\u0022Enter new list name:\u0022, \u0022Rename Automation List\u0022, seq.Name);\n                if (!string.IsNullOrWhiteSpace(name))\n                {\n                    seq.Name = name;\n                    int idx = chkLstSequences.SelectedIndex;\n                    bool isChecked = chkLstSequences.GetItemChecked(idx);\n                    chkLstSequences.Items[idx] = seq;\n                    chkLstSequences.SetItemChecked(idx, isChecked);\n                    RefreshAutomationSequenceDropdowns();\n                }\n            }\n        }\n\n        private async void BtnRunAutomation_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a client first.\u0022, Color.Orange);\n                return;\n            }\n\n            var project = BuildCurrentProjectFromUi();\n            if (project.GetActiveSequences().Count == 0)\n            {\n                Log(\u0022[WARN] No active automation lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n\n            Log(\u0022[SYS] Starting Automation Run...\u0022, Color.Magenta);\n            btnRunAutomation.Enabled = false;\n\n            try\n            {\n                await client.ExecuteProjectAsync(project, _runner);\n                Log(\u0022[SYS] Automation Run Completed.\u0022, Color.Lime);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Automation aborted: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnRunAutomation.Enabled = true;\n            }\n        }\n==== REPLACE\n        private void BtnAddSequence_Click(object? sender, EventArgs e)\n        {\n            string name = PromptForValue(\u0022Enter new list name:\u0022, \u0022Add Automation List\u0022);\n            if (!string.IsNullOrWhiteSpace(name))\n            {\n                var seq = _project.AddSequence(name);\n                chkLstSequences.Items.Add(seq, seq.IsActive);\n                chkLstSequences.SelectedItem = seq;\n                RefreshAutomationSequenceDropdowns();\n            }\n        }\n\n        private void BtnRemoveSequence_Click(object? sender, EventArgs e)\n        {\n            if (chkLstSequences.SelectedItem is AutomationSequence seq)\n            {\n                _project.RemoveSequence(seq);\n                chkLstSequences.Items.Remove(seq);\n                RefreshAutomationSequenceDropdowns();\n            }\n        }\n\n        private void BtnMoveSeqUp_Click(object? sender, EventArgs e)\n        {\n            int idx = chkLstSequences.SelectedIndex;\n            if (_project.MoveSequenceUp(idx))\n            {\n                var item = chkLstSequences.Items[idx];\n                bool isChecked = chkLstSequences.GetItemChecked(idx);\n\n                chkLstSequences.Items.RemoveAt(idx);\n                chkLstSequences.Items.Insert(idx - 1, item);\n                chkLstSequences.SetItemChecked(idx - 1, isChecked);\n                chkLstSequences.SelectedIndex = idx - 1;\n            }\n        }\n\n        private void BtnMoveSeqDown_Click(object? sender, EventArgs e)\n        {\n            int idx = chkLstSequences.SelectedIndex;\n            if (_project.MoveSequenceDown(idx))\n            {\n                var item = chkLstSequences.Items[idx];\n                bool isChecked = chkLstSequences.GetItemChecked(idx);\n\n                chkLstSequences.Items.RemoveAt(idx);\n                chkLstSequences.Items.Insert(idx \u002B 1, item);\n                chkLstSequences.SetItemChecked(idx \u002B 1, isChecked);\n                chkLstSequences.SelectedIndex = idx \u002B 1;\n            }\n        }\n\n        private void BtnRenameSeq_Click(object? sender, EventArgs e)\n        {\n            if (chkLstSequences.SelectedItem is AutomationSequence seq)\n            {\n                string name = PromptForValue(\u0022Enter new list name:\u0022, \u0022Rename Automation List\u0022, seq.Name);\n                if (_project.RenameSequence(seq, name))\n                {\n                    int idx = chkLstSequences.SelectedIndex;\n                    bool isChecked = chkLstSequences.GetItemChecked(idx);\n                    chkLstSequences.Items[idx] = seq;\n                    chkLstSequences.SetItemChecked(idx, isChecked);\n                    RefreshAutomationSequenceDropdowns();\n                }\n            }\n        }\n\n        private async void BtnRunAutomation_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a client first.\u0022, Color.Orange);\n                return;\n            }\n\n            if (_project.GetActiveSequences().Count == 0)\n            {\n                Log(\u0022[WARN] No active automation lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n\n            Log(\u0022[SYS] Starting Automation Run...\u0022, Color.Magenta);\n            btnRunAutomation.Enabled = false;\n\n            try\n            {\n                await client.ExecuteProjectAsync(_project, _runner);\n                Log(\u0022[SYS] Automation Run Completed.\u0022, Color.Lime);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Automation aborted: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnRunAutomation.Enabled = true;\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void Server_OnExtensionConnected(object? sender, EventArgs e)\n        {\n            Log(\u0022[EXT] Chrome Extension connected to Automation Server!\u0022, Color.LimeGreen);\n            UpdateExtensionStatusLabel(true, _latestExtensionTabs.Count);\n        }\n\n        private void Server_OnExtensionDisconnected(object? sender, EventArgs e)\n        {\n            Log(\u0022[EXT] Chrome Extension disconnected.\u0022, Color.Orange);\n            UpdateExtensionStatusLabel(false, 0);\n        }\n\n        private void Server_OnExtensionTabsUpdated(object? sender, ExtensionTabsEventArgs e)\n        {\n            if (InvokeRequired)\n            {\n                Invoke(new Action(() =\u003E Server_OnExtensionTabsUpdated(sender, e)));\n                return;\n            }\n\n            _latestExtensionTabs = e.Tabs.ToList();\n            UpdateExtensionStatusLabel(true, _latestExtensionTabs.Count);\n            RefreshBrowserTabsListUi();\n\n            foreach (BrowserClient client in lstClients.Items.Cast\u003CBrowserClient\u003E().ToList())\n            {\n                RefreshClientListItemDisplay(client);\n            }\n        }\n\n        private void RefreshBrowserTabsListUi()\n        {\n            _isUpdatingBrowserTabsList = true;\n            lstBrowserTabs.BeginUpdate();\n            try\n            {\n                int? prevSelectedTabId = (lstBrowserTabs.SelectedItem as BrowserTabInfo)?.TabId ?? _server?.ActiveExtensionTabId;\n                string filter = txtFilterTabs.Text.Trim();\n\n                lstBrowserTabs.Items.Clear();\n                BrowserTabInfo? itemToSelect = null;\n\n                foreach (var tab in _latestExtensionTabs)\n                {\n                    if (!tab.MatchesFilter(filter))\n                        continue;\n\n                    lstBrowserTabs.Items.Add(tab);\n                    if (prevSelectedTabId.HasValue \u0026\u0026 tab.TabId == prevSelectedTabId.Value)\n                    {\n                        itemToSelect = tab;\n                    }\n                }\n\n                if (itemToSelect != null)\n                {\n                    lstBrowserTabs.SelectedItem = itemToSelect;\n                }\n            }\n            finally\n            {\n                lstBrowserTabs.EndUpdate();\n                _isUpdatingBrowserTabsList = false;\n            }\n        }\n==== REPLACE\n        private void Server_OnExtensionConnected(object? sender, EventArgs e)\n        {\n            Log(\u0022[EXT] Chrome Extension connected to Automation Server!\u0022, Color.LimeGreen);\n            UpdateExtensionStatusLabel(true, _server?.GetExtensionTabs().Count ?? 0);\n        }\n\n        private void Server_OnExtensionDisconnected(object? sender, EventArgs e)\n        {\n            Log(\u0022[EXT] Chrome Extension disconnected.\u0022, Color.Orange);\n            UpdateExtensionStatusLabel(false, 0);\n        }\n\n        private void Server_OnExtensionTabsUpdated(object? sender, ExtensionTabsEventArgs e)\n        {\n            if (InvokeRequired)\n            {\n                Invoke(new Action(() =\u003E Server_OnExtensionTabsUpdated(sender, e)));\n                return;\n            }\n\n            UpdateExtensionStatusLabel(true, e.Tabs.Count);\n            RefreshBrowserTabsListUi();\n\n            foreach (BrowserClient client in lstClients.Items.Cast\u003CBrowserClient\u003E().ToList())\n            {\n                RefreshClientListItemDisplay(client);\n            }\n        }\n\n        private void RefreshBrowserTabsListUi()\n        {\n            if (_server == null) return;\n\n            _isUpdatingBrowserTabsList = true;\n            lstBrowserTabs.BeginUpdate();\n            try\n            {\n                int? prevSelectedTabId = (lstBrowserTabs.SelectedItem as BrowserTabInfo)?.TabId ?? _server.ActiveExtensionTabId;\n                var filteredTabs = _server.GetExtensionTabs(txtFilterTabs.Text);\n\n                lstBrowserTabs.Items.Clear();\n                BrowserTabInfo? itemToSelect = null;\n\n                foreach (var tab in filteredTabs)\n                {\n                    lstBrowserTabs.Items.Add(tab);\n                    if (prevSelectedTabId.HasValue \u0026\u0026 tab.TabId == prevSelectedTabId.Value)\n                    {\n                        itemToSelect = tab;\n                    }\n                }\n\n                if (itemToSelect != null)\n                {\n                    lstBrowserTabs.SelectedItem = itemToSelect;\n                }\n            }\n            finally\n            {\n                lstBrowserTabs.EndUpdate();\n                _isUpdatingBrowserTabsList = false;\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            var existingClient = _server.GetClientForTab(tab) ?? lstClients.Items.Cast\u003CBrowserClient\u003E().FirstOrDefault(c =\u003E c.TabId == tab.TabId || c.InstanceId == tab.InstanceId);\n==== REPLACE\n            var existingClient = _server.GetClientForTab(tab);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                foreach (AutomationSequence seq in chkLstSequences.Items)\n                {\n                    cmbPreScrapeSeq.Items.Add(seq.Name);\n                    cmbPostScrapeSeq.Items.Add(seq.Name);\n                }\n==== REPLACE\n                foreach (string seqName in _project.GetSequenceNames())\n                {\n                    cmbPreScrapeSeq.Items.Add(seqName);\n                    cmbPostScrapeSeq.Items.Add(seqName);\n                }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void ScrapeConfigControl_Changed(object? sender, EventArgs e)\n        {\n            if (_isUpdatingScrapeUi) return;\n            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape) return;\n\n            scrape.ContainerSelector = txtContainerSelector.Text.Trim();\n            string? pre = cmbPreScrapeSeq.SelectedItem as string;\n            scrape.PreScrapeSequenceName = pre == \u0022(None)\u0022 ? string.Empty : (pre ?? string.Empty);\n\n            string? post = cmbPostScrapeSeq.SelectedItem as string;\n            scrape.PostScrapeSequenceName = post == \u0022(None)\u0022 ? string.Empty : (post ?? string.Empty);\n\n            scrape.EnablePagination = chkEnablePagination.Checked;\n            scrape.MaxPages = (int)numMaxPages.Value;\n            scrape.PaginationStartPage = (int)numStartPage.Value;\n            scrape.PageDelayMs = (int)numPageDelayMs.Value;\n            scrape.NextPageSelector = txtNextPageSelector.Text.Trim();\n            scrape.PaginationUrlPattern = txtPaginationUrlPattern.Text.Trim();\n        }\n==== REPLACE\n        private void ScrapeConfigControl_Changed(object? sender, EventArgs e)\n        {\n            if (_isUpdatingScrapeUi) return;\n            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape) return;\n\n            scrape.ContainerSelector = txtContainerSelector.Text.Trim();\n            scrape.PreScrapeSequenceName = ScrapeDefinition.NormalizeSequenceSelection(cmbPreScrapeSeq.SelectedItem as string);\n            scrape.PostScrapeSequenceName = ScrapeDefinition.NormalizeSequenceSelection(cmbPostScrapeSeq.SelectedItem as string);\n\n            scrape.EnablePagination = chkEnablePagination.Checked;\n            scrape.MaxPages = (int)numMaxPages.Value;\n            scrape.PaginationStartPage = (int)numStartPage.Value;\n            scrape.PageDelayMs = (int)numPageDelayMs.Value;\n            scrape.NextPageSelector = txtNextPageSelector.Text.Trim();\n            scrape.PaginationUrlPattern = txtPaginationUrlPattern.Text.Trim();\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnAddScrape_Click(object? sender, EventArgs e)\n        {\n            string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022Add Scrape List\u0022, $\u0022Scrape {chkLstScrapes.Items.Count \u002B 1}\u0022);\n            if (!string.IsNullOrWhiteSpace(name))\n            {\n                var scrape = new ScrapeDefinition { Name = name.Trim() };\n                chkLstScrapes.Items.Add(scrape, true);\n                chkLstScrapes.SelectedItem = scrape;\n            }\n        }\n\n        private void BtnRemoveScrape_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem != null)\n            {\n                chkLstScrapes.Items.Remove(chkLstScrapes.SelectedItem);\n                LoadSelectedScrapeToUi();\n            }\n        }\n\n        private void BtnMoveScrapeUp_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem != null \u0026\u0026 chkLstScrapes.SelectedIndex \u003E 0)\n            {\n                int idx = chkLstScrapes.SelectedIndex;\n                var item = chkLstScrapes.SelectedItem;\n                bool isChecked = chkLstScrapes.GetItemChecked(idx);\n\n                chkLstScrapes.Items.RemoveAt(idx);\n                chkLstScrapes.Items.Insert(idx - 1, item);\n                chkLstScrapes.SetItemChecked(idx - 1, isChecked);\n                chkLstScrapes.SelectedIndex = idx - 1;\n            }\n        }\n\n        private void BtnMoveScrapeDown_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem != null \u0026\u0026 chkLstScrapes.SelectedIndex \u003C chkLstScrapes.Items.Count - 1)\n            {\n                int idx = chkLstScrapes.SelectedIndex;\n                var item = chkLstScrapes.SelectedItem;\n                bool isChecked = chkLstScrapes.GetItemChecked(idx);\n\n                chkLstScrapes.Items.RemoveAt(idx);\n                chkLstScrapes.Items.Insert(idx \u002B 1, item);\n                chkLstScrapes.SetItemChecked(idx \u002B 1, isChecked);\n                chkLstScrapes.SelectedIndex = idx \u002B 1;\n            }\n        }\n\n        private void BtnRenameScrape_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)\n            {\n                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022Rename Scrape List\u0022, scrape.Name);\n                if (!string.IsNullOrWhiteSpace(name))\n                {\n                    scrape.Name = name.Trim();\n                    int idx = chkLstScrapes.SelectedIndex;\n                    bool isChecked = chkLstScrapes.GetItemChecked(idx);\n                    chkLstScrapes.Items[idx] = scrape;\n                    chkLstScrapes.SetItemChecked(idx, isChecked);\n                }\n            }\n        }\n==== REPLACE\n        private void BtnAddScrape_Click(object? sender, EventArgs e)\n        {\n            string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022Add Scrape List\u0022, $\u0022Scrape {_project.Scrapes.Count \u002B 1}\u0022);\n            if (!string.IsNullOrWhiteSpace(name))\n            {\n                var scrape = _project.AddScrape(name);\n                chkLstScrapes.Items.Add(scrape, scrape.IsActive);\n                chkLstScrapes.SelectedItem = scrape;\n            }\n        }\n\n        private void BtnRemoveScrape_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)\n            {\n                _project.RemoveScrape(scrape);\n                chkLstScrapes.Items.Remove(scrape);\n                LoadSelectedScrapeToUi();\n            }\n        }\n\n        private void BtnMoveScrapeUp_Click(object? sender, EventArgs e)\n        {\n            int idx = chkLstScrapes.SelectedIndex;\n            if (_project.MoveScrapeUp(idx))\n            {\n                var item = chkLstScrapes.Items[idx];\n                bool isChecked = chkLstScrapes.GetItemChecked(idx);\n\n                chkLstScrapes.Items.RemoveAt(idx);\n                chkLstScrapes.Items.Insert(idx - 1, item);\n                chkLstScrapes.SetItemChecked(idx - 1, isChecked);\n                chkLstScrapes.SelectedIndex = idx - 1;\n            }\n        }\n\n        private void BtnMoveScrapeDown_Click(object? sender, EventArgs e)\n        {\n            int idx = chkLstScrapes.SelectedIndex;\n            if (_project.MoveScrapeDown(idx))\n            {\n                var item = chkLstScrapes.Items[idx];\n                bool isChecked = chkLstScrapes.GetItemChecked(idx);\n\n                chkLstScrapes.Items.RemoveAt(idx);\n                chkLstScrapes.Items.Insert(idx \u002B 1, item);\n                chkLstScrapes.SetItemChecked(idx \u002B 1, isChecked);\n                chkLstScrapes.SelectedIndex = idx \u002B 1;\n            }\n        }\n\n        private void BtnRenameScrape_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)\n            {\n                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022Rename Scrape List\u0022, scrape.Name);\n                if (_project.RenameScrape(scrape, name))\n                {\n                    int idx = chkLstScrapes.SelectedIndex;\n                    bool isChecked = chkLstScrapes.GetItemChecked(idx);\n                    chkLstScrapes.Items[idx] = scrape;\n                    chkLstScrapes.SetItemChecked(idx, isChecked);\n                }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            btnPreviewScrape.Enabled = false;\n            try\n            {\n                var sequences = chkLstSequences.Items.Cast\u003CAutomationSequence\u003E().ToList();\n                var result = await client.ExecuteScrapeAsync(scrape, sequences, _scraper);\n                DisplayScrapeResult(result);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Scrape preview failed: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnPreviewScrape.Enabled = true;\n            }\n        }\n\n        private async void BtnRunAllScrapes_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);\n                return;\n            }\n\n            var project = BuildCurrentProjectFromUi();\n            if (project.GetActiveScrapes().Count == 0)\n            {\n                Log(\u0022[WARN] No active scrape lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n\n            btnRunAllScrapes.Enabled = false;\n            try\n            {\n                var combined = await client.ExecuteProjectScrapesCombinedAsync(project, _scraper);\n                DisplayScrapeResult(combined);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Active scrapes run aborted: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnRunAllScrapes.Enabled = true;\n            }\n        }\n\n        private void DisplayScrapeResult(ScrapeResult result)\n        {\n            _lastScrapeResult = result;\n            lblScrapeStatus.Text = $\u0022Results: {result.RecordCount} record(s) | Pages: {result.PagesScraped} | Source: {result.ScrapeName}\u0022;\n            dgvScrapePreview.DataSource = result.ToDataTable();\n            txtScrapeJsonPreview.Text = result.ToJson(true, true);\n        }\n==== REPLACE\n            btnPreviewScrape.Enabled = false;\n            try\n            {\n                var result = await client.ExecuteScrapeAsync(scrape, _project.Sequences, _scraper);\n                DisplayScrapeResult(result);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Scrape preview failed: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnPreviewScrape.Enabled = true;\n            }\n        }\n\n        private async void BtnRunAllScrapes_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);\n                return;\n            }\n\n            if (_project.GetActiveScrapes().Count == 0)\n            {\n                Log(\u0022[WARN] No active scrape lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n\n            btnRunAllScrapes.Enabled = false;\n            try\n            {\n                var combined = await client.ExecuteProjectScrapesCombinedAsync(_project, _scraper);\n                DisplayScrapeResult(combined);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Active scrapes run aborted: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnRunAllScrapes.Enabled = true;\n            }\n        }\n\n        private void DisplayScrapeResult(ScrapeResult result)\n        {\n            _lastScrapeResult = result;\n            lblScrapeStatus.Text = result.GetStatusSummary();\n            dgvScrapePreview.DataSource = result.ToDataTable();\n            txtScrapeJsonPreview.Text = result.ToJson(true, true);\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void DisplaySiteDumpResult(SiteDumpResult result)\n        {\n            _lastSiteDumpResult = result;\n\n            lblDumpStatus.Text = $\u0022Dumped {result.HtmlResources.Count} HTML, {result.CssResources.Count} CSS, {result.JavaScriptResources.Count} JS ({result.GetFormattedTotalSize()})\u0022;\n==== REPLACE\n        private void DisplaySiteDumpResult(SiteDumpResult result)\n        {\n            _lastSiteDumpResult = result;\n\n            lblDumpStatus.Text = result.GetStatusSummary();\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
      "ModelExplanation": "Refactored remaining state management, DOM snapshot refresh coalescing, project manipulation, and status formatting out of \u0060TestBedApp\u0060 into \u0060BrowserAutomationFramework\u0060 so that \u0060TestBedApp\u0060 acts strictly as a thin WinForms UI wrapper around the library:\n\n- **\u0060DomTreeSnapshot.cs\u0060 \u0026 \u0060BrowserClient.cs\u0060**:\n\n- Added \u0060DomSnapshotRefreshResult\u0060 and \u0060BrowserClient.RecordUserDomSelection\u0060 / \u0060BrowserClient.RefreshDomSnapshotCoalescedAsync\u0060 to encapsulate in-flight DOM refresh coalescing, timeout handling, and user-selection vs. DOM-mutation path resolution inside the framework DLL.\n- **\u0060AutomationProject.cs\u0060 \u0026 \u0060ScrapeDefinition.cs\u0060**:\n\n- Added project state management helpers (\u0060Reset\u0060, \u0060AddMatchUrl\u0060, \u0060UpdateMatchUrl\u0060, \u0060RemoveMatchUrl\u0060, \u0060RemoveSequence\u0060, \u0060RemoveScrape\u0060, \u0060RenameSequence\u0060, \u0060RenameScrape\u0060, \u0060HasValidMatchRules\u0060) and \u0060ScrapeDefinition.NormalizeSequenceSelection\u0060 to centralize project model mutations in the library.\n- **\u0060ScrapeResult.cs\u0060 \u0026 \u0060SiteDumpResult.cs\u0060**:\n\n- Added \u0060GetStatusSummary()\u0060 methods on both result models so summary formatting is provided directly by the library.\n- **\u0060MainForm.cs\u0060**:\n\n- Replaced manual project reconstruction, DOM refresh coalescing loops, and string formatting with direct calls to \u0060AutomationProject\u0060, \u0060BrowserClient\u0060, \u0060AutomationServer\u0060, \u0060ScrapeResult\u0060, and \u0060SiteDumpResult\u0060.\n\n### How to Test\n\n- Build the solution (\u0060dotnet build\u0060) and verify both \u0060BrowserAutomationFramework\u0060 and \u0060TestBedApp\u0060 compile with zero warnings or errors.\n- Launch \u0060TestBedApp\u0060, start the server, connect a browser tab, and verify DOM inspection, middle-click selection, Automation Editor lists, Data Scraper previews, and Reverse Engineering dumps work as expected.",
