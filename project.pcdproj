, DomNode? rootDom = null)\n        {\n            if (string.IsNullOrWhiteSpace(selector))\n                return string.Empty;\n\n            var parts = selector.Split(\u0027\u003E\u0027, StringSplitOptions.RemoveEmptyEntries)\n                .Select(p =\u003E p.Trim())\n                .ToArray();\n\n            if (parts.Length == 0)\n                return selector;\n\n            if (rootDom != null)\n            {\n                // Walk from parent up to root looking for a parent node whose tag repeats under its own parent\n                for (int i = parts.Length - 2; i \u003E= 1; i--)\n                {\n                    string ancestorPath = string.Join(\u0022 \u003E \u0022, parts.Take(i));\n                    var ancestorNode = rootDom.FindByPath(ancestorPath);\n                    if (ancestorNode?.Children != null)\n                    {\n                        string childTag = StripNthChild(parts[i]);\n                        int sameTagCount = ancestorNode.Children.Count(c =\u003E\n                            c.Type == \u0022element\u0022 \u0026\u0026\n                            string.Equals(c.TagName, childTag, StringComparison.OrdinalIgnoreCase));\n\n                        if (sameTagCount \u003E 1)\n                        {\n                            var generalizedParts = parts.ToArray();\n                            generalizedParts[i] = StripNthChild(generalizedParts[i]);\n                            return string.Join(\u0022 \u003E \u0022, generalizedParts);\n                        }\n                    }\n                }\n            }\n\n            return GeneralizeSelector(selector);\n        }\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Generalizes a container selector, including any higher-level repeating structural wrappers (such as multi-column card tables).\n        /// \u003C/summary\u003E\n        public static string GeneralizeContainerSelector(string selector, DomNode? rootDom = null)\n        {\n            if (string.IsNullOrWhiteSpace(selector))\n                return string.Empty;\n\n            var parts = selector.Split(\u0027\u003E\u0027, StringSplitOptions.RemoveEmptyEntries)\n                .Select(p =\u003E p.Trim())\n                .ToArray();\n\n            if (parts.Length == 0)\n                return selector.Trim();\n\n            parts[^1] = StripNthChild(parts[^1]);\n\n            if (rootDom != null)\n            {\n                for (int i = parts.Length - 2; i \u003E= 1; i--)\n                {\n                    string childTag = StripNthChild(parts[i]);\n                    if (string.Equals(childTag, \u0022td\u0022, StringComparison.OrdinalIgnoreCase) ||\n                        string.Equals(childTag, \u0022th\u0022, StringComparison.OrdinalIgnoreCase))\n                    {\n                        continue;\n                    }\n\n                    string ancestorPath = string.Join(\u0022 \u003E \u0022, selector.Split(\u0027\u003E\u0027, StringSplitOptions.RemoveEmptyEntries).Select(p =\u003E p.Trim()).Take(i));\n                    var ancestorNode = rootDom.FindByPath(ancestorPath);\n                    if (ancestorNode?.Children != null)\n                    {\n                        var remainingSuffix = parts.Skip(i \u002B 1).ToArray();\n                        int matchingSiblings = ancestorNode.Children.Count(c =\u003E\n                            c.Type == \u0022element\u0022 \u0026\u0026\n                            string.Equals(c.TagName, childTag, StringComparison.OrdinalIgnoreCase) \u0026\u0026\n                            HasMatchingSubpath(c, remainingSuffix));\n\n                        if (matchingSiblings \u003E 1)\n                        {\n                            parts[i] = childTag;\n                        }\n                    }\n                }\n            }\n\n            return string.Join(\u0022 \u003E \u0022, parts);\n        }\n\n        /// \u003Csummary\u003E\n        /// Generalizes a repeating field selector by finding the repeating row/container ancestor(s) or leaf segment in the DOM tree.\n        /// \u003C/summary\u003E\n        public static string GeneralizeRepeatingFieldSelector(string selector, DomNode? rootDom = null)\n        {\n            if (string.IsNullOrWhiteSpace(selector))\n                return string.Empty;\n\n            var parts = selector.Split(\u0027\u003E\u0027, StringSplitOptions.RemoveEmptyEntries)\n                .Select(p =\u003E p.Trim())\n                .ToArray();\n\n            if (parts.Length == 0)\n                return selector;\n\n            if (rootDom != null)\n            {\n                var generalizedParts = parts.ToArray();\n                bool generalizedAnyAncestor = false;\n\n                for (int i = parts.Length - 2; i \u003E= 1; i--)\n                {\n                    string childTag = StripNthChild(parts[i]);\n                    if (string.Equals(childTag, \u0022td\u0022, StringComparison.OrdinalIgnoreCase) ||\n                        string.Equals(childTag, \u0022th\u0022, StringComparison.OrdinalIgnoreCase))\n                    {\n                        continue;\n                    }\n\n                    string ancestorPath = string.Join(\u0022 \u003E \u0022, parts.Take(i));\n                    var ancestorNode = rootDom.FindByPath(ancestorPath);\n                    if (ancestorNode?.Children != null)\n                    {\n                        var remainingSuffix = generalizedParts.Skip(i \u002B 1).ToArray();\n                        int matchingSiblings = ancestorNode.Children.Count(c =\u003E\n                            c.Type == \u0022element\u0022 \u0026\u0026\n                            string.Equals(c.TagName, childTag, StringComparison.OrdinalIgnoreCase) \u0026\u0026\n                            HasMatchingSubpath(c, remainingSuffix));\n\n                        if (matchingSiblings \u003E 1)\n                        {\n                            generalizedParts[i] = childTag;\n                            generalizedAnyAncestor = true;\n                        }\n                    }\n                }\n\n                if (generalizedAnyAncestor)\n                {\n                    return string.Join(\u0022 \u003E \u0022, generalizedParts);\n                }\n            }\n\n            string lastTag = StripNthChild(parts[^1]);\n            if (parts.Length \u003E= 2 \u0026\u0026\n                (string.Equals(lastTag, \u0022td\u0022, StringComparison.OrdinalIgnoreCase) ||\n                 string.Equals(lastTag, \u0022th\u0022, StringComparison.OrdinalIgnoreCase)))\n            {\n                parts[^2] = StripNthChild(parts[^2]);\n                return string.Join(\u0022 \u003E \u0022, parts);\n            }\n\n            return GeneralizeSelector(selector);\n        }\n\n        private static bool HasMatchingSubpath(DomNode node, string[] subpathParts)\n        {\n            if (subpathParts.Length == 0)\n                return true;\n\n            if (node.Children == null || node.Children.Count == 0)\n                return false;\n\n            string currentSeg = subpathParts[0];\n            string targetTag = StripNthChild(currentSeg);\n            int? nthIndex = TryParseNthChild(currentSeg);\n\n            var elementChildren = node.Children.Where(c =\u003E c.Type == \u0022element\u0022).ToList();\n            if (nthIndex.HasValue)\n            {\n                int idx = nthIndex.Value - 1;\n                if (idx \u003C 0 || idx \u003E= elementChildren.Count)\n                    return false;\n\n                var child = elementChildren[idx];\n                if (!string.Equals(child.TagName, targetTag, StringComparison.OrdinalIgnoreCase))\n                    return false;\n\n                return HasMatchingSubpath(child, subpathParts.Skip(1).ToArray());\n            }\n\n            return elementChildren.Any(c =\u003E\n                string.Equals(c.TagName, targetTag, StringComparison.OrdinalIgnoreCase) \u0026\u0026\n                HasMatchingSubpath(c, subpathParts.Skip(1).ToArray()));\n        }\n\n        private static int? TryParseNthChild(string segment)\n        {\n            var match = Regex.Match(segment, @\u0022:nth-child\\((\\d\u002B)\\)\u0022, RegexOptions.IgnoreCase);\n            if (match.Success \u0026\u0026 int.TryParse(match.Groups[1].Value, out int n))\n                return n;\n            return null;\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Scraping\\DataScraper.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n                // 1. Run Pre-Scrape Automation Sequence if configured\n                if (!string.IsNullOrWhiteSpace(definition.PreScrapeSequenceName) \u0026\u0026\n                    sequenceLookup.TryGetValue(definition.PreScrapeSequenceName, out var preSeq))\n                {\n                    await _runner.RunSequenceAsync(client, preSeq, cancellationToken);\n                }\n\n                if (definition.WaitBeforeScrapeMs \u003E 0)\n                {\n                    await Task.Delay(definition.WaitBeforeScrapeMs, cancellationToken);\n                }\n\n                int totalPagesToScrape = definition.EnablePagination ? Math.Max(1, definition.MaxPages) : 1;\n                var seenFingerprints = new HashSet\u003Cstring\u003E();\n\n                // 2. Scrape Page Loop\n                for (int page = 1; page \u003C= totalPagesToScrape; page\u002B\u002B)\n                {\n                    cancellationToken.ThrowIfCancellationRequested();\n\n                    var pageRecords = await ExecuteSinglePageScrapeInternalAsync(client, definition, cancellationToken);\n                    var addedPageRecords = new List\u003CDictionary\u003Cstring, string?\u003E\u003E();\n\n                    foreach (var record in pageRecords)\n                    {\n                        if (definition.DeduplicateRows)\n                        {\n                            string fp = ScrapeResult.GetRecordFingerprint(record);\n                            if (!seenFingerprints.Add(fp))\n                                continue;\n                        }\n\n                        aggregateResult.Records.Add(record);\n                        addedPageRecords.Add(record);\n                    }\n\n                    aggregateResult.PagesScraped = page;\n                    OnScrapePageCompleted?.Invoke(this, new ScrapePageEventArgs(definition, page, addedPageRecords));\n\n                    // Advance to next page if more pages remain\n                    if (page \u003C totalPagesToScrape \u0026\u0026 definition.EnablePagination)\n                    {\n                        bool advanced = false;\n\n                        if (!string.IsNullOrWhiteSpace(definition.PaginationSequenceName) \u0026\u0026\n                            sequenceLookup.TryGetValue(definition.PaginationSequenceName, out var pageSeq))\n                        {\n                            await _runner.RunSequenceAsync(client, pageSeq, cancellationToken);\n                            advanced = true;\n                        }\n                        else if (!string.IsNullOrWhiteSpace(definition.NextPageSelector))\n                        {\n                            try\n                            {\n                                await client.ClickReactElementAsync(definition.NextPageSelector, cancellationToken);\n                                advanced = true;\n                            }\n                            catch\n                            {\n                                // Next page element not found or no longer clickable; stop pagination cleanly\n                                break;\n                            }\n                        }\n\n                        if (!advanced)\n                            break;\n\n                        if (definition.PageDelayMs \u003E 0)\n                        {\n                            await Task.Delay(definition.PageDelayMs, cancellationToken);\n                        }\n                    }\n                }\n==== REPLACE\n                // 1. Run Pre-Scrape Automation Sequence if configured\n                if (!string.IsNullOrWhiteSpace(definition.PreScrapeSequenceName) \u0026\u0026\n                    sequenceLookup.TryGetValue(definition.PreScrapeSequenceName, out var preSeq))\n                {\n                    string? beforePreLoadId = client.CurrentPageLoadId;\n                    await _runner.RunSequenceAsync(client, preSeq, cancellationToken);\n                    await client.WaitForPageTransitionAsync(beforePreLoadId, expectNavigation: false, cancellationToken: cancellationToken);\n                }\n\n                // Ensure initial page is completely loaded\n                await client.WaitForPageLoadAsync(cancellationToken: cancellationToken);\n\n                int totalPagesToScrape = definition.EnablePagination ? Math.Max(1, definition.MaxPages) : 1;\n                int startPageNum = Math.Max(1, definition.PaginationStartPage);\n                int pageIncrement = Math.Max(1, definition.PaginationPageIncrement);\n\n                // If URL pagination is configured, ensure Page 1 starts on the initial resolved URL\n                if (definition.EnablePagination \u0026\u0026 !string.IsNullOrWhiteSpace(definition.PaginationUrlPattern))\n                {\n                    string firstPageUrl = SelectorHelper.ResolvePaginationUrl(definition.PaginationUrlPattern, startPageNum);\n                    if (!string.IsNullOrWhiteSpace(firstPageUrl) \u0026\u0026 !IsSamePageUrl(client.CurrentUrl, firstPageUrl))\n                    {\n                        await client.NavigateToUrlAsync(firstPageUrl, cancellationToken: cancellationToken);\n                    }\n                }\n\n                if (definition.WaitBeforeScrapeMs \u003E 0)\n                {\n                    await Task.Delay(definition.WaitBeforeScrapeMs, cancellationToken);\n                }\n\n                var seenFingerprints = new HashSet\u003Cstring\u003E();\n\n                // 2. Scrape Page Loop\n                for (int page = 1; page \u003C= totalPagesToScrape; page\u002B\u002B)\n                {\n                    cancellationToken.ThrowIfCancellationRequested();\n\n                    await client.WaitForPageLoadAsync(cancellationToken: cancellationToken);\n\n                    var pageRecords = await ExecuteSinglePageScrapeInternalAsync(client, definition, cancellationToken);\n                    var addedPageRecords = new List\u003CDictionary\u003Cstring, string?\u003E\u003E();\n\n                    foreach (var record in pageRecords)\n                    {\n                        if (definition.DeduplicateRows)\n                        {\n                            string fp = ScrapeResult.GetRecordFingerprint(record);\n                            if (!seenFingerprints.Add(fp))\n                                continue;\n                        }\n\n                        aggregateResult.Records.Add(record);\n                        addedPageRecords.Add(record);\n                    }\n\n                    aggregateResult.PagesScraped = page;\n                    OnScrapePageCompleted?.Invoke(this, new ScrapePageEventArgs(definition, page, addedPageRecords));\n\n                    // Advance to next page if more pages remain\n                    if (page \u003C totalPagesToScrape \u0026\u0026 definition.EnablePagination)\n                    {\n                        bool advanced = false;\n\n                        if (!string.IsNullOrWhiteSpace(definition.PaginationUrlPattern))\n                        {\n                            int nextTargetPage = startPageNum \u002B (page * pageIncrement);\n                            string nextUrl = SelectorHelper.ResolvePaginationUrl(definition.PaginationUrlPattern, nextTargetPage);\n                            if (!string.IsNullOrWhiteSpace(nextUrl))\n                            {\n                                await client.NavigateToUrlAsync(nextUrl, cancellationToken: cancellationToken);\n                                advanced = true;\n                            }\n                        }\n                        else if (!string.IsNullOrWhiteSpace(definition.PaginationSequenceName) \u0026\u0026\n                                 sequenceLookup.TryGetValue(definition.PaginationSequenceName, out var pageSeq))\n                        {\n                            string? beforePageLoadId = client.CurrentPageLoadId;\n                            await _runner.RunSequenceAsync(client, pageSeq, cancellationToken);\n                            await client.WaitForPageTransitionAsync(beforePageLoadId, expectNavigation: false, cancellationToken: cancellationToken);\n                            advanced = true;\n                        }\n                        else if (!string.IsNullOrWhiteSpace(definition.NextPageSelector))\n                        {\n                            try\n                            {\n                                string? beforePageLoadId = client.CurrentPageLoadId;\n                                var clickRes = await client.ClickReactElementAsync(definition.NextPageSelector, cancellationToken);\n                                bool isFullNavigation = clickRes.Output != null \u0026\u0026\n                                                        clickRes.Output.StartsWith(\u0022Link click executed\u0022, StringComparison.OrdinalIgnoreCase);\n                                await client.WaitForPageTransitionAsync(beforePageLoadId, expectNavigation: isFullNavigation, cancellationToken: cancellationToken);\n                                advanced = true;\n                            }\n                            catch\n                            {\n                                // Next page element not found or no longer clickable; stop pagination cleanly\n                                break;\n                            }\n                        }\n\n                        if (!advanced)\n                            break;\n\n                        if (definition.PageDelayMs \u003E 0)\n                        {\n                            await Task.Delay(definition.PageDelayMs, cancellationToken);\n                        }\n                    }\n                }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        internal static List\u003CDictionary\u003Cstring, string?\u003E\u003E ParseRecordsFromCommandOutput(string? output)\n==== REPLACE\n        private static bool IsSamePageUrl(string? currentUrl, string targetUrl)\n        {\n            if (string.IsNullOrWhiteSpace(currentUrl) || string.IsNullOrWhiteSpace(targetUrl))\n                return false;\n\n            if (string.Equals(currentUrl.Trim(), targetUrl.Trim(), StringComparison.OrdinalIgnoreCase))\n                return true;\n\n            if (Uri.TryCreate(currentUrl, UriKind.Absolute, out var currentUri))\n            {\n                if (Uri.TryCreate(targetUrl, UriKind.Absolute, out var targetUri))\n                {\n                    return Uri.Compare(currentUri, targetUri, UriComponents.HttpRequestUrl, UriFormat.SafeUnescaped, StringComparison.OrdinalIgnoreCase) == 0;\n                }\n\n                if (Uri.TryCreate(currentUri, targetUrl, out var resolvedUri))\n                {\n                    return Uri.Compare(currentUri, resolvedUri, UriComponents.HttpRequestUrl, UriFormat.SafeUnescaped, StringComparison.OrdinalIgnoreCase) == 0;\n                }\n            }\n\n            return false;\n        }\n\n        internal static List\u003CDictionary\u003Cstring, string?\u003E\u003E ParseRecordsFromCommandOutput(string? output)\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Scraping\\ScrapeBuilder.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        /// \u003Csummary\u003E\n        /// Enables multi-page scraping using a custom \u003Csee cref=\u0022AutomationSequence\u0022/\u003E to advance pages.\n        /// \u003C/summary\u003E\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Enables multi-page scraping by navigating directly to a URL pattern for each page (e.g., \u0022https://example.com/items?page={page}\u0022).\n        /// \u003C/summary\u003E\n        public ScrapeBuilder WithUrlPagination(string urlPattern, int maxPages = 5, int startPage = 1, int pageDelayMs = 1000, bool deduplicateRows = false)\n        {\n            _definition.EnablePagination = true;\n            _definition.PaginationUrlPattern = urlPattern;\n            _definition.PaginationStartPage = startPage;\n            _definition.MaxPages = maxPages;\n            _definition.PageDelayMs = pageDelayMs;\n            _definition.DeduplicateRows = deduplicateRows;\n            return this;\n        }\n\n        /// \u003Csummary\u003E\n        /// Enables multi-page scraping using a custom \u003Csee cref=\u0022AutomationSequence\u0022/\u003E to advance pages.\n        /// \u003C/summary\u003E\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Server\\AutomationServer.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        private void CleanupStaleClients(object? state)\n        {\n            var threshold = DateTime.UtcNow.AddSeconds(-10);\n            foreach (var kvp in _clients)\n            {\n                if (kvp.Value.Mode == IpcMode.HttpPolling \u0026\u0026 kvp.Value.LastSeen \u003C threshold)\n                {\n                    if (_clients.TryRemove(kvp.Key, out var removedClient))\n                    {\n                        OnClientDisconnected?.Invoke(this, removedClient);\n                    }\n                }\n            }\n        }\n==== REPLACE\n        private void CleanupStaleClients(object? state)\n        {\n            var now = DateTime.UtcNow;\n            var httpThreshold = now.AddSeconds(-10);\n            var wsThreshold = now.AddSeconds(-15);\n\n            foreach (var kvp in _clients)\n            {\n                var client = kvp.Value;\n                bool isStale = (client.Mode == IpcMode.HttpPolling \u0026\u0026 client.LastSeen \u003C httpThreshold) ||\n                               (client.Mode == IpcMode.WebSocket \u0026\u0026 !client.IsWebSocketConnected \u0026\u0026 client.LastSeen \u003C wsThreshold);\n\n                if (isStale)\n                {\n                    if (_clients.TryRemove(kvp.Key, out var removedClient))\n                    {\n                        OnClientDisconnected?.Invoke(this, removedClient);\n                    }\n                }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private async Task HandleWebSocketAsync(HttpListenerContext context, CancellationToken cancellationToken)\n        {\n            var wsContext = await context.AcceptWebSocketAsync(null);\n            var webSocket = wsContext.WebSocket;\n            \n            string instanceId = context.Request.QueryString[\u0022instanceId\u0022] ?? Guid.NewGuid().ToString();\n            var client = new BrowserClient(instanceId, IpcMode.WebSocket, webSocket);\n            _clients[instanceId] = client;\n            OnClientConnected?.Invoke(this, client);\n\n            var buffer = new byte[1024 * 64];\n\n            try\n            {\n                while (webSocket.State == WebSocketState.Open \u0026\u0026 !cancellationToken.IsCancellationRequested)\n                {\n                    using var ms = new MemoryStream();\n                    WebSocketReceiveResult result;\n                    \n                    do\n                    {\n                        result = await webSocket.ReceiveAsync(new ArraySegment\u003Cbyte\u003E(buffer), cancellationToken);\n                        if (result.MessageType == WebSocketMessageType.Close)\n                        {\n                            await webSocket.CloseAsync(WebSocketCloseStatus.NormalClosure, \u0022\u0022, cancellationToken);\n                            break;\n                        }\n                        ms.Write(buffer, 0, result.Count);\n                    } while (!result.EndOfMessage);\n\n                    if (result.MessageType == WebSocketMessageType.Close)\n                        break;\n\n                    string message = Encoding.UTF8.GetString(ms.ToArray());\n                    using var doc = JsonDocument.Parse(message);\n                    if (doc.RootElement.TryGetProperty(\u0022event\u0022, out _))\n                    {\n                        var evt = JsonSerializer.Deserialize\u003CEventMessage\u003E(message);\n                        if (evt != null)\n                        {\n                            client.HandleEvent(evt);\n                        }\n                    }\n                    else\n                    {\n                        var cmdResult = JsonSerializer.Deserialize\u003CCommandResult\u003E(message);\n                        if (cmdResult != null)\n                        {\n                            client.HandleResult(cmdResult);\n                        }\n                    }\n                }\n            }\n            catch (Exception ex)\n            {\n                Console.WriteLine($\u0022[AutomationServer] WebSocket error: {ex.Message}\u0022);\n            }\n            finally\n            {\n                if (_clients.TryRemove(instanceId, out var removedClient))\n                {\n                    OnClientDisconnected?.Invoke(this, removedClient);\n                }\n                if (webSocket.State != WebSocketState.Closed \u0026\u0026 webSocket.State != WebSocketState.Aborted)\n                {\n                    webSocket.Dispose();\n                }\n            }\n        }\n==== REPLACE\n        private async Task HandleWebSocketAsync(HttpListenerContext context, CancellationToken cancellationToken)\n        {\n            var wsContext = await context.AcceptWebSocketAsync(null);\n            var webSocket = wsContext.WebSocket;\n            \n            string instanceId = context.Request.QueryString[\u0022instanceId\u0022] ?? Guid.NewGuid().ToString();\n            bool isNewClient = false;\n            var client = _clients.GetOrAdd(instanceId, id =\u003E\n            {\n                isNewClient = true;\n                return new BrowserClient(id, IpcMode.WebSocket, webSocket);\n            });\n\n            if (isNewClient)\n            {\n                OnClientConnected?.Invoke(this, client);\n            }\n            else\n            {\n                await client.AttachWebSocketAsync(webSocket, cancellationToken);\n            }\n\n            var buffer = new byte[1024 * 64];\n\n            try\n            {\n                while (webSocket.State == WebSocketState.Open \u0026\u0026 !cancellationToken.IsCancellationRequested)\n                {\n                    using var ms = new MemoryStream();\n                    WebSocketReceiveResult result;\n                    \n                    do\n                    {\n                        result = await webSocket.ReceiveAsync(new ArraySegment\u003Cbyte\u003E(buffer), cancellationToken);\n                        if (result.MessageType == WebSocketMessageType.Close)\n                        {\n                            await webSocket.CloseAsync(WebSocketCloseStatus.NormalClosure, \u0022\u0022, cancellationToken);\n                            break;\n                        }\n                        ms.Write(buffer, 0, result.Count);\n                    } while (!result.EndOfMessage);\n\n                    if (result.MessageType == WebSocketMessageType.Close)\n                        break;\n\n                    client.LastSeen = DateTime.UtcNow;\n                    string message = Encoding.UTF8.GetString(ms.ToArray());\n                    using var doc = JsonDocument.Parse(message);\n                    if (doc.RootElement.TryGetProperty(\u0022event\u0022, out _))\n                    {\n                        var evt = JsonSerializer.Deserialize\u003CEventMessage\u003E(message);\n                        if (evt != null)\n                        {\n                            client.HandleEvent(evt);\n                        }\n                    }\n                    else\n                    {\n                        var cmdResult = JsonSerializer.Deserialize\u003CCommandResult\u003E(message);\n                        if (cmdResult != null)\n                        {\n                            client.HandleResult(cmdResult);\n                        }\n                    }\n                }\n            }\n            catch (Exception ex)\n            {\n                Console.WriteLine($\u0022[AutomationServer] WebSocket error: {ex.Message}\u0022);\n            }\n            finally\n            {\n                client.DetachWebSocket(webSocket);\n                if (webSocket.State != WebSocketState.Closed \u0026\u0026 webSocket.State != WebSocketState.Aborted)\n                {\n                    webSocket.Dispose();\n                }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Server\\BrowserClient.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        public string InstanceId { get; }\n        public IpcMode Mode { get; }\n        public DateTime LastSeen { get; internal set; } = DateTime.UtcNow;\n        \n        private readonly WebSocket? _webSocket;\n        private readonly ConcurrentQueue\u003CCommandMessage\u003E _httpCommandQueue = new();\n        private readonly ConcurrentDictionary\u003Cstring, TaskCompletionSource\u003CCommandResult\u003E\u003E _pendingCommands = new();\n\n        /// \u003Csummary\u003E\n        /// Triggered when the browser script streams partial data back for a long-running task.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CCommandResult\u003E? OnStreamDataReceived;\n\n        /// \u003Csummary\u003E\n        /// Triggered when the browser script sends an event.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CEventMessage\u003E? OnEventReceived;\n\n        /// \u003Csummary\u003E\n        /// Triggered when the page DOM mutates.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CDomChangedEventArgs\u003E? OnDomChanged;\n\n        /// \u003Csummary\u003E\n        /// Triggered when the currently highlighted element is removed from the page DOM.\n        /// \u003C/summary\u003E\n        public event EventHandler? OnHighlightedElementRemoved;\n\n        /// \u003Csummary\u003E\n        /// Triggered when an element is selected in the browser via middle-click.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CElementClickedEventArgs\u003E? OnElementClicked;\n\n        public BrowserClient(string instanceId, IpcMode mode, WebSocket? webSocket = null)\n        {\n            InstanceId = instanceId;\n            Mode = mode;\n            _webSocket = webSocket;\n        }\n\n        /// \u003Csummary\u003E\n        /// Sends a command to the browser and awaits the final result.\n        /// \u003C/summary\u003E\n        public async Task\u003CCommandResult\u003E SendCommandAsync(string type, object? payload = null, CancellationToken cancellationToken = default)\n        {\n            var cmd = new CommandMessage { Type = type, Payload = payload };\n            var tcs = new TaskCompletionSource\u003CCommandResult\u003E();\n            _pendingCommands.TryAdd(cmd.Id, tcs);\n\n            if (Mode == IpcMode.WebSocket \u0026\u0026 _webSocket != null \u0026\u0026 _webSocket.State == WebSocketState.Open)\n            {\n                var json = JsonSerializer.Serialize(cmd);\n                var bytes = Encoding.UTF8.GetBytes(json);\n                await _webSocket.SendAsync(new ArraySegment\u003Cbyte\u003E(bytes), WebSocketMessageType.Text, true, cancellationToken);\n            }\n            else if (Mode == IpcMode.HttpPolling)\n            {\n                _httpCommandQueue.Enqueue(cmd);\n            }\n            else\n            {\n                throw new InvalidOperationException(\u0022Client is disconnected or invalid IPC mode.\u0022);\n            }\n\n            await using (cancellationToken.Register(() =\u003E tcs.TrySetCanceled()))\n            {\n                return await tcs.Task;\n            }\n        }\n==== REPLACE\n        public string InstanceId { get; }\n        public IpcMode Mode { get; }\n        public DateTime LastSeen { get; internal set; } = DateTime.UtcNow;\n        public string? CurrentUrl { get; private set; }\n        public string? CurrentPageLoadId { get; private set; }\n\n        internal bool IsWebSocketConnected =\u003E _webSocket != null \u0026\u0026 _webSocket.State == WebSocketState.Open;\n\n        private WebSocket? _webSocket;\n        private readonly SemaphoreSlim _wsSendLock = new(1, 1);\n        private TaskCompletionSource\u003Cbool\u003E _wsReconnectTcs = new(TaskCreationOptions.RunContinuationsAsynchronously);\n        private readonly ConcurrentQueue\u003CCommandMessage\u003E _httpCommandQueue = new();\n        private readonly ConcurrentDictionary\u003Cstring, (CommandMessage Command, TaskCompletionSource\u003CCommandResult\u003E Tcs)\u003E _pendingCommands = new();\n\n        /// \u003Csummary\u003E\n        /// Triggered when the browser script streams partial data back for a long-running task.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CCommandResult\u003E? OnStreamDataReceived;\n\n        /// \u003Csummary\u003E\n        /// Triggered when the browser script sends an event.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CEventMessage\u003E? OnEventReceived;\n\n        /// \u003Csummary\u003E\n        /// Triggered when the page DOM mutates.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CDomChangedEventArgs\u003E? OnDomChanged;\n\n        /// \u003Csummary\u003E\n        /// Triggered when the currently highlighted element is removed from the page DOM.\n        /// \u003C/summary\u003E\n        public event EventHandler? OnHighlightedElementRemoved;\n\n        /// \u003Csummary\u003E\n        /// Triggered when an element is selected in the browser via middle-click.\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CElementClickedEventArgs\u003E? OnElementClicked;\n\n        /// \u003Csummary\u003E\n        /// Triggered when a page finishes loading (document.readyState === \u0027complete\u0027).\n        /// \u003C/summary\u003E\n        public event EventHandler\u003CPageLoadedEventArgs\u003E? OnPageLoaded;\n\n        public BrowserClient(string instanceId, IpcMode mode, WebSocket? webSocket = null)\n        {\n            InstanceId = instanceId;\n            Mode = mode;\n            _webSocket = webSocket;\n            if (webSocket != null \u0026\u0026 webSocket.State == WebSocketState.Open)\n            {\n                _wsReconnectTcs.TrySetResult(true);\n            }\n        }\n\n        internal async Task AttachWebSocketAsync(WebSocket webSocket, CancellationToken cancellationToken = default)\n        {\n            _webSocket = webSocket;\n            LastSeen = DateTime.UtcNow;\n\n            var oldTcs = Interlocked.Exchange(ref _wsReconnectTcs, new TaskCompletionSource\u003Cbool\u003E(TaskCreationOptions.RunContinuationsAsynchronously));\n            oldTcs.TrySetResult(true);\n            _wsReconnectTcs.TrySetResult(true);\n\n            // Re-send any pending commands that were interrupted during page navigation\n            foreach (var entry in _pendingCommands.Values)\n            {\n                if (!entry.Tcs.Task.IsCompleted)\n                {\n                    try\n                    {\n                        await SendWebSocketMessageAsync(webSocket, entry.Command, cancellationToken);\n                    }\n                    catch\n                    {\n                        // Will be retried on next reconnect if socket dropped\n                    }\n                }\n            }\n        }\n\n        internal void DetachWebSocket(WebSocket webSocket)\n        {\n            LastSeen = DateTime.UtcNow;\n            if (ReferenceEquals(_webSocket, webSocket))\n            {\n                _webSocket = null;\n                Interlocked.Exchange(ref _wsReconnectTcs, new TaskCompletionSource\u003Cbool\u003E(TaskCreationOptions.RunContinuationsAsynchronously));\n            }\n        }\n\n        private async Task SendWebSocketMessageAsync(WebSocket socket, CommandMessage cmd, CancellationToken cancellationToken)\n        {\n            var json = JsonSerializer.Serialize(cmd);\n            var bytes = Encoding.UTF8.GetBytes(json);\n            await _wsSendLock.WaitAsync(cancellationToken);\n            try\n            {\n                if (socket.State == WebSocketState.Open)\n                {\n                    await socket.SendAsync(new ArraySegment\u003Cbyte\u003E(bytes), WebSocketMessageType.Text, true, cancellationToken);\n                }\n            }\n            finally\n            {\n                _wsSendLock.Release();\n            }\n        }\n\n        private async Task\u003CWebSocket\u003E WaitForActiveWebSocketAsync(int timeoutMs, CancellationToken cancellationToken)\n        {\n            var current = _webSocket;\n            if (current != null \u0026\u0026 current.State == WebSocketState.Open)\n                return current;\n\n            using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);\n            timeoutCts.CancelAfter(timeoutMs);\n\n            await using (timeoutCts.Token.Register(() =\u003E _wsReconnectTcs.TrySetCanceled()))\n            {\n                try\n                {\n                    await _wsReconnectTcs.Task;\n                }\n                catch (OperationCanceledException) when (!cancellationToken.IsCancellationRequested)\n                {\n                    throw new TimeoutException(\u0022Timed out waiting for browser client WebSocket to reconnect after navigation.\u0022);\n                }\n            }\n\n            current = _webSocket;\n            if (current != null \u0026\u0026 current.State == WebSocketState.Open)\n                return current;\n\n            throw new InvalidOperationException(\u0022Client is disconnected.\u0022);\n        }\n\n        /// \u003Csummary\u003E\n        /// Sends a command to the browser and awaits the final result.\n        /// Automatically handles transient WebSocket reconnections during full-page navigations.\n        /// \u003C/summary\u003E\n        public async Task\u003CCommandResult\u003E SendCommandAsync(string type, object? payload = null, CancellationToken cancellationToken = default)\n        {\n            var cmd = new CommandMessage { Type = type, Payload = payload };\n            var tcs = new TaskCompletionSource\u003CCommandResult\u003E(TaskCreationOptions.RunContinuationsAsynchronously);\n            _pendingCommands.TryAdd(cmd.Id, (cmd, tcs));\n\n            try\n            {\n                if (Mode == IpcMode.WebSocket)\n                {\n                    var socket = await WaitForActiveWebSocketAsync(15000, cancellationToken);\n                    try\n                    {\n                        await SendWebSocketMessageAsync(socket, cmd, cancellationToken);\n                    }\n                    catch when (!cancellationToken.IsCancellationRequested)\n                    {\n                        // If the socket closed mid-send due to page unload, AttachWebSocketAsync will re-transmit cmd\n                    }\n                }\n                else if (Mode == IpcMode.HttpPolling)\n                {\n                    _httpCommandQueue.Enqueue(cmd);\n                }\n                else\n                {\n                    throw new InvalidOperationException(\u0022Client is disconnected or invalid IPC mode.\u0022);\n                }\n\n                await using (cancellationToken.Register(() =\u003E tcs.TrySetCanceled()))\n                {\n                    return await tcs.Task;\n                }\n            }\n            finally\n            {\n                _pendingCommands.TryRemove(cmd.Id, out _);\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                else if (evt.Event == \u0022ELEMENT_CLICKED\u0022)\n                {\n                    if (evt.Payload is JsonElement clickPayload \u0026\u0026\n                        clickPayload.ValueKind == JsonValueKind.Object \u0026\u0026\n                        clickPayload.TryGetProperty(\u0022path\u0022, out var pathProp))\n                    {\n                        string? path = pathProp.GetString();\n                        if (!string.IsNullOrEmpty(path))\n                        {\n                            OnElementClicked?.Invoke(this, new ElementClickedEventArgs(path));\n                        }\n                    }\n                }\n            }\n            catch\n            {\n                // Ignore malformed event payloads\n            }\n        }\n\n        internal void HandleResult(CommandResult result)\n        {\n            if (result.Status == \u0022streaming\u0022)\n            {\n                OnStreamDataReceived?.Invoke(this, result);\n            }\n            else\n            {\n                if (_pendingCommands.TryRemove(result.TaskId, out var tcs))\n                {\n                    if (result.Status == \u0022error\u0022)\n                        tcs.TrySetException(new Exception(result.Output));\n                    else\n                        tcs.TrySetResult(result);\n                }\n            }\n        }\n==== REPLACE\n                else if (evt.Event == \u0022ELEMENT_CLICKED\u0022)\n                {\n                    if (evt.Payload is JsonElement clickPayload \u0026\u0026\n                        clickPayload.ValueKind == JsonValueKind.Object \u0026\u0026\n                        clickPayload.TryGetProperty(\u0022path\u0022, out var pathProp))\n                    {\n                        string? path = pathProp.GetString();\n                        if (!string.IsNullOrEmpty(path))\n                        {\n                            OnElementClicked?.Invoke(this, new ElementClickedEventArgs(path));\n                        }\n                    }\n                }\n                else if (evt.Event == \u0022PAGE_LOADED\u0022)\n                {\n                    if (evt.Payload is JsonElement loadPayload \u0026\u0026\n                        loadPayload.ValueKind == JsonValueKind.Object)\n                    {\n                        string pageLoadId = loadPayload.TryGetProperty(\u0022pageLoadId\u0022, out var idProp) ? (idProp.GetString() ?? string.Empty) : string.Empty;\n                        string url = loadPayload.TryGetProperty(\u0022url\u0022, out var urlProp) ? (urlProp.GetString() ?? string.Empty) : string.Empty;\n                        string readyState = loadPayload.TryGetProperty(\u0022readyState\u0022, out var rsProp) ? (rsProp.GetString() ?? \u0022complete\u0022) : \u0022complete\u0022;\n\n                        if (!string.IsNullOrEmpty(pageLoadId))\n                            CurrentPageLoadId = pageLoadId;\n                        if (!string.IsNullOrEmpty(url))\n                            CurrentUrl = url;\n\n                        OnPageLoaded?.Invoke(this, new PageLoadedEventArgs(pageLoadId, url, readyState));\n                    }\n                }\n            }\n            catch\n            {\n                // Ignore malformed event payloads\n            }\n        }\n\n        internal void HandleResult(CommandResult result)\n        {\n            if (result.Status == \u0022streaming\u0022)\n            {\n                OnStreamDataReceived?.Invoke(this, result);\n            }\n            else\n            {\n                if (_pendingCommands.TryRemove(result.TaskId, out var pending))\n                {\n                    if (result.Status == \u0022error\u0022)\n                        pending.Tcs.TrySetException(new Exception(result.Output));\n                    else\n                        pending.Tcs.TrySetResult(result);\n                }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Extensions\\ReactExtensions.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nusing System.Collections.Generic;\nusing System.Text.Json;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing BrowserAutomationFramework.Automation;\nusing BrowserAutomationFramework.Models;\nusing BrowserAutomationFramework.Scraping;\nusing BrowserAutomationFramework.Server;\n\nnamespace BrowserAutomationFramework.Extensions\n{\n    public static class ReactExtensions\n    {\n        /// \u003Csummary\u003E\n        /// Locates an element via CSS selector and simulates a trusted React click event.\n        /// \u003C/summary\u003E\n        public static Task\u003CCommandResult\u003E ClickReactElementAsync(this BrowserClient client, string selector, CancellationToken cancellationToken = default)\n        {\n            return client.SendCommandAsync(\u0022REACT_CLICK\u0022, new { selector }, cancellationToken);\n        }\n==== REPLACE\nusing System;\nusing System.Collections.Generic;\nusing System.Text.Json;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing BrowserAutomationFramework.Automation;\nusing BrowserAutomationFramework.Models;\nusing BrowserAutomationFramework.Scraping;\nusing BrowserAutomationFramework.Server;\n\nnamespace BrowserAutomationFramework.Extensions\n{\n    public static class ReactExtensions\n    {\n        /// \u003Csummary\u003E\n        /// Locates an element via CSS selector and simulates a trusted React or native click event.\n        /// \u003C/summary\u003E\n        public static Task\u003CCommandResult\u003E ClickReactElementAsync(this BrowserClient client, string selector, CancellationToken cancellationToken = default)\n        {\n            return client.SendCommandAsync(\u0022REACT_CLICK\u0022, new { selector }, cancellationToken);\n        }\n\n        /// \u003Csummary\u003E\n        /// Navigates the browser tab to the specified URL and waits until the new page has completely loaded.\n        /// \u003C/summary\u003E\n        public static async Task\u003CCommandResult\u003E NavigateToUrlAsync(\n            this BrowserClient client,\n            string url,\n            int timeoutMs = 30000,\n            CancellationToken cancellationToken = default)\n        {\n            if (string.IsNullOrWhiteSpace(url))\n                throw new ArgumentException(\u0022URL cannot be empty.\u0022, nameof(url));\n\n            string? beforeLoadId = client.CurrentPageLoadId;\n            var navResult = await client.SendCommandAsync(\u0022NAVIGATE\u0022, new { url }, cancellationToken);\n\n            if (!string.IsNullOrWhiteSpace(navResult.Output))\n            {\n                try\n                {\n                    using var doc = JsonDocument.Parse(navResult.Output);\n                    if (doc.RootElement.ValueKind == JsonValueKind.Object \u0026\u0026\n                        doc.RootElement.TryGetProperty(\u0022previousPageLoadId\u0022, out var prevProp) \u0026\u0026\n                        prevProp.ValueKind == JsonValueKind.String)\n                    {\n                        beforeLoadId = prevProp.GetString() ?? beforeLoadId;\n                    }\n                }\n                catch { }\n            }\n\n            await client.WaitForPageTransitionAsync(beforeLoadId, expectNavigation: true, timeoutMs: timeoutMs, cancellationToken: cancellationToken);\n            return navResult;\n        }\n\n        /// \u003Csummary\u003E\n        /// Waits until the current page reports \u003Cc\u003Edocument.readyState === \u0027complete\u0027\u003C/c\u003E.\n        /// \u003C/summary\u003E\n        public static async Task\u003CCommandResult\u003E WaitForPageLoadAsync(\n            this BrowserClient client,\n            int timeoutMs = 30000,\n            CancellationToken cancellationToken = default)\n        {\n            var res = await client.SendCommandAsync(\u0022WAIT_FOR_PAGE_LOAD\u0022, new { timeoutMs }, cancellationToken);\n            UpdateClientPageStateFromOutput(client, res.Output);\n            return res;\n        }\n\n        /// \u003Csummary\u003E\n        /// Waits for a page navigation or in-page transition to complete and ensures the entire page is loaded before returning.\n        /// \u003C/summary\u003E\n        public static async Task WaitForPageTransitionAsync(\n            this BrowserClient client,\n            string? previousPageLoadId,\n            bool expectNavigation = true,\n            int timeoutMs = 30000,\n            CancellationToken cancellationToken = default)\n        {\n            var pageLoadedTcs = new TaskCompletionSource\u003CPageLoadedEventArgs\u003E(TaskCreationOptions.RunContinuationsAsynchronously);\n            void OnLoaded(object? sender, PageLoadedEventArgs e)\n            {\n                if (string.IsNullOrEmpty(previousPageLoadId) || !string.Equals(e.PageLoadId, previousPageLoadId, StringComparison.Ordinal))\n                {\n                    pageLoadedTcs.TrySetResult(e);\n                }\n            }\n\n            client.OnPageLoaded \u002B= OnLoaded;\n            try\n            {\n                // Allow time for navigation/unload to begin\n                await Task.Delay(150, cancellationToken);\n\n                if (expectNavigation)\n                {\n                    using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);\n                    timeoutCts.CancelAfter(timeoutMs);\n\n                    while (!timeoutCts.IsCancellationRequested)\n                    {\n                        if (pageLoadedTcs.Task.IsCompleted)\n                            break;\n\n                        if (!string.IsNullOrEmpty(client.CurrentPageLoadId) \u0026\u0026\n                            !string.IsNullOrEmpty(previousPageLoadId) \u0026\u0026\n                            !string.Equals(client.CurrentPageLoadId, previousPageLoadId, StringComparison.Ordinal))\n                        {\n                            break;\n                        }\n\n                        var completed = await Task.WhenAny(pageLoadedTcs.Task, Task.Delay(250, timeoutCts.Token));\n                        if (completed == pageLoadedTcs.Task)\n                            break;\n\n                        try\n                        {\n                            var stateRes = await client.WaitForPageLoadAsync(timeoutMs, timeoutCts.Token);\n                            if (!string.IsNullOrEmpty(client.CurrentPageLoadId) \u0026\u0026\n                                (string.IsNullOrEmpty(previousPageLoadId) ||\n                                 !string.Equals(client.CurrentPageLoadId, previousPageLoadId, StringComparison.Ordinal)))\n                            {\n                                break;\n                            }\n                        }\n                        catch\n                        {\n                            // Page is still unloading/reconnecting\n                        }\n                    }\n                }\n\n                await client.WaitForPageLoadAsync(timeoutMs, cancellationToken);\n                await Task.Delay(100, cancellationToken);\n            }\n            finally\n            {\n                client.OnPageLoaded -= OnLoaded;\n            }\n        }\n\n        private static void UpdateClientPageStateFromOutput(BrowserClient client, string? output)\n        {\n            if (string.IsNullOrWhiteSpace(output))\n                return;\n\n            try\n            {\n                using var doc = JsonDocument.Parse(output);\n                if (doc.RootElement.ValueKind == JsonValueKind.Object)\n                {\n                    string pageLoadId = doc.RootElement.TryGetProperty(\u0022pageLoadId\u0022, out var idProp) ? (idProp.GetString() ?? string.Empty) : string.Empty;\n                    string url = doc.RootElement.TryGetProperty(\u0022url\u0022, out var urlProp) ? (urlProp.GetString() ?? string.Empty) : string.Empty;\n                    string readyState = doc.RootElement.TryGetProperty(\u0022readyState\u0022, out var rsProp) ? (rsProp.GetString() ?? \u0022complete\u0022) : \u0022complete\u0022;\n\n                    if (!string.IsNullOrEmpty(pageLoadId) || !string.IsNullOrEmpty(url))\n                    {\n                        client.HandleEvent(new EventMessage\n                        {\n                            Event = \u0022PAGE_LOADED\u0022,\n                            Payload = doc.RootElement.Clone()\n                        });\n                    }\n                }\n            }\n            catch { }\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Automation\\AutomationRunner.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        private void RegisterDefaultHandlers()\n        {\n            RegisterStepHandler(AutomationActionType.Click, (client, step, ct) =\u003E\n                client.ClickReactElementAsync(step.Selector, ct)!);\n\n            RegisterStepHandler(AutomationActionType.SetValue, (client, step, ct) =\u003E\n                client.SetReactInputValueAsync(step.Selector, step.Value, step.Overwrite, ct)!);\n\n            RegisterStepHandler(AutomationActionType.EvaluateScript, (client, step, ct) =\u003E\n                client.EvaluateJavaScriptAsync(step.Value, ct)!);\n==== REPLACE\n        private void RegisterDefaultHandlers()\n        {\n            RegisterStepHandler(AutomationActionType.Click, async (client, step, ct) =\u003E\n            {\n                string? beforeLoadId = client.CurrentPageLoadId;\n                var res = await client.ClickReactElementAsync(step.Selector, ct);\n                if (res.Output != null \u0026\u0026 res.Output.StartsWith(\u0022Link click executed\u0022, StringComparison.OrdinalIgnoreCase))\n                {\n                    await client.WaitForPageTransitionAsync(beforeLoadId, expectNavigation: true, cancellationToken: ct);\n                }\n                return res;\n            });\n\n            RegisterStepHandler(AutomationActionType.SetValue, (client, step, ct) =\u003E\n                client.SetReactInputValueAsync(step.Selector, step.Value, step.Overwrite, ct)!);\n\n            RegisterStepHandler(AutomationActionType.Navigate, (client, step, ct) =\u003E\n            {\n                string targetUrl = !string.IsNullOrWhiteSpace(step.Value) ? step.Value.Trim() : step.Selector.Trim();\n                return client.NavigateToUrlAsync(targetUrl, cancellationToken: ct)!;\n            });\n\n            RegisterStepHandler(AutomationActionType.EvaluateScript, (client, step, ct) =\u003E\n                client.EvaluateJavaScriptAsync(step.Value, ct)!);\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\n\u0060\u0060\u0060cs\n\u0