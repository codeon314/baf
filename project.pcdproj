if (definition == null) throw new ArgumentNullException(nameof(definition));            return client.HighlightElementsAsync(definition.ContainerSelector, null, true, cancellationToken);        }==== REPLACE        /// \u003Csummary\u003E        /// Highlights all repeating container elements configured on a \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E and returns the match count.        /// \u003C/summary\u003E        public static Task\u003Cint\u003E HighlightScrapeContainerAsync(            this BrowserClient client,            ScrapeDefinition definition,            CancellationToken cancellationToken = default)        {            if (definition == null) throw new ArgumentNullException(nameof(definition));            return client.HighlightElementsAsync(definition.ContainerSelector, null, true, cancellationToken);        }        /// \u003Csummary\u003E        /// Generalizes a container CSS selector using the client\u0027s cached DOM root (or \u003Cparamref name=\u0022fallbackDomRoot\u0022/\u003E),        /// and updates \u003Cparamref name=\u0022definition\u0022/\u003E if provided.        /// \u003C/summary\u003E        public static string GeneralizeContainerSelector(            this BrowserClient? client,            string rawSelector,            ScrapeDefinition? definition = null,            DomNode? fallbackDomRoot = null)        {            if (string.IsNullOrWhiteSpace(rawSelector))                return string.Empty;            DomNode? rootDom = client?.ResolveDomRoot(fallbackDomRoot) ?? fallbackDomRoot;            return definition != null                ? definition.GeneralizeAndSetContainer(rawSelector, rootDom)                : SelectorHelper.GeneralizeContainerSelector(rawSelector, rootDom);        }        /// \u003Csummary\u003E        /// Highlights the repeating container configured on \u003Cparamref name=\u0022definition\u0022/\u003E if provided,        /// or highlights all elements matching \u003Cparamref name=\u0022rawSelector\u00