e;\n\n            bool expandedChanged = _snapshot.ExpandAncestors(targetItem, _expandedKeys);\n            if (expandedChanged || _visibleRows.Count == 0)\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private static bool ExpandAncestorsInSet(DomTreeSnapshot snapshot, DomTreeItem item, HashSet\u003Cstring\u003E expandedSet)\n        {\n            bool addedAny = false;\n            string? parentKey = item.ParentKey;\n            while (!string.IsNullOrEmpty(parentKey))\n            {\n                if (expandedSet.Add(parentKey))\n                    addedAny = true;\n\n                if (snapshot.ItemsByKey.TryGetValue(parentKey, out var parentItem))\n                    parentKey = parentItem.ParentKey;\n                else\n                    break;\n            }\n            return addedAny;\n        }\n\n        private void RebuildVisibleRowsInternal()\n        {\n            if (_snapshot == null)\n            {\n                _visibleRows.Clear();\n                _rowIndexByKey.Clear();\n                _maxContentWidth = 200;\n                return;\n            }\n\n            _visibleRows = DomTreeSnapshot.BuildVisibleRows(_snapshot.RootItem, _expandedKeys);\n            _rowIndexByKey.Clear();\n\n            int maxEstimatedW = 200;\n            for (int i = 0; i \u003C _visibleRows.Count; i\u002B\u002B)\n            {\n                var row = _visibleRows[i];\n                _rowIndexByKey[row.UniqueKey] = i;\n\n                int rowWidth = _paddingLeft \u002B (row.Depth * _indentWidth) \u002B _glyphColumnWidth \u002B\n                               (row.MeasuredFontGeneration == _fontGeneration\n                                   ? GetMeasuredRowTextWidth(row)\n                                   : (row.EstimatedCharLength * _avgCharWidth)) \u002B 32;\n\n                if (rowWidth \u003E maxEstimatedW)\n                    maxEstimatedW = rowWidth;\n            }\n\n            _maxContentWidth = maxEstimatedW;\n            UpdateScrollBars();\n        }\n\n        private int GetMeasuredRowTextWidth(DomTreeItem item)\n        {\n            bool includeCollapsedSuffix = item.HasChildren \u0026\u0026 !_expandedKeys.Contains(item.UniqueKey);\n            return item.OpenTotalWidth \u002B (includeCollapsedSuffix ? item.CollapsedSuffixTotalWidth : 0);\n        }\n\n        private void EnsureItemMeasured(Graphics g, DomTreeItem item)\n        {\n            if (item.MeasuredFontGeneration == _fontGeneration \u0026\u0026 item.OpenPartWidths != null)\n                return;\n\n            const TextFormatFlags measureFlags = TextFormatFlags.NoPadding | TextFormatFlags.SingleLine | TextFormatFlags.NoPrefix;\n\n            var openParts = item.OpenParts;\n            int[] openWidths = new int[openParts.Length];\n            int openTotal = 0;\n            for (int i = 0; i \u003C openParts.Length; i\u002B\u002B)\n            {\n                int w = TextRenderer.MeasureText(g, openParts[i].Text, _codeFont, Size.Empty, measureFlags).Width;\n                openWidths[i] = w;\n                openTotal \u002B= w;\n            }\n\n            var suffixParts = item.CollapsedSuffixParts;\n            int[] suffixWidths = suffixParts.Length \u003E 0 ? new int[suffixParts.Length] : Array.Empty\u003Cint\u003E();\n            int suffixTotal = 0;\n            for (int i = 0; i \u003C suffixParts.Length; i\u002B\u002B)\n            {\n                int w = TextRenderer.MeasureText(g, suffixParts[i].Text, _codeFont, Size.Empty, measureFlags).Width;\n                suffixWidths[i] = w;\n                suffixTotal \u002B= w;\n            }\n\n            item.OpenPartWidths = openWidths;\n            item.CollapsedSuffixWidths = suffixWidths;\n            item.OpenTotalWidth = openTotal;\n            item.CollapsedSuffixTotalWidth = suffixTotal;\n            item.MeasuredFontGeneration = _fontGeneration;\n\n            int fullRowW = _paddingLeft \u002B (item.Depth * _indentWidth) \u002B _glyphColumnWidth \u002B openTotal \u002B suffixTotal \u002B 32;\n            if (fullRowW \u003E _maxContentWidth)\n            {\n                _maxContentWidth = fullRowW;\n                UpdateScrollBars();\n            }\n        }\n==== REPLACE\n        private void RebuildVisibleRowsInternal()\n        {\n            if (_snapshot == null)\n            {\n                _visibleRows.Clear();\n                _rowIndexByKey.Clear();\n                _maxContentWidth = 200;\n                return;\n            }\n\n            _visibleRows = _snapshot.BuildVisibleRows(_expandedKeys);\n            _rowIndexByKey.Clear();\n\n            int maxEstimatedW = 200;\n            for (int i = 0; i \u003C _visibleRows.Count; i\u002B\u002B)\n            {\n                var row = _visibleRows[i];\n                _rowIndexByKey[row.UniqueKey] = i;\n\n                int textWidth = (_measureCache.TryGetValue(row.UniqueKey, out var cached) \u0026\u0026 cached.MeasuredFontGeneration == _fontGeneration)\n                    ? GetMeasuredRowTextWidth(row, cached)\n                    : (row.EstimatedCharLength * _avgCharWidth);\n\n                int rowWidth = _paddingLeft \u002B (row.Depth * _indentWidth) \u002B _glyphColumnWidth \u002B textWidth \u002B 32;\n\n                if (rowWidth \u003E maxEstimatedW)\n                    maxEstimatedW = rowWidth;\n            }\n\n            _maxContentWidth = maxEstimatedW;\n            UpdateScrollBars();\n        }\n\n        private int GetMeasuredRowTextWidth(DomTreeItem item, RowMeasureCache cache)\n        {\n            bool includeCollapsedSuffix = item.HasChildren \u0026\u0026 !_expandedKeys.Contains(item.UniqueKey);\n            return cache.OpenTotalWidth \u002B (includeCollapsedSuffix ? cache.CollapsedSuffixTotalWidth : 0);\n        }\n\n        private RowMeasureCache EnsureItemMeasured(Graphics g, DomTreeItem item)\n        {\n            if (_measureCache.TryGetValue(item.UniqueKey, out var existing) \u0026\u0026\n                existing.MeasuredFontGeneration == _fontGeneration)\n            {\n                return existing;\n            }\n\n            const TextFormatFlags measureFlags = TextFormatFlags.NoPadding | TextFormatFlags.SingleLine | TextFormatFlags.NoPrefix;\n\n            var openParts = item.OpenParts;\n            int[] openWidths = new int[openParts.Length];\n            int openTotal = 0;\n            for (int i = 0; i \u003C openParts.Length; i\u002B\u002B)\n            {\n                int w = TextRenderer.MeasureText(g, openParts[i].Text, _codeFont, Size.Empty, measureFlags).Width;\n                openWidths[i] = w;\n                openTotal \u002B= w;\n            }\n\n            var suffixParts = item.CollapsedSuffixParts;\n            int[] suffixWidths = suffixParts.Length \u003E 0 ? new int[suffixParts.Length] : Array.Empty\u003Cint\u003E();\n            int suffixTotal = 0;\n            for (int i = 0; i \u003C suffixParts.Length; i\u002B\u002B)\n            {\n                int w = TextRenderer.MeasureText(g, suffixParts[i].Text, _codeFont, Size.Empty, measureFlags).Width;\n                suffixWidths[i] = w;\n                suffixTotal \u002B= w;\n            }\n\n            var cache = new RowMeasureCache\n            {\n                OpenPartWidths = openWidths,\n                CollapsedSuffixWidths = suffixWidths,\n                OpenTotalWidth = openTotal,\n                CollapsedSuffixTotalWidth = suffixTotal,\n                MeasuredFontGeneration = _fontGeneration\n            };\n            _measureCache[item.UniqueKey] = cache;\n\n            int fullRowW = _paddingLeft \u002B (item.Depth * _indentWidth) \u002B _glyphColumnWidth \u002B openTotal \u002B suffixTotal \u002B 32;\n            if (fullRowW \u003E _maxContentWidth)\n            {\n                _maxContentWidth = fullRowW;\n                UpdateScrollBars();\n            }\n\n            return cache;\n        }\n\u003E\u003E\u003E\u003E\