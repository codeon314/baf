et; }        public int EstimatedCharLength { get; }        internal int MeasuredFontGeneration;        internal int[]? OpenPartWidths;        internal int[]? CollapsedSuffixWidths;        internal int OpenTotalWidth;        internal int CollapsedSuffixTotalWidth;        public DomTreeItem(            DomNode node,            string uniqueKey,            string? parentKey,            int depth,            DomDisplayPart[] openParts,            DomDisplayPart[] collapsedSuffixParts,            int estimatedCharLength)        {            Node = node;            UniqueKey = uniqueKey;            ParentKey = parentKey;            Depth = depth;            OpenParts = openParts;            CollapsedSuffixParts = collapsedSuffixParts;            EstimatedCharLength = estimatedCharLength;        }    }    /// \u003Csummary\u003E    /// Thread-safe, pre-indexed DOM tree snapshot built on a background worker thread.    /// Provides O(1) lookup by CSS path and pre-tokenized syntax highlighting parts.    /// \u003C/summary\u003E    public sealed class DomTreeSnapshot    {        private const int MaxAttrValueDisplayLength = 180;        private const int MaxTextDisplayLength = 220;        private const int MaxAttributesDisplayed = 24;        public DomNode RootNode { get; }        public DomTreeItem RootItem { get; }        public Dictionary\u003Cstring, DomTreeItem\u003E ItemsByKey { get; }        private DomTreeSnapshot(DomNode rootNode, DomTreeItem rootItem, Dictionary\u003Cstring, DomTreeItem\u003E itemsByKey)        {            RootNode = rootNode;            RootItem = rootItem;            ItemsByKey = itemsByKey;        }        public static DomTreeSnapshot Build(DomNode rootNode)        {            var itemsByKey = new Dictionary\u003Cstring, DomTreeItem\u003E(4096, StringComparer.Ordinal);            var rootItem = BuildItemRecursive(rootNode, null, 0, 0, itemsByKey);            return new DomTreeSnapshot(rootNode, rootItem, itemsByKey);        }        public static List\u003CDomTreeItem\u003E BuildVisibleRows(DomTreeItem rootItem, HashSet\u003Cstring\u003E expandedKeys)        {            var list = new List\u003CDomTreeItem\u003E(Math.Max(64, expandedKeys.Count * 8));            AppendVisibleRecursive(rootItem, expandedKeys, list);            return list;        }        private static void AppendVisibleRecursive(DomTreeItem item, HashSet\u003Cstring\u003E expandedKeys, List\u003CDomTreeItem\u003E output)        {            output.Add(item);            if (item.HasChildren \u0026\u0026 expandedKeys.Contains(item.UniqueKey))            {                var children = item.Children;                for (int i = 0; i \u003C children.Count; i\u002B\u002B)                {                    AppendVisibleRecursive(children[i], expandedKeys, output);                }            }        }        private static DomTreeItem BuildItemRecursive(            DomNode node,            string? parentKey,            int depth,            int siblingIndex,            Dictionary\u003Cstring, DomTreeItem\u003E itemsByKey)        {            string uniqueKey = !string.IsNullOrEmpty(node.Path)                ? node.Path!                : $\u0022{parentKey ?? \u0022root\u0022}#text_{siblingIndex}\u0022;            BuildDisplayParts(node, out var openParts, out var suffixParts, out int charLen);            var item = new DomTreeItem(node, uniqueKey, parentKey, depth, openParts, suffixParts, charLen);            itemsByKey[uniqueKey] = item;            if (node.Children != null \u0026\u0026 node.Children.Count \u003E 0)            {                for (int i = 0; i \u003C node.Children.Count; i\u002B\u002B)                {                    var childItem = BuildItemRecursive(node.Children[i], uniqueKey, depth \u002B 1, i, itemsByKey);                    item.Children.Add(childItem);                }            }            return item;        }        private static void BuildDisplayParts(            DomNode domNode,            out DomDisplayPart[] openParts,            out DomDisplayPart[] collapsedSuffixParts,            out int estimatedCharLen)        {            estimatedCharLen = 0;            if (domNode.Type == \u0022element\u0022)            {                string tag = domNode.TagName ?? \u0022element\u0022;                int attrCount = domNode.Attributes?.Count ?? 0;                var parts = new List\u003CDomDisplayPart\u003E(3 \u002B (Math.Min(attrCount, MaxAttributesDisplayed) * 3));                parts.Add(new DomDisplayPart(\u0022\u003C\u0022, DomTokenColor.Punctuation));                parts.Add(new DomDisplayPart(tag, DomTokenColor.TagName));                estimatedCharLen \u002B= 1 \u002B tag.Length;                if (domNode.Attributes != null \u0026\u0026 attrCount \u003E 0)                {                    int processed = 0;                    foreach (var attr in domNode.Attributes)                    {                        if (processed \u003E= MaxAttributesDisplayed)                        {                            parts.Add(new DomDisplayPart(\u0022 ...\u0022, DomTokenColor.Punctuation));                            estimatedCharLen \u002B= 4;                            break;                        }                        string cleanVal = SanitizeSingleLine(attr.Value, MaxAttrValueDisplayLength);                        string quotedVal = $\u0022\\\u0022{cleanVal}\\\u0022\u0022;                        parts.Add(new DomDisplayPart($\u0022 {attr.Key}\u0022, DomTokenColor.AttributeName));                        parts.Add(new DomDisplayPart(\u0022=\u0022, DomTokenColor.Punctuation));                        parts.Add(new DomDisplayPart(quotedVal, DomTokenColor.AttributeValue));                        estimatedCharLen \u002B= 1 \u002B attr.Key.Length \u002B 1 \u002B quotedVal.Length;                        processed\u002B\u002B;                    }                }                parts.Add(new DomDisplayPart(\u0022\u003E\u0022, DomTokenColor.Punctuation));          