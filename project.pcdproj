ton btnRunAutomation;\n        private System.Windows.Forms.SplitContainer splitEditor;\n        private System.Windows.Forms.ListBox lstSteps;\n        private System.Windows.Forms.PropertyGrid pgStepDetails;\n        private System.Windows.Forms.ContextMenuStrip ctxDomNode;\n        private System.Windows.Forms.ToolStripMenuItem mnuClickElement;\n        private System.Windows.Forms.ToolStripMenuItem mnuSetValue;\n        private System.Windows.Forms.ToolStripMenuItem mnuAddClickTo;\n        private System.Windows.Forms.ToolStripMenuItem mnuAddSetValueTo;\n        private System.Windows.Forms.SplitContainer splitSequences;\n        private System.Windows.Forms.CheckedListBox chkLstSequences;\n        private System.Windows.Forms.Panel pnlSequencesTop;\n==== REPLACE\n        private System.Windows.Forms.TableLayoutPanel pnlEditorTop;\n        private System.Windows.Forms.FlowLayoutPanel flpStepButtons;\n        private System.Windows.Forms.Button btnAddStep;\n        private System.Windows.Forms.Button btnRemoveStep;\n        private System.Windows.Forms.Button btnRunAutomation;\n        private System.Windows.Forms.SplitContainer splitEditor;\n        private System.Windows.Forms.ListBox lstSteps;\n        private System.Windows.Forms.PropertyGrid pgStepDetails;\n        private System.Windows.Forms.ContextMenuStrip ctxDomNode;\n        private System.Windows.Forms.ToolStripMenuItem mnuClickElement;\n        private System.Windows.Forms.ToolStripMenuItem mnuSetValue;\n        private System.Windows.Forms.ToolStripMenuItem mnuAddClickTo;\n        private System.Windows.Forms.ToolStripMenuItem mnuAddSetValueTo;\n        private System.Windows.Forms.SplitContainer splitSequences;\n        private System.Windows.Forms.CheckedListBox chkLstSequences;\n        private System.Windows.Forms.FlowLayoutPanel pnlSequencesTop;\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        // Data Scraper Tab Controls\n        private CheckedListBox chkLstScrapes = null!;\n        private TextBox txtContainerSelector = null!;\n        private ComboBox cmbPreScrapeSeq = null!;\n        private ComboBox cmbPostScrapeSeq = null!;\n        private CheckBox chkEnablePagination = null!;\n        private NumericUpDown numMaxPages = null!;\n        private TextBox txtNextPageSelector = null!;\n        private ListBox lstScrapeFields = null!;\n        private PropertyGrid pgScrapeFieldDetails = null!;\n        private Button btnPreviewScrape = null!;\n        private Button btnRunAllScrapes = null!;\n        private Label lblScrapeStatus = null!;\n        private DataGridView dgvScrapePreview = null!;\n        private TextBox txtScrapeJsonPreview = null!;\n\n        public MainForm()\n        {\n            InitializeComponent();\n            InitializeScraperTabUi();\n            ApplyFixedSingleBorders(this);\n==== REPLACE\n        // Data Scraper Tab Controls\n        private SplitContainer splitScraperMain = null!;\n        private SplitContainer splitScraperRight = null!;\n        private SplitContainer splitFields = null!;\n        private CheckedListBox chkLstScrapes = null!;\n        private TextBox txtContainerSelector = null!;\n        private ComboBox cmbPreScrapeSeq = null!;\n        private ComboBox cmbPostScrapeSeq = null!;\n        private CheckBox chkEnablePagination = null!;\n        private NumericUpDown numMaxPages = null!;\n        private TextBox txtNextPageSelector = null!;\n        private ListBox lstScrapeFields = null!;\n        private PropertyGrid pgScrapeFieldDetails = null!;\n        private Button btnPreviewScrape = null!;\n        private Button btnRunAllScrapes = null!;\n        private Label lblScrapeStatus = null!;\n        private DataGridView dgvScrapePreview = null!;\n        private TextBox txtScrapeJsonPreview = null!;\n        private bool _domSplittersInitialized;\n        private bool _editorSplittersInitialized;\n        private bool _scraperSplittersInitialized;\n\n        public MainForm()\n        {\n            InitializeComponent();\n            InitializeScraperTabUi();\n            ApplyFixedSingleBorders(this);\n\n            tabMain.SelectedIndexChanged \u002B= (s, e) =\u003E EnsureTabSplittersConfigured();\n            Shown \u002B= (s, e) =\u003E EnsureTabSplittersConfigured();\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        // --- Data Scraper UI \u0026 Point-and-Click Handlers ---\n\n        private void InitializeScraperTabUi()\n        {\n            var darkBg = Color.FromArgb(30, 30, 30);\n            var darkLine = Color.FromArgb(45, 45, 48);\n\n            var splitScraperMain = new SplitContainer\n            {\n                Dock = DockStyle.Fill,\n                SplitterDistance = 300\n            };\n\n            // Left Panel: Scrape Lists \u0026 Scrape-Level Options\n            var pnlScrapesTop = new Panel\n            {\n                Dock = DockStyle.Top,\n                Height = 86,\n                Padding = new Padding(5)\n            };\n\n            var btnAddScrape = new Button { Text = \u0022Add Scrape\u0022, Location = new Point(5, 5), Size = new Size(135, 34), UseVisualStyleBackColor = true };\n            var btnRemoveScrape = new Button { Text = \u0022Remove\u0022, Location = new Point(145, 5), Size = new Size(135, 34), UseVisualStyleBackColor = true };\n            var btnMoveScrapeUp = new Button { Text = \u0022Move Up\u0022, Location = new Point(5, 44), Size = new Size(85, 34), UseVisualStyleBackColor = true };\n            var btnMoveScrapeDown = new Button { Text = \u0022Move Down\u0022, Location = new Point(95, 44), Size = new Size(95, 34), UseVisualStyleBackColor = true };\n            var btnRenameScrape = new Button { Text = \u0022Rename\u0022, Location = new Point(195, 44), Size = new Size(85, 34), UseVisualStyleBackColor = true };\n\n            btnAddScrape.Click \u002B= BtnAddScrape_Click;\n            btnRemoveScrape.Click \u002B= BtnRemoveScrape_Click;\n            btnMoveScrapeUp.Click \u002B= BtnMoveScrapeUp_Click;\n            btnMoveScrapeDown.Click \u002B= BtnMoveScrapeDown_Click;\n            btnRenameScrape.Click \u002B= BtnRenameScrape_Click;\n\n            pnlScrapesTop.Controls.AddRange(new Control[] { btnAddScrape, btnRemoveScrape, btnMoveScrapeUp, btnMoveScrapeDown, btnRenameScrape });\n\n            chkLstScrapes = new CheckedListBox\n            {\n                Dock = DockStyle.Fill,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                BorderStyle = BorderStyle.FixedSingle,\n                IntegralHeight = false\n            };\n            chkLstScrapes.SelectedIndexChanged \u002B= ChkLstScrapes_SelectedIndexChanged;\n            chkLstScrapes.ItemCheck \u002B= ChkLstScrapes_ItemCheck;\n\n            var grpScrapeConfig = new GroupBox\n            {\n                Dock = DockStyle.Bottom,\n                Height = 235,\n                Text = \u0022Container \u0026 Automation Hooks\u0022,\n                Padding = new Padding(8),\n                ForeColor = Color.LightGray\n            };\n\n            var tlpConfig = new TableLayoutPanel\n            {\n                Dock = DockStyle.Fill,\n                ColumnCount = 2,\n                RowCount = 6\n            };\n            tlpConfig.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute, 115F));\n            tlpConfig.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100F));\n            for (int i = 0; i \u003C 6; i\u002B\u002B) tlpConfig.RowStyles.Add(new RowStyle(SizeType.AutoSize));\n\n            var lblContainer = new Label { Text = \u0022Container CSS:\u0022, AutoSize = true, Anchor = AnchorStyles.Left };\n            txtContainerSelector = new TextBox { Dock = DockStyle.Fill, BackColor = darkBg, ForeColor = Color.LightGray };\n            txtContainerSelector.TextChanged \u002B= ScrapeConfigControl_Changed;\n\n            var pnlContainerBtns = new FlowLayoutPanel { Dock = DockStyle.Fill, AutoSize = true, Margin = new Padding(0, 2, 0, 4) };\n            var btnGenContainer = new Button { Text = \u0022Generalize\u0022, AutoSize = true, UseVisualStyleBackColor = true };\n            var btnHlContainer = new Button { Text = \u0022Highlight\u0022, AutoSize = true, UseVisualStyleBackColor = true };\n            var btnClrContainer = new Button { Text = \u0022Clear\u0022, AutoSize = true, UseVisualStyleBackColor = true };\n            btnGenContainer.Click \u002B= BtnGeneralizeContainer_Click;\n            btnHlContainer.Click \u002B= BtnHighlightContainer_Click;\n            btnClrContainer.Click \u002B= (s, e) =\u003E txtContainerSelector.Text = string.Empty;\n            pnlContainerBtns.Controls.AddRange(new Control[] { btnGenContainer, btnHlContainer, btnClrContainer });\n\n            var lblPreSeq = new Label { Text = \u0022Pre-Automation:\u0022, AutoSize = true, Anchor = AnchorStyles.Left };\n            cmbPreScrapeSeq = new ComboBox { Dock = DockStyle.Fill, DropDownStyle = ComboBoxStyle.DropDownList, BackColor = darkBg, ForeColor = Color.LightGray };\n            cmbPreScrapeSeq.SelectedIndexChanged \u002B= ScrapeConfigControl_Changed;\n\n            var lblPostSeq = new Label { Text = \u0022Post-Automation:\u0022, AutoSize = true, Anchor = AnchorStyles.Left };\n            cmbPostScrapeSeq = new ComboBox { Dock = DockStyle.Fill, DropDownStyle = ComboBoxStyle.DropDownList, BackColor = darkBg, ForeColor = Color.LightGray };\n            cmbPostScrapeSeq.SelectedIndexChanged \u002B= ScrapeConfigControl_Changed;\n\n            chkEnablePagination = new CheckBox { Text = \u0022Paginate (Max):\u0022, AutoSize = true, Anchor = AnchorStyles.Left };\n            chkEnablePagination.CheckedChanged \u002B= ScrapeConfigControl_Changed;\n\n            numMaxPages = new NumericUpDown\n            {\n                Minimum = 1,\n                Maximum = 500,\n                Value = 3,\n                Width = 70,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray\n            };\n            numMaxPages.ValueChanged \u002B= ScrapeConfigControl_Changed;\n\n            var lblNextBtn = new Label { Text = \u0022Next Button CSS:\u0022, AutoSize = true, Anchor = AnchorStyles.Left };\n            txtNextPageSelector = new TextBox { Dock = DockStyle.Fill, BackColor = darkBg, ForeColor = Color.LightGray };\n            txtNextPageSelector.TextChanged \u002B= ScrapeConfigControl_Changed;\n\n            tlpConfig.Controls.Add(lblContainer, 0, 0);\n            tlpConfig.Controls.Add(txtContainerSelector, 1, 0);\n            tlpConfig.Controls.Add(pnlContainerBtns, 1, 1);\n            tlpConfig.Controls.Add(lblPreSeq, 0, 2);\n            tlpConfig.Controls.Add(cmbPreScrapeSeq, 1, 2);\n            tlpConfig.Controls.Add(lblPostSeq, 0, 3);\n            tlpConfig.Controls.Add(cmbPostScrapeSeq, 1, 3);\n            tlpConfig.Controls.Add(chkEnablePagination, 0, 4);\n            tlpConfig.Controls.Add(numMaxPages, 1, 4);\n            tlpConfig.Controls.Add(lblNextBtn, 0, 5);\n            tlpConfig.Controls.Add(txtNextPageSelector, 1, 5);\n\n            grpScrapeConfig.Controls.Add(tlpConfig);\n\n            splitScraperMain.Panel1.Controls.Add(chkLstScrapes);\n            splitScraperMain.Panel1.Controls.Add(pnlScrapesTop);\n            splitScraperMain.Panel1.Controls.Add(grpScrapeConfig);\n\n            // Right Panel: Top = Fields \u0026 PropertyGrid, Bottom = Results \u0026 Preview\n            var splitScraperRight = new SplitContainer\n            {\n                Dock = DockStyle.Fill,\n                Orientation = Orientation.Horizontal,\n                SplitterDistance = 210\n            };\n\n            var pnlFieldsToolbar = new Panel { Dock = DockStyle.Top, Height = 46, Padding = new Padding(4) };\n            var btnAddField = new Button { Text = \u0022Add Field\u0022, Dock = DockStyle.Left, Width = 90, UseVisualStyleBackColor = true };\n            var btnRemoveField = new Button { Text = \u0022Remove\u0022, Dock = DockStyle.Left, Width = 80, UseVisualStyleBackColor = true };\n            var btnFieldUp = new Button { Text = \u0022Up\u0022, Dock = DockStyle.Left, Width = 50, UseVisualStyleBackColor = true };\n            var btnFieldDown = new Button { Text = \u0022Down\u0022, Dock = DockStyle.Left, Width = 60, UseVisualStyleBackColor = true };\n            var btnGenField = new Button { Text = \u0022Generalize\u0022, Dock = DockStyle.Left, Width = 90, UseVisualStyleBackColor = true };\n            var btnHlField = new Button { Text = \u0022Highlight\u0022, Dock = DockStyle.Left, Width = 85, UseVisualStyleBackColor = true };\n\n            btnPreviewScrape = new Button { Text = \u0022Preview Scrape\u0022, Dock = DockStyle.Right, Width = 130, UseVisualStyleBackColor = true };\n            btnRunAllScrapes = new Button { Text = \u0022Run Active Scrapes\u0022, Dock = DockStyle.Right, Width = 145, UseVisualStyleBackColor = true };\n\n            btnAddField.Click \u002B= BtnAddScrapeField_Click;\n            btnRemoveField.Click \u002B= BtnRemoveScrapeField_Click;\n            btnFieldUp.Click \u002B= BtnMoveScrapeFieldUp_Click;\n            btnFieldDown.Click \u002B= BtnMoveScrapeFieldDown_Click;\n            btnGenField.Click \u002B= BtnGeneralizeScrapeField_Click;\n            btnHlField.Click \u002B= BtnHighlightScrapeField_Click;\n            btnPreviewScrape.Click \u002B= BtnPreviewScrape_Click;\n            btnRunAllScrapes.Click \u002B= BtnRunAllScrapes_Click;\n\n            pnlFieldsToolbar.Controls.AddRange(new Control[]\n            {\n                btnRunAllScrapes, btnPreviewScrape,\n                btnHlField, btnGenField, btnFieldDown, btnFieldUp, btnRemoveField, btnAddField\n            });\n\n            var splitFields = new SplitContainer { Dock = DockStyle.Fill, SplitterDistance = 220 };\n            lstScrapeFields = new ListBox\n            {\n                Dock = DockStyle.Fill,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                BorderStyle = BorderStyle.FixedSingle,\n                IntegralHeight = false\n            };\n            lstScrapeFields.SelectedIndexChanged \u002B= LstScrapeFields_SelectedIndexChanged;\n\n            pgScrapeFieldDetails = new PropertyGrid\n            {\n                Dock = DockStyle.Fill,\n                BackColor = darkBg,\n                CategoryForeColor = Color.LightGray,\n                CategorySplitterColor = darkLine,\n                CommandsBorderColor = darkLine,\n                CommandsForeColor = Color.LightGray,\n                DisabledItemForeColor = Color.FromArgb(127, 127, 127),\n                HelpBackColor = darkBg,\n                HelpBorderColor = darkLine,\n                HelpForeColor = Color.LightGray,\n                LineColor = darkLine,\n                ViewBackColor = darkBg,\n                ViewBorderColor = darkLine,\n                ViewForeColor = Color.LightGray\n            };\n            pgScrapeFieldDetails.PropertyValueChanged \u002B= PgScrapeFieldDetails_PropertyValueChanged;\n\n            splitFields.Panel1.Controls.Add(lstScrapeFields);\n            splitFields.Panel2.Controls.Add(pgScrapeFieldDetails);\n\n            splitScraperRight.Panel1.Controls.Add(splitFields);\n            splitScraperRight.Panel1.Controls.Add(pnlFieldsToolbar);\n\n            // Bottom Panel: Results Preview \u0026 Export\n            var pnlResultsToolbar = new Panel { Dock = DockStyle.Top, Height = 40, Padding = new Padding(4) };\n            lblScrapeStatus = new Label\n            {\n                Text = \u0022Scrape Results Preview (0 records)\u0022,\n                AutoSize = true,\n                Dock = DockStyle.Left,\n                TextAlign = ContentAlignment.MiddleLeft,\n                Padding = new Padding(4, 6, 0, 0)\n            };\n\n            var btnExportJson = new Button { Text = \u0022Export JSON...\u0022, Dock = DockStyle.Right, Width = 115, UseVisualStyleBackColor = true };\n            var btnExportCsv = new Button { Text = \u0022Export CSV...\u0022, Dock = DockStyle.Right, Width = 110, UseVisualStyleBackColor = true };\n            var btnCopyJson = new Button { Text = \u0022Copy JSON\u0022, Dock = DockStyle.Right, Width = 100, UseVisualStyleBackColor = true };\n\n            btnExportJson.Click \u002B= BtnExportScrapeJson_Click;\n            btnExportCsv.Click \u002B= BtnExportScrapeCsv_Click;\n            btnCopyJson.Click \u002B= BtnCopyScrapeJson_Click;\n\n            pnlResultsToolbar.Controls.AddRange(new Control[] { btnExportJson, btnExportCsv, btnCopyJson, lblScrapeStatus });\n\n            var tabPreview = new TabControl { Dock = DockStyle.Fill };\n            var tabTable = new TabPage(\u0022Table View\u0022) { BackColor = darkBg };\n            var tabJson = new TabPage(\u0022JSON View\u0022) { BackColor = darkBg };\n\n            dgvScrapePreview = new DataGridView\n            {\n                Dock = DockStyle.Fill,\n                BackgroundColor = darkBg,\n                ForeColor = Color.LightGray,\n                GridColor = darkLine,\n                BorderStyle = BorderStyle.FixedSingle,\n                ReadOnly = true,\n                AllowUserToAddRows = false,\n                AllowUserToDeleteRows = false,\n                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill,\n                RowHeadersVisible = false,\n                EnableHeadersVisualStyles = false,\n                SelectionMode = DataGridViewSelectionMode.FullRowSelect\n            };\n            dgvScrapePreview.ColumnHeadersDefaultCellStyle.BackColor = Color.FromArgb(45, 45, 48);\n            dgvScrapePreview.ColumnHeadersDefaultCellStyle.ForeColor = Color.White;\n            dgvScrapePreview.DefaultCellStyle.BackColor = darkBg;\n            dgvScrapePreview.DefaultCellStyle.ForeColor = Color.LightGray;\n            dgvScrapePreview.DefaultCellStyle.SelectionBackColor = Color.FromArgb(9, 71, 113);\n            dgvScrapePreview.DefaultCellStyle.SelectionForeColor = Color.White;\n\n            txtScrapeJsonPreview = new TextBox\n            {\n                Dock = DockStyle.Fill,\n                Multiline = true,\n                ReadOnly = true,\n                ScrollBars = ScrollBars.Both,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                Font = new Font(\u0022Consolas\u0022, 10F)\n            };\n\n            tabTable.Controls.Add(dgvScrapePreview);\n            tabJson.Controls.Add(txtScrapeJsonPreview);\n            tabPreview.Controls.Add(tabTable);\n            tabPreview.Controls.Add(tabJson);\n\n            splitScraperRight.Panel2.Controls.Add(tabPreview);\n            splitScraperRight.Panel2.Controls.Add(pnlResultsToolbar);\n\n            splitScraperMain.Panel2.Controls.Add(splitScraperRight);\n            tabScraper.Controls.Add(splitScraperMain);\n\n            RefreshAutomationSequenceDropdowns();\n        }\n==== REPLACE\n        // --- Data Scraper UI \u0026 Point-and-Click Handlers ---\n\n        private int ScaleDpi(int value) =\u003E (int)Math.Ceiling(value * (DeviceDpi / 96f));\n\n        private static Button CreateToolbarButton(string text, int padX, int padY, int margin)\n        {\n            return new Button\n            {\n                Text = text,\n                AutoSize = true,\n                AutoSizeMode = AutoSizeMode.GrowAndShrink,\n                Padding = new Padding(padX, padY, padX, padY),\n                Margin = new Padding(margin),\n                UseVisualStyleBackColor = true\n            };\n        }\n\n        private void EnsureTabSplittersConfigured()\n        {\n            try\n            {\n                if (tabMain.SelectedTab == tabDom \u0026\u0026 !_domSplittersInitialized \u0026\u0026 splitDom.Width \u003E 200)\n                {\n                    _domSplittersInitialized = true;\n                    splitDom.SplitterDistance = (int)(splitDom.Width * 0.45);\n                }\n                else if (tabMain.SelectedTab == tabEditor \u0026\u0026 !_editorSplittersInitialized \u0026\u0026 splitSequences.Width \u003E 300)\n                {\n                    _editorSplittersInitialized = true;\n                    splitSequences.SplitterDistance = Math.Clamp((int)(splitSequences.Width * 0.28), ScaleDpi(220), ScaleDpi(380));\n                    if (splitEditor.Width \u003E 250)\n                    {\n                        splitEditor.SplitterDistance = Math.Clamp((int)(splitEditor.Width * 0.36), ScaleDpi(180), ScaleDpi(420));\n                    }\n                }\n                else if (tabMain.SelectedTab == tabScraper \u0026\u0026 !_scraperSplittersInitialized \u0026\u0026 splitScraperMain != null \u0026\u0026 splitScraperMain.Width \u003E 300)\n                {\n                    _scraperSplittersInitialized = true;\n                    splitScraperMain.SplitterDistance = Math.Clamp((int)(splitScraperMain.Width * 0.32), ScaleDpi(260), ScaleDpi(440));\n                    if (splitScraperRight.Height \u003E 200)\n                    {\n                        splitScraperRight.SplitterDistance = Math.Clamp(\n                            (int)(splitScraperRight.Height * 0.52),\n                            ScaleDpi(160),\n                            Math.Max(ScaleDpi(170), splitScraperRight.Height - ScaleDpi(140)));\n                    }\n                    if (splitFields.Width \u003E 250)\n                    {\n                        splitFields.SplitterDistance = Math.Clamp((int)(splitFields.Width * 0.35), ScaleDpi(180), ScaleDpi(400));\n                    }\n                }\n            }\n            catch\n            {\n                // Ignore transient layout bounds exceptions during window initialization\n            }\n        }\n\n        private void InitializeScraperTabUi()\n        {\n            var darkBg = Color.FromArgb(30, 30, 30);\n            var darkLine = Color.FromArgb(45, 45, 48);\n\n            int padX = ScaleDpi(6);\n            int padY = ScaleDpi(3);\n            int btnMargin = ScaleDpi(3);\n\n            splitScraperMain = new SplitContainer\n            {\n                Dock = DockStyle.Fill,\n                Size = new Size(920, 440)\n            };\n\n            // Left Panel: Scrape Lists \u0026 Scrape-Level Options\n            var pnlScrapesTop = new FlowLayoutPanel\n            {\n                Dock = DockStyle.Top,\n                AutoSize = true,\n                AutoSizeMode = AutoSizeMode.GrowAndShrink,\n                WrapContents = true,\n                Padding = new Padding(ScaleDpi(4))\n            };\n\n            var btnAddScrape = CreateToolbarButton(\u0022Add Scrape\u0022, padX, padY, btnMargin);\n            var btnRemoveScrape = CreateToolbarButton(\u0022Remove\u0022, padX, padY, btnMargin);\n            var btnMoveScrapeUp = CreateToolbarButton(\u0022Move Up\u0022, padX, padY, btnMargin);\n            var btnMoveScrapeDown = CreateToolbarButton(\u0022Move Down\u0022, padX, padY, btnMargin);\n            var btnRenameScrape = CreateToolbarButton(\u0022Rename\u0022, padX, padY, btnMargin);\n\n            btnAddScrape.Click \u002B= BtnAddScrape_Click;\n            btnRemoveScrape.Click \u002B= BtnRemoveScrape_Click;\n            btnMoveScrapeUp.Click \u002B= BtnMoveScrapeUp_Click;\n            btnMoveScrapeDown.Click \u002B= BtnMoveScrapeDown_Click;\n            btnRenameScrape.Click \u002B= BtnRenameScrape_Click;\n\n            pnlScrapesTop.Controls.AddRange(new Control[]\n            {\n                btnAddScrape, btnRemoveScrape, btnMoveScrapeUp, btnMoveScrapeDown, btnRenameScrape\n            });\n\n            chkLstScrapes = new CheckedListBox\n            {\n                Dock = DockStyle.Fill,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                BorderStyle = BorderStyle.FixedSingle,\n                IntegralHeight = false\n            };\n            chkLstScrapes.SelectedIndexChanged \u002B= ChkLstScrapes_SelectedIndexChanged;\n            chkLstScrapes.ItemCheck \u002B= ChkLstScrapes_ItemCheck;\n\n            var grpScrapeConfig = new GroupBox\n            {\n                Dock = DockStyle.Bottom,\n                AutoSize = true,\n                AutoSizeMode = AutoSizeMode.GrowAndShrink,\n                Text = \u0022Container \u0026\u0026 Automation Hooks\u0022,\n                Padding = new Padding(ScaleDpi(8), ScaleDpi(6), ScaleDpi(8), ScaleDpi(8)),\n                ForeColor = Color.LightGray\n            };\n\n            var tlpConfig = new TableLayoutPanel\n            {\n                Dock = DockStyle.Top,\n                AutoSize = true,\n                AutoSizeMode = AutoSizeMode.GrowAndShrink,\n                ColumnCount = 2,\n                RowCount = 6\n            };\n            tlpConfig.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));\n            tlpConfig.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100F));\n            for (int i = 0; i \u003C 6; i\u002B\u002B)\n            {\n                tlpConfig.RowStyles.Add(new RowStyle(SizeType.AutoSize));\n            }\n\n            Padding lblMargin = new Padding(0, ScaleDpi(4), ScaleDpi(6), ScaleDpi(4));\n            Padding inputMargin = new Padding(0, ScaleDpi(3), 0, ScaleDpi(3));\n\n            var lblContainer = new Label { Text = \u0022Container CSS:\u0022, AutoSize = true, Anchor = AnchorStyles.Left, Margin = lblMargin };\n            txtContainerSelector = new TextBox { Dock = DockStyle.Fill, BackColor = darkBg, ForeColor = Color.LightGray, Margin = inputMargin };\n            txtContainerSelector.TextChanged \u002B= ScrapeConfigControl_Changed;\n\n            var pnlContainerBtns = new FlowLayoutPanel\n            {\n                Dock = DockStyle.Fill,\n                AutoSize = true,\n                AutoSizeMode = AutoSizeMode.GrowAndShrink,\n                WrapContents = true,\n                Margin = new Padding(0, ScaleDpi(2), 0, ScaleDpi(4))\n            };\n            var btnGenContainer = CreateToolbarButton(\u0022Generalize\u0022, ScaleDpi(5), ScaleDpi(2), ScaleDpi(2));\n            var btnHlContainer = CreateToolbarButton(\u0022Highlight\u0022, ScaleDpi(5), ScaleDpi(2), ScaleDpi(2));\n            var btnClrContainer = CreateToolbarButton(\u0022Clear\u0022, ScaleDpi(5), ScaleDpi(2), ScaleDpi(2));\n            btnGenContainer.Click \u002B= BtnGeneralizeContainer_Click;\n            btnHlContainer.Click \u002B= BtnHighlightContainer_Click;\n            btnClrContainer.Click \u002B= (s, e) =\u003E txtContainerSelector.Text = string.Empty;\n            pnlContainerBtns.Controls.AddRange(new Control[] { btnGenContainer, btnHlContainer, btnClrContainer });\n\n            var lblPreSeq = new Label { Text = \u0022Pre-Automation:\u0022, AutoSize = true, Anchor = AnchorStyles.Left, Margin = lblMargin };\n            cmbPreScrapeSeq = new ComboBox\n            {\n                Dock = DockStyle.Fill,\n                DropDownStyle = ComboBoxStyle.DropDownList,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                Margin = inputMargin\n            };\n            cmbPreScrapeSeq.SelectedIndexChanged \u002B= ScrapeConfigControl_Changed;\n\n            var lblPostSeq = new Label { Text = \u0022Post-Automation:\u0022, AutoSize = true, Anchor = AnchorStyles.Left, Margin = lblMargin };\n            cmbPostScrapeSeq = new ComboBox\n            {\n                Dock = DockStyle.Fill,\n                DropDownStyle = ComboBoxStyle.DropDownList,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                Margin = inputMargin\n            };\n            cmbPostScrapeSeq.SelectedIndexChanged \u002B= ScrapeConfigControl_Changed;\n\n            chkEnablePagination = new CheckBox { Text = \u0022Paginate (Max):\u0022, AutoSize = true, Anchor = AnchorStyles.Left, Margin = lblMargin };\n            chkEnablePagination.CheckedChanged \u002B= ScrapeConfigControl_Changed;\n\n            numMaxPages = new NumericUpDown\n            {\n                Minimum = 1,\n                Maximum = 500,\n                Value = 3,\n                Width = ScaleDpi(80),\n                Anchor = AnchorStyles.Left,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                Margin = inputMargin\n            };\n            numMaxPages.ValueChanged \u002B= ScrapeConfigControl_Changed;\n\n            var lblNextBtn = new Label { Text = \u0022Next Button CSS:\u0022, AutoSize = true, Anchor = AnchorStyles.Left, Margin = lblMargin };\n            txtNextPageSelector = new TextBox { Dock = DockStyle.Fill, BackColor = darkBg, ForeColor = Color.LightGray, Margin = inputMargin };\n            txtNextPageSelector.TextChanged \u002B= ScrapeConfigControl_Changed;\n\n            tlpConfig.Controls.Add(lblContainer, 0, 0);\n            tlpConfig.Controls.Add(txtContainerSelector, 1, 0);\n            tlpConfig.Controls.Add(pnlContainerBtns, 1, 1);\n            tlpConfig.Controls.Add(lblPreSeq, 0, 2);\n            tlpConfig.Controls.Add(cmbPreScrapeSeq, 1, 2);\n            tlpConfig.Controls.Add(lblPostSeq, 0, 3);\n            tlpConfig.Controls.Add(cmbPostScrapeSeq, 1, 3);\n            tlpConfig.Controls.Add(chkEnablePagination, 0, 4);\n            tlpConfig.Controls.Add(numMaxPages, 1, 4);\n            tlpConfig.Controls.Add(lblNextBtn, 0, 5);\n            tlpConfig.Controls.Add(txtNextPageSelector, 1, 5);\n\n            grpScrapeConfig.Controls.Add(tlpConfig);\n\n            splitScraperMain.Panel1.Controls.Add(chkLstScrapes);\n            splitScraperMain.Panel1.Controls.Add(pnlScrapesTop);\n            splitScraperMain.Panel1.Controls.Add(grpScrapeConfig);\n\n            // Right Panel: Top = Fields \u0026 PropertyGrid, Bottom = Results \u0026 Preview\n            splitScraperRight = new SplitContainer\n            {\n                Dock = DockStyle.Fill,\n                Orientation = Orientation.Horizontal,\n                Size = new Size(600, 440)\n            };\n\n            var pnlFieldsToolbar = new TableLayoutPanel\n            {\n                Dock = DockStyle.Top,\n                AutoSize = true,\n                AutoSizeMode = AutoSizeMode.GrowAndShrink,\n                ColumnCount = 2,\n                RowCount = 1,\n                Padding = new Padding(ScaleDpi(4))\n            };\n            pnlFieldsToolbar.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100F));\n            pnlFieldsToolbar.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));\n            pnlFieldsToolbar.RowStyles.Add(new RowStyle(SizeType.AutoSize));\n\n            var flpFieldActionsLeft = new FlowLayoutPanel\n            {\n                Dock = DockStyle.Fill,\n                AutoSize = true,\n                AutoSizeMode = AutoSizeMode.GrowAndShrink,\n                WrapContents = true,\n                Margin = new Padding(0)\n            };\n\n            var flpFieldActionsRight = new FlowLayoutPanel\n            {\n                Dock = DockStyle.Top,\n                Anchor = AnchorStyles.Top | AnchorStyles.Right,\n                AutoSize = true,\n                AutoSizeMode = AutoSizeMode.GrowAndShrink,\n                WrapContents = false,\n                Margin = new Padding(0)\n            };\n\n            var btnAddField = CreateToolbarButton(\u0022Add Field\u0022, padX, padY, btnMargin);\n            var btnRemoveField = CreateToolbarButton(\u0022Remove\u0022, padX, padY, btnMargin);\n            var btnFieldUp = CreateToolbarButton(\u0022Move Up\u0022, padX, padY, btnMargin);\n            var btnFieldDown = CreateToolbarButton(\u0022Move Down\u0022, padX, padY, btnMargin);\n            var btnGenField = CreateToolbarButton(\u0022Generalize\u0022, padX, padY, btnMargin);\n            var btnHlField = CreateToolbarButton(\u0022Highlight\u0022, padX, padY, btnMargin);\n\n            btnPreviewScrape = CreateToolbarButton(\u0022Preview Scrape\u0022, padX, padY, btnMargin);\n            btnRunAllScrapes = CreateToolbarButton(\u0022Run Active Scrapes\u0022, padX, padY, btnMargin);\n\n            btnAddField.Click \u002B= BtnAddScrapeField_Click;\n            btnRemoveField.Click \u002B= BtnRemoveScrapeField_Click;\n            btnFieldUp.Click \u002B= BtnMoveScrapeFieldUp_Click;\n            btnFieldDown.Click \u002B= BtnMoveScrapeFieldDown_Click;\n            btnGenField.Click \u002B= BtnGeneralizeScrapeField_Click;\n            btnHlField.Click \u002B= BtnHighlightScrapeField_Click;\n            btnPreviewScrape.Click \u002B= BtnPreviewScrape_Click;\n            btnRunAllScrapes.Click \u002B= BtnRunAllScrapes_Click;\n\n            flpFieldActionsLeft.Controls.AddRange(new Control[]\n            {\n                btnAddField, btnRemoveField, btnFieldUp, btnFieldDown, btnGenField, btnHlField\n            });\n            flpFieldActionsRight.Controls.AddRange(new Control[]\n            {\n                btnPreviewScrape, btnRunAllScrapes\n            });\n\n            pnlFieldsToolbar.Controls.Add(flpFieldActionsLeft, 0, 0);\n            pnlFieldsToolbar.Controls.Add(flpFieldActionsRight, 1, 0);\n\n            splitFields = new SplitContainer\n            {\n                Dock = DockStyle.Fill,\n                Size = new Size(600, 220)\n            };\n\n            lstScrapeFields = new ListBox\n            {\n                Dock = DockStyle.Fill,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                BorderStyle = BorderStyle.FixedSingle,\n                IntegralHeight = false\n            };\n            lstScrapeFields.SelectedIndexChanged \u002B= LstScrapeFields_SelectedIndexChanged;\n\n            pgScrapeFieldDetails = new PropertyGrid\n            {\n                Dock = DockStyle.Fill,\n                BackColor = darkBg,\n                CategoryForeColor = Color.LightGray,\n                CategorySplitterColor = darkLine,\n                CommandsBorderColor = darkLine,\n                CommandsForeColor = Color.LightGray,\n                DisabledItemForeColor = Color.FromArgb(127, 127, 127),\n                HelpBackColor = darkBg,\n                HelpBorderColor = darkLine,\n                HelpForeColor = Color.LightGray,\n                LineColor = darkLine,\n                ViewBackColor = darkBg,\n                ViewBorderColor = darkLine,\n                ViewForeColor = Color.LightGray\n            };\n            pgScrapeFieldDetails.PropertyValueChanged \u002B= PgScrapeFieldDetails_PropertyValueChanged;\n\n            splitFields.Panel1.Controls.Add(lstScrapeFields);\n            splitFields.Panel2.Controls.Add(pgScrapeFieldDetails);\n\n            splitScraperRight.Panel1.Controls.Add(splitFields);\n            splitScraperRight.Panel1.Controls.Add(pnlFieldsToolbar);\n\n            // Bottom Panel: Results Preview \u0026 Export\n            var pnlResultsToolbar = new TableLayoutPanel\n            {\n                Dock = DockStyle.Top,\n                AutoSize = true,\n                AutoSizeMode = AutoSizeMode.GrowAndShrink,\n                ColumnCount = 2,\n                RowCount = 1,\n                Padding = new Padding(ScaleDpi(4))\n            };\n            pnlResultsToolbar.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100F));\n            pnlResultsToolbar.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));\n            pnlResultsToolbar.RowStyles.Add(new RowStyle(SizeType.AutoSize));\n\n            lblScrapeStatus = new Label\n            {\n                Text = \u0022Scrape Results Preview (0 records)\u0022,\n                AutoSize = false,\n                AutoEllipsis = true,\n                Dock = DockStyle.Fill,\n                TextAlign = ContentAlignment.MiddleLeft,\n                Margin = new Padding(ScaleDpi(4), 0, ScaleDpi(8), 0)\n            };\n\n            var flpExportBtns = new FlowLayoutPanel\n            {\n                Dock = DockStyle.Top,\n                Anchor = AnchorStyles.Top | AnchorStyles.Right,\n                AutoSize = true,\n                AutoSizeMode = AutoSizeMode.GrowAndShrink,\n                WrapContents = false,\n                Margin = new Padding(0)\n            };\n\n            var btnCopyJson = CreateToolbarButton(\u0022Copy JSON\u0022, padX, padY, btnMargin);\n            var btnExportCsv = CreateToolbarButton(\u0022Export CSV...\u0022, padX, padY, btnMargin);\n            var btnExportJson = CreateToolbarButton(\u0022Export JSON...\u0022, padX, padY, btnMargin);\n\n            btnExportJson.Click \u002B= BtnExportScrapeJson_Click;\n            btnExportCsv.Click \u002B= BtnExportScrapeCsv_Click;\n            btnCopyJson.Click \u002B= BtnCopyScrapeJson_Click;\n\n            flpExportBtns.Controls.AddRange(new Control[] { btnCopyJson, btnExportCsv, btnExportJson });\n\n            pnlResultsToolbar.Controls.Add(lblScrapeStatus, 0, 0);\n            pnlResultsToolbar.Controls.Add(flpExportBtns, 1, 0);\n\n            var tabPreview = new TabControl { Dock = DockStyle.Fill };\n            var tabTable = new TabPage(\u0022Table View\u0022) { BackColor = darkBg };\n            var tabJson = new TabPage(\u0022JSON View\u0022) { BackColor = darkBg };\n\n            dgvScrapePreview = new DataGridView\n            {\n                Dock = DockStyle.Fill,\n                BackgroundColor = darkBg,\n                ForeColor = Color.LightGray,\n                GridColor = darkLine,\n                BorderStyle = BorderStyle.FixedSingle,\n                ReadOnly = true,\n                AllowUserToAddRows = false,\n                AllowUserToDeleteRows = false,\n                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill,\n                RowHeadersVisible = false,\n                EnableHeadersVisualStyles = false,\n                SelectionMode = DataGridViewSelectionMode.FullRowSelect\n            };\n            dgvScrapePreview.ColumnHeadersDefaultCellStyle.BackColor = Color.FromArgb(45, 45, 48);\n            dgvScrapePreview.ColumnHeadersDefaultCellStyle.ForeColor = Color.White;\n            dgvScrapePreview.DefaultCellStyle.BackColor = darkBg;\n            dgvScrapePreview.DefaultCellStyle.ForeColor = Color.LightGray;\n            dgvScrapePreview.DefaultCellStyle.SelectionBackColor = Color.FromArgb(9, 71, 113);\n            dgvScrapePreview.DefaultCellStyle.SelectionForeColor = Color.White;\n\n            txtScrapeJsonPreview = new TextBox\n            {\n                Dock = DockStyle.Fill,\n                Multiline = true,\n                ReadOnly = true,\n                ScrollBars = ScrollBars.Both,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                Font = new Font(\u0022Consolas\u0022, 10F)\n            };\n\n            tabTable.Controls.Add(dgvScrapePreview);\n            tabJson.Controls.Add(txtScrapeJsonPreview);\n            tabPreview.Controls.Add(tabTable);\n            tabPreview.Controls.Add(tabJson);\n\n            splitScraperRight.Panel2.Controls.Add(tabPreview);\n            splitScraperRight.Panel2.Controls.Add(pnlResultsToolbar);\n\n            splitScraperMain.Panel2.Controls.Add(splitScraperRight);\n            tabScraper.Controls.Add(splitScraperMain);\n\n            splitScraperMain.SplitterDistance = 300;\n            splitScraperRight.SplitterDistance = 220;\n            splitFields.SplitterDistance = 210;\n\n            RefreshAutomationSequenceDropdowns();\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
      "ModelExplanation": "### Summary of Changes\n\n- **Automation Editor Tab (\u0060MainForm.Designer.cs\u0060 \u0026 \u0060MainForm.cs\u0060)**:\n\n- Converted \u0060pnlSequencesTop\u0060 into an auto-sizing \u0060FlowLayoutPanel\u0060 and enabled \u0060AutoSize\u0060 (\u0060GrowAndShrink\u0060) with padding on \u0060btnAddSequence\u0060, \u0060btnRemoveSequence\u0060, \u0060btnMoveSeqUp\u0060, \u0060btnMoveSeqDown\u0060, and \u0060btnRenameSeq\u0060 so button text never wraps onto multiple lines or clips vertically at high DPI.\n- Replaced the fixed-width docked button layout in \u0060pnlEditorTop\u0060 with an auto-sizing \u0060TableLayoutPanel\u0060 and \u0060FlowLayoutPanel\u0060 so \u0060btnAddStep\u0060, \u0060btnRemoveStep\u0060, \u0060btnMoveUp\u0060, \u0060btnMoveDown\u0060, and \u0060btnRunAutomation\u0060 size dynamically to their text with proper spacing and alignment.\n- Escaped the ampersand in \u0060btnGenerate.Text\u0060 (\u0060\u0022Generate \u0026\u0026 Copy Script\u0022\u0060) so it renders literally instead of as a mnemonic underscore.\n- **Data Scraper Tab (\u0060MainForm.cs\u0060)**:\n\n- Replaced fixed-pixel button positions/widths in \u0060pnlScrapesTop\u0060, \u0060pnlFieldsToolbar\u0060, and \u0060pnlResultsToolbar\u0060 with DPI-aware \u0060TableLayoutPanel\u0060 and \u0060FlowLayoutPanel\u0060 containers and \u0060AutoSize\u0060 buttons so no buttons wrap text, clip vertically, or overlap status labels or adjacent buttons.\n- Updated \u0060grpScrapeConfig\u0060 (\u0060\u0022Container \u0026\u0026 Automation Hooks\u0022\u0060) and \u0060tlpConfig\u0060 to use \u0060AutoSize\u0060 (\u0060GrowAndShrink\u0060) with \u0060SizeType.AutoSize\u0060 on the label column so labels never wrap and all 6 configuration rows (including pagination and next-page selector controls) remain fully visible without clipping.\n- Fixed \u0060SplitContainer\u0060 initialization and added proportional splitter initialization when tabs are sized/selected so \u0060splitScraperMain\u0060, \u0060splitScraperRight\u0060, \u0060splitFields\u0060, \u0060splitSequences\u0060, and \u0060splitEditor\u0060 maintain balanced panel proportions at any screen resolution and DPI scale.\n\n### How to Test\n\n- Build and run \u0060TestBedApp\u0060.\n- Open the **Automation Editor** tab and verify that \u0060Add List\u0060, \u0060Remove List\u0060, \u0060Move Up\u0060, \u0060Move Down\u0060, \u0060Rename\u0060, \u0060Add Step\u0060, \u0060Remove Step\u0060, and \u0060Run Automation\u0060 display their full text on a single line without clipping or overlapping.\n- Open the **Data Scraper** tab and verify that:\n\n- The left panel, top fields/property grid panel, and bottom results preview panel are proportionally split.\n- All buttons (\u0060Add Scrape\u0060, \u0060Remove\u0060, \u0060Move Up\u0060, \u0060Move Down\u0060, \u0060Rename\u0060, \u0060Add Field\u0060, \u0060Generalize\u0060, \u0060Highlight\u0060, \u0060Preview Scrape\u0060, \u0060Run Active Scrapes\u0060, \u0060Copy JSON\u0060, \u0060Export CSV...\u0060, \u0060Export JSON...\u0060) fit their text on a single line without overlapping.\n- All rows inside \u0060Container \u0026 Automation Hooks\u0060 (including \u0060Paginate (Max):\u0060 and \u0060Next Button CSS:\u0060) are completely visible.",
