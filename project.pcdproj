            catch (Exception ex)            {                Log($\u0022[ERR] Failed to highlight container: {ex.Message}\u0022, Color.Red);            }        }==== REPLACE        private void BtnGeneralizeContainer_Click(object? sender, EventArgs e)        {            if (!string.IsNullOrWhiteSpace(txtContainerSelector.Text))            {                DomNode? rootDom = tvDom.RootDomNode;                if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)                {                    txtContainerSelector.Text = scrape.GeneralizeAndSetContainer(txtContainerSelector.Text, rootDom);                    pgScrapeFieldDetails.Refresh();                }                else                {                    txtContainerSelector.Text = SelectorHelper.GeneralizeContainerSelector(txtContainerSelector.Text, rootDom);                }            }        }        private async void BtnHighlightContainer_Click(object? sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            string selector = txtContainerSelector.Text.Trim();            if (string.IsNullOrWhiteSpace(selector))            {                Log(\u0022[WARN] Container selector is empty.\u0022, Color.Orange);                return;            }            try            {                int count = chkLstScrapes.SelectedItem is ScrapeDefinition scrape                    ? await client.HighlightScrapeContainerAsync(scrape)                    : await client.HighlightElementsAsync(selector, null, true);                Log($\u0022[SCRAPE] Highlighted {count} container element(s) matching \u0027{selector}\u0027.\u0022, Color.SpringGreen);            }            catch (Exception ex)            {                Log($\u0022[ERR] Failed to highlight container: {ex.Message}\u0022, Color.Red);            }        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private void BtnGeneralizeScrapeField_Click(object? sender, EventArgs e)        {            if (lstScrapeFields.SelectedItem is ScrapeField field \u0026\u0026 !string.IsNullOrWhiteSpace(field.Selector))            {                DomNode? rootDom = tvDom.RootDomNode;                field.Selector = SelectorHelper.GeneralizeRepeatingFieldSelector(field.Selector, rootDom);                field.MatchAllElements = true;                pgScrapeFieldDetails.Refresh();                RefreshSelectedFieldItemText();            }        }        private async void BtnHighlightScrapeField_Click(object? sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            if (lstScrapeFields.SelectedItem is not ScrapeField field || string.IsNullOrWhiteSpace(field.Selector))            {                Log(\u0022[WARN] Please select a field with a valid selector first.\u0022, Color.Orange);                return;            }            string? containerSelector = (chkLstScrapes.SelectedItem as ScrapeDefinition)?.ContainerSelector;            try            {                int count = await client.HighlightElementsAsync(                    field.Selector,                    containerSelector,                    field.MatchAllElements || !string.IsNullOrWhiteSpace(containerSelector));                Log($\u0022[SCRAPE] Highlighted {count} element(s) for field \u0027{field.Name}\u0027.\u0022, Color.SpringGreen);            }            catch (Exception ex)            {                Log($\u0022[ERR] Highlight failed: {ex.Message}\u0022, Color.Red);            }        }==== REPLACE        private void BtnGeneralizeScrapeField_Click(object? sender, EventArgs e)        {            if (lstScrapeFields.SelectedItem is ScrapeField field \u0026\u0026 !string.IsNullOrWhiteSpace(field.Selector))            {                field.GeneralizeSelector(tvDom.RootDomNode);                pgScrapeFieldDetails.Refresh();                RefreshSelectedFieldItemText();            }        }        private async void BtnHighlightScrapeField_Click(object? sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            if (lstScrapeFields.SelectedItem is not ScrapeField field || string.IsNullOrWhiteSpace(field.Selector))            {                Log(\u0022[WARN] Please select a field with a valid selector first.\u0022, Color.Orange);                return;            }            var parentScrape = chkLstScrapes.SelectedItem as ScrapeDefinition;            try            {                int count = await client.HighlightScrapeFieldAsync(field, parentScrape);                Log($\u0022[SCRAPE] Highlighted {count} element(s) for field \u0027{field.Name}\u0027.\u0022, Color.SpringGreen);            }            catch (Exception ex)            {                Log($\u0022[ERR] Highlight failed: {ex.Message}\u0022, Color.Red);            }        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private void AddFieldFromSelectedDomNode(ScrapeDefinition scrape, bool matchAllElements)        {            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))                return;            DomNode? rootDom = tvDom.RootDomNode;            var suggestedType = domNode.GetSuggestedExtractionType();            string baseName = domNode.GetSuggestedFieldName(suggestedType);            string uniqueName = scrape.GetUniqueFieldName(baseName);            var field = domNode.CreateScrapeField(                fieldName: uniqueName,                extractionType: suggestedType,                containerSelector: scrape.ContainerSelector,                matchAllElements: matchAllElements,                rootDom: rootDom);            scrape.Fields.Add(field);            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                lstScrapeFields.Items.Add(field);                lstScrapeFields.SelectedItem = field;            }            Log($\u0022[SCRAPE] Added field \u0027{field.Name}\u0027 ({field.ExtractionType}) to \u0027{scrape.Name}\u0027.\u0022, Color.SpringGreen);        }        private void SetContainerFromSelectedDomNode(ScrapeDefinition scrape)        {            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))                return;            DomNode? rootDom = tvDom.RootDomNode;            string generalizedContainer = domNode.GetGeneralizedPath(rootDom);            scrape.SetContainerAndRelativizeFields(generalizedContainer);            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                LoadSelectedScrapeToUi();            }            Log($\u0022[SCRAPE] Set repeating container for \u0027{scrape.Name}\u0027 to: {generalizedContainer}\u0022, Color.SpringGreen);        }        private void SetPaginationNextFromSelectedDomNode(ScrapeDefinition scrape)        {            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))                return;            DomNode? rootDom = tvDom.RootDomNode;            string selector = domNode.GetBestInteractiveSelector(rootDom);            scrape.EnablePagination = true;            scrape.NextPageSelector = selector;            if (scrape.MaxPages \u003C 2) scrape.MaxPages = 3;            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                LoadSelectedScrapeToUi();            }            Log($\u0022[SCRAPE] Set pagination Next button for \u0027{scrape.Name}\u0027 to: {domNode.Path}\u0022, Color.SpringGreen);        }==== REPLACE        private void AddFieldFromSelectedDomNode(ScrapeDefinition scrape, bool matchAllElements)        {            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))                return;            var field = scrape.AddFieldFromDomNode(domNode, matchAllElements, tvDom.RootDomNode);            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                lstScrapeFields.Items.Add(field);                lstScrapeFields.SelectedItem = field;            }            Log($\u0022[SCRAPE] Added field \u0027{field.Name}\u0027 ({field.ExtractionType}) to \u0027{scrape.Name}\u0027.\u0022, Color.SpringGreen);        }        private void SetContainerFromSelectedDomNode(ScrapeDefinition scrape)        {            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))                return;            string generalizedContainer = scrape.SetContainerFromDomNode(domNode, tvDom.RootDomNode);            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                LoadSelectedScrapeToUi();            }            Log($\u0022[SCRAPE] Set repeating container for \u0027{scrape.Name}\u0027 to: {generalizedContainer}\u0022, Color.SpringGreen);        }        private void SetPaginationNextFromSelectedDomNode(ScrapeDefinition scrape)        {            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))                return;            string selector = scrape.SetPaginationNextFromDomNode(domNode, tvDom.RootDomNode);            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                LoadSelectedScrapeToUi();            }            Log($\u0022[SCRAPE] Set pagination Next button for \u0027{scrape.Name}\u0027 to: {selector}\u0022, Color.SpringGreen);        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH            btnRunAllScrapes.Enabled = false;            try            {                var results = await _scraper.RunProjectScrapesAsync(client, project);                if (results.Count \u003E 0)                {                    var combined = new ScrapeResult                    {                        ScrapeName = results.Count == 1 ? results[0].ScrapeName : \u0022Combined Active Scrapes\u0022,                        PagesScraped = results.Sum(r =\u003E r.PagesScraped)                    };                    foreach (var r in results)                    {                        combined.Merge(r);                    }                    DisplayScrapeResult(combined);                }            }==== REPLACE            btnRunAllScrapes.Enabled = false;            try            {                var combined = await _scraper.RunProjectScrapesCombinedAsync(client, project);                DisplayScrapeResult(combined);            }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH                string filter = txtFilterResources.Text.Trim();                var allResources = _lastSiteDumpResult.GetAllResources();                foreach (var res in allResources)                {                    if (!string.IsNullOrEmpty(filter))                    {                        bool matches = res.Name.Contains(filter, StringComparison.OrdinalIgnoreCase) ||                                       res.Url.Contains(filter, StringComparison.OrdinalIgnoreCase) ||                                       res.SourceType.Contains(filter, StringComparison.OrdinalIgnoreCase) ||                                       res.Category.ToString().Contains(filter, StringComparison.OrdinalIgnoreCase) ||                                       (!string.IsNullOrEmpty(res.Content) \u0026\u0026 res.Content.Contains(filter, StringComparison.OrdinalIgnoreCase));                        if (!matches)                            continue;                    }                    lstDumpedResources.Items.Add(res);                }==== REPLACE                string filter = txtFilterResources.Text.Trim();                foreach (var res in _lastSiteDumpResult.FilterResources(filter))                {                    lstDumpedResources.Items.Add(res);                }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
      "ModelExplanation": "### Summary of Changes\n\n- **Migrated DOM Snapshot, Indexing \u0026 Syntax Tokenization to \u0060BrowserAutomationFramework\u0060**:\n\n- Created \u0060Models/DomTreeSnapshot.cs\u0060 containing \u0060DomTreeSnapshot\u0060, \u0060DomTreeItem\u0060, \u0060DomDisplayPart\u0060, and \u0060DomTokenColor\u0060. Any consumer or UI framework can now build an O(1) path-indexed, pre-tokenized DOM snapshot via \u0060await client.GetDomSnapshotAsync()\u0060 or \u0060domNode.CreateSnapshot()\u0060.\n- Updated \u0060TestBedApp/Controls/DomTreeView.cs\u0060 to be a pure WinForms virtualized renderer over \u0060BrowserAutomationFramework.Models.DomTreeSnapshot\u0060.\n- **Migrated Authoring, Filtering \u0026 Aggregation Logic from \u0060TestBedApp\u0060 to \u0060BrowserAutomationFramework\u0060**:\n\n- **\u0060ScrapeDefinition\u0060 \u0026 \u0060ScrapeField\u0060**: Added \u0060AddFieldFromDomNode\u0060, \u0060SetContainerFromDomNode\u0060, \u0060GeneralizeAndSetContainer\u0060, \u0060SetPaginationNextFromDomNode\u0060, and \u0060ScrapeField.GeneralizeSelector\u0060.\n- **\u0060AutomationSequence\u0060 \u0026 \u0060AutomationProject\u0060**: Added \u0060AutomationSequence.AddStepFromDomNode\u0060 and project-level helpers (\u0060GetActiveSequences\u0060, \u0060GetActiveScrapes\u0060, \u0060GetSequenceNames\u0060, \u0060MoveSequenceUp\u0060/\u0060Down\u0060, \u0060MoveScrapeUp\u0060/\u0060Down\u0060).\n- **\u0060ScrapeResult\u0060 \u0026 \u0060DataScraper\u0060**: Added \u0060ScrapeResult.Combine\u0060 and \u0060DataScraper.RunProjectScrapesCombinedAsync\u0060 (plus \u0060client.ExecuteProjectScrapesCombinedAsync\u0060).\n- **\u0060BrowserTabInfo\u0060, \u0060SiteResourceItem\u0060 \u0026 \u0060SiteDumpResult\u0060**: Added \u0060BrowserTabInfo.MatchesFilter\u0060, \u0060SiteResourceItem.MatchesFilter\u0060, and \u0060SiteDumpResult.FilterResources\u0060.\n- **\u0060AutomationServer\u0060 \u0026 \u0060ReactExtensions\u0060**: Added \u0060AutomationServer.Port\u0060, \u0060SyncDefaultChromeExtension\u0060, \u0060GetExtensionTabs(filter)\u0060, \u0060GetClientForTab\u0060, \u0060client.HighlightScrapeFieldAsync\u0060, and \u0060client.HighlightScrapeContainerAsync\u0060.\n- **\u0060BrowserAutomationFramework.csproj\u0060**: Enabled \u0060\u003CGenerateDocumentationFile\u003Etrue\u003C/GenerateDocumentationFile\u003E\u0060 and added XML documentation across the framework models and services.\n- **\u0060TestBedApp/MainForm.cs\u0060**: Replaced inline business logic with calls to the \u0060BrowserAutomationFramework\u0060 API.\n\n### How to Test\n\n- Build the solution (\u0060dotnet build\u0060) and verify both \u0060BrowserAutomationFramework\u0060 (including its generated XML documentation) and \u0060TestBedApp\u0060 compile cleanly.\n- Run \u0060TestBedApp\u0060, start the server, connect via the Chrome Extension or Tampermonkey, and verify DOM Explorer rendering, right-click DOM-to-Scraper/Automation actions, container/field generalization and highlighting, and Reverse Engineering resource filtering.",
