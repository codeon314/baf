      "ModelResponse": "Anti-Agent v1.0\n\n### Summary of Changes\n\n- Fixed \u0060BrowserAutomationFramework\\Models\\DomTreeSnapshot.cs\u0060 using a \u0060SEARCH/REPLACE\u0060 block to replace the flattened single-line content (\u0060csusing System;...\u0060) with properly formatted multi-line C# code.\n- This resolves all 11 compiler errors in \u0060BrowserAutomationFramework\u0060 and \u0060TestBedApp\u0060 caused by \u0060DomTreeSnapshot\u0060 being commented out on line 1.\n\n### How to Test\n\n- Rebuild the solution in Visual Studio or via \u0060dotnet build\u0060 and verify that all 11 build errors are resolved.\n\n--CODESTART--\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\DomTreeSnapshot.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\ncsusing System;using System.Collections.Generic;using System.Text;namespace BrowserAutomationFramework.Models{    /// \u003Csummary\u003E    /// Classifies syntax tokens for rendering a \u003Csee cref=\u0022DomNode\u0022/\u003E in a developer tools tree view.    /// \u003C/summary\u003E    public enum DomTokenColor : byte    {        Punctuation,        TagName,        AttributeName,        AttributeValue,        TextContent    }    /// \u003Csummary\u003E    /// Represents a single syntax-highlighted text segment of a serialized \u003Csee cref=\u0022DomNode\u0022/\u003E line.    /// \u003C/summary\u003E    public readonly struct DomDisplayPart    {        public readonly string Text;        public readonly DomTokenColor ColorType;        public DomDisplayPart(string text, DomTokenColor colorType)        {            Text = text;            ColorType = colorType;        }    }    /// \u003Csummary\u003E    /// Represents an indexed, pre-tokenized node entry inside a \u003Csee cref=\u0022DomTreeSnapshot\u0022/\u003E.    /// \u003C/summary\u003E    public sealed class DomTreeItem    {        public DomNode Node { get; }        public string UniqueKey { get; }        public string? ParentKey { get; }        public int Depth { get; }        public List\u003CDomTreeItem\u003E Children { get; } = new();        public bool HasChildren =\u003E Children.Count \u003E 0;        public DomDisplayPart[] OpenParts { get; }        public DomDisplayPart[] CollapsedSuffixParts { get; }        public int EstimatedCharLength { get; }        public DomTreeItem(            DomNode node,            string uniqueKey,            string? parentKey,            int depth,            DomDisplayPart[] openParts,            DomDisplayPart[] collapsedSuffixParts,            int estimatedCharLength)        {            Node = node;            UniqueKey = uniqueKey;            ParentKey = parentKey;            Depth = depth;            OpenParts = openParts;            CollapsedSuffixParts = collapsedSuffixParts;            EstimatedCharLength = estimatedCharLength;        }    }    /// \u003Csummary\u003E    /// Thread-safe, pre-indexed DOM tree snapshot built from a \u003Csee cref=\u0022DomNode\u0022/\u003E hierarchy.    /// Provides O(1) lookup by CSS path, ancestor expansion helpers, and pre-tokenized syntax highlighting parts.    /// \u003C/summary\u003E    public sealed class DomTreeSnapshot    {        private const int MaxAttrValueDisplayLength = 180;        private const int MaxTextDisplayLength = 220;        private const int MaxAttributesDisplayed = 24;        public DomNode RootNode { get; }        public DomTreeItem RootItem { get; }        public Dictionary\u003Cstring, DomTreeItem\u003E ItemsByKey { get; }        private DomTreeSnapshot(DomNode rootNode, DomTreeItem rootItem, Dictionary\u003Cstring, DomTreeItem\u003E itemsByKey)        {            RootNode = rootNode;            RootItem = rootItem;            ItemsByKey = itemsByKey;        }        /// \u003Csummary\u003E        /// Indexes and tokenizes a \u003Csee cref=\u0022DomNode\u0022/\u003E hierarchy into a \u003Csee cref=\u0022DomTreeSnapshot\u0022/\u003E.        /// Safe to call on a background worker thread.        /// \u003C/summary\u003E        public static DomTreeSnapshot Build(DomNode rootNode)        {            if (rootNode == null) throw new ArgumentNullException(nameof(rootNode));            var itemsByKey = new Dictionary\u003Cstring, DomTreeItem\u003E(4096, StringComparer.Ordinal);            var rootItem = BuildItemRecursive(rootNode, null, 0, 0, itemsByKey);            return new DomTreeSnapshot(rootNode, rootItem, itemsByKey);        }        /// \u003Csummary\u003E        /// Attempts to find a \u003Csee cref=\u0022DomTreeItem\u0022/\u003E by its unique CSS path key in O(1) time.        /// \u003C/summary\u003E        public DomTreeItem? FindItemByPath(string? path)        {            if (string.IsNullOrEmpty(path)) return null;            return ItemsByKey.TryGetValue(path, out var item) ? item : null;        }        /// \u003Csummary\u003E        /// Attempts to find a \u003Csee cref=\u0022DomNode\u0022/\u003E by its CSS path in O(1) time using the snapshot index.        /// \u003C/summary\u003E        public DomNode? FindNodeByPath(string? path)        {            return FindItemByPath(path)?.Node;        }        /// \u003Csummary\u003E        /// Expands all ancestor keys of \u003Cparamref name=\u0022targetItem\u0022/\u003E into \u003Cparamref name=\u0022expandedKeys\u0022/\u003E.        /// Returns \u003Cc\u003Etrue\u003C/c\u003E if any new ancestor key was added.        /// \u003C/summary\u003E        public bool ExpandAncestors(DomTreeItem targetItem, HashSet\u003Cstring\u003E expandedKeys)        {            if (targetItem == null) throw new ArgumentNullException(nameof(targetItem));            if (expandedKeys == null) throw new ArgumentNullException(nameof(expandedKeys));            bool addedAny = false;            string? parentKey = targetItem.ParentKey;            while (!string.IsNullOrEmpty(parentKey))            {                if (expandedKeys.Add(parentKey))                    addedAny = true;                if (ItemsByKey.TryGetValue(parentKey, out var parentItem))                    parentKey = parentItem.ParentKey;                else                    break;            }            return addedAny;        }        /// \u003Csummary\u003E        /// Builds the flat list of currently visible \u003Csee cref=\u0022DomTreeItem\u0022/\u003E rows based on the set of expanded node keys.        /// \u003C/summary\u003E        public List\u003CDomTreeItem\u003E BuildVisibleRows(HashSet\u003Cstring\u003E expandedKeys)        {            return BuildVisibleRows(RootItem, expandedKeys);        }        /// \u003Csummary\u003E        /// Builds the flat list of currently visible \u003Csee cref=\u0022DomTreeItem\u0022/\u003E rows starting from \u003Cparamref name=\u0022rootItem\u0022/\u003E.        /// \u003C/summary\u003E        public static List\u003CDomTreeItem\u003E BuildVisibleRows(DomTreeItem rootItem, HashSet\u003Cstring\u003E expandedKeys)        {            var list = new List\u003CDomTreeItem\u003E(Math.Max(64, (expandedKeys?.Count ?? 1) * 8));            if (rootItem != null \u0026\u0026 expandedKeys != null)            {                AppendVisibleRecursive(rootItem, expandedKeys, list);            }            return list;        }        private static void AppendVisibleRecursive(DomTreeItem item, HashSet\u003Cstring\u003E expandedKeys, List\u003CDomTreeItem\u003E output)        {            output.Add(item);            if (item.HasChildren \u0026\u0026 expandedKeys.Contains(item.UniqueKey))            {                var children = item.Children;                for (int i = 0; i \u003C children.Count; i\u002B\u002B)                {                    AppendVisibleRecursive(children[i], expandedKeys, output);                }            }        }        private static DomTreeItem BuildItemRecursive(            DomNode node,            string? parentKey,            int depth,            int siblingIndex,            Dictionary\u003Cstring, DomTreeItem\u003E itemsByKey)        {            string uniqueKey = !string.IsNullOrEmpty(node.Path)                ? node.Path!                : $\u0022{parentKey ?? \u0022root\u0022}#text_{siblingIndex}\u0022;            BuildDisplayParts(node, out var openParts, out var suffixParts, out int charLen);            var item = new DomTreeItem(node, uniqueKey, parentKey, depth, openParts, suffixParts, charLen);            itemsByKey[uniqueKey] = item;            if (node.Children != null \u0026\u0026 node.Children.Count \u003E 0)            {                for (int i = 0; i \u003C node.Children.Count; i\u002B\u002B)                {                    var childItem = BuildItemRecursive(node.Children[i], uniqueKey, depth \u002B 1, i, itemsByKey);                    item.Children.Add(childItem);                }            }            return item;        }        private static void BuildDisplayParts(            DomNode domNode,            out DomDisplayPart[] openParts,            out DomDisplayPart[] collapsedSuffixParts,            out int estimatedCharLen)        {            estimatedCharLen = 0;            if (domNode.Type == \u0022element\u0022)            {                string tag = domNode.TagName ?? \u0022element\u0022;                int attrCount = domNode.Attributes?.Count ?? 0;                var parts = new List\u003CDomDisplayPart\u003E(3 \u002B (Math.Min(attrCount, MaxAttributesDisplayed) * 3));                parts.Add(new DomDisplayPart(\u0022\u003C\u0022, DomTokenColor.Punctuation));                parts.Add(new DomDisplayPart(tag, DomTokenColor.TagName));                estimatedCharLen \u002B= 1 \u002B tag.Length;                if (domNode.Attributes != null \u0026\u0026 attrCount \u003E 0)                {                    int processed = 0;                    foreach (var attr in domNode.Attributes)                    {                        if (processed \u003E= MaxAttributesDisplayed)                        {                            parts.Add(new DomDis