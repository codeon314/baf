per;        private ScrapeResult? _lastScrapeResult;        private SiteDumpResult? _lastSiteDumpResult;        private bool _isUpdatingScrapeUi;        private System.Windows.Forms.Timer _clientRefreshTimer;        // Data Scraper Tab Controls        private SplitContainer splitScraperMain = null!;        private SplitContainer splitScraperRight = null!;        private SplitContainer splitFields = null!;        private CheckedListBox chkLstScrapes = null!;        private TextBox txtContainerSelector = null!;        private ComboBox cmbPreScrapeSeq = null!;        private ComboBox cmbPostScrapeSeq = null!;        private CheckBox chkEnablePagination = null!;        private NumericUpDown numMaxPages = null!;        private NumericUpDown numStartPage = null!;        private NumericUpDown numPageDelayMs = null!;        private TextBox txtNextPageSelector = null!;        private TextBox txtPaginationUrlPattern = null!;        private ListBox lstScrapeFields = null!;        private PropertyGrid pgScrapeFieldDetails = null!;        private Button btnPreviewScrape = null!;        private Button btnRunAllScrapes = null!;        private Label lblScrapeStatus = null!;        private DataGridView dgvScrapePreview = null!;        private TextBox txtScrapeJsonPreview = null!;        // Reverse Engineering Tab Controls        private SplitContainer splitRevEngMain = null!;        private SplitContainer splitRevEngLeft = null!;        private Button btnDumpHtml = null!;        private Button btnDumpCss = null!;        private Button btnDumpJs = null!;        private Button btnDumpAll = null!;        private CheckBox chkDumpInline = null!;        private CheckBox chkDumpExternal = null!;        private CheckBox chkDumpDynamicJs = null!;        private TextBox txtFilterResources = null!;        private ListBox lstDumpedResources = null!;        private TextBox txtDumpedResourceDetails = null!;        private Label lblDumpStatus = null!;        private TabControl tabDumpViewers = null!;        private TabPage tabSelectedResourceView = null!;        private TabPage tabCombinedHtmlView = null!;        private TabPage tabCombinedCssView = null!;        private TabPage tabCombinedJsView = null!;        private TextBox txtSelectedResourceSource = null!;        private TextBox txtCombinedHtmlSource = null!;        private TextBox txtCombinedCssSource = null!;        private TextBox txtCombinedJsSource = null!;        private bool _domSplittersInitialized;        private bool _editorSplittersInitialized;        private bool _scraperSplittersInitialized;        private bool _revEngSplittersInitialized;        public MainForm()        {            InitializeComponent();            InitializeScraperTabUi();            InitializeReverseEngineeringTabUi();            ApplyFixedSingleBorders(this);\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH            _scraper.OnScrapeFailed \u002B= (s, e) =\u003E Log($\u0022[SCRAPE-ERR] \u0027{e.Definition.Name}\u0027 failed: {e.Error?.Message}\u0022, Color.Red);            _clientRefreshTimer = new System.Windows.Forms.Timer { Interval = 2000 };==== REPLACE            _scraper.OnScrapeFailed \u002B= (s, e) =\u003E Log($\u0022[SCRAPE-ERR] \u0027{e.Definition.Name}\u0027 failed: {e.Error?.Message}\u0022, Color.Red);            _siteDumper = new SiteDumper();            _siteDumper.OnDumpStarted \u002B= (s, e) =\u003E Log($\u0022[REV-ENG] --- Starting Site Dump ({e.DumpType}) ---\u0022, Color.DeepSkyBlue);            _siteDumper.OnDumpCompleted \u002B= (s, e) =\u003E            {                if (e.Result != null)                {                    Log($\u0022[REV-ENG] Dump ({e.DumpType}) completed: {e.Result.HtmlResources.Count} HTML, {e.Result.CssResources.Count} CSS, {e.Result.JavaScriptResources.Count} JS resource(s) ({e.Result.GetFormattedTotalSize()}).\u0022, Color.Lime);                    Invoke(new Action(() =\u003E DisplaySiteDumpResult(e.Result)));                }            };            _siteDumper.OnDumpFailed \u002B= (s, e) =\u003E Log($\u0022[REV-ENG-ERR] Dump ({e.DumpType}) failed: {e.Error?.Message}\u0022, Color.Red);            _clientRefreshTimer = new System.Windows.Forms.Timer { Interval = 2000 };\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH                    if (splitFields.Width \u003E 250)                    {                        splitFields.SplitterDistance = Math.Clamp((int)(splitFields.Width * 0.35), ScaleDpi(180), ScaleDpi(400));                    }                }            }            catch==== REPLACE                    if (splitFields.Width \u003E 250)                    {                        splitFields.SplitterDistance = Math.Clamp((int)(splitFields.Width * 0.35), ScaleDpi(180), ScaleDpi(400));                    }                }                else if (tabMain.SelectedTab == tabReverseEngineering \u0026\u0026 !_revEngSplittersInitialized \u0026\u0026 splitRevEngMain != null \u0026\u0026 splitRevEngMain.Width \u003E 300)                {                    _revEngSplittersInitialized = true;                    splitRevEngMain.SplitterDistance = Math.Clamp((int)(splitRevEngMain.Width * 0.34), ScaleDpi(260), ScaleDpi(440));                    if (splitRevEngLeft.Height \u003E 200)                    {                        splitRevEngLeft.SplitterDistance = Math.Clamp(                            (int)(splitRevEngLeft.Height * 0.65),                            ScaleDpi(150),                            Math.Max(ScaleDpi(160), splitRevEngLeft.Height - ScaleDpi(110)));                    }                }            }            catch\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH                    Log($\u0022[ERR] Failed to export CSV: {ex.Message}\u0022, Color.Red);                }            }        }    }}==== REPLACE                    Log($\u0022[ERR] Failed to export CSV: {ex.Message}\u0022, Color.Red);                }            }        }        // --- Reverse Engineering Tab UI \u0026 API Wrappers ---        private void InitializeReverseEngineeringTabUi()        {            var darkBg = Color.FromArgb(30, 30, 30);            int padX = ScaleDpi(8);            int padY = ScaleDpi(4);            int btnMargin = ScaleDpi(4);            // Top Action Bar containing the 4 Dump Buttons \u002B Options \u002B Export Buttons            var pnlTopBar = new TableLayoutPanel            {                Dock = DockStyle.Top,                AutoSize = true,                AutoSizeMode = AutoSizeMode.GrowAndShrink,                ColumnCount = 2,                RowCount = 2,                Padding = new Padding(ScaleDpi(4))            };            pnlTopBar.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100F));            pnlTopBar.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));            pnlTopBar.RowStyles.Add(new RowStyle(SizeType.AutoSize));            pnlTopBar.RowStyles.Add(new RowStyle(SizeType.AutoSize));            var flpDumpButtons = new FlowLayoutPanel            {                Dock = DockStyle.Fill,                AutoSize = true,                AutoSizeMode = AutoSizeMode.GrowAndShrink,                WrapContents = true,                Margin = new Padding(0)            };            btnDumpHtml = CreateToolbarButton(\u0022Dump HTML\u0022, padX, padY, btnMargin);            btnDumpCss = CreateToolbarButton(\u0022Dump CSS\u0022, padX, padY, btnMargin);            btnDumpJs = CreateToolbarButton(\u0022Dump JavaScript\u0022, padX, padY, btnMargin);            btnDumpAll = CreateToolbarButton(\u0022Dump Everything\u0022, padX, padY, btnMargin);            btnDumpHtml.Click \u002B= async (s, e) =\u003E await ExecuteSiteDumpFromUiAsync(SiteDumpType.Html);            btnDumpCss.Click \u002B= async (s, e) =\u003E await ExecuteSiteDumpFromUiAsync(SiteDumpType.Css);            btnDumpJs.Click \u002B= async (s, e) =\u003E await ExecuteSiteDumpFromUiAsync(SiteDumpType.JavaScript);            btnDumpAll.Click \u002B= async (s, e) =\u003E await ExecuteSiteDumpFromUiAsync(SiteDumpType.All);            flpDumpButtons.Controls.AddRange(new Control[]            {                btnDumpHtml, btnDumpCss, btnDumpJs, btnDumpAll            });            var flpExportActions = new FlowLayoutPanel            {                Dock = DockStyle.Top,                Anchor = AnchorStyles.Top | AnchorStyles.Right,                AutoSize = true,                AutoSizeMode = AutoSizeMode.GrowAndShrink,                WrapContents = false,                Margin = new Padding(0)            };            var btnCopyCurrentView = CreateToolbarButton(\u0022Copy Active View\u0022, ScaleDpi(6), ScaleDpi(3), btnMargin);            var btnSaveSelectedFile = CreateToolbarButton(\u0022Save Active File...\u0022, ScaleDpi(6), ScaleDpi(3), btnMargin);            var btnSaveDumpFolder = CreateToolbarButton(\u0022Save Dump to Folder...\u0022, ScaleDpi(6), ScaleDpi(3), btnMargin);            btnCopyCurrentView.Click \u002B= BtnCopyCurrentDumpView_Click;            btnSaveSelectedFile.Click \u002B= BtnSaveActiveDumpFile_Click;            btnSaveDumpFolder.Click \u002B= BtnSaveDumpToFolder_Click;            flpExportActions.Controls.AddRange(new Control[]            {                btnCopyCurrentView, btnSaveSelectedFile, btnSaveDumpFolder            });            var flpOptionsRow = new FlowLayoutPanel            {                Dock = DockStyle.Fill,                AutoSize = true,                AutoSizeMode = AutoSizeMode.GrowAndShrink,                WrapContents = true,                Margin = new Padding(ScaleDpi(2), ScaleDpi(2), 0, 0)            };            chkDumpExternal = new CheckBox            {                Text = \u0022Include External Assets\u0022,                Checked = true,                AutoSize = true,                Margin = new Padding(0, ScaleDpi(2), ScaleDpi(12), ScaleDpi(2))            };            chkDumpInline = new CheckBox            {                Text = \u0022Include Inline \u003Cstyle\u003E / \u003Cscript\u003E\u0022,                Checked = true,                AutoSize = true,                Margin = new Padding(0, ScaleDpi(2), ScaleDpi(12), ScaleDpi(2))            };            chkDumpDynamicJs = new CheckBox            {                Text = \u0022Include Dynamic JS Resources\u0022,                Checked = true,                AutoSize = true,                Margin = new Padding(0, ScaleDpi(2), ScaleDpi(12), ScaleDpi(2))            };            flpOptionsRow.Controls.AddRange(new Control[]            {                chkDumpExternal, chkDumpInline, chkDumpDynamicJs            });            lblDumpStatus = new Label            {                Text = \u0022Ready \u2014 Connect a browser client and click one of the 4 dump buttons.\u0022,                AutoSize = false,                AutoEllipsis = true,                Dock = DockStyle.Fill,                TextAlign = ContentAlignment.MiddleRight,                ForeColor = Color.LightGray,                Margin = new Padding(ScaleDpi(4), 0, ScaleDpi(4), 0)            };            pnlTopBar.Controls.Add(flpDumpButtons, 0, 0);            pnlTopBar.Controls.Add(flpExportActions, 1, 0);            pnlTopBar.Controls.Add(flpOptionsRow, 0, 1);            pnlTopBar.Controls.Add(lblDumpStatus, 1, 1);            // Main Split Container: Left = Resource Explorer \u0026 Metadata, Right = Source Viewers            splitRevEngMain = new SplitContainer            {                Dock = DockStyle.Fill,                Size = new Size(920, 380)            };            splitRevEngLeft = new SplitContainer            {                Dock = DockStyle.Fill,                Orientation = Orientation.Horizontal,                Size = new Size(300, 380)            };            var pnlFilterTop = new TableLayoutPanel            {                Dock = DockStyle.Top,                AutoSize = true,                AutoSizeMode = AutoSizeMode.GrowAndShrink,                ColumnCount = 2,                RowCount = 1,                Padding = new Padding(0, 0, 0, ScaleDpi(4))            };            pnlFilterTop.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));            pnlFilterTop.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100F));            pnlFilterTop.RowStyles.Add(new RowStyle(SizeType.AutoSize));            var lblFilter = new Label            {                Text = \u0022Filter:\u0022,                AutoSize = true,                Anchor = AnchorStyles.Left,                Margin = new Padding(0, 0, ScaleDpi(6), 0)            };            txtFilterResources = new TextBox            {                Dock = DockStyle.Fill,                BackColor = darkBg,                ForeColor = Color.LightGray,                PlaceholderText = \u0022Filter by name, type, URL, or code...\u0022,                Margin = new Padding(0)            };            txtFilterResources.TextChanged \u002B= (s, e) =\u003E RefreshDumpedResourcesList();            pnlFilterTop.Controls.Add(lblFilter, 0, 0);            pnlFilterTop.Controls.Add(txtFilterResources, 1, 0);            lstDumpedResources = new ListBox            {                Dock = DockStyle.Fill,                BackColor = darkBg,                ForeColor = Color.LightGray,                BorderStyle = BorderStyle.FixedSingle,                IntegralHeight = false            };            lstDumpedResources.SelectedIndexChanged \u002B= LstDumpedResources_SelectedIndexChanged;            txtDumpedResourceDetails = new TextBox            {                Dock = DockStyle.Fill,                Multiline = true,                ReadOnly = true,                ScrollBars = ScrollBars.Vertical,                BackColor = darkBg,                ForeColor = Color.LightGray,                Font = new Font(\u0022Consolas\u0022, 9.5F)            };            splitRevEngLeft.Panel1.Controls.Add(lstDumpedResources);            splitRevEngLeft.Panel1.Controls.Add(pnlFilterTop);            splitRevEngLeft.Panel2.Controls.Add(txtDumpedResourceDetails);            tabDumpViewers = new TabControl { Dock = DockStyle.Fill };            tabSelectedResourceView = new TabPage(\u0022Selected Resource\u0022) { BackColor = darkBg };            tabCombinedHtmlView = new TabPage(\u0022Combined HTML\u0022) { BackColor = darkBg };            tabCombinedCssView = new TabPage(\u0022Combined CSS\u0022) { BackColor = darkBg };            tabCombinedJsView = new TabPage(\u0022Combined JavaScript\u0022) { BackColor = darkBg };            txtSelectedResourceSource = CreateCodeViewerTextBox(darkBg);            txtCombinedHtmlSource = CreateCodeViewerTextBox(darkBg);            txtCombinedCssSource = CreateCodeViewerTextBox(darkBg);            txtCombinedJsSource = CreateCodeViewerTextBox(darkBg);            tabSelectedResourceView.Controls.Add(txtSelectedResourceSource);            tabCombinedHtmlView.Controls.Add(txtCombinedHtmlSource);            tabCombinedCssView.Controls.Add(txtCombinedCssSource);            tabCombinedJsView.Controls.Add(txtCombinedJsSource);            tabDumpViewers.Controls.Add(tabSelectedResourceView);            tabDumpViewers.Controls.Add(tabCombinedHtmlView);            tabDumpViewers.Controls.Add(tabCombinedCssView);            tabDumpViewers.Controls.Add(tabCombinedJsView);            splitRevEngMain.Panel1.Controls.Add(splitRevEngLeft);            splitRevEngMain.Panel2.Controls.Add(tabDumpViewers);            tabReverseEngineering.Controls.Add(splitRevEngMain);            tabReverseEngineering.Controls.Add(pnlTopBar);            splitRevEngMain.SplitterDistance = 300;            splitRevEngLeft.SplitterDistance = 240;        }        private static TextBox CreateCodeViewerTextBox(Color darkBg)        {            return new TextBox            {                Dock = DockStyle.Fill,                Multiline = true,                ReadOnly = true,                WordWrap = false,                ScrollBars = ScrollBars.Both,                BackColor = darkBg,                ForeColor = Color.LightGray,                Font = new Font(\u0022Consolas\u0022, 10F),                MaxLength = 0            };        }        private SiteDumpOptions BuildSiteDumpOptionsFromUi()        {            return new SiteDumpOptions            {                IncludeExternalCss = chkDumpExternal.Checked,                IncludeExternalScripts = chkDumpExternal.Checked,                IncludeInlineCss = chkDumpInline.Checked,                IncludeConstructedCss = chkDumpInline.Checked,                IncludeInlineScripts = chkDumpInline.Checked,                IncludePerformanceResourceScripts = chkDumpDynamicJs.Checked            };        }        private void SetDumpButtonsEnabled(bool enabled)        {            btnDumpHtml.Enabled = enabled;            btnDumpCss.Enabled = enabled;            btnDumpJs.Enabled = enabled;            btnDumpAll.Enabled = enabled;        }        private async Task ExecuteSiteDumpFromUiAsync(SiteDumpType dumpType)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            var options = BuildSiteDumpOptionsFromUi();            SetDumpButtonsEnabled(false);            lblDumpStatus.Text = $\u0022Dumping {dumpType} from {client.InstanceId}...\u0022;            try            {                SiteDumpResult result = dumpType switch                {                    SiteDumpType.Html =\u003E await client.DumpHtmlAsync(options, _siteDumper),                    SiteDumpType.Css =\u003E await client.DumpCssAsync(options, _siteDumper),                    SiteDumpType.JavaScript =\u003E await client.DumpJavaScriptAsync(options, _siteDumper),                    _ =\u003E await client.DumpAllAsync(options, _siteDumper)                };                DisplaySiteDumpResult(result);            }            catch (Exception ex)            {                lblDumpStatus.Text = $\u0022Dump failed: {ex.Message}\u0022;                Log($\u0022[ERR] Site dump ({dumpType}) failed: {ex.Message}\u0022, Color.Red);            }            finally            {                SetDumpButtonsEnabled(true);            }        }        private void DisplaySiteDumpResult(SiteDumpResult result)        {            _lastSiteDumpResult = result;            lblDumpStatus.Text = $\u0022Dumped {result.HtmlResources.Count} HTML, {result.CssResources.Count} CSS, {result.JavaScriptResources.Count} JS ({result.GetFormattedTotalSize()})\u0022;            txtCombinedHtmlSource.Text = result.GetCombinedHtml();            txtCombinedCssSource.Text = result.GetCombinedCss();            txtCombinedJsSource.Text = result.GetCombinedJavaScript();            RefreshDumpedResourcesList();            if (result.DumpType == SiteDumpType.Html)            {                tabDumpViewers.SelectedTab = tabCombinedHtmlView;            }            else if (result.DumpType == SiteDumpType.Css)            {                tabDumpViewers.SelectedTab = tabCombinedCssView;            }            else if (result.DumpType == SiteDumpType.JavaScript)            {                tabDumpViewers.SelectedTab = tabCombinedJsView;            }            else if (lstDumpedResources.Items.Count \u003E 0)            {                tabDumpViewers.SelectedTab = tabSelectedResourceView;            }        }        private void RefreshDumpedResourcesList()        {            lstDumpedResources.BeginUpdate();            try            {                lstDumpedResources.Items.Clear();                if (_lastSiteDumpResult == null)                {                    txtDumpedResourceDetails.Text = string.Empty;                    txtSelectedResourceSource.Text = string.Empty;                    return;                }                string filter = txtFilterResources.Text.Trim();                var allResources = _lastSiteDumpResult.GetAllResources();                foreach (var res in allResources)                {                    if (!string.IsNullOrEmpty(filter))                    {                        bool matches = res.Name.Contains(filter, StringComparison.OrdinalIgnoreCase) ||                                       res.Url.Contains(filter, StringComparison.OrdinalIgnoreCase) ||                                       res.SourceType.Contains(filter, StringComparison.OrdinalIgnoreCase) ||                                       res.Category.ToString().Contains(filter, StringComparison.OrdinalIgnoreCase) ||                                       (!string.IsNullOrEmpty(res.Content) \u0026\u0026 res.Content.Contains(filter, StringComparison.OrdinalIgnoreCase));                        if (!matches)                            continue;                    }                    lstDumpedResources.Items.Add(res);                }                if (lstDumpedResources.Items.Count \u003E 0)                {                    lstDumpedResources.SelectedIndex = 0;                }                else                {                    txtDumpedResourceDetails.Text = string.Empty;                    txtSelectedResourceSource.Text = string.Empty;                }            }            finally            {                lstDumpedResources.EndUpdate();            }        }        private void LstDumpedResources_SelectedIndexChanged(object? sender, EventArgs e)        {            if (lstDumpedResources.SelectedItem is SiteResourceItem resource)            {                txtDumpedResourceDetails.Text = resource.GetFormattedDetails();                txtSelectedResourceSource.Text = resource.Content;            }        }        private string GetActiveDumpViewerText(out string suggestedFileName)        {            suggestedFileName = \u0022dump.txt\u0022;            if (_lastSiteDumpResult == null)                return string.Empty;            if (tabDumpViewers.SelectedTab == tabSelectedResourceView \u0026\u0026 lstDumpedResources.SelectedItem is SiteResourceItem selectedRes)            {                suggestedFileName = string.IsNullOrWhiteSpace(selectedRes.Name) ? \u0022resource.txt\u0022 : selectedRes.Name;                return selectedRes.Content;            }            if (tabDumpViewers.SelectedTab == tabCombinedHtmlView)            {                suggestedFileName = \u0022combined.html\u0022;                return _lastSiteDumpResult.GetCombinedHtml();            }            if (tabDumpViewers.SelectedTab == tabCombinedCssView)            {                suggestedFileName = \u0022combined.css\u0022;                return _lastSiteDumpResult.GetCombinedCss();            }            if (tabDumpViewers.SelectedTab == tabCombinedJsView)            {                suggestedFileName = \u0022combined.js\u0022;                return _lastSiteDumpResult.GetCombinedJavaScript();            }            suggestedFileName = \u0022combined_dump.txt\u0022;            return _lastSiteDumpResult.GetCombinedContent();        }        private void BtnCopyCurrentDumpView_Click(object? sender, EventArgs e)        {            string content = GetActiveDumpViewerText(out string name);            if (string.IsNullOrEmpty(content))            {                Log(\u0022[WARN] No dumped source content in the active view to copy.\u0022, Color.Orange);                return;            }            Clipboard.SetText(content);            Log($\u0022[REV-ENG] Copied \u0027{name}\u0027 ({content.Length:N0} chars) to clipboard.\u0022, Color.Lime);        }        private void BtnSaveActiveDumpFile_Click(object? sender, EventArgs e)        {            if (_lastSiteDumpResult == null)            {                Log(\u0022[WARN] Please run a dump operation first.\u0022, Color.Orange);                return;            }            if (tabDumpViewers.SelectedTab == tabSelectedResourceView \u0026\u0026 lstDumpedResources.SelectedItem is SiteResourceItem selectedResource)            {                using var sfdResource = new SaveFileDialog                {                    Filter = \u0022All Files (.)|.|HTML Files (.html)|.html|CSS Files (.css)|.css|JavaScript Files (.js)|.js\u0022,                    Title = \u0022Save Selected Resource\u0022,                    FileName = selectedResource.Name                };                if (sfdResource.ShowDialog() == DialogResult.OK)                {                    try                    {                        selectedResource.SaveToFile(sfdResource.FileName);                        Log($\u0022[REV-ENG] Saved resource \u0027{selectedResource.Name}\u0027 to {sfdResource.FileName}\u0022, Color.Lime);                    }                    catch (Exception ex)                    {                        Log($\u0022[ERR] Failed to save resource: {ex.Message}\u0022, Color.Red);                    }                }                return;            }            string content = GetActiveDumpViewerText(out string defaultFileName);            if (string.IsNullOrEmpty(content))            {                Log(\u0022[WARN] Active dump view is empty.\u0022, Color.Orange);                return;            }            using var sfd = new SaveFileDialog            {                Filter = \u0022All Files (.)|.|HTML Files (.html)|.html|CSS Files (.css)|.css|JavaScript Files (.js)|.js\u0022,                Title = \u0022Save Combined Dump Output\u0022,                FileName = defaultFileName            };            if (sfd.ShowDialog() == DialogResult.OK)            {                try                {                    System.IO.File.WriteAllText(sfd.FileName, content, System.Text.Encoding.UTF8);                    Log($\u0022[REV-ENG] Saved \u0027{defaultFileName}\u0027 to {sfd.FileName}\u0022, Color.Lime);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Failed to save file: {ex.Message}\u0022, Color.Red);                }            }        }        private void BtnSaveDumpToFolder_Click(object? sender, EventArgs e)        {            if (_lastSiteDumpResult == null || _lastSiteDumpResult.TotalResourceCount == 0)            {                Log(\u0022[WARN] No site dump results available to save.\u0022, Color.Orange);                return;            }            using var fbd = new FolderBrowserDialog            {                Description = \u0022Select a destination folder to save all dumped HTML, CSS, and JavaScript files\u0022,                UseDescriptionForTitle = true            };            if (fbd.ShowDialog() == DialogResult.OK \u0026\u0026 !string.IsNullOrWhiteSpace(fbd.SelectedPath))            {                try                {                    string savedPath = _lastSiteDumpResult.SaveToDirectory(fbd.SelectedPath);                    Log($\u0022[REV-ENG] Saved {_lastSiteDumpResult.TotalResourceCount} resource(s) ({_lastSiteDumpResult.GetFormattedTotalSize()}) to {savedPath}\u0022, Color.Lime);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Failed to save dump to folder: {ex.Message}\u0022, Color.Red);                }            }        }    }}\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
      "ModelExplanation": "### Overview of Changes\n1. **Reverse Engineering Models (\u0060SiteResourceItem\u0060, \u0060SiteDumpOptions\u0060, \u0060SiteDumpResult\u0060, \u0060SiteDumpEventArgs\u0060)**:\n   - Added \u0060SiteResourceType\u0060 (\u0060Html\u0060, \u0060Css\u0060, \u0060JavaScript\u0060) and \u0060SiteDumpType\u0060 (\u0060Html\u0060, \u0060Css\u0060, \u0060JavaScript\u0060, \u0060All\u0060) enums.\n   - Added \u0060SiteResourceItem\u0060 to represent individual dumped assets (document HTML, iframes, external/inline/constructed CSS stylesheets, and external/inline/dynamic JS scripts) with helper methods to format metadata and save individual files (\u0060SaveToFile\u0060 / \u0060SaveToFileAsync\u0060).\n   - Added \u0060SiteDumpOptions\u0060 to configure what asset types and sources are included during a dump.\n   - Added \u0060SiteDumpResult\u0060 with methods to retrieve combined HTML/CSS/JS sources (\u0060GetCombinedHtml\u0060, \u0060GetCombinedCss\u0060, \u0060GetCombinedJavaScript\u0060, \u0060GetCombinedContent\u0060), serialize to JSON (\u0060ToJson\u0060), save combined output (\u0060SaveCombinedToFile\u0060), and export structured site dumps (\u0060index.html\u0060, \u0060css/\u0060, \u0060js/\u0060, \u0060manifest.json\u0060) to a directory (\u0060SaveToDirectory\u0060 / \u0060SaveToDirectoryAsync\u0060).\n2. **Reverse Engineering Engine \u0026 \u0060BrowserClient\u0060 API (\u0060SiteDumper\u0060, \u0060ReactExtensions\u0060, \u0060AutomationRunner\u0060)**:\n   - Added \u0060SiteDumper\u0060 in \u0060BrowserAutomationFramework.ReverseEngineering\u0060 with \u0060DumpHtmlAsync\u0060, \u0060DumpCssAsync\u0060, \u0060DumpJavaScriptAsync\u0060, \u0060DumpAllAsync\u0060, and \u0060DumpSiteAsync\u0060, plus lifecycle events (\u0060OnDumpStarted\u0060, \u0060OnDumpCompleted\u0060, \u0060OnDumpFailed\u0060).\n   - Added \u0060BrowserClient\u0060 extension methods (\u0060DumpHtmlAsync\u0060, \u0060DumpCssAsync\u0060, \u0060DumpJavaScriptAsync\u0060, \u0060DumpAllAsync\u0060, \u0060DumpSiteAsync\u0060) in \u0060ReactExtensions\u0060.\n   - Added \u0060AutomationActionType.DumpSite\u0060 support to \u0060AutomationRunner\u0060.\n3. **Userscript Reverse Engineering Actions (\u0060ScriptGenerator\u0060)**:\n   - Added \u0060ReverseEngineeringUtils\u0060 and registered \u0060DUMP_HTML\u0060, \u0060DUMP_CSS\u0060, \u0060DUMP_JS\u0060, and \u0060DUMP_SITE\u0060 commands in the generated Tampermonkey script.\n   - Uses \u0060GM_xmlhttpRequest\u0060 (with \u0060fetch\u0060 and CSSOM \u0060cssRules\u0060 fallbacks) to retrieve cross-origin external stylesheets and scripts, inline \u0060\u003Cstyle\u003E\u0060 and \u0060\u003Cscript\u003E\u0060 blocks, constructed stylesheets, and dynamically loaded scripts from \u0060performance.getEntriesByType(\u0027resource\u0027)\u0060, while stripping framework highlight overlays from the dumped HTML.\n4. **TestBedApp UI (\u0060MainForm\u0060, \u0060MainForm.Designer\u0060)**:\n   - Added a **Reverse Engineering** tab to \u0060MainForm\u0060 featuring the 4 dump buttons (**Dump HTML**, **Dump CSS**, **Dump JavaScript**, **Dump Everything**), resource filter \u0026 options checkboxes, a resource inspector list, individual and combined source viewers, and file/folder export buttons that wrap the new API methods.\n\n### How to Test\n1. Build and run \u0060TestBedApp\u0060.\n2. Click **Start Server**, then click **Generate \u0026 Copy Script** and install/update the Tampermonkey userscript in your browser.\n3. Open any website in the browser and verify the client appears in **Connected Clients**.\n4. Open the **Reverse Engineering** tab and test the 4 buttons:\n   - **Dump HTML**: Extracts and displays the full page HTML (and any accessible iframe HTML).\n   - **Dump CSS**: Extracts all external \u0060\u003Clink rel=\u0022stylesheet\u0022\u003E\u0060, inline \u0060\u003Cstyle\u003E\u0060, and constructed CSSOM stylesheets.\n   - **Dump JavaScript**: Extracts all external \u0060\u003Cscript src\u003E\u0060, inline \u0060\u003Cscript\u003E\u0060, and dynamically loaded JS resources.\n   - **Dump Everything**: Extracts all HTML, CSS, and JavaScript in a single operation.\n5. Select individual assets on the left to inspect their source code and metadata, switch between the combined HTML/CSS/JS tabs, or click **Save Dump to Folder...** to write the full structured site dump to disk.",
