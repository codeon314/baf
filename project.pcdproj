op.SuspendLayout();\n==== REPLACE\n            pnlLogs = new GroupBox();\n            rtbLogs = new RichTextBox();\n            tabMain = new TabControl();\n            tabRaw = new TabPage();\n            tabDom = new TabPage();\n            tabEditor = new TabPage();\n            pnlDomTop = new Panel();\n            btnRefreshDom = new Button();\n            splitDom = new SplitContainer();\n            tvDom = new TreeView();\n            txtElementDetails = new TextBox();\n            pnlEditorTop = new Panel();\n            btnAddStep = new Button();\n            btnRemoveStep = new Button();\n            btnRunAutomation = new Button();\n            splitEditor = new SplitContainer();\n            lstSteps = new ListBox();\n            pgStepDetails = new PropertyGrid();\n            ctxDomNode = new ContextMenuStrip();\n            mnuClickElement = new ToolStripMenuItem();\n            mnuSetValue = new ToolStripMenuItem();\n            mnuAddClickStep = new ToolStripMenuItem();\n            mnuAddSetValueStep = new ToolStripMenuItem();\n            pnlTop.SuspendLayout();\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            pnlCommands.SuspendLayout();\n            tlpCommands.SuspendLayout();\n            pnlCmdButtons.SuspendLayout();\n            pnlLogs.SuspendLayout();\n            SuspendLayout();\n==== REPLACE\n            pnlCommands.SuspendLayout();\n            tabMain.SuspendLayout();\n            tabRaw.SuspendLayout();\n            tabDom.SuspendLayout();\n            pnlDomTop.SuspendLayout();\n            ((System.ComponentModel.ISupportInitialize)splitDom).BeginInit();\n            splitDom.Panel1.SuspendLayout();\n            splitDom.Panel2.SuspendLayout();\n            splitDom.SuspendLayout();\n            tabEditor.SuspendLayout();\n            pnlEditorTop.SuspendLayout();\n            ((System.ComponentModel.ISupportInitialize)splitEditor).BeginInit();\n            splitEditor.Panel1.SuspendLayout();\n            splitEditor.Panel2.SuspendLayout();\n            splitEditor.SuspendLayout();\n            tlpCommands.SuspendLayout();\n            pnlCmdButtons.SuspendLayout();\n            pnlLogs.SuspendLayout();\n            SuspendLayout();\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private System.Windows.Forms.GroupBox pnlCommands;\n        private System.Windows.Forms.Label lblCmdType;\n        private System.Windows.Forms.TextBox txtCmdType;\n        private System.Windows.Forms.Label lblPayload;\n        private System.Windows.Forms.TextBox txtPayload;\n        private System.Windows.Forms.Button btnSend;\n        private System.Windows.Forms.Button btnReactClick;\n        private System.Windows.Forms.Button btnEval;\n        private System.Windows.Forms.GroupBox pnlLogs;\n        private System.Windows.Forms.RichTextBox rtbLogs;\n    }\n}\n==== REPLACE\n        private System.Windows.Forms.GroupBox pnlCommands;\n        private System.Windows.Forms.Label lblCmdType;\n        private System.Windows.Forms.TextBox txtCmdType;\n        private System.Windows.Forms.Label lblPayload;\n        private System.Windows.Forms.TextBox txtPayload;\n        private System.Windows.Forms.Button btnSend;\n        private System.Windows.Forms.Button btnReactClick;\n        private System.Windows.Forms.Button btnEval;\n        private System.Windows.Forms.GroupBox pnlLogs;\n        private System.Windows.Forms.RichTextBox rtbLogs;\n\n        private System.Windows.Forms.TabControl tabMain;\n        private System.Windows.Forms.TabPage tabRaw;\n        private System.Windows.Forms.TabPage tabDom;\n        private System.Windows.Forms.TabPage tabEditor;\n        private System.Windows.Forms.Panel pnlDomTop;\n        private System.Windows.Forms.Button btnRefreshDom;\n        private System.Windows.Forms.SplitContainer splitDom;\n        private System.Windows.Forms.TreeView tvDom;\n        private System.Windows.Forms.TextBox txtElementDetails;\n        private System.Windows.Forms.Panel pnlEditorTop;\n        private System.Windows.Forms.Button btnAddStep;\n        private System.Windows.Forms.Button btnRemoveStep;\n        private System.Windows.Forms.Button btnRunAutomation;\n        private System.Windows.Forms.SplitContainer splitEditor;\n        private System.Windows.Forms.ListBox lstSteps;\n        private System.Windows.Forms.PropertyGrid pgStepDetails;\n        private System.Windows.Forms.ContextMenuStrip ctxDomNode;\n        private System.Windows.Forms.ToolStripMenuItem mnuClickElement;\n        private System.Windows.Forms.ToolStripMenuItem mnuSetValue;\n        private System.Windows.Forms.ToolStripMenuItem mnuAddClickStep;\n        private System.Windows.Forms.ToolStripMenuItem mnuAddSetValueStep;\n    }\n}\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nusing BrowserAutomationFramework.Generators;\nusing BrowserAutomationFramework.Extensions;\n\nnamespace TestBedApp\n==== REPLACE\nusing BrowserAutomationFramework.Generators;\nusing BrowserAutomationFramework.Extensions;\nusing TestBedApp.Models;\nusing System.Collections.Generic;\n\nnamespace TestBedApp\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private async void BtnEval_Click(object sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client) return;\n            string code = txtPayload.Text.Trim();\n            \n            Log($\u0022[TX -\u003E {client.InstanceId}] EVAL | Code: {code}\u0022, Color.DeepSkyBlue);\n            try\n            {\n                var result = await client.EvaluateJavaScriptAsync(code);\n                Log($\u0022[RX \u003C- {client.InstanceId}] Status: {result.Status} | Output: {result.Output}\u0022, Color.White);\n            }\n            catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }\n        }\n    }\n}\n==== REPLACE\n        private async void BtnEval_Click(object sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client) return;\n            string code = txtPayload.Text.Trim();\n            \n            Log($\u0022[TX -\u003E {client.InstanceId}] EVAL | Code: {code}\u0022, Color.DeepSkyBlue);\n            try\n            {\n                var result = await client.EvaluateJavaScriptAsync(code);\n                Log($\u0022[RX \u003C- {client.InstanceId}] Status: {result.Status} | Output: {result.Output}\u0022, Color.White);\n            }\n            catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }\n        }\n\n        private async void BtnRefreshDom_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a client first.\u0022, Color.Orange);\n                return;\n            }\n\n            Log($\u0022[SYS] Fetching DOM from {client.InstanceId}...\u0022, Color.Cyan);\n            try\n            {\n                var result = await client.GetDomAsync();\n                if (result.Status == \u0022completed\u0022 \u0026\u0026 !string.IsNullOrEmpty(result.Output))\n                {\n                    var rootNode = JsonSerializer.Deserialize\u003CDomNode\u003E(result.Output);\n                    if (rootNode != null)\n                    {\n                        tvDom.Nodes.Clear();\n                        var treeNode = BuildTreeNode(rootNode);\n                        tvDom.Nodes.Add(treeNode);\n                        treeNode.Expand();\n                        Log(\u0022[SYS] DOM loaded successfully.\u0022, Color.Lime);\n                    }\n                }\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to fetch DOM: {ex.Message}\u0022, Color.Red);\n            }\n        }\n\n        private TreeNode BuildTreeNode(DomNode domNode)\n        {\n            string text = domNode.Type == \u0022text\u0022 ? $\u0022\\\u0022{domNode.Text}\\\u0022\u0022 : $\u0022\u003C{domNode.TagName}\u003E\u0022;\n            if (domNode.Attributes != null \u0026\u0026 domNode.Attributes.TryGetValue(\u0022id\u0022, out var id))\n            {\n                text \u002B= $\u0022 #{id}\u0022;\n            }\n            if (domNode.Attributes != null \u0026\u0026 domNode.Attributes.TryGetValue(\u0022class\u0022, out var cls))\n            {\n                text \u002B= $\u0022 .{cls.Replace(\u0022 \u0022, \u0022.\u0022)}\u0022;\n            }\n\n            var treeNode = new TreeNode(text)\n            {\n                Tag = domNode\n            };\n\n            if (domNode.Children != null)\n            {\n                foreach (var child in domNode.Children)\n                {\n                    treeNode.Nodes.Add(BuildTreeNode(child));\n                }\n            }\n\n            return treeNode;\n        }\n\n        private async void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)\n        {\n            if (e.Node?.Tag is DomNode domNode)\n            {\n                var details = new System.Text.StringBuilder();\n                details.AppendLine($\u0022Type: {domNode.Type}\u0022);\n                if (domNode.Type == \u0022element\u0022)\n                {\n                    details.AppendLine($\u0022Tag: {domNode.TagName}\u0022);\n                    details.AppendLine($\u0022Path: {domNode.Path}\u0022);\n                    details.AppendLine(\u0022Attributes:\u0022);\n                    if (domNode.Attributes != null)\n                    {\n                        foreach (var kvp in domNode.Attributes)\n                        {\n                            details.AppendLine($\u0022  {kvp.Key} = \\\u0022{kvp.Value}\\\u0022\u0022);\n                        }\n                    }\n                }\n                else if (domNode.Type == \u0022text\u0022)\n                {\n                    details.AppendLine($\u0022Text: {domNode.Text}\u0022);\n                }\n\n                txtElementDetails.Text = details.ToString();\n\n                if (domNode.Type == \u0022element\u0022 \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n                {\n                    try\n                    {\n                        await client.HighlightElementAsync(domNode.Path);\n                    }\n                    catch { /* Ignore highlight errors */ }\n                }\n            }\n        }\n\n        private void TvDom_NodeMouseClick(object? sender, TreeNodeMouseClickEventArgs e)\n        {\n            if (e.Button == MouseButtons.Right)\n            {\n                tvDom.SelectedNode = e.Node;\n                if (e.Node.Tag is DomNode domNode \u0026\u0026 domNode.Type == \u0022element\u0022)\n                {\n                    ctxDomNode.Show(tvDom, e.Location);\n                }\n            }\n        }\n\n        private async void MnuClickElement_Click(object? sender, EventArgs e)\n        {\n            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n            {\n                Log($\u0022[SYS] Testing click on {domNode.Path}\u0022, Color.Cyan);\n                try\n                {\n                    var res = await client.ClickReactElementAsync(domNode.Path);\n                    Log($\u0022[RX] {res.Output}\u0022, Color.White);\n                }\n                catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }\n            }\n        }\n\n        private string PromptForValue(string text, string caption)\n        {\n            Form prompt = new Form()\n            {\n                Width = 400,\n                Height = 150,\n                FormBorderStyle = FormBorderStyle.FixedDialog,\n                Text = caption,\n                StartPosition = FormStartPosition.CenterScreen\n            };\n            Label textLabel = new Label() { Left = 20, Top = 20, Text = text, Width = 340 };\n            TextBox textBox = new TextBox() { Left = 20, Top = 50, Width = 340 };\n            Button confirmation = new Button() { Text = \u0022Ok\u0022, Left = 260, Width = 100, Top = 80, DialogResult = DialogResult.OK };\n            prompt.Controls.Add(textBox);\n            prompt.Controls.Add(confirmation);\n            prompt.Controls.Add(textLabel);\n            prompt.AcceptButton = confirmation;\n\n            return prompt.ShowDialog() == DialogResult.OK ? textBox.Text : string.Empty;\n        }\n\n        private async void MnuSetValue_Click(object? sender, EventArgs e)\n        {\n            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n            {\n                string value = PromptForValue(\u0022Enter value to set:\u0022, \u0022Set Value\u0022);\n                if (string.IsNullOrEmpty(value)) return;\n\n                Log($\u0022[SYS] Testing set value on {domNode.Path}\u0022, Color.Cyan);\n                try\n                {\n                    var res = await client.SetReactInputValueAsync(domNode.Path, value);\n                    Log($\u0022[RX] {res.Output}\u0022, Color.White);\n                }\n                catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }\n            }\n        }\n\n        private void MnuAddClickStep_Click(object? sender, EventArgs e)\n        {\n            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path))\n            {\n                var step = new AutomationStep\n                {\n                    Name = $\u0022Click \u003C{domNode.TagName}\u003E\u0022,\n                    ActionType = AutomationActionType.Click,\n                    Selector = domNode.Path\n                };\n                lstSteps.Items.Add(step);\n                tabMain.SelectedTab = tabEditor;\n                lstSteps.SelectedItem = step;\n            }\n        }\n\n        private void MnuAddSetValueStep_Click(object? sender, EventArgs e)\n        {\n            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path))\n            {\n                var step = new AutomationStep\n                {\n                    Name = $\u0022Set Value \u003C{domNode.TagName}\u003E\u0022,\n                    ActionType = AutomationActionType.SetValue,\n                    Selector = domNode.Path\n                };\n                lstSteps.Items.Add(step);\n                tabMain.SelectedTab = tabEditor;\n                lstSteps.SelectedItem = step;\n            }\n        }\n\n        private void BtnAddStep_Click(object? sender, EventArgs e)\n        {\n            var step = new AutomationStep();\n            lstSteps.Items.Add(step);\n            lstSteps.SelectedItem = step;\n        }\n\n        private void BtnRemoveStep_Click(object? sender, EventArgs e)\n        {\n            if (lstSteps.SelectedItem != null)\n            {\n                lstSteps.Items.Remove(lstSteps.SelectedItem);\n            }\n        }\n\n        private void LstSteps_SelectedIndexChanged(object? sender, EventArgs e)\n        {\n            pgStepDetails.SelectedObject = lstSteps.SelectedItem;\n        }\n\n        private void PgStepDetails_PropertyValueChanged(object? s, PropertyValueChangedEventArgs e)\n        {\n            int idx = lstSteps.SelectedIndex;\n            if (idx \u003E= 0)\n            {\n                var item = lstSteps.Items[idx];\n                lstSteps.Items[idx] = item;\n            }\n        }\n\n        private async void BtnRunAutomation_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a client first.\u0022, Color.Orange);\n                return;\n            }\n\n            if (lstSteps.Items.Count == 0) return;\n\n            Log(\u0022[SYS] Starting Automation Run...\u0022, Color.Magenta);\n            btnRunAutomation.Enabled = false;\n\n            try\n            {\n                foreach (AutomationStep step in lstSteps.Items)\n                {\n                    Log($\u0022[AUTO] Executing: {step.Name}\u0022, Color.Plum);\n                    CommandResult res = null;\n                    \n                    if (step.ActionType == AutomationActionType.Click)\n                    {\n                        res = await client.ClickReactElementAsync(step.Selector);\n                    }\n                    else if (step.ActionType == AutomationActionType.SetValue)\n                    {\n                        res = await client.SetReactInputValueAsync(step.Selector, step.Value);\n                    }\n                    else if (step.ActionType == AutomationActionType.EvaluateScript)\n                    {\n                        res = await client.EvaluateJavaScriptAsync(step.Value);\n                    }\n\n                    if (res != null)\n                    {\n                        Log($\u0022[AUTO-RX] {res.Status} | {res.Output}\u0022, Color.White);\n                    }\n                    \n                    await Task.Delay(500);\n                }\n                Log(\u0022[SYS] Automation Run Completed.\u0022, Color.Lime);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Automation aborted: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnRunAutomation.Enabled = true;\n            }\n        }\n    }\n}\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\Models\\DomNode.cs**\n\n\u0060\u0060\u0060cs\nusing System.Collections.Generic;\nusing System.Text.Json.Serialization;\n\nnamespace TestBedApp.Models\n{\n    public class DomNode\n    {\n        [JsonPropertyName(\u0022type\u0022)]\n        public string Type { get; set; } = string.Empty;\n\n        [JsonPropertyName(\u0022tagName\u0022)]\n        public string? TagName { get; set; }\n\n        [JsonPropertyName(\u0022path\u0022)]\n        public string? Path { get; set; }\n\n        [JsonPropertyName(\u0022text\u0022)]\n        public string? Text { get; set; }\n\n        [JsonPropertyName(\u0022attributes\u0022)]\n        public Dictionary\u003Cstring, string\u003E? Attributes { get; set; }\n\n        [JsonPropertyName(\u0022children\u0022)]\n        public List\u003CDomNode\u003E? Children { get; set; }\n    }\n}\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\Models\\AutomationStep.cs**\n\n\u0060\u0060\u0060cs\nnamespace TestBedApp.Models\n{\n    public enum AutomationActionType\n    {\n        Click,\n        SetValue,\n        EvaluateScript\n    }\n\n    public class AutomationStep\n    {\n        public string Name { get; set; } = \u0022New Step\u0022;\n        public AutomationActionType ActionType { get; set; }\n        public string Selector { get; set; } = string.Empty;\n        public string Value { get; set; } = string.Empty;\n\n        public override string ToString() =\u003E $\u0022{Name} ({ActionType})\u0022;\n    }\n}\n\u0060\u0060\u0060\n\nCitations\n\n- [https://github.com/AP-Students/website](https://github.com/AP-Students/website)\n- [https://github.com/hds3131/WindowsForms](https://github.com/hds3131/WindowsForms)",
      "ModelExplanation": "I have implemented the DOM Explorer and Automation Editor features.\n\n- **ScriptGenerator.cs**: Added \u0060GET_DOM\u0060, \u0060HIGHLIGHT_ELEMENT\u0060, and \u0060REMOVE_HIGHLIGHT\u0060 commands. The DOM serialization generates precise CSS selector paths for every element.\n- **ReactExtensions.cs**: Added extension methods for the new commands.\n- **MainForm.Designer.cs \u0026 MainForm.cs**: Replaced the command panel with a TabControl containing \u0022Raw Commands\u0022, \u0022DOM Explorer\u0022, and \u0022Automation Editor\u0022. The DOM Explorer uses a TreeView to display the DOM, highlights elements in the browser on selection, and provides a context menu to test actions or add them to an automation script. The Automation Editor allows building, editing, and running a sequence of actions.\n- **New Models**: Created \u0060DomNode.cs\u0060 and \u0060AutomationStep.cs\u0060 to support the new features.\n\nTo test:\n\n- Start the server and inject the generated script into a browser page.\n- Go to the \u0022DOM Explorer\u0022 tab and click \u0022Refresh DOM\u0022.\n- Expand the tree and click on elements to see them highlighted in the browser.\n- Right-click an element to test a click/set value, or add it to the Automation Editor.\n- Go to the \u0022Automation Editor\u0022 tab, configure your steps, and click \u0022Run Automation\u0022.",
