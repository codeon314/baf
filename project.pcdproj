PostScrapeSequenceName { get; set; } = string.Empty;        /// \u003Csummary\u003E        /// Gets or sets whether multi-page pagination is enabled.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022enablePagination\u0022)]        public bool EnablePagination { get; set; } = false;        /// \u003Csummary\u003E        /// Gets or sets the CSS selector of the Next Page button/link to click between pages.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022nextPageSelector\u0022)]        public string NextPageSelector { get; set; } = string.Empty;        /// \u003Csummary\u003E        /// Gets or sets an optional URL pattern (e.g., \u003Cc\u003Ehttps://site.com/items?page={page}\u003C/c\u003E) for URL-based pagination.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022paginationUrlPattern\u0022)]        public string PaginationUrlPattern { get; set; } = string.Empty;        /// \u003Csummary\u003E        /// Gets or sets the starting page number when using \u003Csee cref=\u0022PaginationUrlPattern\u0022/\u003E.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022paginationStartPage\u0022)]        public int PaginationStartPage { get; set; } = 1;        /// \u003Csummary\u003E        /// Gets or sets the page number increment between pages when using \u003Csee cref=\u0022PaginationUrlPattern\u0022/\u003E.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022paginationPageIncrement\u0022)]        public int PaginationPageIncrement { get; set; } = 1;        /// \u003Csummary\u003E        /// Gets or sets the name of an optional custom \u003Csee cref=\u0022AutomationSequence\u0022/\u003E used to advance pages.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022paginationSequenceName\u0022)]        public string PaginationSequenceName { get; set; } = string.Empty;        /// \u003Csummary\u003E        /// Gets or sets the maximum number of pages to scrape when \u003Csee cref=\u0022EnablePagination\u002