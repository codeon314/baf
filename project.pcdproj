               var rows = _state.VisibleRows;\n                if (_state.GetVisibleRowRange(view.Height, _itemHeight, out int firstRow, out int lastRow))\n                {\n                    int glyphBoxSize = ScaleDpi(9);\n                    if (glyphBoxSize % 2 == 0) glyphBoxSize\u002B\u002B;\n\n                    const TextFormatFlags drawFlags = TextFormatFlags.NoPadding | TextFormatFlags.SingleLine | TextFormatFlags.NoPrefix | TextFormatFlags.PreserveGraphicsClipping;\n\n                    for (int rowIdx = firstRow; rowIdx \u003C= lastRow; rowIdx\u002B\u002B)\n                    {\n                        var item = rows[rowIdx];\n                        var measure = EnsureItemMeasured(g, item);\n\n                        int rowY = view.Top \u002B (rowIdx * _itemHeight) - _state.ScrollY;\n                        int centerY = rowY \u002B (_itemHeight / 2);\n                        int indentX = view.Left \u002B _paddingLeft \u002B (item.Depth * _indentWidth) - _state.ScrollX;\n                        int textStartX = indentX \u002B _glyphColumnWidth;\n\n                        bool isExpanded = item.HasChildren \u0026\u0026 _state.IsExpanded(item.UniqueKey);\n                        bool isSelected = string.Equals(item.UniqueKey, _state.SelectedKey, StringComparison.Ordinal);\n                        bool isHovered = rowIdx == _hoveredRowIndex \u0026\u0026 !isSelected;\n\n                        int textTotalW = _state.GetMeasuredRowTextWidth(item, measure.OpenTotalWidth, measure.CollapsedSuffixTotalWidth);\n\n                        // Selection or hover highlight\n                        if (isSelected)\n                        {\n                            Rectangle selRect = new Rectangle(textStartX - 2, rowY, textTotalW \u002B 6, _itemHeight);\n                            g.FillRectangle(_selBgBrush, selRect);\n                        }\n                        else if (isHovered)\n                        {\n                            Rectangle hovRect = new Rectangle(textStartX - 2, rowY, textTotalW \u002B 6, _itemHeight);\n                            g.FillRectangle(_hoverBgBrush, hovRect);\n                        }\n\n                        // Hierarchy guide lines\n                        if (ShowLines)\n                        {\n                            for (int d = (ShowRootLines ? 0 : 1); d \u003C item.Depth; d\u002B\u002B)\n                            {\n                                int guideX = view.Left \u002B _paddingLeft \u002B (d * _indentWidth) \u002B (_glyphColumnWidth / 2) - _state.ScrollX;\n                                if (guideX \u003E= view.Left \u0026\u0026 guideX \u003C= view.Right)\n                                {\n                                    g.DrawLine(_linePen, guideX, rowY, guideX, rowY \u002B _itemHeight);\n                                }\n                            }\n\n                            if (item.Depth \u003E 0 || ShowRootLines)\n                            {\n                                int lineCenterX = indentX \u002B (_glyphColumnWidth / 2);\n                                if (lineCenterX \u003E= view.Left - 20 \u0026\u0026 lineCenterX \u003C= view.Right)\n                                {\n                                    g.DrawLine(_linePen, lineCenterX, rowY, lineCenterX, centerY);\n                                    g.DrawLine(_linePen, lineCenterX, centerY, textStartX - 3, centerY);\n                                }\n                            }\n                        }\n\n                        // Expand / Collapse Plus-Minus Box\n                        if (ShowPlusMinus \u0026\u0026 item.HasChildren)\n                        {\n                            int boxLeft = indentX \u002B ((_glyphColumnWidth - glyphBoxSize) / 2);\n                            int boxTop = centerY - (glyphBoxSize / 2);\n                            Rectangle boxRect = new Rectangle(boxLeft, boxTop, glyphBoxSize - 1, glyphBoxSize - 1);\n\n                            g.FillRectangle(_glyphFillBrush, boxRect);\n                            g.DrawRectangle(_glyphBorderPen, boxRect);\n\n                            int signMargin = 2;\n                            int midY = boxTop \u002B (glyphBoxSize / 2);\n                            int midX = boxLeft \u002B (glyphBoxSize / 2);\n                            g.DrawLine(_glyphSignPen, boxLeft \u002B signMargin, midY, boxLeft \u002B glyphBoxSize - 1 - signMargin, midY);\n                            if (!isExpanded)\n                            {\n                                g.DrawLine(_glyphSignPen, midX, boxTop \u002B signMargin, midX, boxTop \u002B glyphBoxSize - 1 - signMargin);\n                            }\n                        }\n\n                        // Syntax-highlighted tokens with horizontal viewport culling\n                        int textY = rowY \u002B ((_itemHeight - _codeFont.Height) / 2);\n                        int curX = textStartX;\n\n                        var openParts = item.OpenParts;\n                        var openWidths = measure.OpenPartWidths;\n                        for (int p = 0; p \u003C openParts.Length; p\u002B\u002B)\n                        {\n                            int w = openWidths[p];\n                            if (curX \u002B w \u003E= view.Left)\n                            {\n                                Color tokenColor = GetColorForToken(openParts[p].ColorType);\n                                TextRenderer.DrawText(g, openParts[p].Text, _codeFont, new Point(curX, textY), tokenColor, drawFlags);\n                            }\n                            curX \u002B= w;\n                            if (curX \u003E view.Right)\n                                break;\n                        }\n\n                        if (item.HasChildren \u0026\u0026 !isExpanded \u0026\u0026 curX \u003C= view.Right)\n                        {\n                            var suffixParts = item.CollapsedSuffixParts;\n                            var suffixWidths = measure.CollapsedSuffixWidths;\n                            for (int p = 0; p \u003C suffixParts.Length; p\u002B\u002B)\n                            {\n                                int w = suffixWidths[p];\n                                if (curX \u002B w \u003E= view.Left)\n                                {\n                                    Color tokenColor = GetColorForToken(suffixParts[p].ColorType);\n                                    TextRenderer.DrawText(g, suffixParts[p].Text, _codeFont, new Point(curX, textY), tokenColor, drawFlags);\n                                }\n                                curX \u002B= w;\n                                if (curX \u003E view.Right)\n                                    break;\n                            }\n                        }\n                    }\n                }\n==== REPLACE\n                var rows = _state.VisibleRows;\n                if (_state.GetVisibleRowRange(view.Height, _itemHeight, out int firstRow, out int lastRow))\n                {\n                    int rawGlyphBoxSize = ScaleDpi(9);\n                    const TextFormatFlags drawFlags = TextFormatFlags.NoPadding | TextFormatFlags.SingleLine | TextFormatFlags.NoPrefix | TextFormatFlags.PreserveGraphicsClipping;\n\n                    for (int rowIdx = firstRow; rowIdx \u003C= lastRow; rowIdx\u002B\u002B)\n                    {\n                        var item = rows[rowIdx];\n                        var measure = EnsureItemMeasured(g, item);\n                        var rowLayout = _state.CalculateRowRenderLayout(\n                            rowIdx,\n                            item,\n                            measure,\n                            _hoveredRowIndex,\n                            view.Left,\n                            view.Top,\n                            view.Right,\n                            _paddingLeft,\n                            _indentWidth,\n                            _glyphColumnWidth,\n                            _itemHeight,\n                            _codeFont.Height,\n                            rawGlyphBoxSize,\n                            ShowLines,\n                            ShowRootLines,\n                            ShowPlusMinus);\n\n                        if (rowLayout.IsSelected || rowLayout.IsHovered)\n                        {\n                            Rectangle hlRect = new Rectangle(\n                                rowLayout.HighlightLeft,\n                                rowLayout.HighlightTop,\n                                rowLayout.HighlightWidth,\n                                rowLayout.HighlightHeight);\n                            g.FillRectangle(rowLayout.IsSelected ? _selBgBrush : _hoverBgBrush, hlRect);\n                        }\n\n                        if (ShowLines)\n                        {\n                            for (int d = (ShowRootLines ? 0 : 1); d \u003C item.Depth; d\u002B\u002B)\n                            {\n                                if (_state.TryGetAncestorGuideLineX(d, view.Left, view.Right, _paddingLeft, _indentWidth, _glyphColumnWidth, out int guideX))\n                                {\n                                    g.DrawLine(_linePen, guideX, rowLayout.RowY, guideX, rowLayout.RowY \u002B _itemHeight);\n                                }\n                            }\n\n                            if (rowLayout.HasBranchConnector)\n                            {\n                                g.DrawLine(_linePen, rowLayout.BranchLineCenterX, rowLayout.RowY, rowLayout.BranchLineCenterX, rowLayout.CenterY);\n                                g.DrawLine(_linePen, rowLayout.BranchLineCenterX, rowLayout.CenterY, rowLayout.BranchHorizontalEndX, rowLayout.CenterY);\n                            }\n                        }\n\n                        if (rowLayout.ShowExpandGlyph)\n                        {\n                            Rectangle boxRect = new Rectangle(\n                                rowLayout.GlyphBoxLeft,\n                                rowLayout.GlyphBoxTop,\n                                rowLayout.GlyphBoxDrawSize,\n                                rowLayout.GlyphBoxDrawSize);\n\n                            g.FillRectangle(_glyphFillBrush, boxRect);\n                            g.DrawRectangle(_glyphBorderPen, boxRect);\n                            g.DrawLine(_glyphSignPen, rowLayout.GlyphSignLeft, rowLayout.GlyphSignMidY, rowLayout.GlyphSignRight, rowLayout.GlyphSignMidY);\n                            if (!rowLayout.IsExpanded)\n                            {\n                                g.DrawLine(_glyphSignPen, rowLayout.GlyphSignMidX, rowLayout.GlyphSignTop, rowLayout.GlyphSignMidX, rowLayout.GlyphSignBottom);\n                            }\n                        }\n\n                        foreach (var token in _state.EnumerateVisibleTokens(item, measure, rowLayout, view.Left, view.Right))\n                        {\n                            TextRenderer.DrawText(\n                                g,\n                                token.Text,\n                                _codeFont,\n                                new Point(token.X, token.Y),\n                                GetColorForToken(token.ColorType),\n                                drawFlags);\n                        }\n                    }\n                }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private static Color GetColorForToken(DomTokenColor tokenColor)\n        {\n            var rgb = tokenColor.GetDefaultRgb();\n            return Color.FromArgb(rgb.R, rgb.G, rgb.B);\n        }\n\n        private int GetRowIndexAtY(int y)\n        {\n            Rectangle view = GetViewportBounds();\n            return _state.GetRowIndexAtY(y, view.Top, view.Height, _state.ScrollY, _itemHeight);\n        }\n\n        private bool IsPointOnExpandGlyph(DomTreeItem item, int x)\n        {\n            Rectangle view = GetViewportBounds();\n            return _state.IsPointOnExpandGlyph(item, x, view.Left, _paddingLeft, _indentWidth, _glyphColumnWidth, _state.ScrollX);\n        }\n\n        private void ToggleItemExpansion(DomTreeItem item)\n        {\n            if (_state.ToggleExpansion(item))\n            {\n                RecalculateContentWidth();\n                Invalidate();\n            }\n        }\n\n        protected override void OnMouseDown(MouseEventArgs e)\n        {\n            base.OnMouseDown(e);\n\n            if (!Focused \u0026\u0026 CanFocus)\n                Focus();\n\n            int rowIndex = GetRowIndexAtY(e.Y);\n            if (rowIndex \u003C 0)\n                return;\n\n            var item = _state.VisibleRows[rowIndex];\n\n            if (e.Button == MouseButtons.Left \u0026\u0026 IsPointOnExpandGlyph(item, e.X))\n            {\n                ToggleItemExpansion(item);\n                return;\n            }\n\n            SelectRowInternal(rowIndex, TreeViewAction.ByMouse, ensureVisible: false);\n\n            if (e.Button == MouseButtons.Right)\n            {\n                NodeMouseClick?.Invoke(\n                    this,\n                    new TreeNodeMouseClickEventArgs(CreateShimTreeNode(item.Node), e.Button, e.Clicks, e.X, e.Y));\n            }\n        }\n\n        protected override void OnMouseDoubleClick(MouseEventArgs e)\n        {\n            base.OnMouseDoubleClick(e);\n\n            if (e.Button != MouseButtons.Left)\n                return;\n\n            int rowIndex = GetRowIndexAtY(e.Y);\n            if (rowIndex \u003E= 0 \u0026\u0026 rowIndex \u003C _state.VisibleRows.Count)\n            {\n                var item = _state.VisibleRows[rowIndex];\n                if (!IsPointOnExpandGlyph(item, e.X) \u0026\u0026 item.HasChildren)\n                {\n                    ToggleItemExpansion(item);\n                }\n            }\n        }\n==== REPLACE\n        private static Color ToColor((byte R, byte G, byte B) rgb) =\u003E Color.FromArgb(rgb.R, rgb.G, rgb.B);\n\n        private static Color GetColorForToken(DomTokenColor tokenColor) =\u003E ToColor(tokenColor.GetDefaultRgb());\n\n        private int GetRowIndexAtY(int y)\n        {\n            Rectangle view = GetViewportBounds();\n            return _state.GetRowIndexAtY(y, view.Top, view.Height, _state.ScrollY, _itemHeight);\n        }\n\n        protected override void OnMouseDown(MouseEventArgs e)\n        {\n            base.OnMouseDown(e);\n\n            if (!Focused \u0026\u0026 CanFocus)\n                Focus();\n\n            Rectangle view = GetViewportBounds();\n            if (!_state.HandlePointerDown(\n                    e.X,\n                    e.Y,\n                    e.Button == MouseButtons.Left,\n                    view.Left,\n                    view.Top,\n                    view.Height,\n                    _paddingLeft,\n                    _indentWidth,\n                    _glyphColumnWidth,\n                    _itemHeight,\n                    out var hitItem,\n                    out bool expansionToggled,\n                    out _) || hitItem == null)\n            {\n                return;\n            }\n\n            if (expansionToggled)\n            {\n                RecalculateContentWidth();\n                Invalidate();\n                return;\n            }\n\n            Invalidate();\n            RaiseAfterSelect(hitItem.Node, TreeViewAction.ByMouse);\n\n            if (e.Button == MouseButtons.Right)\n            {\n                NodeMouseClick?.Invoke(\n                    this,\n                    new TreeNodeMouseClickEventArgs(CreateShimTreeNode(hitItem.Node), e.Button, e.Clicks, e.X, e.Y));\n            }\n        }\n\n        protected override void OnMouseDoubleClick(MouseEventArgs e)\n        {\n            base.OnMouseDoubleClick(e);\n\n            Rectangle view = GetViewportBounds();\n            if (_state.HandlePointerDoubleClick(\n                    e.X,\n                    e.Y,\n                    e.Button == MouseButtons.Left,\n                    view.Left,\n                    view.Top,\n                    view.Height,\n                    _paddingLeft,\n                    _indentWidth,\n                    _glyphColumnWidth,\n                    _itemHeight))\n            {\n                RecalculateContentWidth();\n                Invalidate();\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        protected override void OnKeyDown(KeyEventArgs e)\n        {\n            base.OnKeyDown(e);\n            int rowCount = _state.VisibleRows.Count;\n            if (rowCount == 0)\n                return;\n\n            int currentRow = _state.GetCurrentOrFirstRowIndex();\n            int pageRows = Math.Max(1, GetViewportBounds().Height / _itemHeight);\n\n            switch (e.KeyCode)\n            {\n                case Keys.Down:\n                    if (currentRow \u003C rowCount - 1)\n                        SelectRowInternal(currentRow \u002B 1, TreeViewAction.ByKeyboard, ensureVisible: true);\n                    e.Handled = true;\n                    break;\n\n                case Keys.Up:\n                    if (currentRow \u003E 0)\n                        SelectRowInternal(currentRow - 1, TreeViewAction.ByKeyboard, ensureVisible: true);\n                    e.Handled = true;\n                    break;\n\n                case Keys.PageDown:\n                    SelectRowInternal(Math.Min(rowCount - 1, currentRow \u002B pageRows), TreeViewAction.ByKeyboard, ensureVisible: true);\n                    e.Handled = true;\n                    break;\n\n                case Keys.PageUp:\n                    SelectRowInternal(Math.Max(0, currentRow - pageRows), TreeViewAction.ByKeyboard, ensureVisible: true);\n                    e.Handled = true;\n                    break;\n\n                case Keys.Home:\n                    SelectRowInternal(0, TreeViewAction.ByKeyboard, ensureVisible: true);\n                    e.Handled = true;\n                    break;\n\n                case Keys.End:\n                    SelectRowInternal(rowCount - 1, TreeViewAction.ByKeyboard, ensureVisible: true);\n                    e.Handled = true;\n                    break;\n\n                case Keys.Right:\n                    _state.NavigateRight(out bool rightExpandedChanged, out int? rightNextRow);\n                    if (rightExpandedChanged)\n                    {\n                        RecalculateContentWidth();\n                        Invalidate();\n                    }\n                    else if (rightNextRow.HasValue)\n                    {\n                        SelectRowInternal(rightNextRow.Value, TreeViewAction.ByKeyboard, ensureVisible: true);\n                    }\n                    e.Handled = true;\n                    break;\n\n                case Keys.Left:\n                    _state.NavigateLeft(out bool leftExpandedChanged, out int? leftParentRow);\n                    if (leftExpandedChanged)\n                    {\n                        RecalculateContentWidth();\n                        Invalidate();\n                    }\n                    else if (leftParentRow.HasValue)\n                    {\n                        SelectRowInternal(leftParentRow.Value, TreeViewAction.ByKeyboard, ensureVisible: true);\n                    }\n                    e.Handled = true;\n                    break;\n            }\n        }\n\n        private void SelectRowInternal(int rowIndex, TreeViewAction action, bool ensureVisible)\n        {\n            if (!_state.SelectRow(rowIndex, out var item, out bool changed) || item == null)\n                return;\n\n            if (ensureVisible)\n            {\n                EnsureRowVisible(rowIndex, centerVertically: false);\n            }\n\n            Invalidate();\n\n            if (changed || action == TreeViewAction.ByMouse)\n            {\n                RaiseAfterSelect(item.Node, action);\n            }\n        }\n==== REPLACE\n        protected override void OnKeyDown(KeyEventArgs e)\n        {\n            base.OnKeyDown(e);\n\n            DomTreeNavigationKey? navKey = e.KeyCode switch\n            {\n                Keys.Up =\u003E DomTreeNavigationKey.Up,\n                Keys.Down =\u003E DomTreeNavigationKey.Down,\n                Keys.PageUp =\u003E DomTreeNavigationKey.PageUp,\n                Keys.PageDown =\u003E DomTreeNavigationKey.PageDown,\n                Keys.Home =\u003E DomTreeNavigationKey.Home,\n                Keys.End =\u003E DomTreeNavigationKey.End,\n                Keys.Left =\u003E DomTreeNavigationKey.Left,\n                Keys.Right =\u003E DomTreeNavigationKey.Right,\n                _ =\u003E null\n            };\n\n            if (!navKey.HasValue)\n                return;\n\n            Rectangle view = GetViewportBounds();\n            if (_state.NavigateByKey(\n                    navKey.Value,\n                    view.Width,\n                    view.Height,\n                    _itemHeight,\n                    _paddingLeft,\n                    _indentWidth,\n                    ScaleDpi(100),\n                    ScaleDpi(24),\n                    out var selectedItem,\n                    out bool expandedChanged,\n                    out bool selectionChanged,\n                    out bool scrollChanged))\n            {\n                if (expandedChanged)\n                {\n                    RecalculateContentWidth();\n                }\n                else if (scrollChanged)\n                {\n                    UpdateScrollBars();\n                }\n\n                Invalidate();\n\n                if (selectionChanged \u0026\u0026 selectedItem != null)\n                {\n                    RaiseAfterSelect(selectedItem.Node, TreeViewAction.ByKeyboard);\n                }\n\n                e.Handled = true;\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n            _runner = new AutomationRunner();\n            _runner.OnSequenceStarted \u002B= (s, e) =\u003E Log($\u0022[AUTO] {e.GetStartedLogMessage()}\u0022, Color.Magenta);\n            _runner.OnStepStarted \u002B= (s, e) =\u003E Log($\u0022[AUTO] {e.GetStartedLogMessage()}\u0022, Color.Plum);\n            _runner.OnStepCompleted \u002B= (s, e) =\u003E\n            {\n                if (e.Result != null)\n                {\n                    Log($\u0022[AUTO-RX] {e.GetCompletedLogMessage()}\u0022, Color.White);\n                }\n            };\n            _runner.OnScrapeCompleted \u002B= (s, e) =\u003E\n            {\n                if (e.Result != null)\n                {\n                    Invoke(new Action(() =\u003E DisplayScrapeResult(e.Result)));\n                }\n            };\n\n            _scraper = new DataScraper(_runner);\n            _scraper.OnScrapeStarted \u002B= (s, e) =\u003E Log($\u0022[SCRAPE] {e.GetStartedLogMessage()}\u0022, Color.SpringGreen);\n            _scraper.OnScrapePageCompleted \u002B= (s, e) =\u003E Log($\u0022[SCRAPE] {e.GetLogMessage()}\u0022, Color.LightGreen);\n            _scraper.OnPageTurnDelay \u002B= (s, e) =\u003E\n            {\n                string msg = e.GetStatusMessage();\n                Log($\u0022[SCRAPE] {msg}\u0022, Color.Khaki);\n                Invoke(new Action(() =\u003E lblScrapeStatus.Text = msg));\n            };\n            _scraper.OnRateLimitDetected \u002B= (s, e) =\u003E\n            {\n                Log($\u0022[RATE-LIMIT 429] {e.GetLogMessage()}\u0022, Color.Orange);\n                Invoke(new Action(() =\u003E\n                {\n                    if (!e.IsDateHeader \u0026\u0026 chkLstScrapes.SelectedItem == e.Definition)\n                    {\n                        _isUpdatingScrapeUi = true;\n                        try\n                        {\n                            numPageDelayMs.Value = Math.Clamp(e.NewPageDelayMs, (int)numPageDelayMs.Minimum, (int)numPageDelayMs.Maximum);\n                        }\n                        finally\n                        {\n                            _isUpdatingScrapeUi = false;\n                        }\n                    }\n                    lblScrapeStatus.Text = e.GetStatusMessage();\n                }));\n            };\n            _scraper.OnScrapeCompleted \u002B= (s, e) =\u003E\n            {\n                if (e.Result != null)\n                {\n                    Log($\u0022[SCRAPE] {e.GetCompletedLogMessage()}\u0022, Color.Lime);\n                    Invoke(new Action(() =\u003E DisplayScrapeResult(e.Result)));\n                }\n            };\n            _scraper.OnScrapeFailed \u002B= (s, e) =\u003E Log($\u0022[SCRAPE-ERR] {e.GetFailedLogMessage()}\u0022, Color.Red);\n\n            _siteDumper = new SiteDumper();\n==== REPLACE\n            _runner = new AutomationRunner();\n            _scraper = _runner.Scraper;\n            _siteDumper = _runner.SiteDumper;\n\n            _runner.OnSequenceStarted \u002B= (s, e) =\u003E Log($\u0022[AUTO] {e.GetStartedLogMessage()}\u0022, Color.Magenta);\n            _runner.OnStepStarted \u002B= (s, e) =\u003E Log($\u0022[AUTO] {e.GetStartedLogMessage()}\u0022, Color.Plum);\n            _runner.OnStepCompleted \u002B= (s, e) =\u003E\n            {\n                if (e.Result != null)\n                {\n                    Log($\u0022[AUTO-RX] {e.GetCompletedLogMessage()}\u0022, Color.White);\n                }\n            };\n\n            _scraper.OnScrapeStarted \u002B= (s, e) =\u003E Log($\u0022[SCRAPE] {e.GetStartedLogMessage()}\u0022, Color.SpringGreen);\n            _scraper.OnScrapePageCompleted \u002B= (s, e) =\u003E Log($\u0022[SCRAPE] {e.GetLogMessage()}\u0022, Color.LightGreen);\n            _scraper.OnPageTurnDelay \u002B= (s, e) =\u003E\n            {\n                string msg = e.GetStatusMessage();\n                Log($\u0022[SCRAPE] {msg}\u0022, Color.Khaki);\n                Invoke(new Action(() =\u003E lblScrapeStatus.Text = msg));\n            };\n            _scraper.OnRateLimitDetected \u002B= (s, e) =\u003E\n            {\n                Log($\u0022[RATE-LIMIT 429] {e.GetLogMessage()}\u0022, Color.Orange);\n                Invoke(new Action(() =\u003E\n                {\n                    if (!e.IsDateHeader \u0026\u0026 chkLstScrapes.SelectedItem == e.Definition)\n                    {\n                        _isUpdatingScrapeUi = true;\n                        try\n                        {\n                            numPageDelayMs.Value = Math.Clamp(e.NewPageDelayMs, (int)numPageDelayMs.Minimum, (int)numPageDelayMs.Maximum);\n                        }\n                        finally\n                        {\n                            _isUpdatingScrapeUi = false;\n                        }\n                    }\n                    lblScrapeStatus.Text = e.GetStatusMessage();\n                }));\n            };\n            _scraper.OnScrapeCompleted \u002B= (s, e) =\u003E\n            {\n                if (e.Result != null)\n                {\n                    Log($\u0022[SCRAPE] {e.GetCompletedLogMessage()}\u0022, Color.Lime);\n                    Invoke(new Action(() =\u003E DisplayScrapeResult(e.Result)));\n                }\n            };\n            _scraper.OnScrapeFailed \u002B= (s, e) =\u003E Log($\u0022[SCRAPE-ERR] {e.GetFailedLogMessage()}\u0022, Color.Red);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            _server.OnClientConnected \u002B= Server_OnClientConnected;\n            _server.OnClientDisconnected \u002B= Server_OnClientDisconnected;\n            _server.OnClientMetadataUpdated \u002B= Server_OnClientMetadataUpdated;\n            _server.OnActiveClientChanged \u002B= Server_OnActiveClientChanged;\n            _server.OnExtensionConnected \u002B= Server_OnExtensionConnected;\n            _server.OnExtensionDisconnected \u002B= Server_OnExtensionDisconnected;\n            _server.OnExtensionTabsUpdated \u002B= Server_OnExtensionTabsUpdated;\n==== REPLACE\n            _server.OnClientConnected \u002B= Server_OnClientConnected;\n            _server.OnClientDisconnected \u002B= Server_OnClientDisconnected;\n            _server.OnClientMetadataUpdated \u002B= Server_OnClientMetadataUpdated;\n            _server.OnActiveClientChanged \u002B= Server_OnActiveClientChanged;\n            _server.OnClientModeChanged \u002B= (s, c) =\u003E Log($\u0022[SYS] Client {c.InstanceId} switched IPC transport to {c.Mode}.\u0022, Color.Cyan);\n            _server.OnClientStreamDataReceived \u002B= (s, ev) =\u003E Log($\u0022[STREAM \u003C- {ev.Client.InstanceId}] {ev.Result.Output}\u0022, Color.MediumPurple);\n            _server.OnClientPageLoaded \u002B= (s, ev) =\u003E Log(ev.Args.GetLogMessage(ev.Client.InstanceId), ev.Args.IsRateLimited ? Color.Orange : Color.Aqua);\n            _server.OnActiveClientPageLoaded \u002B= Server_OnActiveClientPageLoaded;\n            _server.OnActiveClientDomChanged \u002B= Server_OnActiveClientDomChanged;\n            _server.OnActiveClientHighlightedElementRemoved \u002B= Server_OnActiveClientHighlightedElementRemoved;\n            _server.OnActiveClientElementClicked \u002B= Server_OnActiveClientElementClicked;\n            _server.OnExtensionConnected \u002B= Server_OnExtensionConnected;\n            _server.OnExtensionDisconnected \u002B= Server_OnExtensionDisconnected;\n            _server.OnExtensionTabsUpdated \u002B= Server_OnExtensionTabsUpdated;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void Server_OnClientConnected(object? sender, BrowserClient client)\n        {\n            Log($\u0022[SYS] Client Connected: {client.InstanceId} via {client.Mode}\u0022, Color.LimeGreen);\n\n            client.OnModeChanged \u002B= (s, newMode) =\u003E\n            {\n                Log($\u0022[SYS] Client {client.InstanceId} switched IPC transport to {newMode}.\u0022, Color.Cyan);\n            };\n            \n            client.OnStreamDataReceived \u002B= (s, res) =\u003E\n            {\n                Log($\u0022[STREAM \u003C- {client.InstanceId}] {res.Output}\u0022, Color.MediumPurple);\n            };\n\n            client.OnPageLoaded \u002B= (s, e) =\u003E\n            {\n                Log(e.GetLogMessage(client.InstanceId), e.IsRateLimited ? Color.Orange : Color.Aqua);\n                BeginInvoke(new Action(async () =\u003E\n                {\n                    RefreshClientListItemDisplay(client);\n                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)\n                    {\n                        await RefreshDomAsync(client);\n                    }\n                }));\n            };\n\n            client.OnDomChanged \u002B= (s, e) =\u003E\n            {\n                BeginInvoke(new Action(async () =\u003E\n                {\n                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)\n                    {\n                        await RefreshDomAsync(client, e.HighlightedPath, e.HasHighlightedPath);\n                    }\n                }));\n            };\n\n            client.OnHighlightedElementRemoved \u002B= (s, e) =\u003E\n            {\n                BeginInvoke(new Action(() =\u003E\n                {\n                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)\n                    {\n                        tvDom.ClearSelection();\n                        txtElementDetails.Text = string.Empty;\n                    }\n                }));\n            };\n\n            client.OnElementClicked \u002B= (s, e) =\u003E\n            {\n                BeginInvoke(new Action(async () =\u003E\n                {\n                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)\n                    {\n                        if (tvDom.SelectNodeByPath(e.Path, ensureVisible: true, raiseAfterSelect: false))\n                        {\n                            txtElementDetails.Text = tvDom.SelectedDomNode?.GetFormattedDetails() ?? string.Empty;\n                        }\n                        else\n                        {\n                            await RefreshDomAsync(client, e.Path, hasTargetPath: true);\n                        }\n                    }\n                }));\n            };\n\n            BeginInvoke(new Action(() =\u003E\n            {\n                UpsertClientInListUi(client);\n                if (_server?.ActiveClient != null \u0026\u0026 _server.ActiveClient.InstanceId == client.InstanceId)\n                {\n                    SyncActiveClientSelectionToUi(_server.ActiveClient);\n                }\n            }));\n        }\n==== REPLACE\n        private void Server_OnClientConnected(object? sender, BrowserClient client)\n        {\n            Log($\u0022[SYS] Client Connected: {client.InstanceId} via {client.Mode}\u0022, Color.LimeGreen);\n\n            BeginInvoke(new Action(() =\u003E\n            {\n                UpsertClientInListUi(client);\n                if (_server?.ActiveClient != null \u0026\u0026 _server.ActiveClient.InstanceId == client.InstanceId)\n                {\n                    SyncActiveClientSelectionToUi(_server.ActiveClient);\n                }\n            }));\n        }\n\n        private void Server_OnActiveClientPageLoaded(object? sender, PageLoadedEventArgs e)\n        {\n            if (sender is BrowserClient client)\n            {\n                BeginInvoke(new Action(async () =\u003E await RefreshDomAsync(client)));\n            }\n        }\n\n        private void Server_OnActiveClientDomChanged(object? sender, DomChangedEventArgs e)\n        {\n            if (sender is BrowserClient client)\n            {\n                BeginInvoke(new Action(async () =\u003E await RefreshDomAsync(client, e.HighlightedPath, e.HasHighlightedPath)));\n            }\n        }\n\n        private void Server_OnActiveClientHighlightedElementRemoved(object? sender, EventArgs e)\n        {\n            BeginInvoke(new Action(() =\u003E\n            {\n                tvDom.ClearSelection();\n                txtElementDetails.Text = string.Empty;\n            }));\n        }\n\n        private void Server_OnActiveClientElementClicked(object? sender, ElementClickedEventArgs e)\n        {\n            if (sender is BrowserClient client)\n            {\n                BeginInvoke(new Action(async () =\u003E\n                {\n                    if (tvDom.SelectNodeByPath(e.Path, ensureVisible: true, raiseAfterSelect: false))\n                    {\n                        txtElementDetails.Text = tvDom.SelectedDomNode?.GetFormattedDetails() ?? string.Empty;\n                    }\n                    else\n                    {\n                        await RefreshDomAsync(client, e.Path, hasTargetPath: true);\n                    }\n                }));\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)\n        {\n            if (e.Node?.Tag is DomNode domNode)\n            {\n                txtElementDetails.Text = domNode.GetFormattedDetails();\n\n                if (lstClients.SelectedItem is BrowserClient client)\n                {\n                    client.RecordUserDomSelection(domNode.Path);\n                    if (domNode.Type == \u0022element\u0022 \u0026\u0026 !string.IsNullOrEmpty(domNode.Path))\n                    {\n                        client.HighlightElementDebounced(domNode.Path);\n                    }\n                }\n            }\n        }\n\n        private void TvDom_NodeMouseClick(object? sender, TreeNodeMouseClickEventArgs e)\n        {\n            if (e.Button == MouseButtons.Right \u0026\u0026 e.Node?.Tag is DomNode domNode \u0026\u0026 domNode.Type == \u0022element\u0022)\n            {\n                ctxDomNode.Show(tvDom, e.Location);\n            }\n        }\n\n        private async void MnuClickElement_Click(object? sender, EventArgs e)\n        {\n            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n            {\n                Log($\u0022[SYS] Testing click on {domNode.Path}\u0022, Color.Cyan);\n                try\n                {\n                    var res = await client.ClickReactElementAsync(domNode.Path);\n                    Log($\u0022[RX] {res.Output}\u0022, Color.White);\n                }\n                catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }\n            }\n        }\n==== REPLACE\n        private void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)\n        {\n            if (e.Node?.Tag is DomNode domNode)\n            {\n                txtElementDetails.Text = domNode.GetFormattedDetails();\n                (lstClients.SelectedItem as BrowserClient)?.SelectDomNode(domNode);\n            }\n        }\n\n        private void TvDom_NodeMouseClick(object? sender, TreeNodeMouseClickEventArgs e)\n        {\n            if (e.Button == MouseButtons.Right \u0026\u0026 e.Node?.Tag is DomNode domNode \u0026\u0026 domNode.Type == \u0022element\u0022)\n            {\n                ctxDomNode.Show(tvDom, e.Location);\n            }\n        }\n\n        private async void MnuClickElement_Click(object? sender, EventArgs e)\n        {\n            if (tvDom.SelectedDomNode is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n            {\n                Log($\u0022[SYS] Testing click on {domNode.Path}\u0022, Color.Cyan);\n                try\n                {\n                    var res = await client.ClickReactElementAsync(domNode);\n                    Log($\u0022[RX] {res.Output}\u0022, Color.White);\n                }\n                catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private async void MnuSetValue_Click(object? sender, EventArgs e)\n        {\n            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n            {\n                string value = PromptForValue(\u0022Enter value to set:\u0022, \u0022Set Value\u0022);\n                if (string.IsNullOrEmpty(value)) return;\n\n                Log($\u0022[SYS] Testing set value on {domNode.Path}\u0022, Color.Cyan);\n                try\n                {\n                    var res = await client.SetReactInputValueAsync(domNode.Path, value);\n                    Log($\u0022[RX] {res.Output}\u0022, Color.White);\n                }\n                catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }\n            }\n        }\n==== REPLACE\n        private async void MnuSetValue_Click(object? sender, EventArgs e)\n        {\n            if (tvDom.SelectedDomNode is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n            {\n                string value = PromptForValue(\u0022Enter value to set:\u0022, \u0022Set Value\u0022);\n                if (string.IsNullOrEmpty(value)) return;\n\n                Log($\u0022[SYS] Testing set value on {domNode.Path}\u0022, Color.Cyan);\n                try\n                {\n                    var res = await client.SetReactInputValueAsync(domNode, value);\n                    Log($\u0022[RX] {res.Output}\u0022, Color.White);\n                }\n                catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            chkExclusiveTab.CheckedChanged \u002B= (s, e) =\u003E\n            {\n                if (_server != null)\n                {\n                    _server.ExclusiveTabMode = chkExclusiveTab.Checked;\n                }\n            };\n            chkExclusiveTab.CheckedChanged \u002B= (s, e) =\u003E\n            {\n                if (_server != null)\n                {\n                    _server.ExclusiveTabMode = chkExclusiveTab.Checked;\n                }\n            };\n==== REPLACE\n            chkExclusiveTab.CheckedChanged \u002B= (s, e) =\u003E\n            {\n                if (_server != null)\n                {\n                    _server.ExclusiveTabMode = chkExclusiveTab.Checked;\n                }\n            };\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private async Task SwitchToBrowserTabAsync(BrowserTabInfo tab, bool focusBrowserTab)\n        {\n            if (_server == null)\n            {\n                Log(\u0022[WARN] Start the Automation Server first.\u0022, Color.Orange);\n                return;\n            }\n\n            if (!tab.CanInject)\n            {\n                Log($\u0022[WARN] Tab #{tab.TabId} (\u0027{tab.Url}\u0027) is a restricted internal browser page and cannot be injected.\u0022, Color.Orange);\n                return;\n            }\n\n            var mode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;\n            bool detachOthers = chkExclusiveTab.Checked;\n\n            Log($\u0022[EXT] Injecting \u0026 switching to Tab #{tab.TabId}: {tab.Title} ({tab.Url})\u0022, Color.SpringGreen);\n\n            try\n            {\n                var existingClient = await _server.SwitchToExtensionTabAsync(tab, focusBrowserTab, detachOthers, mode);\n                if (existingClient != null \u0026\u0026 lstClients.SelectedItem == existingClient)\n                {\n                    _ = RefreshDomAsync(existingClient);\n                }\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to switch to tab #{tab.TabId}: {ex.Message}\u0022, Color.Red);\n            }\n        }\n==== REPLACE\n        private async Task SwitchToBrowserTabAsync(BrowserTabInfo tab, bool focusBrowserTab)\n        {\n            if (_server == null)\n            {\n                Log(\u0022[WARN] Start the Automation Server first.\u0022, Color.Orange);\n                return;\n            }\n\n            var mode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;\n            bool detachOthers = chkExclusiveTab.Checked;\n\n            Log($\u0022[EXT] Injecting \u0026 switching to Tab #{tab.TabId}: {tab.Title} ({tab.Url})\u0022, Color.SpringGreen);\n\n            try\n            {\n                var existingClient = await _server.SwitchToExtensionTabAsync(tab, focusBrowserTab, detachOthers, mode);\n                if (existingClient != null \u0026\u0026 lstClients.SelectedItem == existingClient)\n                {\n                    _ = RefreshDomAsync(existingClient);\n                }\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to switch to tab #{tab.TabId}: {ex.Message}\u0022, Color.Red);\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private async void MnuQuickScrapeText_Click(object? sender, EventArgs e)\n        {\n            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n            {\n                var extType = domNode.GetSuggestedExtractionType();\n                Log($\u0022[SCRAPE] Testing extraction ({extType}) on {domNode.Path}...\u0022, Color.SpringGreen);\n                try\n                {\n                    string? val = await client.ScrapeElementAsync(domNode.Path, extType);\n                    Log($\u0022[SCRAPE-RX] Extracted Value: {val}\u0022, Color.White);\n                }\n                catch (Exception ex)\n                {\n                    Log($\u0022[ERR] Quick scrape failed: {ex.Message}\u0022, Color.Red);\n                }\n            }\n        }\n==== REPLACE\n        private async void MnuQuickScrapeText_Click(object? sender, EventArgs e)\n        {\n            if (tvDom.SelectedDomNode is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n            {\n                var extType = domNode.GetSuggestedExtractionType();\n                Log($\u0022[SCRAPE] Testing extraction ({extType}) on {domNode.Path}...\u0022, Color.SpringGreen);\n                try\n                {\n                    string? val = await client.ScrapeElementAsync(domNode, extType);\n                    Log($\u0022[SCRAPE-RX] Extracted Value: {val}\u0022, Color.White);\n                }\n                catch (Exception ex)\n                {\n                    Log($\u0022[ERR] Quick scrape failed: {ex.Message}\u0022, Color.Red);\n                }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\nAnti-Agent v1.0\n\n### Summary of Changes\n\n1. **DOM Tree Rendering \u0026 Interaction Logic (\u0060BrowserAutomationFramework\\Models\\DomTreeSnapshot.cs\u0060 \u0026 \u0060TestBedApp\\Controls\\DomTreeView.cs\u0060)**:\n   - Added theme color constants to \u0060DomTokenColorExtensions\u0060, along with \u0060DomTreeNavigationKey\u0060, \u0060DomTokenRenderSlice\u0060, and \u0060DomRowRenderLayout\u0060.\n   - Added \u0060UpdateFontMetrics\u0060, \u0060CalculateRowRenderLayout\u0060, \u0060TryGetAncestorGuideLineX\u0060, \u0060EnumerateVisibleTokens\u0060, \u0060HandlePointerDown\u0060, \u0060HandlePointerDoubleClick\u0060, and \u0060NavigateByKey\u0060 to \u0060DomTreeViewportState\u0060.\n   - Updated \u0060DomTreeView\u0060 in \u0060TestBedApp\u0060 to delegate all row layout math, token viewport culling, hit-testing, double-click expansion, and keyboard navigation to \u0060DomTreeViewportState\u0060.\n\n2. **Unified Runner / Scraper / Dumper Pipeline (\u0060BrowserAutomationFramework\\Automation\\AutomationRunner.cs\u0060 \u0026 \u0060BrowserAutomationFramework\\Scraping\\DataScraper.cs\u0060)**:\n   - Added shared \u0060Scraper\u0060 (\u0060DataScraper\u0060) and \u0060SiteDumper\u0060 (\u0060SiteDumper\u0060) properties to \u0060AutomationRunner\u0060 and \u0060Runner\u0060 to \u0060DataScraper\u0060 so automation steps and direct scrapes/dumps share the same engine instances and lifecycle events.\n\n3. **DOM Node Selection \u0026 Action Overloads (\u0060BrowserAutomationFramework\\Server\\BrowserClient.cs\u0060 \u0026 \u0060BrowserAutomationFramework\\Extensions\\ReactExtensions.cs\u0060)**:\n   - Added \u0060BrowserClient.SelectDomNode\u0060 to record user DOM selection and trigger debounced element highlighting for element nodes.\n   - Added \u0060DomNode\u0060 overloads to \u0060ReactExtensions\u0060 for \u0060ClickReactElementAsync\u0060, \u0060SetReactInputValueAsync\u0060, and \u0060ScrapeElementAsync\u0060.\n\n4. **Server-Level Client \u0026 Active-Client Event Forwarding (\u0060BrowserAutomationFramework\\Server\\AutomationServer.cs\u0060 \u0026 \u0060TestBedApp\\MainForm.cs\u0060)**:\n   - Added \u0060OnClientModeChanged\u0060, \u0060OnClientStreamDataReceived\u0060, \u0060OnClientPageLoaded\u0060, \u0060OnActiveClientPageLoaded\u0060, \u0060OnActiveClientDomChanged\u0060, \u0060OnActiveClientHighlightedElementRemoved\u0060, and \u0060OnActiveClientElementClicked\u0060 to \u0060AutomationServer\u0060.\n   - Updated \u0060MainForm\u0060 to consume the new \u0060AutomationServer\u0060, \u0060AutomationRunner\u0060, \u0060BrowserClient\u0060, and \u0060ReactExtensions\u0060 APIs, and removed duplicate event wiring and redundant tab injection checks.\n\n### How to Test\n\n1. Build the solution (\u0060dotnet build\u0060) and verify both \u0060BrowserAutomationFramework\u0060 and \u0060TestBedApp\u0060 compile with zero warnings or errors.\n2. Run \u0060TestBedApp\u0060, start the server, connect a browser tab, and verify DOM Explorer rendering, node expansion/collapse, keyboard navigation, middle-click selection, context menu test actions, data scraping, and reverse-engineering dumps.\n\n--CODESTART--\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\DomTreeSnapshot.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH    /// \u003Csummary\u003E    /// Provides default dark-theme RGB syntax highlighting colors for \u003Csee cref=\u0022DomTokenColor\u0022/\u003E values.    /// \u003C/summary\u003E    public static class DomTokenColorExtensions    {        /// \u003Csummary\u003E        /// Returns the default dark-mode RGB color tuple \u003Cc\u003E(R, G, B)\u003C/c\u003E for the specified \u003Csee cref=\u0022DomTokenColor\u0022/\u003E.        /// \u003C/summary\u003E        public static (byte R, byte G, byte B) GetDefaultRgb(this DomTokenColor tokenColor)        {            return tokenColor switch            {                DomTokenColor.TagName =\u003E (86, 156, 214),                DomTokenColor.AttributeName =\u003E (156, 220, 254),                DomTokenColor.AttributeValue =\u003E (206, 145, 120),                DomTokenColor.TextContent =\u003E (212, 212, 212),                _ =\u003E (128, 128, 128)            };        }    }==== REPLACE    /// \u003Csummary\u003E    /// Provides default dark-theme RGB syntax highlighting and tree chrome colors for \u003Csee cref=\u0022DomTokenColor\u0022/\u003E values and DOM tree views.    /// \u003C/summary\u003E    public static class DomTokenColorExtensions    {        /// \u003Csummary\u003E        /// Gets the default dark-mode RGB color tuple for selected tree rows.        /// \u003C/summary\u003E        public static (byte R, byte G, byte B) SelectionBackgroundRgb =\u003E (9, 71, 113);        /// \u003Csummary\u003E        /// Gets the default dark-mode RGB color tuple for hovered tree rows.        /// \u003C/summary\u003E        public static (byte R, byte G, byte B) HoverBackgroundRgb =\u003E (40, 42, 46);        /// \u003Csummary\u003E        /// Gets the default dark-mode RGB color tuple for the tree control border.        /// \u003C/summary\u003E        public static (byte R, byte G, byte B) BorderRgb =\u003E (63, 63, 70);        /// \u003Csummary\u003E        /// Gets the default dark-mode RGB color tuple for expand/collapse glyph box backgrounds.        /// \u003C/summary\u003E        public static (byte R, byte G, byte B) GlyphFillRgb =\u003E (37, 37, 38);        /// \u003Csummary\u003E        /// Gets the default dark-mode RGB color tuple for hierarchy guide lines.        /// \u003C/summary\u003E        public static (byte R, byte G, byte B) GuideLineRgb =\u003E (58, 58, 62);        /// \u003Csummary\u003E        /// Gets the default dark-mode RGB color tuple for expand/collapse glyph box borders.        /// \u003C/summary\u003E        public static (byte R, byte G, byte B) GlyphBorderRgb =\u003E (130, 130, 135);        /// \u003Csummary\u003E        /// Gets the default dark-mode RGB color tuple for expand/collapse plus/minus sign lines.        /// \u003C/summary\u003E        public static (byte R, byte G, byte B) GlyphSignRgb =\u003E DomTokenColor.TextContent.GetDefaultRgb();        /// \u003Csummary\u003E        /// Returns the default dark-mode RGB color tuple \u003Cc\u003E(R, G, B)\u003C/c\u003E for the specified \u003Csee cref=\u0022DomTokenColor\u0022/\u003E.        /// \u003C/summary\u003E        public static (byte R, byte G, byte B) GetDefaultRgb(this DomTokenColor tokenColor)        {            return tokenColor switch            {                DomTokenColor.TagName =\u003E (86, 156, 214),                DomTokenColor.AttributeName =\u003E (156, 220, 254),                DomTokenColor.AttributeValue =\u003E (206, 145, 120),                DomTokenColor.TextContent =\u003E (212, 212, 212),                _ =\u003E (128, 128, 128)            };        }    }    /// \u003Csummary\u003E    /// Specifies a platform-independent keyboard navigation command for a \u003Csee cref=\u0022DomTreeViewportState\u0022/\u003E.    /// \u003C/summary\u003E    public enum DomTreeNavigationKey    {        /// \u003Csummary\u003E        /// Moves selection one row up.        /// \u003C/summary\u003E        Up,        /// \u003Csummary\u003E        /// Moves selection one row down.        /// \u003C/summary\u003E        Down,        /// \u003Csummary\u003E        /// Moves selection one viewport page up.        /// \u003C/summary\u003E        PageUp,        /// \u003Csummary\u003E        /// Moves selection one viewport page down.        /// \u003C/summary\u003E        PageDown,        /// \u003Csummary\u003E        /// Moves selection to the first visible row.        /// \u003C/summary\u003E        Home,        /// \u003Csummary\u003E        /// Moves selection to the last visible row.        /// \u003C/summary\u003E        End,        /// \u003Csummary\u003E        /// Collapses an expanded node or moves selection to the parent node.        /// \u003C/summary\u003E        Left,        /// \u003Csummary\u003E        /// Expands a collapsed parent node or moves selection to its first child.        /// \u003C/summary\u003E        Right    }    /// \u003Csummary\u003E    /// Represents a horizontally culled, positioned syntax token ready to be drawn by a UI renderer.    /// \u003C/summary\u003E    public readonly struct DomTokenRenderSlice    {        ///