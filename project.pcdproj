                       curX \u002B= w;\n                            if (curX \u003E view.Right)\n                                break;\n                        }\n\n                        if (item.HasChildren \u0026\u0026 !isExpanded \u0026\u0026 curX \u003C= view.Right)\n                        {\n                            var suffixParts = item.CollapsedSuffixParts;\n                            var suffixWidths = measure.CollapsedSuffixWidths;\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        private async void BtnStart_Click(object sender, EventArgs e)\n        {\n            int port = (int)numPort.Value;\n            var selectedMode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;\n\n            try\n            {\n                string defaultExtDir = ChromeExtensionGenerator.GetDefaultExtensionDirectory();\n                ChromeExtensionGenerator.ExportToDirectory(defaultExtDir, port, selectedMode);\n                Log($\u0022[EXT] Synced Chrome Extension files (Port {port}) at: {defaultExtDir}\u0022, Color.MediumSpringGreen);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[WARN] Could not auto-sync default ChromeExtension folder: {ex.Message}\u0022, Color.Orange);\n            }\n\n            _server = new AutomationServer(port);\n==== REPLACE\n        private async void BtnStart_Click(object sender, EventArgs e)\n        {\n            int port = (int)numPort.Value;\n            var selectedMode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;\n\n            _server = new AutomationServer(port);\n            try\n            {\n                string defaultExtDir = _server.SyncDefaultChromeExtension(selectedMode);\n                Log($\u0022[EXT] Synced Chrome Extension files (Port {port}) at: {defaultExtDir}\u0022, Color.MediumSpringGreen);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[WARN] Could not auto-sync default ChromeExtension folder: {ex.Message}\u0022, Color.Orange);\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                    // Fetch, deserialize, and index the entire DOM tree on a background thread with timeout protection\n                    using var fetchTimeoutCts = new CancellationTokenSource(TimeSpan.FromSeconds(10));\n                    var token = fetchTimeoutCts.Token;\n\n                    TestBedApp.Controls.DomTreeSnapshot? snapshot = null;\n                    try\n                    {\n                        snapshot = await Task.Run(async () =\u003E\n                        {\n                            var rootNode = await currentClient.GetDomNodeAsync(token).ConfigureAwait(false);\n                            return rootNode != null ? TestBedApp.Controls.DomTreeSnapshot.Build(rootNode) : null;\n                        }, token);\n                    }\n                    catch (OperationCanceledException)\n                    {\n                        snapshot = null;\n                    }\n==== REPLACE\n                    // Fetch, deserialize, and index the entire DOM tree on a background thread with timeout protection\n                    using var fetchTimeoutCts = new CancellationTokenSource(TimeSpan.FromSeconds(10));\n                    var token = fetchTimeoutCts.Token;\n\n                    DomTreeSnapshot? snapshot = null;\n                    try\n                    {\n                        snapshot = await currentClient.GetDomSnapshotAsync(token);\n                    }\n                    catch (OperationCanceledException)\n                    {\n                        snapshot = null;\n                    }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void AddStepToSequence(AutomationSequence seq, AutomationActionType actionType)\n        {\n            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path))\n            {\n                var step = domNode.CreateStep(actionType);\n                seq.Steps.Add(step);\n                \n                if (chkLstSequences.SelectedItem == seq)\n                {\n                    lstSteps.Items.Add(step);\n                    lstSteps.SelectedItem = step;\n                }\n                \n                tabMain.SelectedTab = tabEditor;\n                Log($\u0022[SYS] Added step to list \u0027{seq.Name}\u0027\u0022, Color.Cyan);\n            }\n        }\n==== REPLACE\n        private void AddStepToSequence(AutomationSequence seq, AutomationActionType actionType)\n        {\n            if (tvDom.SelectedDomNode is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path))\n            {\n                var step = seq.AddStepFromDomNode(domNode, actionType);\n                \n                if (chkLstSequences.SelectedItem == seq)\n                {\n                    lstSteps.Items.Add(step);\n                    lstSteps.SelectedItem = step;\n                }\n                \n                tabMain.SelectedTab = tabEditor;\n                Log($\u0022[SYS] Added step to list \u0027{seq.Name}\u0027\u0022, Color.Cyan);\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                foreach (var tab in _latestExtensionTabs)\n                {\n                    if (!string.IsNullOrEmpty(filter))\n                    {\n                        bool matches = tab.Title.Contains(filter, StringComparison.OrdinalIgnoreCase) ||\n                                       tab.Url.Contains(filter, StringComparison.OrdinalIgnoreCase) ||\n                                       tab.TabId.ToString().Contains(filter, StringComparison.OrdinalIgnoreCase);\n                        if (!matches)\n                            continue;\n                    }\n\n                    lstBrowserTabs.Items.Add(tab);\n==== REPLACE\n                foreach (var tab in _latestExtensionTabs)\n                {\n                    if (!tab.MatchesFilter(filter))\n                        continue;\n\n                    lstBrowserTabs.Items.Add(tab);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            var existingClient = lstClients.Items.Cast\u003CBrowserClient\u003E().FirstOrDefault(c =\u003E c.TabId == tab.TabId || c.InstanceId == tab.InstanceId);\n==== REPLACE\n            var existingClient = _server.GetClientForTab(tab) ?? lstClients.Items.Cast\u003CBrowserClient\u003E().FirstOrDefault(c =\u003E c.TabId == tab.TabId || c.InstanceId == tab.InstanceId);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnGeneralizeContainer_Click(object? sender, EventArgs e)\n        {\n            if (!string.IsNullOrWhiteSpace(txtContainerSelector.Text))\n            {\n                DomNode? rootDom = tvDom.RootDomNode;\n                string generalized = SelectorHelper.GeneralizeContainerSelector(txtContainerSelector.Text, rootDom);\n                txtContainerSelector.Text = generalized;\n                if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)\n                {\n                    scrape.SetContainerAndRelativizeFields(generalized);\n                    pgScrapeFieldDetails.Refresh();\n                }\n            }\n        }\n\n        private async void BtnHighlightContainer_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);\n                return;\n            }\n\n            string selector = txtContainerSelector.Text.Trim();\n            if (string.IsNullOrWhiteSpace(selector))\n            {\n                Log(\u0022[WARN] Container selector is empty.\u0022, Color.Orange);\n                return;\n            }\n\n            try\n            {\n                int count = await client.HighlightElementsAsync(selector, null, true);\n                Log($\u0022[SCRAPE] Highlighted {count} container element(s) matching \u0027{selector}\u0027.\u0022, Color.SpringGreen);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to highlight container: {ex.Message}\u0022, Color.Red);\n            }\n        }\n==== REPLACE\n        private void BtnGeneralizeContainer_Click(object? sender, EventArgs e)\n        {\n            if (!string.IsNullOrWhiteSpace(txtContainerSelector.Text))\n            {\n                DomNode? rootDom = tvDom.RootDomNode;\n                if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)\n                {\n                    txtContainerSelector.Text = scrape.GeneralizeAndSetContainer(txtContainerSelector.Text, rootDom);\n                    pgScrapeFieldDetails.Refresh();\n                }\n                else\n                {\n                    txtContainerSelector.Text = SelectorHelper.GeneralizeContainerSelector(txtContainerSelector.Text, rootDom);\n                }\n            }\n        }\n\n        private async void BtnHighlightContainer_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);\n                return;\n            }\n\n            string selector = txtContainerSelector.Text.Trim();\n            if (string.IsNullOrWhiteSpace(selector))\n            {\n                Log(\u0022[WARN] Container selector is empty.\u0022, Color.Orange);\n                return;\n            }\n\n            try\n            {\n                int count = chkLstScrapes.SelectedItem is ScrapeDefinition scrape\n                    ? await client.HighlightScrapeContainerAsync(scrape)\n                    : await client.HighlightElementsAsync(selector, null, true);\n                Log($\u0022[SCRAPE] Highlighted {count} container element(s) matching \u0027{selector}\u0027.\u0022, Color.SpringGreen);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to highlight container: {ex.Message}\u0022, Color.Red);\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnGeneralizeScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (lstScrapeFields.SelectedItem is ScrapeField field \u0026\u0026 !string.IsNullOrWhiteSpace(field.Selector))\n            {\n                DomNode? rootDom = tvDom.RootDomNode;\n                field.Selector = SelectorHelper.GeneralizeRepeatingFieldSelector(field.Selector, rootDom);\n                field.MatchAllElements = true;\n                pgScrapeFieldDetails.Refresh();\n                RefreshSelectedFieldItemText();\n            }\n        }\n\n        private async void BtnHighlightScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);\n                return;\n            }\n\n            if (lstScrapeFields.SelectedItem is not ScrapeField field || string.IsNullOrWhiteSpace(field.Selector))\n            {\n                Log(\u0022[WARN] Please select a field with a valid selector first.\u0022, Color.Orange);\n                return;\n            }\n\n            string? containerSelector = (chkLstScrapes.SelectedItem as ScrapeDefinition)?.ContainerSelector;\n            try\n            {\n                int count = await client.HighlightElementsAsync(\n                    field.Selector,\n                    containerSelector,\n                    field.MatchAllElements || !string.IsNullOrWhiteSpace(containerSelector));\n                Log($\u0022[SCRAPE] Highlighted {count} element(s) for field \u0027{field.Name}\u0027.\u0022, Color.SpringGreen);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Highlight failed: {ex.Message}\u0022, Color.Red);\n            }\n        }\n==== REPLACE\n        private void BtnGeneralizeScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (lstScrapeFields.SelectedItem is ScrapeField field \u0026\u0026 !string.IsNullOrWhiteSpace(field.Selector))\n            {\n                field.GeneralizeSelector(tvDom.RootDomNode);\n                pgScrapeFieldDetails.Refresh();\n                RefreshSelectedFieldItemText();\n            }\n        }\n\n        private async void BtnHighlightScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);\n                return;\n            }\n\n            if (lstScrapeFields.SelectedItem is not ScrapeField field || string.IsNullOrWhiteSpace(field.Selector))\n            {\n                Log(\u0022[WARN] Please select a field with a valid selector first.\u0022, Color.Orange);\n                return;\n            }\n\n            var parentScrape = chkLstScrapes.SelectedItem as ScrapeDefinition;\n            try\n            {\n                int count = await client.HighlightScrapeFieldAsync(field, parentScrape);\n                Log($\u0022[SCRAPE] Highlighted {count} element(s) for field \u0027{field.Name}\u0027.\u0022, Color.SpringGreen);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Highlight failed: {ex.Message}\u0022, Color.Red);\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void AddFieldFromSelectedDomNode(ScrapeDefinition scrape, bool matchAllElements)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            DomNode? rootDom = tvDom.RootDomNode;\n            var suggestedType = domNode.GetSuggestedExtractionType();\n            string baseName = domNode.GetSuggestedFieldName(suggestedType);\n            string uniqueName = scrape.GetUniqueFieldName(baseName);\n\n            var field = domNode.CreateScrapeField(\n                fieldName: uniqueName,\n                extractionType: suggestedType,\n                containerSelector: scrape.ContainerSelector,\n                matchAllElements: matchAllElements,\n                rootDom: rootDom);\n\n            scrape.Fields.Add(field);\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                lstScrapeFields.Items.Add(field);\n                lstScrapeFields.SelectedItem = field;\n            }\n\n            Log($\u0022[SCRAPE] Added field \u0027{field.Name}\u0027 ({field.ExtractionType}) to \u0027{scrape.Name}\u0027.\u0022, Color.SpringGreen);\n        }\n\n        private void SetContainerFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            DomNode? rootDom = tvDom.RootDomNode;\n            string generalizedContainer = domNode.GetGeneralizedPath(rootDom);\n            scrape.SetContainerAndRelativizeFields(generalizedContainer);\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                LoadSelectedScrapeToUi();\n            }\n\n            Log($\u0022[SCRAPE] Set repeating container for \u0027{scrape.Name}\u0027 to: {generalizedContainer}\u0022, Color.SpringGreen);\n        }\n\n        private void SetPaginationNextFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            DomNode? rootDom = tvDom.RootDomNode;\n            string selector = domNode.GetBestInteractiveSelector(rootDom);\n\n            scrape.EnablePagination = true;\n            scrape.NextPageSelector = selector;\n            if (scrape.MaxPages \u003C 2) scrape.MaxPages = 3;\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                LoadSelectedScrapeToUi();\n            }\n\n            Log($\u0022[SCRAPE] Set pagination Next button for \u0027{scrape.Name}\u0027 to: {domNode.Path}\u0022, Color.SpringGreen);\n        }\n==== REPLACE\n        private void AddFieldFromSelectedDomNode(ScrapeDefinition scrape, bool matchAllElements)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            var field = scrape.AddFieldFromDomNode(domNode, matchAllElements, tvDom.RootDomNode);\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                lstScrapeFields.Items.Add(field);\n                lstScrapeFields.SelectedItem = field;\n            }\n\n            Log($\u0022[SCRAPE] Added field \u0027{field.Name}\u0027 ({field.ExtractionType}) to \u0027{scrape.Name}\u0027.\u0022, Color.SpringGreen);\n        }\n\n        private void SetContainerFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            string generalizedContainer = scrape.SetContainerFromDomNode(domNode, tvDom.RootDomNode);\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                LoadSelectedScrapeToUi();\n            }\n\n            Log($\u0022[SCRAPE] Set repeating container for \u0027{scrape.Name}\u0027 to: {generalizedContainer}\u0022, Color.SpringGreen);\n        }\n\n        private void SetPaginationNextFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            string selector = scrape.SetPaginationNextFromDomNode(domNode, tvDom.RootDomNode);\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                LoadSelectedScrapeToUi();\n            }\n\n            Log($\u0022[SCRAPE] Set pagination Next button for \u0027{scrape.Name}\u0027 to: {selector}\u0022, Color.SpringGreen);\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            btnRunAllScrapes.Enabled = false;\n            try\n            {\n                var results = await _scraper.RunProjectScrapesAsync(client, project);\n                if (results.Count \u003E 0)\n                {\n                    var combined = new ScrapeResult\n                    {\n                        ScrapeName = results.Count == 1 ? results[0].ScrapeName : \u0022Combined Active Scrapes\u0022,\n                        PagesScraped = results.Sum(r =\u003E r.PagesScraped)\n                    };\n                    foreach (var r in results)\n                    {\n                        combined.Merge(r);\n                    }\n                    DisplayScrapeResult(combined);\n                }\n            }\n==== REPLACE\n            btnRunAllScrapes.Enabled = false;\n            try\n            {\n                var combined = await _scraper.RunProjectScrapesCombinedAsync(client, project);\n                DisplayScrapeResult(combined);\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                string filter = txtFilterResources.Text.Trim();\n                var allResources = _lastSiteDumpResult.GetAllResources();\n\n                foreach (var res in allResources)\n                {\n                    if (!string.IsNullOrEmpty(filter))\n                    {\n                        bool matches = res.Name.Contains(filter, StringComparison.OrdinalIgnoreCase) ||\n                                       res.Url.Contains(filter, StringComparison.OrdinalIgnoreCase) ||\n                                       res.SourceType.Contains(filter, StringComparison.OrdinalIgnoreCase) ||\n                                       res.Category.ToString().Contains(filter, StringComparison.OrdinalIgnoreCase) ||\n                                       (!string.IsNullOrEmpty(res.Content) \u0026\u0026 res.Content.Contains(filter, StringComparison.OrdinalIgnoreCase));\n                        if (!matches)\n                            continue;\n                    }\n\n                    lstDumpedResources.Items.Add(res);\n                }\n==== REPLACE\n                string filter = txtFilterResources.Text.Trim();\n                foreach (var res in _lastSiteDumpResult.FilterResources(filter))\n                {\n                    lstDumpedResources.Items.Add(res);\n                }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\nAnti-Agent v1.0\n\n### Summary of Changes\n\n1. **Migrated DOM Snapshot, Indexing \u0026 Syntax Tokenization to \u0060BrowserAutomationFramework\u0060**:\n   - Created \u0060Models/DomTreeSnapshot.cs\u0060 containing \u0060DomTreeSnapshot\u0060, \u0060DomTreeItem\u0060, \u0060DomDisplayPart\u0060, and \u0060DomTokenColor\u0060. Any consumer or UI framework can now build an O(1) path-indexed, pre-tokenized DOM snapshot via \u0060await client.GetDomSnapshotAsync()\u0060 or \u0060domNode.CreateSnapshot()\u0060.\n   - Updated \u0060TestBedApp/Controls/DomTreeView.cs\u0060 to be a pure WinForms virtualized renderer over \u0060BrowserAutomationFramework.Models.DomTreeSnapshot\u0060.\n\n2. **Migrated Authoring, Filtering \u0026 Aggregation Logic from \u0060TestBedApp\u0060 to \u0060BrowserAutomationFramework\u0060**:\n   - **\u0060ScrapeDefinition\u0060 \u0026 \u0060ScrapeField\u0060**: Added \u0060AddFieldFromDomNode\u0060, \u0060SetContainerFromDomNode\u0060, \u0060GeneralizeAndSetContainer\u0060, \u0060SetPaginationNextFromDomNode\u0060, and \u0060ScrapeField.GeneralizeSelector\u0060.\n   - **\u0060AutomationSequence\u0060 \u0026 \u0060AutomationProject\u0060**: Added \u0060AutomationSequence.AddStepFromDomNode\u0060 and project-level helpers (\u0060GetActiveSequences\u0060, \u0060GetActiveScrapes\u0060, \u0060GetSequenceNames\u0060, \u0060MoveSequenceUp\u0060/\u0060Down\u0060, \u0060MoveScrapeUp\u0060/\u0060Down\u0060).\n   - **\u0060ScrapeResult\u0060 \u0026 \u0060DataScraper\u0060**: Added \u0060ScrapeResult.Combine\u0060 and \u0060DataScraper.RunProjectScrapesCombinedAsync\u0060 (plus \u0060client.ExecuteProjectScrapesCombinedAsync\u0060).\n   - **\u0060BrowserTabInfo\u0060, \u0060SiteResourceItem\u0060 \u0026 \u0060SiteDumpResult\u0060**: Added \u0060BrowserTabInfo.MatchesFilter\u0060, \u0060SiteResourceItem.MatchesFilter\u0060, and \u0060SiteDumpResult.FilterResources\u0060.\n   - **\u0060AutomationServer\u0060 \u0026 \u0060ReactExtensions\u0060**: Added \u0060AutomationServer.Port\u0060, \u0060SyncDefaultChromeExtension\u0060, \u0060GetExtensionTabs(filter)\u0060, \u0060GetClientForTab\u0060, \u0060client.HighlightScrapeFieldAsync\u0060, and \u0060client.HighlightScrapeContainerAsync\u0060.\n   - **\u0060BrowserAutomationFramework.csproj\u0060**: Enabled \u0060\u003CGenerateDocumentationFile\u003Etrue\u003C/GenerateDocumentationFile\u003E\u0060 and added XML documentation across the framework models and services.\n   - **\u0060TestBedApp/MainForm.cs\u0060**: Replaced inline business logic with calls to the \u0060BrowserAutomationFramework\u0060 API.\n\n### How to Test\n\n1. Build the solution (\u0060dotnet build\u0060) and verify both \u0060BrowserAutomationFramework\u0060 (including its generated XML documentation) and \u0060TestBedApp\u0060 compile cleanly.\n2. Run \u0060TestBedApp\u0060, start the server, connect via the Chrome Extension or Tampermonkey, and verify DOM Explorer rendering, right-click DOM-to-Scraper/Automation actions, container/field generalization and highlighting, and Reverse Engineering resource filtering.\n\n--CODESTART--\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\BrowserAutomationFramework.csproj**\n\n\u0060\u0060\u0060\ncsproj\u003C\u003C\u003C\u003C SEARCH  \u003CPropertyGroup\u003E    \u003CTargetFramework\u003Enet10.0\u003C/TargetFramework\u003E    \u003CImplicitUsings\u003Eenable\u003C/ImplicitUsings\u003E    \u003CNullable\u003Eenable\u003C/Nullable\u003E  \u003C/PropertyGroup\u003E==== REPLACE  \u003CPropertyGroup\u003E    \u003CTargetFramework\u003Enet10.0\u003C/TargetFramework\u003E    \u003CImplicitUsings\u003Eenable\u003C/ImplicitUsings\u003E    \u003CNullable\u003Eenable\u003C/Nullable\u003E    \u003CGenerateDocumentationFile\u003Etrue\u003C/GenerateDocumentationFile\u003E    \u003CNoWarn\u003E$(NoWarn);1591\u003C/NoWarn\u003E  \u003C/PropertyGroup\u003E\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\DomTreeSnapshot.cs**\n\n\u0060\u0060\u0060\ncsusing System;using System.Collections.Generic;using System.Text;namespace BrowserAutomationFramework.Models{    /// \u003Csummary\u003E    /// Classifies syntax tokens for rendering a \u003Csee cref=\u0022DomNode\u0022/\u003E in a developer tools tree view.    /// \u003C/summary\u003E    public enum DomTokenColor : byte    {        Punctuation,        TagName,        AttributeName,        AttributeValue,        TextContent    }    /// \u003Csummary\u003E    /// Represents a single syntax-highlighted text segment of a serialized \u003Csee cref=\u0022DomNode\u0022/\u003E line.    /// \u003C/summary\u003E    public readonly struct DomDisplayPart    {        public readonly string Text;        public readonly DomTokenColor ColorType;        public DomDisplayPart(string text, DomTokenColor colorType)        {            Text = text;            ColorType = colorType;        }    }    /// \u003Csummary\u003E    /// Represents an indexed, pre-tokenized node entry inside a \u003Csee cref=\u0022DomTreeSnapshot\u0022/\u003E.    /// \u003C/summary\u003E    public sealed class DomTreeItem    {        public DomNode Node { get; }        public string UniqueKey { get; }        public string? ParentKey { get; }        public int Depth { get; }        public List\u003CDomTreeItem\u003E Children { get; } = new();        public bool HasChildren =\u003E Children.Count \u003E 0;        public DomDisplayPart[] OpenParts { get; }        public DomDisplayPart[] CollapsedSuffixParts { get; }        public int EstimatedCharLength { get; }        public DomTreeItem(            DomNode node,            string uniqueKey,            string? parentKey,            int depth,            DomDisplayPart[] openParts,            DomDisplayPart[] collapsedSuffixParts,            int estimatedCharLength)        {            Node = node;            UniqueKey = uniqueKey;            ParentKey = parentKey;            Depth = depth;            OpenParts = openParts;            CollapsedSuffixParts = collapsedSuffixParts;            EstimatedCharLength = estimatedCharLength;        }    }    /// \u003Csummary\u003E    /// Thread-safe, pre-indexed DOM tree snapshot built from a \u003Csee cref=\u0022DomNode\u0022/\u003E hierarchy.    /// Provides O(1) lookup by CSS path, ancestor expansion helpers, and pre-tokenized syntax highlighting parts.    /// \u003C/summary\u003E    public sealed class DomTreeSnapshot    {        private const int MaxAttrValueDisplayLength = 180;        private const int MaxTextDisplayLength = 220;        private const int MaxAttributesDisplayed = 24;        public DomNode RootNode { get; }        public DomTreeItem RootItem { get; }        public Dictionary\u003Cstring, DomTreeItem\u003E ItemsByKey { get; }        private DomTreeSnapshot(DomNode rootNode, DomTreeItem rootItem, Dictionary\u003Cstring, DomTreeItem\u003E itemsByKey)        {            RootNode = rootNode;            RootItem = rootItem;            ItemsByKey = itemsByKey;        }        /// \u003Csummary\u003E        /// Indexes and tokenizes a \u003Csee cref=\u0022DomNode\u0022/\u003E hierarchy into a \u003Csee cref=\u0022DomTreeSnapshot\u0022/\u003E.        /// Safe to call on a background worker thread.        /// \u003C/summary\u003E        public static DomTreeSnapshot Build(DomNode rootNode)        {            if (rootNode == null) throw new ArgumentNullException(nameof(rootNode));            var itemsByKey = new Dictionary\u003Cstring, DomTreeItem\u003E(4096, StringComparer.Ordinal);            var rootItem = BuildItemRecursive(rootNode, null, 0, 0, itemsByKey);            return new DomTreeSnapshot(rootNode, rootItem, itemsByKey);        }        /// \u003Csummary\u003E        /// Attempts to find a \u003Csee cref=\u0022DomTreeItem\u0022/\u003E by its unique CSS path key in O(1) time.        /// \u003C/summary\u003E        public DomTreeItem? FindItemByPath(string? path)        {            if (string.IsNullOrEmpty(path)) return null;            return ItemsByKey.TryGetValue(path, out var item) ? item : null;        }        /// \u003Csummary\u003E        /// Attempts to find a \u003Csee cref=\u0022DomNode\u0022/\u003E by its CSS path in O(1) time using the snapshot index.        /// \u003C/summary\u003E        public DomNode? FindNodeByPath(string? path)        {            return FindItemByPath(path)?.Node;        }        /// \u003Csummary\u003E        /// Expands all ancestor keys of \u003Cparamref name=\u0022targetItem\u0022/\u003E into \u003Cparamref name=\u0022expandedKeys\u0022/\u003E.        /// Returns \u003Cc\u003Etrue\u003C/c\u003E if any new ancestor key was added.        /// \u003C/summary\u003E        public bool ExpandAncestors(DomTreeItem targetItem, HashSet\u003Cstring\u003E expandedKeys)        {            if (targetItem == null) throw new ArgumentNullException(nameof(targetItem));            if (expandedKeys == null) throw new ArgumentNullException(nameof(expandedKeys));            bool addedAny = false;            string? parentKey = targetItem.ParentKey;            while (!string.IsNullOrEmpty(parentKey))            {                if (expandedKeys.Add(parentKey))                    addedAny = true;                if (ItemsByKey.TryGetValue(parentKey, out var parentItem))                    parentKey = parentItem.ParentKey;                else                    break;            }            return addedAny;        }        /// \u003Csummary\u003E        /// Builds the flat list of currently visible \u003Csee cref=\u0022DomTreeItem\u0022/\u003E rows based on the set of expanded node keys.        /// \u003C/summary\u003E        public List\u003CDomTreeItem\u003E BuildVisibleRows(HashSet\u003Cstring\u003E expandedKeys)        {            return BuildVisibleRows(RootItem, expandedKeys);        }        /// \u003Csummary\u003E        /// Builds the flat list of currently visible \u003Csee cref=\u0022DomTreeItem\u0022/\u003E rows starting from \u003Cparamref name=\u0022rootItem\u0022/\u003E.        /// \u003C/summary\u003E        public static List\u003CDomTreeItem\u003E BuildVisibleRows(DomTreeItem rootItem, HashSet\u003Cstring\u003E expandedKeys)        {            var list = new List\u003CDomTreeItem\u003E(Math.Max(64, (expandedKeys?.Count ?? 1) * 8));            if (rootItem != null \u0026\u0026 expandedKeys != null)            {                AppendVisibleRecursive(rootItem, expandedKeys, list);            }            return list;        }        private static void AppendVisibleRecursive(DomTreeItem item, HashSet\u003Cstring\u003E expandedKeys, List\u003CDomTreeItem\u003E output)        {            output.Add(item);            if (item.HasChildren \u0026\u0026 expandedKeys.Contains(item.UniqueKey))            {                var children = item.Children;                for (int i = 0; i \u003C children.Count; i\u002B\u002B)                {                    AppendVisibleRecursive(children[i], expandedKeys, output);                }            }        }        private static DomTreeItem BuildItemRecursive(            DomNode node,            string? parentKey,            int depth,            int siblingIndex,            Dictionary\u003Cstring, DomTreeItem\u003E itemsByKey)        {            string uniqueKey = !string.IsNullOrEmpty(node.Path)                ? node.Path!                : $\u0022{parentKey ?? \u0022root\u0022}#text_{siblingIndex}\u0022;            BuildDisplayParts(node, out var openParts, out var suffixParts, out int charLen);            var item = new DomTreeItem(node, uniqueKey, parentKey, depth, openParts, suffixParts, charLen);            itemsByKey[uniqueKey] = item;            if (node.Children != null \u0026\u0026 node.Children.Count \u003E 0)            {                for (int i = 0; i \u003C node.Children.Count; i\u002B\u002B)                {                    var childItem = BuildItemRecursive(node.Children[i], uniqueKey, depth \u002B 1, i, itemsByKey);                    item.Children.Add(childItem);                }            }            return item;        }        private static void BuildDisplayParts(            DomNode domNode,            out DomDisplayPart[] openParts,            out DomDisplayPart[] collapsedSuffixParts,            out int estimatedCharLen)        {            estimatedCharLen = 0;            if (domNode.Type == \u0022element\u0022)            {                string tag = domNode.TagName ?? \u0022element\u0022;                int attrCount = domNode.Attributes?.Count ?? 0;                var parts = new List\u003CDomDisplayPart\u003E(3 \u002B (Math.Min(attrCount, MaxAttributesDisplayed) * 3));                parts.Add(new DomDisplayPart(\u0022\u003C\u0022, DomTokenColor.Punctuation));                parts.Add(new DomDisplayPart(tag, DomTokenColor.TagName));                estimatedCharLen \u002B= 1 \u002B tag.Length;                if (domNode.Attributes != null \u0026\u0026 attrCount \u003E 0)                {                    int processed = 0;                    foreach (var attr in domNode.Attributes)                    {                        if (processed \u003E= MaxAttributesDisplayed)                        {                            parts.Add(new DomDisplayPart(\u0022 ...\u0022, DomTokenColor.Punctuation));                            estimatedCharLen \u002B= 4;                            break;                        }                        string cleanVal = SanitizeSingleLine(attr.Value, MaxAttrValueDisplayLength);                        string quotedVal = $\u0022\\\u0022{cleanVal}\\\u0022\u0022;                        parts.Add(new DomDisplayPart($\u0022 {attr.Key}\u0022, DomTokenColor.AttributeName));                        parts.Add(new DomDisplayPart(\u0022=\u0022, DomTokenColor.Punctuation));                        parts.Add(new DomDisplayPart(quotedVal, DomTokenColor.AttributeValue));                        estimatedCharLen \u002B= 1 \u002B attr.Key.Length \u002B 1 \u002B quotedVal.Length;                        processed\u002B\u002B;                    }                }                parts.Add(new DomDisplayPart(\u0022\u003E\u0022, DomTokenColor.Punctuation));                estimatedCharLen \u002B= 1;                openParts = parts.ToArray();                if (domNode.Children != null \u0026\u0026 domNode.Children.Count \u003E 0)                {                    collapsedSuffixParts = new[]                    {                        new DomDisplayPart(\u0022...\u003C/\u0022, DomTokenColor.Punctuation),                        new DomDisplayPart(tag, DomTokenColor.TagName),                        new DomDisplayPart(\u0022\u003E\u0022, DomTokenColor.Punctuation)                    };                    estimatedCharLen \u002B= 6 \u002B tag.Length;                }                else                {                    collapsedSuffixParts = Array.Empty\u003CDomDisplayPart\u003E();                }            }            else            {                string cleanText = SanitizeSingleLine(domNode.Text ?? string.Empty, MaxTextDisplayLength);                string display = $\u0022\\\u0022{cleanText}\\\u0022\u0022;                openParts = new[] { new DomDisplayPart(display, DomTokenColor.TextContent) };                collapsedSuffixParts = Array.Empty\u003CDomDisplayPart\u003E();                estimatedCharLen = display.Length;            }        }        private static string SanitizeSingleLine(string raw, int maxLen)        {            if (string.IsNullOrEmpty(raw))                return string.Empty;            int limit = Math.Min(raw.Length, maxLen);            var sb = new StringBuilder(limit \u002B 3);            bool lastWasSpace = false;            for (int i = 0; i \u003C raw.Length; i\u002B\u002B)            {                char c = raw[i];                if (c == \u0027\\r\u0027 || c == \u0027\\n\u0027 || c == \u0027\\t\u0027)                {                    if (!lastWasSpace)                    {                        sb.Append(\u0027 \u0027);                        lastWasSpace = true;                    }                }                else                {                    sb.Append(c);                    lastWasSpace = c == \u0027 \u0027;                }                if (sb.Length \u003E= maxLen)                {                    if (i \u003C 