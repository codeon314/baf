ion scrape)\n                {\n                    txtContainerSelector.Text = scrape.GeneralizeAndSetContainer(txtContainerSelector.Text, rootDom);\n                    pgScrapeFieldDetails.Refresh();\n                }\n                else\n                {\n                    txtContainerSelector.Text = SelectorHelper.GeneralizeContainerSelector(txtContainerSelector.Text, rootDom);\n                }\n            }\n        }\n==== REPLACE\n        private DomNode? GetCurrentRootDomNode() =\u003E\n            (lstClients.SelectedItem as BrowserClient)?.CurrentDomRoot ?? tvDom.RootDomNode;\n\n        private void BtnGeneralizeContainer_Click(object? sender, EventArgs e)\n        {\n            if (!string.IsNullOrWhiteSpace(txtContainerSelector.Text))\n            {\n                DomNode? rootDom = GetCurrentRootDomNode();\n                if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)\n                {\n                    txtContainerSelector.Text = scrape.GeneralizeAndSetContainer(txtContainerSelector.Text, rootDom);\n                    pgScrapeFieldDetails.Refresh();\n                }\n                else\n                {\n                    txtContainerSelector.Text = SelectorHelper.GeneralizeContainerSelector(txtContainerSelector.Text, rootDom);\n                }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnGeneralizeScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (lstScrapeFields.SelectedItem is ScrapeField field \u0026\u0026 !string.IsNullOrWhiteSpace(field.Selector))\n            {\n                field.GeneralizeSelector(tvDom.RootDomNode);\n                pgScrapeFieldDetails.Refresh();\n                RefreshSelectedFieldItemText();\n            }\n        }\n==== REPLACE\n        private void BtnGeneralizeScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (lstScrapeFields.SelectedItem is ScrapeField field \u0026\u0026 !string.IsNullOrWhiteSpace(field.Selector))\n            {\n                field.GeneralizeSelector(GetCurrentRootDomNode());\n                pgScrapeFieldDetails.Refresh();\n                RefreshSelectedFieldItemText();\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void AddFieldFromSelectedDomNode(ScrapeDefinition scrape, bool matchAllElements)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            var field = scrape.AddFieldFromDomNode(domNode, matchAllElements, tvDom.RootDomNode);\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                lstScrapeFields.Items.Add(field);\n                lstScrapeFields.SelectedItem = field;\n            }\n\n            Log($\u0022[SCRAPE] Added field \u0027{field.Name}\u0027 ({field.ExtractionType}) to \u0027{scrape.Name}\u0027.\u0022, Color.SpringGreen);\n        }\n\n        private void SetContainerFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            string generalizedContainer = scrape.SetContainerFromDomNode(domNode, tvDom.RootDomNode);\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                LoadSelectedScrapeToUi();\n            }\n\n            Log($\u0022[SCRAPE] Set repeating container for \u0027{scrape.Name}\u0027 to: {generalizedContainer}\u0022, Color.SpringGreen);\n        }\n\n        private void SetPaginationNextFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            string selector = scrape.SetPaginationNextFromDomNode(domNode, tvDom.RootDomNode);\n==== REPLACE\n        private void AddFieldFromSelectedDomNode(ScrapeDefinition scrape, bool matchAllElements)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            var field = scrape.AddFieldFromDomNode(domNode, matchAllElements, GetCurrentRootDomNode());\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                lstScrapeFields.Items.Add(field);\n                lstScrapeFields.SelectedItem = field;\n            }\n\n            Log($\u0022[SCRAPE] Added field \u0027{field.Name}\u0027 ({field.ExtractionType}) to \u0027{scrape.Name}\u0027.\u0022, Color.SpringGreen);\n        }\n\n        private void SetContainerFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            string generalizedContainer = scrape.SetContainerFromDomNode(domNode, GetCurrentRootDomNode());\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                LoadSelectedScrapeToUi();\n            }\n\n            Log($\u0022[SCRAPE] Set repeating container for \u0027{scrape.Name}\u0027 to: {generalizedContainer}\u0022, Color.SpringGreen);\n        }\n\n        private void SetPaginationNextFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            string selector = scrape.SetPaginationNextFromDomNode(domNode, GetCurrentRootDomNode());\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnSaveActiveDumpFile_Click(object? sender, EventArgs e)\n        {\n            if (_lastSiteDumpResult == null)\n            {\n                Log(\u0022[WARN] Please run a dump operation first.\u0022, Color.Orange);\n                return;\n            }\n\n            if (tabDumpViewers.SelectedTab == tabSelectedResourceView \u0026\u0026 lstDumpedResources.SelectedItem is SiteResourceItem selectedResource)\n            {\n                using var sfdResource = new SaveFileDialog\n                {\n                    Filter = \u0022All Files (*.*)|*.*|HTML Files (*.html)|*.html|CSS Files (*.css)|*.css|JavaScript Files (*.js)|*.js\u0022,\n                    Title = \u0022Save Selected Resource\u0022,\n                    FileName = selectedResource.Name\n                };\n\n                if (sfdResource.ShowDialog() == DialogResult.OK)\n                {\n                    try\n                    {\n                        selectedResource.SaveToFile(sfdResource.FileName);\n                        Log($\u0022[REV-ENG] Saved resource \u0027{selectedResource.Name}\u0027 to {sfdResource.FileName}\u0022, Color.Lime);\n                    }\n                    catch (Exception ex)\n                    {\n                        Log($\u0022[ERR] Failed to save resource: {ex.Message}\u0022, Color.Red);\n                    }\n                }\n                return;\n            }\n\n            string content = GetActiveDumpViewerText(out string defaultFileName);\n            if (string.IsNullOrEmpty(content))\n            {\n                Log(\u0022[WARN] Active dump view is empty.\u0022, Color.Orange);\n                return;\n            }\n\n            using var sfd = new SaveFileDialog\n            {\n                Filter = \u0022All Files (*.*)|*.*|HTML Files (*.html)|*.html|CSS Files (*.css)|*.css|JavaScript Files (*.js)|*.js\u0022,\n                Title = \u0022Save Combined Dump Output\u0022,\n                FileName = defaultFileName\n            };\n\n            if (sfd.ShowDialog() == DialogResult.OK)\n            {\n                try\n                {\n                    _lastSiteDumpResult.SaveCombinedToFile(sfd.FileName, GetSelectedCombinedViewerDumpType());\n                    Log($\u0022[REV-ENG] Saved \u0027{defaultFileName}\u0027 to {sfd.FileName}\u0022, Color.Lime);\n                }\n                catch (Exception ex)\n                {\n                    Log($\u0022[ERR] Failed to save file: {ex.Message}\u0022, Color.Red);\n                }\n            }\n        }\n==== REPLACE\n        private void BtnSaveActiveDumpFile_Click(object? sender, EventArgs e)\n        {\n            if (_lastSiteDumpResult == null)\n            {\n                Log(\u0022[WARN] Please run a dump operation first.\u0022, Color.Orange);\n                return;\n            }\n\n            var selectedResource = tabDumpViewers.SelectedTab == tabSelectedResourceView\n                ? lstDumpedResources.SelectedItem as SiteResourceItem\n                : null;\n            var viewType = GetSelectedCombinedViewerDumpType();\n            string content = _lastSiteDumpResult.GetViewContent(viewType, selectedResource, out string defaultFileName);\n\n            if (selectedResource == null \u0026\u0026 string.IsNullOrEmpty(content))\n            {\n                Log(\u0022[WARN] Active dump view is empty.\u0022, Color.Orange);\n                return;\n            }\n\n            using var sfd = new SaveFileDialog\n            {\n                Filter = \u0022All Files (*.*)|*.*|HTML Files (*.html)|*.html|CSS Files (*.css)|*.css|JavaScript Files (*.js)|*.js\u0022,\n                Title = selectedResource != null ? \u0022Save Selected Resource\u0022 : \u0022Save Combined Dump Output\u0022,\n                FileName = defaultFileName\n            };\n\n            if (sfd.ShowDialog() == DialogResult.OK)\n            {\n                try\n                {\n                    _lastSiteDumpResult.SaveViewContentToFile(sfd.FileName, viewType, selectedResource);\n                    Log($\u0022[REV-ENG] Saved \u0027{defaultFileName}\u0027 to {sfd.FileName}\u0022, Color.Lime);\n                }\n                catch (Exception ex)\n                {\n                    Log($\u0022[ERR] Failed to save file: {ex.Message}\u0022, Color.Red);\n                }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
      "ModelExplanation": "### Summary of Changes\n\n- **DOM Snapshot Caching on \u0060BrowserClient\u0060 (\u0060BrowserClient.cs\u0060, \u0060ReactExtensions.cs\u0060, \u0060MainForm.cs\u0060)**:\n\n- Added \u0060CurrentDomSnapshot\u0060 (\u0060DomTreeSnapshot?\u0060) and \u0060CurrentDomRoot\u0060 (\u0060DomNode?\u0060) properties to \u0060BrowserClient\u0060 and updated \u0060GetDomNodeAsync\u0060, \u0060GetDomSnapshotAsync\u0060, and \u0060RefreshDomSnapshotCoalescedAsync\u0060 to cache the latest DOM tree on the client instance.\n- Updated \u0060MainForm\u0060 selector generalization and point-and-click scrape helpers to resolve the root DOM from the active \u0060BrowserClient.CurrentDomRoot\u0060 (with fallback to \u0060tvDom.RootDomNode\u0060).\n- **Chrome Extension Tab Switch Overload \u0026 Setup Instructions (\u0060AutomationServer.cs\u0060, \u0060ChromeExtensionGenerator.cs\u0060, \u0060MainForm.cs\u0060)**:\n\n- Added \u0060AutomationServer.SwitchToExtensionTabAsync(BrowserTabInfo tab, ...)\u0060 to encapsulate \u0060CanInject\u0060 validation, existing \u0060BrowserClient\u0060 resolution, and tab attachment.\n- Added \u0060ChromeExtensionGenerator.GetLoadInstructions(string exportedDirectoryPath)\u0060 and updated \u0060MainForm.BtnExportExtension_Click\u0060 to use it.\n- **Unified View Saving \u0026 Event Formatting Helpers (\u0060SiteDumpResult.cs\u0060, \u0060BrowserEventArgs.cs\u0060, \u0060MainForm.cs\u0060)**:\n\n- Added \u0060SaveViewContentToFile\u0060 and \u0060SaveViewContentToFileAsync\u0060 to \u0060SiteDumpResult\u0060 and simplified \u0060MainForm.BtnSaveActiveDumpFile_Click\u0060.\n- Added log and status formatting methods (\u0060GetLogMessage\u0060, \u0060GetStatusMessage\u0060, \u0060GetStartedLogMessage\u0060, \u0060GetCompletedLogMessage\u0060, \u0060GetFailedLogMessage\u0060) to \u0060PageLoadedEventArgs\u0060, \u0060AutomationSequenceEventArgs\u0060, \u0060AutomationStepEventArgs\u0060, \u0060ScrapePageEventArgs\u0060, \u0060ScrapeEventArgs\u0060, and \u0060SiteDumpEventArgs\u0060.\n- **Virtualized Viewport \u0026 Hit-Testing Math (\u0060DomTreeSnapshot.cs\u0060, \u0060DomTreeView.cs\u0060)**:\n\n- Migrated row Y-coordinate hit-testing (\u0060GetRowIndexAtY\u0060), expand/collapse glyph hit-testing (\u0060IsPointOnExpandGlyph\u0060), scroll offset clamping (\u0060CalculateScrollOffsetsForRow\u0060), and row width calculations (\u0060GetMeasuredRowTextWidth\u0060, \u0060CalculateFullRowWidth\u0060) from \u0060DomTreeView\u0060 into \u0060DomTreeViewportState\u0060.\n\n### How to Test\n\n- Build the solution (\u0060dotnet build\u0060) and verify both \u0060BrowserAutomationFramework\u0060 and \u0060TestBedApp\u0060 compile cleanly with zero warnings or errors.\n- Launch \u0060TestBedApp\u0060, start the server, and attach to a browser tab via the Chrome Extension or Tampermonkey script.\n- Inspect the DOM in the **DOM Explorer** tab (expanding/collapsing nodes, keyboard navigation, and middle-clicking elements in the browser).\n- Test generalizing selectors in the **Data Scraper** tab and saving active resource/combined views in the **Reverse Engineering** tab.",
