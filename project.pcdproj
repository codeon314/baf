 {client.InstanceId} switched IPC transport to {newMode}.\u0022, Color.Cyan);            };                        client.OnStreamDataReceived \u002B= (s, res) =\u003E            {                Log($\u0022[STREAM \u003C- {client.InstanceId}] {res.Output}\u0022, Color.MediumPurple);            };            client.OnPageLoaded \u002B= (s, e) =\u003E            {                Log(e.GetLogMessage(client.InstanceId), e.IsRateLimited ? Color.Orange : Color.Aqua);                BeginInvoke(new Action(async () =\u003E                {                    RefreshClientListItemDisplay(client);                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)                    {                        await RefreshDomAsync(client);                    }                }));            };            client.OnDomChanged \u002B= (s, e) =\u003E            {                BeginInvoke(new Action(async () =\u003E                {                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)                    {                        await RefreshDomAsync(client, e.HighlightedPath, e.HasHighlightedPath);                    }                }));            };            client.OnHighlightedElementRemoved \u002B= (s, e) =\u003E            {                BeginInvoke(new Action(() =\u003E                {                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)                    {                        tvDom.ClearSelection();                        txtElementDetails.Text = string.Empty;                    }                }));            };            client.OnElementClicked \u002B= (s, e) =\u003E            {                BeginInvoke(new Action(async () =\u003E                {                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)                    {                        if (tvDom.SelectNodeByPath(e.Path, ensureVisible: true, raiseAfterSelect: false))                        {                            txtElementDetails.Text = tvDom.SelectedDomNode?.GetFormattedDetails() ?? string.Empty;                        }                        else                        {                            await RefreshDomAsync(client, e.Path, hasTargetPath: true);                        }                    }                }));            };            BeginInvoke(new Action(() =\u003E            {                UpsertClientInListUi(client);                if (_server?.ActiveClient != null \u0026\u0026 _server.ActiveClient.InstanceId == client.InstanceId)                {                    SyncActiveClientSelectionToUi(_server.ActiveClient);                }            }));        }==== REPLACE        private void Server_OnClientConnected(object? sender, BrowserClient client)        {            Log($\u0022[SYS] Client Connected: {client.InstanceId} via {client.Mode}\u0022, Color.LimeGreen);            BeginInvoke(new Action(() =\u003E            {                UpsertClientInListUi(client);                if (_server?.ActiveClient != null \u0026\u0026 _server.ActiveClient.InstanceId == client.InstanceId)                {                    SyncActiveClientSelectionToUi(_server.ActiveClient);                }            }));        }        private void Server_OnActiveClientPageLoaded(object? sender, PageLoadedEventArgs e)        {            if (sender is BrowserClient client)            {                BeginInvoke(new Action(async () =\u003E await RefreshDomAsync(client)));            }        }        private void Server_OnActiveClientDomChanged(object? sender, DomChangedEventArgs e)        {            if (sender is BrowserClient client)            {                BeginInvoke(new Action(async () =\u003E await RefreshDomAsync(client, e.HighlightedPath, e.HasHighlightedPath)));            }        }        private void Server_OnActiveClientHighlightedElementRemoved(object? sender, EventArgs e)        {            BeginInvoke(new Action(() =\u003E            {                tvDom.ClearSelection();                txtElementDetails.Text = string.Empty;            }));        }        private void Server_OnActiveClientElementClicked(object? sender, ElementClickedEventArgs e)        {            if (sender is BrowserClient client)            {                BeginInvoke(new Action(async () =\u003E                {                    if (tvDom.SelectNodeByPath(e.Path, ensureVisible: true, raiseAfterSelect: false))                    {                        txtElementDetails.Text = tvDom.SelectedDomNode?.GetFormattedDetails() ?? string.Empty;                    }                    else                    {                        await RefreshDomAsync(client, e.Path, hasTargetPath: true);                    }                }));            }        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)        {            if (e.Node?.Tag is DomNode domNode)            {                txtElementDetails.Text = domNode.GetFormattedDetails();                if (lstClients.SelectedItem is BrowserClient client)                {                    client.RecordUserDomSelection(domNode.Path);                    if (domNode.Type == \u0022element\u0022 \u0026\u0026 !string.IsNullOrEmpty(domNode.Path))                    {                        client.HighlightElementDebounced(domNode.Path);                    }                }            }        }        private void TvDom_NodeMouseClick(object? sender, TreeNodeMouseClickEventArgs e)        {            if (e.Button == MouseButtons.Right \u0026\u0026 e.Node?.Tag is DomNode domNode \u0026\u0026 domNode.Type == \u0022element\u0022)            {                ctxDomNode.Show(tvDom, e.Location);            }        }        private async void MnuClickElement_Click(object? sender, EventArgs e)        {            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)            {                Log($\u0022[SYS] Testing click on {domNode.Path}\u0022, Color.Cyan);                try                {                    var res = await client.ClickReactElementAsync(domNode.Path);                    Log($\u0022[RX] {res.Output}\u0022, Color.White);                }                catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }            }        }==== REPLACE        private void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)        {            if (e.Node?.Tag is DomNode domNode)            {                txtElementDetails.Text = domNode.GetFormattedDetails();                (lstClients.SelectedItem as BrowserClient)?.SelectDomNode(domNode);            }        }        private void TvDom_NodeMouseClick(object? sender, TreeNodeMouseClickEventArgs e)        {            if (e.Button == MouseButtons.Right \u0026\u0026 e.Node?.Tag is DomNode domNode \u0026\u0026 domNode.Type == \u0022element\u0022)            {                ctxDomNode.Show(tvDom, e.Location);            }        }        private async void MnuClickElement_Click(object? sender, EventArgs e)        {            if (tvDom.SelectedDomNode is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)            {                Log($\u0022[SYS] Testing click on {domNode.Path}\u0022, Color.Cyan);                try                {                    var res = await client.ClickReactElementAsync(domNode);                    Log($\u0022[RX] {res.Output}\u0022, Color.White);                }                catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }            }        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private async void MnuSetValue_Click(object? sender, EventArgs e)        {            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)            {                string value = PromptForValue(\u0022Enter value to set:\u0022, \u0022Set Value\u0022);                if (string.IsNullOrEmpty(value)) return;                Log($\u0022[SYS] Testing set value on {domNode.Path}\u0022, Color.Cyan);                try                {                    var res = await client.SetReactInputValueAsync(domNode.Path, value);                    Log($\u0022[RX] {res.Output}\u0022, Color.White);                }                catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }            }        }==== REPLACE        private async void MnuSetValue_Click(object? sender, EventArgs e)        {            if (tvDom.SelectedDomNode is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)            {                string value = PromptForValue(\u0022Enter value to set:\u0022, \u0022Set Value\u0022);                if (string.IsNullOrEmpty(value)) return;                Log($\u0022[SYS] Testing set value on {domNode.Path}\u0022, Color.Cyan);                try                {                    var res = await client.SetReactInputValueAsync(domNode, value);                    Log($\u0022[RX] {res.Output}\u0022, Color.White);                }                catch (Exception ex) { Log($\u0022[ERR] {ex.Message}\u0022, Color.Red); }            }        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH            chkExclusiveTab.CheckedChanged \u002B= (s, e) =\u003E            {                if (_server != null)                {                    _server.ExclusiveTabMode = chkExclusiveTab.Checked;                }            };            chkExclusiveTab.CheckedChanged \u002B= (s, e) =\u003E            {                if (_server != null)                {                    _server.ExclusiveTabMode = chkExclusiveTab.Checked;                }            };==== REPLACE            chkExclusiveTab.CheckedChanged \u002B= (s, e) =\u003E            {                if (_server != null)                {                    _server.ExclusiveTabMode = chkExclusiveTab.Checked;                }            };\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private async Task SwitchToBrowserTabAsync(BrowserTabInfo tab, bool focusBrowserTab)        {            if (_server == null)            {                Log(\u0022[WARN] Start the Automation Server first.\u0022, Color.Orange);                return;            }            if (!tab.CanInject)            {                Log($\u0022[WARN] Tab #{tab.TabId} (\u0027{tab.Url}\u0027) is a restricted internal browser page and cannot be injected.\u0022, Color.Orange);                return;            }            var mode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;            bool detachOthers = chkExclusiveTab.Checked;            Log($\u0022[EXT] Injecting \u0026 switching to Tab #{tab.TabId}: {tab.Title} ({tab.Url})\u0022, Color.SpringGreen);            try            {                var existingClient = await _server.SwitchToExtensionTabAsync(tab, focusBrowserTab, detachOthers, mode);                if (existingClient != null \u0026\u0026 lstClients.SelectedItem == existingClient)                {                    _ = RefreshDomAsync(existingClient);                }            }            catch (Exception ex)            {                Log($\u0022[ERR] Failed to switch to tab #{tab.TabId}: {ex.Message}\u0022, Color.Red);            }        }==== REPLACE        private async Task SwitchToBrowserTabAsync(BrowserTabInfo tab, bool focusBrowserTab)        {            if (_server == null)            {                Log(\u0022[WARN] Start the Automation Server first.\u0022, Color.Orange);                return;            }            var mode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;            bool detachOthers = chkExclusiveTab.Checked;            Log($\u0022[EXT] Injecting \u0026 switching to Tab #{tab.TabId}: {tab.Title} ({tab.Url})\u0022, Color.SpringGreen);            try            {                var existingClient = await _server.SwitchToExtensionTabAsync(tab, focusBrowserTab, detachOthers, mode);                if (existingClient != null \u0026\u0026 lstClients.SelectedItem == existingClient)                {                    _ = RefreshDomAsync(existingClient);                }            }            catch (Exception ex)            {                Log($\u0022[ERR] Failed to switch to tab #{tab.TabId}: {ex.Message}\u0022, Color.Red);            }        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private async void MnuQuickScrapeText_Click(object? sender, EventArgs e)        {            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)            {                var extType = domNode.GetSuggestedExtractionType();                Log($\u0022[SCRAPE] Testing extraction ({extType}) on {domNode.Path}...\u0022, Color.SpringGreen);                try                {                    string? val = await client.ScrapeElementAsync(domNode.Path, extType);                    Log($\u0022[SCRAPE-RX] Extracted Value: {val}\u0022, Color.White);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Quick scrape failed: {ex.Message}\u0022, Color.Red);                }            }        }==== REPLACE        private async void MnuQuickScrapeText_Click(object? sender, EventArgs e)        {            if (tvDom.SelectedDomNode is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)            {                var extType = domNode.GetSuggestedExtractionType();                Log($\u0022[SCRAPE] Testing extraction ({extType}) on {domNode.Path}...\u0022, Color.SpringGreen);                try                {                    string? val = await client.ScrapeElementAsync(domNode, extType);                    Log($\u0022[SCRAPE-RX] Extracted Value: {val}\u0022, Color.White);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Quick scrape failed: {ex.Message}\u0022, Color.Red);                }            }        }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
      "ModelExplanation": "### Summary of Changes\n\n- **DOM Tree Rendering \u0026 Interaction Logic (\u0060BrowserAutomationFramework\\Models\\DomTreeSnapshot.cs\u0060 \u0026 \u0060TestBedApp\\Controls\\DomTreeView.cs\u0060)**:\n\n- Added theme color constants to \u0060DomTokenColorExtensions\u0060, along with \u0060DomTreeNavigationKey\u0060, \u0060DomTokenRenderSlice\u0060, and \u0060DomRowRenderLayout\u0060.\n- Added \u0060UpdateFontMetrics\u0060, \u0060CalculateRowRenderLayout\u0060, \u0060TryGetAncestorGuideLineX\u0060, \u0060EnumerateVisibleTokens\u0060, \u0060HandlePointerDown\u0060, \u0060HandlePointerDoubleClick\u0060, and \u0060NavigateByKey\u0060 to \u0060DomTreeViewportState\u0060.\n- Updated \u0060DomTreeView\u0060 in \u0060TestBedApp\u0060 to delegate all row layout math, token viewport culling, hit-testing, double-click expansion, and keyboard navigation to \u0060DomTreeViewportState\u0060.\n- **Unified Runner / Scraper / Dumper Pipeline (\u0060BrowserAutomationFramework\\Automation\\AutomationRunner.cs\u0060 \u0026 \u0060BrowserAutomationFramework\\Scraping\\DataScraper.cs\u0060)**:\n\n- Added shared \u0060Scraper\u0060 (\u0060DataScraper\u0060) and \u0060SiteDumper\u0060 (\u0060SiteDumper\u0060) properties to \u0060AutomationRunner\u0060 and \u0060Runner\u0060 to \u0060DataScraper\u0060 so automation steps and direct scrapes/dumps share the same engine instances and lifecycle events.\n- **DOM Node Selection \u0026 Action Overloads (\u0060BrowserAutomationFramework\\Server\\BrowserClient.cs\u0060 \u0026 \u0060BrowserAutomationFramework\\Extensions\\ReactExtensions.cs\u0060)**:\n\n- Added \u0060BrowserClient.SelectDomNode\u0060 to record user DOM selection and trigger debounced element highlighting for element nodes.\n- Added \u0060DomNode\u0060 overloads to \u0060ReactExtensions\u0060 for \u0060ClickReactElementAsync\u0060, \u0060SetReactInputValueAsync\u0060, and \u0060ScrapeElementAsync\u0060.\n- **Server-Level Client \u0026 Active-Client Event Forwarding (\u0060BrowserAutomationFramework\\Server\\AutomationServer.cs\u0060 \u0026 \u0060TestBedApp\\MainForm.cs\u0060)**:\n\n- Added \u0060OnClientModeChanged\u0060, \u0060OnClientStreamDataReceived\u0060, \u0060OnClientPageLoaded\u0060, \u0060OnActiveClientPageLoaded\u0060, \u0060OnActiveClientDomChanged\u0060, \u0060OnActiveClientHighlightedElementRemoved\u0060, and \u0060OnActiveClientElementClicked\u0060 to \u0060AutomationServer\u0060.\n- Updated \u0060MainForm\u0060 to consume the new \u0060AutomationServer\u0060, \u0060AutomationRunner\u0060, \u0060BrowserClient\u0060, and \u0060ReactExtensions\u0060 APIs, and removed duplicate event wiring and redundant tab injection checks.\n\n### How to Test\n\n- Build the solution (\u0060dotnet build\u0060) and verify both \u0060BrowserAutomationFramework\u0060 and \u0060TestBedApp\u0060 compile with zero warnings or errors.\n- Run \u0060TestBedApp\u0060, start the server, connect a browser tab, and verify DOM Explorer rendering, node expansion/collapse, keyboard navigation, middle-click selection, context menu test actions, data scraping, and reverse-engineering dumps.",
