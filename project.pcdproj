u0026\u0026 el.id.startsWith(\u0027eval_\u0027) \u0026\u0026 el.id.endsWith(\u0027_script\u0027)) return null;\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Server\\BrowserClient.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n            // Re-send any pending commands that were interrupted during page navigation\n            foreach (var entry in _pendingCommands.Values)\n            {\n                if (!entry.Tcs.Task.IsCompleted)\n                {\n                    try\n                    {\n                        await SendWebSocketMessageAsync(webSocket, entry.Command, cancellationToken);\n                    }\n                    catch\n                    {\n                        // Will be retried on next reconnect if socket dropped\n                    }\n                }\n            }\n==== REPLACE\n            // Complete any navigation/click commands that triggered the page unload rather than re-sending them to the new page\n            foreach (var entry in _pendingCommands.Values)\n            {\n                if (!entry.Tcs.Task.IsCompleted)\n                {\n                    string cmdType = entry.Command.Type ?? string.Empty;\n                    if (string.Equals(cmdType, \u0022REACT_CLICK\u0022, StringComparison.OrdinalIgnoreCase) ||\n                        string.Equals(cmdType, \u0022NAVIGATE\u0022, StringComparison.OrdinalIgnoreCase) ||\n                        string.Equals(cmdType, \u0022RELOAD_PAGE\u0022, StringComparison.OrdinalIgnoreCase))\n                    {\n                        entry.Tcs.TrySetResult(new CommandResult\n                        {\n                            TaskId = entry.Command.Id,\n                            Status = \u0022completed\u0022,\n                            Output = \u0022Link click executed (page navigated)\u0022\n                        });\n                        continue;\n                    }\n\n                    try\n                    {\n                        await SendWebSocketMessageAsync(webSocket, entry.Command, cancellationToken);\n                    }\n                    catch\n                    {\n                        // Will be retried on next reconnect if socket dropped\n                    }\n                }\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                        if (!string.IsNullOrEmpty(pageLoadId))\n                            CurrentPageLoadId = pageLoadId;\n                        if (!string.IsNullOrEmpty(url))\n                            CurrentUrl = url;\n\n                        LastStatusCode = statusCode;\n                        LastRetryAfter = retryAfter;\n\n                        OnPageLoaded?.Invoke(this, new PageLoadedEventArgs(pageLoadId, url, readyState, statusCode, retryAfter));\n                    }\n                }\n==== REPLACE\n                        bool isNewPageLoad = string.IsNullOrEmpty(pageLoadId) ||\n                                             !string.Equals(CurrentPageLoadId, pageLoadId, StringComparison.Ordinal) ||\n                                             (statusCode == 429 \u0026\u0026 LastStatusCode != 429);\n\n                        if (!string.IsNullOrEmpty(pageLoadId))\n                            CurrentPageLoadId = pageLoadId;\n                        if (!string.IsNullOrEmpty(url))\n                            CurrentUrl = url;\n\n                        LastStatusCode = statusCode;\n                        LastRetryAfter = retryAfter;\n\n                        if (isNewPageLoad)\n                        {\n                            OnPageLoaded?.Invoke(this, new PageLoadedEventArgs(pageLoadId, url, readyState, statusCode, retryAfter));\n                        }\n                    }\n                }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Extensions\\ReactExtensions.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n            client.OnPageLoaded \u002B= OnLoaded;\n            try\n            {\n                // Allow time for navigation/unload to begin\n                await Task.Delay(150, cancellationToken);\n\n                if (expectNavigation)\n                {\n                    using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);\n                    timeoutCts.CancelAfter(timeoutMs);\n\n                    while (!timeoutCts.IsCancellationRequested)\n                    {\n                        if (pageLoadedTcs.Task.IsCompleted)\n                            break;\n\n                        if (!string.IsNullOrEmpty(client.CurrentPageLoadId) \u0026\u0026\n                            !string.IsNullOrEmpty(previousPageLoadId) \u0026\u0026\n                            !string.Equals(client.CurrentPageLoadId, previousPageLoadId, StringComparison.Ordinal))\n                        {\n                            break;\n                        }\n\n                        var completed = await Task.WhenAny(pageLoadedTcs.Task, Task.Delay(250, timeoutCts.Token));\n                        if (completed == pageLoadedTcs.Task)\n                            break;\n\n                        try\n                        {\n                            var stateRes = await client.WaitForPageLoadAsync(timeoutMs, timeoutCts.Token);\n                            if (!string.IsNullOrEmpty(client.CurrentPageLoadId) \u0026\u0026\n                                (string.IsNullOrEmpty(previousPageLoadId) ||\n                                 !string.Equals(client.CurrentPageLoadId, previousPageLoadId, StringComparison.Ordinal)))\n                            {\n                                break;\n                            }\n                        }\n                        catch\n                        {\n                            // Page is still unloading/reconnecting\n                        }\n                    }\n                }\n\n                await client.WaitForPageLoadAsync(timeoutMs, cancellationToken);\n                await Task.Delay(100, cancellationToken);\n            }\n            finally\n            {\n                client.OnPageLoaded -= OnLoaded;\n            }\n==== REPLACE\n            client.OnPageLoaded \u002B= OnLoaded;\n            try\n            {\n                // If safeNavigate already completed the transition in-place, return immediately\n                if (!string.IsNullOrEmpty(previousPageLoadId) \u0026\u0026\n                    !string.IsNullOrEmpty(client.CurrentPageLoadId) \u0026\u0026\n                    !string.Equals(client.CurrentPageLoadId, previousPageLoadId, StringComparison.Ordinal))\n                {\n                    await Task.Delay(50, cancellationToken);\n                    return;\n                }\n\n                if (expectNavigation)\n                {\n                    using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);\n                    timeoutCts.CancelAfter(timeoutMs);\n\n                    while (!timeoutCts.IsCancellationRequested)\n                    {\n                        if (pageLoadedTcs.Task.IsCompleted)\n                            break;\n\n                        if (!string.IsNullOrEmpty(client.CurrentPageLoadId) \u0026\u0026\n                            !string.IsNullOrEmpty(previousPageLoadId) \u0026\u0026\n                            !string.Equals(client.CurrentPageLoadId, previousPageLoadId, StringComparison.Ordinal))\n                        {\n                            break;\n                        }\n\n                        var completed = await Task.WhenAny(pageLoadedTcs.Task, Task.Delay(2000, timeoutCts.Token));\n                        if (completed == pageLoadedTcs.Task)\n                            break;\n\n                        try\n                        {\n                            await client.WaitForPageLoadAsync(timeoutMs, timeoutCts.Token);\n                            if (!string.IsNullOrEmpty(client.CurrentPageLoadId) \u0026\u0026\n                                (string.IsNullOrEmpty(previousPageLoadId) ||\n                                 !string.Equals(client.CurrentPageLoadId, previousPageLoadId, StringComparison.Ordinal)))\n                            {\n                                break;\n                            }\n                        }\n                        catch\n                        {\n                            // Page is still unloading/reconnecting\n                        }\n                    }\n                }\n                else\n                {\n                    await Task.Delay(150, cancellationToken);\n                    await client.WaitForPageLoadAsync(timeoutMs, cancellationToken);\n                }\n\n                await Task.Delay(50, cancellationToken);\n            }\n            finally\n            {\n                client.OnPageLoaded -= OnLoaded;\n            }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Scraping\\DataScraper.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n                // 2. Scrape Page Loop\n                for (int page = 1; page \u003C= totalPagesToScrape; page\u002B\u002B)\n                {\n                    cancellationToken.ThrowIfCancellationRequested();\n\n                    await client.WaitForPageLoadAsync(cancellationToken: cancellationToken);\n\n                    int currentTargetPageNum = startPageNum \u002B ((page - 1) * pageIncrement);\n==== REPLACE\n                // 2. Scrape Page Loop\n                for (int page = 1; page \u003C= totalPagesToScrape; page\u002B\u002B)\n                {\n                    cancellationToken.ThrowIfCancellationRequested();\n\n                    int currentTargetPageNum = startPageNum \u002B ((page - 1) * pageIncrement);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                        else if (!string.IsNullOrWhiteSpace(definition.NextPageSelector))\n                        {\n                            try\n                            {\n                                string? beforePageLoadId = client.CurrentPageLoadId;\n                                var clickRes = await client.ClickReactElementAsync(definition.NextPageSelector, cancellationToken);\n                                bool isFullNavigation = clickRes.Output != null \u0026\u0026\n                                                        clickRes.Output.StartsWith(\u0022Link click executed\u0022, StringComparison.OrdinalIgnoreCase);\n                                await client.WaitForPageTransitionAsync(beforePageLoadId, expectNavigation: isFullNavigation, cancellationToken: cancellationToken);\n                                advanced = true;\n                            }\n                            catch\n                            {\n                                // Next page element not found or no longer clickable\n\u0060\u0060\u0060",
      "ModelExplanation": "### Root Cause \u0026 Changes\n\n- **Fixed Duplicate Link Navigation in \u0060ScriptGenerator.cs\u0060**:\n\n- Previously, \u0060ReactUtils.simulateClick\u0060 invoked \u0060target.click()\u0060 (which natively initiates a browser navigation on \u0060\u003Ca href\u003E\u0060 links) **and then** 25ms later executed \u0060setTimeout(() =\u003E { window.location.href = href; }, 25)\u0060, firing two HTTP \u0060GET\u0060 requests 25ms apart on every page turn and tripping burst rate limiters.\n- Added a controlled \u0060safeNavigate\u0060 helper and a \u0060window\u0060 bubble-phase click interceptor for \u0060\u003Ca href\u003E\u0060 links so each page turn performs **only one** HTTP \u0060GET\u0060 request.\n- **Prevented Empty-Body \u0060HTTP 429\u0060 Responses from Unloading Tampermonkey (\u0060chrome-error://chromewebdata/\u0060)**:\n\n- When sites like \u0060swappa.com\u0060 return \u0060HTTP 429\u0060 with an empty response body on a top-level navigation, Chrome replaces the document with its internal \u0060chrome-error://chromewebdata/\u0060 error page (\u0022This page isn\u0027t working - HTTP ERROR 429\u0022), where Chrome disables Tampermonkey userscripts and drops the WebSocket connection.\n- \u0060safeNavigate\u0060 now performs same-origin navigations and reloads via an in-page \u0060fetch\u0060, keeping the userscript and WebSocket connection alive if \u0060429\u0060 is returned, reading \u0060Retry-After\u0060 headers directly from the response, displaying an in-page status banner, and reporting the \u0060429\u0060 state to \u0060DataScraper\u0060 so it can wait and retry automatically.\n- **Eliminated \u0060Page loaded\u0060 Log Spam \u0026 Redundant Polling (\u0060BrowserClient.cs\u0060, \u0060ReactExtensions.cs\u0060, \u0060DataScraper.cs\u0060, \u0060MainForm.cs\u0060)**:\n\n- \u0060BrowserClient.HandleEvent\u0060 now only raises \u0060OnPageLoaded\u0060 when \u0060pageLoadId\u0060 changes (or when reporting a \u0060429\u0060 status), preventing \u0060WaitForPageLoadAsync\u0060 from logging duplicate \u0060[NAV] Page loaded\u0060 lines for the same page instance.\n- \u0060WaitForPageTransitionAsync\u0060 now exits immediately if \u0060CurrentPageLoadId\u0060 has already transitioned and no longer spams \u0060WAIT_FOR_PAGE_LOAD\u0060 every 250ms against the unloading page.\n- \u0060BrowserClient.AttachWebSocketAsync\u0060 no longer re-sends navigation/click commands (\u0060REACT_CLICK\u0060, \u0060NAVIGATE\u0060, \u0060RELOAD_PAGE\u0060, \u0060WAIT_FOR_PAGE_LOAD\u0060) across WebSocket reconnections.\n\n### How to Test\n\n- Rebuild and launch **TestBedApp**, then start the server.\n- Click **\u0022Generate \u0026 Copy Script\u0022** and paste the updated script into Tampermonkey (replacing the previous script), then reload the \u0060swappa.com/imei/tac?page=1\u0060 tab so the new userscript is active.\n- Run your multi-page scrape in the **Data Scraper** tab. Observe in **Real-time Logs** that each page loads only once per page transition, and if a \u0060429\u0060 occurs, the browser tab remains connected and automatically waits and retries.",
