ation\u0022/\u003E, clears cached token measurements, and updates \u003Csee cref=\u0022AvgCharWidth\u0022/\u003E.        /// \u003C/summary\u003E        public void InvalidateMeasurements(int avgCharWidth)        {            FontGeneration\u002B\u002B;            _measureCache.Clear();            AvgCharWidth = Math.Max(1, avgCharWidth);        }==== REPLACE        /// \u003Csummary\u003E        /// Increments \u003Csee cref=\u0022FontGeneration\u0022/\u003E, clears cached token measurements, and updates \u003Csee cref=\u0022AvgCharWidth\u0022/\u003E.        /// \u003C/summary\u003E        public void InvalidateMeasurements(int avgCharWidth)        {            FontGeneration\u002B\u002B;            _measureCache.Clear();            AvgCharWidth = Math.Max(1, avgCharWidth);        }        /// \u003Csummary\u003E        /// Computes DPI-scaled row metrics (\u003Cparamref name=\u0022itemHeight\u0022/\u003E, \u003Cparamref name=\u0022indentWidth\u0022/\u003E,        /// \u003Cparamref name=\u0022glyphColumnWidth\u0022/\u003E, and \u003Cparamref name=\u0022paddingLeft\u0022/\u003E) and invalidates cached token measurements.        /// \u003C/summary\u003E        public void UpdateFontMetrics(            int fontHeight,            int tenCharSampleWidth,            float dpiScale,            out int itemHeight,            out int indentWidth,            out int glyphColumnWidth,            out int paddingLeft)        {            float safeScale = dpiScale \u003E 0f ? dpiScale : 1f;            int Scale(int val) =\u003E (int)Math.Ceiling(val * safeScale);            itemHeight = Math.Max(fontHeight \u002B Scale(6), Scale(24));            indentWidth = Scale(18);            glyphColumnWidth = Scale(18);            paddingLeft = Scale(6);            int avgCharWidth = Math.Max(6, (int)Math.Ceiling(tenCharSampleWidth / 10.0));            InvalidateMeasurements(avgCharWidth);        }        /// \u003Csummary\u003E        /// Calculates the pixel layout geometry for rendering the visible row at \u003Cparamref name=\u0022rowIndex\u0022/\u003E.        /// \u003C/summary\u003E        public DomRowRenderLayout CalculateRowRenderLayout(            int rowIndex,            DomTreeItem item,            DomRowMeasureCache measure,            int hoveredRowIndex,            int viewportLeft,            int viewportTop,            int viewportRight,            int paddingLeft,            int indentWidth,            int glyphColumnWidth,            int itemHeight,            int fontHeight,            int rawGlyphBoxSize,            bool showLines,            bool showRootLines,            bool showPlusMinus)        {            if (item == null) throw new ArgumentNullException(nameof(item));            if (measure == null) throw new ArgumentNullException(nameof(measure));            int glyphBoxSize = Math.Max(5, rawGlyphBoxSize);            if (glyphBoxSize % 2 == 0)                glyphBoxSize\u002B\u002B;            int rowY = viewportTop \u002B (rowIndex * itemHeight) - ScrollY;            int centerY = rowY \u002B (itemHeight / 2);            int indentX = viewportLeft \u002B paddingLeft \u002B (item.Depth * indentWidth) - ScrollX;            int textStartX = indentX \u002B glyphColumnWidth;            int textY = rowY \u002B ((itemHeight - fontHeight) / 2);            bool isExpanded = item.HasChildren \u0026\u0026 _expandedKeys.Contains(item.UniqueKey);            bool isSelected = string.Equals(item.UniqueKey, SelectedKey, StringComparison.Ordinal);            bool isHovered = rowIndex == hoveredRowIndex \u0026\u0026 !isSelected;            int textTotalW = GetMeasuredRowTextWidth(item, measure.OpenTotalWidth, measure.CollapsedSuffixTotalWidth);            int lineCenterX = indentX \u002B (glyphColumnWidth / 2);            bool hasBranchConnector = showLines \u0026\u0026                                      (item.Depth \u003E 0 || showRootLines) \u0026\u0026                                      lineCenterX \u003E= viewportLeft - 20 \u0