ationToken);\n        }\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Saves the combined dump output (for \u003Cparamref name=\u0022viewType\u0022/\u003E or \u003Csee cref=\u0022DumpType\u0022/\u003E) to a single file.\n        /// \u003C/summary\u003E\n        public void SaveCombinedToFile(string filePath, SiteDumpType? viewType = null)\n        {\n            if (string.IsNullOrWhiteSpace(filePath))\n                throw new ArgumentException(\u0022File path cannot be empty.\u0022, nameof(filePath));\n\n            string? dir = Path.GetDirectoryName(filePath);\n            if (!string.IsNullOrWhiteSpace(dir))\n            {\n                Directory.CreateDirectory(dir);\n            }\n\n            File.WriteAllText(filePath, GetCombinedContent(viewType ?? DumpType), Encoding.UTF8);\n        }\n\n        /// \u003Csummary\u003E\n        /// Asynchronously saves the combined dump output (for \u003Cparamref name=\u0022viewType\u0022/\u003E or \u003Csee cref=\u0022DumpType\u0022/\u003E) to a single file.\n        /// \u003C/summary\u003E\n        public Task SaveCombinedToFileAsync(string filePath, SiteDumpType? viewType = null, CancellationToken cancellationToken = default)\n        {\n            if (string.IsNullOrWhiteSpace(filePath))\n                throw new ArgumentException(\u0022File path cannot be empty.\u0022, nameof(filePath));\n\n            string? dir = Path.GetDirectoryName(filePath);\n            if (!string.IsNullOrWhiteSpace(dir))\n            {\n                Directory.CreateDirectory(dir);\n            }\n\n            return File.WriteAllTextAsync(filePath, GetCombinedContent(viewType ?? DumpType), Encoding.UTF8, cancellationToken);\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Server\\BrowserClient.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nnamespace BrowserAutomationFramework.Server\n{\n    public class BrowserClient\n    {\n==== REPLACE\nusing BrowserAutomationFramework.Extensions;\n\nnamespace BrowserAutomationFramework.Server\n{\n    /// \u003Csummary\u003E\n    /// Represents a connected browser tab instance (via the BAF Chrome Extension or Tampermonkey userscript)\n    /// and manages bidirectional command execution and DOM/navigation event streaming.\n    /// \u003C/summary\u003E\n    public class BrowserClient\n    {\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private readonly ConcurrentQueue\u003CCommandMessage\u003E _httpCommandQueue = new();\n        private readonly ConcurrentDictionary\u003Cstring, (CommandMessage Command, TaskCompletionSource\u003CCommandResult\u003E Tcs)\u003E _pendingCommands = new();\n\n        /// \u003Csummary\u003E\n        /// Triggered when the browser script streams partial data back for a long-running task.\n==== REPLACE\n        private readonly ConcurrentQueue\u003CCommandMessage\u003E _httpCommandQueue = new();\n        private readonly ConcurrentDictionary\u003Cstring, (CommandMessage Command, TaskCompletionSource\u003CCommandResult\u003E Tcs)\u003E _pendingCommands = new();\n        private CancellationTokenSource? _highlightDebounceCts;\n        private string? _lastHighlightedSelector;\n\n        /// \u003Csummary\u003E\n        /// Gets the CSS selector of the most recently highlighted element on this client, if any.\n        /// \u003C/summary\u003E\n        public string? LastHighlightedSelector =\u003E _lastHighlightedSelector;\n\n        /// \u003Csummary\u003E\n        /// Resets the tracked highlight selector (or sets it to \u003Cparamref name=\u0022selector\u0022/\u003E) without sending a command to the browser.\n        /// \u003C/summary\u003E\n        public void SetTrackedHighlightSelector(string? selector = null)\n        {\n            _lastHighlightedSelector = selector;\n        }\n\n        /// \u003Csummary\u003E\n        /// Highlights the specified CSS selector in the browser using automatic debouncing and duplicate-selector suppression.\n        /// Ideal for binding directly to UI tree view selection or hover events.\n        /// \u003C/summary\u003E\n        public void HighlightElementDebounced(string? selector, int debounceMs = 25)\n        {\n            if (string.IsNullOrEmpty(selector))\n                return;\n\n            if (string.Equals(_lastHighlightedSelector, selector, StringComparison.Ordinal))\n                return;\n\n            _lastHighlightedSelector = selector;\n            _highlightDebounceCts?.Cancel();\n            var cts = new CancellationTokenSource();\n            _highlightDebounceCts = cts;\n            var token = cts.Token;\n\n            _ = Task.Run(async () =\u003E\n            {\n                try\n                {\n                    if (debounceMs \u003E 0)\n                    {\n                        await Task.Delay(debounceMs, token).ConfigureAwait(false);\n                    }\n                    if (!token.IsCancellationRequested)\n                    {\n                        await this.HighlightElementAsync(selector, token).ConfigureAwait(false);\n                    }\n                }\n                catch\n                {\n                    // Ignore transient or canceled highlight commands\n                }\n            }, token);\n        }\n\n        /// \u003Csummary\u003E\n        /// Triggered when the browser script streams partial data back for a long-running task.\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        internal void Disconnect()\n        {\n            foreach (var kvp in _pendingCommands.ToArray())\n==== REPLACE\n        internal void Disconnect()\n        {\n            _highlightDebounceCts?.Cancel();\n            foreach (var kvp in _pendingCommands.ToArray())\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Server\\AutomationServer.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        public string SyncDefaultChromeExtension(\n            IpcMode mode = IpcMode.WebSocket,\n            string? directoryPath = null,\n            string? customScript = null)\n        {\n            string targetDir = !string.IsNullOrWhiteSpace(directoryPath)\n                ? directoryPath!\n                : ChromeExtensionGenerator.GetDefaultExtensionDirectory();\n            return ChromeExtensionGenerator.ExportToDirectory(targetDir, _port, mode, customScript);\n        }\n==== REPLACE\n        public string SyncDefaultChromeExtension(\n            IpcMode mode = IpcMode.WebSocket,\n            string? directoryPath = null,\n            string? customScript = null)\n        {\n            if (!string.IsNullOrWhiteSpace(directoryPath))\n            {\n                return ChromeExtensionGenerator.ExportToDirectory(directoryPath!, _port, mode, customScript);\n            }\n            return ChromeExtensionGenerator.SyncDefaultDirectory(_port, mode, customScript);\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n            try\n            {\n                string defaultExtDir = ChromeExtensionGenerator.GetDefaultExtensionDirectory();\n                ChromeExtensionGenerator.ExportToDirectory(defaultExtDir, (int)numPort.Value, IpcMode.WebSocket);\n            }\n            catch { }\n==== REPLACE\n            try\n            {\n                ChromeExtensionGenerator.SyncDefaultDirectory((int)numPort.Value, IpcMode.WebSocket);\n            }\n            catch { }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            client.OnElementClicked \u002B= (s, e) =\u003E\n            {\n                BeginInvoke(new Action(async () =\u003E\n                {\n                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)\n                    {\n                        _lastUserSelectedDomPath = e.Path;\n                        _lastUserSelectionUtc = DateTime.UtcNow;\n                        _lastHighlightedBrowserPath = e.Path;\n\n                        if (tvDom.SelectNodeByPath(e.Path, ensureVisible: true, raiseAfterSelect: false))\n==== REPLACE\n            client.OnElementClicked \u002B= (s, e) =\u003E\n            {\n                BeginInvoke(new Action(async () =\u003E\n                {\n                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)\n                    {\n                        _lastUserSelectedDomPath = e.Path;\n                        _lastUserSelectionUtc = DateTime.UtcNow;\n                        client.SetTrackedHighlightSelector(e.Path);\n\n                        if (tvDom.SelectNodeByPath(e.Path, ensureVisible: true, raiseAfterSelect: false))\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                    _lastHighlightedBrowserPath = null;\n                    await RefreshDomAsync(client);\n                }\n            }));\n        }\n==== REPLACE\n                    client.SetTrackedHighlightSelector(null);\n                    await RefreshDomAsync(client);\n                }\n            }));\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private async void LstClients_SelectedIndexChanged(object? sender, EventArgs e)\n        {\n            if (_isUpdatingClientsList) return;\n\n            if (lstClients.SelectedItem is BrowserClient client)\n            {\n                _lastHighlightedBrowserPath = null;\n                await RefreshDomAsync(client);\n            }\n==== REPLACE\n        private async void LstClients_SelectedIndexChanged(object? sender, EventArgs e)\n        {\n            if (_isUpdatingClientsList) return;\n\n            if (lstClients.SelectedItem is BrowserClient client)\n            {\n                client.SetTrackedHighlightSelector(null);\n                await RefreshDomAsync(client);\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private int _domRefreshInFlight;\n        private (BrowserClient Client, string? TargetPath, bool HasTargetPath)? _pendingDomRefresh;\n        private string? _lastUserSelectedDomPath;\n        private DateTime _lastUserSelectionUtc = DateTime.MinValue;\n        private CancellationTokenSource? _highlightDebounceCts;\n        private string? _lastHighlightedBrowserPath;\n\n        private async Task RefreshDomAsync(BrowserClient client, string? targetSelectedPath = null, bool hasTargetPath = false)\n==== REPLACE\n        private int _domRefreshInFlight;\n        private (BrowserClient Client, string? TargetPath, bool HasTargetPath)? _pendingDomRefresh;\n        private string? _lastUserSelectedDomPath;\n        private DateTime _lastUserSelectionUtc = DateTime.MinValue;\n\n        private async Task RefreshDomAsync(BrowserClient client, string? targetSelectedPath = null, bool hasTargetPath = false)\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void HighlightElementInBrowserDebounced(BrowserClient client, string selector)\n        {\n            if (string.IsNullOrEmpty(selector))\n                return;\n\n            if (string.Equals(_lastHighlightedBrowserPath, selector, StringComparison.Ordinal))\n                return;\n\n            _lastHighlightedBrowserPath = selector;\n            _highlightDebounceCts?.Cancel();\n            var cts = new CancellationTokenSource();\n            _highlightDebounceCts = cts;\n            var token = cts.Token;\n\n            _ = Task.Run(async () =\u003E\n            {\n                try\n                {\n                    await Task.Delay(25, token).ConfigureAwait(false);\n                    if (!token.IsCancellationRequested)\n                    {\n                        await client.HighlightElementAsync(selector, token).ConfigureAwait(false);\n                    }\n                }\n                catch\n                {\n                    // Ignore transient or canceled highlight commands\n                }\n            }, token);\n        }\n\n        private void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)\n        {\n            if (e.Node?.Tag is DomNode domNode)\n            {\n                _lastUserSelectedDomPath = domNode.Path;\n                _lastUserSelectionUtc = DateTime.UtcNow;\n                txtElementDetails.Text = domNode.GetFormattedDetails();\n\n                if (domNode.Type == \u0022element\u0022 \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n                {\n                    HighlightElementInBrowserDebounced(client, domNode.Path);\n                }\n            }\n        }\n==== REPLACE\n        private void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)\n        {\n            if (e.Node?.Tag is DomNode domNode)\n            {\n                _lastUserSelectedDomPath = domNode.Path;\n                _lastUserSelectionUtc = DateTime.UtcNow;\n                txtElementDetails.Text = domNode.GetFormattedDetails();\n\n                if (domNode.Type == \u0022element\u0022 \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n                {\n                    client.HighlightElementDebounced(domNode.Path);\n                }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            using var sfd = new SaveFileDialog\n            {\n                Filter = \u0022JSON Files (*.json)|*.json|All Files (*.*)|*.*\u0022,\n                Title = \u0022Export Scrape Results as JSON\u0022,\n                DefaultExt = \u0022json\u0022,\n                FileName = $\u0022{_lastScrapeResult.ScrapeName.Replace(\u0027 \u0027, \u0027_\u0027)}.json\u0022\n            };\n==== REPLACE\n            using var sfd = new SaveFileDialog\n            {\n                Filter = \u0022JSON Files (*.json)|*.json|All Files (*.*)|*.*\u0022,\n                Title = \u0022Export Scrape Results as JSON\u0022,\n                DefaultExt = \u0022json\u0022,\n                FileName = _lastScrapeResult.GetSuggestedFileName(\u0022json\u0022)\n            };\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            using var sfd = new SaveFileDialog\n            {\n                Filter = \u0022CSV Files (*.csv)|*.csv|All Files (*.*)|*.*\u0022,\n                Title = \u0022Export Scrape Results as CSV\u0022,\n                DefaultExt = \u0022csv\u0022,\n                FileName = $\u0022{_lastScrapeResult.ScrapeName.Replace(\u0027 \u0027, \u0027_\u0027)}.csv\u0022\n            };\n==== REPLACE\n            using var sfd = new SaveFileDialog\n            {\n                Filter = \u0022CSV Files (*.csv)|*.csv|All Files (*.*)|*.*\u0022,\n                Title = \u0022Export Scrape Results as CSV\u0022,\n                DefaultExt = \u0022csv\u0022,\n                FileName = _lastScrapeResult.GetSuggestedFileName(\u0022csv\u0022)\n            };\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            try\n            {\n                SiteDumpResult result = dumpType switch\n                {\n                    SiteDumpType.Html =\u003E await client.DumpHtmlAsync(options, _siteDumper),\n                    SiteDumpType.Css =\u003E await client.DumpCssAsync(options, _siteDumper),\n                    SiteDumpType.JavaScript =\u003E await client.DumpJavaScriptAsync(options, _siteDumper),\n                    _ =\u003E await client.DumpAllAsync(options, _siteDumper)\n                };\n\n                DisplaySiteDumpResult(result);\n            }\n==== REPLACE\n            try\n            {\n                SiteDumpResult result = await client.DumpSiteAsync(dumpType, options, _siteDumper);\n                DisplaySiteDumpResult(result);\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private string GetActiveDumpViewerText(out string suggestedFileName)\n        {\n            suggestedFileName = \u0022dump.txt\u0022;\n            if (_lastSiteDumpResult == null)\n                return string.Empty;\n\n            if (tabDumpViewers.SelectedTab == tabSelectedResourceView \u0026\u0026 lstDumpedResources.SelectedItem is SiteResourceItem selectedRes)\n            {\n                suggestedFileName = string.IsNullOrWhiteSpace(selectedRes.Name) ? \u0022resource.txt\u0022 : selectedRes.Name;\n                return selectedRes.Content;\n            }\n\n            if (tabDumpViewers.SelectedTab == tabCombinedHtmlView)\n            {\n                suggestedFileName = \u0022combined.html\u0022;\n                return _lastSiteDumpResult.GetCombinedHtml();\n            }\n\n            if (tabDumpViewers.SelectedTab == tabCombinedCssView)\n            {\n                suggestedFileName = \u0022combined.css\u0022;\n                return _lastSiteDumpResult.GetCombinedCss();\n            }\n\n            if (tabDumpViewers.SelectedTab == tabCombinedJsView)\n            {\n                suggestedFileName = \u0022combined.js\u0022;\n                return _lastSiteDumpResult.GetCombinedJavaScript();\n            }\n\n            suggestedFileName = \u0022combined_dump.txt\u0022;\n            return _lastSiteDumpResult.GetCombinedContent();\n        }\n==== REPLACE\n        private SiteDumpType GetSelectedCombinedViewerDumpType()\n        {\n            if (tabDumpViewers.SelectedTab == tabCombinedHtmlView) return SiteDumpType.Html;\n            if (tabDumpViewers.SelectedTab == tabCombinedCssView) return SiteDumpType.Css;\n            if (tabDumpViewers.SelectedTab == tabCombinedJsView) return SiteDumpType.JavaScript;\n            return _lastSiteDumpResult?.DumpType ?? SiteDumpType.All;\n        }\n\n        private string GetActiveDumpViewerText(out string suggestedFileName)\n        {\n            suggestedFileName = \u0022dump.txt\u0022;\n            if (_lastSiteDumpResult == null)\n                return string.Empty;\n\n            if (tabDumpViewers.SelectedTab == tabSelectedResourceView \u0026\u0026 lstDumpedResources.SelectedItem is SiteResourceItem selectedRes)\n            {\n                suggestedFileName = string.IsNullOrWhiteSpace(selectedRes.Name) ? \u0022resource.txt\u0022 : selectedRes.Name;\n                return selectedRes.Content;\n            }\n\n            var viewType = GetSelectedCombinedViewerDumpType();\n            suggestedFileName = SiteDumpResult.GetSuggestedCombinedFileName(viewType);\n            return _lastSiteDumpResult.GetCombinedContent(viewType);\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            if (sfd.ShowDialog() == DialogResult.OK)\n            {\n                try\n                {\n                    System.IO.File.WriteAllText(sfd.FileName, content, System.Text.Encoding.UTF8);\n                    Log($\u0022[REV-ENG] Saved \u0027{defaultFileName}\u0027 to {sfd.FileName}\u0022, Color.Lime);\n                }\n                catch (Exception ex)\n                {\n                    Log($\u0022[ERR] Failed to save file: {ex.Message}\u0022, Color.Red);\n                }\n            }\n==== REPLACE\n            if (sfd.ShowDialog() == DialogResult.OK)\n            {\n                try\n                {\n                    _lastSiteDumpResult.SaveCombinedToFile(sfd.FileName, GetSelectedCombinedViewerDumpType());\n                    Log($\u0022[REV-ENG] Saved \u0027{defaultFileName}\u0027 to {sfd.FileName}\u0022, Color.Lime);\n                }\n                catch (Exception ex)\n                {\n                    Log($\u0022[ERR] Failed to save file: {ex.Message}\u0022, Color.Red);\n                }\n            }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
      "ModelExplanation": "Yes, the previous response was complete and applied the core migration. However, upon doing a second pass across the entire codebase to make sure **nothing** was missed, I found a few additional places where \u0060TestBedApp\u0060 still had helper/plumbing logic that belongs in \u0060BrowserAutomationFramework\u0060, as well as a few models that lacked full XML documentation comments:\n\n- **Debounced \u0026 Deduplicated Browser Highlighting (\u0060BrowserClient.HighlightElementDebounced\u0060 \u0026 \u0060ResetHighlightTracking\u0060)**:\n\n- Migrated the \u0060CancellationTokenSource\u0060 debouncing and last-highlighted-selector deduplication out of \u0060MainForm\u0060 and directly into \u0060BrowserClient\u0060 so any UI wrapper can call \u0060client.HighlightElementDebounced(selector)\u0060 without managing background tasks or tokens.\n- **Site Dump Viewer \u0026 Export Helpers (\u0060SiteDumpResult\u0060)**:\n\n- Added \u0060GetCombinedContent(SiteDumpType viewType)\u0060, \u0060GetSuggestedCombinedFileName(SiteDumpType? viewType)\u0060, \u0060SaveCombinedToFile(string filePath, SiteDumpType? viewType)\u0060, and \u0060SaveCombinedToFileAsync(...)\u0060 to \u0060SiteDumpResult\u0060.\n- Replaced the \u0060switch\u0060 statement and manual \u0060System.IO.File.WriteAllText\u0060 in \u0060MainForm\u0060 with \u0060client.DumpSiteAsync(...)\u0060 and \u0060_lastSiteDumpResult.SaveCombinedToFile(...)\u0060.\n- **Safe Filename Generation (\u0060ScrapeResult.GetSuggestedFileName\u0060)**:\n\n- Added \u0060GetSuggestedFileName(string extension)\u0060 to \u0060ScrapeResult\u0060 to sanitize invalid path characters when exporting JSON or CSV files from any UI.\n- **One-Call Default Extension Sync (\u0060ChromeExtensionGenerator.SyncDefaultDirectory\u0060)**:\n\n- Added \u0060SyncDefaultDirectory(int port, IpcMode mode, string? customScript)\u0060 to \u0060ChromeExtensionGenerator\u0060 and used it in both \u0060MainForm\u0060 and \u0060AutomationServer\u0060.\n- **100% XML Documentation Coverage**:\n\n- Added complete XML \u0060\u003Csummary\u003E\u0060 documentation to \u0060BrowserClient\u0060, \u0060BrowserEventArgs\u0060, \u0060CommandMessage\u0060, \u0060CommandResult\u0060, \u0060EventMessage\u0060, \u0060IpcMode\u0060, \u0060ScriptOptions\u0060, and \u0060ScriptGenerator\u0060.\n\n### How to Test\n\n- Build the solution (\u0060dotnet build\u0060) and verify zero warnings or errors.\n- Run \u0060TestBedApp\u0060 and test hovering/selecting DOM nodes (debounced highlighting), exporting scrape results to CSV/JSON, and saving combined HTML/CSS/JS views in the Reverse Engineering tab.",
