untime.InteropServices;using Microsoft.Win32;namespace TestBedApp.Utils{    public static class FileAssociationHelper    {        [DllImport(\u0022shell32.dll\u0022, CharSet = CharSet.Auto, SetLastError = true)]        public static extern void SHChangeNotify(uint wEventId, uint uFlags, IntPtr dwItem1, IntPtr dwItem2);        private const uint SHCNE_ASSOCCHANGED = 0x08000000;        private const uint SHCNF_IDLIST = 0x0000;        public static void EnsureAssociation(string extension, string progId, string description, string applicationFilePath)        {            try            {                bool needsUpdate = false;                // Check if the extension is mapped to our ProgId                using (var key = Registry.CurrentUser.OpenSubKey($@\u0022Software\\Classes\\{extension}\u0022))                {                    if (key?.GetValue(\u0022\u0022) as string != progId) needsUpdate = true;                }                // Check if the ProgId command matches our current executable path                using (var key = Registry.CurrentUser.OpenSubKey($@\u0022Software\\Classes\\{progId}\\shell\\open\\command\u0022))                {                    string expectedCommand = $\u0022\\\u0022{applicationFilePath}\\\u0022 \\\u0022%1\\\u0022\u0022;                    if (key?.GetValue(\u0022\u0022) as string != expectedCommand) needsUpdate = true;                }                // If everything is already set up correctly, skip writing to the registry                if (!needsUpdate) return;                // Set association for the extension                using (var key = Registry.CurrentUser.CreateSubKey($@\u0022Software\\Classes\\{extension}\u0022))                {                    key.SetValue(\u0022\u0022, progId);                }                // Set up the ProgId                using (var key = Registry.CurrentUser.CreateSubKey($@\u0022Software\\Classes\\{progId}\u0022))                {                    key.SetValue(\u0022\u0022, descriptio