.Text))            {                DomNode? rootDom = GetCurrentRootDomNode();                if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)                {                    txtContainerSelector.Text = scrape.GeneralizeAndSetContainer(txtContainerSelector.Text, rootDom);                    pgScrapeFieldDetails.Refresh();                }                else                {                    txtContainerSelector.Text = SelectorHelper.GeneralizeContainerSelector(txtContainerSelector.Text, rootDom);                }            }        }        private async void BtnHighlightContainer_Click(object? sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            string selector = txtContainerSelector.Text.Trim();            if (string.IsNullOrWhiteSpace(selector))            {                Log(\u0022[WARN] Container selector is empty.\u0022, Color.Orange);                return;            }            try            {                int count = chkLstScrapes.SelectedItem is ScrapeDefinition scrape                    ? await client.HighlightScrapeContainerAsync(scrape)                    : await client.HighlightElementsAsync(selector, null, true);                Log($\u0022[SCRAPE] Highlighted {count} container element(s) matching \u0027{selector}\u0027.\u0022, Color.SpringGreen);            }            catch (Exception ex)            {                Log($\u0022[ERR] Failed to highlight container: {ex.Message}\u0022, Color.Red);            }        }        private void BtnAddScrapeField_Click(object? sender, EventArgs e)        {            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape)            {                Log(\u0022[WARN] Please select or create a scrape list first.\u0022, Color.Orange);                return;            }==== REPLACE        private void BtnAddScrape_Click(object? sender, EventArgs e)        {            string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022Add Scrape List\u0022, $\u0022Scrape {_session.Project.Scrapes.Count \u002B 1}\u0022);            if (!string.IsNullOrWhiteSpace(name))            {                var scrape = _session.Project.AddScrape(name);                chkLstScrapes.Items.Add(scrape, scrape.IsActive);                chkLstScrapes.SelectedItem = scrape;            }        }        private void BtnRemoveScrape_Click(object? sender, EventArgs e)        {            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)            {                _session.Project.RemoveScrape(scrape);                chkLstScrapes.Items.Remove(scrape);                LoadSelectedScrapeToUi();            }        }        private void BtnMoveScrapeUp_Click(object? sender, EventArgs e)        {            int idx = chkLstScrapes.SelectedIndex;            if (_session.Project.MoveScrapeUp(idx))            {                var item = chkLstScrapes.Items[idx];                bool isChecked = chkLstScrapes.GetItemChecked(idx);                chkLstScrapes.Items.RemoveAt(idx);                chkLstScrapes.Items.Insert(idx - 1, item);                chkLstScrapes.SetItemChecked(idx - 1, isChecked);                chkLstScrapes.SelectedIndex = idx - 1;            }        }        private void BtnMoveScrapeDown_Click(object? sender, EventArgs e)        {            int idx = chkLstScrapes.SelectedIndex;            if (_session.Project.MoveScrapeDown(idx))            {                var item = chkLstScrapes.Items[idx];                bool isChecked = chkLstScrapes.GetItemChecked(idx);                chkLstScrapes.Items.RemoveAt(idx);                chkLstScrapes.Items.Insert(idx \u002B 1, item);                chkLstScrapes.SetItemChecked(idx \u002B 1, isChecked);                chkLstScrapes.SelectedIndex = idx \u002B 1;            }        }        private void BtnRenameScrape_Click(object? sender, EventArgs e)        {            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)            {                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022Rename Scrape List\u0022, scrape.Name);                if (_session.Project.RenameScrape(scrape, name))                {                    int idx = chkLstScrapes.SelectedIndex;                    bool isChecked = chkLstScrapes.GetItemChecked(idx);                    chkLstScrapes.Items[idx] = scrape;                    chkLstScrapes.SetItemChecked(idx, isChecked);                }            }        }        private void BtnGeneralizeContainer_Click(object? sender, EventArgs e)        {            if (!string.IsNullOrWhiteSpace(txtContainerSelector.Text))            {                txtContainerSelector.Text = _session.GeneralizeContainerSelector(                    txtContainerSelector.Text,                    chkLstScrapes.SelectedItem as ScrapeDefinition,                    tvDom.RootDomNode);                pgScrapeFieldDetails.Refresh();            }        }        private async void BtnHighlightContainer_Click(object? sender, EventArgs e)        {            await _session.HighlightContainerAsync(                txtContainerSelector.Text,                chkLstScrapes.SelectedItem as ScrapeDefinition,                lstClients.SelectedItem as BrowserClient);        }        private void BtnAddScrapeField_Click(object? sender, EventArgs e)        {            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape)            {                _session.Log(\u0022WARN\u0022, \u0022Please select or create a scrape list first.\u0022, AutomationLogLevel.Warning);                return;            }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private void BtnGeneralizeScrapeField_Click(object? sender, EventArgs e)        {            if (lstScrapeFields.SelectedItem is ScrapeField field \u0026\u0026 !string.IsNullOrWhiteSpace(field.Selector))            {                field.GeneralizeSelector(GetCurrentRootDomNode());                pgScrapeFieldDetails.Refresh();                RefreshSelectedFieldItemText();            }        }        private async void BtnHighlightScrapeField_Click(object? sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            if (lstScrapeFields.SelectedItem is not ScrapeField field || string.IsNullOrWhiteSpace(field.Selector))            {                Log(\u0022[WARN] Please select a field with a valid selector first.\u0022, Color.Orange);                return;            }            var parentScrape = chkLstScrapes.SelectedItem as ScrapeDefinition;            try            {                int count = await client.HighlightScrapeFieldAsync(field, parentScrape);                Log($\u0022[SCRAPE] Highlighted {count} element(s) for field \u0027{field.Name}\u0027.\u0022, Color.SpringGreen);            }            catch (Exception ex)            {                Log($\u0022[ERR] Highlight failed: {ex.Message}\u0022, Color.Red);            }        }==== REPLACE        private void BtnGeneralizeScrapeField_Click(object? sender, EventArgs e)        {            if (lstScrapeFields.SelectedItem is ScrapeField field \u0026\u0026 !string.IsNullOrWhiteSpace(field.Selector))            {                field.GeneralizeSelector(_session.ResolveDomRoot(tvDom.RootDomNode));                pgScrapeFieldDetails.Refresh();                RefreshSelectedFieldItemText();            }        }        private async void BtnHighlightScrapeField_Click(object? sender, EventArgs e)        {            await _session.HighlightScrapeFieldAsync(                lstScrapeFields.SelectedItem as ScrapeField,                chkLstScrapes.SelectedItem as ScrapeDefinition,                lstClients.SelectedItem as BrowserClient);        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private async void MnuQuickScrapeText_Click(object? sender, EventArgs e)        {            if (tvDom.SelectedDomNode is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)            {                var extType = domNode.GetSuggestedExtractionType();                Log($\u0022[SCRAPE] Testing extraction ({extType}) on {domNode.Path}...\u0022, Color.SpringGreen);                try                {                    string? val = await client.ScrapeElementAsync(domNode, extType);                    Log($\u0022[SCRAPE-RX] Extracted Value: {val}\u0022, Color.White);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Quick scrape failed: {ex.Message}\u0022, Color.Red);                }            }        }        private void AddFieldFromSelectedDomNode(ScrapeDefinition scrape, bool matchAllElements)        {            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))                return;            var field = scrape.AddFieldFromDomNode(domNode, matchAllElements, GetCurrentRootDomNode());            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                lstScrapeFields.Items.Add(field);                lstScrapeFields.SelectedItem = field;            }            Log($\u0022[SCRAPE] Added field \u0027{field.Name}\u0027 ({field.ExtractionType}) to \u0027{scrape.Name}\u0027.\u0022, Color.SpringGreen);        }        private void SetContainerFromSelectedDomNode(ScrapeDefinition scrape)        {            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))                return;            string generalizedContainer = scrape.SetContainerFromDomNode(domNode, GetCurrentRootDomNode());            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                LoadSelectedScrapeToUi();            }            Log($\u0022[SCRAPE] Set repeating container for \u0027{scrape.Name}\u0027 to: {generalizedContainer}\u0022, Color.SpringGreen);        }        private void SetPaginationNextFromSelectedDomNode(ScrapeDefinition scrape)        {            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))                return;            string selector = scrape.SetPaginationNextFromDomNode(domNode, GetCurrentRootDomNode());            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                LoadSelectedScrapeToUi();            }            Log($\u0022[SCRAPE] Set pagination Next button for \u0027{scrape.Name}\u0027 to: {selector}\u0022, Color.SpringGreen);        }        private async void BtnPreviewScrape_Click(object? sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape)            {                Log(\u0022[WARN] Please select a scrape list to preview.\u0022, Color.Orange);                return;            }            if (!scrape.HasFields)            {                Log(\u0022[WARN] The selected scrape list has no fields defined.\u0022, Color.Orange);                return;            }            btnPreviewScrape.Enabled = false;            try            {                var result = await client.ExecuteScrapeAsync(scrape, _project.Sequences, _scraper);                DisplayScrapeResult(result);            }            catch (Exception ex)            {                Log($\u0022[ERR] Scrape preview failed: {ex.Message}\u0022, Color.Red);            }            finally            {                btnPreviewScrape.Enabled = true;            }        }        private async void BtnRunAllScrapes_Click(object? sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            if (!_project.HasActiveScrapes)            {                Log(\u0022[WARN] No active scrape lists selected to run.\u0022, Color.Orange);                return;            }            btnRunAllScrapes.Enabled = false;            try            {                var combined = await client.ExecuteProjectScrapesCombinedAsync(_project, _scraper);                DisplayScrapeResult(combined);            }            catch (Exception ex)            {                Log($\u0022[ERR] Active scrapes run aborted: {ex.Message}\u0022, Color.Red);            }            finally            {                btnRunAllScrapes.Enabled = true;            }        }        private void DisplayScrapeResult(ScrapeResult result)        {            _lastScrapeResult = result;            lblScrapeStatus.Text = result.GetStatusSummary();            dgvScrapePreview.DataSource = result.ToDataTable();            txtScrapeJsonPreview.Text = result.ToJson(true, true);        }        private void BtnCopyScrapeJson_Click(object? sender, EventArgs e)        {            if (_lastScrapeResult == null || !_lastScrapeResult.HasRecords)            {                Log(\u0022[WARN] No scrape results available to copy.\u0022, Color.Orange);                return;            }            Clipboard.SetText(_lastScrapeResult.ToJson(true, true));            Log(\u0022[SCRAPE] Copied scraped JSON records to clipboard.\u0022, Color.Lime);        }        private void BtnExportScrapeJson_Click(object? sender, EventArgs e)        {            if (_lastScrapeResult == null || !_lastScrapeResult.HasRecords)            {                Log(\u0022[WARN] No scrape results available to export.\u0022, Color.Orange);                return;            }            using var sfd = new SaveFileDialog            {                Filter = \u0022JSON Files (.json)|.json|All Files (.)|.\u0022,                Title = \u0022Export Scrape Results as JSON\u0022,                DefaultExt = \u0022json\u0022,                FileName = _lastScrapeResult.GetSuggestedFileName(\u0022json\u0022)            };            if (sfd.ShowDialog() == DialogResult.OK)            {                try                {                    _lastScrapeResult.SaveToJsonFile(sfd.FileName, recordsOnly: true);                    Log($\u0022[SCRAPE] Exported {_lastScrapeResult.RecordCount} record(s) to {sfd.FileName}\u0022, Color.Lime);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Failed to export JSON: {ex.Message}\u0022, Color.Red);                }            }        }        private void BtnExportScrapeCsv_Click(object? sender, EventArgs e)        {            if (_lastScrapeResult == null || !_lastScrapeResult.HasRecords)            {                Log(\u0022[WARN] No scrape results available to export.\u0022, Color.Orange);                return;            }            using var sfd = new SaveFileDialog            {                Filter = \u0022CSV Files (.csv)|.csv|All Files (.)|.\u0022,                Title = \u0022Export Scrape Results as CSV\u0022,                DefaultExt = \u0022csv\u0022,                FileName = _lastScrapeResult.GetSuggestedFileName(\u0022csv\u0022)            };            if (sfd.ShowDialog() == DialogResult.OK)            {                try                {                    _lastScrapeResult.SaveToCsvFile(sfd.FileName);                    Log($\u0022[SCRAPE] Exported {_lastScrapeResult.RecordCount} record(s) to {sfd.FileName}\u0022, Color.Lime);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Failed to export CSV: {ex.Message}\u0022, Color.Red);                }            }        }==== REPLACE        private async void MnuQuickScrapeText_Click(object? sender, EventArgs e)        {            await _session.QuickScrapeDomNodeAsync(tvDom.SelectedDomNode, lstClients.SelectedItem as BrowserClient);        }        private void AddFieldFromSelectedDomNode(ScrapeDefinition scrape, bool matchAllElements)        {            var field = _session.AddFieldFromDomNode(scrape, tvDom.SelectedDomNode, matchAllElements, tvDom.RootDomNode);            if (field == null) return;            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                lstScrapeFields.Items.Add(field);                lstScrapeFields.SelectedItem = field;            }        }        private void SetContainerFromSelectedDomNode(ScrapeDefinition scrape)        {            if (_session.SetContainerFromDomNode(scrape, tvDom.SelectedDomNode, tvDom.RootDomNode) == null)                return;            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                LoadSelectedScrapeToUi();            }        }        private void SetPaginationNextFromSelectedDomNode(ScrapeDefinition scrape)        {            if (_session.SetPaginationNextFromDomNode(scrape, tvDom.SelectedDomNode, tvDom.RootDomNode) == null)                return;            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                LoadSelectedScrapeToUi();            }        }        private async void BtnPreviewScrape_Click(object? sender, EventArgs e)        {            btnPreviewScrape.Enabled = false;            try            {                await _session.PreviewScrapeAsync(                    chkLstScrapes.SelectedItem as ScrapeDefinition,                    lstClients.SelectedItem as BrowserClient);            }            finally            {                btnPreviewScrape.Enabled = true;            }        }        private async void BtnRunAllScrapes_Click(object? sender, EventArgs e)        {            btnRunAllScrapes.Enabled = false;            try            {                await _session.RunActiveScrapesAsync(lstClients.SelectedItem as BrowserClient);            }            finally            {                btnRunAllScrapes.Enabled = true;            }        }        private void DisplayScrapeResult(ScrapeResult result)        {            lblScrapeStatus.Text = result.GetStatusSummary();            dgvScrapePreview.DataSource = result.ToDataTable();            txtScrapeJsonPreview.Text = result.ToJson(true, true);        }        private void BtnCopyScrapeJson_Click(object? sender, EventArgs e)        {            string? json = _session.GetLastScrapeJsonForCopy();            if (json != null)            {                Clipboard.SetText(json);            }        }        private void BtnExportScrapeJson_Click(object? sender, EventArgs e)        {            if (!_session.EnsureHasScrapeResultForExport() || _session.LastScrapeResult == null)                return;            using var sfd = new SaveFileDialog            {                Filter = \u0022JSON Files (.json)|.json|All Files (.)|.\u0022,                Title = \u0022Export Scrape Results as JSON\u0022,                DefaultExt = \u0022json\u0022,                FileName = _session.LastScrapeResult.GetSuggestedFileName(\u0022json\u0022)            };            if (sfd.ShowDialog() == DialogResult.OK)            {                _session.ExportLastScrapeToJsonFile(sfd.FileName);            }        }        private void BtnExportScrapeCsv_Click(object? sender, EventArgs e)        {            if (!_session.EnsureHasScrapeResultForExport() || _session.LastScrapeResult == null)                return;            using var sfd = new SaveFileDialog            {                Filter = \u0022CSV Files (.csv)|.csv|All Files (.)|.\u0022,                Title = \u0022Export Scrape Results as CSV\u0022,                DefaultExt = \u0022csv\u0022,                FileName = _session.LastScrapeResult.GetSuggestedFileName(\u0022csv\u0022)            };            if (sfd.ShowDialog() == DialogResult.OK)            {                _session.ExportLastScrapeToCsvFile(sfd.FileName);            }        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private async Task ExecuteSiteDumpFromUiAsync(SiteDumpType dumpType)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            var options = BuildSiteDumpOptionsFromUi();            SetDumpButtonsEnabled(false);            lblDumpStatus.Text = $\u0022Dumping {dumpType} from {client.InstanceId}...\u0022;            try            {                SiteDumpResult result = await client.DumpSiteAsync(dumpType, options, _siteDumper);                DisplaySiteDumpResult(result);            }            catch (Exception ex)            {                lblDumpStatus.Text = $\u0022Dump failed: {ex.Message}\u0022;                Log($\u0022[ERR] Site dump ({dumpType}) failed: {ex.Message}\u0022, Color.Red);            }            finally            {                SetDumpButtonsEnabled(true);            }        }        private void DisplaySiteDumpResult(SiteDumpResult result)        {            _lastSiteDumpResult = result;            lblDumpStatus.Text = result.GetStatusSummary();            txtCombinedHtmlSource.Text = result.GetCombinedHtml();            txtCombinedCssSource.Text = result.GetCombinedCss();            txtCombinedJsSource.Text = result.GetCombinedJavaScript();            RefreshDumpedResourcesList();            tabDumpViewers.SelectedTab = result.GetDefaultViewMode() switch            {                SiteDumpViewMode.CombinedHtml =\u003E tabCombinedHtmlView,                SiteDumpViewMode.CombinedCss =\u003E tabCombinedCssView,                SiteDumpViewMode.CombinedJavaScript =\u003E tabCombinedJsView,                _ =\u003E tabSelectedResourceView            };        }        private void RefreshDumpedResourcesList()        {            lstDumpedResources.BeginUpdate();            try            {                lstDumpedResources.Items.Clear();                if (_lastSiteDumpResult == null)                {                    txtDumpedResourceDetails.Text = string.Empty;                    txtSelectedResourceSource.Text = string.Empty;                    return;                }                string filter = txtFilterResources.Text.Trim();                foreach (var res in _lastSiteDumpResult.FilterResources(filter))                {                    lstDumpedResources.Items.Add(res);                }                if (lstDumpedResources.Items.Count \u003E 0)                {                    lstDumpedResources.SelectedIndex = 0;                }                else                {                    txtDumpedResourceDetails.Text = string.Empty;                    txtSelectedResourceSource.Text = string.Empty;                }            }            finally            {                lstDumpedResources.EndUpdate();            }        }        private void LstDumpedResources_SelectedIndexChanged(object? sender, EventArgs e)        {            if (lstDumpedResources.SelectedItem is SiteResourceItem resource)            {                txtDumpedResourceDetails.Text = resource.GetFormattedDetails();                txtSelectedResourceSource.Text = resource.Content;            }        }        private SiteDumpViewMode GetActiveDumpViewMode()        {            if (tabDumpViewers.SelectedTab == tabCombinedHtmlView) return SiteDumpViewMode.CombinedHtml;            if (tabDumpViewers.SelectedTab == tabCombinedCssView) return SiteDumpViewMode.CombinedCss;            if (tabDumpViewers.SelectedTab == tabCombinedJsView) return SiteDumpViewMode.CombinedJavaScript;            return SiteDumpViewMode.SelectedResource;        }        private string GetActiveDumpViewerText(out string suggestedFileName)        {            suggestedFileName = \u0022dump.txt\u0022;            if (_lastSiteDumpResult == null)                return string.Empty;            var viewMode = GetActiveDumpViewMode();            var selectedRes = lstDumpedResources.SelectedItem as SiteResourceItem;            return _lastSiteDumpResult.GetViewContent(viewMode, selectedRes, out suggestedFileName);        }        private void BtnCopyCurrentDumpView_Click(object? sender, EventArgs e)        {            string content = GetActiveDumpViewerText(out string name);            if (string.IsNullOrEmpty(content))            {                Log(\u0022[WARN] No dumped source content in the active view to copy.\u0022, Color.Orange);                return;            }            Clipboard.SetText(content);            Log($\u0022[REV-ENG] Copied \u0027{name}\u0027 ({content.Length:N0} chars) to clipboard.\u0022, Color.Lime);        }        private void BtnSaveActiveDumpFile_Click(object? sender, EventArgs e)        {            if (_lastSiteDumpResult == null)            {                Log(\u0022[WARN] Please run a dump operation first.\u0022, Color.Orange);                return;            }            var viewMode = GetActiveDumpViewMode();            var selectedResource = lstDumpedResources.SelectedItem as SiteResourceItem;            string content = _lastSiteDumpResult.GetViewContent(viewMode, selectedResource, out string defaultFileName);            if (string.IsNullOrEmpty(content))            {                Log(\u0022[WARN] Active dump view is empty.\u0022, Color.Orange);                return;            }            using var sfd = new SaveFileDialog            {                Filter = \u0022All Files (.)|.|HTML Files (.html)|.html|CSS Files (.css)|.css|JavaScript Files (.js)|.js\u0022,                Title = viewMode == SiteDumpViewMode.SelectedResource ? \u0022Save Selected Resource\u0022 : \u0022Save Combined Dump Output\u0022,                FileName = defaultFileName            };            if (sfd.ShowDialog() == DialogResult.OK)            {                try                {                    _lastSiteDumpResult.SaveViewContentToFile(sfd.FileName, viewMode, selectedResource);                    Log($\u0022[REV-ENG] Saved \u0027{defaultFileName}\u0027 to {sfd.FileName}\u0022, Color.Lime);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Failed to save file: {ex.Message}\u0022, Color.Red);                }            }        }        private void BtnSaveDumpToFolder_Click(object? sender, EventArgs e)        {            if (_lastSiteDumpResult == null || !_lastSiteDumpResult.HasResources)            {                Log(\u0022[WARN] No site dump results available to save.\u0022, Color.Orange);                return;            }            using var fbd = new FolderBrowserDialog            {                Description = \u0022Select a destination folder to save all dumped HTML, CSS, and JavaScript files\u0022,                UseDescriptionForTitle = true            };            if (fbd.ShowDialog() == DialogResult.OK \u0026\u0026 !string.IsNullOrWhiteSpace(fbd.SelectedPath))            {                try                {                    string savedPath = _lastSiteDumpResult.SaveToDirectory(fbd.SelectedPath);                    Log($\u0022[REV-ENG] Saved {_lastSiteDumpResult.TotalResourceCount} resource(s) ({_lastSiteDumpResult.GetFormattedTotalSize()}) to {savedPath}\u0022, Color.Lime);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Failed to save dump to folder: {ex.Message}\u0022, Color.Red);                }            }        }==== REPLACE        private async Task ExecuteSiteDumpFromUiAsync(SiteDumpType dumpType)        {            SetDumpButtonsEnabled(false);            try            {                await _session.ExecuteSiteDumpAsync(                    dumpType,                    BuildSiteDumpOptionsFromUi(),                    lstClients.SelectedItem as BrowserClient);            }            finally            {                SetDumpButtonsEnabled(true);            }        }        private void DisplaySiteDumpResult(SiteDumpResult result)        {            lblDumpStatus.Text = result.GetStatusSummary();            txtCombinedHtmlSource.Text = result.GetCombinedHtml();            txtCombinedCssSource.Text = result.GetCombinedCss();            txtCombinedJsSource.Text = result.GetCombinedJavaScript();            RefreshDumpedResourcesList();            tabDumpViewers.SelectedTab = result.GetDefaultViewMode() switch            {                SiteDumpViewMode.CombinedHtml =\u003E tabCombinedHtmlView,                SiteDumpViewMode.CombinedCss =\u003E tabCombinedCssView,                SiteDumpViewMode.CombinedJavaScript =\u003E tabCombinedJsView,                _ =\u003E tabSelectedResourceView            };        }        private void RefreshDumpedResourcesList()        {            lstDumpedResources.BeginUpdate();            try            {                lstDumpedResources.Items.Clear();                if (_session.LastSiteDumpResult == null)                {                    txtDumpedResourceDetails.Text = string.Empty;                    txtSelectedResourceSource.Text = string.Empty;                    return;                }                string filter = txtFilterResources.Text.Trim();                foreach (var res in _session.LastSiteDumpResult.FilterResources(filter))                {                    lstDumpedResources.Items.Add(res);                }                if (lstDumpedResources.Items.Count \u003E 0)                {                    lstDumpedResources.SelectedIndex = 0;                }                else                {                    txtDumpedResourceDetails.Text = string.Empty;                    txtSelectedResourceSource.Text = string.Empty;                }            }            finally            {                lstDumpedResources.EndUpdate();            }        }        private void LstDumpedResources_SelectedIndexChanged(object? sender, EventArgs e)        {            if (lstDumpedResources.SelectedItem is SiteResourceItem resource)            {                txtDumpedResourceDetails.Text = resource.GetFormattedDetails();                txtSelectedResourceSource.Text = resource.Content;            }        }        private SiteDumpViewMode GetActiveDumpViewMode()        {            if (tabDumpViewers.SelectedTab == tabCombinedHtmlView) return SiteDumpViewMode.CombinedHtml;            if (tabDumpViewers.SelectedTab == tabCombinedCssView) return SiteDumpViewMode.CombinedCss;            if (tabDumpViewers.SelectedTab == tabCombinedJsView) return SiteDumpViewMode.CombinedJavaScript;            return SiteDumpViewMode.SelectedResource;        }        private string GetActiveDumpViewerText(out string suggestedFileName)        {            return _session.GetActiveDumpViewText(                GetActiveDumpViewMode(),                lstDumpedResources.SelectedItem as SiteResourceItem,                out suggestedFileName);        }        private void BtnCopyCurrentDumpView_Click(object? sender, EventArgs e)        {            string content = GetActiveDumpViewerText(out string name);            if (string.IsNullOrEmpty(content))            {                _session.Log(\u0022WARN\u0022, \u0022No dumped source content in the active view to copy.\u0022, AutomationLogLevel.Warning);                return;            }            Clipboard.SetText(content);            _session.Log(\u0022REV-ENG\u0022, $\u0022Copied \u0027{name}\u0027 ({content.Length:N0} chars) to clipboard.\u0022, AutomationLogLevel.Success);        }        private void BtnSaveActiveDumpFile_Click(object? sender, EventArgs e)        {            if (_session.LastSiteDumpResult == null)            {                _session.Log(\u0022WARN\u0022, \u0022Please run a dump operation first.\u0022, AutomationLogLevel.Warning);                return;            }            var viewMode = GetActiveDumpViewMode();            var selectedResource = lstDumpedResources.SelectedItem as SiteResourceItem;            string content = _session.GetActiveDumpViewText(viewMode, selectedResource, out string defaultFileName);            if (string.IsNullOrEmpty(content))            {                _session.Log(\u0022WARN\u0022, \u0022Active dump view is empty.\u0022, AutomationLogLevel.Warning);                return;            }            using var sfd = new SaveFileDialog            {                Filter = \u0022All Files (.)|.|HTML Files (.html)|.html|CSS Files (.css)|.css|JavaScript Files (.js)|.js\u0022,                Title = viewMode == SiteDumpViewMode.SelectedResource ? \u0022Save Selected Resource\u0022 : \u0022Save Combined Dump Output\u0022,                FileName = defaultFileName            };            if (sfd.ShowDialog() == DialogResult.OK)            {                _session.SaveActiveDumpViewToFile(sfd.FileName, viewMode, selectedResource, defaultFileName);            }        }        private void BtnSaveDumpToFolder_Click(object? sender, EventArgs e)        {            if (_session.LastSiteDumpResult == null || !_session.LastSiteDumpResult.HasResources)            {                _session.Log(\u0022WARN\u0022, \u0022No site dump results available to save.\u0022, AutomationLogLevel.Warning);                return;            }            using var fbd = new FolderBrowserDialog            {                Description = \u0022Select a destination folder to save all dumped HTML, CSS, and JavaScript files\u0022,                UseDescriptionForTitle = true            };            if (fbd.ShowDialog() == DialogResult.OK \u0026\u0026 !string.IsNullOrWhiteSpace(fbd.SelectedPath))            {                _session.SaveLastDumpToFolder(fbd.SelectedPath);            }        }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
      "ModelExplanation": "All remaining non-UI logic in \u0060TestBedApp\u0060 has been migrated into \u0060BrowserAutomationFramework.dll\u0060, leaving \u0060TestBedApp\u0060 (\u0060MainForm.cs\u0060 and \u0060Controls\\DomTreeView.cs\u0060) as a thin WinForms UI wrapper around the framework:\n\n1. **Multi-Engine Studio Session Controller (\u0060AutomationStudioSession.cs\u0060)**:\n   - Created \u0060AutomationStudioSession\u0060 in \u0060BrowserAutomationFramework.Automation\u0060 to own and coordinate \u0060AutomationProject\u0060, \u0060AutomationServer\u0060, \u0060AutomationRunner\u0060, \u0060DataScraper\u0060, \u0060SiteDumper\u0060, \u0060LastScrapeResult\u0060, and \u0060LastSiteDumpResult\u0060.\n   - Centralized server start/stop lifecycle, Chrome Extension synchronization, userscript generation, project file load/save, raw/eval/click/set-value command execution, point-and-click sequence/scrape builder actions, scrape previews/exports, and reverse-engineering site dump execution/saving.\n2. **Unified Telemetry \u0026 Log Event Pipeline (\u0060BrowserEventArgs.cs\u0060)**:\n   - Added \u0060AutomationLogLevel\u0060, \u0060AutomationLogLevelExtensions.GetDefaultRgb(...)\u0060, and \u0060AutomationLogEventArgs\u0060 so host applications can subscribe to a single \u0060OnLog\u0060 event with pre-formatted timestamps, category prefixes, and default dark-mode RGB color tuples.\n3. **Server \u0026 Client DOM/List Helpers (\u0060AutomationServer.cs\u0060, \u0060BrowserClient.cs\u0060, \u0060ReactExtensions.cs\u0060)**:\n   - Added \u0060AutomationServer.GetExtensionStatusMessage(...)\u0060, \u0060AutomationServer.UpsertClientInList(...)\u0060, \u0060AutomationServer.RemoveClientFromList(...)\u0060, \u0060AutomationServer.RefreshClientInList(...)\u0060, and \u0060skipIfAlreadyActive\u0060 handling in \u0060SwitchToExtensionTabAsync(...)\u0060.\n   - Added \u0060BrowserClient.HandleElementClickedOrRefreshDomAsync(...)\u0060 to encapsulate checking the current snapshot before falling back to a coalesced DOM refresh.\n   - Added \u0060ReactExtensions.GeneralizeContainerSelector(...)\u0060 and \u0060ReactExtensions.HighlightContainerOrSelectorAsync(...)\u0060.\n4. **Virtualized DOM Tree Viewport \u0026 Scroll Geometry (\u0060DomTreeSnapshot.cs\u0060 \u0026 \u0060DomTreeView.cs\u0060)**:\n   - Added \u0060DomRect\u0060, scrollbar/corner layout calculation (\u0060CalculateScrollBarLayout\u0060, \u0060GetViewportBounds\u0060), ancestor guide-line X enumeration (\u0060EnumerateAncestorGuideLineXs\u0060), and viewport-based \u0060ApplyMouseWheel\u0060 overloads to \u0060DomTreeViewportState\u0060 and \u0060DomScrollBarMetrics\u0060.\n   - Updated \u0060DomTreeView.cs\u0060 and \u0060MainForm.cs\u0060 to delegate directly to these DLL APIs.\n\n### How to Test\n1. Build the solution (\u0060dotnet build\u0060) and verify both \u0060BrowserAutomationFramework\u0060 and \u0060TestBedApp\u0060 compile with zero warnings or errors.\n2. Launch \u0060TestBedApp\u0060, click **Start Server**, connect a tab via the Chrome Extension or Tampermonkey, and verify real-time logs, DOM Explorer selection/middle-click inspection, Automation Editor execution, Data Scraper preview/export, and Reverse Engineering dumps.",
