22includePerformanceResourceScripts\u0022)]\n        public bool IncludePerformanceResourceScripts { get; set; } = true;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets whether accessible \u003Cc\u003E\u0026lt;iframe\u0026gt;\u003C/c\u003E documents are included when dumping HTML.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022includeIframes\u0022)]\n        public bool IncludeIframes { get; set; } = true;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the timeout in milliseconds for fetching individual external CSS/JS assets.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022fetchTimeoutMs\u0022)]\n        public int FetchTimeoutMs { get; set; } = 15000;\n\n        /// \u003Csummary\u003E\n        /// Creates a \u003Csee cref=\u0022SiteDumpOptions\u0022/\u003E instance configured from high-level inclusion flags.\n        /// \u003C/summary\u003E\n        public static SiteDumpOptions Create(\n            bool includeExternal = true,\n            bool includeInline = true,\n            bool includeDynamicScripts = true,\n            bool includeIframes = true,\n            int fetchTimeoutMs = 15000)\n        {\n            return new SiteDumpOptions\n            {\n                IncludeExternalCss = includeExternal,\n                IncludeExternalScripts = includeExternal,\n                IncludeInlineCss = includeInline,\n                IncludeConstructedCss = includeInline,\n                IncludeInlineScripts = includeInline,\n                IncludePerformanceResourceScripts = includeDynamicScripts,\n                IncludeIframes = includeIframes,\n                FetchTimeoutMs = fetchTimeoutMs\n            };\n        }\n\n        /// \u003Csummary\u003E\n        /// Creates a shallow copy of this \u003Csee cref=\u0022SiteDumpOptions\u0022/\u003E instance.\n        /// \u003C/summary\u003E\n        public SiteDumpOptions Clone()\n        {\n            return new SiteDumpOptions\n            {\n                IncludeHtml = IncludeHtml,\n                IncludeCss = IncludeCss,\n                IncludeJavaScript = IncludeJavaScript,\n                IncludeInlineCss = IncludeInlineCss,\n                IncludeExternalCss = IncludeExternalCss,\n                IncludeConstructedCss = IncludeConstructedCss,\n                IncludeInlineScripts = IncludeInlineScripts,\n                IncludeExternalScripts = IncludeExternalScripts,\n                IncludePerformanceResourceScripts = IncludePerformanceResourceScripts,\n                IncludeIframes = IncludeIframes,\n                FetchTimeoutMs = FetchTimeoutMs\n            };\n        }\n\n        /// \u003Csummary\u003E\n        /// Returns a \u003Csee cref=\u0022SiteDumpOptions\u0022/\u003E copy with \u003Csee cref=\u0022IncludeHtml\u0022/\u003E, \u003Csee cref=\u0022IncludeCss\u0022/\u003E, and \u003Csee cref=\u0022IncludeJavaScript\u0022/\u003E set according to \u003Cparamref name=\u0022dumpType\u0022/\u003E.\n        /// \u003C/summary\u003E\n        public static SiteDumpOptions ForType(SiteDumpType dumpType, SiteDumpOptions? baseOptions = null)\n        {\n            var opts = baseOptions?.Clone() ?? new SiteDumpOptions();\n            opts.IncludeHtml = dumpType == SiteDumpType.Html || dumpType == SiteDumpType.All;\n            opts.IncludeCss = dumpType == SiteDumpType.Css || dumpType == SiteDumpType.All;\n            opts.IncludeJavaScript = dumpType == SiteDumpType.JavaScript || dumpType == SiteDumpType.All;\n            return opts;\n        }\n    }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\SiteDumpResult.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n    public class SiteDumpResult\n    {\n        [JsonPropertyName(\u0022dumpType\u0022)]\n        public SiteDumpType DumpType { get; set; } = SiteDumpType.All;\n\n        [JsonPropertyName(\u0022pageUrl\u0022)]\n        public string PageUrl { get; set; } = string.Empty;\n\n        [JsonPropertyName(\u0022pageTitle\u0022)]\n        public string PageTitle { get; set; } = string.Empty;\n\n        [JsonPropertyName(\u0022timestampUtc\u0022)]\n        public DateTime TimestampUtc { get; set; } = DateTime.UtcNow;\n\n        [JsonPropertyName(\u0022success\u0022)]\n        public bool Success { get; set; } = true;\n\n        [JsonPropertyName(\u0022errorMessage\u0022)]\n        public string? ErrorMessage { get; set; }\n\n        [JsonPropertyName(\u0022html\u0022)]\n        public string Html { get; set; } = string.Empty;\n\n        [JsonPropertyName(\u0022htmlResources\u0022)]\n        public List\u003CSiteResourceItem\u003E HtmlResources { get; set; } = new();\n\n        [JsonPropertyName(\u0022cssResources\u0022)]\n        public List\u003CSiteResourceItem\u003E CssResources { get; set; } = new();\n\n        [JsonPropertyName(\u0022javascriptResources\u0022)]\n        public List\u003CSiteResourceItem\u003E JavaScriptResources { get; set; } = new();\n\n        [JsonIgnore]\n        public int TotalResourceCount =\u003E HtmlResources.Count \u002B CssResources.Count \u002B JavaScriptResources.Count;\n\n        [JsonIgnore]\n        public long TotalSizeBytes =\u003E GetAllResources().Sum(r =\u003E r.SizeBytes \u003E 0 ? r.SizeBytes : Encoding.UTF8.GetByteCount(r.Content ?? string.Empty));\n==== REPLACE\n    public class SiteDumpResult\n    {\n        /// \u003Csummary\u003E\n        /// Gets or sets the \u003Csee cref=\u0022SiteDumpType\u0022/\u003E that was requested for this dump.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022dumpType\u0022)]\n        public SiteDumpType DumpType { get; set; } = SiteDumpType.All;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the URL of the page from which resources were dumped.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022pageUrl\u0022)]\n        public string PageUrl { get; set; } = string.Empty;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the document title of the dumped page.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022pageTitle\u0022)]\n        public string PageTitle { get; set; } = string.Empty;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the UTC timestamp when the dump completed.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022timestampUtc\u0022)]\n        public DateTime TimestampUtc { get; set; } = DateTime.UtcNow;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets whether the dump operation succeeded.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022success\u0022)]\n        public bool Success { get; set; } = true;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the error message if \u003Csee cref=\u0022Success\u0022/\u003E is \u003Cc\u003Efalse\u003C/c\u003E.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022errorMessage\u0022)]\n        public string? ErrorMessage { get; set; }\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the primary serialized HTML of the main document.\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022html\u0022)]\n        public string Html { get; set; } = string.Empty;\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the list of extracted HTML resources (main document and accessible iframes).\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022htmlResources\u0022)]\n        public List\u003CSiteResourceItem\u003E HtmlResources { get; set; } = new();\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the list of extracted CSS stylesheet resources (external, inline, and constructed).\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022cssResources\u0022)]\n        public List\u003CSiteResourceItem\u003E CssResources { get; set; } = new();\n\n        /// \u003Csummary\u003E\n        /// Gets or sets the list of extracted JavaScript resources (external, inline, and dynamically loaded).\n        /// \u003C/summary\u003E\n        [JsonPropertyName(\u0022javascriptResources\u0022)]\n        public List\u003CSiteResourceItem\u003E JavaScriptResources { get; set; } = new();\n\n        /// \u003Csummary\u003E\n        /// Gets the total number of HTML, CSS, and JavaScript resources captured in this dump.\n        /// \u003C/summary\u003E\n        [JsonIgnore]\n        public int TotalResourceCount =\u003E HtmlResources.Count \u002B CssResources.Count \u002B JavaScriptResources.Count;\n\n        /// \u003Csummary\u003E\n        /// Gets the combined size in bytes across all captured resources.\n        /// \u003C/summary\u003E\n        [JsonIgnore]\n        public long TotalSizeBytes =\u003E GetAllResources().Sum(r =\u003E r.SizeBytes \u003E 0 ? r.SizeBytes : Encoding.UTF8.GetByteCount(r.Content ?? string.Empty));\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        /// \u003Csummary\u003E\n        /// Returns a default file name (such as \u003Cc\u003E\u0022combined.html\u0022\u003C/c\u003E, \u003Cc\u003E\u0022combined.css\u0022\u003C/c\u003E, or \u003Cc\u003E\u0022combined.js\u0022\u003C/c\u003E) for the given \u003Csee cref=\u0022SiteDumpType\u0022/\u003E.\n        /// \u003C/summary\u003E\n        public static string GetSuggestedCombinedFileName(SiteDumpType viewType)\n        {\n            return viewType switch\n            {\n                SiteDumpType.Html =\u003E \u0022combined.html\u0022,\n                SiteDumpType.Css =\u003E \u0022combined.css\u0022,\n                SiteDumpType.JavaScript =\u003E \u0022combined.js\u0022,\n                _ =\u003E \u0022combined_dump.txt\u0022\n            };\n        }\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Returns a default file name (such as \u003Cc\u003E\u0022combined.html\u0022\u003C/c\u003E, \u003Cc\u003E\u0022combined.css\u0022\u003C/c\u003E, or \u003Cc\u003E\u0022combined.js\u0022\u003C/c\u003E) for the given \u003Csee cref=\u0022SiteDumpType\u0022/\u003E.\n        /// \u003C/summary\u003E\n        public static string GetSuggestedCombinedFileName(SiteDumpType viewType)\n        {\n            return viewType switch\n            {\n                SiteDumpType.Html =\u003E \u0022combined.html\u0022,\n                SiteDumpType.Css =\u003E \u0022combined.css\u0022,\n                SiteDumpType.JavaScript =\u003E \u0022combined.js\u0022,\n                _ =\u003E \u0022combined_dump.txt\u0022\n            };\n        }\n\n        /// \u003Csummary\u003E\n        /// Resolves the source text and suggested export filename for either a specific \u003Cparamref name=\u0022selectedResource\u0022/\u003E or a combined \u003Cparamref name=\u0022viewType\u0022/\u003E.\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022viewType\u0022\u003EThe combined dump type to view if \u003Cparamref name=\u0022selectedResource\u0022/\u003E is null.\u003C/param\u003E\n        /// \u003Cparam name=\u0022selectedResource\u0022\u003EAn optional individual resource item to view instead of combined output.\u003C/param\u003E\n        /// \u003Cparam name=\u0022suggestedFileName\u0022\u003EOutputs the recommended filename for saving the returned content.\u003C/param\u003E\n        /// \u003Creturns\u003EThe resolved resource or combined source text.\u003C/returns\u003E\n        public string GetViewContent(SiteDumpType? viewType, SiteResourceItem? selectedResource, out string suggestedFileName)\n        {\n            if (selectedResource != null)\n            {\n                suggestedFileName = string.IsNullOrWhiteSpace(selectedResource.Name) ? \u0022resource.txt\u0022 : selectedResource.Name;\n                return selectedResource.Content;\n            }\n\n            var resolvedType = viewType ?? DumpType;\n            suggestedFileName = GetSuggestedCombinedFileName(resolvedType);\n            return GetCombinedContent(resolvedType);\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\SiteResourceItem.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nnamespace BrowserAutomationFramework.Models\n{\n    public enum SiteResourceType\n    {\n        Html,\n        Css,\n        JavaScript\n    }\n\n    public enum SiteDumpType\n    {\n        Html,\n        Css,\n        JavaScript,\n        All\n    }\n\n    public class SiteResourceItem\n    {\n        [JsonPropertyName(\u0022name\u0022)]\n        public string Name { get; set; } = string.Empty;\n\n        [JsonPropertyName(\u0022category\u0022)]\n        public SiteResourceType Category { get; set; } = SiteResourceType.Html;\n\n        [JsonPropertyName(\u0022sourceType\u0022)]\n        public string SourceType { get; set; } = string.Empty;\n\n        [JsonPropertyName(\u0022url\u0022)]\n        public string Url { get; set; } = string.Empty;\n\n        [JsonPropertyName(\u0022content\u0022)]\n        public string Content { get; set;Anti-Agent v1.0\n\n### Summary of Changes\n\n1. **Verified and Tightened WinForms UI Wrapper (\u0060TestBedApp\u0060)**:\n   - Updated \u0060MainForm\u0060 and \u0060DomTreeView\u0060 so that all domain/model operations delegate directly to \u0060BrowserAutomationFramework\u0060:\n     - \u0060DomTreeView.ApplySnapshot\u0060 now delegates expansion state restoration, default root/body expansion, and target ancestor expansion to \u0060DomTreeSnapshot.PrepareExpandedState\u0060.\n     - \u0060MainForm.BtnAddStep_Click\u0060 and \u0060MainForm.BtnAddScrapeField_Click\u0060 now use \u0060AutomationSequence.AddStep\u0060 and \u0060ScrapeDefinition.AddField\u0060.\n     - \u0060MainForm.BtnRunAutomation_Click\u0060, \u0060MainForm.BtnPreviewScrape_Click\u0060, and \u0060MainForm.BtnRunAllScrapes_Click\u0060 now delegate directly to \u0060BrowserClient\u0060 extension methods (\u0060ExecuteProjectAsync\u0060, \u0060ExecuteScrapeAsync\u0060, \u0060ExecuteProjectScrapesCombinedAsync\u0060) and \u0060AutomationProject.GetActiveSequences()\u0060 / \u0060GetActiveScrapes()\u0060.\n     - \u0060MainForm.BuildSiteDumpOptionsFromUi\u0060 and \u0060MainForm.GetActiveDumpViewerText\u0060 now delegate to \u0060SiteDumpOptions.Create\u0060 and \u0060SiteDumpResult.GetViewContent\u0060.\n\n2. **Full XML API Documentation (\u0060BrowserAutomationFramework\u0060)**:\n   - Added complete XML documentation (\u0060\u003Csummary\u003E\u0060, \u0060\u003Cparam\u003E\u0060, \u0060\u003Creturns\u003E\u0060, \u0060\u003Ctypeparam\u003E\u0060) to every public class, struct, enum, enum value, delegate, event, property, constructor, and method across all namespaces (\u0060Automation\u0060, \u0060Extensions\u0060, \u0060Generators\u0060, \u0060Models\u0060, \u0060ReverseEngineering\u0060, \u0060Scraping\u0060, and \u0060Server\u0060).\n   - Removed the \u0060CS1591\u0060 suppression from \u0060BrowserAutomationFramework.csproj\u0060 so the compiler enforces 100% XML documentation coverage on build.\n\n### How to Test\n\n1. Build the solution (\u0060dotnet build\u0060) and verify that \u0060BrowserAutomationFramework.xml\u0060 is generated with zero \u0060CS1591\u0060 warnings.\n2. Run \u0060TestBedApp\u0060 and verify that DOM exploration, Automation Editor sequences, Data Scraper previews/runs, and Reverse Engineering dumps operate as expected.\n\n--CODESTART--\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\BrowserAutomationFramework.csproj**\n\n\u0060\u0060\u0060\ncsproj\u003C\u003C\u003C\u003C SEARCH    \u003CGenerateDocumentationFile\u003Etrue\u003C/GenerateDocumentationFile\u003E    \u003CNoWarn\u003E$(NoWarn);1591\u003C/NoWarn\u003E  \u003C/PropertyGroup\u003E==== REPLACE    \u003CGenerateDocumentationFile\u003Etrue\u003C/GenerateDocumentationFile\u003E  \u003C/PropertyGroup\u003E\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Automation\\AutomationRunner.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH    public class AutomationRunner    {        public delegate Task\u003CCommandResult?\u003E StepHandlerDelegate(BrowserClient client, AutomationStep step, CancellationToken cancellationToken);        private readonly ConcurrentDictionary\u003CAutomationActionType, StepHandlerDelegate\u003E _stepHandlers = new();        private readonly ConcurrentDictionary\u003Cstring, StepHandlerDelegate\u003E _customCommandHandlers = new(StringComparer.OrdinalIgnoreCase);        private readonly ConcurrentDictionary\u003Cstring, ScrapeDefinition\u003E _registeredScrapes = new(StringComparer.OrdinalIgnoreCase);        public event EventHandler\u003CAutomationSequenceEventArgs\u003E? OnSequenceStarted;        public event EventHandler\u003CAutomationSequenceEventArgs\u003E? OnSequenceCompleted;        public event EventHandler\u003CAutomationStepEventArgs\u003E? OnStepStarted;        public event EventHandler\u003CAutomationStepEventArgs\u003E? OnStepCompleted;        public event EventHandler\u003CAutomationStepEventArgs\u003E? OnStepFailed;        public event EventHandler\u003CScrapeEventArgs\u003E? OnScrapeCompleted;        public event EventHandler\u003CSiteDumpEventArgs\u003E? OnSiteDumpCompleted;        public AutomationRunner()        {            RegisterDefaultHandlers();        }==== REPLACE    public class AutomationRunner    {        /// \u003Csummary\u003E        /// Represents an asynchronous handler that executes a single \u003Csee cref=\u0022AutomationStep\u0022/\u003E against a connected \u003Csee cref=\u0022BrowserClient\u0022/\u003E.        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022client\u0022\u003EThe target browser client.\u003C/param\u003E        /// \u003Cparam name=\u0022step\u0022\u003EThe automation step to execute.\u003C/param\u003E        /// \u003Cparam name=\u0022cancellationToken\u0022\u003EA token to monitor for cancellation requests.\u003C/param\u003E        /// \u003Creturns\u003EA task representing the asynchronous operation, containing the optional \u003Csee cref=\u0022CommandResult\u0022/\u003E.\u003C/returns\u003E        public delegate Task\u003CCommandResult?\u003E StepHandlerDelegate(BrowserClient client, AutomationStep step, CancellationToken cancellationToken);        private readonly ConcurrentDictionary\u003CAutomationActionType, StepHandlerDelegate\u003E _stepHandlers = new();        private readonly ConcurrentDictionary\u003Cstring, StepHandlerDelegate\u003E _customCommandHandlers = new(StringComparer.OrdinalIgnoreCase);        private readonly ConcurrentDictionary\u003Cstring, ScrapeDefinition\u003E _registeredScrapes = new(StringComparer.OrdinalIgnoreCase);        /// \u003Csummary\u003E        /// Raised when an \u003Csee cref=\u0022AutomationSequence\u0022/\u003E begins execution.        /// \u003C/summary\u003E        public event EventHandler\u003CAutomationSequenceEventArgs\u003E? OnSequenceStarted;        /// \u003Csummary\u003E        /// Raised when an \u003Csee cref=\u0022AutomationSequence\u0022/\u003E finishes executing all of its steps.        /// \u003C/summary\u003E        public event EventHandler\u003CAutomationSequenceEventArgs\u003E? OnSequenceCompleted;        /// \u003Csummary\u003E        /// Raised immediately before an individual \u003Csee cref=\u0022AutomationStep\u0022/\u003E is executed.        /// \u003C/summary\u003E        public event EventHandler\u003CAutomationStepEventArgs\u003E? OnStepStarted;        /// \u003Csummary\u003E        /// Raised when an individual \u003Csee cref=\u0022AutomationStep\u0022/\u003E completes successfully.        /// \u003C/summary\u003E        public event EventHandler\u003CAutomationStepEventArgs\u003E? OnStepCompleted;        /// \u003Csummary\u003E        /// Raised when an individual \u003Csee cref=\u0022AutomationStep\u0022/\u003E throws an exception during execution.        /// \u003C/summary\u003E        public event EventHandler\u003CAutomationStepEventArgs\u003E? OnStepFailed;        /// \u003Csummary\u003E        /// Raised when an \u003Csee cref=\u0022AutomationActionType.Scrape\u0022/\u003E step finishes extracting data.        /// \u003C/summary\u003E        public event EventHandler\u003CScrapeEventArgs\u003E? OnScrapeCompleted;        /// \u003Csummary\u003E        /// Raised when an \u003Csee cref=\u0022AutomationActionType.DumpSite\u0022/\u003E step finishes dumping site resources.        /// \u003C/summary\u003E        public event EventHandler\u003CSiteDumpEventArgs\u003E? OnSiteDumpCompleted;        /// \u003Csummary\u003E        /// Initializes a new instance of the \u003Csee cref=\u0022AutomationRunner\u0022/\u003E class with all built-in step handlers registered.        /// \u003C/summary\u003E        public AutomationRunner()        {            RegisterDefaultHandlers();        }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Extensions\\ReactExtensions.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCHnamespace BrowserAutomationFramework.Extensions{    public static class ReactExtensions    {==== REPLACEnamespace BrowserAutomationFramework.Extensions{    /// \u003Csummary\u003E    /// Provides high-level extension methods on \u003Csee cref=\u0022BrowserClient\u0022/\u003E for React-compatible DOM interaction,    /// page navigation, DOM tree snapshots, element highlighting, data scraping, automation workflows, and reverse-engineering site dumps.    /// \u003C/summary\u003E    public static class ReactExtensions    {\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Generators\\ChromeExtensionGenerator.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH        public static string GenerateManifestJson()==== REPLACE        /// \u003Csummary\u003E        /// Generates the Manifest V3 \u003Cc\u003Emanifest.json\u003C/c\u003E content for the BAF Chrome Extension.        /// \u003C/summary\u003E        public static string GenerateManifestJson()\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        public static string GenerateContentRelayJs()==== REPLACE        /// \u003Csummary\u003E        /// Generates the \u003Cc\u003Econtent_relay.js\u003C/c\u003E script that runs in the \u003Cc\u003EISOLATED\u003C/c\u003E world and relays \u003Cc\u003EGM_xmlhttpRequest\u003C/c\u003E calls to the extension service worker.        /// \u003C/summary\u003E        public static string GenerateContentRelayJs()\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        public static string GenerateBackgroundJs(int defaultPort = 9999, IpcMode defaultMode = IpcMode.WebSocket)==== REPLACE        /// \u003Csummary\u003E        /// Generates the Manifest V3 \u003Cc\u003Ebackground.js\u003C/c\u003E service worker script configured for the specified default port and IPC mode.        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022defaultPort\u0022\u003EThe default local server port to connect to.\u003C/param\u003E        /// \u003Cparam name=\u0022defaultMode\u0022\u003EThe default IPC mode (\u003Csee cref=\u0022IpcMode.WebSocket\u0022/\u003E or \u003Csee cref=\u0022IpcMode.HttpPolling\u0022/\u003E).\u003C/param\u003E        public static string GenerateBackgroundJs(int defaultPort = 9999, IpcMode defaultMode = IpcMode.WebSocket)\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        public static string GeneratePopupHtml()==== REPLACE        /// \u003Csummary\u003E        /// Generates the HTML markup for the Chrome Extension\u0027s toolbar popup (\u003Cc\u003Epopup.html\u003C/c\u003E).        /// \u003C/summary\u003E        public static string GeneratePopupHtml()\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        public static string GeneratePopupJs(int defaultPort = 9999)==== REPLACE        /// \u003Csummary\u003E        /// Generates the Java