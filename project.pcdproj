ce.Name) ? \u0022resource.txt\u0022 : selectedResource.Name;                return selectedResource.Content;            }            var resolvedType = viewType ?? DumpType;            suggestedFileName = GetSuggestedCombinedFileName(resolvedType);            return GetCombinedContent(resolvedType);        }==== REPLACE        /// \u003Csummary\u003E        /// Returns the recommended initial \u003Csee cref=\u0022SiteDumpViewMode\u0022/\u003E to display after this dump completes.        /// \u003C/summary\u003E        public SiteDumpViewMode GetDefaultViewMode()        {            return DumpType switch            {                SiteDumpType.Html =\u003E SiteDumpViewMode.CombinedHtml,                SiteDumpType.Css =\u003E SiteDumpViewMode.CombinedCss,                SiteDumpType.JavaScript =\u003E SiteDumpViewMode.CombinedJavaScript,                _ =\u003E HasResources ? SiteDumpViewMode.SelectedResource : SiteDumpViewMode.CombinedAll            };        }        /// \u003Csummary\u003E        /// Resolves the source text and suggested export filename for the specified \u003Csee cref=\u0022SiteDumpViewMode\u0022/\u003E and optional \u003Cparamref name=\u0022selectedResource\u0022/\u003E.        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022viewMode\u0022\u003EThe active viewer mode.\u003C/param\u003E        /// \u003Cparam name=\u0022selectedResource\u0022\u003EThe currently selected resource when \u003Cparamref name=\u0022viewMode\u0022/\u003E is \u003Csee cref=\u0022SiteDumpViewMode.SelectedResource\u0022/\u003E.\u003C/param\u003E        /// \u003Cparam name=\u0022suggestedFileName\u0022\u003EOutputs the recommended filename for saving the returned content.\u003C/param\u003E        /// \u003Creturns\u003EThe resolved resource or combined source text.\u003C/returns\u003E        public string GetViewContent(SiteDumpViewMode viewMode, SiteResourceItem? selectedResource, out string suggestedFileName)        {            if (viewMode == SiteDumpViewMode.SelectedResource)            {                if (selectedResource == null)                {                    suggestedFileName = \u0022resource.txt\u0022;                    return string.Empty;                }                suggestedFileName = string.IsNullOrWhiteSpace(selectedResource.Name) ? \u0022resource.txt\u0022 : selectedResource.Name;                return selectedResource.Content;            }            var resolvedType = viewMode switch            {                SiteDumpViewMode.CombinedHtml =\u003E SiteDumpType.Html,                SiteDumpViewMode.CombinedCss =\u003E SiteDumpType.Css,                SiteDumpViewMode.CombinedJavaScript =\u003E SiteDumpType.JavaScript,                _ =\u003E DumpType            };            suggestedFileName = GetSuggestedCombinedFileName(resolvedType);            return GetCombinedContent(resolvedType);        }        /// \u003Csummary\u003E        /// Resolves the source text and suggested export filename for either a specific \u003Cparamref name=\u0022selectedResource\u0022/\u003E or a combined \u003Cparamref name=\u0022viewType\u0022/\u003E.        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022viewType\u0022\u003EThe combined dump type to view if \u003Cparamref name=\u0022selectedResource\u0022/\u003E is null.\u003C/param\u003E        /// \u003Cparam name=\u0022selectedResource\u0022\u003EAn optional individual resource item to view instead of combined output.\u003C/param\u003E        /// \u003Cparam name=\u0022suggestedFileName\u0022\u003EOutputs the recommended filename for saving the returned content.\u003C/param\u003E        /// \u003Creturns\u003EThe resolved resource or combined source text.\u003C/returns\u003E        public string GetViewContent(SiteDumpType? viewType, SiteResourceItem? selectedResource, out string suggestedFileName)        {            if (selectedResource != null)            {                suggestedFileName = string.IsNullOrWhiteSpace(selectedResource.Name) ? \u0022resource.txt\u0022 : selectedResource.Name;                return selectedResource.Content;            }            var resolvedType = viewType ?? DumpType;            suggestedFileName = GetSuggestedCombinedFileName(resolvedType);            return GetCombinedContent(resolvedType);        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        /// \u003Csummary\u003E        /// Saves the resolved view content (either a specific \u003Cparamref name=\u0022selectedResource\u0022/\u003E or the combined output for \u003Cparamref name=\u0022viewType\u0022/\u003E) to the specified file path.        /// \u003C/summary\u003E        public void SaveViewContentToFile(string filePath, SiteDumpType? viewType, SiteResourceItem? selectedResource)        {            if (string.IsNullOrWhiteSpace(filePath))                throw new ArgumentException(\u0022File path cannot be empty.\u0022, nameof(filePath));            if (selectedResource != null)            {                selectedResource.SaveToFile(filePath);                return;            }            SaveCombinedToFile(filePath, viewType ?? DumpType);        }        /// \u003Csummary\u003E        /// Asynchronously saves the resolved view content (either a specific \u003Cparamref name=\u0022selectedResource\u0022/\u003E or the combined output for \u003Cparamref name=\u0022viewType\u0022/\u003E) to the specified file path.        /// \u003C/summary\u003E        public Task SaveViewContentToFileAsync(            string filePath,            SiteDumpType? viewType,            SiteResourceItem? selectedResource,            CancellationToken cancellationToken = default)        {            if (string.IsNullOrWhiteSpace(filePath))                throw new ArgumentException(\u0022File path cannot be empty.\u0022, nameof(filePath));            if (selectedResource != null)            {                return selectedResource.SaveToFileAsync(filePath, cancellationToken);            }            return SaveCombinedToFileAsync(filePath, viewType ?? DumpType, cancellationToken);        }==== REPLACE        /// \u003Csummary\u003E        /// Saves the resolved view content for the specified \u003Csee cref=\u0022SiteDumpViewMode\u0022/\u003E to the given file path.        /// \u003C/summary\u003E        public void SaveViewContentToFile(string filePath, SiteDumpViewMode viewMode, SiteResourceItem? selectedResource)        {            if (string.IsNullOrWhiteSpace(filePath))                throw new ArgumentException(\u0022File path cannot be empty.\u0022, nameof(filePath));            if (viewMode == SiteDumpViewMode.SelectedResource)            {                if (selectedResource == null)                    throw new InvalidOperationException(\u0022No resource is selected to save.\u0022);                selectedResource.SaveToFile(filePath);                return;            }            var resolvedType = viewMode switch            {                SiteDumpViewMode.CombinedHtml =\u003E SiteDumpType.Html,                SiteDumpViewMode.CombinedCss =\u003E SiteDumpType.Css,                SiteDumpViewMode.CombinedJavaScript =\u003E SiteDumpType.JavaScript,                _ =\u003E DumpType            };            SaveCombinedToFile(filePath, resolvedType);        }        /// \u003Csummary\u003E        /// Asynchronously saves the resolved view content for the specified \u003Csee cref=\u0022SiteDumpViewMode\u0022/\u003E to the given file path.        /// \u003C/summary\u003E        public Task SaveViewContentToFileAsync(            string filePath,            SiteDumpViewMode viewMode,            SiteResourceItem? selectedResource,            CancellationToken cancellationToken = default)        {            if (string.IsNullOrWhiteSpace(filePath))                throw new ArgumentException(\u0022File path cannot be empty.\u0022, nameof(filePath));            if (viewMode == SiteDumpViewMode.SelectedResource)            {                if (selectedResource == null)                    throw new InvalidOperationException(\u0022No resource is selected to save.\u0022);                return selectedResource.SaveToFileAsync(filePath, cancellationToken);            }            var resolvedType = viewMode switch            {                SiteDumpViewMode.CombinedHtml =\u003E SiteDumpType.Html,                SiteDumpViewMode.CombinedCss =\u003E SiteDumpType.Css,                SiteDumpViewMode.CombinedJavaScript =\u003E SiteDumpType.JavaScript,                _ =\u003E DumpType            };            return SaveCombinedToFileAsync(filePath, resolvedType, cancellationToken);        }        /// \u003Csummary\u003E        /// Saves the resolved view content (either a specific \u003Cparamref name=\u0022selectedResource\u0022/\u003E or the combined output for \u003Cparamref name=\u0022viewType\u0022/\u003E) to the specified file path.        /// \u003C/summary\u003E        public void SaveViewContentToFile(string filePath, SiteDumpType? viewType, SiteResourceItem? selectedResource)        {            if (string.IsNullOrWhiteSpace(filePath))                throw new ArgumentException(\u0022File path cannot be empty.\u0022, nameof(filePath));            if (selectedResource != null)            {                selectedResource.SaveToFile(filePath);                return;            }            SaveCombinedToFile(filePath, viewType ?? DumpType);        }        /// \u003Csummary\u003E        /// Asynchronously saves the resolved view content (either a specific \u003Cparamref name=\u0022selectedResource\u0022/\u003E or the combined output for \u003Cparamref name=\u0022viewType\u0022/\u003E) to the specified file path.        /// \u003C/summary\u003E        public Task SaveViewContentToFileAsync(            string filePath,            SiteDumpType? viewType,            SiteResourceItem? selectedResource,            CancellationToken cancellationToken = default)        {            if (string.IsNullOrWhiteSpace(filePath))                throw new ArgumentException(\u0022File path cannot be empty.\u0022, nameof(filePath));            if (selectedResource != null)            {                return selectedResource.SaveToFileAsync(filePath, cancellationToken);            }            return SaveCombinedToFileAsync(filePath, viewType ?? DumpType, cancellationToken);        }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\DomTreeSnapshot.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH        /// \u003Csummary\u003E        /// Text node content token.        /// \u003C/summary\u003E        TextContent    }    /// \u003Csummary\u003E    /// Represents a single syntax-highlighted text segment of a serialized \u003Csee cref=\u0022DomNode\u0022/\u003E line.==== REPLACE        /// \u003Csummary\u003E        /// Text node content token.        /// \u003C/summary\u003E        TextContent    }    /// \u003Csummary\u003E    /// Provides default dark-theme RGB syntax highlighting colors for \u003Csee cref=\u0022DomTokenColor\u0022/\u003E values.    /// \u003C/summary\u003E    public static class DomTokenColorExtensions    {        /// \u003Csummary\u003E        /// Returns the default dark-mode RGB color tuple \u003Cc\u003E(R, G, B)\u003C/c\u003E for the specified \u003Csee cref=\u0022DomTokenColor\u0022/\u003E.        /// \u003C/summary\u003E        public static (byte R, byte G, byte B) GetDefaultRgb(this DomTokenColor tokenColor)        {            return tokenColor switch            {                DomTokenColor.TagName =\u003E (86, 156, 214),                DomTokenColor.AttributeName =\u003E (156, 220, 254),                DomTokenColor.AttributeValue =\u003E (206, 145, 120),                DomTokenColor.TextContent =\u003E (212, 212, 212),                _ =\u003E (128, 128, 128)            };        }    }    /// \u003Csummary\u003E    /// Caches measured pixel widths for the syntax-highlighted display tokens of a \u003Csee cref=\u0022DomTreeItem\u0022/\u003E row.    /// \u003C/summary\u003E    public sealed class DomRowMeasureCache    {        /// \u003Csummary\u003E        /// Gets or sets the font generation counter at which these widths were measured.        /// \u003C/summary\u003E        public int MeasuredFontGeneration { get; set; }        /// \u003Csummary\u003E        /// Gets or sets the measured pixel widths for each token in \u003Csee cref=\u0022DomTreeItem.OpenParts\u0022/\u003E.        /// \u003C/summary\u003E        public int[] OpenPartWidths { get; set; } = Array.Empty\u003Cint\u003E();        /// \u003Csummary\u003E        /// Gets or sets the measured pixel widths for each token in \u003Csee cref=\u0022DomTreeItem.CollapsedSuffixParts\u0022/\u003E.        /// \u003C/summary\u003E        public int[] CollapsedSuffixWidths { get; set; } = Array.Empty\u003Cint\u003E();        /// \u003Csummary\u003E        /// Gets or sets the sum of all widths in \u003Csee cref=\u0022OpenPartWidths\u0022/\u003E.        /// \u003C/summary\u003E        public int OpenTotalWidth { get; set; }        /// \u003Csummary\u003E        /// Gets or sets the sum of all widths in \u003Csee cref=\u0022CollapsedSuffixWidths\u0022/\u003E.        /// \u003C/summary\u003E        public int CollapsedSuffixTotalWidth { get; set; }    }    /// \u003Csummary\u003E    /// Contains computed scrollbar visibility, viewport dimensions, and scroll range parameters for a virtualized DOM tree control.    /// \u003C/summary\u003E    public readonly struct DomScrollBarMetrics    {        /// \u003Csummary\u003E        /// Gets whether the vertical scrollbar should be visible.        /// \u003C/summary\u003E        public bool NeedVertical { get; init; }        /// \u003Csummary\u003E        /// Gets whether the horizontal scrollbar should be visible.        /// \u003C/summary\u003E        public bool NeedHorizontal { get; init; }        /// \u003Csummary\u003E        /// Gets the available viewport width exclu