cmdResult = await client.SendCommandAsync(commandName, resolvedOptions, cancellationToken);                var dumpResult = ParseSiteDumpOutput(cmdResult.Output, dumpType, client.CurrentUrl);                dumpResult.Success = cmdResult.Status == \u0022completed\u0022;                OnDumpCompleted?.Invoke(this, new SiteDumpEventArgs(dumpType, dumpResult));                return dumpResult;            }            catch (Exception ex)            {                var failedResult = new SiteDumpResult                {                    DumpType = dumpType,                    PageUrl = client.CurrentUrl ?? string.Empty,                    TimestampUtc = DateTime.UtcNow,                    Success = false,                    ErrorMessage = ex.Message                };                OnDumpFailed?.Invoke(this, new SiteDumpEventArgs(dumpType, failedResult, ex));                throw;            }        }        internal static SiteDumpResult ParseSiteDumpOutput(string? rawOutput, SiteDumpType dumpType, string? fallbackUrl)        {            var result = new SiteDumpResult            {                DumpType = dumpType,                PageUrl = fallbackUrl ?? string.Empty,                TimestampUtc = DateTime.UtcNow,                Success = true            };            if (string.IsNullOrWhiteSpace(rawOutput))                return result;            try            {                using var doc = JsonDocument.Parse(rawOutput);                var root = doc.RootElement;                if (root.ValueKind != JsonValueKind.Object)                    return result;                if (root.TryGetProperty(\u0022pageUrl\u0022, out var urlProp) \u0026\u0026 urlProp.ValueKind == JsonValueKind.String)                {                    result.PageUrl = urlProp.GetString() ?? result.PageUrl;                }                if (root.TryGetProperty(\u0022pageTitle\u0022, out var titleProp) \u0026\u0026 titleProp.ValueKind == JsonValueKind.String)                {                    result.PageTitle = titleProp.GetString() ?? string.Empty;                }                if (root.TryGetProperty(\u0022html\u0022, out var htmlProp) \u0026\u0026 htmlProp.ValueKind == JsonValueKind.String)                {                    result.Html = htmlProp.GetString() ?? string.Empty;                }                if (root.TryGetProperty(\u0022htmlResources\u0022, out var htmlArr) \u0026\u0026 htmlArr.ValueKind == JsonValueKind.Array)                {                    result.HtmlResources = ParseResourceList(htmlArr, SiteResourceType.Html);                }                if (root.TryGetProperty(\u0022cssResources\u0022, out var cssArr) \u0026\u0026 cssArr.ValueKind == JsonValueKind.Array)                {                    result.CssResources = ParseResourceList(cssArr, SiteResourceType.Css);                }                if (root.TryGetProperty(\u0022javascriptResources\u0022, out var jsArr) \u0026\u0026 jsArr.ValueKind == JsonValueKind.Array)                {                    result.JavaScriptResources = ParseResourceList(jsArr, SiteResourceType.JavaScript);                }                if (string.IsNullOrEmpty(result.Html) \u0026\u0026 result.HtmlResources.Count \u003E 0)                {                    result.Html = result.HtmlResources[0].Content;                }            }            catch            {                // Fallback if a custom script returned plain HTML string                if (dumpType == SiteDumpType.Html)                {                    result.Html = rawOutput;                    result.HtmlResources.Add(new SiteResourceItem                    {                        Index = 1,                        Name = \u0022document.html\u0022,                        Category = SiteResourceType.Html,                        SourceType = \u0022Document\u0022,                        Url = result.PageUrl,                        Content = rawOutput,                        SizeBytes = Encoding.UTF8.GetByteCount(rawOutput)                    });                }            }            return result;        }        private static List\u003CSiteResourceItem\u003E ParseResourceList(JsonElement arrayElement, SiteResourceType defaultCategory)        {            var list = new List\u003CSiteResourceItem\u003E();            int idx = 1;            foreach (var elem in arrayElement.EnumerateArray())            {                if (elem.ValueKind != JsonValueKind.Object)                    continue;                string content = elem.TryGetProperty(\u0022content\u0022, out var contentProp) \u0026\u0026 contentProp.ValueKind == JsonValueKind.String                    ? (contentProp.GetString() ?? string.Empty)                    : string.Empty;                long sizeBytes = elem.TryGetProperty(\u0022sizeBytes\u0022, out var sizeProp) \u0026\u0026 sizeProp.TryGetInt64(out long parsedSize)                    ? parsedSize                    : Encoding.UTF8.GetByteCount(content);                int itemIndex = elem.TryGetProperty(\u0022index\u0022, out var idxProp) \u0026\u0026 idxProp.TryGetInt32(out int parsedIdx)                    ? parsedIdx                    : idx;                var category = defaultCategory;                if (elem.TryGetProperty(\u0022category\u0022, out var catProp) \u0026\u0026 catProp.ValueKind == JsonValueKind.String)                {                    if (Enum.TryParse\u003CSiteResourceType\u003E(catProp.GetString(), true, out var parsedCat))                    {                        category = parsedCat;                    }                }                var item = new SiteResourceItem                {                    Index = itemIndex,                    Name = elem.TryGetProperty(\u0022name\u0022, out var nameProp) \u0026\u0026 nameProp.ValueKind == JsonValueKind.String                        ? (nameProp.GetString() ?? $\u0022resource-{itemIndex}\u0022)                        : $\u0022resource-{itemIndex}\u0022,                    Category = category,                    SourceType = elem.TryGetProperty(\u0022sourceType\u0022, out var stProp) \u0026\u0026 stProp.ValueKind == JsonValueKind.String                        ? (stProp.GetString() ?? \u0022External\u0022)                        : \u0022External\u0022,                    Url = elem.TryGetProperty(\u0022url\u0022, out var urlProp) \u0026\u0026 urlProp.ValueKind == JsonValueKind.String                        ? (urlProp.GetString() ?? string.Empty)                        : string.Empty,                    Content = content,                    SizeBytes = sizeBytes,                    Error = elem.TryGetProperty(\u0022error\u0022, out var errProp) \u0026\u0026 errProp.ValueKind == JsonValueKind.String                        ? errProp.GetString()                        : null                };                list.Add(item);                idx\u002B\u002B;            }            return list;        }    }}\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\BrowserEventArgs.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH    public class ScrapePageEventArgs : EventArgs    {        public ScrapeDefinition Definition { get; }        public int PageNumber { get; }        public System.Collections.Generic.IReadOnlyList\u003CSystem.Collections.Generic.Dictionary\u003Cstring, string?\u003E\u003E PageRecords { get; }        public ScrapePageEventArgs(            ScrapeDefinition definition,            int pageNumber,            System.Collections.Generic.IReadOnlyList\u003CSystem.Collections.Generic.Dictionary\u003Cstring, string?\u003E\u003E pageRecords)        {            Definition = definition;            PageNumber = pageNumber;            PageRecords = pageRecords;        }    }}==== REPLACE    public class ScrapePageEventArgs : EventArgs    {        public ScrapeDefinition Definition { get; }        public int PageNumber { get; }        public System.Collections.Generic.IReadOnlyList\u