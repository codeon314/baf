t var vBounds,                out var hBounds,                out var cornerBounds);            return new DomScrollBarMetrics            {                NeedVertical = needV,                NeedHorizontal = needH,                ViewportX = borderInset,                ViewportY = borderInset,                ViewportWidth = viewW,                ViewportHeight = viewH,                VerticalScrollBarBounds = vBounds,                HorizontalScrollBarBounds = hBounds,                ScrollCornerBounds = cornerBounds,                VerticalLargeChange = vLarge,                VerticalSmallChange = vSmall,                VerticalMaximum = vMax,                VerticalValue = vVal,                HorizontalLargeChange = hLarge,                HorizontalSmallChange = hSmall,                HorizontalMaximum = hMax,                HorizontalValue = hVal            };        }        /// \u003Csummary\u003E        /// Computes the content viewport rectangle given the control client dimensions, border inset, and current scrollbar visibility.        /// \u003C/summary\u003E        public DomRect GetViewportBounds(            int clientWidth,            int clientHeight,            int borderInset,            bool vScrollVisible,            int vScrollWidth,            bool hScrollVisible,            int hScrollHeight)        {            int w = Math.Max(0, clientWidth - (borderInset * 2) - (vScrollVisible ? vScrollWidth : 0));            int h = Math.Max(0, clientHeight - (borderInset * 2) - (hScrollVisible ? hScrollHeight : 0));            return new DomRect(borderInset, borderInset, w, h);        }        /// \u003Csummary\u003E        /// Computes the pixel layout rectangles for the vertical scrollbar, horizontal scrollbar, and bottom-right corner box.        /// \u003C/summary\u003E        public static void CalculateScrollBarLayout(            int clientWidth,            int clientHeight,            int borderInset,            int verticalScrollBarWidth,            int horizontalScrollBarHeight,            bool vScrollVisible,            bool hScrollVisible,            out DomRect verticalScrollBarBounds,            out DomRect horizontalScrollBarBounds,            out DomRect scrollCornerBounds)        {            int innerW = Math.Max(0, clientWidth - (borderInset * 2));            int innerH = Math.Max(0, clientHeight - (borderInset * 2));            int vLeft = clientWidth - borderInset - verticalScrollBarWidth;            int vTop = borderInset;            int vHeight = Math.Max(0, innerH - (hScrollVisible ? horizontalScrollBarHeight : 0));            verticalScrollBarBounds = new DomRect(vLeft, vTop, verticalScrollBarWidth, vHeight);            int hLeft = borderInset;            int hTop = clientHeight - borderInset - horizontalScrollBarHeight;            int hWidth = Math.Max(0, innerW - (vScrollVisible ? verticalScrollBarWidth : 0));            horizontalScrollBarBounds = new DomRect(hLeft, hTop, hWidth, horizontalScrollBarHeight);            scrollCornerBounds = (vScrollVisible \u0026\u0026 hScrollVisible)                ? new DomRect(vLeft, hTop, verticalScrollBarWidth, horizontalScrollBarHeight)                : new DomRect(0, 0, 0, 0);        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        /// \u003Csummary\u003E        /// Applies a mouse wheel delta to \u003Csee cref=\u0022ScrollX\u0022/\u003E (when \u003Cparamref name=\u0022horizontal\u0022/\u003E is true) or \u003Csee cref=\u0022ScrollY\u0022/\u003E,        /// clamping against the provided maximum scroll bound. Returns \u003Cc\u003Etrue\u003C/c\u003E if the scroll offset changed.        /// \u003C/summary\u003E        public bool ApplyMouseWheel(int wheelDelta, bool horizontal, int maxScrollOffset, int itemHeight, int mouseWheelLines = 3)==== REPLACE        /// \u003Csummary\u003E        /// Applies a mouse wheel delta to \u003Csee cref=\u0022ScrollX\u0022/\u003E (when \u003Cparamref name=\u0022horizontal\u0022/\u003E is true) or \u003Csee c