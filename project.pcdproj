ionUrlPattern, 1, 6);\n==== REPLACE\n            pnlPageNums.Controls.AddRange(new Control[] { numMaxPages, lblStartPage, numStartPage });\n\n            var lblPageDelay = new Label { Text = \u0022Page Delay (ms):\u0022, AutoSize = true, Anchor = AnchorStyles.Left, Margin = lblMargin };\n            numPageDelayMs = new NumericUpDown\n            {\n                Minimum = 0,\n                Maximum = 3600000,\n                Increment = 250,\n                Value = 1000,\n                Width = ScaleDpi(100),\n                Anchor = AnchorStyles.Left,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                Margin = inputMargin\n            };\n            numPageDelayMs.ValueChanged \u002B= ScrapeConfigControl_Changed;\n\n            var lblNextBtn = new Label { Text = \u0022Next Button CSS:\u0022, AutoSize = true, Anchor = AnchorStyles.Left, Margin = lblMargin };\n            txtNextPageSelector = new TextBox { Dock = DockStyle.Fill, BackColor = darkBg, ForeColor = Color.LightGray, Margin = inputMargin };\n            txtNextPageSelector.TextChanged \u002B= ScrapeConfigControl_Changed;\n\n            var lblPageUrlPattern = new Label { Text = \u0022Page URL Pattern:\u0022, AutoSize = true, Anchor = AnchorStyles.Left, Margin = lblMargin };\n            txtPaginationUrlPattern = new TextBox\n            {\n                Dock = DockStyle.Fill,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                PlaceholderText = \u0022https://site.com/items?page={page}\u0022,\n                Margin = inputMargin\n            };\n            txtPaginationUrlPattern.TextChanged \u002B= ScrapeConfigControl_Changed;\n\n            tlpConfig.Controls.Add(lblContainer, 0, 0);\n            tlpConfig.Controls.Add(txtContainerSelector, 1, 0);\n            tlpConfig.Controls.Add(pnlContainerBtns, 1, 1);\n            tlpConfig.Controls.Add(lblPreSeq, 0, 2);\n            tlpConfig.Controls.Add(cmbPreScrapeSeq, 1, 2);\n            tlpConfig.Controls.Add(lblPostSeq, 0, 3);\n            tlpConfig.Controls.Add(cmbPostScrapeSeq, 1, 3);\n            tlpConfig.Controls.Add(chkEnablePagination, 0, 4);\n            tlpConfig.Controls.Add(pnlPageNums, 1, 4);\n            tlpConfig.Controls.Add(lblPageDelay, 0, 5);\n            tlpConfig.Controls.Add(numPageDelayMs, 1, 5);\n            tlpConfig.Controls.Add(lblNextBtn, 0, 6);\n            tlpConfig.Controls.Add(txtNextPageSelector, 1, 6);\n            tlpConfig.Controls.Add(lblPageUrlPattern, 0, 7);\n            tlpConfig.Controls.Add(txtPaginationUrlPattern, 1, 7);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                    chkEnablePagination.Checked = scrape.EnablePagination;\n                    numMaxPages.Value = Math.Clamp(scrape.MaxPages, (int)numMaxPages.Minimum, (int)numMaxPages.Maximum);\n                    numStartPage.Value = Math.Clamp(scrape.PaginationStartPage, (int)numStartPage.Minimum, (int)numStartPage.Maximum);\n                    txtNextPageSelector.Text = scrape.NextPageSelector;\n                    txtPaginationUrlPattern.Text = scrape.PaginationUrlPattern;\n==== REPLACE\n                    chkEnablePagination.Checked = scrape.EnablePagination;\n                    numMaxPages.Value = Math.Clamp(scrape.MaxPages, (int)numMaxPages.Minimum, (int)numMaxPages.Maximum);\n                    numStartPage.Value = Math.Clamp(scrape.PaginationStartPage, (int)numStartPage.Minimum, (int)numStartPage.Maximum);\n                    numPageDelayMs.Value = Math.Clamp(scrape.PageDelayMs, (int)numPageDelayMs.Minimum, (int)numPageDelayMs.Maximum);\n                    txtNextPageSelector.Text = scrape.NextPageSelector;\n                    txtPaginationUrlPattern.Text = scrape.PaginationUrlPattern;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                    chkEnablePagination.Checked = false;\n                    numMaxPages.Value = 1;\n                    numStartPage.Value = 1;\n                    txtNextPageSelector.Text = string.Empty;\n                    txtPaginationUrlPattern.Text = string.Empty;\n==== REPLACE\n                    chkEnablePagination.Checked = false;\n                    numMaxPages.Value = 1;\n                    numStartPage.Value = 1;\n                    numPageDelayMs.Value = 1000;\n                    txtNextPageSelector.Text = string.Empty;\n                    txtPaginationUrlPattern.Text = string.Empty;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            scrape.EnablePagination = chkEnablePagination.Checked;\n            scrape.MaxPages = (int)numMaxPages.Value;\n            scrape.PaginationStartPage = (int)numStartPage.Value;\n            scrape.NextPageSelector = txtNextPageSelector.Text.Trim();\n            scrape.PaginationUrlPattern = txtPaginationUrlPattern.Text.Trim();\n        }\n==== REPLACE\n            scrape.EnablePagination = chkEnablePagination.Checked;\n            scrape.MaxPages = (int)numMaxPages.Value;\n            scrape.PaginationStartPage = (int)numStartPage.Value;\n            scrape.PageDelayMs = (int)numPageDelayMs.Value;\n            scrape.NextPageSelector = txtNextPageSelector.Text.Trim();\n            scrape.PaginationUrlPattern = txtPaginationUrlPattern.Text.Trim();\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
      "ModelExplanation": "### Summary of Changes\n\n- **Pre-Navigation Page Turn Delay (\u0060DataScraper.cs\u0060, \u0060ScrapeBuilder.cs\u0060, \u0060MainForm.cs\u0060)**:\n\n- Moved the \u0060PageDelayMs\u0060 wait to execute **before** advancing to the next page during pagination so requests are spaced out to avoid triggering rate limits.\n- Added a **Page Delay (ms):** numeric control (\u0060numPageDelayMs\u0060) to the **Data Scraper** tab in \u0060MainForm.cs\u0060 so you can configure the page delay in advance and see live updates in the UI.\n- Added \u0060OnPageTurnDelay\u0060 on \u0060DataScraper\u0060 so the UI logs and displays the active wait duration before each page turn.\n- **HTTP 429 \u0026 \u0060Retry-After\u0060 Header Detection (\u0060ScriptGenerator.cs\u0060, \u0060BrowserClient.cs\u0060, \u0060ReactExtensions.cs\u0060, \u0060DataScraper.cs\u0060, \u0060BrowserEventArgs.cs\u0060, \u0060MainForm.cs\u0060)**:\n\n- Updated the userscript in \u0060ScriptGenerator.cs\u0060 to detect HTTP \u0060429\u0060 status codes (via \u0060PerformanceNavigationTiming.responseStatus\u0060 and page heuristics) and read the \u0060Retry-After\u0060 response header (via \u0060GM_xmlhttpRequest\u0060 / \u0060fetch\u0060 headers).\n- Added \u0060RELOAD_PAGE\u0060 action and \u0060ReloadPageAsync\u0060 extension method to retry rate-limited pages.\n- Added \u0060EnsurePageNotRateLimitedAsync\u0060 and \u0060ParseRetryAfter\u0060 in \u0060DataScraper.cs\u0060:\n\n- If \u0060Retry-After\u0060 contains a target HTTP date/time, it reports the retry timestamp to the UI (\u0060OnRateLimitDetected\u0060), waits until that exact date/time is reached, and then reloads/retries the page.\n- If \u0060Retry-After\u0060 contains a timeout in seconds, it updates \u0060definition.PageDelayMs\u0060 (and updates the \u0060Page Delay (ms):\u0060 control in the UI), waits for the timeout to elapse, retries the current page, and uses that new delay before every subsequent page turn.\n\n### How to Test\n\n- Build and run \u0060TestBedApp\u0060.\n- Click **Generate \u0026 Copy Script** and update the Tampermonkey script in your browser, then reload the target page.\n- In the **Data Scraper** tab under **Container \u0026 Automation Hooks**, set **Page Delay (ms):** (e.g., \u00601500\u0060) to wait 1.5 seconds before each page turn.\n- Run a paginated scrape. Before each page turn, the status bar and log will show the configured delay. If the site returns HTTP \u0060429\u0060, the log and status bar will display the parsed \u0060Retry-After\u0060 date/time or timeout in seconds, automatically update **Page Delay (ms):** in the UI if a seconds timeout was specified, wait until the retry window elapses, and retry the page.",
      "Diffs": [
