       _vScrollBar.Value = _scrollY;\n                    _updatingScrollBars = false;\n                    Invalidate();\n                }\n            }\n        }\n==== REPLACE\n        protected override void OnMouseWheel(MouseEventArgs e)\n        {\n            base.OnMouseWheel(e);\n\n            if ((ModifierKeys \u0026 Keys.Shift) == Keys.Shift)\n            {\n                if (_hScrollBar.Visible)\n                {\n                    int maxScrollX = Math.Max(0, _hScrollBar.Maximum - _hScrollBar.LargeChange \u002B 1);\n                    if (_state.ApplyMouseWheel(e.Delta, horizontal: true, maxScrollX, _itemHeight))\n                    {\n                        _updatingScrollBars = true;\n                        _hScrollBar.Value = _state.ScrollX;\n                        _updatingScrollBars = false;\n                        Invalidate();\n                    }\n                }\n                return;\n            }\n\n            if (_vScrollBar.Visible)\n            {\n                int maxScrollY = Math.Max(0, _vScrollBar.Maximum - _vScrollBar.LargeChange \u002B 1);\n                if (_state.ApplyMouseWheel(e.Delta, horizontal: false, maxScrollY, _itemHeight, SystemInformation.MouseWheelScrollLines))\n                {\n                    _updatingScrollBars = true;\n                    _vScrollBar.Value = _state.ScrollY;\n                    _updatingScrollBars = false;\n                    Invalidate();\n                }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\utils\\FileAssociationHelper.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nusing System;\nusing System.Diagnostics;\nusing System.Runtime.InteropServices;\nusing Microsoft.Win32;\n\nnamespace TestBedApp.Utils\n{\n    public static class FileAssociationHelper\n    {\n        [DllImport(\u0022shell32.dll\u0022, CharSet = CharSet.Auto, SetLastError = true)]\n        public static extern void SHChangeNotify(uint wEventId, uint uFlags, IntPtr dwItem1, IntPtr dwItem2);\n\n        private const uint SHCNE_ASSOCCHANGED = 0x08000000;\n        private const uint SHCNF_IDLIST = 0x0000;\n\n        public static void EnsureAssociation(string extension, string progId, string description, string applicationFilePath)\n        {\n            try\n            {\n                bool needsUpdate = false;\n\n                // Check if the extension is mapped to our ProgId\n                using (var key = Registry.CurrentUser.OpenSubKey($@\u0022Software\\Classes\\{extension}\u0022))\n                {\n                    if (key?.GetValue(\u0022\u0022) as string != progId) needsUpdate = true;\n                }\n\n                // Check if the ProgId command matches our current executable path\n                using (var key = Registry.CurrentUser.OpenSubKey($@\u0022Software\\Classes\\{progId}\\shell\\open\\command\u0022))\n                {\n                    string expectedCommand = $\u0022\\\u0022{applicationFilePath}\\\u0022 \\\u0022%1\\\u0022\u0022;\n                    if (key?.GetValue(\u0022\u0022) as string != expectedCommand) needsUpdate = true;\n                }\n\n                // If everything is already set up correctly, skip writing to the registry\n                if (!needsUpdate) return;\n\n                // Set association for the extension\n                using (var key = Registry.CurrentUser.CreateSubKey($@\u0022Software\\Classes\\{extension}\u0022))\n                {\n                    key.SetValue(\u0022\u0022, progId);\n                }\n\n                // Set up the ProgId\n                using (var key = Registry.CurrentUser.CreateSubKey($@\u0022Software\\Classes\\{progId}\u0022))\n                {\n                    key.SetValue(\u0022\u0022, description);\n                }\n\n                // Set the icon to the application\u0027s icon\n                using (var key = Registry.CurrentUser.CreateSubKey($@\u0022Software\\Classes\\{progId}\\DefaultIcon\u0022))\n                {\n                    key.SetValue(\u0022\u0022, $\u0022\\\u0022{applicationFilePath}\\\u0022,0\u0022);\n                }\n\n                // Set the open command\n                using (var key = Registry.CurrentUser.CreateSubKey($@\u0022Software\\Classes\\{progId}\\shell\\open\\command\u0022))\n                {\n                    key.SetValue(\u0022\u0022, $\u0022\\\u0022{applicationFilePath}\\\u0022 \\\u0022%1\\\u0022\u0022);\n                }\n\n                // Notify the Windows shell that file associations have changed so icons update immediately\n                SHChangeNotify(SHCNE_ASSOCCHANGED, SHCNF_IDLIST, IntPtr.Zero, IntPtr.Zero);\n            }\n            catch\n            {\n                // Silently fail if we lack permissions or encounter an error\n            }\n        }\n    }\n}\n==== REPLACE\nnamespace TestBedApp.Utils\n{\n    public static class FileAssociationHelper\n    {\n        public static void EnsureAssociation(string extension, string progId, string description, string applicationFilePath)\n        {\n            BrowserAutomationFramework.Utils.FileAssociationHelper.EnsureAssociation(\n                extension,\n                progId,\n                description,\n                applicationFilePath);\n        }\n    }\n}\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\utils\\ReThemer.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n\t\tpublic static void ThemeControl(Control control)\n\t\t{\n            int trueValue = 0x01;\n            SetWindowTheme(control.Handle, \u0022DarkMode_Explorer\u0022, null);\n            DwmSetWindowAttribute(control.Handle, DwmWindowAttribute.DWMWA_USE_IMMERSIVE_DARK_MODE, ref trueValue, Marshal.SizeOf(typeof(int)));\n            DwmSetWindowAttribute(control.Handle, DwmWindowAttribute.DWMWA_SYSTEMBACKDROP_TYPE, ref trueValue, Marshal.SizeOf(typeof(int)));\n        }\n\n\t\tpublic static void RestartExplorer()\n\t\t{\n\t\t\tvar explorerProcess = Process.GetProcesses().FirstOrDefault(p =\u003E p.ProcessName == \u0022explorer\u0022);\n\t\t\tif (explorerProcess != null)\n\t\t\t\texplorerProcess.Kill();\n\t\t}\n\t}\n}\n==== REPLACE\n\t\tpublic static void ThemeControl(Control control)\n\t\t{\n            int trueValue = 0x01;\n            SetWindowTheme(control.Handle, \u0022DarkMode_Explorer\u0022, null);\n            DwmSetWindowAttribute(control.Handle, DwmWindowAttribute.DWMWA_USE_IMMERSIVE_DARK_MODE, ref trueValue, Marshal.SizeOf(typeof(int)));\n            DwmSetWindowAttribute(control.Handle, DwmWindowAttribute.DWMWA_SYSTEMBACKDROP_TYPE, ref trueValue, Marshal.SizeOf(typeof(int)));\n        }\n\t}\n}\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        private AutomationServer? _server;\n        private CancellationTokenSource? _cts;\n        private AutomationProject _project = new();\n        private readonly AutomationRunner _runner;\n        private readonly DataScraper _scraper;\n        private readonly SiteDumper _siteDumper;\n        private ScrapeResult? _lastScrapeResult;\n        private SiteDumpResult? _lastSiteDumpResult;\n        private bool _isUpdatingScrapeUi;\n        private System.Windows.Forms.Timer _clientRefreshTimer;\n==== REPLACE\n        private AutomationServer? _server;\n        private AutomationProject _project = new();\n        private readonly AutomationRunner _runner;\n        private readonly DataScraper _scraper;\n        private readonly SiteDumper _siteDumper;\n        private ScrapeResult? _lastScrapeResult;\n        private SiteDumpResult? _lastSiteDumpResult;\n        private bool _isUpdatingScrapeUi;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            _siteDumper.OnDumpFailed \u002B= (s, e) =\u003E Log($\