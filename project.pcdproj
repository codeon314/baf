imer.Tick \u002B= ClientRefreshTimer_Tick;        }==== REPLACEusing BrowserAutomationFramework.Automation;using BrowserAutomationFramework.Extensions;using BrowserAutomationFramework.Generators;using BrowserAutomationFramework.Models;using BrowserAutomationFramework.Scraping;using BrowserAutomationFramework.Server;using TestBedApp.Utils;namespace TestBedApp{    public partial class MainForm : Form    {        private AutomationServer? _server;        private CancellationTokenSource? _cts;        private readonly AutomationRunner _runner;        private readonly DataScraper _scraper;        private ScrapeResult? _lastScrapeResult;        private bool _isUpdatingScrapeUi;        private System.Windows.Forms.Timer _clientRefreshTimer;        // Data Scraper Tab Controls        private CheckedListBox chkLstScrapes = null!;        private TextBox txtContainerSelector = null!;        private ComboBox cmbPreScrapeSeq = null!;        private ComboBox cmbPostScrapeSeq = null!;        private CheckBox chkEnablePagination = null!;        private NumericUpDown numMaxPages = null!;        private TextBox txtNextPageSelector = null!;        private ListBox lstScrapeFields = null!;        private PropertyGrid pgScrapeFieldDetails = null!;        private Button btnPreviewScrape = null!;        private Button btnRunAllScrapes = null!;        private Label lblScrapeStatus = null!;        private DataGridView dgvScrapePreview = null!;        private TextBox txtScrapeJsonPreview = null!;        public MainForm()        {            InitializeComponent();            InitializeScraperTabUi();            ApplyFixedSingleBorders(this);                        cmbMode.DataSource = Enum.GetValues(typeof(IpcMode));            cmbMode.SelectedIndex = 1;            _runner = new AutomationRunner();            _runner.OnSequenceStarted \u002B= (s, e) =\u003E Log($\u0022[AUTO] --- Starting List: {e.Sequence.Name} ---\u0022, Color.Magenta);            _runner.OnStepStarted \u002B= (s, e) =\u003E Log($\u0022[AUTO] Executing: {e.Step.Name}\u0022, Color.Plum);            _runner.OnStepCompleted \u002B= (s, e) =\u003E            {                if (e.Result != null)                {                    Log($\u0022[AUTO-RX] {e.Result.Status} | {e.Result.Output}\u0022, Color.White);                }            };            _runner.OnScrapeCompleted \u002B= (s, e) =\u003E            {                if (e.Result != null)                {                    Invoke(new Action(() =\u003E DisplayScrapeResult(e.Result)));                }            };            _scraper = new DataScraper(_runner);            _scraper.OnScrapeStarted \u002B= (s, e) =\u003E Log($\u0022[SCRAPE] --- Starting Scrape: {e.Definition.Name} ---\u0022, Color.SpringGreen);            _scraper.OnScrapePageCompleted \u002B= (s, e) =\u003E Log($\u0022[SCRAPE] Page {e.PageNumber} extracted {e.PageRecords.Count} record(s).\u0022, Color.LightGreen);            _scraper.OnScrapeCompleted \u002B= (s, e) =\u003E            {                if (e.Result != null)                {                    Log($\u0022[SCRAPE] Completed \u0027{e.Definition.Name}\u0027: {e.Result.RecordCount} total record(s) across {e.Result.PagesScraped} page(s).\u0022, Color.Lime);                    Invoke(new Action(() =\u003E DisplayScrapeResult(e.Result)));                }            };            _scraper.OnScrapeFailed \u002B= (s, e) =\u003E Log($\u0022[SCRAPE-ERR] \u0027{e.Definition.Name}\u0027 failed: {e.Error?.Message}\u0022, Color.Red);            _clientRefreshTimer = new System.Windows.Forms.Timer { Interval = 2000 };            _clientRefreshTimer.Tick \u002B= ClientRefreshTimer_Tick;        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private AutomationProject BuildCurrentProjectFromUi()        {            return new AutomationProject            {                MatchAnySite = chkMatchAnySite.Checked,                MatchUrls = lstMatchUrls.Items.Cast\u003Cstring\u003E().ToList(),                Sequences = chkLstSequences.Items.Cast\u003CAutomationSequence\u003E().ToList()            };        }        private void ApplyProjectToUi(AutomationProject project)        {            chkMatchAnySite.Checked = project.MatchAnySite;            lstMatchUrls.Items.Clear();            foreach (var url in project.MatchUrls)            {                lstMatchUrls.Items.Add(url);            }            chkLstSequences.Items.Clear();            lstSteps.Items.Clear();            foreach (var seq in project.Sequences)            {                chkLstSequences.Items.Add(seq, seq.IsActive);            }            if (chkLstSequences.Items.Count \u003E 0)            {                chkLstSequences.SelectedIndex = 0;            }        }==== REPLACE        private AutomationProject BuildCurrentProjectFromUi()        {            return new AutomationProject            {                MatchAnySite = chkMatchAnySite.Checked,                MatchUrls = lstMatchUrls.Items.Cast\u003Cstring\u003E().ToList(),                Sequences = chkLstSequences.Items.Cast\u003CAutomationSequence\u003E().ToList(),                Scrapes = chkLstScrapes.Items.Cast\u003CScrapeDefinition\u003E().ToList()            };        }        private void ApplyProjectToUi(AutomationProject project)        {            chkMatchAnySite.Checked = project.MatchAnySite;            lstMatchUrls.Items.Clear();            foreach (var url in project.MatchUrls)            {                lstMatchUrls.Items.Add(url);            }            chkLstSequences.Items.Clear();            lstSteps.Items.Clear();            foreach (var seq in project.Sequences)            {                chkLstSequences.Items.Add(seq, seq.IsActive);            }            if (chkLstSequences.Items.Count \u003E 0)            {                chkLstSequences.SelectedIndex = 0;            }            RefreshAutomationSequenceDropdowns();            chkLstScrapes.Items.Clear();            lstScrapeFields.Items.Clear();            pgScrapeFieldDetails.SelectedObject = null;            foreach (var scrape in project.Scrapes)            {                chkLstScrapes.Items.Add(scrape, scrape.IsActive);            }            if (chkLstScrapes.Items.Count \u003E 0)            {                chkLstScrapes.SelectedIndex = 0;            }            else            {                LoadSelectedScrapeToUi();            }        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private void CtxDomNode_Opening(object? sender, System.ComponentModel.CancelEventArgs e)        {            mnuAddClickTo.DropDownItems.Clear();            mnuAddSetValueTo.DropDownItems.Clear();            if (chkLstSequences.Items.Count == 0)            {                mnuAddClickTo.DropDownItems.Add(new ToolStripMenuItem(\u0022(No lists available)\u0022) { Enabled = false });                mnuAddSetValueTo.DropDownItems.Add(new ToolStripMenuItem(\u0022(No lists available)\u0022) { Enabled = false });                return;            }            foreach (AutomationSequence seq in chkLstSequences.Items)            {                var clickItem = new ToolStripMenuItem(seq.Name);                clickItem.Click \u002B= (s, args) =\u003E AddStepToSequence(seq, AutomationActionType.Click);                mnuAddClickTo.DropDownItems.Add(clickItem);                var setValItem = new ToolStripMenuItem(seq.Name);                setValItem.Click \u002B= (s, args) =\u003E AddStepToSequence(seq, AutomationActionType.SetValue);                mnuAddSetValueTo.DropDownItems.Add(setValItem);            }        }==== REPLACE        private void CtxDomNode_Opening(object? sender, System.ComponentModel.CancelEventArgs e)        {            mnuAddClickTo.DropDownItems.Clear();            mnuAddSetValueTo.DropDownItems.Clear();            if (chkLstSequences.Items.Count == 0)            {                mnuAddClickTo.DropDownItems.Add(new ToolStripMenuItem(\u0022(No lists available)\u0022) { Enabled = false });                mnuAddSetValueTo.DropDownItems.Add(new ToolStripMenuItem(\u0022(No lists available)\u0022) { Enabled = false });            }            else            {                foreach (AutomationSequence seq in chkLstSequences.Items)                {                    var clickItem = new ToolStripMenuItem(seq.Name);                    clickItem.Click \u002B= (s, args) =\u003E AddStepToSequence(seq, AutomationActionType.Click);                    mnuAddClickTo.DropDownItems.Add(clickItem);                    var setValItem = new ToolStripMenuItem(seq.Name);                    setValItem.Click \u002B= (s, args) =\u003E AddStepToSequence(seq, AutomationActionType.SetValue);                    mnuAddSetValueTo.DropDownItems.Add(setValItem);                }            }            PopulateScrapeSubMenu(mnuAddScrapeFieldTo, scrape =\u003E AddFieldFromSelectedDomNode(scrape, matchAllElements: false));            PopulateScrapeSubMenu(mnuAddRepeatingFieldTo, scrape =\u003E AddFieldFromSelectedDomNode(scrape, matchAllElements: true));            PopulateScrapeSubMenu(mnuSetScrapeContainerFor, SetContainerFromSelectedDomNode);            PopulateScrapeSubMenu(mnuSetPaginationNextFor, SetPaginationNextFromSelectedDomNode);        }        private void PopulateScrapeSubMenu(ToolStripMenuItem parentMenu, Action\u003CScrapeDefinition\u003E onSelect)        {            parentMenu.DropDownItems.Clear();            foreach (ScrapeDefinition scrape in chkLstScrapes.Items)            {                var item = new ToolStripMenuItem(scrape.Name);                item.Click \u002B= (s, e) =\u003E onSelect(scrape);                parentMenu.DropDownItems.Add(item);            }            if (chkLstScrapes.Items.Count \u003E 0)            {                parentMenu.DropDownItems.Add(new ToolStripSeparator());            }            var createNewItem = new ToolStripMenuItem(\u0022(\u002B New Scrape List...)\u0022);            createNewItem.Click \u002B= (s, e) =\u003E            {                string defaultName = $\u0022Scrape {chkLstScrapes.Items.Count \u002B 1}\u0022;                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022New Scrape List\u0022, defaultName);                if (!string.IsNullOrWhiteSpace(name))                {                    var newScrape = new ScrapeDefinition { Name = name.Trim() };                    chkLstScrapes.Items.Add(newScrape, true);                    chkLstScrapes.SelectedItem = newScrape;                    onSelect(newScrape);                }            };            parentMenu.DropDownItems.Add(createNewItem);        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private void MnuFileNew_Click(object? sender, EventArgs e)        {            chkMatchAnySite.Checked = true;            lstMatchUrls.Items.Clear();            chkLstSequences.Items.Clear();            lstSteps.Items.Clear();            Log(\u0022[SYS] Started new automation project.\u0022, Color.Cyan);        }==== REPLACE        private void MnuFileNew_Click(object? sender, EventArgs e)        {            chkMatchAnySite.Checked = true;            lstMatchUrls.Items.Clear();            chkLstSequences.Items.Clear();            lstSteps.Items.Clear();            chkLstScrapes.Items.Clear();            lstScrapeFields.Items.Clear();            pgScrapeFieldDetails.SelectedObject = null;            RefreshAutomationSequenceDropdowns();            LoadSelectedScrapeToUi();            Log(\u0022[SYS] Started new automation project.\u0022, Color.Cyan);        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private void BtnAddSequence_Click(object? sender, EventArgs e)        {            string name = PromptForValue(\u0022Enter new list name:\u0022, \u0022Add Automation List\u0022);            if (!string.IsNullOrWhiteSpace(name))            {                var seq = new AutomationSequence { Name = name };                chkLstSequences.Items.Add(seq, true);                chkLstSequences.SelectedItem = seq;            }        }        private void BtnRemoveSequence_Click(object? sender, EventArgs e)        {            if (chkLstSequences.SelectedItem != null)            {                chkLstSequences.Items.Remove(chkLstSequences.SelectedItem);            }        }==== REPLACE        private void BtnAddSequence_Click(object? sender, EventArgs e)        {            string name = PromptForValue(\u0022Enter new list name:\u0022, \u0022Add Automation List\u0022);            if (!string.IsNullOrWhiteSpace(name))            {                var seq = new AutomationSequence { Name = name };                chkLstSequences.Items.Add(seq, true);                chkLstSequences.SelectedItem = seq;                RefreshAutomationSequenceDropdowns();            }        }        private void BtnRemoveSequence_Click(object? sender, EventArgs e)        {            if (chkLstSequences.SelectedItem != null)            {                chkLstSequences.Items.Remove(chkLstSequences.SelectedItem);                RefreshAutomationSequenceDropdowns();            }        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        private void BtnRenameSeq_Click(object? sender, EventArgs e)        {            if (chkLstSequences.SelectedItem is AutomationSequence seq)            {                string name = PromptForValue(\u0022Enter new list name:\u0022, \u0022Rename Automation List\u0022);                if (!string.IsNullOrWhiteSpace(name))                {                    seq.Name = name;                    int idx = chkLstSequences.SelectedIndex;                    bool isChecked = chkLstSequences.GetItemChecked(idx);                    chkLstSequences.Items[idx] = seq;                    chkLstSequences.SetItemChecked(idx, isChecked);                }            }        }        private async void BtnRunAutomation_Click(object? sender, EventArgs e)==== REPLACE        private void BtnRenameSeq_Click(object? sender, EventArgs e)        {            if (chkLstSequences.SelectedItem is AutomationSequence seq)            {                string name = PromptForValue(\u0022Enter new list name:\u0022, \u0022Rename Automation List\u0022, seq.Name);                if (!string.IsNullOrWhiteSpace(name))                {                    seq.Name = name;                    int idx = chkLstSequences.SelectedIndex;                    bool isChecked = chkLstSequences.GetItemChecked(idx);                    chkLstSequences.Items[idx] = seq;                    chkLstSequences.SetItemChecked(idx, isChecked);                    RefreshAutomationSequenceDropdowns();                }            }        }        private async void BtnRunAutomation_Click(object? sender, EventArgs e)\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH            try            {                await _runner.RunSequencesAsync(client, activeSequences);                Log(\u0022[SYS] Automation Run Completed.\u0022, Color.Lime);            }            catch (Exception ex)            {                Log($\u0022[ERR] Automation aborted: {ex.Message}\u0022, Color.Red);            }            finally            {                btnRunAutomation.Enabled = true;            }        }    }}==== REPLACE            try            {                _runner.SetScrapeDefinitions(chkLstScrapes.Items.Cast\u003CScrapeDefinition\u003E());                await _runner.RunSequencesAsync(client, activeSequences);                Log(\u0022[SYS] Automation Run Completed.\u0022, Color.Lime);            }            catch (Exception ex)            {                Log($\u0022[ERR] Automation aborted: {ex.Message}\u0022, Color.Red);            }            finally            {                btnRunAutomation.Enabled = true;            }        }        // --- Data Scraper UI \u0026 Point-and-Click Handlers ---        private void InitializeScraperTabUi()        {            var darkBg = Color.FromArgb(30, 30, 30);            var darkLine = Color.FromArgb(45, 45, 48);            var splitScraperMain = new SplitContainer            {                Dock = DockStyle.Fill,                SplitterDistance = 300            };            // Left Panel: Scrape Lists \u0026 Scrape-Level Options            var pnlScrapesTop = new Panel            {                Dock = DockStyle.Top,                Height = 86,                Padding = new Padding(5)            };            var btnAddScrape = new Button { Text = \u0022Add Scrape\u0022, Location = new Point(5, 5), Size = new Size(135, 34), UseVisualStyleBackColor = true };            var btnRemoveScrape = new Button { Text = \u0022Remove\u0022, Location = new Point(145, 5), Size = new Size(135, 34), UseVisualStyleBackColor = true };            var btnMoveScrapeUp = new Button { Text = \u0022Move Up\u0022, Location = new Point(5, 44), Size = new Size(85, 34), UseVisualStyleBackColor = true };            var btnMoveScrapeDown = new Button { Text = \u0022Move Down\u0022, Location = new Point(95, 44), Size = new Size(95, 34), UseVisualStyleBackColor = true };            var btnRenameScrape = new Button { Text = \u0022Rename\u0022, Location = new Point(195, 44), Size = new Size(85, 34), UseVisualStyleBackColor = true };            btnAddScrape.Click \u002B= BtnAddScrape_Click;            btnRemoveScrape.Click \u002B= BtnRemoveScrape_Click;            btnMoveScrapeUp.Click \u002B= BtnMoveScrapeUp_Click;            btnMoveScrapeDown.Click \u002B= BtnMoveScrapeDown_Click;            btnRenameScrape.Click \u002B= BtnRenameScrape_Click;            pnlScrapesTop.Controls.AddRange(new Control[] { btnAddScrape, btnRemoveScrape, btnMoveScrapeUp, btnMoveScrapeDown, btnRenameScrape });            chkLstScrapes = new CheckedListBox            {                Dock = DockStyle.Fill,                BackColor = darkBg,                ForeColor = Color.LightGray,                BorderStyle = BorderStyle.FixedSingle,                IntegralHeight = false            };            chkLstScrapes.SelectedIndexChanged \u002B= ChkLstScrapes_SelectedIndexChanged;            chkLstScrapes.ItemCheck \u002B= ChkLstScrapes_ItemCheck;            var grpScrapeConfig = new GroupBox            {                Dock = DockStyle.Bottom,                Height = 235,                Text = \u0022Container \u0026 Automation Hooks\u0022,                Padding = new Padding(8),                ForeColor = Color.LightGray            };            var tlpConfig = new TableLayoutPanel            {                Dock = DockStyle.Fill,                ColumnCount = 2,                RowCount = 6            };            tlpConfig.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute, 115F));            tlpConfig.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100F));            for (int i = 0; i \u003C 6; i\u002B\u002B) tlpConfig.RowStyles.Add(new RowStyle(SizeType.AutoSize));            var lblContainer = new Label { Text = \u0022Container CSS:\u0022, AutoSize = true, Anchor = AnchorStyles.Left };            txtContainerSelector = new TextBox { Dock = DockStyle.Fill, BackColor = darkBg, ForeColor = Color.LightGray };            txtContainerSelector.TextChanged \u002B= ScrapeConfigControl_Changed;            var pnlContainerBtns = new FlowLayoutPanel { Dock = DockStyle.Fill, AutoSize = true, Margin = new Padding(0, 2, 0, 4) };            var btnGenContainer = new Button { Text = \u0022Generalize\u0022, AutoSize = true, UseVisualStyleBackColor = true };            var btnHlContainer = new Button { Text = \u0022Highlight\u0022, AutoSize = true, UseVisualStyleBackColor = true };            var btnClrContainer = new Button { Text = \u0022Clear\u0022, AutoSize = true, UseVisualStyleBackColor = true };            btnGenContainer.Click \u002B= BtnGeneralizeContainer_Click;            btnHlContainer.Click \u002B= BtnHighlightContainer_Click;            btnClrContainer.Click \u002B= (s, e) =\u003E txtContainerSelector.Text = string.Empty;            pnlContainerBtns.Controls.AddRange(new Control[] { btnGenContainer, btnHlContainer, btnClrContainer });            var lblPreSeq = new Label { Text = \u0022Pre-Automation:\u0022, AutoSize = true, Anchor = AnchorStyles.Left };            cmbPreScrapeSeq = new ComboBox { Dock = DockStyle.Fill, DropDownStyle = ComboBoxStyle.DropDownList, BackColor = darkBg, ForeColor = Color.LightGray };            cmbPreScrapeSeq.SelectedIndexChanged \u002B= ScrapeConfigControl_Changed;            var lblPostSeq = new Label { Text = \u0022Post-Automation:\u0022, AutoSize = true, Anchor = AnchorStyles.Left };            cmbPostScrapeSeq = new ComboBox { Dock = DockStyle.Fill, DropDownStyle = ComboBoxStyle.DropDownList, BackColor = darkBg, ForeColor = Color.LightGray };            cmbPostScrapeSeq.SelectedIndexChanged \u002B= ScrapeConfigControl_Changed;            chkEnablePagination = new CheckBox { Text = \u0022Paginate (Max):\u0022, AutoSize = true, Anchor = AnchorStyles.Left };            chkEnablePagination.CheckedChanged \u002B= ScrapeConfigControl_Changed;            numMaxPages = new NumericUpDown            {                Minimum = 1,                Maximum = 500,                Value = 3,                Width = 70,                BackColor = darkBg,                ForeColor = Color.LightGray            };            numMaxPages.ValueChanged \u002B= ScrapeConfigControl_Changed;            var lblNextBtn = new Label { Text = \u0022Next Button CSS:\u0022, AutoSize = true, Anchor = AnchorStyles.Left };            txtNextPageSelector = new TextBox { Dock = DockStyle.Fill, BackColor = darkBg, ForeColor = Color.LightGray };            txtNextPageSelector.TextChanged \u002B= ScrapeConfigControl_Changed;            tlpConfig.Controls.Add(lblContainer, 0, 0);            tlpConfig.Controls.Add(txtContainerSelector, 1, 0);            tlpConfig.Controls.Add(pnlContainerBtns, 1, 1);            tlpConfig.Controls.Add(lblPreSeq, 0, 2);            tlpConfig.Controls.Add(cmbPreScrapeSeq, 1, 2);            tlpConfig.Controls.Add(lblPostSeq, 0, 3);            tlpConfig.Controls.Add(cmbPostScrapeSeq, 1, 3);            tlpConfig.Controls.Add(chkEnablePagination, 0, 4);            tlpConfig.Controls.Add(numMaxPages, 1, 4);            tlpConfig.Controls.Add(lblNextBtn, 0, 5);            tlpConfig.Controls.Add(txtNextPageSelector, 1, 5);            grpScrapeConfig.Controls.Add(tlpConfig);            splitScraperMain.Panel1.Controls.Add(chkLstScrapes);            splitScraperMain.Panel1.Controls.Add(pnlScrapesTop);            splitScraperMain.Panel1.Controls.Add(grpScrapeConfig);            // Right Panel: Top = Fields \u0026 PropertyGrid, Bottom = Results \u0026 Preview            var splitScraperRight = new SplitContainer            {                Dock = DockStyle.Fill,                Orientation = Orientation.Horizontal,                SplitterDistance = 210            };            var pnlFieldsToolbar = new Panel { Dock = DockStyle.Top, Height = 46, Padding = new Padding(4) };            var btnAddField = new Button { Text = \u0022Add Field\u0022, Dock = DockStyle.Left, Width = 90, UseVisualStyleBackColor = true };            var btnRemoveField = new Button { Text = \u0022Remove\u0022, Dock = DockStyle.Left, Width = 80, UseVisualStyleBackColor = true };            var btnFieldUp = new Button { Text = \u0022Up\u0022, Dock = DockStyle.Left, Width = 50, UseVisualStyleBackColor = true };            var btnFieldDown = new Button { Text = \u0022Down\u0022, Dock = DockStyle.Left, Width = 60, UseVisualStyleBackColor = true };            var btnGenField = new Button { Text = \u0022Generalize\u0022, Dock = DockStyle.Left, Width = 90, UseVisualStyleBackColor = true };            var btnHlField = new Button { Text = \u0022Highlight\u0022, Dock = DockStyle.Left, Width = 85, UseVisualStyleBackColor = true };            btnPreviewScrape = new Button { Text = \u0022Preview Scrape\u0022, Dock = DockStyle.Right, Width = 130, UseVisualStyleBackColor = true };            btnRunAllScrapes = new Button { Text = \u0022Run Active Scrapes\u0022, Dock = DockStyle.Right, Width = 145, UseVisualStyleBackColor = true };            btnAddField.Click \u002B= BtnAddScrapeField_Click;            btnRemoveField.Click \u002B= BtnRemoveScrapeField_Click;            btnFieldUp.Click \u002B= BtnMoveScrapeFieldUp_Click;            btnFieldDown.Click \u002B= BtnMoveScrapeFieldDown_Click;            btnGenField.Click \u002B= BtnGeneralizeScrapeField_Click;            btnHlField.Click \u002B= BtnHighlightScrapeField_Click;            btnPreviewScrape.Click \u002B= BtnPreviewScrape_Click;            btnRunAllScrapes.Click \u002B= BtnRunAllScrapes_Click;            pnlFieldsToolbar.Controls.AddRange(new Control[]            {                btnRunAllScrapes, btnPreviewScrape,                btnHlField, btnGenField, btnFieldDown, btnFieldUp, btnRemoveField, btnAddField            });            var splitFields = new SplitContainer { Dock = DockStyle.Fill, SplitterDistance = 220 };            lstScrapeFields = new ListBox            {                Dock = DockStyle.Fill,                BackColor = darkBg,                ForeColor = Color.LightGray,                BorderStyle = BorderStyle.FixedSingle,                IntegralHeight = false            };            lstScrapeFields.SelectedIndexChanged \u002B= LstScrapeFields_SelectedIndexChanged;            pgScrapeFieldDetails = new PropertyGrid            {                Dock = DockStyle.Fill,                BackColor = darkBg,                CategoryForeColor = Color.LightGray,                CategorySplitterColor = darkLine,                CommandsBorderColor = darkLine,                CommandsForeColor = Color.LightGray,                DisabledItemForeColor = Color.FromArgb(127, 127, 127),                HelpBackColor = darkBg,                HelpBorderColor = darkLine,                HelpForeColor = Color.LightGray,                LineColor = darkLine,                ViewBackColor = darkBg,                ViewBorderColor = darkLine,                ViewForeColor = Color.LightGray            };            pgScrapeFieldDetails.PropertyValueChanged \u002B= PgScrapeFieldDetails_PropertyValueChanged;            splitFields.Panel1.Controls.Add(lstScrapeFields);            splitFields.Panel2.Controls.Add(pgScrapeFieldDetails);            splitScraperRight.Panel1.Controls.Add(splitFields);            splitScraperRight.Panel1.Controls.Add(pnlFieldsToolbar);            // Bottom Panel: Results Preview \u0026 Export            var pnlResultsToolbar = new Panel { Dock = DockStyle.Top, Height = 40, Padding = new Padding(4) };            lblScrapeStatus = new Label            {                Text = \u0022Scrape Results Preview (0 records)\u0022,                AutoSize = true,                Dock = DockStyle.Left,                TextAlign = ContentAlignment.MiddleLeft,                Padding = new Padding(4, 6, 0, 0)            };            var btnExportJson = new Button { Text = \u0022Export JSON...\u0022, Dock = DockStyle.Right, Width = 115, UseVisualStyleBackColor = true };            var btnExportCsv = new Button { Text = \u0022Export CSV...\u0022, Dock = DockStyle.Right, Width = 110, UseVisualStyleBackColor = true };            var btnCopyJson = new Button { Text = \u0022Copy JSON\u0022, Dock = DockStyle.Right, Width = 100, UseVisualStyleBackColor = true };            btnExportJson.Click \u002B= BtnExportScrapeJson_Click;            btnExportCsv.Click \u002B= BtnExportScrapeCsv_Click;            btnCopyJson.Click \u002B= BtnCopyScrapeJson_Click;            pnlResultsToolbar.Controls.AddRange(new Control[] { btnExportJson, btnExportCsv, btnCopyJson, lblScrapeStatus });            var tabPreview = new TabControl { Dock = DockStyle.Fill };            var tabTable = new TabPage(\u0022Table View\u0022) { BackColor = darkBg };            var tabJson = new TabPage(\u0022JSON View\u0022) { BackColor = darkBg };            dgvScrapePreview = new DataGridView            {                Dock = DockStyle.Fill,                BackgroundColor = darkBg,                ForeColor = Color.LightGray,                GridColor = darkLine,                BorderStyle = BorderStyle.FixedSingle,                ReadOnly = true,                AllowUserToAddRows = false,                AllowUserToDeleteRows = false,                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill,                RowHeadersVisible = false,                EnableHeadersVisualStyles = false,                SelectionMode = DataGridViewSelectionMode.FullRowSelect            };            dgvScrapePreview.ColumnHeadersDefaultCellStyle.BackColor = Color.FromArgb(45, 45, 48);            dgvScrapePreview.ColumnHeadersDefaultCellStyle.ForeColor = Color.White;            dgvScrapePreview.DefaultCellStyle.BackColor = darkBg;            dgvScrapePreview.DefaultCellStyle.ForeColor = Color.LightGray;            dgvScrapePreview.DefaultCellStyle.SelectionBackColor = Color.FromArgb(9, 71, 113);            dgvScrapePreview.DefaultCellStyle.SelectionForeColor = Color.White;            txtScrapeJsonPreview = new TextBox            {                Dock = DockStyle.Fill,                Multiline = true,                ReadOnly = true,                ScrollBars = ScrollBars.Both,                BackColor = darkBg,                ForeColor = Color.LightGray,                Font = new Font(\u0022Consolas\u0022, 10F)            };            tabTable.Controls.Add(dgvScrapePreview);            tabJson.Controls.Add(txtScrapeJsonPreview);            tabPreview.Controls.Add(tabTable);            tabPreview.Controls.Add(tabJson);            splitScraperRight.Panel2.Controls.Add(tabPreview);            splitScraperRight.Panel2.Controls.Add(pnlResultsToolbar);            splitScraperMain.Panel2.Controls.Add(splitScraperRight);            tabScraper.Controls.Add(splitScraperMain);            RefreshAutomationSequenceDropdowns();        }        private void RefreshAutomationSequenceDropdowns()        {            if (cmbPreScrapeSeq == null || cmbPostScrapeSeq == null) return;            _isUpdatingScrapeUi = true;            try            {                string prevPre = cmbPreScrapeSeq.SelectedItem as string ?? string.Empty;                string prevPost = cmbPostScrapeSeq.SelectedItem as string ?? string.Empty;                cmbPreScrapeSeq.Items.Clear();                cmbPostScrapeSeq.Items.Clear();                cmbPreScrapeSeq.Items.Add(\u0022(None)\u0022);                cmbPostScrapeSeq.Items.Add(\u0022(None)\u0022);                foreach (AutomationSequence seq in chkLstSequences.Items)                {                    cmbPreScrapeSeq.Items.Add(seq.Name);                    cmbPostScrapeSeq.Items.Add(seq.Name);                }                cmbPreScrapeSeq.SelectedItem = cmbPreScrapeSeq.Items.Contains(prevPre) ? prevPre : \u0022(None)\u0022;                cmbPostScrapeSeq.SelectedItem = cmbPostScrapeSeq.Items.Contains(prevPost) ? prevPost : \u0022(None)\u0022;                if (chkLstScrapes?.SelectedItem is ScrapeDefinition def)                {                    cmbPreScrapeSeq.SelectedItem = !string.IsNullOrWhiteSpace(def.PreScrapeSequenceName) \u0026\u0026 cmbPreScrapeSeq.Items.Contains(def.PreScrapeSequenceName)                        ? def.PreScrapeSequenceName                        : \u0022(None)\u0022;                    cmbPostScrapeSeq.SelectedItem = !string.IsNullOrWhiteSpace(def.PostScrapeSequenceName) \u0026\u0026 cmbPostScrapeSeq.Items.Contains(def.PostScrapeSequenceName)                        ? def.PostScrapeSequenceName                        : \u0022(None)\u0022;                }            }            finally            {                _isUpdatingScrapeUi = false;            }        }        private void LoadSelectedScrapeToUi()        {            _isUpdatingScrapeUi = true;            try            {                lstScrapeFields.Items.Clear();                pgScrapeFieldDetails.SelectedObject = null;                if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)                {                    txtContainerSelector.Text = scrape.ContainerSelector;                    cmbPreScrapeSeq.SelectedItem = !string.IsNullOrWhiteSpace(scrape.PreScrapeSequenceName) \u0026\u0026 cmbPreScrapeSeq.Items.Contains(scrape.PreScrapeSequenceName)                        ? scrape.PreScrapeSequenceName                        : \u0022(None)\u0022;                    cmbPostScrapeSeq.SelectedItem = !string.IsNullOrWhiteSpace(scrape.PostScrapeSequenceName) \u0026\u0026 cmbPostScrapeSeq.Items.Contains(scrape.PostScrapeSequenceName)                        ? scrape.PostScrapeSequenceName                        : \u0022(None)\u0022;                    chkEnablePagination.Checked = scrape.EnablePagination;                    numMaxPages.Value = Math.Clamp(scrape.MaxPages, (int)numMaxPages.Minimum, (int)numMaxPages.Maximum);                    txtNextPageSelector.Text = scrape.NextPageSelector;                    foreach (var field in scrape.Fields)                    {                        lstScrapeFields.Items.Add(field);                    }                    if (lstScrapeFields.Items.Count \u003E 0)                    {                        lstScrapeFields.SelectedIndex = 0;                    }                }                else                {                    txtContainerSelector.Text = string.Empty;                    cmbPreScrapeSeq.SelectedIndex = 0;                    cmbPostScrapeSeq.SelectedIndex = 0;                    chkEnablePagination.Checked = false;                    numMaxPages.Value = 1;                    txtNextPageSelector.Text = string.Empty;                }            }            finally            {                _isUpdatingScrapeUi = false;            }        }        private void ScrapeConfigControl_Changed(object? sender, EventArgs e)        {            if (_isUpdatingScrapeUi) return;            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape) return;            scrape.ContainerSelector = txtContainerSelector.Text.Trim();            string? pre = cmbPreScrapeSeq.SelectedItem as string;            scrape.PreScrapeSequenceName = pre == \u0022(None)\u0022 ? string.Empty : (pre ?? string.Empty);            string? post = cmbPostScrapeSeq.SelectedItem as string;            scrape.PostScrapeSequenceName = post == \u0022(None)\u0022 ? string.Empty : (post ?? string.Empty);            scrape.EnablePagination = chkEnablePagination.Checked;            scrape.MaxPages = (int)numMaxPages.Value;            scrape.NextPageSelector = txtNextPageSelector.Text.Trim();        }        private void ChkLstScrapes_SelectedIndexChanged(object? sender, EventArgs e)        {            LoadSelectedScrapeToUi();        }        private void ChkLstScrapes_ItemCheck(object? sender, ItemCheckEventArgs e)        {            if (chkLstScrapes.Items[e.Index] is ScrapeDefinition scrape)            {                scrape.IsActive = e.NewValue == CheckState.Checked;            }        }        private void BtnAddScrape_Click(object? sender, EventArgs e)        {            string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022Add Scrape List\u0022, $\u0022Scrape {chkLstScrapes.Items.Count \u002B 1}\u0022);            if (!string.IsNullOrWhiteSpace(name))            {                var scrape = new ScrapeDefinition { Name = name.Trim() };                chkLstScrapes.Items.Add(scrape, true);                chkLstScrapes.SelectedItem = scrape;            }        }        private void BtnRemoveScrape_Click(object? sender, EventArgs e)        {            if (chkLstScrapes.SelectedItem != null)            {                chkLstScrapes.Items.Remove(chkLstScrapes.SelectedItem);                LoadSelectedScrapeToUi();            }        }        private void BtnMoveScrapeUp_Click(object? sender, EventArgs e)        {            if (chkLstScrapes.SelectedItem != null \u0026\u0026 chkLstScrapes.SelectedIndex \u003E 0)            {                int idx = chkLstScrapes.SelectedIndex;                var item = chkLstScrapes.SelectedItem;                bool isChecked = chkLstScrapes.GetItemChecked(idx);                chkLstScrapes.Items.RemoveAt(idx);                chkLstScrapes.Items.Insert(idx - 1, item);                chkLstScrapes.SetItemChecked(idx - 1, isChecked);                chkLstScrapes.SelectedIndex = idx - 1;            }        }        private void BtnMoveScrapeDown_Click(object? sender, EventArgs e)        {            if (chkLstScrapes.SelectedItem != null \u0026\u0026 chkLstScrapes.SelectedIndex \u003C chkLstScrapes.Items.Count - 1)            {                int idx = chkLstScrapes.SelectedIndex;                var item = chkLstScrapes.SelectedItem;                bool isChecked = chkLstScrapes.GetItemChecked(idx);                chkLstScrapes.Items.RemoveAt(idx);                chkLstScrapes.Items.Insert(idx \u002B 1, item);                chkLstScrapes.SetItemChecked(idx \u002B 1, isChecked);                chkLstScrapes.SelectedIndex = idx \u002B 1;            }        }        private void BtnRenameScrape_Click(object? sender, EventArgs e)        {            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)            {                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022Rename Scrape List\u0022, scrape.Name);                if (!string.IsNullOrWhiteSpace(name))                {                    scrape.Name = name.Trim();                    int idx = chkLstScrapes.SelectedIndex;                    bool isChecked = chkLstScrapes.GetItemChecked(idx);                    chkLstScrapes.Items[idx] = scrape;                    chkLstScrapes.SetItemChecked(idx, isChecked);                }            }        }        private void BtnGeneralizeContainer_Click(object? sender, EventArgs e)        {            if (!string.IsNullOrWhiteSpace(txtContainerSelector.Text))            {                string generalized = SelectorHelper.GeneralizeSelector(txtContainerSelector.Text);                txtContainerSelector.Text = generalized;                if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)                {                    scrape.SetContainerAndRelativizeFields(generalized);                    pgScrapeFieldDetails.Refresh();                }            }        }        private async void BtnHighlightContainer_Click(object? sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            string selector = txtContainerSelector.Text.Trim();            if (string.IsNullOrWhiteSpace(selector))            {                Log(\u0022[WARN] Container selector is empty.\u0022, Color.Orange);                return;            }            try            {                int count = await client.HighlightElementsAsync(selector, null, true);                Log($\u0022[SCRAPE] Highlighted {count} container element(s) matching \u0027{selector}\u0027.\u0022, Color.SpringGreen);            }            catch (Exception ex)            {                Log($\u0022[ERR] Failed to highlight container: {ex.Message}\u0022, Color.Red);            }        }        private void BtnAddScrapeField_Click(object? sender, EventArgs e)        {            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape)            {                Log(\u0022[WARN] Please select or create a scrape list first.\u0022, Color.Orange);                return;            }            var field = new ScrapeField            {                Name = scrape.GetUniqueFieldName(\u0022Field\u0022)            };            scrape.Fields.Add(field);            lstScrapeFields.Items.Add(field);            lstScrapeFields.SelectedItem = field;        }        private void BtnRemoveScrapeField_Click(object? sender, EventArgs e)        {            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape \u0026\u0026 lstScrapeFields.SelectedItem is ScrapeField field)            {                scrape.Fields.Remove(field);                lstScrapeFields.Items.Remove(field);                pgScrapeFieldDetails.SelectedObject = lstScrapeFields.SelectedItem;            }        }        private void BtnMoveScrapeFieldUp_Click(object? sender, EventArgs e)        {            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape \u0026\u0026 lstScrapeFields.SelectedItem is ScrapeField field)            {                int idx = lstScrapeFields.SelectedIndex;                if (scrape.MoveFieldUp(idx))                {                    lstScrapeFields.Items.RemoveAt(idx);                    lstScrapeFields.Items.Insert(idx - 1, field);                    lstScrapeFields.SelectedIndex = idx - 1;                }            }        }        private void BtnMoveScrapeFieldDown_Click(object? sender, EventArgs e)        {            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape \u0026\u0026 lstScrapeFields.SelectedItem is ScrapeField field)            {                int idx = lstScrapeFields.SelectedIndex;                if (scrape.MoveFieldDown(idx))                {                    lstScrapeFields.Items.RemoveAt(idx);                    lstScrapeFields.Items.Insert(idx \u002B 1, field);                    lstScrapeFields.SelectedIndex = idx \u002B 1;                }            }        }        private void BtnGeneralizeScrapeField_Click(object? sender, EventArgs e)        {            if (lstScrapeFields.SelectedItem is ScrapeField field \u0026\u0026 !string.IsNullOrWhiteSpace(field.Selector))            {                DomNode? rootDom = tvDom.Nodes.Count \u003E 0 ? tvDom.Nodes[0].Tag as DomNode : null;                field.Selector = SelectorHelper.GeneralizeRepeatingFieldSelector(field.Selector, rootDom);                field.MatchAllElements = true;                pgScrapeFieldDetails.Refresh();                RefreshSelectedFieldItemText();            }        }        private async void BtnHighlightScrapeField_Click(object? sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            if (lstScrapeFields.SelectedItem is not ScrapeField field || string.IsNullOrWhiteSpace(field.Selector))            {                Log(\u0022[WARN] Please select a field with a valid selector first.\u0022, Color.Orange);                return;            }            string? containerSelector = (chkLstScrapes.SelectedItem as ScrapeDefinition)?.ContainerSelector;            try            {                int count = await client.HighlightElementsAsync(                    field.Selector,                    containerSelector,                    field.MatchAllElements || !string.IsNullOrWhiteSpace(containerSelector));                Log($\u0022[SCRAPE] Highlighted {count} element(s) for field \u0027{field.Name}\u0027.\u0022, Color.SpringGreen);            }            catch (Exception ex)            {                Log($\u0022[ERR] Highlight failed: {ex.Message}\u0022, Color.Red);            }        }        private void LstScrapeFields_SelectedIndexChanged(object? sender, EventArgs e)        {            pgScrapeFieldDetails.SelectedObject = lstScrapeFields.SelectedItem;        }        private void PgScrapeFieldDetails_PropertyValueChanged(object? s, PropertyValueChangedEventArgs e)        {            RefreshSelectedFieldItemText();        }        private void RefreshSelectedFieldItemText()        {            int idx = lstScrapeFields.SelectedIndex;            if (idx \u003E= 0)            {                var item = lstScrapeFields.Items[idx];                lstScrapeFields.Items[idx] = item;            }        }        private async void MnuQuickScrapeText_Click(object? sender, EventArgs e)        {            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)            {                var extType = domNode.GetSuggestedExtractionType();                Log($\u0022[SCRAPE] Testing extraction ({extType}) on {domNode.Path}...\u0022, Color.SpringGreen);                try                {                    string? val = await client.ScrapeElementAsync(domNode.Path, extType);                    Log($\u0022[SCRAPE-RX] Extracted Value: {val}\u0022, Color.White);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Quick scrape failed: {ex.Message}\u0022, Color.Red);                }            }        }        private void AddFieldFromSelectedDomNode(ScrapeDefinition scrape, bool matchAllElements)        {            if (tvDom.SelectedNode?.Tag is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))                return;            DomNode? rootDom = tvDom.Nodes.Count \u003E 0 ? tvDom.Nodes[0].Tag as DomNode : null;            var suggestedType = domNode.GetSuggestedExtractionType();            string baseName = domNode.GetSuggestedFieldName(suggestedType);            string uniqueName = scrape.GetUniqueFieldName(baseName);            var field = domNode.CreateScrapeField(                fieldName: uniqueName,                extractionType: suggestedType,                containerSelector: scrape.ContainerSelector,                matchAllElements: matchAllElements,                rootDom: rootDom);            scrape.Fields.Add(field);            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                lstScrapeFields.Items.Add(field);                lstScrapeFields.SelectedItem = field;            }            Log($\u0022[SCRAPE] Added field \u0027{field.Name}\u0027 ({field.ExtractionType}) to \u0027{scrape.Name}\u0027.\u0022, Color.SpringGreen);        }        private void SetContainerFromSelectedDomNode(ScrapeDefinition scrape)        {            if (tvDom.SelectedNode?.Tag is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))                return;            string generalizedContainer = domNode.GetGeneralizedPath();            scrape.SetContainerAndRelativizeFields(generalizedContainer);            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                LoadSelectedScrapeToUi();            }            Log($\u0022[SCRAPE] Set repeating container for \u0027{scrape.Name}\u0027 to: {generalizedContainer}\u0022, Color.SpringGreen);        }        private void SetPaginationNextFromSelectedDomNode(ScrapeDefinition scrape)        {            if (tvDom.SelectedNode?.Tag is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))                return;            scrape.EnablePagination = true;            scrape.NextPageSelector = domNode.Path;            if (scrape.MaxPages \u003C 2) scrape.MaxPages = 3;            if (chkLstScrapes.SelectedItem != scrape)            {                chkLstScrapes.SelectedItem = scrape;            }            else            {                LoadSelectedScrapeToUi();            }            Log($\u0022[SCRAPE] Set pagination Next button for \u0027{scrape.Name}\u0027 to: {domNode.Path}\u0022, Color.SpringGreen);        }        private async void BtnPreviewScrape_Click(object? sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape)            {                Log(\u0022[WARN] Please select a scrape list to preview.\u0022, Color.Orange);                return;            }            if (scrape.Fields.Count == 0)            {                Log(\u0022[WARN] The selected scrape list has no fields defined.\u0022, Color.Orange);                return;            }            btnPreviewScrape.Enabled = false;            try            {                var sequences = chkLstSequences.Items.Cast\u003CAutomationSequence\u003E().ToList();                var result = await _scraper.RunScrapeAsync(client, scrape, sequences);                DisplayScrapeResult(result);            }            catch (Exception ex)            {                Log($\u0022[ERR] Scrape preview failed: {ex.Message}\u0022, Color.Red);            }            finally            {                btnPreviewScrape.Enabled = true;            }        }        private async void BtnRunAllScrapes_Click(object? sender, EventArgs e)        {            if (lstClients.SelectedItem is not BrowserClient client)            {                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);                return;            }            var project = BuildCurrentProjectFromUi();            if (!project.Scrapes.Any(s =\u003E s.IsActive))            {                Log(\u0022[WARN] No active scrape lists selected to run.\u0022, Color.Orange);                return;            }            btnRunAllScrapes.Enabled = false;            try            {                var results = await _scraper.RunProjectScrapesAsync(client, project);                if (results.Count \u003E 0)                {                    var combined = new ScrapeResult                    {                        ScrapeName = results.Count == 1 ? results[0].ScrapeName : \u0022Combined Active Scrapes\u0022,                        PagesScraped = results.Sum(r =\u003E r.PagesScraped)                    };                    foreach (var r in results)                    {                        combined.Merge(r);                    }                    DisplayScrapeResult(combined);                }            }            catch (Exception ex)            {                Log($\u0022[ERR] Active scrapes run aborted: {ex.Message}\u0022, Color.Red);            }            finally            {                btnRunAllScrapes.Enabled = true;            }        }        private void DisplayScrapeResult(ScrapeResult result)        {            _lastScrapeResult = result;            lblScrapeStatus.Text = $\u0022Results: {result.RecordCount} record(s) | Pages: {result.PagesScraped} | Source: {result.ScrapeName}\u0022;            dgvScrapePreview.DataSource = result.ToDataTable();            txtScrapeJsonPreview.Text = result.ToJson(true, true);        }        private void BtnCopyScrapeJson_Click(object? sender, EventArgs e)        {            if (_lastScrapeResult == null || _lastScrapeResult.RecordCount == 0)            {                Log(\u0022[WARN] No scrape results available to copy.\u0022, Color.Orange);                return;            }            Clipboard.SetText(_lastScrapeResult.ToJson(true, true));            Log(\u0022[SCRAPE] Copied scraped JSON records to clipboard.\u0022, Color.Lime);        }        private void BtnExportScrapeJson_Click(object? sender, EventArgs e)        {            if (_lastScrapeResult == null || _lastScrapeResult.RecordCount == 0)            {                Log(\u0022[WARN] No scrape results available to export.\u0022, Color.Orange);                return;            }            using var sfd = new SaveFileDialog            {                Filter = \u0022JSON Files (.json)|.json|All Files (.)|.\u0022,                Title = \u0022Export Scrape Results as JSON\u0022,                DefaultExt = \u0022json\u0022,                FileName = $\u0022{_lastScrapeResult.ScrapeName.Replace(\u0027 \u0027, \u0027_\u0027)}.json\u0022            };            if (sfd.ShowDialog() == DialogResult.OK)            {                try                {                    _lastScrapeResult.SaveToJsonFile(sfd.FileName, recordsOnly: true);                    Log($\u0022[SCRAPE] Exported {_lastScrapeResult.RecordCount} record(s) to {sfd.FileName}\u0022, Color.Lime);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Failed to export JSON: {ex.Message}\u0022, Color.Red);                }            }        }        private void BtnExportScrapeCsv_Click(object? sender, EventArgs e)        {            if (_lastScrapeResult == null || _lastScrapeResult.RecordCount == 0)            {                Log(\u0022[WARN] No scrape results available to export.\u0022, Color.Orange);                return;            }            using var sfd = new SaveFileDialog            {                Filter = \u0022CSV Files (.csv)|.csv|All Files (.)|.\u0022,                Title = \u0022Export Scrape Results as CSV\u0022,                DefaultExt = \u0022csv\u0022,                FileName = $\u0022{_lastScrapeResult.ScrapeName.Replace(\u0027 \u0027, \u0027_\u0027)}.csv\u0022            };            if (sfd.ShowDialog() == DialogResult.OK)            {                try                {                    _lastScrapeResult.SaveToCsvFile(sfd.FileName);                    Log($\u0022[SCRAPE] Exported {_lastScrapeResult.RecordCount} record(s) to {sfd.FileName}\u0022, Color.Lime);                }                catch (Exception ex)                {                    Log($\u0022[ERR] Failed to export CSV: {ex.Message}\u0022, Color.Red);                }            }        }    }}\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\nCitations\n\n- [https://github.com/vikikize/styledetective](https://github.com/vikikize/styledetective)",
      "ModelExplanation": "### Summary of Remaining Changes\n\n1. **Models \u0026 Runner Integration (\u0060AutomationStep.cs\u0060, \u0060BrowserEventArgs.cs\u0060, \u0060DomNode.cs\u0060, \u0060AutomationRunner.cs\u0060)**:\n   - Added \u0060AutomationActionType.Scrape\u0060 to \u0060AutomationStep\u0060.\n   - Added \u0060ScrapeEventArgs\u0060 and \u0060ScrapePageEventArgs\u0060 to \u0060BrowserEventArgs.cs\u0060.\n   - Added point-and-click helper methods on \u0060DomNode\u0060 (\u0060GetGeneralizedPath\u0060, \u0060GetSuggestedExtractionType\u0060, \u0060GetSuggestedFieldName\u0060, \u0060CreateScrapeField\u0060).\n   - Updated \u0060AutomationRunner\u0060 to handle \u0060AutomationActionType.Scrape\u0060 steps (supporting both named \u0060ScrapeDefinition\u0060 execution and direct selector extraction).\n2. **Extensions \u0026 Browser Userscript (\u0060ReactExtensions.cs\u0060, \u0060ScriptGenerator.cs\u0060)**:\n   - Added \u0060ExecuteScrapeAsync\u0060, \u0060ExecuteProjectScrapesAsync\u0060, \u0060ScrapeElementAsync\u0060, \u0060ScrapeElementsAsync\u0060, \u0060ScrapeTableAsync\u0060, \u0060HighlightElementsAsync\u0060, and \u0060CreateScrape\u0060 extension methods on \u0060BrowserClient\u0060.\n   - Updated \u0060ScriptGenerator\u0060 with \u0060SCRAPE_DATA\u0060, \u0060SCRAPE_TABLE\u0060, and \u0060HIGHLIGHT_ELEMENTS\u0060 commands, multi-element highlight overlays, and relative container selector resolution.\n3. **TestBedApp Point-and-Click Scraper UI (\u0060MainForm.Designer.cs\u0060, \u0060MainForm.cs\u0060)**:\n   - Added right-click DOM Explorer menu options to test-scrape elements, add single or repeating scrape fields, set a repeating container, or set a pagination next button.\n   - Added the **Data Scraper** tab with scrape list management, container and automation hooks (pre-scrape, post-scrape, pagination), field PropertyGrid editor, live browser multi-element highlighting, Table/JSON result preview tabs, and CSV/JSON export.\n\n### How to Test\n1. Build and run the solution, start the server, and click **Generate \u0026 Copy Script** to update your browser userscript.\n2. Right-click elements in **DOM Explorer** to add fields or containers to a scrape list, then open the **Data Scraper** tab and click **Preview Scrape** or **Run Active Scrapes**.",
