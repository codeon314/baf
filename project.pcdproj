nToken);            if (existingClient != null)            {                ActiveClient = existingClient;            }            return existingClient;        }==== REPLACE        /// \u003Csummary\u003E        /// Returns a human-readable status message describing the current Chrome Extension connection state and open tab count.        /// \u003C/summary\u003E        public string GetExtensionStatusMessage()        {            return GetExtensionStatusMessage(IsRunning, IsExtensionConnected, GetExtensionTabs().Count);        }        /// \u003Csummary\u003E        /// Returns a human-readable status message describing the Chrome Extension connection state and open tab count.        /// \u003C/summary\u003E        public static string GetExtensionStatusMessage(bool isServerRunning, bool isExtensionConnected, int openTabCount)        {            if (isExtensionConnected)            {                return $\u0022Extension: Connected ({openTabCount} open tab{(openTabCount == 1 ? \u0022\u0022 : \u0022s\u0022)})\u0022;            }            return isServerRunning                ? \u0022Extension: Waiting for connection...\u0022                : \u0022Extension: Server stopped\u0022;        }        /// \u003Csummary\u003E        /// Finds the index of a \u003Csee cref=\u0022BrowserClient\u0022/\u003E with a matching \u003Csee cref=\u0022BrowserClient.InstanceId\u0022/\u003E in an \u003Csee cref=\u0022System.Collections.IList\u0022/\u003E, or returns -1.        /// \u003C/summary\u003E        public static int FindClientIndex(System.Collections.IList items, BrowserClient? client)        {            if (items == null || client == null) return -1;            for (int i = 0; i \u003C items.Count; i\u002B\u002B)            {                if (items[i] is BrowserClient item \u0026\u0026                    string.Equals(item.InstanceId, client.InstanceId, StringComparison.Ordinal))                {                    return i;                }            }            return -1;        }        /// \u003Csummary\u003E        /// Inserts or updates \u003Cparamref name=\u0022client\u0022/\u003E inside \u003Cparamref name=\u0022items\u0022/\u003E by matching \u003Csee cref=\u0022BrowserClient.InstanceId\u0022/\u003E.        /// \u003C/summary\u003E        public static int UpsertClientInList(System.Collections.IList items, BrowserClient client)        {            if (items == null) throw new ArgumentNullException(nameof(items));            if (client == null) throw new ArgumentNullException(nameof(client));            int idx = FindClientIndex(items, client);            if (idx \u003E= 0)            {                items[idx] = client;                return idx;            }            return items.Add(client);        }        /// \u003Csummary\u003E        /// Removes all entries matching \u003Cparamref name=\u0022client\u0022/\u003E\u0027s \u003Csee cref=\u0022BrowserClient.InstanceId\u0022/\u003E from \u003Cparamref name=\u0022items\u0022/\u003E.        /// \u003C/summary\u003E        public static bool RemoveClientFromList(System.Collections.IList items, BrowserClient? client)        {            if (items == null || client == null) return false;            bool removedAny = false;            for (int i = items.Count - 1; i \u003E= 0; i--)            {                if (items[i] is BrowserClient item \u0026\u0026                    string.Equals(item.InstanceId, client.InstanceId, StringComparison.Ordinal))                {                    items.RemoveAt(i);                    removedAny = true;                }            }            return removedAny;        }        /// \u003Csummary\u003E        /// Refreshes the display entry for \u003Cparamref name=\u0022client\u0022/\u003E in \u003Cparamref name=\u0022items\u0022/\u003E if present, returning its index or -1.        /// \u003C/summary\u003E        public static int RefreshClientInList(System.Collections.IList items, BrowserClient? client)        {            int idx = FindClientIndex(items, client);            if (idx \u003E= 0 \u0026\u0026 client != null)            {                items[idx] = client;            }            return idx;        }        /// \u003Csummary\u003E        /// Validates that \u003Cparamref name=\u0022tab\u0022/\u003E allows script injection, instructs the connected Chrome Extension        /// to inject the automation bridge into the tab, and returns any already-connected \u003Csee cref=\u0022BrowserClient\u0022/\u003E for the tab.        /// \u003C/summary\u003E        public async Task\u003CBrowserClient?\u003E SwitchToExtensionTabAsync(            BrowserTabInfo tab,            bool focusBrowserTab = false,            bool detachOtherTabs = true,            IpcMode mode = IpcMode.WebSocket,            bool skipIfAlreadyActive = false,            CancellationToken cancellationToken = default)        {            if (tab == null) throw new ArgumentNullException(nameof(tab));            if (skipIfAlreadyActive \u0026\u0026 tab.IsAlreadyActiveClient(_activeClient, detachOtherTabs))            {                return _activeClient;            }            if (!tab.CanInject)                throw new InvalidOperationException($\u0022Tab #{tab.TabId} (\u0027{tab.Url}\u0027) is a restricted internal browser page and cannot be injected.\u0022);            var existingClient = GetClientForTab(tab);            await SwitchToExtensionTabAsync(tab.TabId, focusBrowserTab, detachOtherTabs, mode, cancellationToken);            if (existingClient != null)            {                ActiveClient = existingClient;            }            return existingClient;        }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Server\\BrowserClient.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH        /// \u003Csummary\u003E        /// Executes a coalesced DOM tree snapshot refresh for this client. If a refresh is already in flight,        /// queues the latest target request and invokes \u003Cparamref name=\u0022onSnapshotReady\u0022/\u003E for each completed snapshot.        /// \u003C/summary\u003E        public async Task RefreshDomSnapshotCoalescedAsync(==== REPLACE        /// \u003Csummary\u003E        /// Handles a browser middle-click element selection by attempting to select \u003Cparamref name=\u0022clickedPath\u0022/\u003E immediately via \u003Cparamref name=\u0022trySelectExistingPath\u0022/\u003E,        /// or falling back to a coalesced DOM snapshot refresh targeting \u003Cparamref name=\u0022clickedPath\u0022/\u003E if the node is not yet present in the current tree.        /// \u003C/summary\u003E        public async Task HandleElementClickedOrRefreshDomAsync(            string? clickedPath,            Func\u003Cstring, bool\u003E trySelectExistingPath,            Action onSelectedInExistingTree,            Func\u003Cstring?\u003E getCurrentSelectedPath,            Action\u003CDomSnapshotRefreshResult\u003E onSnapshotReady,            int timeoutSeconds = 10)        {            if (string.IsNullOrEmpty(clickedPath))                return;            if (trySelectExistingPath(clickedPath))            {                onSelectedInExistingTree();                return;            }            await RefreshDomSnapshotCoalescedAsync(                getCurrentSelectedPath,                onSnapshotReady,                targetSelectedPath: clickedPath,                hasTargetPath: true,                timeoutSeconds: timeoutSeconds).ConfigureAwait(true);        }        /// \u003Csummary\u003E        /// Executes a coalesced DOM tree snapshot refresh for this client. If a refresh is already in flight,        /// queues the latest target request and invokes \u003Cparamref name=\u0022onSnapshotReady\u0022/\u003E for each completed snapshot.        /// \u003C/summary\u003E        public async Task RefreshDomSnapshotCoalescedAsync(\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Automation\\AutomationStudioSession.cs**\n\n\u0060\u0060\u0060\ncsusing System;using System.Collections.Generic;using System.Threading;using System.Threading.Tasks;using BrowserAutomationFramework.Extensions;using BrowserAutomationFramework.Generators;using BrowserAutomationFramework.Models;using BrowserAutomationFramework.ReverseEngineering;using BrowserAutomationFramework.Scraping;using BrowserAutomationFramework.Server;namespace BrowserAutomationFramework.Automation{    /// \u003Csummary\u003E    /// High-level studio session controller that coordinates \u003Csee cref=\u0022AutomationServer\u0022/\u003E, \u003Csee cref=\u0022AutomationProject\u0022/\u003E,    /// \u003Csee cref=\u0022AutomationRunner\u0022/\u003E, \u003Csee cref=\u0022DataScraper\u0022/\u003E, and \u003Csee cref=\u0022SiteDumper\u0022/\u003E into a single facade with unified logging and state management.    /// \u003C/summary\u003E    public class AutomationStudioSession : IDisposable    {        private AutomationServer? _server;        private bool _exclusiveTabMode = true;        private bool _disposed;        /// \u003Csummary\u003E        /// Gets the active \u003Csee cref=\u0022AutomationProject\u0022/\u003E managed by this session.        /// \u003C/summary\u003E        public AutomationProject Project { get; private set; } = new();        /// \u003Csummary\u003E        /// Gets the current \u003Csee cref=\u0022AutomationServer\u0022/\u003E instance if started.        /// \u003C/summary\u003E        public AutomationServer? Server =\u003E _server;        /// \u003Csummary\u003E        /// Gets the \u003Csee cref=\u0022AutomationRunner\u0022/\u003E engine for this session.        /// \u003C/summary\u003E        public AutomationRunner Runner { get; }        /// \u003Csummary\u003E        /// Gets the \u003Csee cref=\u0022DataScraper\u0022/\u003E engine for this session.        /// \u003C/summary\u003E        public DataScraper Scraper { get; }        /// \u003Csummary\u003E        /// Gets the \u003Csee cref=\u0022SiteDumper\u0022/\u003E reverse-engineering engine for this session.        /// \u003C/summary\u003E        public SiteDumper SiteDumper { get; }        /// \u003Csummary\u003E        /// Gets the most recent \u003Csee cref=\u0022ScrapeResult\u0022/\u003E produced during this session, if any.        /// \u003C/summary\u003E        public ScrapeResult? LastScrapeResult { get; private set; }        /// \u003Csummary\u003E        /// Gets the most recent \u003Csee cref=\u0022SiteDumpResult\u0022/\u003E produced during this session, if any.        /// \u003C/summary\u003E        public SiteDumpResult? LastSiteDumpResult { get; private set; }        /// \u003Csummary\u003E        /// Gets or sets whether switching to a Chrome Extension tab detaches other tabs automatically.        /// \u003C/summary\u003E        public bool ExclusiveTabMode        {            get =\u003E _exclusiveTabMode;            set            {                _exclusiveTabMode = value;                if (_server != null)                {                    _server.ExclusiveTabMode = value;                }            }        }        /// \u003Csummary\u003E        /// Gets or sets the currently active/selected \u003Csee cref=\u0022BrowserClient\u0022/\u003E on the server.        /// \u003C/summary\u003E        public BrowserClient? ActiveClient        {            get =\u003E _server?.ActiveClient;            set            {                if (_server != null)                {                    _server.ActiveClient = value;                }            }        }        /// \u003Csummary\u003E        /// Gets whether the \u003Csee cref=\u0022AutomationServer\u0022/\u003E is currently running.        /// \u003C/summary\u003E        public bool IsServerRunning =\u003E _server?.IsRunning ?? false;        /// \u003Csummary\u003E        /// Gets whether the BAF Chrome Extension is currently connected to the server.        /// \u003C/summary\u003E        public bool IsExtensionConnected =\u003E _server?.IsExtensionConnected ?? false;        /// \u003Csummary\u003E        /// Raised whenever any component in the session emits a formatted log message.        /// \u003C/summary\u003E        public event EventHandler\u003CAutomationLogEventArgs\u003E? OnLog;        /// \u003Csummary\u003E        /// Raised when the scraper status bar summary text changes.        /// \u003C/summary\u003E        public event EventHandler\u003Cstring\u003E? OnScrapeStatusChanged;        /// \u003Csummary\u003E        /// Raised when the reverse-engineering dump status bar summary text changes.        /// \u003C/summary\u003E        public event EventHandler\u003Cstring\u003E? OnDumpStatusChanged;        /// \u003Csummary\u003E        /// Raised when an HTTP 429 rate-limit response is detected during scraping.        /// \u003C/summary\u003E        public event EventHandler\u003CScrapeRateLimitEventArgs\u003E? OnRateLimitDetected;        /// \u003Csummary\u003E        /// Raised when a new \u003Csee cref=\u0022ScrapeResult\u0022/\u003E is available for display.        /// \u003C/summary\u003E        public event EventHandler\u003CScrapeResult\u003E? OnScrapeResultAvailable;        /// \u003Csummary\u003E        /// Raised when a new \u003Csee cref=\u0022SiteDumpResult\u0022/\u003E is available for display.        /// \u003C/summary\u003E        public event EventHandler\u003CSiteDumpResult\u003E? OnSiteDumpResultAvailable;        /// \u003Csummary\u003E        /// Raised when a \u003Csee cref=\u0022BrowserClient\u0022/\u003E connects to the server.        /// \u003C/summary\u003E        public event EventHandler\u003CBrowserClient\u003E? OnClientConnected;        /// \u003Csummary\u003E        /// Raised when a \u003Csee cref=\u0022BrowserClient\u0022/\u003E disconnects from the server.        /// \u003C/summary\u003E        public event EventHandler\u003CBrowserClient\u003E? OnClientDisconnected;        /// \u003Csummary\u003E        /// Raised when a connected \u003Csee cref=\u0022BrowserClient\u0022/\u003E updates its metadata (title, URL, or IPC mode).        /// \u003C/summary\u003E        public event EventHandler\u003CBrowserClient\u003E? OnClientMetadataUpdated;        /// \u003Csummary\u003E        /// Raised when \u003Csee cref=\u0022ActiveClient\u0022/\u003E changes.        /// \u003C/summary\u003E        public event EventHandler\u003CBrowserClient?\u003E? OnActiveClientChanged;        /// \u003Csummary\u003E        /// Raised when \u003Csee cref=\u0022ActiveClient\u0022/\u003E finishes loading a page.        /// \u003C/summary\u003E        public event EventHandler\u003CPageLoadedEventArgs\u003E? OnActiveClientPageLoaded;        /// \u003Csummary\u003E        /// Raised when \u003Csee cref=\u0022ActiveClient\u0022/\u003E reports a DOM mutation.        /// \u003C/summary\u003E        public event EventHandler\u003CDomChangedEventArgs\u003E? OnActiveClientDomChanged;        /// \u003Csummary\u003E        /// Raised when the highlighted element on \u003Csee cref=\u0022ActiveClient\u0022/\u003E is removed from the DOM.        /// \u003C/summary\u003E        public event EventHandler? OnActiveClientHighlightedElementRemoved;        /// \u003Csummary\u003E        /// Raised when an element is middle-clicked in the \u003Csee cref=\u0022ActiveClient\u0022/\u003E browser tab.        /// \u003C/summary\u003E        public event EventHandler\u003CElementClickedEventArgs\u003E? OnActiveClientElementClicked;        /// \u003Csummary\u003E        /// Raised when the Chrome Extension connects, disconnects, or updates its open tab list.        /// \u003C/summary\u003E        public event EventHandler? OnExtensionStateChanged;        /// \u003Csummary\u003E        /// Raised when the Chrome Extension reports an updated list of open browser tabs.        /// \u003C/summary\u003E        public event EventHandler\u003CExtensionTabsEventArgs\u003E? OnExtensionTabsUpdated;        /// \u003Csummary\u003E        /// Initializes a new instance of the \u003Csee cref=\u0022AutomationStudioSession\u0022/\u003E class and wires all engine lifecycle events.        /// \u003C/summary\u003E        public AutomationStudioSession()        {            Runner = new AutomationRunner();            Scraper = Runner.Scraper;            SiteDumper = Runner.SiteDumper;            Runner.OnSequenceStarted \u002B= (s, e) =\u003E Log(\u0022AUTO\u0022, e.GetStartedLogMessage(), AutomationLogLevel.Automation);            Runner.OnStepStarted \u002B= (s, e) =\u003E Log(\u0022AUTO\u0022, e.GetStartedLogMessage(), AutomationLogLevel.AutomationStep);            Runner.OnStepCompleted \u002B= (s, e) =\u003E            {                if (e.Result != null)                {                    Log(\u0022AUTO-RX\u0022, e.GetCompletedLogMessage(), AutomationLogLevel.CommandRx);                }            };            Scraper.OnScrapeStarted \u002B= (s, e) =\u003E Log(\u0022SCRAPE\u0022, e.GetStartedLogMessage(), AutomationLogLevel.ScrapeStart);            Scraper.OnScrapePageCompleted \u002B= (s, e) =\u003E Log(\u0022SCRAPE\u0022, e.GetLogMessage(), AutomationLogLevel.ScrapePage);            Scraper.OnPageTurnDelay \u002B= (s, e) =\u003E            {                string msg = e.GetStatusMessage();                Log(\u0022SCRAPE\u0022, msg, AutomationLogLevel.ScrapeDelay);                OnScrapeStatusChanged?.Invoke(this, msg);            };            Scraper.OnRateLimitDetected \u002B= (s, e) =\u003E            {                Log(\u0022RATE-LIMIT 429\u0022, e.GetLogMessage(), AutomationLogLevel.Warning);                OnScrapeStatusChanged?.Invoke(this, e.GetStatusMessage());                OnRateLimitDetected?.Invoke(this, e);            };            Scraper.OnScrapeCompleted \u002B= (s, e) =\u003E            {                if (e.Result != null)                {                    Log(\u0022SCRAPE\u0022, e.GetCompletedLogMessage(), AutomationLogLevel.Success);                    SetLastScrapeResult(e.Result);                }            };            Scraper.OnScrapeFailed \u002B= (s, e) =\u003E Log(\u0022SCRAPE-ERR\u0022, e.GetFailedLogMessage(), AutomationLogLevel.Error);            SiteDumper.OnDumpStarted \u002B= (s, e) =\u003E Log(\u0022REV-ENG\u0022, e.GetStartedLogMessage(), AutomationLogLevel.ReverseEngineering);            SiteDumper.OnDumpCompleted \u002B= (s, e) =\u003E            {                if (e.Result != null)                {                    Log(\u0022REV-ENG\u0022, e.GetCompletedLogMessage(), AutomationLogLevel.Success);                    SetLastSiteDumpResult(e.Result);                }            };            SiteDumper.OnDumpFailed \u002B= (s, e) =\u003E Log(\u0022REV-ENG-ERR\u0022, e.GetFailedLogMessage(), AutomationLogLevel.Error);        }        /// \u003Csummary\u003E        /// Emits a structured log message to \u003Csee cref=\u0022OnLog\u0022/\u003E.        /// \u003C/summary\u003E        public void Log(string category, string message, AutomationLogLevel level = AutomationLogLevel.Default)        {            OnLog?.Invoke(this, new AutomationLogEventArgs(category, message, level));        }        /// \u003Csummary\u003E        /// Attempts to synchronize the default unpacked Chrome Extension folder on startup without throwing if disk access is restricted.        /// \u003C/summary\u003E        public void TrySyncDefaultChromeExtensionQuietly(int port = 9999, IpcMode mode = IpcMode.WebSocket)        {            try            {                ChromeExtensionGenerator.SyncDefaultDirectory(port, mode);            }            catch { }        }        /// \u003Csummary\u003E        /// Updates \u003Csee cref=\u0022LastScrapeResult\u0022/\u003E and raises \u003Csee cref=\u0022OnScrapeStatusChanged\u0022/\u003E and \u003Csee cref=\u0022OnScrapeResultAvailable\u0022/\u003E.        /// \u003C/summary\u003E        public void SetLastScrapeResult(ScrapeResult result)        {            if (result == null) return;            LastScrapeResult = result;            OnScrapeStatusChanged?.Invoke(this, result.GetStatusSummary());            OnScrapeResultAvailable?.Invoke(this, result);        }        /// \u003Csummary\u003E        /// Updates \u003Csee cref=\u0022LastSiteDumpResult\u0022/\u003E and raises \u003Csee cref=\u0022OnDumpStatusChanged\u0022/\u003E and \u003Csee cref=\u0022OnSiteDumpResultAvailable\u0022/\u003E.        /// \u003C/summary\u003E        public void SetLastSiteDumpResult(SiteDumpResult result)        {            if (result == null) return;            LastSiteDumpResult = result;            OnDumpStatusChanged?.Invoke(this, result.GetStatusSummary());            OnSiteDumpResultAvailable?.Invoke(this, result);        }        /// \u003Csummary\u003E        /// Returns a formatted status string describing the current Chrome Extension connection and open tab count.        /// \u003C/summary\u003E        public string GetExtensionStatusMessage()        {            return _server != null                ? _server.GetExtensionStatusMessage()                : AutomationServer.GetExtensionStatusMessage(false, false, 0);        }        /// \u003Csummary\u003E        /// Returns all open browser tabs reported by the Chrome Extension, optionally filtered by a search string.        /// \u003C/summary\u003E        public IReadOnlyList\u003CBrowserTabInfo\u003E GetExtensionTabs(string? filter = null)        {            return _server?.GetExtensionTabs(filter) ?? Array.Empty\u003CBrowserTabInfo\u003E();        }        /// \u003Csummary\u003E        /// Creates, configures, and starts a new \u003Csee cref=\u0022AutomationServer\u0022/\u003E on the specified \u003Cparamref name=\u0022port\u0022/\u003E.        /// \u003C/summary\u003E        public async Task StartServerAsync(int port, IpcMode mode = IpcMode.WebSocket, CancellationToken cancellationToken = default)        {            _server?.Dispose();            _server = new AutomationServer(port)            {                ExclusiveTabMode = _exclusiveTabMode            };            try            {                string defaultExtDir = _server.SyncDefaultChromeExtension(mode);                Log(\u0022EXT\u0022, $\u0022Synced Chrome Extension files (Port {port}) at: {defaultExtDir}\u0022, AutomationLogLevel.Extension);            }            catch (Exception ex)            {                Log(\u0022WARN\u0022, $\u0022Could not auto-sync default ChromeExtension folder: {ex.Message}\u0022, AutomationLogLevel.Warning);            }            _server.OnClientConnected \u002B= (s, c) =\u003E            {                Log(\u0022SYS\u0022, $\u0022Client Connected: {c.InstanceId} via {c.Mode}\u0022, AutomationLogLevel.ClientConnected);                OnClientConnected?.Invoke(this, c);            };            _server.OnClientDisconnected \u002B= (s, c) =\u003E            {                Log(\u0022SYS\u0022, $\u0022Client Disconnected: {c.InstanceId}\u0022, AutomationLogLevel.Warning);                OnClientDisconnected?.Invoke(this, c);            };            _server.OnClientMetadataUpdated \u002B= (s, c) =\u003E OnClientMetadataUpdated?.Invoke(this, c);            _server.OnActiveClientChanged \u002B= (s, c) =\u003E OnActiveClientChanged?.Invoke(this, c);            _server.OnClientModeChanged \u002B= (s, c) =\u003E Log(\u0022SYS\u0022, $\u0022Client {c.InstanceId} switched IPC transport to {c.Mode}.\u0022, AutomationLogLevel.System);            _server.OnClientStreamDataReceived \u002B= (s, ev) =\u003E Log($\u0022STREAM \u003C- {ev.Client.InstanceId}\u0022, ev.Result.Output ?? string.Empty, AutomationLogLevel.Stream);            _server.OnClientPageLoaded \u002B= (s, ev) =\u003E            {                Log(string.Empty, ev.Args.GetLogMessage(ev.Client.InstanceId), ev.Args.IsRateLimited ? AutomationLogLevel.Warning : AutomationLogLevel.Navigation);            };            _server.OnActiveClientPageLoaded \u002B= (s, e) =\u003E OnActiveClientPageLoaded?.Invoke(s, e);            _server.OnActiveClientDomChanged \u002B= (s, e) =\u003E OnActiveClientDomChanged?.Invoke(s, e);            _server.OnActiveClientHighlightedElementRemoved \u002B= (s, e) =\u003E OnActiveClientHighlightedElementRemoved?.Invoke(s, e);            _server.OnActiveClientElementClicked \u002B= (s, e) =\u003E OnActiveClientElementClicked?.Invoke(s, e);            _server.OnExtensionConnected \u002B= (s, e) =\u003E            {                Log(\u0022EXT\u0022, \u0022Chrome Extension connected to Automation Server!\u0022, AutomationLogLevel.ClientConnected);                OnExtensionStateChanged?.Invoke(this, EventArgs.Empty);            };            _server.OnExtensionDisconnected \u002B= (s, e) =\u003E            {                Log(\u0022EXT\u0022, \u0022Chrome Extension disconnected.\u0022, AutomationLogLevel.Warning);                OnExtensionStateChanged?.Invoke(this, EventArgs.Empty);            };            _server.OnExtensionTabsUpdated \u002B= (s, e) =\u003E            {                OnExtensionStateChanged?.Invoke(this, EventArgs.Empty);                OnExtensionTabsUpdated?.Invoke(this, e);            };            Log(\u0022SYS\u0022, $\u0022Starting Automation Server on port {port}...\u0022, AutomationLogLevel.System);            OnExtensionStateChanged?.Invoke(this, EventArgs.Empty);            try            {                await _server.StartAsync(cancellationToken);            }            catch (Exception ex) when (ex is not OperationCanceledException)            {                Log(\u0022ERR\u0022, $\u0022Server error: {ex.Message}\u0022, AutomationLogLevel.Error);                StopServer();                throw;            }        }        /// \u003Csummary\u003E        /// Stops the active \u003Csee cref=\u0022AutomationServer\u0022/\u003E if running.        /// \u003C/summary\u003E        public void StopServer()        {            _server?.Stop();            Log(\u0022SYS\u0022, \u0022Server stopped.\u0022, AutomationLogLevel.ServerStopped);            OnExtensionStateChanged?.Invoke(this, EventArgs.Empty);        }        /// \u003Csummary\u003E        /// Resets \u003Csee cref=\u0022Project\u0022/\u003E to a new empty \u003Csee cref=\u0022AutomationProject\u0022/\u003E.        /// \u003C/summary\u003E        public AutomationProject ResetProject()        {            Project.Reset();            Log(\u0022SYS\u0022, \u0022Started new automation project.\u0022, AutomationLogLevel.System);            return Project;        }        /// \u003Csummary\u003E        /// Loads an \u003Csee cref=\u0022AutomationProject\u0022/\u003E from disk into \u003Csee cref=\u0022Project\u0022/\u003E.        /// \u003C/summary\u003E        public AutomationProject LoadProjectFromFile(string filePath)        {            Project = AutomationProject.LoadFromFile(filePath);            Log(\u0022SYS\u0022, $\u0022Loaded project from {filePath}\u0022, AutomationLogLevel.Success);            return Project;        }        /// \u003Csummary\u003E        /// Saves \u003Csee cref=\u0022Project\u0022/\u003E to the specified file path.        /// \u003C/summary\u003E        public void SaveProjectToFile(string filePath)        {            Project.SaveToFile(filePath);            Log(\u0022SYS\u0022, $\u0022Saved project to {filePath}\u0022, AutomationLogLevel.Success);        }        /// \u003Csummary\u003E        /// Generates a Tampermonkey userscript for the current \u003Csee cref=\u0022Project\u0022/\u003E.        /// \u003C/summary\u003E        public string GenerateUserscript(int port, IpcMode mode)        {            if (!Project.HasValidMatchRules)            {                Log(\u0022WARN\u0022, \u0022No Match URLs provided. Defaulting to match any site.\u0022, AutomationLogLevel.Warning);            }            string script = ScriptGenerator.Generate(Project, port, mode);            Log(\u0022SYS\u0022, $\u0022Tampermonkey script generated for {mode} and copied to clipboard!\u0022, AutomationLogLevel.Success);            return script;        }        /// \u003Csummary\u003E        /// Exports the unpacked BAF Chrome Extension to \u003Cparamref name=\u0022folderPath\u0022/\u003E and returns the user load instructions.        /// \u003C/summary\u003E        public string ExportChromeExtension(string folderPath, int port, IpcMode mode)        {            string savedPath = ChromeExtensionGenerator.ExportToDirectory(folderPath, port, mode);            Log(\u0022EXT\u0022, $\u0022Exported unpacked Chrome Extension (Port {port}, {mode}) to: {savedPath}\u0022, AutomationLogLevel.Success);            return ChromeExtensionGenerator.GetLoadInstructions(savedPath);        }        /// \u003Csummary\u003E        /// Resolves the target \u003Csee cref=\u0022BrowserClient\u0022/\u003E (using \u003Cparamref name=\u0022explicitClient\u0022/\u003E or \u003Csee cref=\u0022ActiveClient\u0022/\u003E),        /// logging a warning if no client is selected.        /// \u003C/summary\u003E        public BrowserClient? RequireClient(BrowserClient? explicitClient = null, string warningMessage = \u0022Please select a connected client first.\u0022)        {            var client = explicitClient ?? ActiveClient;            if (client == null)            {                Log(\u0022WARN\u0022, warningMessage, AutomationLogLevel.Warning);            }            return client;        }        /// \u003Csummary\u003E        /// Resolves the most recent root \u003Csee cref=\u0022DomNode\u0022/\u003E from \u003Csee cref=\u0022ActiveClient\u0022/\u003E or \u003Cparamref name=\u0022fallbackDomRoot\u0022/\u003E.        /// \u003C/summary\u003E        public DomNode? ResolveDomRoot(DomNode? fallbackDomRoot = null)        {            return ActiveClient?.ResolveDomRoot(fallbackDomRoot) ?? fallbackDomRoot;        }        /// \u003Csummary\u003E        /// Instructs the Chrome Extension to inject and switch to \u003Cparamref name=\u0022tab\u0022/\u003E.        /// Returns any already-connected \u003Csee cref=\u0022BrowserClient\u0022/\u003E for that tab if an immediate DOM refresh should be triggered.        /// \u003C/summary\u003E        public async Task\u003CBrowserClient?\u003E SwitchToExtensionTabAsync(            BrowserTabInfo? tab,            IpcMode mode,            bool focusBrowserTab = false,            bool skipIfAlreadyActive = false,            CancellationToken cancellationToken = default)        {            if (tab == null)            {                Log(\u0022WARN\u0022, \u0022Please select a browser tab from the Chrome Extension tabs list first.\u0022, AutomationLogLevel.Warning);                return null;            }            if (_server == null)            {                Log(\u0022WARN\u0022, \u0022Start the Automation Server first.\u0022, AutomationLogLevel.Warning);                return null;            }            if (skipIfAlreadyActive \u0026\u0026 tab.IsAlreadyActiveClient(ActiveClient, _exclusiveTabMode))            {                return null;            }            Log(\u0022EXT\u0022, $\u0022Injecting \u0026 switching to Tab #{tab.TabId}: {tab.Title} ({tab.Url})\u0022, AutomationLogLevel.Extension);            try            {                return await _server.SwitchToExtensionTabAsync(tab, focusBrowserTab, _exclusiveTabMode, mode, skipIfAlreadyActive: false, cancellationToken);            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Failed to switch to tab #{tab.TabId}: {ex.Message}\u0022, AutomationLogLevel.Error);                return null;            }        }        /// \u003Csummary\u003E        /// Detaches the automation bridge from \u003Cparamref name=\u0022tab\u0022/\u003E.        /// \u003C/summary\u003E        public async Task DetachExtensionTabAsync(BrowserTabInfo? tab, CancellationToken cancellationToken = default)        {            if (_server == null) return;            if (tab == null)            {                Log(\u0022WARN\u0022, \u0022Please select a tab to detach.\u0022, AutomationLogLevel.Warning);                return;            }            Log(\u0022EXT\u0022, $\u0022Detaching automation bridge from Tab #{tab.TabId}...\u0022, AutomationLogLevel.ServerStopped);            try            {                await _server.DetachExtensionTabAsync(tab.TabId, cancellationToken);            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Failed to detach tab: {ex.Message}\u0022, AutomationLogLevel.Error);            }        }        /// \u003Csummary\u003E        /// Brings \u003Cparamref name=\u0022tab\u0022/\u003E to the foreground in Chrome.        /// \u003C/summary\u003E        public async Task FocusExtensionTabAsync(BrowserTabInfo? tab, CancellationToken cancellationToken = default)        {            if (_server == null) return;            if (tab == null)            {                Log(\u0022WARN\u0022, \u0022Please select a tab to focus in Chrome.\u0022, AutomationLogLevel.Warning);                return;            }            try            {                await _server.FocusExtensionTabAsync(tab.TabId, cancellationToken);            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Failed to focus tab: {ex.Message}\u0022, AutomationLogLevel.Error);            }        }        /// \u003Csummary\u003E        /// Requests an immediate refresh of open tabs from the Chrome Extension.        /// \u003C/summary\u003E        public async Task RefreshExtensionTabsAsync(CancellationToken cancellationToken = default)        {            if (_server == null) return;            try            {                await _server.RequestExtensionTabsRefreshAsync(cancellationToken);            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Failed to refresh tabs: {ex.Message}\u0022, AutomationLogLevel.Error);            }        }        /// \u003Csummary\u003E        /// Sends a raw command and payload to the specified or active \u003Csee cref=\u0022BrowserClient\u0022/\u003E.        /// \u003C/summary\u003E        public async Task\u003CCommandResult?\u003E SendRawCommandAsync(string type, string? payloadStr, BrowserClient? client = null, CancellationToken cancellationToken = default)        {            var target = RequireClient(client, \u0022Please select a client from the list first.\u0022);            if (target == null) return null;            Log($\u0022TX -\u003E {target.InstanceId}\u0022, $\u0022{type} | Payload: {payloadStr}\u0022, AutomationLogLevel.CommandTx);            try            {                var result = await target.SendRawCommandAsync(type, payloadStr, cancellationToken);                Log($\u0022RX \u003C- {target.InstanceId}\u0022, $\u0022Status: {result.Status} | Output: {result.Output}\u0022, AutomationLogLevel.CommandRx);                return result;            }            catch (Exception ex)            {                Log($\u0022ERR \u003C- {target.InstanceId}\u0022, ex.Message, AutomationLogLevel.Error);                return null;            }        }        /// \u003Csummary\u003E        /// Sends a \u003Cc\u003EREACT_CLICK\u003C/c\u003E command for \u003Cparamref name=\u0022selector\u0022/\u003E to the specified or active \u003Csee cref=\u0022BrowserClient\u0022/\u003E.        /// \u003C/summary\u003E        public async Task\u003CCommandResult?\u003E TestReactClickAsync(string selector, BrowserClient? client = null, CancellationToken cancellationToken = default)        {            var target = client ?? ActiveClient;            if (target == null) return null;            string trimmed = selector?.Trim() ?? string.Empty;            Log($\u0022TX -\u003E {target.InstanceId}\u0022, $\u0022REACT_CLICK | Selector: {trimmed}\u0022, AutomationLogLevel.CommandTx);            try            {                var result = await target.ClickReactElementAsync(trimmed, cancellationToken);                Log($\u0022RX \u003C- {target.InstanceId}\u0022, $\u0022Status: {result.Status} | Output: {result.Output}\u0022, AutomationLogLevel.CommandRx);                return result;            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, ex.Message, AutomationLogLevel.Error);                return null;            }        }        /// \u003Csummary\u003E        /// Evaluates JavaScript \u003Cparamref name=\u0022code\u0022/\u003E on the specified or active \u003Csee cref=\u0022BrowserClient\u0022/\u003E.        /// \u003C/summary\u003E        public async Task\u003CCommandResult?\u003E TestEvalAsync(string code, BrowserClient? client = null, CancellationToken cancellationToken = default)        {            var target = client ?? ActiveClient;            if (target == null) return null;            string trimmed = code?.Trim() ?? string.Empty;            Log($\u0022TX -\u003E {target.InstanceId}\u0022, $\u0022EVAL | Code: {trimmed}\u0022, AutomationLogLevel.CommandTx);            try            {                var result = await target.EvaluateJavaScriptAsync(trimmed, cancellationToken);                Log($\u0022RX \u003C- {target.InstanceId}\u0022, $\u0022Status: {result.Status} | Output: {result.Output}\u0022, AutomationLogLevel.CommandRx);                return result;            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, ex.Message, AutomationLogLevel.Error);                return null;            }        }        /// \u003Csummary\u003E        /// Tests clicking a \u003Csee cref=\u0022DomNode\u0022/\u003E on the specified or active \u003Csee cref=\u0022BrowserClient\u0022/\u003E.        /// \u003C/summary\u003E        public async Task\u003CCommandResult?\u003E ClickDomNodeAsync(DomNode? domNode, BrowserClient? client = null, CancellationToken cancellationToken = default)        {            var target = client ?? ActiveClient;            if (domNode == null || string.IsNullOrEmpty(domNode.Path) || target == null)                return null;            Log(\u0022SYS\u0022, $\u0022Testing click on {domNode.Path}\u0022, AutomationLogLevel.System);            try            {                var res = await target.ClickReactElementAsync(domNode, cancellationToken);                Log(\u0022RX\u0022, res.Output ?? string.Empty, AutomationLogLevel.CommandRx);                return res;            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, ex.Message, AutomationLogLevel.Error);                return null;            }        }        /// \u003Csummary\u003E        /// Tests setting an input \u003Cparamref name=\u0022value\u0022/\u003E on \u003Cparamref name=\u0022domNode\u0022/\u003E on the specified or active \u003Csee cref=\u0022BrowserClient\u0022/\u003E.        /// \u003C/summary\u003E        public async Task\u003CCommandResult?\u003E SetDomNodeValueAsync(DomNode? domNode, string? value, BrowserClient? client = null, CancellationToken cancellationToken = default)        {            var target = client ?? ActiveClient;            if (domNode == null || string.IsNullOrEmpty(domNode.Path) || target == null || string.IsNullOrEmpty(value))                return null;            Log(\u0022SYS\u0022, $\u0022Testing set value on {domNode.Path}\u0022, AutomationLogLevel.System);            try            {                var res = await target.SetReactInputValueAsync(domNode, value, cancellationToken: cancellationToken);                Log(\u0022RX\u0022, res.Output ?? string.Empty, AutomationLogLevel.CommandRx);                return res;            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, ex.Message, AutomationLogLevel.Error);                return null;            }        }        /// \u003Csummary\u003E        /// Tests extracting text/value from \u003Cparamref name=\u0022domNode\u0022/\u003E on the specified or active \u003Csee cref=\u0022BrowserClient\u0022/\u003E.        /// \u003C/summary\u003E        public async Task\u003Cstring?\u003E QuickScrapeDomNodeAsync(DomNode? domNode, BrowserClient? client = null, CancellationToken cancellationToken = default)        {            var target = client ?? ActiveClient;            if (domNode == null || string.IsNullOrEmpty(domNode.Path) || target == null)                return null;            var extType = domNode.GetSuggestedExtractionType();            Log(\u0022SCRAPE\u0022, $\u0022Testing extraction ({extType}) on {domNode.Path}...\u0022, AutomationLogLevel.ScrapeStart);            try            {                string? val = await target.ScrapeElementAsync(domNode, extType, cancellationToken: cancellationToken);                Log(\u0022SCRAPE-RX\u0022, $\u0022Extracted Value: {val}\u0022, AutomationLogLevel.CommandRx);                return val;            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Quick scrape failed: {ex.Message}\u0022, AutomationLogLevel.Error);                return null;            }        }        /// \u003Csummary\u003E        /// Creates an \u003Csee cref=\u0022AutomationStep\u0022/\u003E from \u003Cparamref name=\u0022domNode\u0022/\u003E and appends it to \u003Cparamref name=\u0022sequence\u0022/\u003E.        /// \u003C/summary\u003E        public AutomationStep? AddStepFromDomNode(AutomationSequence? sequence, DomNode? domNode, AutomationActionType actionType)        {            if (sequence == null || domNode == null || string.IsNullOrEmpty(domNode.Path))                return null;            var step = sequence.AddStepFromDomNode(domNode, actionType);            Log(\u0022SYS\u0022, $\u0022Added step to list \u0027{sequence.Name}\u0027\u0022, AutomationLogLevel.System);            return step;        }        /// \u003Csummary\u003E        /// Creates a \u003Csee cref=\u0022ScrapeField\u0022/\u003E from \u003Cparamref name=\u0022domNode\u0022/\u003E and adds it to \u003Cparamref name=\u0022scrape\u0022/\u003E.        /// \u003C/summary\u003E        public ScrapeField? AddFieldFromDomNode(ScrapeDefinition? scrape, DomNode? domNode, bool matchAllElements, DomNode? fallbackDomRoot = null)        {            if (scrape == null || domNode == null || string.IsNullOrEmpty(domNode.Path))                return null;            var field = scrape.AddFieldFromDomNode(domNode, matchAllElements, ResolveDomRoot(fallbackDomRoot));            Log(\u0022SCRAPE\u0022, $\u0022Added field \u0027{field.Name}\u0027 ({field.ExtractionType}) to \u0027{scrape.Name}\u0027.\u0022, AutomationLogLevel.ScrapeStart);            return field;        }        /// \u003Csummary\u003E        /// Sets the repeating container selector on \u003Cparamref name=\u0022scrape\u0022/\u003E from \u003Cparamref name=\u0022domNode\u0022/\u003E.        /// \u003C/summary\u003E        public string? SetContainerFromDomNode(ScrapeDefinition? scrape, DomNode? domNode, DomNode? fallbackDomRoot = null)        {            if (scrape == null || domNode == null || string.IsNullOrEmpty(domNode.Path))                return null;            string generalizedContainer = scrape.SetContainerFromDomNode(domNode, ResolveDomRoot(fallbackDomRoot));            Log(\u0022SCRAPE\u0022, $\u0022Set repeating container for \u0027{scrape.Name}\u0027 to: {generalizedContainer}\u0022, AutomationLogLevel.ScrapeStart);            return generalizedContainer;        }        /// \u003Csummary\u003E        /// Configures pagination Next button on \u003Cparamref name=\u0022scrape\u0022/\u003E from \u003Cparamref name=\u0022domNode\u0022/\u003E.        /// \u003C/summary\u003E        public string? SetPaginationNextFromDomNode(ScrapeDefinition? scrape, DomNode? domNode, DomNode? fallbackDomRoot = null)        {            if (scrape == null || domNode == null || string.IsNullOrEmpty(domNode.Path))                return null;            string selector = scrape.SetPaginationNextFromDomNode(domNode, ResolveDomRoot(fallbackDomRoot));            Log(\u0022SCRAPE\u0022, $\u0022Set pagination Next button for \u0027{scrape.Name}\u0027 to: {selector}\u0022, AutomationLogLevel.ScrapeStart);            return selector;        }        /// \u003Csummary\u003E        /// Generalizes a container CSS selector using the active client\u0027s DOM root (or \u003Cparamref name=\u0022fallbackDomRoot\u0022/\u003E).        /// \u003C/summary\u003E        public string GeneralizeContainerSelector(string rawSelector, ScrapeDefinition? scrape = null, DomNode? fallbackDomRoot = null)        {            return ActiveClient.GeneralizeContainerSelector(rawSelector, scrape, fallbackDomRoot);        }        /// \u003Csummary\u003E        /// Highlights all elements matching a container selector on the specified or active \u003Csee cref=\u0022BrowserClient\u0022/\u003E.        /// \u003C/summary\u003E        public async Task\u003Cint\u003E HighlightContainerAsync(string rawSelector, ScrapeDefinition? scrape = null, BrowserClient? client = null, CancellationToken cancellationToken = default)        {            var target = RequireClient(client);            if (target == null) return 0;            string selector = rawSelector?.Trim() ?? string.Empty;            if (string.IsNullOrWhiteSpace(selector))            {                Log(\u0022WARN\u0022, \u0022Container selector is empty.\u0022, AutomationLogLevel.Warning);                return 0;            }            try            {                int count = await target.HighlightContainerOrSelectorAsync(selector, scrape, cancellationToken);                Log(\u0022SCRAPE\u0022, $\u0022Highlighted {count} container element(s) matching \u0027{selector}\u0027.\u0022, AutomationLogLevel.ScrapeStart);                return count;            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Failed to highlight container: {ex.Message}\u0022, AutomationLogLevel.Error);                return 0;            }        }        /// \u003Csummary\u003E        /// Highlights all elements matching \u003Cparamref name=\u0022field\u0022/\u003E on the specified or active \u003Csee cref=\u0022BrowserClient\u0022/\u003E.        /// \u003C/summary\u003E        public async Task\u003Cint\u003E HighlightScrapeFieldAsync(ScrapeField? field, ScrapeDefinition? parentScrape = null, BrowserClient? client = null, CancellationToken cancellationToken = default)        {            var target = RequireClient(client);            if (target == null) return 0;            if (field == null || string.IsNullOrWhiteSpace(field.Selector))            {                Log(\u0022WARN\u0022, \u0022Please select a field with a valid selector first.\u0022, AutomationLogLevel.Warning);                return 0;            }            try            {                int count = await target.HighlightScrapeFieldAsync(field, parentScrape, cancellationToken);                Log(\u0022SCRAPE\u0022, $\u0022Highlighted {count} element(s) for field \u0027{field.Name}\u0027.\u0022, AutomationLogLevel.ScrapeStart);                return count;            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Highlight failed: {ex.Message}\u0022, AutomationLogLevel.Error);                return 0;            }        }        /// \u003Csummary\u003E        /// Executes all active \u003Csee cref=\u0022AutomationSequence\u0022/\u003E items in \u003Csee cref=\u0022Project\u0022/\u003E on the specified or active \u003Csee cref=\u0022BrowserClient\u0022/\u003E.        /// \u003C/summary\u003E        public async Task\u003Cbool\u003E RunActiveSequencesAsync(BrowserClient? client = null, CancellationToken cancellationToken = default)        {            var target = RequireClient(client, \u0022Please select a client first.\u0022);            if (target == null) return false;            if (!Project.HasActiveSequences)            {                Log(\u0022WARN\u0022, \u0022No active automation lists selected to run.\u0022, AutomationLogLevel.Warning);                return false;            }            Log(\u0022SYS\u0022, \u0022Starting Automation Run...\u0022, AutomationLogLevel.Automation);            try            {                await target.ExecuteProjectAsync(Project, Runner, cancellationToken);                Log(\u0022SYS\u0022, \u0022Automation Run Completed.\u0022, AutomationLogLevel.Success);                return true;            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Automation aborted: {ex.Message}\u0022, AutomationLogLevel.Error);                return false;            }        }        /// \u003Csummary\u003E        /// Previews a single \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E on the specified or active \u003Csee cref=\u0022BrowserClient\u0022/\u003E.        /// \u003C/summary\u003E        public async Task\u003CScrapeResult?\u003E PreviewScrapeAsync(ScrapeDefinition? scrape, BrowserClient? client = null, CancellationToken cancellationToken = default)        {            var target = RequireClient(client);            if (target == null) return null;            if (scrape == null)            {                Log(\u0022WARN\u0022, \u0022Please select a scrape list to preview.\u0022, AutomationLogLevel.Warning);                return null;            }            if (!scrape.HasFields)            {                Log(\u0022WARN\u0022, \u0022The selected scrape list has no fields defined.\u0022, AutomationLogLevel.Warning);                return null;            }            try            {                var result = await target.ExecuteScrapeAsync(scrape, Project.Sequences, Scraper, cancellationToken);                SetLastScrapeResult(result);                return result;            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Scrape preview failed: {ex.Message}\u0022, AutomationLogLevel.Error);                return null;            }        }        /// \u003Csummary\u003E        /// Executes all active \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E items in \u003Csee cref=\u0022Project\u0022/\u003E and combines their results.        /// \u003C/summary\u003E        public async Task\u003CScrapeResult?\u003E RunActiveScrapesAsync(BrowserClient? client = null, CancellationToken cancellationToken = default)        {            var target = RequireClient(client);            if (target == null) return null;            if (!Project.HasActiveScrapes)            {                Log(\u0022WARN\u0022, \u0022No active scrape lists selected to run.\u0022, AutomationLogLevel.Warning);                return null;            }            try            {                var combined = await target.ExecuteProjectScrapesCombinedAsync(Project, Scraper, cancellationToken: cancellationToken);                SetLastScrapeResult(combined);                return combined;            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Active scrapes run aborted: {ex.Message}\u0022, AutomationLogLevel.Error);                return null;            }        }        /// \u003Csummary\u003E        /// Returns the JSON string for \u003Csee cref=\u0022LastScrapeResult\u0022/\u003E if it contains records, or logs a warning and returns \u003Cc\u003Enull\u003C/c\u003E.        /// \u003C/summary\u003E        public string? GetLastScrapeJsonForCopy()        {            if (LastScrapeResult == null || !LastScrapeResult.HasRecords)            {                Log(\u0022WARN\u0022, \u0022No scrape results available to copy.\u0022, AutomationLogLevel.Warning);                return null;            }            string json = LastScrapeResult.ToJson(true, true);            Log(\u0022SCRAPE\u0022, \u0022Copied scraped JSON records to clipboard.\u0022, AutomationLogLevel.Success);            return json;        }        /// \u003Csummary\u003E        /// Validates that \u003Csee cref=\u0022LastScrapeResult\u0022/\u003E contains records for file export.        /// \u003C/summary\u003E        public bool EnsureHasScrapeResultForExport()        {            if (LastScrapeResult == null || !LastScrapeResult.HasRecords)            {                Log(\u0022WARN\u0022, \u0022No scrape results available to export.\u0022, AutomationLogLevel.Warning);                return false;            }            return true;        }        /// \u003Csummary\u003E        /// Exports \u003Csee cref=\u0022LastScrapeResult\u0022/\u003E as JSON to \u003Cparamref name=\u0022filePath\u0022/\u003E.        /// \u003C/summary\u003E        public void ExportLastScrapeToJsonFile(string filePath)        {            if (LastScrapeResult == null) return;            try            {                LastScrapeResult.SaveToJsonFile(filePath, recordsOnly: true);                Log(\u0022SCRAPE\u0022, $\u0022Exported {LastScrapeResult.RecordCount} record(s) to {filePath}\u0022, AutomationLogLevel.Success);            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Failed to export JSON: {ex.Message}\u0022, AutomationLogLevel.Error);            }        }        /// \u003Csummary\u003E        /// Exports \u003Csee cref=\u0022LastScrapeResult\u0022/\u003E as CSV to \u003Cparamref name=\u0022filePath\u0022/\u003E.        /// \u003C/summary\u003E        public void ExportLastScrapeToCsvFile(string filePath)        {            if (LastScrapeResult == null) return;            try            {                LastScrapeResult.SaveToCsvFile(filePath);                Log(\u0022SCRAPE\u0022, $\u0022Exported {LastScrapeResult.RecordCount} record(s) to {filePath}\u0022, AutomationLogLevel.Success);            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Failed to export CSV: {ex.Message}\u0022, AutomationLogLevel.Error);            }        }        /// \u003Csummary\u003E        /// Executes a reverse-engineering site dump of \u003Cparamref name=\u0022dumpType\u0022/\u003E on the specified or active \u003Csee cref=\u0022BrowserClient\u0022/\u003E.        /// \u003C/summary\u003E        public async Task\u003CSiteDumpResult?\u003E ExecuteSiteDumpAsync(            SiteDumpType dumpType,            SiteDumpOptions options,            BrowserClient? client = null,            CancellationToken cancellationToken = default)        {            var target = RequireClient(client);            if (target == null) return null;            OnDumpStatusChanged?.Invoke(this, $\u0022Dumping {dumpType} from {target.InstanceId}...\u0022);            try            {                var result = await target.DumpSiteAsync(dumpType, options, SiteDumper, cancellationToken);                SetLastSiteDumpResult(result);                return result;            }            catch (Exception ex)            {                OnDumpStatusChanged?.Invoke(this, $\u0022Dump failed: {ex.Message}\u0022);                Log(\u0022ERR\u0022, $\u0022Site dump ({dumpType}) failed: {ex.Message}\u0022, AutomationLogLevel.Error);                return null;            }        }        /// \u003Csummary\u003E        /// Resolves the text content and suggested file name for the active dump view.        /// \u003C/summary\u003E        public string GetActiveDumpViewText(SiteDumpViewMode viewMode, SiteResourceItem? selectedResource, out string suggestedFileName)        {            suggestedFileName = \u0022dump.txt\u0022;            if (LastSiteDumpResult == null)                return string.Empty;            return LastSiteDumpResult.GetViewContent(viewMode, selectedResource, out suggestedFileName);        }        /// \u003Csummary\u003E        /// Saves the active dump view to \u003Cparamref name=\u0022filePath\u0022/\u003E.        /// \u003C/summary\u003E        public void SaveActiveDumpViewToFile(string filePath, SiteDumpViewMode viewMode, SiteResourceItem? selectedResource, string displayFileName)        {            if (LastSiteDumpResult == null) return;            try            {                LastSiteDumpResult.SaveViewContentToFile(filePath, viewMode, selectedResource);                Log(\u0022REV-ENG\u0022, $\u0022Saved \u0027{displayFileName}\u0027 to {filePath}\u0022, AutomationLogLevel.Success);            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Failed to save file: {ex.Message}\u0022, AutomationLogLevel.Error);            }        }        /// \u003Csummary\u003E        /// Saves all resources in \u003Csee cref=\u0022LastSiteDumpResult\u0022/\u003E to \u003Cparamref name=\u0022folderPath\u0022/\u003E.        /// \u003C/summary\u003E        public void SaveLastDumpToFolder(string folderPath)        {            if (LastSiteDumpResult == null) return;            try            {                string savedPath = LastSiteDumpResult.SaveToDirectory(folderPath);                Log(\u0022REV-ENG\u0022, $\u0022Saved {LastSiteDumpResult.TotalResourceCount} resource(s) ({LastSiteDumpResult.GetFormattedTotalSize()}) to {savedPath}\u0022, AutomationLogLevel.Success);            }            catch (Exception ex)            {                Log(\u0022ERR\u0022, $\u0022Failed to save dump to folder: {ex.Message}\u0022, AutomationLogLevel.Error);            }        }        /// \u003Csummary\u003E        /// Disposes the underlying \u003Csee cref=\u0022AutomationServer\u0022/\u003E if created.        /// \u003C/summary\u003E        public void Dispose()        {            if (_disposed) return;            _disposed = true;            _server?.Dispose();            GC.SuppressFinalize(this);        }    }}\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\Controls\\DomTreeView.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH        private Rectangle GetViewportBounds()        {            int inset = BorderInset;            int w = Math.Max(0, ClientSize.Width - (inset * 2) 