InstanceId { get; }\n\n        /// \u003Csummary\u003E\n        /// Gets the active IPC transport mode (\u003Csee cref=\u0022IpcMode.WebSocket\u0022/\u003E or \u003Csee cref=\u0022IpcMode.HttpPolling\u0022/\u003E) used by this client.\n        /// \u003C/summary\u003E\n        public IpcMode Mode { get; private set; }\n\n        /// \u003Csummary\u003E\n        /// Gets the UTC timestamp when the server last received a message or poll from this client.\n        /// \u003C/summary\u003E\n        public DateTime LastSeen { get; internal set; } = DateTime.UtcNow;\n\n        /// \u003Csummary\u003E\n        /// Gets the current URL loaded in the browser tab, if known.\n        /// \u003C/summary\u003E\n        public string? CurrentUrl { get; internal set; }\n\n        /// \u003Csummary\u003E\n        /// Gets the current document title of the browser tab, if known.\n        /// \u003C/summary\u003E\n        public string? PageTitle { get; internal set; }\n\n        /// \u003Csummary\u003E\n        /// Gets the unique correlation ID generated by the browser script for the current page load.\n        /// \u003C/summary\u003E\n        public string? CurrentPageLoadId { get; private set; }\n\n        /// \u003Csummary\u003E\n        /// Gets the most recent HTTP status code reported by the browser tab (e.g., 200 or 429).\n        /// \u003C/summary\u003E\n        public int LastStatusCode { get; private set; } = 200;\n\n        /// \u003Csummary\u003E\n        /// Gets the most recent \u003Cc\u003ERetry-After\u003C/c\u003E header value reported when \u003Csee cref=\u0022LastStatusCode\u0022/\u003E is 429.\n        /// \u003C/summary\u003E\n        public string? LastRetryAfter { get; private set; }\n\n        /// \u003Csummary\u003E\n        /// Gets the Chrome tab ID if this client was injected by the BAF Chrome Extension.\n        /// \u003C/summary\u003E\n        public int? TabId { get; internal set; }\n\n        /// \u003Csummary\u003E\n        /// Gets whether this client was injected by the BAF Chrome Extension rather than a Tampermonkey userscript.\n        /// \u003C/summary\u003E\n        public bool IsExtensionClient =\u003E TabId.HasValue || InstanceId.StartsWith(\u0022tab_\u0022, StringComparison.OrdinalIgnoreCase);\n\n        /// \u003Csummary\u003E\n        /// Gets a human-readable display string combining the client source (\u003Cc\u003E[Ext]\u003C/c\u003E or \u003Cc\u003E[TM]\u003C/c\u003E), \u003Csee cref=\u0022InstanceId\u0022/\u003E, and page title or host.\n        /// \u003C/summary\u003E\n        public string DisplayName\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        public BrowserClient(string instanceId, IpcMode mode, WebSocket? webSocket = null)\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Initializes a new instance of the \u003Csee cref=\u0022BrowserClient\u0022/\u003E class.\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022instanceId\u0022\u003EThe unique client instance identifier.\u003C/param\u003E\n        /// \u003Cparam name=\u0022mode\u0022\u003EThe initial IPC transport mode.\u003C/param\u003E\n        /// \u003Cparam name=\u0022webSocket\u0022\u003EAn optional active WebSocket connection when \u003Cparamref name=\u0022mode\u0022/\u003E is \u003Csee cref=\u0022IpcMode.WebSocket\u0022/\u003E.\u003C/param\u003E\n        public BrowserClient(string instanceId, IpcMode mode, WebSocket? webSocket = null)\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        public override string ToString() =\u003E DisplayName;\n==== REPLACE\n        /// \u003Csummary\u003E\n        /// Returns \u003Csee cref=\u0022DisplayName\u0022/\u003E.\n        /// \u003C/summary\u003E\n        public override string ToString() =\u003E DisplayName;\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnAddStep_Click(object? sender, EventArgs e)\n        {\n            if (chkLstSequences.SelectedItem is AutomationSequence seq)\n            {\n                var step = new AutomationStep();\n                seq.Steps.Add(step);\n                lstSteps.Items.Add(step);\n                lstSteps.SelectedItem = step;\n            }\n            else\n            {\n                Log(\u0022[WARN] Please select an automation list first.\u0022, Color.Orange);\n            }\n        }\n==== REPLACE\n        private void BtnAddStep_Click(object? sender, EventArgs e)\n        {\n            if (chkLstSequences.SelectedItem is AutomationSequence seq)\n            {\n                var step = seq.AddStep();\n                lstSteps.Items.Add(step);\n                lstSteps.SelectedItem = step;\n            }\n            else\n            {\n                Log(\u0022[WARN] Please select an automation list first.\u0022, Color.Orange);\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private async void BtnRunAutomation_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a client first.\u0022, Color.Orange);\n                return;\n            }\n\n            var activeSequences = chkLstSequences.Items.Cast\u003CAutomationSequence\u003E()\n                .Where((seq, idx) =\u003E chkLstSequences.GetItemChecked(idx))\n                .ToList();\n\n            if (activeSequences.Count == 0)\n            {\n                Log(\u0022[WARN] No active automation lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n\n            Log(\u0022[SYS] Starting Automation Run...\u0022, Color.Magenta);\n            btnRunAutomation.Enabled = false;\n\n            try\n            {\n                _runner.SetScrapeDefinitions(chkLstScrapes.Items.Cast\u003CScrapeDefinition\u003E());\n                await _runner.RunSequencesAsync(client, activeSequences);\n                Log(\u0022[SYS] Automation Run Completed.\u0022, Color.Lime);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Automation aborted: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnRunAutomation.Enabled = true;\n            }\n        }\n==== REPLACE\n        private async void BtnRunAutomation_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a client first.\u0022, Color.Orange);\n                return;\n            }\n\n            var project = BuildCurrentProjectFromUi();\n            if (project.GetActiveSequences().Count == 0)\n            {\n                Log(\u0022[WARN] No active automation lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n\n            Log(\u0022[SYS] Starting Automation Run...\u0022, Color.Magenta);\n            btnRunAutomation.Enabled = false;\n\n            try\n            {\n                await client.ExecuteProjectAsync(project, _runner);\n                Log(\u0022[SYS] Automation Run Completed.\u0022, Color.Lime);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Automation aborted: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnRunAutomation.Enabled = true;\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnAddScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape)\n            {\n                Log(\u0022[WARN] Please select or create a scrape list first.\u0022, Color.Orange);\n                return;\n            }\n\n            var field = new ScrapeField\n            {\n                Name = scrape.GetUniqueFieldName(\u0022Field\u0022)\n            };\n            scrape.Fields.Add(field);\n            lstScrapeFields.Items.Add(field);\n            lstScrapeFields.SelectedItem = field;\n        }\n==== REPLACE\n        private void BtnAddScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape)\n            {\n                Log(\u0022[WARN] Please select or create a scrape list first.\u0022, Color.Orange);\n                return;\n            }\n\n            var field = scrape.AddField(\u0022Field\u0022);\n            lstScrapeFields.Items.Add(field);\n            lstScrapeFields.SelectedItem = field;\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            btnPreviewScrape.Enabled = false;\n            try\n            {\n                var sequences = chkLstSequences.Items.Cast\u003CAutomationSequence\u003E().ToList();\n                var result = await _scraper.RunScrapeAsync(client, scrape, sequences);\n                DisplayScrapeResult(result);\n            }\n==== REPLACE\n            btnPreviewScrape.Enabled = false;\n            try\n            {\n                var sequences = chkLstSequences.Items.Cast\u003CAutomationSequence\u003E().ToList();\n                var result = await client.ExecuteScrapeAsync(scrape, sequences, _scraper);\n                DisplayScrapeResult(result);\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            var project = BuildCurrentProjectFromUi();\n            if (!project.Scrapes.Any(s =\u003E s.IsActive))\n            {\n                Log(\u0022[WARN] No active scrape lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n\n            btnRunAllScrapes.Enabled = false;\n            try\n            {\n                var combined = await _scraper.RunProjectScrapesCombinedAsync(client, project);\n                DisplayScrapeResult(combined);\n            }\n==== REPLACE\n            var project = BuildCurrentProjectFromUi();\n            if (project.GetActiveScrapes().Count == 0)\n            {\n                Log(\u0022[WARN] No active scrape lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n\n            btnRunAllScrapes.Enabled = false;\n            try\n            {\n                var combined = await client.ExecuteProjectScrapesCombinedAsync(project, _scraper);\n                DisplayScrapeResult(combined);\n            }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private SiteDumpOptions BuildSiteDumpOptionsFromUi()\n        {\n            return new SiteDumpOptions\n            {\n                IncludeExternalCss = chkDumpExternal.Checked,\n                IncludeExternalScripts = chkDumpExternal.Checked,\n                IncludeInlineCss = chkDumpInline.Checked,\n                IncludeConstructedCss = chkDumpInline.Checked,\n                IncludeInlineScripts = chkDumpInline.Checked,\n                IncludePerformanceResourceScripts = chkDumpDynamicJs.Checked\n            };\n        }\n==== REPLACE\n        private SiteDumpOptions BuildSiteDumpOptionsFromUi()\n        {\n            return SiteDumpOptions.Create(\n                includeExternal: chkDumpExternal.Checked,\n                includeInline: chkDumpInline.Checked,\n                includeDynamicScripts: chkDumpDynamicJs.Checked);\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private string GetActiveDumpViewerText(out string suggestedFileName)\n        {\n            suggestedFileName = \u0022dump.txt\u0022;\n            if (_lastSiteDumpResult == null)\n                return string.Empty;\n\n            if (tabDumpViewers.SelectedTab == tabSelectedResourceView \u0026\u0026 lstDumpedResources.SelectedItem is SiteResourceItem selectedRes)\n            {\n                suggestedFileName = string.IsNullOrWhiteSpace(selectedRes.Name) ? \u0022resource.txt\u0022 : selectedRes.Name;\n                return selectedRes.Content;\n            }\n\n            var viewType = GetSelectedCombinedViewerDumpType();\n            suggestedFileName = SiteDumpResult.GetSuggestedCombinedFileName(viewType);\n            return _lastSiteDumpResult.GetCombinedContent(viewType);\n        }\n==== REPLACE\n        private string GetActiveDumpViewerText(out string suggestedFileName)\n        {\n            suggestedFileName = \u0022dump.txt\u0022;\n            if (_lastSiteDumpResult == null)\n                return string.Empty;\n\n            var selectedRes = tabDumpViewers.SelectedTab == tabSelectedResourceView\n                ? lstDumpedResources.SelectedItem as SiteResourceItem\n                : null;\n\n            return _lastSiteDumpResult.GetViewContent(GetSelectedCombinedViewerDumpType(), selectedRes, out suggestedFileName);\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\Controls\\DomTreeView.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n            if (expandedKeys != null \u0026\u0026 expandedKeys.Count \u003E 0)\n            {\n                _expandedKeys.Clear();\n                foreach (var k in expandedKeys)\n                {\n                    if (snapshot.ItemsByKey.ContainsKey(k))\n                        _expandedKeys.Add(k);\n                }\n            }\n\n            if (_expandedKeys.Count == 0)\n            {\n                _expandedKeys.Add(snapshot.RootItem.UniqueKey);\n                if (snapshot.ItemsByKey.ContainsKey(\u0022body\u0022))\n                    _expandedKeys.Add(\u0022body\u0022);\n            }\n\n            DomTreeItem? resolvedSelected = null;\n            if (!string.IsNullOrEmpty(selectedPath) \u0026\u0026 snapshot.ItemsByKey.TryGetValue(selectedPath, out var foundTarget))\n            {\n                resolvedSelected = foundTarget;\n                snapshot.ExpandAncestors(foundTarget, _expandedKeys);\n            }\n\n            _selectedItem = resolvedSelected;\n==== REPLACE\n            var resolvedSelected = snapshot.PrepareExpandedState(_expandedKeys, expandedKeys, selectedPath);\n            _selectedItem = resolvedSelected;\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
