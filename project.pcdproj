u003C\u003C\u003C\u003C SEARCH\n            // \n            // lstSteps\n            // \n            lstSteps.BackColor = Color.FromArgb(30, 30, 30);\n            lstSteps.BorderStyle = BorderStyle.FixedSingle;\n            lstSteps.Dock = DockStyle.Fill;\n            lstSteps.ForeColor = Color.LightGray;\n            lstSteps.Location = new Point(0, 0);\n            lstSteps.Name = \u0022lstSteps\u0022;\n            lstSteps.Size = new Size(217, 386);\n            lstSteps.TabIndex = 0;\n            lstSteps.SelectedIndexChanged \u002B= LstSteps_SelectedIndexChanged;\n==== REPLACE\n            // \n            // lstSteps\n            // \n            lstSteps.BackColor = Color.FromArgb(30, 30, 30);\n            lstSteps.BorderStyle = BorderStyle.FixedSingle;\n            lstSteps.Dock = DockStyle.Fill;\n            lstSteps.ForeColor = Color.LightGray;\n            lstSteps.IntegralHeight = false;\n            lstSteps.Location = new Point(0, 0);\n            lstSteps.Name = \u0022lstSteps\u0022;\n            lstSteps.Size = new Size(217, 386);\n            lstSteps.TabIndex = 0;\n            lstSteps.SelectedIndexChanged \u002B= LstSteps_SelectedIndexChanged;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            // \n            // rtbLogs\n            // \n            rtbLogs.BackColor = Color.FromArgb(30, 30, 30);\n            rtbLogs.BorderStyle = BorderStyle.FixedSingle;\n            rtbLogs.Dock = DockStyle.Fill;\n            rtbLogs.Font = new Font(\u0022Consolas\u0022, 6.666667F);\n            rtbLogs.ForeColor = Color.LightGray;\n            rtbLogs.Location = new Point(10, 28);\n            rtbLogs.Name = \u0022rtbLogs\u0022;\n            rtbLogs.ReadOnly = true;\n            rtbLogs.Size = new Size(1236, 121);\n            rtbLogs.TabIndex = 0;\n            rtbLogs.Text = \u0022\u0022;\n            // \n            // ctxDomNode\n            // \n            ctxDomNode.ImageScalingSize = new Size(24, 24);\n            ctxDomNode.Items.AddRange(new ToolStripItem[] { mnuClickElement, mnuSetValue, mnuAddClickTo, mnuAddSetValueTo });\n            ctxDomNode.Name = \u0022ctxDomNode\u0022;\n            ctxDomNode.Size = new Size(271, 132);\n            ctxDomNode.Opening \u002B= CtxDomNode_Opening;\n==== REPLACE\n            // \n            // rtbLogs\n            // \n            rtbLogs.BackColor = Color.FromArgb(30, 30, 30);\n            rtbLogs.BorderStyle = BorderStyle.FixedSingle;\n            rtbLogs.Dock = DockStyle.Fill;\n            rtbLogs.Font = new Font(\u0022Consolas\u0022, 10F);\n            rtbLogs.ForeColor = Color.LightGray;\n            rtbLogs.Location = new Point(10, 28);\n            rtbLogs.Name = \u0022rtbLogs\u0022;\n            rtbLogs.ReadOnly = true;\n            rtbLogs.Size = new Size(1236, 121);\n            rtbLogs.TabIndex = 0;\n            rtbLogs.Text = \u0022\u0022;\n            // \n            // ctxDomNode\n            // \n            ctxDomNode.Font = new Font(\u0022Segoe UI\u0022, 10F);\n            ctxDomNode.ImageScalingSize = new Size(24, 24);\n            ctxDomNode.Items.AddRange(new ToolStripItem[] { mnuClickElement, mnuSetValue, mnuAddClickTo, mnuAddSetValueTo });\n            ctxDomNode.Name = \u0022ctxDomNode\u0022;\n            ctxDomNode.Size = new Size(271, 132);\n            ctxDomNode.Opening \u002B= CtxDomNode_Opening;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            // \n            // menuStripMain\n            // \n            menuStripMain.ImageScalingSize = new Size(24, 24);\n            menuStripMain.Items.AddRange(new ToolStripItem[] { mnuFile, mnuHelp });\n            menuStripMain.Location = new Point(0, 0);\n            menuStripMain.Name = \u0022menuStripMain\u0022;\n            menuStripMain.Size = new Size(1256, 36);\n            menuStripMain.TabIndex = 2;\n            menuStripMain.Text = \u0022menuStripMain\u0022;\n==== REPLACE\n            // \n            // menuStripMain\n            // \n            menuStripMain.Font = new Font(\u0022Segoe UI\u0022, 10F);\n            menuStripMain.ImageScalingSize = new Size(24, 24);\n            menuStripMain.Items.AddRange(new ToolStripItem[] { mnuFile, mnuHelp });\n            menuStripMain.Location = new Point(0, 0);\n            menuStripMain.Name = \u0022menuStripMain\u0022;\n            menuStripMain.Size = new Size(1256, 36);\n            menuStripMain.TabIndex = 2;\n            menuStripMain.Text = \u0022menuStripMain\u0022;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            // \n            // MainForm\n            // \n            ClientSize = new Size(1256, 817);\n            Controls.Add(splitMain);\n            Controls.Add(pnlTop);\n            Controls.Add(menuStripMain);\n            Font = new Font(\u0022Segoe UI\u0022, 6.666667F);\n            MainMenuStrip = menuStripMain;\n            Name = \u0022MainForm\u0022;\n==== REPLACE\n            // \n            // MainForm\n            // \n            AutoScaleDimensions = new SizeF(96F, 96F);\n            AutoScaleMode = AutoScaleMode.Dpi;\n            ClientSize = new Size(1256, 817);\n            Controls.Add(splitMain);\n            Controls.Add(pnlTop);\n            Controls.Add(menuStripMain);\n            Font = new Font(\u0022Segoe UI\u0022, 10F);\n            MainMenuStrip = menuStripMain;\n            Name = \u0022MainForm\u0022;\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
      "ModelExplanation": "### Changes Made\n\n- **Fixed Tiny Font \u0026 Enabled Per-Monitor DPI Auto-Scaling (\u0060MainForm.Designer.cs\u0060, \u0060Program.cs\u0060)**:\n\n- Replaced the \u00606.666667F\u0060 font size on \u0060MainForm\u0060 and \u0060rtbLogs\u0060 with \u006010F\u0060 (\u0060new Font(\u0022Segoe UI\u0022, 10F)\u0060 for UI controls/menus and \u0060new Font(\u0022Consolas\u0022, 10F)\u0060 for code/details/log views), matching the readable \u006010F\u0060 text size used by \u0060DomTreeView\u0060.\n- Added \u0060AutoScaleDimensions = new SizeF(96F, 96F)\u0060 and \u0060AutoScaleMode = AutoScaleMode.Dpi\u0060 to \u0060MainForm\u0060 so WinForms automatically scales all control dimensions, buttons, panels, and splitters proportionally across 4K @ 150% scaling as well as lower resolutions/scalings.\n- Adjusted base dimensions of the top bar (\u0060pnlTop\u0060, \u0060pnlMatchUrls\u0060), sequence list toolbar (\u0060pnlSequencesTop\u0060), and step editor toolbar (\u0060pnlEditorTop\u0060) so buttons (such as **Move Down**, **Add List**, **Remove List**, etc.) fit comfortably on a single line without wrapping or clipping.\n- **Dynamic DPI-Aware Row Height in DOM Explorer (\u0060DomTreeView.cs\u0060)**:\n\n- Updated \u0060DomTreeView\u0060 to dynamically calculate \u0060ItemHeight\u0060 based on the current DPI and font height (\u0060OnHandleCreated\u0060 and \u0060OnDpiChangedAfterParent\u0060) instead of using a fixed 22px height.\n\n### How to Test\n\n- Build and run \u0060TestBedApp\u0060 on 4K with 150% display scaling.\n- Verify that menus, buttons, labels, client lists, element details, automation sequences/steps, property grid, and real-time logs are all sized to match the readability of the DOM Explorer tree view.\n- Verify that no button text wraps or clips (e.g., **Move Down** in the Automation Editor and **Add/Edit/Remove** in Match URLs).\n- Change display scaling or resolution (e.g., 100% or 125%) and confirm the layout and proportions remain consistent.",
