amework.Models;\nusing BrowserAutomationFramework.Server;\nusing BAFStudio.Utils;\n\nnamespace BAFStudio\n{\n    public partial class MainForm : Form\n    {\n        [DllImport(\u0022user32.dll\u0022, SetLastError = true)]\n        private static extern bool DestroyIcon(IntPtr hIcon);\n\n        private readonly AutomationStudioSession _session = new();\n        private Icon? _studioAppIcon;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        public MainForm(string[]? startupArgs)\n        {\n            InitializeComponent();\n            InitializeExtensionTabsSidebarUi();\n            InitializeScraperTabUi();\n            InitializeReverseEngineeringTabUi();\n            ApplyFixedSingleBorders(this);\n\n            _session.TrySyncDefaultChromeExtensionQuietly((int)numPort.Value, AutomationStudioSession.DefaultIpcMode);\n==== REPLACE\n        public MainForm(string[]? startupArgs)\n        {\n            InitializeComponent();\n            _studioAppIcon = CreateBafStudioAppIcon();\n            if (_studioAppIcon != null)\n            {\n                Icon = _studioAppIcon;\n            }\n            DarkModeTitleBar.Enable(this);\n            InitializeExtensionTabsSidebarUi();\n            InitializeScraperTabUi();\n            InitializeReverseEngineeringTabUi();\n            ApplyFixedSingleBorders(this);\n\n            _session.TrySyncDefaultChromeExtensionQuietly((int)numPort.Value, AutomationStudioSession.DefaultIpcMode);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                case TreeView treeView:\n                    treeView.BorderStyle = BorderStyle.FixedSingle;\n                    break;\n                case TestBedApp.Controls.DomTreeView domTreeView:\n                    domTreeView.BorderStyle = BorderStyle.FixedSingle;\n                    break;\n                case UpDownBase upDownBase:\n==== REPLACE\n                case TreeView treeView:\n                    treeView.BorderStyle = BorderStyle.FixedSingle;\n                    break;\n                case BAFStudio.Controls.DomTreeView domTreeView:\n                    domTreeView.BorderStyle = BorderStyle.FixedSingle;\n                    break;\n                case UpDownBase upDownBase:\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void MnuHelpAbout_Click(object? sender, EventArgs e)\n        {\n            DarkMessageBox.Show(AutomationStudioSession.StudioAboutMessage, \u0022About\u0022, MessageBoxButtons.OK, MessageBoxIcon.Information);\n        }\n==== REPLACE\n        private void MnuHelpAbout_Click(object? sender, EventArgs e)\n        {\n            DarkMessageBox.Show(this, AutomationStudioSession.StudioAboutMessage, $\u0022About {AutomationStudioSession.StudioShortTitle}\u0022, MessageBoxButtons.OK, MessageBoxIcon.Information);\n        }\n\n        protected override void WndProc(ref Message m)\n        {\n            base.WndProc(ref m);\n            DarkModeTitleBar.WndProc(ref m);\n        }\n\n        private static Icon? CreateBafStudioAppIcon()\n        {\n            try\n            {\n                const int size = 256;\n                using var bmp = new Bitmap(size, size);\n                using (var g = Graphics.FromImage(bmp))\n                {\n                    g.SmoothingMode = SmoothingMode.AntiAlias;\n                    g.TextRenderingHint = TextRenderingHint.AntiAliasGridFit;\n\n                    // 1. Squircle background\n                    using (var bgPath = CreateRoundedRectPath(new RectangleF(10, 10, 236, 236), 52f))\n                    using (var bgBrush = new LinearGradientBrush(new PointF(10, 10), new PointF(246, 246), Color.FromArgb(10, 15, 30), Color.FromArgb(23, 17, 46)))\n                    using (var borderPen = new Pen(Color.FromArgb(0, 229, 255), 4f))\n                    {\n                        g.FillPath(bgBrush, bgPath);\n                        g.DrawPath(borderPen, bgPath);\n                    }\n\n                    // 2. Inner browser studio frame\n                    using (var winPath = CreateRoundedRectPath(new RectangleF(32, 36, 192, 150), 14f))\n                    using (var winBrush = new SolidBrush(Color.FromArgb(18, 28, 50)))\n                    using (var winPen = new Pen(Color.FromArgb(56, 189, 248), 2.5f))\n                    {\n                        g.FillPath(winBrush, winPath);\n                        g.DrawPath(winPen, winPath);\n                    }\n\n                    // Window traffic dots\n                    using (var redB = new SolidBrush(Color.FromArgb(255, 95, 86)))\n                    using (var yelB = new SolidBrush(Color.FromArgb(255, 189, 46)))\n                    using (var grnB = new SolidBrush(Color.FromArgb(39, 201, 63)))\n                    {\n                        g.FillEllipse(redB, 45, 47, 8, 8);\n                        g.FillEllipse(yelB, 57, 47, 8, 8);\n                        g.FillEllipse(grnB, 69, 47, 8, 8);\n                    }\n\n                    // DOM nodes on left\n                    using (var treePen = new Pen(Color.FromArgb(0, 245, 212), 3f))\n                    using (var nodeBrush = new SolidBrush(Color.FromArgb(0, 245, 212)))\n                    {\n                        g.DrawLine(treePen, 52, 80, 52, 156);\n                        g.DrawLine(treePen, 52, 104, 72, 104);\n                        g.DrawLine(treePen, 52, 130, 72, 130);\n                        g.DrawLine(treePen, 52, 156, 72, 156);\n                        g.FillEllipse(nodeBrush, 47, 75, 10, 10);\n                        g.FillRectangle(nodeBrush, 74, 99, 36, 10);\n                        g.FillRectangle(nodeBrush, 74, 125, 42, 10);\n                        g.FillRectangle(nodeBrush, 74, 151, 30, 10);\n                    }\n\n                    // Lightning bolt core on right\n                    PointF[] bolt =\n                    {\n                        new(175f, 88f),\n                        new(150f, 124f),\n                        new(170f, 124f),\n                        new(162f, 156f),\n                        new(190f, 118f),\n                        new(170f, 118f)\n                    };\n                    using (var boltBrush = new LinearGradientBrush(new PointF(150, 88), new PointF(190, 156), Color.FromArgb(0, 245, 212), Color.FromArgb(139, 92, 246)))\n                    {\n                        g.FillPolygon(boltBrush, bolt);\n                    }\n\n                    // Bottom \u0022BAF\u0022 badge\n                    using (var badgePath = CreateRoundedRectPath(new RectangleF(54, 174, 148, 52), 14f))\n                    using (var badgeBrush = new SolidBrush(Color.FromArgb(14, 23, 42)))\n                    using (var badgePen = new Pen(Color.FromArgb(0, 245, 212), 2.5f))\n                    {\n                        g.FillPath(badgeBrush, badgePath);\n                        g.DrawPath(badgePen, badgePath);\n                    }\n\n                    using (var font = new Font(\u0022Segoe UI\u0022, 22f, FontStyle.Bold, GraphicsUnit.Pixel))\n                    using (var textBrush = new SolidBrush(Color.White))\n                    {\n                        var sf = new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center };\n                        g.DrawString(\u0022BAF\u0022, font, textBrush, new RectangleF(54, 174, 148, 52), sf);\n                    }\n                }\n\n                IntPtr hIcon = bmp.GetHicon();\n                try\n                {\n                    using var tempIcon = Icon.FromHandle(hIcon);\n                    return (Icon)tempIcon.Clone();\n                }\n                finally\n                {\n                    DestroyIcon(hIcon);\n                }\n            }\n            catch\n            {\n                return null;\n            }\n        }\n\n        private static GraphicsPath CreateRoundedRectPath(RectangleF rect, float radius)\n        {\n            float d = radius * 2f;\n            var path = new GraphicsPath();\n            path.AddArc(rect.X, rect.Y, d, d, 180, 90);\n            path.AddArc(rect.Right - d, rect.Y, d, d, 270, 90);\n            path.AddArc(rect.Right - d, rect.Bottom - d, d, d, 0, 90);\n            path.AddArc(rect.X, rect.Bottom - d, d, d, 90, 90);\n            path.CloseFigure();\n            return path;\n        }\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.Designer.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nusing BrowserAutomationFramework.Automation;\nusing BrowserAutomationFramework.Models;\n\nnamespace TestBedApp\n{\n    partial class MainForm\n    {\n        /// \u003Csummary\u003E\n        /// Required designer variable.\n        /// \u003C/summary\u003E\n        private System.ComponentModel.IContainer components = null;\n\n        /// \u003Csummary\u003E\n        /// Clean up any resources being used.\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022disposing\u0022\u003Etrue if managed resources should be disposed; otherwise, false.\u003C/param\u003E\n        protected override void Dispose(bool disposing)\n        {\n            if (disposing \u0026\u0026 (components != null))\n            {\n                components.Dispose();\n            }\n            base.Dispose(disposing);\n        }\n==== REPLACE\nusing BrowserAutomationFramework.Automation;\nusing BrowserAutomationFramework.Models;\n\nnamespace BAFStudio\n{\n    partial class MainForm\n    {\n        /// \u003Csummary\u003E\n        /// Required designer variable.\n        /// \u003C/summary\u003E\n        private System.ComponentModel.IContainer components = null;\n\n        /// \u003Csummary\u003E\n        /// Clean up any resources being used.\n        /// \u003C/summary\u003E\n        /// \u003Cparam name=\u0022disposing\u0022\u003Etrue if managed resources should be disposed; otherwise, false.\u003C/param\u003E\n        protected override void Dispose(bool disposing)\n        {\n            if (disposing)\n            {\n                _session?.Dispose();\n                _studioAppIcon?.Dispose();\n                if (components != null)\n                {\n                    components.Dispose();\n                }\n            }\n            base.Dispose(disposing);\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            tabDom = new TabPage();\n            splitDom = new SplitContainer();\n            tvDom = new TestBedApp.Controls.DomTreeView();\n            txtElementDetails = new TextBox();\n==== REPLACE\n            tabDom = new TabPage();\n            splitDom = new SplitContainer();\n            tvDom = new BAFStudio.Controls.DomTreeView();\n            txtElementDetails = new TextBox();\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private System.Windows.Forms.SplitContainer splitDom;\n        private TestBedApp.Controls.DomTreeView tvDom;\n        private System.Windows.Forms.TextBox txtElementDetails;\n==== REPLACE\n        private System.Windows.Forms.SplitContainer splitDom;\n        private BAFStudio.Controls.DomTreeView tvDom;\n        private System.Windows.Forms.TextBox txtElementDetails;\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\Controls\\DomTreeView.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nusing BrowserAutomationFramework.Models;\nusing TestBedApp.Utils;\n\nnamespace TestBedApp.Controls\n{\n==== REPLACE\nusing BrowserAutomationFramework.Models;\nusing BAFStudio.Utils;\n\nnamespace BAFStudio.Controls\n{\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\utils\\DarkMessageBox.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nusing BrowserAutomationFramework.Models;\n\nnamespace TestBedApp.Utils\n{\n==== REPLACE\nusing BrowserAutomationFramework.Models;\n\nnamespace BAFStudio.Utils\n{\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\utils\\DarkModeTitleBar.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nusing BrowserAutomationFramework.Models;\n\nnamespace TestBedApp.Utils\n{\n==== REPLACE\nusing BrowserAutomationFramework.Models;\n\nnamespace BAFStudio.Utils\n{\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\utils\\ReThemer.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nnamespace TestBedApp.Utils\n{\n==== REPLACE\nnamespace BAFStudio.Utils\n{\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\README.md**\n\n\u0060\u0060\u0060markdown\n\u003C\u003C\u003C\u003C SEARCH\n# Browser Automation Framework (BAF)\n\n**A stealth-first, .NET 10 browser automation, web scraping, and site reverse-engineering framework powered by real browser sessions.**\n==== REPLACE\n\u003Cp align=\u0022center\u0022\u003E\n  \u003Cimg src=\u0022TestBedApp/baf-studio-icon.svg\u0022 alt=\u0022BAF Studio Icon\u0022 width=\u0022180\u0022 height=\u0022180\u0022 /\u003E\n\u003C/p\u003E\n\n\u003Ch1 align=\u0022center\u0022\u003EBrowser Automation Framework \u0026amp; BAF Studio\u003C/h1\u003E\n\n\u003Cp align=\u0022center\u0022\u003E\n  \u003Cstrong\u003EA stealth-first, .NET 10 browser automation, web scraping, and site reverse-engineering framework powered by real browser sessions.\u003C/strong\u003E\n\u003C/p\u003E\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n### 7. 100% Decoupled Core Library (\u0060BrowserAutomationFramework.dll\u0060)\n* Every feature of the framework lives inside \u0060BrowserAutomationFramework.dll\u0060 with **zero dependency on Windows Forms**.\n* Use the included **Automation Studio (\u0060TestBedApp\u0060)** to visually inspect DOM trees, build projects, and test scrapes, or reference \u0060BrowserAutomationFramework.dll\u0060 directly in your own console apps, background workers, web APIs, or custom GUIs.\n\n---\n\n## Quick Start\n\n### Option A: Using the Automation Studio GUI (\u0060TestBedApp\u0060)\n\n1. **Build and Run the Solution:**\n   ~~~bash\n   dotnet build\n   dotnet run --project TestBedApp\n   ~~~\n==== REPLACE\n### 7. 100% Decoupled Core Library (\u0060BrowserAutomationFramework.dll\u0060) \u0026 BAF Studio IDE\n* Every feature of the framework lives inside \u0060BrowserAutomationFramework.dll\u0060 with **zero dependency on Windows Forms**.\n* Use the included **BAF Studio** desktop IDE to visually inspect DOM trees, build projects, and test scrapes, or reference \u0060BrowserAutomationFramework.dll\u0060 directly in your own console apps, background workers, web APIs, or custom GUIs.\n\n---\n\n## Quick Start\n\n### Option A: Using the BAF Studio GUI\n\n1. **Build and Run BAF Studio:**\n   ~~~bash\n   dotnet build\n   dotnet run --project TestBedApp\n   ~~~\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n\u2514\u2500\u2500 TestBedApp/                          # Dark-mode WinForms Automation Studio GUI\n    \u251C\u2500\u2500 Controls/                        # Virtualized DomTreeView control\n    \u251C\u2500\u2500 utils/                           # Dark mode theming utilities\n    \u2514\u2500\u2500 MainForm.cs                      # Studio UI wrapper\n==== REPLACE\n\u2514\u2500\u2500 TestBedApp/                          # BAF Studio \u2014 Dark-mode WinForms IDE (BAF Studio.exe)\n    \u251C\u2500\u2500 Controls/                        # Virtualized DomTreeView control\n    \u251C\u2500\u2500 utils/                           # Dark mode theming utilities\n    \u251C\u2500\u2500 baf-studio-icon.svg              # BAF Studio 512x512 vector application icon\n    \u2514\u2500\u2500 MainForm.cs                      # BAF Studio UI wrapper\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
      "ModelExplanation": "Renamed the WinForms studio application to **BAF Studio (Browser Automation Framework Studio)** across the project configuration, namespaces (\u0060BAFStudio\u0060), window titles, and documentation, and created a 512x512 vector SVG application icon (\u0060baf-studio-icon.svg\u0060) along with a matching runtime window/taskbar icon renderer.\n\n### Summary of Changes\n\n- **SVG Application Icon (\u0060baf-studio-icon.svg\u0060)**:\n\n- Created a 512x512 (\u0060viewBox=\u00220 0 512 512\u0022\u0060) multi-layered vector icon featuring a dark cyber-studio squircle badge, glassmorphic browser frame, glowing DOM tree nodes, an electric automation core, an interactive target reticle, and a **BAF STUDIO** emblem.\n- Embedded the icon at the top of \u0060README.md\u0060.\n- **Project \u0026 Namespace Rename to BAF Studio**:\n\n- Updated \u0060AutomationStudioSession.StudioTitle\u0060 (\u0060\u0022BAF Studio - Browser Automation Framework Studio\u0022\u0060), \u0060StudioShortTitle\u0060 (\u0060\u0022BAF Studio\u0022\u0060), and \u0060StudioDescription\u0060.\n- Configured \u0060TestBedApp.csproj\u0060 with \u0060\u003CAssemblyName\u003EBAF Studio\u003C/AssemblyName\u003E\u0060, \u0060\u003CProduct\u003EBAF Studio\u003C/Product\u003E\u0060, and \u0060\u003CRootNamespace\u003EBAFStudio\u003C/RootNamespace\u003E\u0060.\n- Updated all namespaces and references in \u0060Program.cs\u0060, \u0060MainForm.cs\u0060, \u0060MainForm.Designer.cs\u0060, \u0060Controls\\DomTreeView.cs\u0060, \u0060utils\\DarkMessageBox.cs\u0060, \u0060utils\\DarkModeTitleBar.cs\u0060, and \u0060utils\\ReThemer.cs\u0060 from \u0060TestBedApp\u0060 to \u0060BAFStudio\u0060.\n- Added runtime GDI\u002B icon generation (\u0060CreateBafStudioAppIcon\u0060) and enabled \u0060DarkModeTitleBar\u0060 in \u0060MainForm.cs\u0060 so the window title bar, taskbar, and dialogs display the BAF Studio icon.\n\n### How to Test\n\n- Open \u0060C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\baf-studio-icon.svg\u0060 in any browser or vector viewer to inspect the 512x512 SVG icon.\n- Build and run the application (\u0060dotnet run --project TestBedApp\u0060) and verify the window title (\u0060BAF Studio - Browser Automation Framework Studio\u0060), custom window/taskbar icon, and **Help -\u003E About** dialog.",
