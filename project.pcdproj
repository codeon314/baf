    {
      "Id": "ad829ec4",
      "Timestamp": "2026-10-27T19:56:19.0051085-05:00",
      "UserPrompt": "PLease finish the changes you were doing. You left off at ChromeExtensionGenerator.cs code file, which was not completedf. Please pickup from here and continue. You do not need to include a summary of changes this time as well.",
      "ModelResponse": "Anti-Agent v1.0\n\nContinuing from \u0060ChromeExtensionGenerator.cs\u0060 and completing the server and UI integration.\n\n--CODESTART--\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Generators\\ChromeExtensionGenerator.cs**\n\n\u0060\u0060\u0060cs\nusing System;\nusing System.IO;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing BrowserAutomationFramework.Models;\n\nnamespace BrowserAutomationFramework.Generators\n{\n    /// \u003Csummary\u003E\n    /// Generates an unpacked Manifest V3 Chrome Extension that reports all open browser tabs to\n    /// \u003Csee cref=\u0022Server.AutomationServer\u0022/\u003E and allows on-demand script injection and tab switching.\n    /// \u003C/summary\u003E\n    public static class ChromeExtensionGenerator\n    {\n        /// \u003Csummary\u003E\n        /// Resolves the default ChromeExtension directory inside the solution if present, or inside the application base directory.\n        /// \u003C/summary\u003E\n        public static string GetDefaultExtensionDirectory()\n        {\n            string baseDir = AppContext.BaseDirectory;\n            DirectoryInfo? current = new DirectoryInfo(baseDir);\n            while (current != null)\n            {\n                string candidate = Path.Combine(current.FullName, \u0022BrowserAutomationFramework\u0022, \u0022ChromeExtension\u0022);\n                if (Directory.Exists(Path.Combine(current.FullName, \u0022BrowserAutomationFramework\u0022)))\n                {\n                    return candidate;\n                }\n                current = current.Parent;\n            }\n\n            return Path.Combine(baseDir, \u0022ChromeExtension\u0022);\n        }\n\n        /// \u003Csummary\u003E\n        /// Writes all Manifest V3 Chrome Extension files (\u003Cc\u003Emanifest.json\u003C/c\u003E, \u003Cc\u003Ebackground.js\u003C/c\u003E,\n        /// \u003Cc\u003Econtent_relay.js\u003C/c\u003E, \u003Cc\u003Ebridge.js\u003C/c\u003E, \u003Cc\u003Epopup.html\u003C/c\u003E, \u003Cc\u003Epopup.js\u003C/c\u003E) to the specified folder.\n        /// \u003C/summary\u003E\n        public static string ExportToDirectory(\n            string directoryPath,\n            int port = 9999,\n            IpcMode mode = IpcMode.WebSocket,\n            string? customScript = null)\n        {\n            if (string.IsNullOrWhiteSpace(directoryPath))\n                throw new ArgumentException(\u0022Directory path cannot be empty.\u0022, nameof(directoryPath));\n\n            Directory.CreateDirectory(directoryPath);\n\n            var scriptOptions = new ScriptOptions\n            {\n                Port = port,\n                Mode = mode,\n                PollingIntervalMs = 250,\n                CustomScript = customScript ?? string.Empty\n            };\n\n            string bridgeJs = ScriptGenerator.Generate(scriptOptions);\n\n            File.WriteAllText(Path.Combine(directoryPath, \u0022manifest.json\u0022), GenerateManifestJson(), Encoding.UTF8);\n            File.WriteAllText(Path.Combine(directoryPath, \u0022background.js\u0022), GenerateBackgroundJs(port, mode), Encoding.UTF8);\n            File.WriteAllText(Path.Combine(directoryPath, \u0022content_relay.js\u0022), GenerateContentRelayJs(), Encoding.UTF8);\n            File.WriteAllText(Path.Combine(directoryPath, \u0022bridge.js\u0022), bridgeJs, Encoding.UTF8);\n            File.WriteAllText(Path.Combine(directoryPath, \u0022popup.html\u0022), GeneratePopupHtml(), Encoding.UTF8);\n            File.WriteAllText(Path.Combine(directoryPath, \u0022popup.js\u0022), GeneratePopupJs(port), Encoding.UTF8);\n\n            return directoryPath;\n        }\n\n        /// \u003Csummary\u003E\n        /// Asynchronously writes all Manifest V3 Chrome Extension files to the specified folder.\n        /// \u003C/summary\u003E\n        public static async Task\u003Cstring\u003E ExportToDirectoryAsync(\n            string directoryPath,\n            int port = 9999,\n            IpcMode mode = IpcMode.WebSocket,\n            string? customScript = null,\n            CancellationToken cancellationToken = default)\n        {\n            if (string.IsNullOrWhiteSpace(directoryPath))\n                throw new ArgumentException(\u0022Directory path cannot be empty.\u0022, nameof(directoryPath));\n\n            Directory.CreateDirectory(directoryPath);\n\n            var scriptOptions = new ScriptOptions\n            {\n                Port = port,\n                Mode = mode,\n                PollingIntervalMs = 250,\n                CustomScript = customScript ?? string.Empty\n            };\n\n            string bridgeJs = ScriptGenerator.Generate(scriptOptions);\n\n            await File.WriteAllTextAsync(Path.Combine(directoryPath, \u0022manifest.json\u0022), GenerateManifestJson(), Encoding.UTF8, cancellationToken);\n            await File.WriteAllTextAsync(Path.Combine(directoryPath, \u0022background.js\u0022), GenerateBackgroundJs(port, mode), Encoding.UTF8, cancellationToken);\n            await File.WriteAllTextAsync(Path.Combine(directoryPath, \u0022content_relay.js\u0022), GenerateContentRelayJs(), Encoding.UTF8, cancellationToken);\n            await File.WriteAllTextAsync(Path.Combine(directoryPath, \u0022bridge.js\u0022), bridgeJs, Encoding.UTF8, cancellationToken);\n            await File.WriteAllTextAsync(Path.Combine(directoryPath, \u0022popup.html\u0022), GeneratePopupHtml(), Encoding.UTF8, cancellationToken);\n            await File.WriteAllTextAsync(Path.Combine(directoryPath, \u0022popup.js\u0022), GeneratePopupJs(port), Encoding.UTF8, cancellationToken);\n\n            return directoryPath;\n        }\n\n        public static string GenerateManifestJson()\n        {\n            return @\u0022{\n  \u0022\u0022manifest_version\u0022\u0022: 3,\n  \u0022\u0022name\u0022\u0022: \u0022\u0022Browser Automation Framework Bridge\u0022\u0022,\n  \u0022\u0022version\u0022\u0022: \u0022\u00221.0.0\u0022\u0022,\n  \u0022\u0022description\u0022\u0022: \u0022\u0022Reports open browser tabs to Browser Automation Framework and enables one-click script injection and tab switching.\u0022\u0022,\n  \u0022\u0022permissions\u0022\u0022: [\n    \u0022\u0022tabs\u0022\u0022,\n    \u0022\u0022scripting\u0022\u0022,\n    \u0022\u0022storage\u0022\u0022,\n    \u0022\u0022activeTab\u0022\u0022,\n    \u0022\u0022alarms\u0022\u0022\n  ],\n  \u0022\u0022host_permissions\u0022\u0022: [\n    \u0022\u0022\u003Call_urls\u003E\u0022\u0022,\n    \u0022\u0022http://127.0.0.1/*\u0022\u0022,\n    \u0022\u0022http://localhost/*\u0022\u0022,\n    \u0022\u0022ws://127.0.0.1/*\u0022\u0022,\n    \u0022\u0022ws://localhost/*\u0022\u0022\n  ],\n  \u0022\u0022background\u0022\u0022: {\n    \u0022\u0022service_worker\u0022\u0022: \u0022\u0022background.js\u0022\u0022\n  },\n  \u0022\u0022action\u0022\u0022: {\n    \u0022\u0022default_title\u0022\u0022: \u0022\u0022BAF Automation Bridge\u0022\u0022,\n    \u0022\u0022default_popup\u0022\u0022: \u0022\u0022popup.html\u0022\u0022\n  }\n}\n\u0022;\n        }\n\n        public static string GenerateContentRelayJs()\n        {\n            return @\u0022// BAF Content Script Relay (ISOLATED World)\n// Bridges GM_xmlhttpRequest calls from the MAIN world automation script to the privileged background service worker.\n(function() {\n    \u0027use strict\u0027;\n    if (window.__baf_content_relay_installed) return;\n    window.__baf_content_relay_installed = true;\n\n    window.addEventListener(\u0027__baf_gmxhr_req\u0027, (e) =\u003E {\n        let payload = null;\n        try {\n            payload = JSON.parse((e \u0026\u0026 e.detail) ? e.detail : \u0027{}\u0027);\n        } catch (err) {\n            return;\n        }\n        if (!payload || !payload.reqId) return;\n\n        const resEventName = \u0027__baf_gmxhr_res_\u0027 \u002B payload.reqId;\n        try {\n            chrome.runtime.sendMessage({ type: \u0027BAF_GM_XHR\u0027, payload: payload }, (response) =\u003E {\n                if (chrome.runtime.lastError) {\n                    window.dispatchEvent(new CustomEvent(resEventName, {\n                        detail: JSON.stringify({ error: chrome.runtime.lastError.message || \u0027Extension runtime error\u0027 })\n                    }));\n                    return;\n                }\n                window.dispatchEvent(new CustomEvent(resEventName, {\n                    detail: JSON.stringify(response || { error: \u0027Empty response from background service worker\u0027 })\n                }));\n            });\n        } catch (err) {\n            window.dispatchEvent(new CustomEvent(resEventName, {\n                detail: JSON.stringify({ error: err \u0026\u0026 err.message ? err.message : String(err) })\n            }));\n        }\n    });\n})();\n\u0022;\n        }\n\n        public static string GenerateBackgroundJs(int defaultPort = 9999, IpcMode defaultMode = IpcMode.WebSocket)\n        {\n            string modeStr = defaultMode == IpcMode.WebSocket ? \u0022ws\u0022 : \u0022http\u0022;\n            return $@\u0022// BAF Chrome Extension Background Service Worker\n\u0027use strict\u0027;\n\nconst DEFAULT_PORT = {defaultPort};\nconst FALLBACK_PORTS = [9999, 8081];\nlet currentPort = DEFAULT_PORT;\nlet currentMode = \u0027{modeStr}\u0027;\nlet ws = null;\nlet wsConnected = false;\nlet reconnectTimer = null;\nlet heartbeatTimer = null;\nlet attachedTabIds = new Set();\nlet activeAttachedTabId = null;\n\nchrome.storage.local.get([\u0027baf_port\u0027, \u0027baf_mode\u0027, \u0027baf_attached_tabs\u0027, \u0027baf_active_tab\u0027], (data) =\u003E {{\n    if (data \u0026\u0026 data.baf_port) currentPort = Number(data.baf_port) || DEFAULT_PORT;\n    if (data \u0026\u0026 data.baf_mode) currentMode = String(data.baf_mode);\n    if (data \u0026\u0026 Array.isArray(data.baf_attached_tabs)) {{\n        attachedTabIds = new Set(data.baf_attached_tabs.map(Number).filter(Boolean));\n    }}\n    if (data \u0026\u0026 data.baf_active_tab) {{\n        activeAttachedTabId = Number(data.baf_active_tab) || null;\n    }}\n    connectToServer();\n}});\n\ntry {{\n    chrome.alarms.create(\u0027baf_keepalive\u0027, {{ periodInMinutes: 0.4 }});\n    chrome.alarms.onAlarm.addListener((alarm) =\u003E {{\n        if (alarm \u0026\u0026 alarm.name === \u0027baf_keepalive\u0027) {{\n            if (!wsConnected) connectToServer();\n            else syncTabsToServer();\n        }}\n    }});\n}} catch (e) {{}}\n\nfunction persistState() {{\n    chrome.storage.local.set({{\n        baf_port: currentPort,\n        baf_mode: currentMode,\n        baf_attached_tabs: Array.from(attachedTabIds),\n        baf_active_tab: activeAttachedTabId\n    }});\n}}\n\nfunction isInjectableUrl(url) {{\n    if (!url || typeof url !== \u0027string\u0027) return false;\n    const lower = url.toLowerCase();\n    if (lower.startsWith(\u0027chrome://\u0027) ||\n        lower.startsWith(\u0027edge://\u0027) ||\n        lower.startsWith(\u0027about:\u0027) ||\n        lower.startsWith(\u0027chrome-extension://\u0027) ||\n        lower.startsWith(\u0027devtools://\u0027) ||\n        lower.startsWith(\u0027view-source:\u0027) ||\n        lower.startsWith(\u0027https://chrome.google.com/webstore\u0027) ||\n        lower.startsWith(\u0027https://chromewebstore.google.com\u0027)) {{\n        return false;\n    }}\n    return lower.startsWith(\u0027http://\u0027) || lower.startsWith(\u0027https://\u0027) || lower.startsWith(\u0027file://\u0027);\n}}\n\nasync function collectOpenTabs() {{\n    try {{\n        const tabs = await chrome.tabs.query({{}});\n        const openIds = new Set(tabs.map(t =\u003E t.id));\n        for (const id of Array.from(attachedTabIds)) {{\n            if (!openIds.has(id)) {{\n                attachedTabIds.delete(id);\n                if (activeAttachedTabId === id) activeAttachedTabId = null;\n            }}\n        }}\n\n        return tabs.map(t =\u003E {{\n            const rawUrl = t.url || t.pendingUrl || \u0027\u0027;\n            return {{\n                tabId: t.id,\n                windowId: t.windowId,\n                index: t.index,\n                title: t.title || \u0027(Untitled Tab)\u0027,\n                url: rawUrl,\n                active: Boolean(t.active),\n                status: t.status || \u0027complete\u0027,\n                canInject: isInjectableUrl(rawUrl),\n                isInjected: attachedTabIds.has(t.id),\n                instanceId: \u0027tab_\u0027 \u002B t.id\n            }};\n        }});\n    }} catch (e) {{\n        return [];\n    }}\n}}\n\nasync function syncTabsToServer() {{\n    const tabs = await collectOpenTabs();\n    const payload = {{\n        activeAttachedTabId: activeAttachedTabId,\n        attachedTabIds: Array.from(attachedTabIds),\n        tabs: tabs\n    }};\n\n    if (ws \u0026\u0026 ws.readyState === WebSocket.OPEN) {{\n        try {{\n            ws.send(JSON.stringify({{ event: \u0027EXTENSION_TABS_UPDATED\u0027, payload: payload }}));\n            return true;\n        }} catch (e) {{}}\n    }}\n\n    try {{\n        const res = await fetch(\u0060http://127.0.0.1:${{currentPort}}/api/ext/tabs\u0060, {{\n            method: \u0027POST\u0027,\n            headers: {{ \u0027Content-Type\u0027: \u0027application/json\u0027 }},\n            body: JSON.stringify(payload)\n        }});\n        if (res.ok) {{\n            const data = await res.json();\n            if (data \u0026\u0026 Array.isArray(data.commands)) {{\n                for (const cmd of data.commands) {{\n                    await handleServerExtensionCommand(cmd);\n                }}\n            }}\n            return true;\n        }}\n    }} catch (e) {{}}\n    return false;\n}}\n\nasync function disposeBridgeInTab(tabId) {{\n    attachedTabIds.delete(tabId);\n    if (activeAttachedTabId === tabId) {{\n        const remaining = Array.from(attachedTabIds);\n        activeAttachedTabId = remaining.length \u003E 0 ? remaining[remaining.length - 1] : null;\n    }}\n    persistState();\n\n    try {{\n        await chrome.scripting.executeScript({{\n            target: {{ tabId: tabId }},\n            world: \u0027MAIN\u0027,\n            func: () =\u003E {{\n                if (window.__baf_bridge \u0026\u0026 typeof window.__baf_bridge.dispose === \u0027function\u0027) {{\n                    window.__baf_bridge.dispose();\n                }}\n            }}\n        }});\n    }} catch (e) {{}}\n}}\n\nasync function injectBridgeIntoTab(tabId, options = {{}}) {{\n    const exclusive = options.exclusive !== undefined ? Boolean(options.exclusive) : true;\n    const focusTab = Boolean(options.focus);\n    const forceReinject = Boolean(options.forceReinject);\n    if (options.port) currentPort = Number(options.port) || currentPort;\n    if (options.mode) currentMode = String(options.mode);\n\n    let tab;\n    try {{\n        tab = await chrome.tabs.get(tabId);\n    }} catch (e) {{\n        attachedTabIds.delete(tabId);\n        await syncTabsToServer();\n        return {{ success: false, error: \u0027Tab not found: \u0027 \u002B tabId }};\n    }}\n\n    const tabUrl = tab.url || tab.pendingUrl || \u0027\u0027;\n    if (!isInjectableUrl(tabUrl)) {{\n        return {{ success: false, error: \u0027Cannot inject script into restricted browser URL: \u0027 \u002B tabUrl }};\n    }}\n\n    if (exclusive) {{\n        for (const otherId of Array.from(attachedTabIds)) {{\n            if (otherId !== tabId) {{\n                await disposeBridgeInTab(otherId);\n            }}\n        }}\n    }}\n\n    if (focusTab) {{\n        try {{\n            await chrome.tabs.update(tabId, {{ active: true }});\n            if (tab.windowId) {{\n                await chrome.windows.update(tab.windowId, {{ focused: true }});\n            }}\n        }} catch (e) {{}}\n    }}\n\n    try {{\n        if (!forceReinject) {{\n            const checkRes = await chrome.scripting.executeScript({{\n                target: {{ tabId: tabId }},\n                world: \u0027MAIN\u0027,\n                func: (expectedPort) =\u003E {{\n                    if (window.__baf_bridge \u0026\u0026 window.__baf_bridge.active \u0026\u0026 window.__baf_bridge.port === expectedPort) {{\n                        if (typeof window.__baf_bridge.reannounce === \u0027function\u0027) {{\n                            window.__baf_bridge.reannounce();\n                        }}\n                        return true;\n                    }}\n                    return false;\n                }},\n                args: [currentPort]\n            }});\n\n            if (checkRes \u0026\u0026 checkRes[0] \u0026\u0026 checkRes[0].result === true) {{\n                attachedTabIds.add(tabId);\n                activeAttachedTabId = tabId;\n                persistState();\n                await syncTabsToServer();\n                return {{ success: true, tabId: tabId, instanceId: \u0027tab_\u0027 \u002B tabId, reused: true }};\n            }}\n        }}\n\n        await chrome.scripting.executeScript({{\n            target: {{ tabId: tabId }},\n            world: \u0027ISOLATED\u0027,\n            files: [\u0027content_relay.js\u0027]\n        }});\n\n        await chrome.scripting.executeScript({{\n            target: {{ tabId: tabId }},\n            world: \u0027MAIN\u0027,\n            func: (cfg) =\u003E {{\n                window.__BAF_EXTENSION_CONFIG = cfg;\n            }},\n            args: [{{\n                instanceId: \u0027tab_\u0027 \u002B tabId,\n                tabId: tabId,\n                port: currentPort,\n                mode: currentMode\n            }}]\n        }});\n\n        await chrome.scripting.executeScript({{\n            target: {{ tabId: tabId }},\n            world: \u0027MAIN\u0027,\n            files: [\u0027bridge.js\u0027]\n        }});\n\n        attachedTabIds.add(tabId);\n        activeAttachedTabId = tabId;\n        persistState();\n        await syncTabsToServer();\n        return {{ success: true, tabId: tabId, instanceId: \u0027tab_\u0027 \u002B tabId }};\n    }} catch (err) {{\n        return {{ success: false, error: err \u0026\u0026 err.message ? err.message : String(err) }};\n    }}\n}}\n\nasync function handleServerExtensionCommand(cmd) {{\n    if (!cmd || !cmd.type) return;\n    const payload = cmd.payload || cmd;\n\n    switch (cmd.type) {{\n        case \u0027ATTACH_TAB\u0027: {{\n            const tabId = Number(payload.tabId);\n            if (tabId) {{\n                await injectBridgeIntoTab(tabId, {{\n                    exclusive: payload.exclusive !== undefined ? payload.exclusive : true,\n                    focus: Boolean(payload.focus),\n                    forceReinject: Boolean(payload.forceReinject),\n                    port: payload.port || currentPort,\n                    mode: payload.mode || currentMode\n                }});\n            }}\n            break;\n        }}\n        case \u0027DETACH_TAB\u0027: {{\n            const tabId = Number(payload.tabId);\n            if (tabId) {{\n                await disposeBridgeInTab(tabId);\n                await syncTabsToServer();\n            }}\n            break;\n        }}\n        case \u0027FOCUS_TAB\u0027: {{\n            const tabId = Number(payload.tabId);\n            if (tabId) {{\n                try {{\n                    const t = await chrome.tabs.get(tabId);\n                    await chrome.tabs.update(tabId, {{ active: true }});\n                    if (t \u0026\u0026 t.windowId) {{\n                        await chrome.windows.update(t.windowId, {{ focused: true }});\n                    }}\n                }} catch (e) {{}}\n                await syncTabsToServer();\n            }}\n            break;\n        }}\n        case \u0027REFRESH_TABS\u0027: {{\n            await syncTabsToServer();\n            break;\n        }}\n    }}\n}}\n\nasync function probeAvailableServerPort() {{\n    const candidates = [currentPort, ...FALLBACK_PORTS.filter(p =\u003E p !== currentPort)];\n    for (const p of candidates) {{\n        try {{\n            const controller = new AbortController();\n            const timer = setTimeout(() =\u003E controller.abort(), 1200);\n            const res = await fetch(\u0060http://127.0.0.1:${{p}}/api/ext/status\u0060, {{ signal: controller.signal }});\n            clearTimeout(timer);\n            if (res.ok) {{\n                if (p !== currentPort) {{\n                    currentPort = p;\n                    persistState();\n                }}\n                return p;\n            }}\n        }} catch (e) {{}}\n    }}\n    return currentPort;\n}}\n\nfunction scheduleReconnect(delayMs = 2500) {{\n    if (reconnectTimer) clearTimeout(reconnectTimer);\n    reconnectTimer = setTimeout(() =\u003E {{\n        reconnectTimer = null;\n        connectToServer();\n    }}, delayMs);\n}}\n\nasync function connectToServer() {{\n    if (ws \u0026\u0026 (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) {{\n        return;\n    }}\n\n    const targetPort = await probeAvailableServerPort();\n    try {{\n        ws = new WebSocket(\u0060ws://127.0.0.1:${{targetPort}}/?role=extension\u0060);\n    }} catch (e) {{\n        wsConnected = false;\n        scheduleReconnect(2500);\n        return;\n    }}\n\n    ws.onopen = async () =\u003E {{\n        wsConnected = true;\n        await syncTabsToServer();\n        if (heartbeatTimer) clearInterval(heartbeatTimer);\n        heartbeatTimer = setInterval(() =\u003E {{\n            if (ws \u0026\u0026 ws.readyState === WebSocket.OPEN) {{\n                syncTabsToServer();\n            }}\n        }}, 5000);\n    }};\n\n    ws.onmessage = async (event) =\u003E {{\n        try {{\n            const msg = JSON.parse(event.data);\n            await handleServerExtensionCommand(msg);\n        }} catch (e) {{}}\n    }};\n\n    ws.onerror = () =\u003E {{}};\n\n    ws.onclose = () =\u003E {{\n        wsConnected = false;\n        ws = null;\n        if (heartbeatTimer) {{\n            clearInterval(heartbeatTimer);\n            heartbeatTimer = null;\n        }}\n        scheduleReconnect(2000);\n    }};\n}}\n\n// Tab Lifecycle Listeners\nchrome.tabs.onCreated.addListener(() =\u003E {{ syncTabsToServer(); }});\nchrome.tabs.onRemoved.addListener((tabId) =\u003E {{\n    if (attachedTabIds.has(tabId)) {{\n        attachedTabIds.delete(tabId);\n        if (activeAttachedTabId === tabId) activeAttachedTabId = null;\n        persistState();\n    }}\n    syncTabsToServer();\n}});\nchrome.tabs.onActivated.addListener(() =\u003E {{ syncTabsToServer(); }});\nchrome.tabs.onUpdated.addListener(async (tabId, changeInfo, tab) =\u003E {{\n    if (changeInfo.status === \u0027complete\u0027 \u0026\u0026 attachedTabIds.has(tabId)) {{\n        // Re-inject automatically if a full-page navigation wiped window.__baf_bridge\n        await injectBridgeIntoTab(tabId, {{\n            exclusive: false,\n            focus: false,\n            forceReinject: false\n        }});\n    }} else if (changeInfo.status || changeInfo.title || changeInfo.url) {{\n        syncTabsToServer();\n    }}\n}});\n\n// Handle GM_xmlhttpRequest relay \u0026 Popup messages\nasync function handleGmXhr(req) {{\n    const controller = new AbortController();\n    const timeoutMs = (req \u0026\u0026 req.timeout) ? Number(req.timeout) : 15000;\n    const timer = setTimeout(() =\u003E controller.abort(), timeoutMs);\n    try {{\n        const method = (req \u0026\u0026 req.method) ? String(req.method).toUpperCase() : \u0027GET\u0027;\n        const fetchOpts = {{\n            method: method,\n            headers: (req \u0026\u0026 req.headers) ? req.headers : {{}},\n            signal: controller.signal\n        }};\n        if (req \u0026\u0026 req.data !== null \u0026\u0026 req.data !== undefined \u0026\u0026 method !== \u0027GET\u0027 \u0026\u0026 method !== \u0027HEAD\u0027) {{\n            fetchOpts.body = req.data;\n        }}\n        const res = await fetch(req.url, fetchOpts);\n        const text = method === \u0027HEAD\u0027 ? \u0027\u0027 : await res.text();\n        const rawHeaders = [];\n        res.headers.forEach((val, key) =\u003E {{\n            rawHeaders.push(\u0060${{key}}: ${{val}}\u0060);\n        }});\n        return {{\n            status: res.status,\n            statusText: res.statusText || \u0027\u0027,\n            responseText: text,\n            responseHeaders: rawHeaders.join(\u0027\\r\\n\u0027)\n        }};\n    }} catch (err) {{\n        const isAbort = Boolean(err \u0026\u0026 err.name === \u0027AbortError\u0027);\n        return {{\n            error: isAbort ? \u0027Request timeout\u0027 : (err \u0026\u0026 err.message ? err.message : String(err)),\n            isTimeout: isAbort\n        }};\n    }} finally {{\n        clearTimeout(timer);\n    }}\n}}\n\nchrome.runtime.onMessage.addListener((message, sender, sendResponse) =\u003E {{\n    if (!message || !message.type) return false;\n\n    if (message.type === \u0027BAF_GM_XHR\u0027) {{\n        handleGmXhr(message.payload).then(sendResponse);\n        return true;\n    }}\n\n    if (message.type === \u0027POPUP_GET_STATE\u0027) {{\n        collectOpenTabs().then(tabs =\u003E {{\n            sendResponse({{\n                connected: wsConnected,\n                port: currentPort,\n                mode: currentMode,\n                activeAttachedTabId: activeAttachedTabId,\n                attachedTabIds: Array.from(attachedTabIds),\n                tabs: tabs\n            }});\n        }});\n        return true;\n    }}\n\n    if (message.type === \u0027POPUP_SET_PORT\u0027) {{\n        const newPort = Number(message.port);\n        if (newPort \u003E= 1024 \u0026\u0026 newPort \u003C= 65535) {{\n            currentPort = newPort;\n            persistState();\n            if (ws) {{\n                try {{ ws.close(); }} catch (e) {{}}\n                ws = null;\n            }}\n            connectToServer().then(() =\u003E sendResponse({{ ok: true, port: currentPort }}));\n            return true;\n        }}\n        sendResponse({{ ok: false }});\n        return false;\n    }}\n\n    if (message.type === \u0027POPUP_ATTACH_TAB\u0027) {{\n        const tabId = Number(message.tabId);\n        const exclusive = message.exclusive !== undefined ? Boolean(message.exclusive) : true;\n        injectBridgeIntoTab(tabId, {{ exclusive: exclusive, focus: false, forceReinject: true }})\n            .then(res =\u003E {{\n                // Also notify C# server that user selected this tab from the popup\n                fetch(\u0060http://127.0.0.1:${{currentPort}}/api/ext/select-tab\u0060, {{\n                    method: \u0027POST\u0027,\n                    headers: {{ \u0027Content-Type\u0027: \u0027application/json\u0027 }},\n                    body: JSON.stringify({{ tabId: tabId, exclusive: exclusive }})\n                }}).catch(() =\u003E {{}});\n                sendResponse(res);\n            }});\n        return true;\n    }}\n\n    if (message.type === \u0027POPUP_DETACH_TAB\u0027) {{\n        const tabId = Number(message.tabId);\n        disposeBridgeInTab(tabId).then(async () =\u003E {{\n            fetch(\u0060http://127.0.0.1:${{currentPort}}/api/ext/detach-tab\u0060, {{\n                method: \u0027POST\u0027,\n                headers: {{ \u0027Content-Type\u0027: \u0027application/json\u0027 }},\n                body: JSON.stringify({{ tabId: tabId }})\n            }}).catch(() =\u003E {{}});\n            await syncTabsToServer();\n            sendResponse({{ ok: true }});\n        }});\n        return true;\n    }}\n\n    return false;\n}});\n\u0022;\n        }\n\n        public static string GeneratePopupHtml()\n        {\n            return @\u0022\u003C!DOCTYPE html\u003E\n\u003Chtml\u003E\n\u003Chead\u003E\n    \u003Cmeta charset=\u0022\u0022utf-8\u0022\u0022 /\u003E\n    \u003Ctitle\u003EBAF Automation Bridge\u003C/title\u003E\n    \u003Cstyle\u003E\n        body {\n            width: 380px;\n            margin: 0;\n            padding: 12px;\n            background-color: #1e1e1e;\n            color: #d4d4d4;\n            font-family: \u0027Segoe UI\u0027, Tahoma, sans-serif;\n            font-size: 13px;\n        }\n        .header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 10px;\n            padding-bottom: 8px;\n            border-bottom: 1px solid #333;\n        }\n        .title {\n            font-weight: 600;\n            font-size: 14px;\n            color: #fff;\n        }\n        .badge {\n            padding: 2px 8px;\n            border-radius: 3px;\n            font-size: 11px;\n            font-weight: 600;\n        }\n        .badge-connected { background: #135c2d; color: #73f59b; }\n        .badge-disconnected { background: #663c00; color: #ffca6b; }\n        .port-row {\n            display: flex;\n            align-items: center;\n            gap: 6px;\n            margin-bottom: 10px;\n        }\n        input[type=\u0022\u0022number\u0022\u0022] {\n            width: 80px;\n            padding: 4px 6px;\n            background: #252526;\n            border: 1px solid #454545;\n            color: #fff;\n        }\n        button {\n            background: #0e639c;\n            color: #fff;\n            border: 1px solid #1177bb;\n            padding: 5px 10px;\n            cursor: pointer;\n            font-size: 12px;\n        }\n        button:hover { background: #1177bb; }\n        button.btn-secondary {\n            background: #333337;\n            border-color: #46464a;\n        }\n        button.btn-secondary:hover { background: #3e3e42; }\n        button.btn-danger {\n            background: #7a2121;\n            border-color: #9e2e2e;\n        }\n        .current-box {\n            background: #252526;\n            border: 1px solid #3c3c3c;\n            padding: 8px;\n            margin-bottom: 10px;\n        }\n        .tab-list {\n            max-height: 240px;\n            overflow-y: auto;\n            border: 1px solid #3c3c3c;\n            background: #252526;\n        }\n        .tab-item {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            padding: 6px 8px;\n            border-bottom: 1px solid #2d2d30;\n            gap: 8px;\n        }\n        .tab-item.injected {\n            background: rgba(19, 92, 45, 0.28);\n            border-left: 3px solid #2ea043;\n        }\n        .tab-info {\n            flex: 1;\n            min-width: 0;\n        }\n        .tab-title {\n            white-space: nowrap;\n            overflow: hidden;\n            text-overflow: ellipsis;\n            color: #e0e0e0;\n            font-weight: 500;\n        }\n        .tab-url {\n            white-space: nowrap;\n            overflow: hidden;\n            text-overflow: ellipsis;\n            color: #888;\n            font-size: 11px;\n        }\n    \u003C/style\u003E\n\u003C/head\u003E\n\u003Cbody\u003E\n    \u003Cdiv class=\u0022\u0022header\u0022\u0022\u003E\n        \u003Cspan class=\u0022\u0022title\u0022\u0022\u003EBAF Automation Bridge\u003C/span\u003E\n        \u003Cspan id=\u0022\u0022statusBadge\u0022\u0022 class=\u0022\u0022badge badge-disconnected\u0022\u0022\u003EChecking...\u003C/span\u003E\n    \u003C/div\u003E\n\n    \u003Cdiv class=\u0022\u0022port-row\u0022\u0022\u003E\n        \u003Clabel for=\u0022\u0022portInput\u0022\u0022\u003EServer Port:\u003C/label\u003E\n        \u003Cinput id=\u0022\u0022portInput\u0022\u0022 type=\u0022\u0022number\u0022\u0022 min=\u0022\u00221024\u0022\u0022 max=\u0022\u002265535\u0022\u0022 value=\u0022\u00229999\u0022\u0022 /\u003E\n        \u003Cbutton id=\u0022\u0022btnSavePort\u0022\u0022 class=\u0022\u0022btn-secondary\u0022\u0022\u003EApply / Reconnect\u003C/button\u003E\n    \u003C/div\u003E\n\n    \u003Cdiv class=\u0022\u0022current-box\u0022\u0022\u003E\n        \u003Cdiv style=\u0022\u0022margin-bottom: 6px; font-weight: 600;\u0022\u0022\u003EActive Browser Tab\u003C/div\u003E\n        \u003Cdiv id=\u0022\u0022currentTabTitle\u0022\u0022 class=\u0022\u0022tab-title\u0022\u0022 style=\u0022\u0022margin-bottom: 6px;\u0022\u0022\u003ELoading...\u003C/div\u003E\n        \u003Cdiv style=\u0022\u0022display: flex; gap: 6px;\u0022\u0022\u003E\n            \u003Cbutton id=\u0022\u0022btnAttachCurrent\u0022\u0022 style=\u0022\u0022flex: 1;\u0022\u0022\u003EInject \u0026amp; Switch Here\u003C/button\u003E\n            \u003Cbutton id=\u0022\u0022btnDetachCurrent\u0022\u0022 class=\u0022\u0022btn-danger\u0022\u0022 style=\u0022\u0022display: none;\u0022\u0022\u003EDetach\u003C/button\u003E\n        \u003C/div\u003E\n    \u003C/div\u003E\n\n    \u003Cdiv style=\u0022\u0022margin-bottom: 4px; font-weight: 600;\u0022\u0022\u003EAll Open Tabs\u003C/div\u003E\n    \u003Cdiv id=\u0022\u0022tabList\u0022\u0022 class=\u0022\u0022tab-list\u0022\u0022\u003E\u003C/div\u003E\n\n    \u003Cscript src=\u0022\u0022popup.js\u0022\u0022\u003E\u003C/script\u003E\n\u003C/body\u003E\n\u003C/html\u003E\n\u0022;\n        }\n\n        public static string GeneratePopupJs(int defaultPort = 9999)\n        {\n            return $@\u0022\u0027use strict\u0027;\n\nconst statusBadge = document.getElementById(\u0027statusBadge\u0027);\nconst portInput = document.getElementById(\u0027portInput\u0027);\nconst btnSavePort = document.getElementById(\u0027btnSavePort\u0027);\nconst currentTabTitle = document.getElementById(\u0027currentTabTitle\u0027);\nconst btnAttachCurrent = document.getElementById(\u0027btnAttachCurrent\u0027);\nconst btnDetachCurrent = document.getElementById(\u0027btnDetachCurrent\u0027);\nconst tabList = document.getElementById(\u0027tabList\u0027);\n\nlet activeFocusedTab = null;\n\nfunction renderState(state) {{\n    if (!state) return;\n    portInput.value = state.port || {defaultPort};\n\n    if (state.connected) {{\n        statusBadge.textContent = \u0027Connected\u0027;\n        statusBadge.className = \u0027badge badge-connected\u0027;\n    }} else {{\n        statusBadge.textContent = \u0027Server Offline\u0027;\n        statusBadge.className = \u0027badge badge-disconnected\u0027;\n    }}\n\n    const tabs = Array.isArray(state.tabs) ? state.tabs : [];\n    activeFocusedTab = tabs.find(t =\u003E t.active) || tabs[0] || null;\n\n    if (activeFocusedTab) {{\n        currentTabTitle.textContent = \u0060[#${{activeFocusedTab.tabId}}] ${{activeFocusedTab.title}}\u0060;\n        btnAttachCurrent.disabled = !activeFocusedTab.canInject;\n        btnAttachCurrent.textContent = activeFocusedTab.isInjected ? \u0027Re-Sync This Tab\u0027 : \u0027Inject \u0026 Switch Here\u0027;\n        btnDetachCurrent.style.display = activeFocusedTab.isInjected ? \u0027inline-block\u0027 : \u0027none\u0027;\n    }} else {{\n        currentTabTitle.textContent = \u0027(No active tab)\u0027;\n        btnAttachCurrent.disabled = true;\n    }}\n\n    tabList.innerHTML = \u0027\u0027;\n    tabs.forEach(tab =\u003E {{\n        const row = document.createElement(\u0027div\u0027);\n        row.className = \u0027tab-item\u0027 \u002B (tab.isInjected ? \u0027 injected\u0027 : \u0027\u0027);\n\n        const info = document.createElement(\u0027div\u0027);\n        info.className = \u0027tab-info\u0027;\n\n        const titleEl = document.createElement(\u0027div\u0027);\n        titleEl.className = \u0027tab-title\u0027;\n        titleEl.textContent = (tab.isInjected ? \u0027[HOOKED] \u0027 : \u0027\u0027) \u002B \u0060[#${{tab.tabId}}] ${{tab.title}}\u0060;\n\n        const urlEl = document.createElement(\u0027div\u0027);\n        urlEl.className = \u0027tab-url\u0027;\n        urlEl.textContent = tab.url;\n\n        info.appendChild(titleEl);\n        info.appendChild(urlEl);\n\n        const actionBtn = document.createElement(\u0027button\u0027);\n        if (!tab.canInject) {{\n            actionBtn.textContent = \u0027Restricted\u0027;\n            actionBtn.disabled = true;\n            actionBtn.className = \u0027btn-secondary\u0027;\n        }} else if (tab.isInjected) {{\n            actionBtn.textContent = \u0027Detach\u0027;\n            actionBtn.className = \u0027btn-danger\u0027;\n            actionBtn.onclick = () =\u003E {{\n                chrome.runtime.sendMessage({{ type: \u0027POPUP_DETACH_TAB\u0027, tabId: tab.tabId }}, () =\u003E refreshPopup());\n            }};\n        }} else {{\n            actionBtn.textContent = \u0027Switch\u0027;\n            actionBtn.onclick = () =\u003E {{\n                chrome.runtime.sendMessage({{ type: \u0027POPUP_ATTACH_TAB\u0027, tabId: tab.tabId, exclusive: true }}, () =\u003E refreshPopup());\n            }};\n        }}\n\n        row.appendChild(info);\n        row.appendChild(actionBtn);\n        tabList.appendChild(row);\n    }});\n}}\n\nfunction refreshPopup() {{\n    chrome.runtime.sendMessage({{ type: \u0027POPUP_GET_STATE\u0027 }}, (state) =\u003E {{\n        renderState(state);\n    }});\n}}\n\nbtnSavePort.addEventListener(\u0027click\u0027, () =\u003E {{\n    const p = Number(portInput.value);\n    chrome.runtime.sendMessage({{ type: \u0027POPUP_SET_PORT\u0027, port: p }}, () =\u003E {{\n        setTimeout(refreshPopup, 250);\n    }});\n}});\n\nbtnAttachCurrent.addEventListener(\u0027click\u0027, () =\u003E {{\n    if (!activeFocusedTab) return;\n    chrome.runtime.sendMessage({{ type: \u0027POPUP_ATTACH_TAB\u0027, tabId: activeFocusedTab.tabId, exclusive: true }}, () =\u003E {{\n        refreshPopup();\n    }});\n}});\n\nbtnDetachCurrent.addEventListener(\u0027click\u0027, () =\u003E {{\n    if (!activeFocusedTab) return;\n    chrome.runtime.sendMessage({{ type: \u0027POPUP_DETACH_TAB\u0027, tabId: activeFocusedTab.tabId }}, () =\u003E {{\n        refreshPopup();\n    }});\n}});\n\nrefreshPopup();\n\u0022;\n        }\n    }\n}\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Server\\BrowserClient.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        public string? CurrentUrl { get; private set; }\n        public string? CurrentPageLoadId { get; private set; }\n        public int LastStatusCode { get; private set; } = 200;\n        public string? LastRetryAfter { get; private set; }\n\n        internal bool IsWebSocketConnected =\u003E _webSocket != null \u0026\u0026 _webSocket.State == WebSocketState.Open;\n==== REPLACE\n        public string? CurrentUrl { get; internal set; }\n        public string? PageTitle { get; internal set; }\n        public string? CurrentPageLoadId { get; private set; }\n        public int LastStatusCode { get; private set; } = 200;\n        public string? LastRetryAfter { get; private set; }\n        public int? TabId { get; internal set; }\n\n        public bool IsExtensionClient =\u003E TabId.HasValue || InstanceId.StartsWith(\u0022tab_\u0022, StringComparison.OrdinalIgnoreCase);\n\n        public string DisplayName\n        {\n            get\n            {\n                string prefix = IsExtensionClient ? \u0022[Ext]\u0022 : \u0022[TM]\u0022;\n                if (!string.IsNullOrWhiteSpace(PageTitle))\n                {\n                    string shortTitle = PageTitle.Length \u003E 34 ? PageTitle.Substring(0, 31) \u002B \u0022...\u0022 : PageTitle;\n                    return $\u0022{prefix} {InstanceId} - {shortTitle}\u0022;\n                }\n                if (!string.IsNullOrWhiteSpace(CurrentUrl) \u0026\u0026 Uri.TryCreate(CurrentUrl, UriKind.Absolute, out var uri) \u0026\u0026 !string.IsNullOrWhiteSpace(uri.Host))\n                {\n                    return $\u0022{prefix} {InstanceId} ({uri.Host})\u0022;\n                }\n                return $\u0022{prefix} {InstanceId}\u0022;\n            }\n        }\n\n        internal bool IsWebSocketConnected =\u003E _webSocket != null \u0026\u0026 _webSocket.State == WebSocketState.Open;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        public BrowserClient(string instanceId, IpcMode mode, WebSocket? webSocket = null)\n        {\n            InstanceId = instanceId;\n            Mode = mode;\n            _webSocket = webSocket;\n            if (webSocket != null \u0026\u0026 webSocket.State == WebSocketState.Open)\n            {\n                _wsReconnectTcs.TrySetResult(true);\n            }\n        }\n==== REPLACE\n        public BrowserClient(string instanceId, IpcMode mode, WebSocket? webSocket = null)\n        {\n            InstanceId = instanceId;\n            if (instanceId != null \u0026\u0026\n                instanceId.StartsWith(\u0022tab_\u0022, StringComparison.OrdinalIgnoreCase) \u0026\u0026\n                int.TryParse(instanceId.Substring(4), out int parsedTabId))\n            {\n                TabId = parsedTabId;\n            }\n            Mode = mode;\n            _webSocket = webSocket;\n            if (webSocket != null \u0026\u0026 webSocket.State == WebSocketState.Open)\n            {\n                _wsReconnectTcs.TrySetResult(true);\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                        if (!string.IsNullOrEmpty(pageLoadId))\n                            CurrentPageLoadId = pageLoadId;\n                        if (!string.IsNullOrEmpty(url))\n                            CurrentUrl = url;\n\n                        LastStatusCode = statusCode;\n==== REPLACE\n                        string? title = loadPayload.TryGetProperty(\u0022title\u0022, out var titleProp) \u0026\u0026 titleProp.ValueKind == JsonValueKind.String\n                            ? titleProp.GetString()\n                            : null;\n\n                        if (!string.IsNullOrEmpty(pageLoadId))\n                            CurrentPageLoadId = pageLoadId;\n                        if (!string.IsNullOrEmpty(url))\n                            CurrentUrl = url;\n                        if (!string.IsNullOrEmpty(title))\n                            PageTitle = title;\n\n                        LastStatusCode = statusCode;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        internal void HandleResult(CommandResult result)\n        {\n            if (result.Status == \u0022streaming\u0022)\n            {\n                OnStreamDataReceived?.Invoke(this, result);\n            }\n            else\n            {\n                if (_pendingCommands.TryRemove(result.TaskId, out var pending))\n                {\n                    if (result.Status == \u0022error\u0022)\n                        pending.Tcs.TrySetException(new Exception(result.Output));\n                    else\n                        pending.Tcs.TrySetResult(result);\n                }\n            }\n        }\n    }\n}\n==== REPLACE\n        internal void HandleResult(CommandResult result)\n        {\n            if (result.Status == \u0022streaming\u0022)\n            {\n                OnStreamDataReceived?.Invoke(this, result);\n            }\n            else\n            {\n                if (_pendingCommands.TryRemove(result.TaskId, out var pending))\n                {\n                    if (result.Status == \u0022error\u0022)\n                        pending.Tcs.TrySetException(new Exception(result.Output));\n                    else\n                        pending.Tcs.TrySetResult(result);\n                }\n            }\n        }\n\n        public override string ToString() =\u003E DisplayName;\n    }\n}\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Server\\AutomationServer.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nusing System;\nusing System.Collections.Concurrent;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Net;\nusing System.Net.WebSockets;\nusing System.Text;\nusing System.Text.Json;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing BrowserAutomationFramework.Models;\n\nnamespace BrowserAutomationFramework.Server\n{\n    public class AutomationServer\n    {\n        private readonly int _port;\n        private HttpListener? _listener;\n        private readonly ConcurrentDictionary\u003Cstring, BrowserClient\u003E _clients = new();\n        private System.Threading.Timer? _cleanupTimer;\n\n        public event EventHandler\u003CBrowserClient\u003E? OnClientConnected;\n        public event EventHandler\u003CBrowserClient\u003E? OnClientDisconnected;\n\n        public AutomationServer(int port = 8081)\n        {\n            _port = port;\n        }\n==== REPLACE\nusing System;\nusing System.Collections.Concurrent;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Net;\nusing System.Net.WebSockets;\nusing System.Text;\nusing System.Text.Json;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing BrowserAutomationFramework.Models;\n\nnamespace BrowserAutomationFramework.Server\n{\n    public class AutomationServer\n    {\n        private readonly int _port;\n        private HttpListener? _listener;\n        private readonly ConcurrentDictionary\u003Cstring, BrowserClient\u003E _clients = new();\n        private System.Threading.Timer? _cleanupTimer;\n\n        // Chrome Extension State\n        private WebSocket? _extensionWebSocket;\n        private readonly SemaphoreSlim _extWsSendLock = new(1, 1);\n        private readonly ConcurrentQueue\u003Cobject\u003E _pendingExtensionCommands = new();\n        private List\u003CBrowserTabInfo\u003E _extensionTabs = new();\n        private readonly object _extensionTabsLock = new();\n        private DateTime _lastExtensionSeen = DateTime.MinValue;\n        private bool _wasExtensionConnected;\n\n        public int? ActiveExtensionTabId { get; private set; }\n\n        public bool IsExtensionConnected =\u003E\n            (_extensionWebSocket != null \u0026\u0026 _extensionWebSocket.State == WebSocketState.Open) ||\n            (DateTime.UtcNow - _lastExtensionSeen \u003C TimeSpan.FromSeconds(15));\n\n        public event EventHandler\u003CBrowserClient\u003E? OnClientConnected;\n        public event EventHandler\u003CBrowserClient\u003E? OnClientDisconnected;\n        public event EventHandler? OnExtensionConnected;\n        public event EventHandler? OnExtensionDisconnected;\n        public event EventHandler\u003CExtensionTabsEventArgs\u003E? OnExtensionTabsUpdated;\n\n        public AutomationServer(int port = 8081)\n        {\n            _port = port;\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void CleanupStaleClients(object? state)\n        {\n            var now = DateTime.UtcNow;\n            var httpThreshold = now.AddSeconds(-15);\n            var wsThreshold = now.AddSeconds(-15);\n\n            foreach (var kvp in _clients)\n            {\n                var client = kvp.Value;\n                bool isStale = (client.Mode == IpcMode.HttpPolling \u0026\u0026 client.LastSeen \u003C httpThreshold) ||\n                               (client.Mode == IpcMode.WebSocket \u0026\u0026 !client.IsWebSocketConnected \u0026\u0026 client.LastSeen \u003C wsThreshold);\n\n                if (isStale)\n                {\n                    if (_clients.TryRemove(kvp.Key, out var removedClient))\n                    {\n                        OnClientDisconnected?.Invoke(this, removedClient);\n                    }\n                }\n            }\n        }\n\n        public BrowserClient? GetClient(string instanceId)\n        {\n            _clients.TryGetValue(instanceId, out var client);\n            return client;\n        }\n\n        public IEnumerable\u003CBrowserClient\u003E GetAllClients() =\u003E _clients.Values;\n==== REPLACE\n        private void CleanupStaleClients(object? state)\n        {\n            var now = DateTime.UtcNow;\n            var httpThreshold = now.AddSeconds(-15);\n            var wsThreshold = now.AddSeconds(-15);\n\n            foreach (var kvp in _clients)\n            {\n                var client = kvp.Value;\n                bool isStale = (client.Mode == IpcMode.HttpPolling \u0026\u0026 client.LastSeen \u003C httpThreshold) ||\n                               (client.Mode == IpcMode.WebSocket \u0026\u0026 !client.IsWebSocketConnected \u0026\u0026 client.LastSeen \u003C wsThreshold);\n\n                if (isStale)\n                {\n                    if (_clients.TryRemove(kvp.Key, out var removedClient))\n                    {\n                        OnClientDisconnected?.Invoke(this, removedClient);\n                    }\n                }\n            }\n\n            if (_wasExtensionConnected \u0026\u0026 !IsExtensionConnected)\n            {\n                _wasExtensionConnected = false;\n                OnExtensionDisconnected?.Invoke(this, EventArgs.Empty);\n            }\n        }\n\n        public BrowserClient? GetClient(string instanceId)\n        {\n            _clients.TryGetValue(instanceId, out var client);\n            return client;\n        }\n\n        public IEnumerable\u003CBrowserClient\u003E GetAllClients() =\u003E _clients.Values;\n\n        public IReadOnlyList\u003CBrowserTabInfo\u003E GetExtensionTabs()\n        {\n            lock (_extensionTabsLock)\n            {\n                return _extensionTabs.ToList();\n            }\n        }\n\n        public void DisconnectClient(string instanceId)\n        {\n            if (_clients.TryRemove(instanceId, out var removed))\n            {\n                OnClientDisconnected?.Invoke(this, removed);\n            }\n        }\n\n        /// \u003Csummary\u003E\n        /// Instructs the connected Chrome Extension to inject the automation bridge into \u003Cparamref name=\u0022tabId\u0022/\u003E\n        /// and optionally detach any previously hooked tab so interaction switches cleanly to the selected tab.\n        /// \u003C/summary\u003E\n        public async Task SwitchToExtensionTabAsync(\n            int tabId,\n            bool focusBrowserTab = false,\n            bool detachOtherTabs = true,\n            IpcMode mode = IpcMode.WebSocket,\n            CancellationToken cancellationToken = default)\n        {\n            if (detachOtherTabs)\n            {\n                foreach (var kvp in _clients.ToArray())\n                {\n                    if (kvp.Value.IsExtensionClient \u0026\u0026 kvp.Value.TabId != tabId)\n                    {\n                        DisconnectClient(kvp.Key);\n                    }\n                }\n            }\n\n            ActiveExtensionTabId = tabId;\n            await SendExtensionCommandAsync(new\n            {\n                type = \u0022ATTACH_TAB\u0022,\n                payload = new\n                {\n                    tabId,\n                    focus = focusBrowserTab,\n                    exclusive = detachOtherTabs,\n                    forceReinject = true,\n                    port = _port,\n                    mode = mode == IpcMode.WebSocket ? \u0022ws\u0022 : \u0022http\u0022\n                }\n            }, cancellationToken);\n        }\n\n        /// \u003Csummary\u003E\n        /// Instructs the Chrome Extension to dispose and unhook the automation bridge in \u003Cparamref name=\u0022tabId\u0022/\u003E.\n        /// \u003C/summary\u003E\n        public async Task DetachExtensionTabAsync(int tabId, CancellationToken cancellationToken = default)\n        {\n            DisconnectClient($\u0022tab_{tabId}\u0022);\n            if (ActiveExtensionTabId == tabId)\n            {\n                ActiveExtensionTabId = null;\n            }\n\n            await SendExtensionCommandAsync(new\n            {\n                type = \u0022DETACH_TAB\u0022,\n                payload = new { tabId }\n            }, cancellationToken);\n        }\n\n        /// \u003Csummary\u003E\n        /// Brings the specified browser tab and its window to the foreground in Chrome.\n        /// \u003C/summary\u003E\n        public Task FocusExtensionTabAsync(int tabId, CancellationToken cancellationToken = default)\n        {\n            return SendExtensionCommandAsync(new\n            {\n                type = \u0022FOCUS_TAB\u0022,\n                payload = new { tabId }\n            }, cancellationToken);\n        }\n\n        /// \u003Csummary\u003E\n        /// Requests an immediate refresh of the open tabs list from the Chrome Extension.\n        /// \u003C/summary\u003E\n        public Task RequestExtensionTabsRefreshAsync(CancellationToken cancellationToken = default)\n        {\n            return SendExtensionCommandAsync(new\n            {\n                type = \u0022REFRESH_TABS\u0022\n            }, cancellationToken);\n        }\n\n        private async Task SendExtensionCommandAsync(object command, CancellationToken cancellationToken = default)\n        {\n            var ws = _extensionWebSocket;\n            if (ws != null \u0026\u0026 ws.State == WebSocketState.Open)\n            {\n                var json = JsonSerializer.Serialize(command);\n                var bytes = Encoding.UTF8.GetBytes(json);\n                await _extWsSendLock.WaitAsync(cancellationToken);\n                try\n                {\n                    if (ws.State == WebSocketState.Open)\n                    {\n                        await ws.SendAsync(new ArraySegment\u003Cbyte\u003E(bytes), WebSocketMessageType.Text, true, cancellationToken);\n                        return;\n                    }\n                }\n                catch\n                {\n                    // Fallback to queue if WebSocket send fails\n                }\n                finally\n                {\n                    _extWsSendLock.Release();\n                }\n            }\n\n            _pendingExtensionCommands.Enqueue(command);\n        }\n\n        private void MarkExtensionSeen()\n        {\n            _lastExtensionSeen = DateTime.UtcNow;\n            if (!_wasExtensionConnected)\n            {\n                _wasExtensionConnected = true;\n                OnExtensionConnected?.Invoke(this, EventArgs.Empty);\n            }\n        }\n\n        private void UpdateExtensionTabsFromPayload(JsonElement payload)\n        {\n            MarkExtensionSeen();\n\n            int? activeTabId = null;\n            if (payload.ValueKind == JsonValueKind.Object \u0026\u0026\n                payload.TryGetProperty(\u0022activeAttachedTabId\u0022, out var activeProp) \u0026\u0026\n                activeProp.ValueKind == JsonValueKind.Number \u0026\u0026\n                activeProp.TryGetInt32(out int parsedActive))\n            {\n                activeTabId = parsedActive;\n            }\n\n            JsonElement tabsElement = payload;\n            if (payload.ValueKind == JsonValueKind.Object \u0026\u0026\n                payload.TryGetProperty(\u0022tabs\u0022, out var tabsProp) \u0026\u0026\n                tabsProp.ValueKind == JsonValueKind.Array)\n            {\n                tabsElement = tabsProp;\n            }\n\n            var parsedTabs = new List\u003CBrowserTabInfo\u003E();\n            if (tabsElement.ValueKind == JsonValueKind.Array)\n            {\n                parsedTabs = JsonSerializer.Deserialize\u003CList\u003CBrowserTabInfo\u003E\u003E(tabsElement.GetRawText()) ?? new List\u003CBrowserTabInfo\u003E();\n            }\n\n            lock (_extensionTabsLock)\n            {\n                _extensionTabs = parsedTabs;\n            }\n\n            ActiveExtensionTabId = activeTabId;\n\n            // Synchronize metadata with active extension clients and disconnect closed/detached tabs\n            var openInjectedTabIds = new HashSet\u003Cint\u003E(parsedTabs.Where(t =\u003E t.IsInjected).Select(t =\u003E t.TabId));\n            foreach (var tab in parsedTabs)\n            {\n                if (_clients.TryGetValue(tab.InstanceId, out var existingClient))\n                {\n                    existingClient.TabId = tab.TabId;\n                    if (!string.IsNullOrWhiteSpace(tab.Title))\n                        existingClient.PageTitle = tab.Title;\n                    if (!string.IsNullOrWhiteSpace(tab.Url))\n                        existingClient.CurrentUrl = tab.Url;\n                }\n            }\n\n            var allOpenTabIds = new HashSet\u003Cint\u003E(parsedTabs.Select(t =\u003E t.TabId));\n            foreach (var kvp in _clients.ToArray())\n            {\n                if (kvp.Value.IsExtensionClient \u0026\u0026 kvp.Value.TabId.HasValue)\n                {\n                    int cTabId = kvp.Value.TabId.Value;\n                    if (!allOpenTabIds.Contains(cTabId) || !openInjectedTabIds.Contains(cTabId))\n                    {\n                        DisconnectClient(kvp.Key);\n                    }\n                }\n            }\n\n            OnExtensionTabsUpdated?.Invoke(this, new ExtensionTabsEventArgs(parsedTabs, activeTabId));\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                else if (path.StartsWith(\u0022/api/event/\u0022))\n                {\n                    string instanceId = path.Substring(\u0022/api/event/\u0022.Length);\n                    var client = GetOrAddClient(instanceId, IpcMode.HttpPolling);\n                    client.TouchHttpPolling();\n\n                    using var reader = new StreamReader(request.InputStream);\n                    string body = await reader.ReadToEndAsync(cancellationToken);\n                    var evt = JsonSerializer.Deserialize\u003CEventMessage\u003E(body);\n\n                    if (evt != null)\n                    {\n                        client.HandleEvent(evt);\n                    }\n\n                    await SendJsonAsync(response, new { status = \u0022acknowledged\u0022 });\n                }\n                else\n                {\n                    response.StatusCode = 404;\n                    response.Close();\n                }\n==== REPLACE\n                else if (path.StartsWith(\u0022/api/event/\u0022))\n                {\n                    string instanceId = path.Substring(\u0022/api/event/\u0022.Length);\n                    var client = GetOrAddClient(instanceId, IpcMode.HttpPolling);\n                    client.TouchHttpPolling();\n\n                    using var reader = new StreamReader(request.InputStream);\n                    string body = await reader.ReadToEndAsync(cancellationToken);\n                    var evt = JsonSerializer.Deserialize\u003CEventMessage\u003E(body);\n\n                    if (evt != null)\n                    {\n                        client.HandleEvent(evt);\n                    }\n\n                    await SendJsonAsync(response, new { status = \u0022acknowledged\u0022 });\n                }\n                else if (path.Equals(\u0022/api/ext/status\u0022, StringComparison.OrdinalIgnoreCase))\n                {\n                    MarkExtensionSeen();\n                    await SendJsonAsync(response, new\n                    {\n                        status = \u0022online\u0022,\n                        port = _port,\n                        activeExtensionTabId = ActiveExtensionTabId\n                    });\n                }\n                else if (path.Equals(\u0022/api/ext/tabs\u0022, StringComparison.OrdinalIgnoreCase))\n                {\n                    using var reader = new StreamReader(request.InputStream);\n                    string body = await reader.ReadToEndAsync(cancellationToken);\n                    if (!string.IsNullOrWhiteSpace(body))\n                    {\n                        using var doc = JsonDocument.Parse(body);\n                        UpdateExtensionTabsFromPayload(doc.RootElement);\n                    }\n\n                    var pending = new List\u003Cobject\u003E();\n                    while (_pendingExtensionCommands.TryDequeue(out var cmd))\n                    {\n                        pending.Add(cmd);\n                    }\n\n                    await SendJsonAsync(response, new { status = \u0022ok\u0022, commands = pending });\n                }\n                else if (path.Equals(\u0022/api/ext/select-tab\u0022, StringComparison.OrdinalIgnoreCase))\n                {\n                    using var reader = new StreamReader(request.InputStream);\n                    string body = await reader.ReadToEndAsync(cancellationToken);\n                    if (!string.IsNullOrWhiteSpace(body))\n                    {\n                        using var doc = JsonDocument.Parse(body);\n                        if (doc.RootElement.TryGetProperty(\u0022tabId\u0022, out var tabProp) \u0026\u0026 tabProp.TryGetInt32(out int tabId))\n                        {\n                            bool exclusive = !doc.RootElement.TryGetProperty(\u0022exclusive\u0022, out var exProp) || exProp.ValueKind != JsonValueKind.False;\n                            await SwitchToExtensionTabAsync(tabId, focusBrowserTab: false, detachOtherTabs: exclusive, cancellationToken: cancellationToken);\n                        }\n                    }\n                    await SendJsonAsync(response, new { status = \u0022ok\u0022 });\n                }\n                else if (path.Equals(\u0022/api/ext/detach-tab\u0022, StringComparison.OrdinalIgnoreCase))\n                {\n                    using var reader = new StreamReader(request.InputStream);\n                    string body = await reader.ReadToEndAsync(cancellationToken);\n                    if (!string.IsNullOrWhiteSpace(body))\n                    {\n                        using var doc = JsonDocument.Parse(body);\n                        if (doc.RootElement.TryGetProperty(\u0022tabId\u0022, out var tabProp) \u0026\u0026 tabProp.TryGetInt32(out int tabId))\n                        {\n                            await DetachExtensionTabAsync(tabId, cancellationToken);\n                        }\n                    }\n                    await SendJsonAsync(response, new { status = \u0022ok\u0022 });\n                }\n                else\n                {\n                    response.StatusCode = 404;\n                    response.Close();\n                }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private async Task HandleWebSocketAsync(HttpListenerContext context, CancellationToken cancellationToken)\n        {\n            var wsContext = await context.AcceptWebSocketAsync(null);\n            var webSocket = wsContext.WebSocket;\n            \n            string instanceId = context.Request.QueryString[\u0022instanceId\u0022] ?? Guid.NewGuid().ToString();\n==== REPLACE\n        private async Task HandleExtensionWebSocketAsync(WebSocket webSocket, CancellationToken cancellationToken)\n        {\n            _extensionWebSocket = webSocket;\n            MarkExtensionSeen();\n\n            while (_pendingExtensionCommands.TryDequeue(out var queuedCmd))\n            {\n                await SendExtensionCommandAsync(queuedCmd, cancellationToken);\n            }\n\n            var buffer = new byte[1024 * 64];\n            try\n            {\n                while (webSocket.State == WebSocketState.Open \u0026\u0026 !cancellationToken.IsCancellationRequested)\n                {\n                    using var ms = new MemoryStream();\n                    WebSocketReceiveResult result;\n                    do\n                    {\n                        result = await webSocket.ReceiveAsync(new ArraySegment\u003Cbyte\u003E(buffer), cancellationToken);\n                        if (result.MessageType == WebSocketMessageType.Close)\n                        {\n                            await webSocket.CloseAsync(WebSocketCloseStatus.NormalClosure, \u0022\u0022, cancellationToken);\n                            break;\n                        }\n                        ms.Write(buffer, 0, result.Count);\n                    } while (!result.EndOfMessage);\n\n                    if (result.MessageType == WebSocketMessageType.Close)\n                        break;\n\n                    MarkExtensionSeen();\n                    string message = Encoding.UTF8.GetString(ms.ToArray());\n                    using var doc = JsonDocument.Parse(message);\n                    if (doc.RootElement.TryGetProperty(\u0022event\u0022, out var evtProp) \u0026\u0026\n                        string.Equals(evtProp.GetString(), \u0022EXTENSION_TABS_UPDATED\u0022, StringComparison.OrdinalIgnoreCase) \u0026\u0026\n                        doc.RootElement.TryGetProperty(\u0022payload\u0022, out var payloadProp))\n                    {\n                        UpdateExtensionTabsFromPayload(payloadProp);\n                    }\n                }\n            }\n            catch (Exception ex)\n            {\n                Console.WriteLine($\u0022[AutomationServer] Extension WebSocket error: {ex.Message}\u0022);\n            }\n            finally\n            {\n                if (ReferenceEquals(_extensionWebSocket, webSocket))\n                {\n                    _extensionWebSocket = null;\n                }\n                if (webSocket.State != WebSocketState.Closed \u0026\u0026 webSocket.State != WebSocketState.Aborted)\n                {\n                    webSocket.Dispose();\n                }\n                if (_wasExtensionConnected)\n                {\n                    _wasExtensionConnected = false;\n                    OnExtensionDisconnected?.Invoke(this, EventArgs.Empty);\n                }\n            }\n        }\n\n        private async Task HandleWebSocketAsync(HttpListenerContext context, CancellationToken cancellationToken)\n        {\n            var wsContext = await context.AcceptWebSocketAsync(null);\n            var webSocket = wsContext.WebSocket;\n\n            string? role = context.Request.QueryString[\u0022role\u0022];\n            if (string.Equals(role, \u0022extension\u0022, StringComparison.OrdinalIgnoreCase))\n            {\n                await HandleExtensionWebSocketAsync(webSocket, cancellationToken);\n                return;\n            }\n            \n            string instanceId = context.Request.QueryString[\u0022instanceId\u0022] ?? Guid.NewGuid().ToString();\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.Designer.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n            btnStart = new Button();\n            btnStop = new Button();\n            btnGenerate = new Button();\n            splitMain = new SplitContainer();\n==== REPLACE\n            btnStart = new Button();\n            btnStop = new Button();\n            btnGenerate = new Button();\n            btnExportExtension = new Button();\n            splitMain = new SplitContainer();\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            mnuFileNew = new ToolStripMenuItem();\n            mnuFileOpen = new ToolStripMenuItem();\n            mnuFileSave = new ToolStripMenuItem();\n            mnuFileSeparator = new ToolStripSeparator();\n==== REPLACE\n            mnuFileNew = new ToolStripMenuItem();\n            mnuFileOpen = new ToolStripMenuItem();\n            mnuFileSave = new ToolStripMenuItem();\n            mnuFileExportExtension = new ToolStripMenuItem();\n            mnuFileSeparator = new ToolStripSeparator();\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            pnlTop.Controls.Add(btnStart);\n            pnlTop.Controls.Add(btnStop);\n            pnlTop.Controls.Add(btnGenerate);\n            pnlTop.Dock = DockStyle.Top;\n==== REPLACE\n            pnlTop.Controls.Add(btnStart);\n            pnlTop.Controls.Add(btnStop);\n            pnlTop.Controls.Add(btnGenerate);\n            pnlTop.Controls.Add(btnExportExtension);\n            pnlTop.Dock = DockStyle.Top;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            // \n            // btnGenerate\n            // \n            btnGenerate.AutoSize = true;\n            btnGenerate.Location = new Point(317, 113);\n            btnGenerate.Margin = new Padding(3, 0, 10, 3);\n            btnGenerate.Name = \u0022btnGenerate\u0022;\n            btnGenerate.Padding = new Padding(8, 4, 8, 4);\n            btnGenerate.Size = new Size(229, 46);\n            btnGenerate.TabIndex = 9;\n            btnGenerate.Text = \u0022Generate \u0026\u0026 Copy Script\u0022;\n            btnGenerate.UseVisualStyleBackColor = true;\n            btnGenerate.Click \u002B= BtnGenerate_Click;\n            // \n==== REPLACE\n            // \n            // btnGenerate\n            // \n            btnGenerate.AutoSize = true;\n            btnGenerate.Location = new Point(317, 113);\n            btnGenerate.Margin = new Padding(3, 0, 10, 3);\n            btnGenerate.Name = \u0022btnGenerate\u0022;\n            btnGenerate.Padding = new Padding(8, 4, 8, 4);\n            btnGenerate.Size = new Size(229, 46);\n            btnGenerate.TabIndex = 9;\n            btnGenerate.Text = \u0022Generate \u0026\u0026 Copy Script (TM)\u0022;\n            btnGenerate.UseVisualStyleBackColor = true;\n            btnGenerate.Click \u002B= BtnGenerate_Click;\n            // \n            // btnExportExtension\n            // \n            btnExportExtension.AutoSize = true;\n            btnExportExtension.Location = new Point(559, 113);\n            btnExportExtension.Margin = new Padding(3, 0, 10, 3);\n            btnExportExtension.Name = \u0022btnExportExtension\u0022;\n            btnExportExtension.Padding = new Padding(8, 4, 8, 4);\n            btnExportExtension.Size = new Size(235, 46);\n            btnExportExtension.TabIndex = 10;\n            btnExportExtension.Text = \u0022Export Chrome Extension...\u0022;\n            btnExportExtension.UseVisualStyleBackColor = true;\n            btnExportExtension.Click \u002B= BtnExportExtension_Click;\n            // \n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            // \n            // lstClients\n            // \n            lstClients.BackColor = Color.FromArgb(30, 30, 30);\n            lstClients.BorderStyle = BorderStyle.FixedSingle;\n            lstClients.DisplayMember = \u0022InstanceId\u0022;\n            lstClients.Dock = DockStyle.Fill;\n==== REPLACE\n            // \n            // lstClients\n            // \n            lstClients.BackColor = Color.FromArgb(30, 30, 30);\n            lstClients.BorderStyle = BorderStyle.FixedSingle;\n            lstClients.DisplayMember = \u0022DisplayName\u0022;\n            lstClients.Dock = DockStyle.Fill;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            // \n            // mnuFile\n            // \n            mnuFile.DropDownItems.AddRange(new ToolStripItem[] { mnuFileNew, mnuFileOpen, mnuFileSave, mnuFileSeparator, mnuFileExit });\n            mnuFile.Name = \u0022mnuFile\u0022;\n            mnuFile.Size = new Size(58, 32);\n            mnuFile.Text = \u0022\u0026File\u0022;\n            // \n            // mnuFileNew\n            // \n            mnuFileNew.Name = \u0022mnuFileNew\u0022;\n            mnuFileNew.Size = new Size(240, 36);\n            mnuFileNew.Text = \u0022\u0026New Project\u0022;\n            mnuFileNew.Click \u002B= MnuFileNew_Click;\n            // \n            // mnuFileOpen\n            // \n            mnuFileOpen.Name = \u0022mnuFileOpen\u0022;\n            mnuFileOpen.Size = new Size(240, 36);\n            mnuFileOpen.Text = \u0022\u0026Open Project...\u0022;\n            mnuFileOpen.Click \u002B= MnuFileOpen_Click;\n            // \n            // mnuFileSave\n            // \n            mnuFileSave.Name = \u0022mnuFileSave\u0022;\n            mnuFileSave.Size = new Size(240, 36);\n            mnuFileSave.Text = \u0022\u0026Save Project...\u0022;\n            mnuFileSave.Click \u002B= MnuFileSave_Click;\n==== REPLACE\n            // \n            // mnuFile\n            // \n            mnuFile.DropDownItems.AddRange(new ToolStripItem[] { mnuFileNew, mnuFileOpen, mnuFileSave, mnuFileExportExtension, mnuFileSeparator, mnuFileExit });\n            mnuFile.Name = \u0022mnuFile\u0022;\n            mnuFile.Size = new Size(58, 32);\n            mnuFile.Text = \u0022\u0026File\u0022;\n            // \n            // mnuFileNew\n            // \n            mnuFileNew.Name = \u0022mnuFileNew\u0022;\n            mnuFileNew.Size = new Size(260, 36);\n            mnuFileNew.Text = \u0022\u0026New Project\u0022;\n            mnuFileNew.Click \u002B= MnuFileNew_Click;\n            // \n            // mnuFileOpen\n            // \n            mnuFileOpen.Name = \u0022mnuFileOpen\u0022;\n            mnuFileOpen.Size = new Size(260, 36);\n            mnuFileOpen.Text = \u0022\u0026Open Project...\u0022;\n            mnuFileOpen.Click \u002B= MnuFileOpen_Click;\n            // \n            // mnuFileSave\n            // \n            mnuFileSave.Name = \u0022mnuFileSave\u0022;\n            mnuFileSave.Size = new Size(260, 36);\n            mnuFileSave.Text = \u0022\u0026Save Project...\u0022;\n            mnuFileSave.Click \u002B= MnuFileSave_Click;\n            // \n            // mnuFileExportExtension\n            // \n            mnuFileExportExtension.Name = \u0022mnuFileExportExtension\u0022;\n            mnuFileExportExtension.Size = new Size(260, 36);\n            mnuFileExportExtension.Text = \u0022Export \u0026Chrome Extension...\u0022;\n            mnuFileExportExtension.Click \u002B= BtnExportExtension_Click;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private System.Windows.Forms.Button btnStart;\n        private System.Windows.Forms.Button btnStop;\n        private System.Windows.Forms.Button btnGenerate;\n==== REPLACE\n        private System.Windows.Forms.Button btnStart;\n        private System.Windows.Forms.Button btnStop;\n        private System.Windows.Forms.Button btnGenerate;\n        private System.Windows.Forms.Button btnExportExtension;\n        private System.Windows.Forms.ToolStripMenuItem mnuFileExportExtension;\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n        private bool _domSplittersInitialized;\n        private bool _editorSplittersInitialized;\n        private bool _scraperSplittersInitialized;\n        private bool _revEngSplittersInitialized;\n\n        public MainForm()\n        {\n            InitializeComponent();\n            InitializeScraperTabUi();\n            InitializeReverseEngineeringTabUi();\n            ApplyFixedSingleBorders(this);\n==== REPLACE\n        // Chrome Extension Sidebar Controls\n        private SplitContainer splitLeftSidebar = null!;\n        private GroupBox grpExtensionTabs = null!;\n        private Label lblExtensionStatus = null!;\n        private Button btnSwitchTab = null!;\n        private Button btnDetachTab = null!;\n        private Button btnFocusTab = null!;\n        private Button btnRefreshTabs = null!;\n        private CheckBox chkExclusiveTab = null!;\n        private TextBox txtFilterTabs = null!;\n        private ListBox lstBrowserTabs = null!;\n        private List\u003CBrowserTabInfo\u003E _latestExtensionTabs = new();\n        private bool _isUpdatingBrowserTabsList;\n        private int? _pendingAutoSelectTabId;\n\n        private bool _leftSidebarSplitterInitialized;\n        private bool _domSplittersInitialized;\n        private bool _editorSplittersInitialized;\n        private bool _scraperSplittersInitialized;\n        private bool _revEngSplittersInitialized;\n\n        public MainForm()\n        {\n            InitializeComponent();\n            InitializeExtensionTabsSidebarUi();\n            InitializeScraperTabUi();\n            InitializeReverseEngineeringTabUi();\n            ApplyFixedSingleBorders(this);\n\n            try\n            {\n                string defaultExtDir = ChromeExtensionGenerator.GetDefaultExtensionDirectory();\n                ChromeExtensionGenerator.ExportToDirectory(defaultExtDir, (int)numPort.Value, IpcMode.WebSocket);\n            }\n            catch { }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private async void BtnStart_Click(object sender, EventArgs e)\n        {\n            int port = (int)numPort.Value;\n            _server = new AutomationServer(port);\n            _server.OnClientConnected \u002B= Server_OnClientConnected;\n            _server.OnClientDisconnected \u002B= Server_OnClientDisconnected;\n            _cts = new CancellationTokenSource();\n            \n            Log($\u0022[SYS] Starting Automation Server on port {port}...\u0022, Color.Cyan);\n            btnStart.Enabled = false;\n            btnStop.Enabled = true;\n            numPort.Enabled = false;\n            _clientRefreshTimer.Start();\n==== REPLACE\n        private async void BtnStart_Click(object sender, EventArgs e)\n        {\n            int port = (int)numPort.Value;\n            var selectedMode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;\n\n            try\n            {\n                string defaultExtDir = ChromeExtensionGenerator.GetDefaultExtensionDirectory();\n                ChromeExtensionGenerator.ExportToDirectory(defaultExtDir, port, selectedMode);\n                Log($\u0022[EXT] Synced Chrome Extension files (Port {port}) at: {defaultExtDir}\u0022, Color.MediumSpringGreen);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[WARN] Could not auto-sync default ChromeExtension folder: {ex.Message}\u0022, Color.Orange);\n            }\n\n            _server = new AutomationServer(port);\n            _server.OnClientConnected \u002B= Server_OnClientConnected;\n            _server.OnClientDisconnected \u002B= Server_OnClientDisconnected;\n            _server.OnExtensionConnected \u002B= Server_OnExtensionConnected;\n            _server.OnExtensionDisconnected \u002B= Server_OnExtensionDisconnected;\n            _server.OnExtensionTabsUpdated \u002B= Server_OnExtensionTabsUpdated;\n            _cts = new CancellationTokenSource();\n            \n            Log($\u0022[SYS] Starting Automation Server on port {port}...\u0022, Color.Cyan);\n            btnStart.Enabled = false;\n            btnStop.Enabled = true;\n            numPort.Enabled = false;\n            UpdateExtensionStatusLabel(false, 0);\n            _clientRefreshTimer.Start();\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            btnStart.Enabled = true;\n            btnStop.Enabled = false;\n            numPort.Enabled = true;\n            lstClients.Items.Clear();\n        }\n==== REPLACE\n            btnStart.Enabled = true;\n            btnStop.Enabled = false;\n            numPort.Enabled = true;\n            lstClients.Items.Clear();\n            _latestExtensionTabs.Clear();\n            lstBrowserTabs.Items.Clear();\n            UpdateExtensionStatusLabel(false, 0);\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnGenerate_Click(object sender, EventArgs e)\n        {\n            var project = BuildCurrentProjectFromUi();\n            if (!project.MatchAnySite \u0026\u0026 project.MatchUrls.Count == 0)\n            {\n                Log(\u0022[WARN] No Match URLs provided. Defaulting to match any site.\u0022, Color.Orange);\n            }\n\n            var mode = (IpcMode)cmbMode.SelectedItem!;\n            string script = ScriptGenerator.Generate(project, (int)numPort.Value, mode);\n            Clipboard.SetText(script);\n            Log($\u0022[SYS] Tampermonkey script generated for {mode} and copied to clipboard!\u0022, Color.Lime);\n        }\n==== REPLACE\n        private void BtnGenerate_Click(object sender, EventArgs e)\n        {\n            var project = BuildCurrentProjectFromUi();\n            if (!project.MatchAnySite \u0026\u0026 project.MatchUrls.Count == 0)\n            {\n                Log(\u0022[WARN] No Match URLs provided. Defaulting to match any site.\u0022, Color.Orange);\n            }\n\n            var mode = (IpcMode)cmbMode.SelectedItem!;\n            string script = ScriptGenerator.Generate(project, (int)numPort.Value, mode);\n            Clipboard.SetText(script);\n            Log($\u0022[SYS] Tampermonkey script generated for {mode} and copied to clipboard!\u0022, Color.Lime);\n        }\n\n        private void BtnExportExtension_Click(object? sender, EventArgs e)\n        {\n            string defaultDir = ChromeExtensionGenerator.GetDefaultExtensionDirectory();\n            using var fbd = new FolderBrowserDialog\n            {\n                Description = \u0022Select a folder to export the unpacked BAF Chrome Extension\u0022,\n                UseDescriptionForTitle = true,\n                SelectedPath = System.IO.Directory.Exists(defaultDir) ? defaultDir : string.Empty\n            };\n\n            if (fbd.ShowDialog() == DialogResult.OK \u0026\u0026 !string.IsNullOrWhiteSpace(fbd.SelectedPath))\n            {\n                try\n                {\n                    int port = (int)numPort.Value;\n                    var mode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;\n                    string savedPath = ChromeExtensionGenerator.ExportToDirectory(fbd.SelectedPath, port, mode);\n                    Log($\u0022[EXT] Exported unpacked Chrome Extension (Port {port}, {mode}) to: {savedPath}\u0022, Color.Lime);\n\n                    DarkMessageBox.Show(\n                        this,\n                        $\u0022Chrome Extension exported successfully to:\\n{savedPath}\\n\\n\u0022 \u002B\n                        \u0022To load in Chrome / Edge / Brave:\\n\u0022 \u002B\n                        \u00221. Open chrome://extensions in your browser.\\n\u0022 \u002B\n                        \u00222. Enable \u0027Developer mode\u0027 (top-right toggle).\\n\u0022 \u002B\n                        \u00223. Click \u0027Load unpacked\u0027 and select the exported folder.\\n\\n\u0022 \u002B\n                        \u0022Once loaded, all open browser tabs will appear automatically in the \u0027Chrome Extension - Open Tabs\u0027 panel!\u0022,\n                        \u0022Chrome Extension Exported\u0022,\n                        MessageBoxButtons.OK,\n                        MessageBoxIcon.Information);\n                }\n                catch (Exception ex)\n                {\n                    Log($\u0022[ERR] Failed to export Chrome Extension: {ex.Message}\u0022, Color.Red);\n                }\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            client.OnPageLoaded \u002B= (s, e) =\u003E\n            {\n                if (e.StatusCode == 429)\n                {\n                    Log($\u0022[NAV \u003C- {client.InstanceId}] Page rate-limited (HTTP 429): {e.Url}\u0022, Color.Orange);\n                }\n                else\n                {\n                    Log($\u0022[NAV \u003C- {client.InstanceId}] Page loaded: {e.Url}\u0022, Color.Aqua);\n                }\n            };\n==== REPLACE\n            client.OnPageLoaded \u002B= (s, e) =\u003E\n            {\n                if (e.StatusCode == 429)\n                {\n                    Log($\u0022[NAV \u003C- {client.InstanceId}] Page rate-limited (HTTP 429): {e.Url}\u0022, Color.Orange);\n                }\n                else\n                {\n                    Log($\u0022[NAV \u003C- {client.InstanceId}] Page loaded: {e.Url}\u0022, Color.Aqua);\n                }\n                Invoke(new Action(() =\u003E RefreshClientListItemDisplay(client)));\n            };\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            Invoke(new Action(() =\u003E\n            {\n                if (!lstClients.Items.Cast\u003CBrowserClient\u003E().Any(c =\u003E c.InstanceId == client.InstanceId))\n                {\n                    lstClients.Items.Add(client);\n                    if (lstClients.Items.Count == 1)\n                    {\n                        lstClients.SelectedIndex = 0;\n                    }\n                }\n            }));\n        }\n==== REPLACE\n            Invoke(new Action(() =\u003E\n            {\n                var existing = lstClients.Items.Cast\u003CBrowserClient\u003E().FirstOrDefault(c =\u003E c.InstanceId == client.InstanceId);\n                if (existing == null)\n                {\n                    lstClients.Items.Add(client);\n                    existing = client;\n                }\n\n                if ((_pendingAutoSelectTabId.HasValue \u0026\u0026 client.TabId == _pendingAutoSelectTabId.Value) ||\n                    lstClients.Items.Count == 1)\n                {\n                    if (_pendingAutoSelectTabId.HasValue \u0026\u0026 client.TabId == _pendingAutoSelectTabId.Value)\n                    {\n                        _pendingAutoSelectTabId = null;\n                    }\n                    lstClients.SelectedItem = existing;\n                }\n            }));\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void EnsureTabSplittersConfigured()\n        {\n            try\n            {\n                if (tabMain.SelectedTab == tabDom \u0026\u0026 !_domSplittersInitialized \u0026\u0026 splitDom.Width \u003E 200)\n==== REPLACE\n        private void InitializeExtensionTabsSidebarUi()\n        {\n            var darkBg = Color.FromArgb(30, 30, 30);\n            int padX = ScaleDpi(5);\n            int padY = ScaleDpi(2);\n            int btnMargin = ScaleDpi(2);\n\n            splitLeftSidebar = new SplitContainer\n            {\n                Dock = DockStyle.Fill,\n                Orientation = Orientation.Horizontal,\n                Size = new Size(300, 440)\n            };\n\n            grpExtensionTabs = new GroupBox\n            {\n                Dock = DockStyle.Fill,\n                Text = \u0022Chrome Extension - Open Tabs\u0022,\n                Padding = new Padding(ScaleDpi(8), ScaleDpi(6), ScaleDpi(8), ScaleDpi(8)),\n                ForeColor = Color.LightGray\n            };\n\n            var pnlExtTop = new TableLayoutPanel\n            {\n                Dock = DockStyle.Top,\n                AutoSize = true,\n                AutoSizeMode = AutoSizeMode.GrowAndShrink,\n                ColumnCount = 1,\n                RowCount = 4,\n                Padding = new Padding(0, 0, 0, ScaleDpi(4))\n            };\n            pnlExtTop.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100F));\n            for (int i = 0; i \u003C 4; i\u002B\u002B)\n            {\n                pnlExtTop.RowStyles.Add(new RowStyle(SizeType.AutoSize));\n            }\n\n            lblExtensionStatus = new Label\n            {\n                Text = \u0022Extension: Waiting for connection...\u0022,\n                AutoSize = true,\n                ForeColor = Color.Orange,\n                Margin = new Padding(0, 0, 0, ScaleDpi(4))\n            };\n\n            var flpExtBtns = new FlowLayoutPanel\n            {\n                Dock = DockStyle.Fill,\n                AutoSize = true,\n                AutoSizeMode = AutoSizeMode.GrowAndShrink,\n                WrapContents = true,\n                Margin = new Padding(0, 0, 0, ScaleDpi(2))\n            };\n\n            btnSwitchTab = CreateToolbarButton(\u0022Inject / Switch\u0022, padX, padY, btnMargin);\n            btnDetachTab = CreateToolbarButton(\u0022Detach\u0022, padX, padY, btnMargin);\n            btnFocusTab = CreateToolbarButton(\u0022Focus Tab\u0022, padX, padY, btnMargin);\n            btnRefreshTabs = CreateToolbarButton(\u0022Refresh\u0022, padX, padY, btnMargin);\n\n            btnSwitchTab.Click \u002B= BtnSwitchTab_Click;\n            btnDetachTab.Click \u002B= BtnDetachTab_Click;\n            btnFocusTab.Click \u002B= BtnFocusTab_Click;\n            btnRefreshTabs.Click \u002B= BtnRefreshTabs_Click;\n\n            flpExtBtns.Controls.AddRange(new Control[]\n            {\n                btnSwitchTab, btnDetachTab, btnFocusTab, btnRefreshTabs\n            });\n\n            chkExclusiveTab = new CheckBox\n            {\n                Text = \u0022Auto-switch (single active tab)\u0022,\n                Checked = true,\n                AutoSize = true,\n                Margin = new Padding(0, ScaleDpi(2), 0, ScaleDpi(4))\n            };\n\n            txtFilterTabs = new TextBox\n            {\n                Dock = DockStyle.Fill,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                PlaceholderText = \u0022Filter open tabs by title or URL...\u0022,\n                Margin = new Padding(0)\n            };\n            txtFilterTabs.TextChanged \u002B= (s, e) =\u003E RefreshBrowserTabsListUi();\n\n            pnlExtTop.Controls.Add(lblExtensionStatus, 0, 0);\n            pnlExtTop.Controls.Add(flpExtBtns, 0, 1);\n            pnlExtTop.Controls.Add(chkExclusiveTab, 0, 2);\n            pnlExtTop.Controls.Add(txtFilterTabs, 0, 3);\n\n            lstBrowserTabs = new ListBox\n            {\n                Dock = DockStyle.Fill,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                BorderStyle = BorderStyle.FixedSingle,\n                IntegralHeight = false\n            };\n            lstBrowserTabs.SelectedIndexChanged \u002B= LstBrowserTabs_SelectedIndexChanged;\n\n            grpExtensionTabs.Controls.Add(lstBrowserTabs);\n            grpExtensionTabs.Controls.Add(pnlExtTop);\n\n            pnlClients.Text = \u0022Connected Clients (Active \u0026\u0026 Legacy TM)\u0022;\n\n            splitTop.Panel1.Controls.Remove(pnlClients);\n            splitLeftSidebar.Panel1.Controls.Add(grpExtensionTabs);\n            splitLeftSidebar.Panel2.Controls.Add(pnlClients);\n            splitTop.Panel1.Controls.Add(splitLeftSidebar);\n        }\n\n        private void RefreshClientListItemDisplay(BrowserClient client)\n        {\n            for (int i = 0; i \u003C lstClients.Items.Count; i\u002B\u002B)\n            {\n                if (lstClients.Items[i] is BrowserClient item \u0026\u0026 item.InstanceId == client.InstanceId)\n                {\n                    lstClients.Items[i] = item;\n                    break;\n                }\n            }\n        }\n\n        private void UpdateExtensionStatusLabel(bool connected, int tabCount)\n        {\n            if (InvokeRequired)\n            {\n                Invoke(new Action(() =\u003E UpdateExtensionStatusLabel(connected, tabCount)));\n                return;\n            }\n\n            if (connected)\n            {\n                lblExtensionStatus.Text = $\u0022Extension: Connected ({tabCount} open tab{(tabCount == 1 ? \u0022\u0022 : \u0022s\u0022)})\u0022;\n                lblExtensionStatus.ForeColor = Color.LimeGreen;\n            }\n            else\n            {\n                lblExtensionStatus.Text = _server != null\n                    ? \u0022Extension: Waiting for connection...\u0022\n                    : \u0022Extension: Server stopped\u0022;\n                lblExtensionStatus.ForeColor = Color.Orange;\n            }\n        }\n\n        private void Server_OnExtensionConnected(object? sender, EventArgs e)\n        {\n            Log(\u0022[EXT] Chrome Extension connected to Automation Server!\u0022, Color.LimeGreen);\n            UpdateExtensionStatusLabel(true, _latestExtensionTabs.Count);\n        }\n\n        private void Server_OnExtensionDisconnected(object? sender, EventArgs e)\n        {\n            Log(\u0022[EXT] Chrome Extension disconnected.\u0022, Color.Orange);\n            UpdateExtensionStatusLabel(false, 0);\n        }\n\n        private void Server_OnExtensionTabsUpdated(object? sender, ExtensionTabsEventArgs e)\n        {\n            if (InvokeRequired)\n            {\n                Invoke(new Action(() =\u003E Server_OnExtensionTabsUpdated(sender, e)));\n                return;\n            }\n\n            _latestExtensionTabs = e.Tabs.ToList();\n            UpdateExtensionStatusLabel(true, _latestExtensionTabs.Count);\n            RefreshBrowserTabsListUi();\n\n            foreach (BrowserClient client in lstClients.Items.Cast\u003CBrowserClient\u003E().ToList())\n            {\n                RefreshClientListItemDisplay(client);\n            }\n        }\n\n        private void RefreshBrowserTabsListUi()\n        {\n            _isUpdatingBrowserTabsList = true;\n            lstBrowserTabs.BeginUpdate();\n            try\n            {\n                int? prevSelectedTabId = (lstBrowserTabs.SelectedItem as BrowserTabInfo)?.TabId ?? _server?.ActiveExtensionTabId;\n                string filter = txtFilterTabs.Text.Trim();\n\n                lstBrowserTabs.Items.Clear();\n                BrowserTabInfo? itemToSelect = null;\n\n                foreach (var tab in _latestExtensionTabs)\n                {\n                    if (!string.IsNullOrEmpty(filter))\n                    {\n                        bool matches = tab.Title.Contains(filter, StringComparison.OrdinalIgnoreCase) ||\n                                       tab.Url.Contains(filter, StringComparison.OrdinalIgnoreCase) ||\n                                       tab.TabId.ToString().Contains(filter, StringComparison.OrdinalIgnoreCase);\n                        if (!matches)\n                            continue;\n                    }\n\n                    lstBrowserTabs.Items.Add(tab);\n                    if (prevSelectedTabId.HasValue \u0026\u0026 tab.TabId == prevSelectedTabId.Value)\n                    {\n                        itemToSelect = tab;\n                    }\n                }\n\n                if (itemToSelect != null)\n                {\n                    lstBrowserTabs.SelectedItem = itemToSelect;\n                }\n            }\n            finally\n            {\n                lstBrowserTabs.EndUpdate();\n                _isUpdatingBrowserTabsList = false;\n            }\n        }\n\n        private async void LstBrowserTabs_SelectedIndexChanged(object? sender, EventArgs e)\n        {\n            if (_isUpdatingBrowserTabsList) return;\n            if (lstBrowserTabs.SelectedItem is not BrowserTabInfo selectedTab) return;\n\n            var currentClient = lstClients.SelectedItem as BrowserClient;\n            if (selectedTab.IsInjected \u0026\u0026 currentClient != null \u0026\u0026 currentClient.TabId == selectedTab.TabId \u0026\u0026 !chkExclusiveTab.Checked)\n            {\n                return;\n            }\n\n            await SwitchToBrowserTabAsync(selectedTab, focusBrowserTab: false);\n        }\n\n        private async void BtnSwitchTab_Click(object? sender, EventArgs e)\n        {\n            if (lstBrowserTabs.SelectedItem is not BrowserTabInfo selectedTab)\n            {\n                Log(\u0022[WARN] Please select a browser tab from the Chrome Extension tabs list first.\u0022, Color.Orange);\n                return;\n            }\n\n            await SwitchToBrowserTabAsync(selectedTab, focusBrowserTab: false);\n        }\n\n        private async Task SwitchToBrowserTabAsync(BrowserTabInfo tab, bool focusBrowserTab)\n        {\n            if (_server == null)\n            {\n                Log(\u0022[WARN] Start the Automation Server first.\u0022, Color.Orange);\n                return;\n            }\n\n            if (!tab.CanInject)\n            {\n                Log($\u0022[WARN] Tab #{tab.TabId} (\u0027{tab.Url}\u0027) is a restricted internal browser page and cannot be injected.\u0022, Color.Orange);\n                return;\n            }\n\n            var mode = cmbMode.SelectedItem is IpcMode m ? m : IpcMode.WebSocket;\n            bool detachOthers = chkExclusiveTab.Checked;\n            _pendingAutoSelectTabId = tab.TabId;\n\n            Log($\u0022[EXT] Injecting \u0026 switching to Tab #{tab.TabId}: {tab.Title} ({tab.Url})\u0022, Color.SpringGreen);\n\n            var existingClient = lstClients.Items.Cast\u003CBrowserClient\u003E().FirstOrDefault(c =\u003E c.TabId == tab.TabId || c.InstanceId == tab.InstanceId);\n            if (existingClient != null)\n            {\n                lstClients.SelectedItem = existingClient;\n            }\n\n            try\n            {\n                await _server.SwitchToExtensionTabAsync(tab.TabId, focusBrowserTab, detachOthers, mode);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to switch to tab #{tab.TabId}: {ex.Message}\u0022, Color.Red);\n            }\n        }\n\n        private async void BtnDetachTab_Click(object? sender, EventArgs e)\n        {\n            if (_server == null) return;\n            if (lstBrowserTabs.SelectedItem is not BrowserTabInfo selectedTab)\n            {\n                Log(\u0022[WARN] Please select a tab to detach.\u0022, Color.Orange);\n                return;\n            }\n\n            Log($\u0022[EXT] Detaching automation bridge from Tab #{selectedTab.TabId}...\u0022, Color.Yellow);\n            try\n            {\n                await _server.DetachExtensionTabAsync(selectedTab.TabId);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to detach tab: {ex.Message}\u0022, Color.Red);\n            }\n        }\n\n        private async void BtnFocusTab_Click(object? sender, EventArgs e)\n        {\n            if (_server == null) return;\n            if (lstBrowserTabs.SelectedItem is not BrowserTabInfo selectedTab)\n            {\n                Log(\u0022[WARN] Please select a tab to focus in Chrome.\u0022, Color.Orange);\n                return;\n            }\n\n            try\n            {\n                await _server.FocusExtensionTabAsync(selectedTab.TabId);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to focus tab: {ex.Message}\u0022, Color.Red);\n            }\n        }\n\n        private async void BtnRefreshTabs_Click(object? sender, EventArgs e)\n        {\n            if (_server == null) return;\n            try\n            {\n                await _server.RequestExtensionTabsRefreshAsync();\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to refresh tabs: {ex.Message}\u0022, Color.Red);\n            }\n        }\n\n        private void EnsureTabSplittersConfigured()\n        {\n            try\n            {\n                if (!_leftSidebarSplitterInitialized \u0026\u0026 splitLeftSidebar != null \u0026\u0026 splitLeftSidebar.Height \u003E 220)\n                {\n                    _leftSidebarSplitterInitialized = true;\n                    splitLeftSidebar.SplitterDistance = Math.Clamp(\n                        (int)(splitLeftSidebar.Height * 0.58),\n                        ScaleDpi(180),\n                        Math.Max(ScaleDpi(190), splitLeftSidebar.Height - ScaleDpi(120)));\n                }\n\n                if (tabMain.SelectedTab == tabDom \u0026\u0026 !_domSplittersInitialized \u0026\u0026 splitDom.Width \u003E 200)\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
