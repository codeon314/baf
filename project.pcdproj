ateFromOutput(BrowserClient client, string? output)        {            if (string.IsNullOrWhiteSpace(output))                return;            try            {                using var doc = JsonDocument.Parse(output);                if (doc.RootElement.ValueKind == JsonValueKind.Object)                {                    string pageLoadId = doc.RootElement.TryGetProperty(\u0022pageLoadId\u0022, out var idProp) ? (idProp.GetString() ?? string.Empty) : string.Empty;                    string url = doc.RootElement.TryGetProperty(\u0022url\u0022, out var urlProp) ? (urlProp.GetString() ?? string.Empty) : string.Empty;                    string readyState = doc.RootElement.TryGetProperty(\u0022readyState\u0022, out var rsProp) ? (rsProp.GetString() ?? \u0022complete\u0022) : \u0022complete\u0022;                    if (!string.IsNullOrEmpty(pageLoadId) || !string.IsNullOrEmpty(url))                    {                        client.HandleEvent(new EventMessage                        {                            Event = \u0022PAGE_LOADED\u0022,                            Payload = doc.RootElement.Clone()                        });                    }                }            }            catch { }        }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Automation\\AutomationRunner.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH        private void RegisterDefaultHandlers()        {            RegisterStepHandler(AutomationActionType.Click, (client, step, ct) =\u003E                client.ClickReactElementAsync(step.Selector, ct)!);            RegisterStepHandler(AutomationActionType.SetValue, (client, step, ct) =\u003E                client.SetReactInputValueAsync(step.Selector, step.Value, step.Overwrite, ct)!);            RegisterStepHandler(AutomationActionType.EvaluateScript, (client, step, ct) =\u003E                client.EvaluateJavaScriptAsync(step.Value, ct)!);==== RE