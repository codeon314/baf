 BrowserAutomationFramework.Automation;using BrowserAutomationFramework.Models;using BrowserAutomationFramework.Scraping;using BrowserAutomationFramework.Server;namespace BrowserAutomationFramework.Extensions{    public static class ReactExtensions    {        /// \u003Csummary\u003E        /// Locates an element via CSS selector and simulates a trusted React or native click event.        /// \u003C/summary\u003E        public static Task\u003CCommandResult\u003E ClickReactElementAsync(this BrowserClient client, string selector, CancellationToken cancellationToken = default)        {            return client.SendCommandAsync(\u0022REACT_CLICK\u0022, new { selector }, cancellationToken);        }        /// \u003Csummary\u003E        /// Navigates the browser tab to the specified URL and waits until the new page has completely loaded.        /// \u003C/summary\u003E        public static async Task\u003CCommandResult\u003E NavigateToUrlAsync(            this BrowserClient client,            string url,            int timeoutMs = 30000,            CancellationToken cancellationToken = default)        {            if (string.IsNullOrWhiteSpace(url))                throw new ArgumentException(\u0022URL cannot be empty.\u0022, nameof(url));            string? beforeLoadId = client.CurrentPageLoadId;            var navResult = await client.SendCommandAsync(\u0022NAVIGATE\u0022, new { url }, cancellationToken);            if (!string.IsNullOrWhiteSpace(navResult.Output))            {                try                {                    using var doc = JsonDocument.Parse(navResult.Output);                    if (doc.RootElement.ValueKind == JsonValueKind.Object \u0026\u0026                        doc.RootElement.TryGetProperty(\u0022previousPageLoadId\u0022, out var prevProp) \u0026\u0026                        prevProp.ValueKind == JsonValueKind.String)                    {                        beforeLoadId = prevProp.GetString() ?? beforeLoadId;                    }                }                catch { }            }            await client.WaitForPageTransitionAsync(beforeLoadId, expectNavigation: true, timeoutMs: timeoutMs, cancellationToken: cancellationToken);            return navResult;        }        /// \u003Csummary\u003E        /// Waits until the current page reports \u003Cc\u003Edocument.readyState === \u0027complete\u0027\u003C/c\u003E.        /// \u003C/summary\u003E        public static async Task\u003CCommandResult\u003E WaitForPageLoadAsync(            this BrowserClient client,            int timeoutMs = 30000,            CancellationToken cancellationToken = default)        {            var res = await client.SendCommandAsync(\u0022WAIT_FOR_PAGE_LOAD\u0022, new { timeoutMs }, cancellationToken);            UpdateClientPageStateFromOutput(client, res.Output);            return res;        }        /// \u003Csummary\u003E        /// Waits for a page navigation or in-page transition to complete and ensures the entire page is loaded before returning.        /// \u003C/summary\u003E        public static async Task WaitForPageTransitionAsync(            this BrowserClient client,            string? previousPageLoadId,            bool expectNavigation = true,            int timeoutMs = 30000,            CancellationToken cancellationToken = default)        {            var pageLoadedTcs = new TaskCompletionSource\u003CPageLoadedEventArgs\u003E(TaskCreationOptions.RunContinuationsAsynchronously);            void OnLoaded(object? sender, PageLoadedEventArgs e)            {                if (string.IsNullOrEmpty(previousPageLoadId) || !string.Equals(e.PageLoadId, previousPageLoadId, StringComparison.Ordinal))                {                    pageLoadedTcs.TrySetResult(e);                }            }            client.OnPageLoaded \u002B= OnLoaded;            try            {                // Allow time for navigation/unload to begin                await Task.Delay(150, cancellationToken);                if (ex