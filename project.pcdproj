t p = 0; p \u003C suffixParts.Length; p\u002B\u002B)                {                    int w = suffixWidths[p];                    if (curX \u002B w \u003E= viewportLeft)                    {                        yield return new DomTokenRenderSlice                        {                            Text = suffixParts[p].Text,                            ColorType = suffixParts[p].ColorType,                            X = curX,                            Y = rowLayout.TextY                        };                    }                    curX \u002B= w;                    if (curX \u003E viewportRight)                        yield break;                }            }        }\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        /// \u003Csummary\u003E        /// Determines whether the horizontal coordinate \u003Cparamref name=\u0022x\u0022/\u003E falls within the expand/collapse glyph box of \u003Cparamref name=\u0022item\u0022/\u003E.        /// \u003C/summary\u003E==== REPLACE        /// \u003Csummary\u003E        /// Processes a pointer-down interaction at \u003Cc\u003E(x, y)\u003C/c\u003E, toggling node expansion if the left button hit an expand glyph or selecting the hit row.        /// \u003C/summary\u003E        public bool HandlePointerDown(            int x,            int y,            bool isLeftButton,            int viewportLeft,            int viewportTop,            int viewportHeight,            int paddingLeft,            int indentWidth,            int glyphColumnWidth,            int itemHeight,            out DomTreeItem? hitItem,            out bool expansionToggled,            out bool selectionChanged)        {            hitItem = null;            expansionToggled = false;            selectionChanged = false;            int rowIndex = GetRowIndexAtY(y, viewportTop, viewportHeight, ScrollY, itemHeight);            if (rowIndex \u003C 0)                return false;            hitItem = _visibleRows[rowIndex];            if (isLeftButton \u0026\u0026 IsPointOnExpandGlyph(hitItem, x, viewportLeft, paddingLeft, indentWidth, glyphColumnWidth, ScrollX))            {                expansionToggled = ToggleExpansion(hitItem);                return true;            }            SelectRow(rowIndex, out hitItem, out selectionChanged);            return true;        }        /// \u003Csummary\u003E        /// Processes a pointer double-click interaction at \u003Cc\u003E(x, y)\u003C/c\u003E, toggling expansion if a parent row was double-clicked outside its expand glyph.        /// \u003C/summary\u003E        public bool HandlePointerDoubleClick(            int x,            int y,            bool isLeftButton,            int viewportLeft,            int viewportTop,            int viewportHeight,            int paddingLeft,            int indentWidth,            int glyphColumnWidth,            int itemHeight)        {            if (!isLeftButton)                return false;            int rowIndex = GetRowIndexAtY(y, viewportTop, viewportHeight, ScrollY, itemHeight);            if (rowIndex \u003C 0 || rowIndex \u003E= _visibleRows.Count)                return false;            var item = _visibleRows[rowIndex];            if (!IsPointOnExpandGlyph(item, x, viewportLeft, paddingLeft, indentWidth, glyphColumnWidth, ScrollX) \u0026\u0026 item.HasChildren)            {                return ToggleExpansion(item);            }            return false;        }        /// \u003Csummary\u003E        /// Processes a keyboard navigation command (\u003Csee cref=\u0022DomTreeNavigationKey\u0022/\u003E), updating node expansion, row selection, and viewport scroll offsets.        /// \u003C/summary\u003E        public bool NavigateByKey(            DomTreeNavigationKey key,            int viewportWidth,            int viewportHeight,            int itemHeight,            int paddingLeft,            int indentWidth,            int minVisibleTextWidth,            int horizontalScrollMargin,            out DomTreeItem? selectedItem,            out bool expandedChanged,            out bool selectionChanged,            out bool scrollChanged)        {            selectedItem = null;            expandedChanged = false;            selectionChanged = false;            scrollChanged = false;            int rowCount = _visibleRows.Count;            if (rowCount == 0)                return false;            int currentRow = GetCurrentOrFirstRowIndex();            int pageRows = Math.Max(1, itemHeight \u003E 0 ? viewportHeight / itemHeight : 1);            int? targetRow = null;            switch (key)            {                case DomTreeNavigationKey.Down:                    if (currentRow \u003C rowCount - 1)                        targetRow = currentRow \u002B 1;                    break;                case DomTreeNavigationKey.Up:                    if (currentRow \u003E 0)                        targetRow = currentRow - 1;                    break;                case DomTreeNavigationKey.PageDown:                    targetRow = Math.Min(rowCount - 1, currentRow \u002B pageRows);                    break;                case DomTreeNavigationKey.PageUp:                    targetRow = Math.Max(0, currentRow - pageRows);                    break;                case DomTreeNavigationKey.Home:                    targetRow = 0;                    break;                case DomTreeNavigationKey.End:                    targetRow = rowCount - 1;                    break;                case DomTreeNavigationKey.Right:                    NavigateRight(out expandedChanged, out targetRow);                    break;                case DomTreeNavigationKey.Left:                    NavigateLeft(out expandedChanged, out targetRow);                    break;                default:                    return false;            }            if (targetRow.HasValue \u0026\u0026 SelectRow(targetRow.Value, out selectedItem, out selectionChanged))            {                scrollChanged = EnsureRowVisible(                    targetRow.Value,                    viewportWidth,                    viewportHeight,                    itemHeight,                    paddingLeft,                    indentWidth,                    minVisibleTextWidth,                    horizontalScrollMargin,                    centerVertically: false);            }            return true;        }        /// \u003Csummary\u003E        /// Determines whether the horizontal coordinate \u003Cparamref name=\u0022x\u0022/\u003E falls within the expand/collapse glyph box of \u003Cparamref name=\u0022item\u0022/\u003E.        /// \u003C/summary\u003E\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Automation\\AutomationRunner.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH        /// \u003Csummary\u003E        /// Raised when an \u003Csee cref=\u0022AutomationActionType.DumpSite\u0022/\u003E step finishes dumping site resources.        /// \u003C/summary\u003E        public event EventHandler\u003CSiteDumpEventArgs\u003E? OnSiteDumpCompleted;        /// \u003Csummary\u003E        /// Initializes a new instance of the \u003Csee cref=\u0022AutomationRunner\u0022/\u003E class with all built-in step handlers registered.        /// \u003C/summary\u003E        public AutomationRunner()        {            RegisterDefaultHandlers();        }        private void RegisterDefaultHandlers()        {==== REPLACE        /// \u003Csummary\u003E        /// Raised when an \u003Csee cref=\u0022AutomationActionType.DumpSite\u0022/\u003E step finishes dumping site resources.        /// \u003C/summary\u003E        public event EventHandler\u003CSiteDumpEventArgs\u003E? OnSiteDumpCompleted;        /// \u003Csummary\u003E        /// Gets the \u003Csee cref=\u0022DataScraper\u0022/\u003E instance used by this runner when executing \u003Csee cref=\u0022AutomationActionType.Scrape\u0022/\u003E steps.        /// \u003C/summa