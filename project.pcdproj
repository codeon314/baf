          throw new ArgumentException(\u0022Directory path cannot be empty.\u0022, nameof(directoryPath));            Directory.CreateDirectory(directoryPath);            // 1. Save HTML            if (HtmlResources.Count \u003E 0 || !string.IsNullOrEmpty(Html))            {                string mainHtml = !string.IsNullOrEmpty(Html) ? Html : (HtmlResources[0].Content ?? string.Empty);                File.WriteAllText(Path.Combine(directoryPath, \u0022index.html\u0022), mainHtml, Encoding.UTF8);                if (HtmlResources.Count \u003E 1)                {                    string htmlDir = Path.Combine(directoryPath, \u0022html\u0022);                    Directory.CreateDirectory(htmlDir);                    var usedNames = new HashSet\u003Cstring\u003E(StringComparer.OrdinalIgnoreCase);                    foreach (var item in HtmlResources)                    {                        string fileName = EnsureUniqueFileName(SanitizeFileName(item.Name, $\u0022document-{item.Index}.html\u0022), usedNames);                        File.WriteAllText(Path.Combine(htmlDir, fileName), item.Content ?? string.Empty, Encoding.UTF8);                    }                }            }            // 2. Save CSS            if (CssResources.Count \u003E 0)            {                string cssDir = Path.Combine(directoryPath, \u0022css\u0022);                Directory.CreateDirectory(cssDir);                var usedNames = new HashSet\u003Cstring\u003E(StringComparer.OrdinalIgnoreCase);                foreach (var item in CssResources)                {                    string fileName = EnsureUniqueFileName(SanitizeFileName(item.Name, $\u0022style-{item.Index}.css\u0022), usedNames);                    File.WriteAllText(Path.Combine(cssDir, fileName), item.Content ?? string.Empty, Encoding.UTF8);                }                if (includeCombinedFiles)                {                    File.WriteAllText(Path.Combine(directoryPath, \u0022combined.css\u0022), GetCombinedCss(), Encoding.UTF8);                }            }            // 3. Save JavaScript            if (JavaScriptResources.Count \u003E 0)            {                string jsDir = Path.Combine(directoryPath, \u0022js\u0022);                Directory.CreateDirectory(jsDir);                var usedNames = new HashSet\u003Cstring\u003E(StringComparer.OrdinalIgnoreCase);                foreach (var item in JavaScriptResources)                {                    string fileName = EnsureUniqueFileName(SanitizeFileName(item.Name, $\u0022script-{item.Index}.js\u0022), usedNames);                    File.WriteAllText(Path.Combine(jsDir, fileName), item.Content ?? string.Empty, Encoding.UTF8);                }                if (includeCombinedFiles)                {                    File.WriteAllText(Path.Combine(directoryPath, \u0022combined.js\u0022), GetCombinedJavaScript(), Encoding.UTF8);                }            }            // 4. Save Manifest            if (includeManifest)            {                var manifest = new                {                    dumpType = DumpType.ToString(),                    pageUrl = PageUrl,                    pageTitle = PageTitle,                    timestampUtc = TimestampUtc,                    totalResources = TotalResourceCount,                    totalSizeBytes = TotalSizeBytes,                    resources = GetAllResources().Select(r =\u003E new                    {                        r.Index,                        r.Name,                        Category = r.Category.ToString(),                        r.SourceType,                        r.Url,                        r.SizeBytes,                        r.Error                    }).ToList()                };                string manifestJson = JsonSerializer.Serialize(manifest, new JsonSerializerOptions { WriteIndented = true });                File.WriteAllText(Path.Combine(directoryPath, \u0022manifest.json\u0022), manifestJson, Encoding.UTF8);            }            return directoryPath;        }        /// \u003Csummary\u003E        /// Asynchronously writes all dumped HTML, CSS, and JavaScript resources into \u003Cparamref name=\u0022directoryPath\u0022/\u003E.        /// \u003C/summary\u003E        public async Task\u003Cstring\u003E SaveToDirectoryAsync(            string directoryPath,            bool includeCombinedFiles = true,            bool includeManifest = true,            CancellationToken cancellationToken = default)        {            if (string.IsNullOrWhiteSpace(directoryPath))                throw new ArgumentException(\u0022Directory path cannot be empty.\u0022, nameof(directoryPath));            Directory.CreateDirectory(directoryPath);            if (HtmlResources.Count \u003E 0 || !string.IsNullOrEmpty(Html))            {                string mainHtml = !string.IsNullOrEmpty(Html) ? Html : (HtmlResources[0].Content ?? string.Empty);                await File.WriteAllTextAsync(Path.Combine(directoryPath, \u0022index.html\u0022), mainHtml, Encoding.UTF8, cancellationToken);                if (HtmlResources.Count \u003E 1)                {                    string htmlDir = Path.Combine(directoryPath, \u0022html\u0022);                    Directory.CreateDirectory(htmlDir);                    var usedNames = new HashSet\u003Cstring\u003E(StringComparer.OrdinalIgnoreCase);                    foreach (var item in HtmlResources)                    {                        string fileName = EnsureUniqueFileName(SanitizeFileName(item.Name, $\u0022document-{item.Index}.html\u0022), usedNames);                        await File.WriteAllTextAsync(Path.Combine(htmlDir, fileName), item.Content ?? string.Empty, Encoding.UTF8, cancellationToken);                    }                }            }            if (CssResources.Count \u003E 0)            {                string cssDir = Path.Combine(directoryPath, \u0022css\u0022);                Directory.CreateDirectory(cssDir);                var usedNames = new HashSet\u003Cstring\u003E(StringComparer.OrdinalIgnoreCase);                foreach (var item in CssResources)                {                    string fileName = EnsureUniqueFileName(SanitizeFileName(item.Name, $\u0022style-{item.Index}.css\u0022), usedNames);                    await File.WriteAllTextAsync(Path.Combine(cssDir, fileName), item.Content ?? string.Empty, Encoding.UTF8, cancellationToken);                }                if (includeCombinedFiles)                {                    await File.WriteAllTextAsync(Path.Combine(directoryPath, \u0022combined.css\u0022), GetCombinedCss(), Encoding.UTF8, cancellationToken);                }            }            if (JavaScriptResources.Count \u003E 0)            {                string jsDir = Path.Combine(directoryPath, \u0022js\u0022);                Directory.CreateDirectory(jsDir);                var usedNames = new HashSet\u003Cstring\u003E(StringComparer.OrdinalIgnoreCase);                foreach (var item in JavaScriptResources)                {                    string fileName = EnsureUniqueFileName(SanitizeFileName(item.Name, $\u0022script-{item.Index}.js\u0022), usedNames);                    await File.WriteAllTextAsync(Path.Combine(jsDir, fileName), item.Content ?? string.Empty, Encoding.UTF8, cancellationToken);                }                if (includeCombinedFiles)                {                    await File.WriteAllTextAsync(Path.Combine(directoryPath, \u0022combined.js\u0022), GetCombinedJavaScript(), Encoding.UTF8, cancellationToken);                }            }            if (includeManifest)            {                var manifest = new                {                    dumpType = DumpType.ToString(),                    pageUrl = PageUrl,                    pageTitle = PageTitle,                    timestampUtc = TimestampUtc,                    totalResources = TotalResourceCount,                    totalSizeBytes = TotalSizeBytes,                    resources = GetAllResources().Select(r =\u003E new                    {                        r.Index,                        r.Name,                        Category = r.Category.ToString(),                        r.SourceType,                        r.Url,                        r.SizeBytes,                        r.Error                    }).ToList()                };                string manifestJson = JsonSerializer.Serialize(manifest, new JsonSerializerOptions { WriteIndented = true });                await File.WriteAllTextAsync(Path.Combine(directoryPath, \u0022manifest.json\u0022), manifestJson, Encoding.UTF8, cancellationToken);            }            return directoryPath;        }        private static string SanitizeFileName(string? rawName, string fallback)        {            if (string.IsNullOrWhiteSpace(rawName))                return fallback;            var invalidChars = Path.GetInvalidFileNameChars();            var sb = new StringBuilder(rawName.Length);            foreach (char c in rawName.Trim())            {                sb.Append(Array.IndexOf(invalidChars, c) \u003E= 0 ? \u0027_\u0027 : c);            }            string cleaned = sb.ToString().Trim(\u0027.\u0027);            if (string.IsNullOrWhiteSpace(cleaned))                return fallback;            if (cleaned.Length \u003E 100)            {                string ext = Path.GetExtension(cleaned);                string baseName = Path.GetFileNameWithoutExtension(cleaned);                cleaned = baseName.Substring(0, Math.Min(baseName.Length, 85)) \u002B ext;            }            return cleaned;        }        private static string EnsureUniqueFileName(string candidate, HashSet\u003Cstring\u003E usedNames)        {            if (usedNames.Add(candidate))                return candidate;            string ext = Path.GetExtension(candidate);            string baseName = Path.GetFileNameWithoutExtension(candidate);            int counter = 2;            while (true)            {                string numbered = $\u0022{baseName}_{counter}{ext}\u0022;                if (usedNames.Add(numbered))                    return numbered;                counter\u002B\u002B;            }        }    }}\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\ReverseEngineering\\SiteDumper.cs**\n\n\u0060\u0060\u0060\ncsusing System;using System.Collections.Generic;using System.Text;using System.Text.Json;using System.Threading;using System.Threading.Tasks;using BrowserAutomationFramework.Models;using BrowserAutomationFramework.Server;namespace BrowserAutomationFramework.ReverseEngineering{    /// \u003Csummary\u003E    /// High-level reverse engineering engine for dumping all loaded HTML, CSS stylesheets, and JavaScript assets from a connected browser tab.    /// \u003C/summary\u003E    public class SiteDumper    {        public event EventHandler\u003CSiteDumpEventArgs\u003E? OnDumpStarted;        public event EventHandler\u003CSiteDumpEventArgs\u003E? OnDumpCompleted;        public event EventHandler\u003CSiteDumpEventArgs\u003E? OnDumpFailed;        /// \u003Csummary\u003E        /// Dumps all HTML from the currently loaded site.        /// \u003C/summary\u003E        public Task\u003CSiteDumpResult\u003E DumpHtmlAsync(            BrowserClient client,            SiteDumpOptions? options = null,            CancellationToken cancellationToken = default)        {            return DumpSiteAsync(client, SiteDumpType.Html, options, cancellationToken);        }        /// \u003Csummary\u003E        /// Dumps all external, inline, and constructed CSS stylesheets from the currently loaded site.        /// \u003C/summary\u003E        public Task\u003CSiteDumpResult\u003E DumpCssAsync(            BrowserClient client,            SiteDumpOptions? options = null,            CancellationToken cancellationToken = default)        {            return DumpSiteAsync(client, SiteDumpType.Css, options, cancellationToken);        }        /// \u0