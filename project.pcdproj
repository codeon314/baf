mTokenColor colorType)\n        {\n            Text = text;\n            ColorType = colorType;\n        }\n    }\n\n    public sealed class DomTreeItem\n    {\n        public DomNode Node { get; }\n        public string UniqueKey { get; }\n        public string? ParentKey { get; }\n        public int Depth { get; }\n        public List\u003CDomTreeItem\u003E Children { get; } = new();\n        public bool HasChildren =\u003E Children.Count \u003E 0;\n        public DomDisplayPart[] OpenParts { get; }\n        public DomDisplayPart[] CollapsedSuffixParts { get; }\n        public int EstimatedCharLength { get; }\n\n        internal int MeasuredFontGeneration;\n        internal int[]? OpenPartWidths;\n        internal int[]? CollapsedSuffixWidths;\n        internal int OpenTotalWidth;\n        internal int CollapsedSuffixTotalWidth;\n\n        public DomTreeItem(\n            DomNode node,\n            string uniqueKey,\n            string? parentKey,\n            int depth,\n            DomDisplayPart[] openParts,\n            DomDisplayPart[] collapsedSuffixParts,\n            int estimatedCharLength)\n        {\n            Node = node;\n            UniqueKey = uniqueKey;\n            ParentKey = parentKey;\n            Depth = depth;\n            OpenParts = openParts;\n            CollapsedSuffixParts = collapsedSuffixParts;\n            EstimatedCharLength = estimatedCharLength;\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// Thread-safe, pre-indexed DOM tree snapshot built on a background worker thread.\n    /// Provides O(1) lookup by CSS path and pre-tokenized syntax highlighting parts.\n    /// \u003C/summary\u003E\n    public sealed class DomTreeSnapshot\n    {\n        private const int MaxAttrValueDisplayLength = 180;\n        private const int MaxTextDisplayLength = 220;\n        private const int MaxAttributesDisplayed = 24;\n\n        public DomNode RootNode { get; }\n        public DomTreeItem RootItem { get; }\n        public Dictionary\u003Cstring, DomTreeItem\u003E ItemsByKey { get; }\n\n        private DomTreeSnapshot(DomNode rootNode, DomTreeItem rootItem, Dictionary\u003Cstring, DomTreeItem\u003E itemsByKey)\n        {\n            RootNode = rootNode;\n            RootItem = rootItem;\n            ItemsByKey = itemsByKey;\n        }\n\n        public static DomTreeSnapshot Build(DomNode rootNode)\n        {\n            var itemsByKey = new Dictionary\u003Cstring, DomTreeItem\u003E(4096, StringComparer.Ordinal);\n            var rootItem = BuildItemRecursive(rootNode, null, 0, 0, itemsByKey);\n            return new DomTreeSnapshot(rootNode, rootItem, itemsByKey);\n        }\n\n        public static List\u003CDomTreeItem\u003E BuildVisibleRows(DomTreeItem rootItem, HashSet\u003Cstring\u003E expandedKeys)\n        {\n            var list = new List\u003CDomTreeItem\u003E(Math.Max(64, expandedKeys.Count * 8));\n            AppendVisibleRecursive(rootItem, expandedKeys, list);\n            return list;\n        }\n\n        private static void AppendVisibleRecursive(DomTreeItem item, HashSet\u003Cstring\u003E expandedKeys, List\u003CDomTreeItem\u003E output)\n        {\n            output.Add(item);\n            if (item.HasChildren \u0026\u0026 expandedKeys.Contains(item.UniqueKey))\n            {\n                var children = item.Children;\n                for (int i = 0; i \u003C children.Count; i\u002B\u002B)\n                {\n                    AppendVisibleRecursive(children[i], expandedKeys, output);\n                }\n            }\n        }\n\n        private static DomTreeItem BuildItemRecursive(\n            DomNode node,\n            string? parentKey,\n            int depth,\n            int siblingIndex,\n            Dictionary\u003Cstring, DomTreeItem\u003E itemsByKey)\n        {\n            string uniqueKey = !string.IsNullOrEmpty(node.Path)\n                ? node.Path!\n                : $\u0022{parentKey ?? \u0022root\u0022}#text_{siblingIndex}\u0022;\n\n            BuildDisplayParts(node, out var openParts, out var suffixParts, out int charLen);\n\n            var item = new DomTreeItem(node, uniqueKey, parentKey, depth, openParts, suffixParts, charLen);\n            itemsByKey[uniqueKey] = item;\n\n            if (node.Children != null \u0026\u0026 node.Children.Count \u003E 0)\n            {\n                for (int i = 0; i \u003C node.Children.Count; i\u002B\u002B)\n                {\n                    var childItem = BuildItemRecursive(node.Children[i], uniqueKey, depth \u002B 1, i, itemsByKey);\n                    item.Children.Add(childItem);\n                }\n            }\n\n            return item;\n        }\n\n        private static void BuildDisplayParts(\n            DomNode domNode,\n            out DomDisplayPart[] openParts,\n            out DomDisplayPart[] collapsedSuffixParts,\n            out int estimatedCharLen)\n        {\n            estimatedCharLen = 0;\n            if (domNode.Type == \u0022element\u0022)\n            {\n                string tag = domNode.TagName ?? \u0022element\u0022;\n                int attrCount = domNode.Attributes?.Count ?? 0;\n                var parts = new List\u003CDomDisplayPart\u003E(3 \u002B (Math.Min(attrCount, MaxAttributesDisplayed) * 3));\n\n                parts.Add(new DomDisplayPart(\u0022\u003C\u0022, DomTokenColor.Punctuation));\n                parts.Add(new DomDisplayPart(tag, DomTokenColor.TagName));\n                estimatedCharLen \u002B= 1 \u002B tag.Length;\n\n                if (domNode.Attributes != null \u0026\u0026 attrCount \u003E 0)\n                {\n                    int processed = 0;\n                    foreach (var attr in domNode.Attributes)\n                    {\n                        if (processed \u003E= MaxAttributesDisplayed)\n                        {\n                            parts.Add(new DomDisplayPart(\u0022 ...\u0022, DomTokenColor.Punctuation));\n                            estimatedCharLen \u002B= 4;\n                            break;\n                        }\n\n                        string cleanVal = SanitizeSingleLine(attr.Value, MaxAttrValueDisplayLength);\n                        string quotedVal = $\u0022\\\u0022{cleanVal}\\\u0022\u0022;\n\n                        parts.Add(new DomDisplayPart($\u0022 {attr.Key}\u0022, DomTokenColor.AttributeName));\n                        parts.Add(new DomDisplayPart(\u0022=\u0022, DomTokenColor.Punctuation));\n                        parts.Add(new DomDisplayPart(quotedVal, DomTokenColor.AttributeValue));\n\n                        estimatedCharLen \u002B= 1 \u002B attr.Key.Length \u002B 1 \u002B quotedVal.Length;\n                        processed\u002B\u002B;\n                    }\n                }\n\n                parts.Add(new DomDisplayPart(\u0022\u003E\u0022, DomTokenColor.Punctuation));\n                estimatedCharLen \u002B= 1;\n                openParts = parts.ToArray();\n\n                if (domNode.Children != null \u0026\u0026 domNode.Children.Count \u003E 0)\n                {\n                    collapsedSuffixParts = new[]\n                    {\n                        new DomDisplayPart(\u0022...\u003C/\u0022, DomTokenColor.Punctuation),\n                        new DomDisplayPart(tag, DomTokenColor.TagName),\n                        new DomDisplayPart(\u0022\u003E\u0022, DomTokenColor.Punctuation)\n                    };\n                    estimatedCharLen \u002B= 6 \u002B tag.Length;\n                }\n                else\n                {\n                    collapsedSuffixParts = Array.Empty\u003CDomDisplayPart\u003E();\n                }\n            }\n            else\n            {\n                string cleanText = SanitizeSingleLine(domNode.Text ?? string.Empty, MaxTextDisplayLength);\n                string display = $\u0022\\\u0022{cleanText}\\\u0022\u0022;\n                openParts = new[] { new DomDisplayPart(display, DomTokenColor.TextContent) };\n                collapsedSuffixParts = Array.Empty\u003CDomDisplayPart\u003E();\n                estimatedCharLen = display.Length;\n            }\n        }\n\n        private static string SanitizeSingleLine(string raw, int maxLen)\n        {\n            if (string.IsNullOrEmpty(raw))\n                return string.Empty;\n\n            int limit = Math.Min(raw.Length, maxLen);\n            var sb = new StringBuilder(limit \u002B 3);\n            bool lastWasSpace = false;\n\n            for (int i = 0; i \u003C raw.Length; i\u002B\u002B)\n            {\n                char c = raw[i];\n                if (c == \u0027\\r\u0027 || c == \u0027\\n\u0027 || c == \u0027\\t\u0027)\n                {\n                    if (!lastWasSpace)\n                    {\n                        sb.Append(\u0027 \u0027);\n                        lastWasSpace = true;\n                    }\n                }\n                else\n                {\n                    sb.Append(c);\n                    lastWasSpace = c == \u0027 \u0027;\n                }\n\n                if (sb.Length \u003E= maxLen)\n                {\n                    if (i \u003C raw.Length - 1)\n                        sb.Append(\u0022...\u0022);\n                    break;\n                }\n            }\n\n            return sb.ToString();\n        }\n    }\n\n    /// \u003Csummary\u003E\n    /// High-performance, virtualized DOM tree viewer control that renders only visible rows\n    /// and supports O(1) element selection without Win32 SysTreeView32 overhead or flicker.\n    /// \u003C/summary\u003E\n    public class DomTreeView : Control\n    {\n        private readonly VScrollBar _vScrollBar;\n        private readonly HScrollBar _hScrollBar;\n        private Font _codeFont;\n        private int _fontGeneration = 1;\n        private int _avgCharWidth = 8;\n\n        private readonly Color _selBgColor = Color.FromArgb(9, 71, 113);\n        private readonly Color _hoverBgColor = Color.FromArgb(40, 42, 46);\n        private readonly Color _borderColor = Color.FromArgb(63, 63, 70);\n        private readonly Color _glyphFillColor = Color.FromArgb(37, 37, 38);\n        private readonly Color _tagColor = Color.FromArgb(86, 156, 214);\n        private readonly Color _attrNameColor = Color.FromArgb(156, 220, 254);\n        private readonly Color _attrValueColor = Color.FromArgb(206, 145, 120);\n        private readonly Color _textColor = Color.FromArgb(212, 212, 212);\n        private readonly Color _punctColor = Color.FromArgb(128, 128, 128);\n\n        private readonly SolidBrush _selBgBrush;\n        private readonly SolidBrush _hoverBgBrush;\n        private readonly SolidBrush _glyphFillBrush;\n        private readonly Pen _borderPen;\n        private readonly Pen _linePen;\n        private readonly Pen _glyphBorderPen;\n        private readonly Pen _glyphSignPen;\n\n        private DomTreeSnapshot? _snapshot;\n        private List\u003CDomTreeItem\u003E _visibleRows = new();\n        private readonly Dictionary\u003Cstring, int\u003E _rowIndexByKey = new(StringComparer.Ordinal);\n        private readonly HashSet\u003Cstring\u003E _expandedKeys = new(StringComparer.Ordinal);\n\n        private DomTreeItem? _selectedItem;\n        private string? _selectedKey;\n        private int _hoveredRowIndex = -1;\n\n        private int _scrollY;\n        private int _scrollX;\n        private int _maxContentWidth = 400;\n        private bool _updatingScrollBars;\n\n        private int _itemHeight = 24;\n        private int _indentWidth = 19;\n        private int _glyphColumnWidth = 18;\n        private int _paddingLeft = 6;\n        private BorderStyle _borderStyle = BorderStyle.FixedSingle;\n\n        [Browsable(false)]\n        [DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]\n        public TreeViewDrawMode DrawMode { get; set; } = TreeViewDrawMode.OwnerDrawText;\n\n        [DefaultValue(BorderStyle.FixedSingle)]\n        public BorderStyle BorderStyle\n        {\n            get =\u003E _borderStyle;\n            set\n            {\n                if (_borderStyle != value)\n                {\n                    _borderStyle = value;\n                    LayoutScrollBars();\n                    Invalidate();\n                }\n            }\n        }\n\n        [DefaultValue(false)]\n        public bool HideSelection { get; set; } = false;\n\n        [DefaultValue(24)]\n        public int ItemHeight\n        {\n            get =\u003E _itemHeight;\n            set\n            {\n                int clamped = Math.Max(16, value);\n                if (_itemHeight != clamped)\n                {\n                    _itemHeight = clamped;\n                    UpdateScrollBars();\n                    Invalidate();\n                }\n            }\n        }\n\n        [DefaultValue(true)]\n        public bool ShowLines { get; set; } = true;\n\n        [DefaultValue(true)]\n        public bool ShowPlusMinus { get; set; } = true;\n\n        [DefaultValue(true)]\n        public bool ShowRootLines { get; set; } = true;\n\n        [Browsable(false)]\n        [DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]\n        public DomNode? RootDomNode =\u003E _snapshot?.RootNode;\n\n        [Browsable(false)]\n        [DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]\n        public DomNode? SelectedDomNode =\u003E _selectedItem?.Node;\n\n        [Browsable(false)]\n        [DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]\n        public string? SelectedPath =\u003E _selectedItem?.Node.Path;\n\n        [Browsable(false)]\n        [DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]\n        public TreeNode? SelectedNode\n        {\n            get =\u003E _selectedItem != null ? CreateShimTreeNode(_selectedItem.Node) : null;\n            set\n            {\n                if (value == null)\n                {\n                    ClearSelection();\n                }\n                else if (value.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path))\n                {\n                    SelectNodeByPath(domNode.Path, ensureVisible: true, raiseAfterSelect: false);\n                }\n            }\n        }\n\n        public event TreeViewEventHandler? AfterSelect;\n        public event TreeNodeMouseClickEventHandler? NodeMouseClick;\n\n        public DomTreeView()\n        {\n            SetStyle(\n                ControlStyles.OptimizedDoubleBuffer |\n                ControlStyles.AllPaintingInWmPaint |\n                ControlStyles.UserPaint |\n                ControlStyles.ResizeRedraw |\n                ControlStyles.Selectable,\n                true);\n\n            BackColor = Color.FromArgb(30, 30, 30);\n            ForeColor = Color.LightGray;\n            _codeFont = new Font(\u0022Consolas\u0022, 10F);\n\n            _selBgBrush = new SolidBrush(_selBgColor);\n            _hoverBgBrush = new SolidBrush(_hoverBgColor);\n            _glyphFillBrush = new SolidBrush(_glyphFillColor);\n            _borderPen = new Pen(_borderColor, 1f);\n            _linePen = new Pen(Color.FromArgb(58, 58, 62), 1f);\n            _glyphBorderPen = new Pen(Color.FromArgb(130, 130, 135), 1f);\n            _glyphSignPen = new Pen(_textColor, 1f);\n\n            _vScrollBar = new VScrollBar { Visible = false };\n            _hScrollBar = new HScrollBar { Visible = false };\n\n            _vScrollBar.Scroll \u002B= OnVScroll;\n            _vScrollBar.ValueChanged \u002B= OnVScroll;\n            _hScrollBar.Scroll \u002B= OnHScroll;\n            _hScrollBar.ValueChanged \u002B= OnHScroll;\n\n            Controls.Add(_vScrollBar);\n            Controls.Add(_hScrollBar);\n        }\n\n        private int ScaleDpi(int value) =\u003E (int)Math.Ceiling(value * (DeviceDpi / 96f));\n\n        protected override void OnHandleCreated(EventArgs e)\n        {\n            base.OnHandleCreated(e);\n            try\n            {\n                ReThemer.ThemeControl(_vScrollBar);\n                ReThemer.ThemeControl(_hScrollBar);\n            }\n            catch { }\n            UpdateMetrics();\n            LayoutScrollBars();\n            UpdateScrollBars();\n        }\n\n        protected override void OnDpiChangedAfterParent(EventArgs e)\n        {\n            base.OnDpiChangedAfterParent(e);\n            UpdateMetrics();\n            LayoutScrollBars();\n            UpdateScrollBars();\n            Invalidate();\n        }\n\n        private void UpdateMetrics()\n        {\n            _fontGeneration\u002B\u002B;\n            int scaledHeight = ScaleDpi(24);\n            _itemHeight = Math.Max(_codeFont.Height \u002B ScaleDpi(6), scaledHeight);\n            _indentWidth = ScaleDpi(18);\n            _glyphColumnWidth = ScaleDpi(18);\n            _paddingLeft = ScaleDpi(6);\n\n            Size charSample = TextRenderer.MeasureText(\u0022MMMMMMMMMM\u0022, _codeFont, Size.Empty, TextFormatFlags.NoPadding | TextFormatFlags.SingleLine);\n            _avgCharWidth = Math.Max(6, (int)Math.Ceiling(charSample.Width / 10.0));\n        }\n\n        protected override void OnResize(EventArgs e)\n        {\n            base.OnResize(e);\n            LayoutScrollBars();\n            UpdateScrollBars();\n        }\n\n        private int BorderInset =\u003E _borderStyle == BorderStyle.FixedSingle ? 1 : 0;\n\n        private Rectangle GetViewportBounds()\n        {\n            int inset = BorderInset;\n            int w = Math.Max(0, ClientSize.Width - (inset * 2) - (_vScrollBar.Visible ? _vScrollBar.Width : 0));\n            int h = Math.Max(0, ClientSize.Height - (inset * 2) - (_hScrollBar.Visible ? _hScrollBar.Height : 0));\n            return new Rectangle(inset, inset, w, h);\n        }\n\n        private void LayoutScrollBars()\n        {\n            int inset = BorderInset;\n            int vWidth = SystemInformation.VerticalScrollBarWidth;\n            int hHeight = SystemInformation.HorizontalScrollBarHeight;\n\n            int clientW = ClientSize.Width - (inset * 2);\n            int clientH = ClientSize.Height - (inset * 2);\n\n            _vScrollBar.Bounds = new Rectangle(\n                ClientSize.Width - inset - vWidth,\n                inset,\n                vWidth,\n                Math.Max(0, clientH - (_hScrollBar.Visible ? hHeight : 0)));\n\n            _hScrollBar.Bounds = new Rectangle(\n                inset,\n                ClientSize.Height - inset - hHeight,\n                Math.Max(0, clientW - (_vScrollBar.Visible ? vWidth : 0)),\n                hHeight);\n        }\n\n        private void UpdateScrollBars()\n        {\n            if (!IsHandleCreated) return;\n\n            _updatingScrollBars = true;\n            try\n            {\n                int inset = BorderInset;\n                int vWidth = SystemInformation.VerticalScrollBarWidth;\n                int hHeight = SystemInformation.HorizontalScrollBarHeight;\n\n                int availW = Math.Max(0, ClientSize.Width - (inset * 2));\n                int availH = Math.Max(0, ClientSize.Height - (inset * 2));\n\n                int totalHeight = _visibleRows.Count * _itemHeight;\n                int totalWidth = _maxContentWidth;\n\n                bool needV = totalHeight \u003E availH;\n                int viewW = needV ? Math.Max(0, availW - vWidth) : availW;\n                bool needH = totalWidth \u003E viewW;\n                int viewH = needH ? Math.Max(0, availH - hHeight) : availH;\n\n                if (!needV \u0026\u0026 totalHeight \u003E viewH)\n                {\n                    needV = true;\n                    viewW = Math.Max(0, availW - vWidth);\n                }\n\n                if (_vScrollBar.Visible != needV || _hScrollBar.Visible != needH)\n                {\n                    _vScrollBar.Visible = needV;\n                    _hScrollBar.Visible = needH;\n                    LayoutScrollBars();\n                }\n\n                if (needV)\n                {\n                    int maxScrollY = Math.Max(0, totalHeight - viewH);\n                    _scrollY = Math.Clamp(_scrollY, 0, maxScrollY);\n                    _vScrollBar.Minimum = 0;\n                    _vScrollBar.LargeChange = Math.Max(1, viewH);\n                    _vScrollBar.SmallChange = _itemHeight;\n                    _vScrollBar.Maximum = Math.Max(0, totalHeight - 1);\n                    _vScrollBar.Value = Math.Clamp(_scrollY, _vScrollBar.Minimum, Math.Max(0, _vScrollBar.Maximum - _vScrollBar.LargeChange \u002B 1));\n                }\n                else\n                {\n                    _scrollY = 0;\n                }\n\n                if (needH)\n                {\n                    int maxScrollX = Math.Max(0, totalWidth - viewW);\n                    _scrollX = Math.Clamp(_scrollX, 0, maxScrollX);\n                    _hScrollBar.Minimum = 0;\n                    _hScrollBar.LargeChange = Math.Max(1, viewW);\n                    _hScrollBar.SmallChange = Math.Max(16, _avgCharWidth * 4);\n                    _hScrollBar.Maximum = Math.Max(0, totalWidth - 1);\n                    _hScrollBar.Value = Math.Clamp(_scrollX, _hScrollBar.Minimum, Math.Max(0, _hScrollBar.Maximum - _hScrollBar.LargeChange \u002B 1));\n                }\n                else\n                {\n                    _scrollX = 0;\n                }\n            }\n            finally\n            {\n                _updatingScrollBars = false;\n            }\n        }\n\n        private void OnVScroll(object? sender, EventArgs e)\n        {\n            if (_updatingScrollBars) return;\n            if (_scrollY != _vScrollBar.Value)\n            {\n                _scrollY = _vScrollBar.Value;\n                Invalidate();\n            }\n        }\n\n        private void OnHScroll(object? sender, EventArgs e)\n        {\n            if (_updatingScrollBars) return;\n            if (_scrollX != _hScrollBar.Value)\n            {\n                _scrollX = _hScrollBar.Value;\n                Invalidate();\n            }\n        }\n\n        /// \u003Csummary\u003E\n        /// Returns a copy of the currently expanded DOM path keys.\n        /// \u003C/summary\u003E\n        public HashSet\u003Cstring\u003E GetExpandedPathsSnapshot()\n        {\n            return new HashSet\u003Cstring\u003E(_expandedKeys, StringComparer.Ordinal);\n        }\n\n        /// \u003Csummary\u003E\n        /// Clears all nodes and resets the tree state.\n        /// \u003C/summary\u003E\n        public void Clear()\n        {\n            _snapshot = null;\n            _visibleRows.Clear();\n            _rowIndexByKey.Clear();\n            _expandedKeys.Clear();\n            _selectedItem = null;\n            _selectedKey = null;\n            _hoveredRowIndex = -1;\n            _scrollX = 0;\n            _scrollY = 0;\n            _maxContentWidth = 200;\n            UpdateScrollBars();\n            Invalidate();\n        }\n\n        /// \u003Csummary\u003E\n        /// Clears the current selection without collapsing nodes.\n        /// \u003C/summary\u003E\n        public void ClearSelection()\n        {\n            if (_selectedItem != null || _selectedKey != null)\n            {\n                _selectedItem = null;\n                _selectedKey = null;\n                Invalidate();\n            }\n        }\n\n        /// \u003Csummary\u003E\n        /// Atomically applies a background-built \u003Csee cref=\u0022DomTreeSnapshot\u0022/\u003E to the control without flickering.\n        /// \u003C/summary\u003E\n        public void ApplySnapshot(\n            DomTreeSnapshot? snapshot,\n            HashSet\u003Cstring\u003E? expandedKeys = null,\n            string? selectedPath = null,\n            bool ensureSelectedVisible = false,\n            bool raiseAfterSelect = false)\n        {\n            _snapshot = snapshot;\n            if (snapshot == null)\n            {\n                Clear();\n                return;\n            }\n\n            if (expandedKeys != null \u0026\u0026 expandedKeys.Count \u003E 0)\n            {\n                _expandedKeys.Clear();\n                foreach (var k in expandedKeys)\n                {\n                    if (snapshot.ItemsByKey.ContainsKey(k))\n                        _expandedKeys.Add(k);\n                }\n            }\n\n            if (_expandedKeys.Count == 0)\n            {\n                _expandedKeys.Add(snapshot.RootItem.UniqueKey);\n                if (snapshot.ItemsByKey.ContainsKey(\u0022body\u0022))\n                    _expandedKeys.Add(\u0022body\u0022);\n            }\n\n            DomTreeItem? resolvedSelected = null;\n            if (!string.IsNullOrEmpty(selectedPath) \u0026\u0026 snapshot.ItemsByKey.TryGetValue(selectedPath, out var foundTarget))\n            {\n                resolvedSelected = foundTarget;\n                ExpandAncestorsInSet(snapshot, foundTarget, _expandedKeys);\n            }\n\n            _selectedItem = resolvedSelected;\n            _selectedKey = resolvedSelected?.UniqueKey;\n\n            RebuildVisibleRowsInternal();\n\n            if (ensureSelectedVisible \u0026\u0026 _selectedKey != null \u0026\u0026 _rowIndexByKey.TryGetValue(_selectedKey, out int selRow))\n            {\n                EnsureRowVisible(selRow, centerVertically: true);\n            }\n            else\n            {\n                UpdateScrollBars();\n            }\n\n            Invalidate();\n\n            if (raiseAfterSelect \u0026\u0026 _selectedItem != null)\n            {\n                RaiseAfterSelect(_selectedItem.Node, TreeViewAction.Unknown);\n            }\n        }\n\n        /// \u003Csummary\u003E\n        /// Selects and expands to the node matching \u003Cparamref name=\u0022path\u0022/\u003E in O(1) lookup time with a single repaint.\n        /// \u003C/summary\u003E\n        public bool SelectNodeByPath(string? path, bool ensureVisible = true, bool raiseAfterSelect = false)\n        {\n            if (string.IsNullOrEmpty(path))\n            {\n                ClearSelection();\n                return false;\n            }\n\n            if (_snapshot == null || !_snapshot.ItemsByKey.TryGetValue(path, out var targetItem))\n                return false;\n\n            bool expandedChanged = ExpandAncestorsInSet(_snapshot, targetItem, _expandedKeys);\n            if (expandedChanged || _visibleRows.Count == 0)\n            {\n                RebuildVisibleRowsInternal();\n            }\n\n            _selectedItem = targetItem;\n            _selectedKey = targetItem.UniqueKey;\n\n            if (ensureVisible \u0026\u0026 _rowIndexByKey.TryGetValue(targetItem.UniqueKey, out int rowIndex))\n            {\n                EnsureRowVisible(rowIndex, centerVertically: true);\n            }\n\n            Invalidate();\n\n            if (raiseAfterSelect)\n            {\n                RaiseAfterSelect(targetItem.Node, TreeViewAction.Unknown);\n            }\n\n            return true;\n        }\n\n        private static bool ExpandAncestorsInSet(DomTreeSnapshot snapshot, DomTreeItem item, HashSet\u003Cstring\u003E expandedSet)\n        {\n            bool addedAny = false;\n            string? parentKey = item.ParentKey;\n            while (!string.IsNullOrEmpty(parentKey))\n            {\n                if (expandedSet.Add(parentKey))\n                    addedAny = true;\n\n                if (snapshot.ItemsByKey.TryGetValue(parentKey, out var parentItem))\n                    parentKey = parentItem.ParentKey;\n                else\n                    break;\n            }\n            return addedAny;\n        }\n\n        private void RebuildVisibleRowsInternal()\n        {\n            if (_snapshot == null)\n            {\n                _visibleRows.Clear();\n                _rowIndexByKey.Clear();\n                _maxContentWidth = 200;\n                return;\n            }\n\n            _visibleRows = DomTreeSnapshot.BuildVisibleRows(_snapshot.RootItem, _expandedKeys);\n            _rowIndexByKey.Clear();\n\n            int maxEstimatedW = 200;\n            for (int i = 0; i \u003C _visibleRows.Count; i\u002B\u002B)\n            {\n                var row = _visibleRows[i];\n                _rowIndexByKey[row.UniqueKey] = i;\n\n                int rowWidth = _paddingLeft \u002B (row.Depth * _indentWidth) \u002B _glyphColumnWidth \u002B\n                               (row.MeasuredFontGeneration == _fontGeneration\n                                   ? GetMeasuredRowTextWidth(row)\n                                   : (row.EstimatedCharLength * _avgCharWidth)) \u002B 32;\n\n                if (rowWidth \u003E maxEstimatedW)\n                    maxEstimatedW = rowWidth;\n            }\n\n            _maxContentWidth = maxEstimatedW;\n            UpdateScrollBars();\n        }\n\n        private int GetMeasuredRowTextWidth(DomTreeItem item)\n        {\n            bool includeCollapsedSuffix = item.HasChildren \u0026\u0026 !_expandedKeys.Contains(item.UniqueKey);\n            return item.OpenTotalWidth \u002B (includeCollapsedSuffix ? item.CollapsedSuffixTotalWidth : 0);\n        }\n\n        private void EnsureItemMeasured(Graphics g, DomTreeItem item)\n        {\n            if (item.MeasuredFontGeneration == _fontGeneration \u0026\u0026 item.OpenPartWidths != null)\n                return;\n\n            const TextFormatFlags measureFlags = TextFormatFlags.NoPadding | TextFormatFlags.SingleLine | TextFormatFlags.NoPrefix;\n\n            var openParts = item.OpenParts;\n            int[] openWidths = new int[openParts.Length];\n            int openTotal = 0;\n            for (int i = 0; i \u003C openParts.Length; i\u002B\u002B)\n            {\n                int w = TextRenderer.MeasureText(g, openParts[i].Text, _codeFont, Size.Empty, measureFlags).Width;\n                openWidths[i] = w;\n                openTotal \u002B= w;\n            }\n\n            var suffixParts = item.CollapsedSuffixParts;\n            int[] suffixWidths = suffixParts.Length \u003E 0 ? new int[suffixParts.Length] : Array.Empty\u003Cint\u003E();\n            int suffixTotal = 0;\n            for (int i = 0; i \u003C suffixParts.Length; i\u002B\u002B)\n            {\n                int w = TextRenderer.MeasureText(g, suffixParts[i].Text, _codeFont, Size.Empty, measureFlags).Width;\n                suffixWidths[i] = w;\n                suffixTotal \u002B= w;\n            }\n\n            item.OpenPartWidths = openWidths;\n            item.CollapsedSuffixWidths = suffixWidths;\n            item.OpenTotalWidth = openTotal;\n            item.CollapsedSuffixTotalWidth = suffixTotal;\n            item.MeasuredFontGeneration = _fontGeneration;\n\n            int fullRowW = _paddingLeft \u002B (item.Depth * _indentWidth) \u002B _glyphColumnWidth \u002B openTotal \u002B suffixTotal \u002B 32;\n            if (fullRowW \u003E _maxContentWidth)\n            {\n                _maxContentWidth = fullRowW;\n                UpdateScrollBars();\n            }\n        }\n\n        private void EnsureRowVisible(int rowIndex, bool centerVertically)\n        {\n            if (rowIndex \u003C 0 || rowIndex \u003E= _visibleRows.Count)\n                return;\n\n            Rectangle view = GetViewportBounds();\n            if (view.Height \u003C= 0)\n                return;\n\n            int rowTop = rowIndex * _itemHeight;\n            int rowBottom = rowTop \u002B _itemHeight;\n\n            if (rowTop \u003C _scrollY || rowBottom \u003E _scrollY \u002B view.Height)\n            {\n                if (centerVertically)\n                {\n                    _scrollY = rowTop - (view.Height / 2) \u002B (_itemHeight / 2);\n                }\n                else if (rowTop \u003C _scrollY)\n                {\n                    _scrollY = rowTop;\n                }\n                else\n                {\n                    _scrollY = rowBottom - view.Height;\n                }\n            }\n\n            var item = _visibleRows[rowIndex];\n            int itemTextStart = _paddingLeft \u002B (item.Depth * _indentWidth);\n            if (itemTextStart \u003C _scrollX || itemTextStart \u002B ScaleDpi(100) \u003E _scrollX \u002B view.Width)\n            {\n                _scrollX = Math.Max(0, itemTextStart - ScaleDpi(24));\n            }\n\n            UpdateScrollBars();\n        }\n\n        protected override void OnPaint(PaintEventArgs e)\n        {\n            Graphics g = e.Graphics;\n            g.Clear(BackColor);\n\n            Rectangle view = GetViewportBounds();\n            if (view.Width \u003C= 0 || view.Height \u003C= 0)\n            {\n                DrawControlBorder(g);\n                return;\n            }\n\n            Region oldClip = g.Clip;\n            g.SetClip(view);\n\n            try\n            {\n                if (_visibleRows.Count \u003E 0)\n                {\n                    int firstRow = Math.Max(0, _scrollY / _itemHeight);\n                    int visibleRowCount = (view.Height / _itemHeight) \u002B 2;\n                    int lastRow = Math.Min(_visibleRows.Count - 1, firstRow \u002B visibleRowCount);\n\n                    int glyphBoxSize = ScaleDpi(9);\n                    if (glyphBoxSize % 2 == 0) glyphBoxSize\u002B\u002B;\n\n                    const TextFormatFlags drawFlags = TextFormatFlags.NoPadding | TextFormatFlags.SingleLine | TextFormatFlags.NoPrefix | TextFormatFlags.PreserveGraphicsClipping;\n\n                    for (int rowIdx = firstRow; rowIdx \u003C= lastRow; rowIdx\u002B\u002B)\n                    {\n                        var item = _visibleRows[rowIdx];\n                        EnsureItemMeasured(g, item);\n\n                        int rowY = view.Top \u002B (rowIdx * _itemHeight) - _scrollY;\n                        int centerY = rowY \u002B (_itemHeight / 2);\n                        int indentX = view.Left \u002B _paddingLeft \u002B (item.Depth * _indentWidth) - _scrollX;\n                        int textStartX = indentX \u002B _glyphColumnWidth;\n\n                        bool isExpanded = item.HasChildren \u0026\u0026 _expandedKeys.Contains(item.UniqueKey);\n                        bool isSelected = string.Equals(item.UniqueKey, _selectedKey, StringComparison.Ordinal);\n                        bool isHovered = rowIdx == _hoveredRowIndex \u0026\u0026 !isSelected;\n\n                        int textTotalW = item.OpenTotalWidth \u002B (item.HasChildren \u0026\u0026 !isExpanded ? item.CollapsedSuffixTotalWidth : 0);\n\n                        // Selection or hover highlight\n                        if (isSelected)\n                        {\n                            Rectangle selRect = new Rectangle(textStartX - 2, rowY, textTotalW \u002B 6, _itemHeight);\n                            g.FillRectangle(_selBgBrush, selRect);\n                        }\n                        else if (isHovered)\n                        {\n                            Rectangle hovRect = new Rectangle(textStartX - 2, rowY, textTotalW \u002B 6, _itemHeight);\n                            g.FillRectangle(_hoverBgBrush, hovRect);\n                        }\n\n                        // Hierarchy guide lines\n                        if (ShowLines)\n                        {\n                            for (int d = (ShowRootLines ? 0 : 1); d \u003C item.Depth; d\u002B\u002B)\n                            {\n                                int guideX = view.Left \u002B _paddingLeft \u002B (d * _indentWidth) \u002B (_glyphColumnWidth / 2) - _scrollX;\n                                if (guideX \u003E= view.Left \u0026\u0026 guideX \u003C= view.Right)\n                                {\n                                    g.DrawLine(_linePen, guideX, rowY, guideX, rowY \u002B _itemHeight);\n                                }\n                            }\n\n                            if (item.Depth \u003E 0 || ShowRootLines)\n                            {\n                                int lineCenterX = indentX \u002B (_glyphColumnWidth / 2);\n                                if (lineCenterX \u003E= view.Left - 20 \u0026\u0026 lineCenterX \u003C= view.Right)\n                                {\n                                    g.DrawLine(_linePen, lineCenterX, rowY, lineCenterX, centerY);\n                                    g.DrawLine(_linePen, lineCenterX, centerY, textStartX - 3, centerY);\n                                }\n                            }\n                        }\n\n                        // Expand / Collapse Plus-Minus Box\n                        if (ShowPlusMinus \u0026\u0026 item.HasChildren)\n                        {\n                            int boxLeft = indentX \u002B ((_glyphColumnWidth - glyphBoxSize) / 2);\n                            int boxTop = centerY - (glyphBoxSize / 2);\n                            Rectangle boxRect = new Rectangle(boxLeft, boxTop, glyphBoxSize - 1, glyphBoxSize - 1);\n\n                            g.FillRectangle(_glyphFillBrush, boxRect);\n                            g.DrawRectangle(_glyphBorderPen, boxRect);\n\n                            int signMargin = 2;\n                            int midY = boxTop \u002B (glyphBoxSize / 2);\n                            int midX = boxLeft \u002B (glyphBoxSize / 2);\n                            g.DrawLine(_glyphSignPen, boxLeft \u002B signMargin, midY, boxLeft \u002B glyphBoxSize - 1 - signMargin, midY);\n                            if (!isExpanded)\n                            {\n                                g.DrawLine(_glyphSignPen, midX, boxTop \u002B signMargin, midX, boxTop \u002B glyphBoxSize - 1 - signMargin);\n                            }\n                        }\n\n                        // Syntax-highlighted tokens with horizontal viewport culling\n                        int textY = rowY \u002B ((_itemHeight - _codeFont.Height) / 2);\n                        int curX = textStartX;\n\n                        var openParts = item.OpenParts;\n                        var openWidths = item.OpenPartWidths!;\n                        for (int p = 0; p \u003C openParts.Length; p\u002B\u002B)\n                        {\n                            int w = openWidths[p];\n                            if (curX \u002B w \u003E= view.Left)\n                            {\n                                Color tokenColor = GetColorForToken(openParts[p].ColorType);\n                                TextRenderer.DrawText(g, openParts[p].Text, _codeFont, new Point(curX, textY), tokenColor, drawFlags);\n                            }\n                            curX \u002B= w;\n                            if (curX \u003E view.Right)\n                                break;\n                        }\n\n                        if (item.HasChildren \u0026\u0026 !isExpanded \u0026\u0026 curX \u003C= view.Right)\n                        {\n                            var suffixParts = item.CollapsedSuffixParts;\n                            var suffixWidths = item.CollapsedSuffixWidths!;\n                            for (int p = 0; p \u003C suffixParts.Length; p\u002B\u002B)\n                            {\n                                int w = suffixWidths[p];\n                                if (curX \u002B w \u003E= view.Left)\n                                {\n                                    Color tokenColor = GetColorForToken(suffixParts[p].ColorType);\n                                    TextRenderer.DrawText(g, suffixParts[p].Text, _codeFont, new Point(curX, textY), tokenColor, drawFlags);\n                                }\n                                curX \u002B= w;\n                                if (curX \u003E view.Right)\n                                    break;\n                            }\n                        }\n                    }\n                }\n            }\n            finally\n            {\n                g.Clip = oldClip;\n            }\n\n            if (_vScrollBar.Visible \u0026\u0026 _hScrollBar.Visible)\n            {\n                Rectangle corner = new Rectangle(\n                    _vScrollBar.Left,\n                    _hScrollBar.Top,\n                    _vScrollBar.Width,\n                    _hScrollBar.Height);\n                using var cornerBrush = new SolidBrush(BackColor);\n                g.FillRectangle(cornerBrush, corner);\n            }\n\n            DrawControlBorder(g);\n        }\n\n        private void DrawControlBorder(Graphics g)\n        {\n            if (_borderStyle == BorderStyle.FixedSingle \u0026\u0026 Width \u003E 1 \u0026\u0026 Height \u003E 1)\n            {\n                g.DrawRectangle(_borderPen, 0, 0, Width - 1, Height - 1);\n            }\n        }\n\n        private Color GetColorForToken(DomTokenColor tokenColor)\n        {\n            return tokenColor switch\n            {\n                DomTokenColor.TagName =\u003E _tagColor,\n                DomTokenColor.AttributeName =\u003E _attrNameColor,\n                DomTokenColor.AttributeValue =\u003E _attrValueColor,\n                DomTokenColor.TextContent =\u003E _textColor,\n                _ =\u003E _punctColor\n            };\n        }\n\n        private int GetRowIndexAtY(int y)\n        {\n            Rectangle view = GetViewportBounds();\n            if (y \u003C view.Top || y \u003E= view.Bottom)\n                return -1;\n\n            int row = (y - view.Top \u002B _scrollY) / _itemHeight;\n            return (row \u003E= 0 \u0026\u0026 row \u003C _visibleRows.Count) ? row : -1;\n        }\n\n        private bool IsPointOnExpandGlyph(DomTreeItem item, int x)\n        {\n            if (!item.HasChildren)\n                return false;\n\n            Rectangle view = GetViewportBounds();\n            int indentX = view.Left \u002B _paddingLeft \u002B (item.Depth * _indentWidth) - _scrollX;\n            return x \u003E= indentX - 2 \u0026\u0026 x \u003C indentX \u002B _glyphColumnWidth \u002B 2;\n        }\n\n        private void ToggleItemExpansion(DomTreeItem item)\n        {\n            if (!item.HasChildren)\n                return;\n\n            if (!_expandedKeys.Remove(item.UniqueKey))\n            {\n                _expandedKeys.Add(item.UniqueKey);\n            }\n\n            RebuildVisibleRowsInternal();\n            Invalidate();\n        }\n\n        protected override void OnMouseDown(MouseEventArgs e)\n        {\n            base.OnMouseDown(e);\n\n            if (!Focused \u0026\u0026 CanFocus)\n                Focus();\n\n            int rowIndex = GetRowIndexAtY(e.Y);\n            if (rowIndex \u003C 0)\n                return;\n\n            var item = _visibleRows[rowIndex];\n\n            if (e.Button == MouseButtons.Left \u0026\u0026 IsPointOnExpandGlyph(item, e.X))\n            {\n                ToggleItemExpansion(item);\n                return;\n            }\n\n            SelectRowInternal(rowIndex, TreeViewAction.ByMouse, ensureVisible: false);\n\n            if (e.Button == MouseButtons.Right)\n            {\n                NodeMouseClick?.Invoke(\n                    this,\n                    new TreeNodeMouseClickEventArgs(CreateShimTreeNode(item.Node), e.Button, e.Clicks, e.X, e.Y));\n            }\n        }\n\n        protected override void OnMouseDoubleClick(MouseEventArgs e)\n        {\n            base.OnMouseDoubleClick(e);\n\n            if (e.Button != MouseButtons.Left)\n                return;\n\n            int rowIndex = GetRowIndexAtY(e.Y);\n            if (rowIndex \u003E= 0 \u0026\u0026 rowIndex \u003C _visibleRows.Count)\n            {\n                var item = _visibleRows[rowIndex];\n                if (!IsPointOnExpandGlyph(item, e.X) \u0026\u0026 item.HasChildren)\n                {\n                    ToggleItemExpansion(item);\n                }\n            }\n        }\n\n        protected override void OnMouseMove(MouseEventArgs e)\n        {\n            base.OnMouseMove(e);\n            int row = GetRowIndexAtY(e.Y);\n            if (row != _hoveredRowIndex)\n            {\n                _hoveredRowIndex = row;\n                Invalidate();\n            }\n        }\n\n        protected override void OnMouseLeave(EventArgs e)\n        {\n            base.OnMouseLeave(e);\n            if (_hoveredRowIndex != -1)\n            {\n                _hoveredRowIndex = -1;\n                Invalidate();\n            }\n        }\n\n        protected override void OnMouseWheel(MouseEventArgs e)\n        {\n            base.OnMouseWheel(e);\n\n            if ((ModifierKeys \u0026 Keys.Shift) == Keys.Shift)\n            {\n                if (_hScrollBar.Visible)\n                {\n                    int deltaX = -(e.Delta / 120) * (_avgCharWidth * 8);\n                    int maxScrollX = Math.Max(0, _hScrollBar.Maximum - _hScrollBar.LargeChange \u002B 1);\n                    int nextX = Math.Clamp(_scrollX \u002B deltaX, 0, maxScrollX);\n                    if (nextX != _scrollX)\n                    {\n                        _scrollX = nextX;\n                        _updatingScrollBars = true;\n                        _hScrollBar.Value = _scrollX;\n                        _updatingScrollBars = false;\n                        Invalidate();\n                    }\n                }\n                return;\n            }\n\n            if (_vScrollBar.Visible)\n            {\n                int lines = SystemInformation.MouseWheelScrollLines \u003E 0 ? SystemInformation.MouseWheelScrollLines : 3;\n                int deltaY = -(e.Delta / 120) * (_itemHeight * lines);\n                int maxScrollY = Math.Max(0, _vScrollBar.Maximum - _vScrollBar.LargeChange \u002B 1);\n                int nextY = Math.Clamp(_scrollY \u002B deltaY, 0, maxScrollY);\n                if (nextY != _scrollY)\n                {\n                    _scrollY = nextY;\n                    _updatingScrollBars = true;\n                    _vScrollBar.Value = _scrollY;\n                    _updatingScrollBars = false;\n                    Invalidate();\n                }\n            }\n        }\n\n        protected override bool IsInputKey(Keys keyData)\n        {\n            switch (keyData \u0026 Keys.KeyCode)\n            {\n                case Keys.Up:\n                case Keys.Down:\n                case Keys.Left:\n                case Keys.Right:\n                case Keys.Home:\n                case Keys.End:\n                case Keys.PageUp:\n                case Keys.PageDown:\n                    return true;\n                default:\n                    return base.IsInputKey(keyData);\n            }\n        }\n\n        protected override void OnKeyDown(KeyEventArgs e)\n        {\n            base.OnKeyDown(e);\n            if (_visibleRows.Count == 0)\n                return;\n\n            int currentRow = (_selectedKey != null \u0026\u0026 _rowIndexByKey.TryGetValue(_selectedKey, out int idx)) ? idx : 0;\n            int pageRows = Math.Max(1, GetViewportBounds().Height / _itemHeight);\n\n            switch (e.KeyCode)\n            {\n                case Keys.Down:\n                    if (currentRow \u003C _visibleRows.Count - 1)\n                        SelectRowInternal(currentRow \u002B 1, TreeViewAction.ByKeyboard, ensureVisible: true);\n                    e.Handled = true;\n                    break;\n\n                case Keys.Up:\n                    if (currentRow \u003E 0)\n                        SelectRowInternal(currentRow - 1, TreeViewAction.ByKeyboard, ensureVisible: true);\n                    e.Handled = true;\n                    break;\n\n                case Keys.PageDown:\n                    SelectRowInternal(Math.Min(_visibleRows.Count - 1, currentRow \u002B pageRows), TreeViewAction.ByKeyboard, ensureVisible: true);\n                    e.Handled = true;\n                    break;\n\n                case Keys.PageUp:\n                    SelectRowInternal(Math.Max(0, currentRow - pageRows), TreeViewAction.ByKeyboard, ensureVisible: true);\n                    e.Handled = true;\n                    break;\n\n                case Keys.Home:\n                    SelectRowInternal(0, TreeViewAction.ByKeyboard, ensureVisible: true);\n                    e.Handled = true;\n                    break;\n\n                case Keys.End:\n                    SelectRowInternal(_visibleRows.Count - 1, TreeViewAction.ByKeyboard, ensureVisible: true);\n                    e.Handled = true;\n                    break;\n\n                case Keys.Right:\n                {\n                    var item = _visibleRows[currentRow];\n                    if (item.HasChildren)\n                    {\n                        if (!_expandedKeys.Contains(item.UniqueKey))\n                        {\n                            _expandedKeys.Add(item.UniqueKey);\n                            RebuildVisibleRowsInternal();\n                            Invalidate();\n                        }\n                        else if (currentRow \u002B 1 \u003C _visibleRows.Count)\n                        {\n                            SelectRowInternal(currentRow \u002B 1, TreeViewAction.ByKeyboard, ensureVisible: true);\n                        }\n                    }\n                    e.Handled = true;\n                    break;\n                }\n\n                case Keys.Left:\n                {\n                    var item = _visibleRows[currentRow];\n                    if (item.HasChildren \u0026\u0026 _expandedKeys.Contains(item.UniqueKey))\n                    {\n                        _expandedKeys.Remove(item.UniqueKey);\n                        RebuildVisibleRowsInternal();\n                        Invalidate();\n                    }\n                    else if (!string.IsNullOrEmpty(item.ParentKey) \u0026\u0026 _rowIndexByKey.TryGetValue(item.ParentKey, out int parentRow))\n                    {\n                        SelectRowInternal(parentRow, TreeViewAction.ByKeyboard, ensureVisible: true);\n                    }\n                    e.Handled = true;\n                    break;\n                }\n            }\n        }\n\n        private void SelectRowInternal(int rowIndex, TreeViewAction action, bool ensureVisible)\n        {\n            if (rowIndex \u003C 0 || rowIndex \u003E= _visibleRows.Count)\n                return;\n\n            var item = _visibleRows[rowIndex];\n            bool changed = !string.Equals(_selectedKey, item.UniqueKey, StringComparison.Ordinal);\n\n            _selectedItem = item;\n            _selectedKey = item.UniqueKey;\n\n            if (ensureVisible)\n            {\n                EnsureRowVisible(rowIndex, centerVertically: false);\n            }\n\n            Invalidate();\n\n            if (changed || action == TreeViewAction.ByMouse)\n            {\n                RaiseAfterSelect(item.Node, action);\n            }\n        }\n\n        private void RaiseAfterSelect(DomNode domNode, TreeViewAction action)\n        {\n            AfterSelect?.Invoke(this, new TreeViewEventArgs(CreateShimTreeNode(domNode), action));\n        }\n\n        private static TreeNode CreateShimTreeNode(DomNode domNode)\n        {\n            return new TreeNode(domNode.TagName ?? domNode.Text ?? string.Empty)\n            {\n                Tag = domNode\n            };\n        }\n\n        protected override void Dispose(bool disposing)\n        {\n            if (disposing)\n            {\n                _codeFont?.Dispose();\n                _selBgBrush?.Dispose();\n                _hoverBgBrush?.Dispose();\n                _glyphFillBrush?.Dispose();\n                _borderPen?.Dispose();\n                _linePen?.Dispose();\n                _glyphBorderPen?.Dispose();\n                _glyphSignPen?.Dispose();\n                _vScrollBar?.Dispose();\n                _hScrollBar?.Dispose();\n            }\n            base.Dispose(disposing);\n        }\n    }\n}\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\n            client.OnDomChanged \u002B= (s, e) =\u003E\n            {\n                Invoke(new Action(async () =\u003E\n                {\n                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)\n                    {\n                        await RefreshDomAsync(client, e.HighlightedPath, e.HasHighlightedPath);\n                    }\n                }));\n            };\n\n            client.OnHighlightedElementRemoved \u002B= (s, e) =\u003E\n            {\n                Invoke(new Action(() =\u003E\n                {\n                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)\n                    {\n                        tvDom.SelectedNode = null;\n                        txtElementDetails.Text = string.Empty;\n                    }\n                }));\n            };\n\n            client.OnElementClicked \u002B= (s, e) =\u003E\n            {\n                Invoke(new Action(() =\u003E\n                {\n                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId \u0026\u0026 tvDom.Nodes.Count \u003E 0)\n                    {\n                        var node = FindNodeByPath(tvDom.Nodes[0], e.Path);\n                        if (node != null)\n                        {\n                            tvDom.SelectedNode = node;\n                            node.EnsureVisible();\n                        }\n                    }\n                }));\n            };\n==== REPLACE\n            client.OnDomChanged \u002B= (s, e) =\u003E\n            {\n                BeginInvoke(new Action(async () =\u003E\n                {\n                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)\n                    {\n                        await RefreshDomAsync(client, e.HighlightedPath, e.HasHighlightedPath);\n                    }\n                }));\n            };\n\n            client.OnHighlightedElementRemoved \u002B= (s, e) =\u003E\n            {\n                BeginInvoke(new Action(() =\u003E\n                {\n                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)\n                    {\n                        tvDom.ClearSelection();\n                        txtElementDetails.Text = string.Empty;\n                    }\n                }));\n            };\n\n            client.OnElementClicked \u002B= (s, e) =\u003E\n            {\n                BeginInvoke(new Action(async () =\u003E\n                {\n                    if (lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026 selectedClient.InstanceId == client.InstanceId)\n                    {\n                        _lastUserSelectedDomPath = e.Path;\n                        _lastUserSelectionUtc = DateTime.UtcNow;\n                        _lastHighlightedBrowserPath = e.Path;\n\n                        if (tvDom.SelectNodeByPath(e.Path, ensureVisible: true, raiseAfterSelect: false))\n                        {\n                            txtElementDetails.Text = tvDom.SelectedDomNode?.GetFormattedDetails() ?? string.Empty;\n                        }\n                        else\n                        {\n                            await RefreshDomAsync(client, e.Path, hasTargetPath: true);\n                        }\n                    }\n                }));\n            };\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private async void LstClients_SelectedIndexChanged(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is BrowserClient client)\n            {\n                await RefreshDomAsync(client);\n            }\n        }\n==== REPLACE\n        private async void LstClients_SelectedIndexChanged(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is BrowserClient client)\n            {\n                _lastHighlightedBrowserPath = null;\n                await RefreshDomAsync(client);\n            }\n            else\n            {\n                tvDom.Clear();\n                txtElementDetails.Text = string.Empty;\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private bool _isRefreshingDom = false;\n\n        private async Task RefreshDomAsync(BrowserClient client, string? targetSelectedPath = null, bool hasTargetPath = false)\n        {\n            if (_isRefreshingDom) return;\n            _isRefreshingDom = true;\n\n            try\n            {\n                var rootNode = await client.GetDomNodeAsync();\n                if (rootNode != null)\n                {\n                    string? currentSelectedPath = (tvDom.SelectedNode?.Tag as DomNode)?.Path;\n                    string? selectedPath = hasTargetPath\n                        ? (currentSelectedPath == null ? null : targetSelectedPath)\n                        : currentSelectedPath;\n                    var expandedPaths = new HashSet\u003Cstring\u003E();\n                    if (tvDom.Nodes.Count \u003E 0)\n                    {\n                        SaveExpandedState(tvDom.Nodes[0], expandedPaths);\n                    }\n\n                    tvDom.BeginUpdate();\n                    try\n                    {\n                        tvDom.Nodes.Clear();\n                        var treeNode = BuildTreeNode(rootNode);\n                        tvDom.Nodes.Add(treeNode);\n                        \n                        treeNode.Expand();\n                        RestoreExpandedState(treeNode, expandedPaths);\n\n                        if (!string.IsNullOrEmpty(selectedPath))\n                        {\n                            var nodeToSelect = FindNodeByPath(treeNode, selectedPath);\n                            if (nodeToSelect != null)\n                            {\n                                tvDom.SelectedNode = nodeToSelect;\n                                nodeToSelect.EnsureVisible();\n                            }\n                            else\n                            {\n                                tvDom.SelectedNode = null;\n                                txtElementDetails.Text = string.Empty;\n                            }\n                        }\n                        else\n                        {\n                            tvDom.SelectedNode = null;\n                            txtElementDetails.Text = string.Empty;\n                        }\n                    }\n                    finally\n                    {\n                        tvDom.EndUpdate();\n                    }\n                }\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to fetch DOM: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                _isRefreshingDom = false;\n            }\n        }\n\n        private void SaveExpandedState(TreeNode node, HashSet\u003Cstring\u003E expandedPaths)\n        {\n            if (node.IsExpanded \u0026\u0026 node.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path))\n            {\n                expandedPaths.Add(domNode.Path);\n            }\n            foreach (TreeNode child in node.Nodes)\n            {\n                SaveExpandedState(child, expandedPaths);\n            }\n        }\n\n        private void RestoreExpandedState(TreeNode node, HashSet\u003Cstring\u003E expandedPaths)\n        {\n            if (node.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 expandedPaths.Contains(domNode.Path))\n            {\n                node.Expand();\n            }\n            foreach (TreeNode child in node.Nodes)\n            {\n                RestoreExpandedState(child, expandedPaths);\n            }\n        }\n\n        private TreeNode? FindNodeByPath(TreeNode root, string path)\n        {\n            if (root.Tag is DomNode domNode \u0026\u0026 domNode.Path == path)\n                return root;\n\n            foreach (TreeNode child in root.Nodes)\n            {\n                var found = FindNodeByPath(child, path);\n                if (found != null) return found;\n            }\n\n            return null;\n        }\n\n        private TreeNode BuildTreeNode(DomNode domNode)\n        {\n            string text = \u0022\u0022;\n            if (domNode.Type == \u0022element\u0022)\n            {\n                text = $\u0022\u003C{domNode.TagName}\u0022;\n                if (domNode.Attributes != null)\n                {\n                    foreach (var attr in domNode.Attributes)\n                    {\n                        text \u002B= $\u0022 {attr.Key}=\\\u0022{attr.Value}\\\u0022\u0022;\n                    }\n                }\n                text \u002B= \u0022\u003E\u0022;\n                text \u002B= $\u0022...\u003C/{domNode.TagName}\u003E\u0022; // Pad width for collapsed state\n            }\n            else\n            {\n                text = $\u0022\\\u0022{domNode.Text}\\\u0022\u0022;\n            }\n\n            var treeNode = new TreeNode(text)\n            {\n                Tag = domNode\n            };\n\n            if (domNode.Children != null)\n            {\n                foreach (var child in domNode.Children)\n                {\n                    treeNode.Nodes.Add(BuildTreeNode(child));\n                }\n            }\n\n            return treeNode;\n        }\n\n        private async void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)\n        {\n            if (e.Node?.Tag is DomNode domNode)\n            {\n                txtElementDetails.Text = domNode.GetFormattedDetails();\n\n                if (domNode.Type == \u0022element\u0022 \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n                {\n                    try\n                    {\n                        await client.HighlightElementAsync(domNode.Path);\n                    }\n                    catch { /* Ignore highlight errors */ }\n                }\n            }\n        }\n\n        private void TvDom_NodeMouseClick(object? sender, TreeNodeMouseClickEventArgs e)\n        {\n            if (e.Button == MouseButtons.Right)\n            {\n                tvDom.SelectedNode = e.Node;\n                if (e.Node.Tag is DomNode domNode \u0026\u0026 domNode.Type == \u0022element\u0022)\n                {\n                    ctxDomNode.Show(tvDom, e.Location);\n                }\n            }\n        }\n==== REPLACE\n        private int _domRefreshInFlight;\n        private (BrowserClient Client, string? TargetPath, bool HasTargetPath)? _pendingDomRefresh;\n        private string? _lastUserSelectedDomPath;\n        private DateTime _lastUserSelectionUtc = DateTime.MinValue;\n        private CancellationTokenSource? _highlightDebounceCts;\n        private string? _lastHighlightedBrowserPath;\n\n        private async Task RefreshDomAsync(BrowserClient client, string? targetSelectedPath = null, bool hasTargetPath = false)\n        {\n            if (Interlocked.CompareExchange(ref _domRefreshInFlight, 1, 0) != 0)\n            {\n                _pendingDomRefresh = (client, targetSelectedPath, hasTargetPath);\n                return;\n            }\n\n            try\n            {\n                BrowserClient currentClient = client;\n                string? currentTarget = targetSelectedPath;\n                bool currentHasTarget = hasTargetPath;\n\n                while (true)\n                {\n                    _pendingDomRefresh = null;\n                    DateTime fetchStartedUtc = DateTime.UtcNow;\n\n                    string? previousSelectedPath = tvDom.SelectedPath;\n                    var expandedPaths = tvDom.GetExpandedPathsSnapshot();\n\n                    // Fetch, deserialize, and index the entire DOM tree on a background thread\n                    var snapshot = await Task.Run(async () =\u003E\n                    {\n                        var rootNode = await currentClient.GetDomNodeAsync().ConfigureAwait(false);\n                        return rootNode != null ? Controls.DomTreeSnapshot.Build(rootNode) : null;\n                    });\n\n                    if (snapshot != null \u0026\u0026\n                        lstClients.SelectedItem is BrowserClient selectedClient \u0026\u0026\n                        selectedClient.InstanceId == currentClient.InstanceId)\n                    {\n                        bool userSelectedDuringFetch = _lastUserSelectionUtc \u003E fetchStartedUtc \u0026\u0026\n                                                       !string.IsNullOrEmpty(_lastUserSelectedDomPath);\n\n                        string? finalSelectedPath;\n                        if (userSelectedDuringFetch)\n                        {\n                            finalSelectedPath = _lastUserSelectedDomPath;\n                        }\n                        else if (currentHasTarget)\n                        {\n                            finalSelectedPath = !string.IsNullOrEmpty(currentTarget) ? currentTarget : previousSelectedPath;\n                        }\n                        else\n                        {\n                            finalSelectedPath = previousSelectedPath;\n                        }\n\n                        bool scrollSelectionIntoView = userSelectedDuringFetch ||\n                            (currentHasTarget \u0026\u0026 !string.IsNullOrEmpty(currentTarget) \u0026\u0026\n                             !string.Equals(currentTarget, previousSelectedPath, StringComparison.Ordinal));\n\n                        tvDom.ApplySnapshot(\n                            snapshot,\n                            expandedPaths,\n                            finalSelectedPath,\n                            ensureSelectedVisible: scrollSelectionIntoView,\n                            raiseAfterSelect: false);\n\n                        var selectedDom = tvDom.SelectedDomNode;\n                        if (selectedDom != null)\n                        {\n                            string details = selectedDom.GetFormattedDetails();\n                            if (!string.Equals(txtElementDetails.Text, details, StringComparison.Ordinal))\n                            {\n                                txtElementDetails.Text = details;\n                            }\n                        }\n                        else\n                        {\n                            txtElementDetails.Text = string.Empty;\n                        }\n                    }\n\n                    if (_pendingDomRefresh.HasValue)\n                    {\n                        var next = _pendingDomRefresh.Value;\n                        _pendingDomRefresh = null;\n                        currentClient = next.Client;\n                        currentTarget = next.TargetPath;\n                        currentHasTarget = next.HasTargetPath;\n                        await Task.Delay(150);\n                        continue;\n                    }\n\n                    break;\n                }\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to fetch DOM: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                Interlocked.Exchange(ref _domRefreshInFlight, 0);\n            }\n        }\n\n        private void HighlightElementInBrowserDebounced(BrowserClient client, string selector)\n        {\n            if (string.IsNullOrEmpty(selector))\n                return;\n\n            if (string.Equals(_lastHighlightedBrowserPath, selector, StringComparison.Ordinal))\n                return;\n\n            _lastHighlightedBrowserPath = selector;\n            _highlightDebounceCts?.Cancel();\n            var cts = new CancellationTokenSource();\n            _highlightDebounceCts = cts;\n            var token = cts.Token;\n\n            _ = Task.Run(async () =\u003E\n            {\n                try\n                {\n                    await Task.Delay(25, token).ConfigureAwait(false);\n                    if (!token.IsCancellationRequested)\n                    {\n                        await client.HighlightElementAsync(selector, token).ConfigureAwait(false);\n                    }\n                }\n                catch\n                {\n                    // Ignore transient or canceled highlight commands\n                }\n            }, token);\n        }\n\n        private void TvDom_AfterSelect(object? sender, TreeViewEventArgs e)\n        {\n            if (e.Node?.Tag is DomNode domNode)\n            {\n                _lastUserSelectedDomPath = domNode.Path;\n                _lastUserSelectionUtc = DateTime.UtcNow;\n                txtElementDetails.Text = domNode.GetFormattedDetails();\n\n                if (domNode.Type == \u0022element\u0022 \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n                {\n                    HighlightElementInBrowserDebounced(client, domNode.Path);\n                }\n            }\n        }\n\n        private void TvDom_NodeMouseClick(object? sender, TreeNodeMouseClickEventArgs e)\n        {\n            if (e.Button == MouseButtons.Right \u0026\u0026 e.Node?.Tag is DomNode domNode \u0026\u0026 domNode.Type == \u0022element\u0022)\n            {\n                ctxDomNode.Show(tvDom, e.Location);\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n                case TreeView treeView:\n                    treeView.BorderStyle = BorderStyle.FixedSingle;\n                    break;\n==== REPLACE\n                case TreeView treeView:\n                    treeView.BorderStyle = BorderStyle.FixedSingle;\n                    break;\n                case Controls.DomTreeView domTreeView:\n                    domTreeView.BorderStyle = BorderStyle.FixedSingle;\n                    break;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnGeneralizeContainer_Click(object? sender, EventArgs e)\n        {\n            if (!string.IsNullOrWhiteSpace(txtContainerSelector.Text))\n            {\n                DomNode? rootDom = tvDom.Nodes.Count \u003E 0 ? tvDom.Nodes[0].Tag as DomNode : null;\n                string generalized = SelectorHelper.GeneralizeContainerSelector(txtContainerSelector.Text, rootDom);\n==== REPLACE\n        private void BtnGeneralizeContainer_Click(object? sender, EventArgs e)\n        {\n            if (!string.IsNullOrWhiteSpace(txtContainerSelector.Text))\n            {\n                DomNode? rootDom = tvDom.RootDomNode;\n                string generalized = SelectorHelper.GeneralizeContainerSelector(txtContainerSelector.Text, rootDom);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnGeneralizeScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (lstScrapeFields.SelectedItem is ScrapeField field \u0026\u0026 !string.IsNullOrWhiteSpace(field.Selector))\n            {\n                DomNode? rootDom = tvDom.Nodes.Count \u003E 0 ? tvDom.Nodes[0].Tag as DomNode : null;\n                field.Selector = SelectorHelper.GeneralizeRepeatingFieldSelector(field.Selector, rootDom);\n==== REPLACE\n        private void BtnGeneralizeScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (lstScrapeFields.SelectedItem is ScrapeField field \u0026\u0026 !string.IsNullOrWhiteSpace(field.Selector))\n            {\n                DomNode? rootDom = tvDom.RootDomNode;\n                field.Selector = SelectorHelper.GeneralizeRepeatingFieldSelector(field.Selector, rootDom);\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void AddFieldFromSelectedDomNode(ScrapeDefinition scrape, bool matchAllElements)\n        {\n            if (tvDom.SelectedNode?.Tag is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            DomNode? rootDom = tvDom.Nodes.Count \u003E 0 ? tvDom.Nodes[0].Tag as DomNode : null;\n==== REPLACE\n        private void AddFieldFromSelectedDomNode(ScrapeDefinition scrape, bool matchAllElements)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            DomNode? rootDom = tvDom.RootDomNode;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void SetContainerFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedNode?.Tag is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            DomNode? rootDom = tvDom.Nodes.Count \u003E 0 ? tvDom.Nodes[0].Tag as DomNode : null;\n==== REPLACE\n        private void SetContainerFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            DomNode? rootDom = tvDom.RootDomNode;\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void SetPaginationNextFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedNode?.Tag is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            DomNode? rootDom = tvDom.Nodes.Count \u003E 0 ? tvDom.Nodes[0].Tag as DomNode : null;\n==== REPLACE\n        private void SetPaginationNextFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedDomNode is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            DomNode? rootDom = tvDom.RootDomNode;\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060",
