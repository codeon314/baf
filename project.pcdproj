ationSequence\u003E Sequences { get; set; } = new();        /// \u003Csummary\u003E        /// Gets or sets the ordered collection of \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E configurations in this project.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022scrapes\u0022)]        public List\u003CScrapeDefinition\u003E Scrapes { get; set; } = new();\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH        public string ToJson(bool writeIndented = true)        {            return JsonSerializer.Serialize(this, new JsonSerializerOptions { WriteIndented = writeIndented });        }        public static AutomationProject FromJson(string json)        {            if (string.IsNullOrWhiteSpace(json))                throw new ArgumentException(\u0022Project JSON cannot be empty.\u0022, nameof(json));            try            {                var project = JsonSerializer.Deserialize\u003CAutomationProject\u003E(json);                if (project != null \u0026\u0026 project.Sequences != null)                {                    return project;                }            }            catch            {                // Fallback to legacy format (List\u003CAutomationSequence\u003E)            }            var legacySequences = JsonSerializer.Deserialize\u003CList\u003CAutomationSequence\u003E\u003E(json);            if (legacySequences != null)            {                return new AutomationProject                {                    MatchAnySite = true,                    Sequences = legacySequences                };            }            throw new InvalidDataException(\u0022Unable to deserialize AutomationProject from JSON.\u0022);        }        public void SaveToFile(string filePath)        {            File.WriteAllText(filePath, ToJson(true));        }        public Task SaveToFileAsync(string filePath, CancellationToken cancellationToken = default)        {            return File.WriteAllTextAsync(filePath, ToJson(true), cancellationToken);        }        public static AutomationProject LoadFromFile(string filePath)        {            string json = File.ReadAllText(filePath);            return FromJson(json);        }        public static async Task\u003CAutomationProject\u003E LoadFromFileAsync(string filePath, CancellationToken cancellationToken = default)        {            string json = await File.ReadAllTextAsync(filePath, cancellationToken);            return FromJson(json);        }==== REPLACE        /// \u003Csummary\u003E        /// Serializes this \u003Csee cref=\u0022AutomationProject\u0022/\u003E to a JSON string.        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022writeIndented\u0022\u003EWhether to format the JSON output with indentation.\u003C/param\u003E        public string ToJson(bool writeIndented = true)        {            return JsonSerializer.Serialize(this, new JsonSerializerOptions { WriteIndented = writeIndented });        }        /// \u003Csummary\u003E        /// Deserializes an \u003Csee cref=\u0022AutomationProject\u0022/\u003E from a JSON string (supporting both current project JSON and legacy sequence-list JSON).        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022json\u0022\u003EThe JSON string to deserialize.\u003C/param\u003E        public static AutomationProject FromJson(string json)        {            if (string.IsNullOrWhiteSpace(json))                throw new ArgumentException(\u0022Project JSON cannot be empty.\u0022, nameof(json));            try            {                var project = JsonSerializer.Deserialize\u003CAutomationProject\u003E(json);                if (project != null \u0026\u0026 project.Sequences != null)                {                    return project;                }            }            catch            {                // Fallback to legacy format (List\u003CAutomationSequence\u003E)            }            var legacySequences = JsonSerializer.Deserialize\u003CList\u003CAutomationSequence\u003E\u003E(json);            if (legacySequences != null)            {                return new AutomationProject                {                    MatchAnySite = true,                    Sequences = legacySequences                };            }            throw new InvalidDataException(\u0022Unable to deserialize AutomationProject from JSON.\u0022);        }        /// \u003Csummary\u003E        /// Saves this \u003Csee cref=\u0022AutomationProject\u0022/\u003E as indented JSON to the specified file path.        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022filePath\u0022\u003EThe destination file path.\u003C/param\u003E        public void SaveToFile(string filePath)        {            File.WriteAllText(filePath, ToJson(true));        }        /// \u003Csummary\u003E        /// Asynchronously saves this \u003Csee cref=\u0022AutomationProject\u0022/\u003E as indented JSON to the specified file path.        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022filePath\u0022\u003EThe destination file path.\u003C/param\u003E        /// \u003Cparam name=\u0022cancellationToken\u0022\u003EA token to monitor for cancellation requests.\u003C/param\u003E        public Task SaveToFileAsync(string filePath, CancellationToken cancellationToken = default)        {            return File.WriteAllTextAsync(filePath, ToJson(true), cancellationToken);        }        /// \u003Csummary\u003E        /// Loads an \u003Csee cref=\u0022AutomationProject\u0022/\u003E from a JSON file on disk.        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022filePath\u0022\u003EThe path to the JSON project file.\u003C/param\u003E        public static AutomationProject LoadFromFile(string filePath)        {            string json = File.ReadAllText(filePath);            return FromJson(json);        }        /// \u003Csummary\u003E        /// Asynchronously loads an \u003Csee cref=\u0022AutomationProject\u0022/\u003E from a JSON file on disk.        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022filePath\u0022\u003EThe path to the JSON project file.\u003C/param\u003E        /// \u003Cparam name=\u0022cancellationToken\u0022\u003EA token to monitor for cancellation requests.\u003C/param\u003E        public static async Task\u003CAutomationProject\u003E LoadFromFileAsync(string filePath, CancellationToken cancellationToken = default)        {            string json = await File.ReadAllTextAsync(filePath, cancellationToken);            return FromJson(json);        }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\AutomationSequence.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH    public class AutomationSequence    {        [JsonPropertyName(\u0022id\u0022)]        public string Id { get; set; } = Guid.NewGuid().ToString();        [JsonPropertyName(\u0022name\u0022)]        public string Name { get; set; } = \u0022New Sequence\u0022;        [JsonPropertyName(\u0022isActive\u0022)]        public bool IsActive { get; set; } = true;        [JsonPropertyName(\u0022steps\u0022)]        public List\u003CAutomationStep\u003E Steps { get; set; } = new();        /// \u003Csummary\u003E        /// Creates an \u003Csee cref=\u0022AutomationStep\u0022/\u003E targeting \u003Cparamref name=\u0022domNode\u0022/\u003E and appends it to \u003Csee cref=\u0022Steps\u0022/\u003E.        /// \u003C/summary\u003E        public AutomationStep AddStepFromDomNode(            DomNode domNode,            AutomationActionType actionType,            string value = \u0022\u0022,            bool overwrite = true)        {            if (domNode == null) throw new ArgumentNullException(nameof(domNode));            var step = domNode.CreateStep(actionType, value, overwrite);            Steps.Add(step);            return step;        }        /// \u003Csummary\u003E        /// Moves the step at \u003Cparamref name=\u0022index\u0022/\u003E one position earlier in the sequence.        /// \u003C/summary\u003E        public bool MoveStepUp(int index)        {            if (index \u003C= 0 || index \u003E= Steps.Count) return false;            var step = Steps[index];            Steps.RemoveAt(index);            Steps.Insert(index - 1, step);            return true;        }        public bool MoveStepDown(int index)        {            if (index \u003C 0 || index \u003E= Steps.Count - 1) return false;            var step = Steps[index];            Steps.RemoveAt(index);            Steps.Insert(index \u002B 1, step);            return true;        }        public override string ToString() =\u003E Name;    }==== REPLACE    public class AutomationSequence    {        /// \u003Csummary\u003E        /// Gets or sets the unique identifier for this automation sequence.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022id\u0022)]        public string Id { get; set; } = Guid.NewGuid().ToString();        /// \u003Csummary\u003E        /// Gets or sets the display name of this automation sequence.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022name\u0022)]        public string Name { get; set; } = \u0022New Sequence\u0022;        /// \u003Csummary\u003E        /// Gets or sets whether this sequence is enabled when running all active sequences in a project.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022isActive\u0022)]        public bool IsActive { get; set; } = true;        /// \u003Csummary\u003E        /// Gets or sets the ordered list of \u003Csee cref=\u0022AutomationStep\u0022/\u003E actions in this sequence.        /// \u003C/summary\u003E        [JsonPropertyName(\u0022steps\u0022)]        public List\u003CAutomationStep\u003E Steps { get; set; } = new();        /// \u003Csummary\u003E        /// Creates a new \u003Csee cref=\u0022AutomationStep\u0022/\u003E and appends it to \u003Csee cref=\u0022Steps\u0022/\u003E.        /// \u003C/summary\u003E        /// \u003Cparam name=\u0022name\u0022\u003EDisplay name for the step.\u003C/param\u003E        /// \u003Cparam name=\u0022actionType\u0022\u003EThe action type to execute.\u003C/param\u003E        /// \u003Cparam name=\u0022selector\u0022\u003ETarget CSS selector.\u003C/param\u003E        /// \u003Cparam name=\u0022value\u0022\u003EStep value or payload.\u003C/param\u003E        /// \u003Cparam name=\u0022overwrite\u0022\u003EWhether to overwrite existing text on input steps.\u003C/param\u003E        /// \u003Creturns\u003EThe newly created \u003Csee cref=\u0022AutomationStep\u0022/\u003E.\u003C/returns\u003E        public AutomationStep AddStep(            string name = \u0022New Step\u0022,            AutomationActionType actionType = AutomationActionType.Click,            string selector = \u0022\u0022,            string value = \u0022\u0022,            bool overwrite = true)        {            var step = new AutomationStep            {                Name = string.IsNullOrWhiteSpace(name) ? \u0022New Step\u0022 : name,                ActionType = actionType,                Selector = selector ?? string.Empty,                Value = value ?? string.Empty,                Overwrite = overwrite            };            Steps.Add(step);            return step;        }        /// \u003Csummary\u003E        /// Creates an \u003Csee cref=\u0022AutomationStep\u0022/\u003E targeting \u003Cparamref name=\u0022domNode\u0022/\u003E and appends it to \u003Csee cref=\u0022Steps\u0022/\u003E.        /// \u003C/summary\u003E        public AutomationStep AddStepFromDomNode(            DomNode domNode,            AutomationActionType actionType,            string value = \u0022\u0022,            bool overwrite = true)        {            if (domNode == null) throw new ArgumentNullException(nameof(domNode));            var step = domNode.CreateStep(actionType, value, overwrite);            Steps.Add(step);            return step;        }        /// \u003Csummary\u003E        /// Moves the step at \u003Cparamref name=\u0022index\u0022/\u003E one position earlier in the sequence.        /// \u003C/summary\u003E        public bool MoveStepUp(int index)        {            if (index \u003C= 0 || index \u003E= Steps.Count) return false;            var step = Steps[index];            Steps.RemoveAt(index);            Steps.Insert(index - 1, step);            return true;        }        /// \u003Csummary\u003E        /// Moves the step at \u003Cparamref name=\u0022index\u0022/\u003E one position later in the sequence.        /// \u003C/summary\u003E        public bool MoveStepDown(int index)        {            if (index \u003C 0 || index \u003E= Steps.Count - 1) return false;            var step = Steps[index];            Steps.RemoveAt(index);            Steps.Insert(index \u002B 1, step);            return true;        }        /// \u003Csummary\u003E        /// Returns the display name of this sequence.        /// \u003C/summary\u003E        public override string ToString() =\u003E Name;    }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\AutomationStep.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH    public enum AutomationActionType    {        Click,        SetValue,        Navigate,        EvaluateScript,        Scrape,        Custom,        DumpSite    }    /// \u003Csummary\u003E    /// Represents a single automation step within an \u003Csee cref=\u0022AutomationSequence\u0022/\u003E.    /// \u003C/summary\u003E    public class AutomationStep    {        [Category(\u00221. General\u0022)]        [Description(\u0022Display name for this automation step.\u0022)]        public string Name { get; set; } = \u0022New Step\u0022;        [Category(\u00221. General\u0022)]        [Description(\u0022The type of browser action to execute.\u0022)]        public AutomationActionType ActionType { get; set; }        [Category(\u00222. Target \u0026 Payload\u0022)]        [Description(\u0022CSS selector of the target DOM element (for Click, SetValue, or ad-hoc Scrape steps).\u0022)]        public string Selector { get; set; } = string.Empty;        [Category(\u00222. Target \u0026 Payload\u0022)]        [Description(\u0022Input text, target URL, JavaScript code, Scrape list name, or dump output folder path.\u0022)]        public string Value { get; set; } = string.Empty;        [Category(\u00222. Target \u0026 Payload\u0022)]        [Description(\u0022Custom command identifier, ScrapeExtractionType, or SiteDumpType depending on ActionType.\u0022)]        public string CustomCommandType { get; set; } = string.Empty;        [Category(\u00223. Behavior\u0022)]        [Description(\u0022When true on SetValue, replaces existing input text instead of appending.\u0022)]        public bool Overwrite { get; set; } = true;        [Category(\u00223. Behavior\u0022)]        [Description(\u0022Delay in milliseconds to wait after this step completes.\u0022)]        public int DelayAfterMs { get; set; } = 500;        public override string ToString() =\u003E $\u0022{Name} ({ActionType})\u0022;    }==== REPLACE    public enum AutomationActionType    {        /// \u003Csummary\u003E        /// Simulates a trusted React or native click on the target element.        /// \u003C/summary\u003E        Click,        /// \u003Csummary\u003E        /// Sets the value of an input or textarea element, bypassing React\u0027s native value tracker.        /// \u003C/summary\u003E        SetValue,        /// \u003Csummary\u003E        /// Navigates the browser tab to a target URL and waits for the page transition to complete.        /// \u003C/summary\u003E        Navigate,        /// \u003Csummary\u003E        /// Evaluates custom JavaScript code in the context of the page.        /// \u003C/summary\u003E        EvaluateScript,        /// \u003Csummary\u003E        /// Executes a registered \u003Csee cref=\u0022ScrapeDefinition\u0022/\u003E or an ad-hoc single-field scrape.        /// \u003C/summary\u003E        Scrape,        /// \u003Csummary\u003E        /// Executes a custom command handler or sends a raw command type to the browser bridge.        /// \u003C/summary\u003E        Custom,        /// \u003Csummary\u003E        /// Executes a reverse-engineering site dump (\u003Csee cref=\u0022SiteDumpType\u0022/\u003E) and optionally saves the output to disk.        /// \u003C/summary\u003E        DumpSite    }    /// \u003Csummary\u003E    /// Represents a single automation step within an \u003Csee cref=\u0022AutomationSequence\u0022/\u003E.    /// \u003C/summary\u003E    public class AutomationStep    {        /// \u003Csummary\u003E        /// Gets or sets the display name for this automation step.        /// \u003C/summary\u003E        [Category(\u00221. General\u0022)]        [Description(\u0022Display name for this automation step.\u0022)]        public string Name { get; set; } = \u0022New Step\u0022;        /// \u003Csummary\u003E        /// Gets or sets the type of browser action to execute.        /// \u003C/summary\u003E        [Category(\u00221. General\u0022)]        [Description(\u0022The type of browser action to execute.\u0022)]        public AutomationActionType ActionType { get; set; }        /// \u003Csummary\u003E        /// Gets or sets the CSS selector of the target DOM element (for Click, SetValue, or ad-hoc Scrape steps).        /// \u003C/summary\u003E        [Category(\u00222. Target \u0026 Payload\u0022)]        [Description(\u0022CSS selector of the target DOM element (for Click, SetValue, or ad-hoc Scrape steps).\u0022)]        public string Selector { get; set; } = string.Empty;        /// \u003Csummary\u003E        /// Gets or sets the input text, target URL, JavaScript code, Scrape list name, or dump output folder path.        /// \u003C/summary\u003E        [Category(\u00222. Target \u0026 Payload\u0022)]        [Description(\u0022Input text, target URL, JavaScript code, Scrape list name, or dump output folder path.\u0022)]        public string Value { get; set; } = string.Empty;        /// \u003Csummary\u003E        /// Gets or sets the custom command identifier, \u003Csee cref=\u0022ScrapeExtractionType\u0022/\u003E, or \u003Csee cref=\u0022SiteDumpType\u0022/\u003E depending on \u003Csee cref=\u0022ActionType\u0022/\u003E.        /// \u003C/summary\u003E        [Category(\u00222. Target \u0026 Payload\u0022)]        [Description(\u0022Custom command identifier, ScrapeExtractionType, or SiteDumpType depending on ActionType.\u0022)]        public string CustomCommandType { get; set; } = string.Empty;        /// \u003Csummary\u003E        /// Gets or sets whether to replace existing input text instead of appending when \u003Csee cref=\u0022ActionType\u0022/\u003E is \u003Csee cref=\u0022AutomationActionType.SetValue\u0022/\u003E.        /// \u003C/summary\u003E        [Category(\u00223. Behavior\u0022)]        [Description(\u0022When true on SetValue, replaces existing input text instead of appending.\u0022)]        public bool Overwrite { get; set; } = true;        /// \u003Csummary\u003E        /// Gets or sets the delay in milliseconds to wait after this step completes.        /// \u003C/summary\u003E        [Category(\u00223. Behavior\u0022)]        [Description(\u0022Delay in milliseconds to wait after this step completes.\u0022)]        public int DelayAfterMs { get; set; } = 500;        /// \u003Csummary\u003E        /// Returns a formatted string representation of this step and its action type.        /// \u003C/summary\u003E        public override string ToString() =\u003E $\u0022{Name} ({ActionType})\u0022;    }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\BrowserEventArgs.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH    public class DomChangedEventArgs : EventArgs    {        public string? HighlightedPath { get; }        public bool HasHighlightedPath { get; }        public DomChangedEventArgs(string? highlightedPath, bool hasHighlightedPath)        {            HighlightedPath = highlightedPath;            HasHighlightedPath = hasHighlightedPath;        }    }    /// \u003Csummary\u003E    /// Event arguments raised when the user middle-clicks an element in the connected browser tab.    /// \u003C/summary\u003E    public class ElementClickedEventArgs : EventArgs    {        public string Path { get; }        public ElementClickedEventArgs(string path)        {            Path = path;        }    }    /// \u003Csummary\u003E    /// Event arguments raised when a page load or in-place navigation completes in the browser tab.    /// \u003C/summary\u003E    public class PageLoadedEventArgs : EventArgs    {        public string PageLoadId { get; }        public string Url { get; }        public string ReadyState { get; }        public int StatusCode { get; }        public string? RetryAfter { get; }        public PageLoadedEventArgs(string pageLoadId, string url, string readyState, int statusCode = 200, string? retryAfter = null)        {            PageLoadId = pageLoadId;            Url = url;            ReadyState = readyState;            StatusCode = statusCode;            RetryAfter = retryAfter;        }    }    /// \u003Csummary\u003E    /// Event arguments raised before waiting between paginated scrape pages.    /// \u003C/summary\u003E    public class ScrapePageDelayEventArgs : EventArgs    {        public ScrapeDefinition Definition { get; }        public int NextPageNumber { get; }        public int DelayMs { get; }        public ScrapePageDelayEventArgs(ScrapeDefinition definition, int nextPageNumber, int delayMs)        {            Definition = definition;            NextPageNumber = nextPageNumber;            DelayMs = delayMs;        }    }    /// \u003Csummary\u003E    /// Event arguments raised when an HTTP 429 rate-limit response is detected during scraping.    /// \u003C/summary\u003E    public class ScrapeRateLimitEventArgs : EventArgs    {        public ScrapeDefinition Definition { get; }        public int PageNumber { get; }        public string? RetryAfterHeader { get; }        public DateTimeOffset RetryAtUtc { get; }        public TimeSpan WaitDuration { get; }        public bool IsDateHeader { get; }        public int NewPageDelayMs { get; }        public ScrapeRateLimitEventArgs(            ScrapeDefinition definition,            int pageNumber,            string? retryAfterHeader,            DateTimeOffset retryAtUtc,            TimeSpan waitDuration,            bool isDateHeader,            int newPageDelayMs)        {            Definition = definition;            PageNumber = pageNumber;            RetryAfterHeader = retryAfterHeader;            RetryAtUtc = retryAtUtc;            WaitDuration = waitDuration;            IsDateHeader = isDateHeader;            NewPageDelayMs = newPageDelayMs;        }    }    /// \u003Csummary\u003E    /// Event arguments raised when an \u003Csee cref=\u0022AutomationSequence\u0022/\u003E starts or completes.    /// \u003C/summary\u003E    public class AutomationSequenceEventArgs : EventArgs    {        public AutomationSequence Sequence { get; }        public AutomationSequenceEventArgs(AutomationSequence sequence)        {            Sequence = sequence;        }    }    /// \u003Csummary\u003E    /// Event arguments raised when an \u003Csee cref=\u0022AutomationStep\u0022/\u003E starts, completes, or fails.    /// \u003C/summary\u003E    public class AutomationStepEventArgs : EventArgs    {        public AutomationSequence? Sequence { get; }        public AutomationStep Step { get; }        public CommandResult? Result { get; }        public Exception? Error { get; }        public AutomationStepEventArgs(AutomationSequence? sequence, AutomationStep step, CommandResult? result = null, Exception? error = null)        {            Sequence = sequence;            Step = step;            Result = result;        