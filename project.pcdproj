Scraper;\n        private System.Windows.Forms.ToolStripSeparator mnuDomSeparator1;\n        private System.Windows.Forms.ToolStripMenuItem mnuQuickScrapeText;\n        private System.Windows.Forms.ToolStripMenuItem mnuAddScrapeFieldTo;\n        private System.Windows.Forms.ToolStripMenuItem mnuAddRepeatingFieldTo;\n        private System.Windows.Forms.ToolStripMenuItem mnuSetScrapeContainerFor;\n        private System.Windows.Forms.ToolStripMenuItem mnuSetPaginationNextFor;\n    }\n}\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\TestBedApp\\MainForm.cs**\n\u0060\u0060\u0060cs\n\u003C\u003C\u003C\u003C SEARCH\nusing BrowserAutomationFramework.Automation;\nusing BrowserAutomationFramework.Extensions;\nusing BrowserAutomationFramework.Generators;\nusing BrowserAutomationFramework.Models;\nusing BrowserAutomationFramework.Server;\nusing TestBedApp.Utils;\n\nnamespace TestBedApp\n{\n    public partial class MainForm : Form\n    {\n        private AutomationServer? _server;\n        private CancellationTokenSource? _cts;\n        private readonly AutomationRunner _runner;\n        private System.Windows.Forms.Timer _clientRefreshTimer;\n\n        public MainForm()\n        {\n            InitializeComponent();\n            ApplyFixedSingleBorders(this);\n            \n            cmbMode.DataSource = Enum.GetValues(typeof(IpcMode));\n            cmbMode.SelectedIndex = 1;\n\n            _runner = new AutomationRunner();\n            _runner.OnSequenceStarted \u002B= (s, e) =\u003E Log($\u0022[AUTO] --- Starting List: {e.Sequence.Name} ---\u0022, Color.Magenta);\n            _runner.OnStepStarted \u002B= (s, e) =\u003E Log($\u0022[AUTO] Executing: {e.Step.Name}\u0022, Color.Plum);\n            _runner.OnStepCompleted \u002B= (s, e) =\u003E\n            {\n                if (e.Result != null)\n                {\n                    Log($\u0022[AUTO-RX] {e.Result.Status} | {e.Result.Output}\u0022, Color.White);\n                }\n            };\n\n            _clientRefreshTimer = new System.Windows.Forms.Timer { Interval = 2000 };\n            _clientRefreshTimer.Tick \u002B= ClientRefreshTimer_Tick;\n        }\n==== REPLACE\nusing BrowserAutomationFramework.Automation;\nusing BrowserAutomationFramework.Extensions;\nusing BrowserAutomationFramework.Generators;\nusing BrowserAutomationFramework.Models;\nusing BrowserAutomationFramework.Scraping;\nusing BrowserAutomationFramework.Server;\nusing TestBedApp.Utils;\n\nnamespace TestBedApp\n{\n    public partial class MainForm : Form\n    {\n        private AutomationServer? _server;\n        private CancellationTokenSource? _cts;\n        private readonly AutomationRunner _runner;\n        private readonly DataScraper _scraper;\n        private ScrapeResult? _lastScrapeResult;\n        private bool _isUpdatingScrapeUi;\n        private System.Windows.Forms.Timer _clientRefreshTimer;\n\n        // Data Scraper Tab Controls\n        private CheckedListBox chkLstScrapes = null!;\n        private TextBox txtContainerSelector = null!;\n        private ComboBox cmbPreScrapeSeq = null!;\n        private ComboBox cmbPostScrapeSeq = null!;\n        private CheckBox chkEnablePagination = null!;\n        private NumericUpDown numMaxPages = null!;\n        private TextBox txtNextPageSelector = null!;\n        private ListBox lstScrapeFields = null!;\n        private PropertyGrid pgScrapeFieldDetails = null!;\n        private Button btnPreviewScrape = null!;\n        private Button btnRunAllScrapes = null!;\n        private Label lblScrapeStatus = null!;\n        private DataGridView dgvScrapePreview = null!;\n        private TextBox txtScrapeJsonPreview = null!;\n\n        public MainForm()\n        {\n            InitializeComponent();\n            InitializeScraperTabUi();\n            ApplyFixedSingleBorders(this);\n            \n            cmbMode.DataSource = Enum.GetValues(typeof(IpcMode));\n            cmbMode.SelectedIndex = 1;\n\n            _runner = new AutomationRunner();\n            _runner.OnSequenceStarted \u002B= (s, e) =\u003E Log($\u0022[AUTO] --- Starting List: {e.Sequence.Name} ---\u0022, Color.Magenta);\n            _runner.OnStepStarted \u002B= (s, e) =\u003E Log($\u0022[AUTO] Executing: {e.Step.Name}\u0022, Color.Plum);\n            _runner.OnStepCompleted \u002B= (s, e) =\u003E\n            {\n                if (e.Result != null)\n                {\n                    Log($\u0022[AUTO-RX] {e.Result.Status} | {e.Result.Output}\u0022, Color.White);\n                }\n            };\n            _runner.OnScrapeCompleted \u002B= (s, e) =\u003E\n            {\n                if (e.Result != null)\n                {\n                    Invoke(new Action(() =\u003E DisplayScrapeResult(e.Result)));\n                }\n            };\n\n            _scraper = new DataScraper(_runner);\n            _scraper.OnScrapeStarted \u002B= (s, e) =\u003E Log($\u0022[SCRAPE] --- Starting Scrape: {e.Definition.Name} ---\u0022, Color.SpringGreen);\n            _scraper.OnScrapePageCompleted \u002B= (s, e) =\u003E Log($\u0022[SCRAPE] Page {e.PageNumber} extracted {e.PageRecords.Count} record(s).\u0022, Color.LightGreen);\n            _scraper.OnScrapeCompleted \u002B= (s, e) =\u003E\n            {\n                if (e.Result != null)\n                {\n                    Log($\u0022[SCRAPE] Completed \u0027{e.Definition.Name}\u0027: {e.Result.RecordCount} total record(s) across {e.Result.PagesScraped} page(s).\u0022, Color.Lime);\n                    Invoke(new Action(() =\u003E DisplayScrapeResult(e.Result)));\n                }\n            };\n            _scraper.OnScrapeFailed \u002B= (s, e) =\u003E Log($\u0022[SCRAPE-ERR] \u0027{e.Definition.Name}\u0027 failed: {e.Error?.Message}\u0022, Color.Red);\n\n            _clientRefreshTimer = new System.Windows.Forms.Timer { Interval = 2000 };\n            _clientRefreshTimer.Tick \u002B= ClientRefreshTimer_Tick;\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private AutomationProject BuildCurrentProjectFromUi()\n        {\n            return new AutomationProject\n            {\n                MatchAnySite = chkMatchAnySite.Checked,\n                MatchUrls = lstMatchUrls.Items.Cast\u003Cstring\u003E().ToList(),\n                Sequences = chkLstSequences.Items.Cast\u003CAutomationSequence\u003E().ToList()\n            };\n        }\n\n        private void ApplyProjectToUi(AutomationProject project)\n        {\n            chkMatchAnySite.Checked = project.MatchAnySite;\n            lstMatchUrls.Items.Clear();\n            foreach (var url in project.MatchUrls)\n            {\n                lstMatchUrls.Items.Add(url);\n            }\n\n            chkLstSequences.Items.Clear();\n            lstSteps.Items.Clear();\n            foreach (var seq in project.Sequences)\n            {\n                chkLstSequences.Items.Add(seq, seq.IsActive);\n            }\n\n            if (chkLstSequences.Items.Count \u003E 0)\n            {\n                chkLstSequences.SelectedIndex = 0;\n            }\n        }\n==== REPLACE\n        private AutomationProject BuildCurrentProjectFromUi()\n        {\n            return new AutomationProject\n            {\n                MatchAnySite = chkMatchAnySite.Checked,\n                MatchUrls = lstMatchUrls.Items.Cast\u003Cstring\u003E().ToList(),\n                Sequences = chkLstSequences.Items.Cast\u003CAutomationSequence\u003E().ToList(),\n                Scrapes = chkLstScrapes.Items.Cast\u003CScrapeDefinition\u003E().ToList()\n            };\n        }\n\n        private void ApplyProjectToUi(AutomationProject project)\n        {\n            chkMatchAnySite.Checked = project.MatchAnySite;\n            lstMatchUrls.Items.Clear();\n            foreach (var url in project.MatchUrls)\n            {\n                lstMatchUrls.Items.Add(url);\n            }\n\n            chkLstSequences.Items.Clear();\n            lstSteps.Items.Clear();\n            foreach (var seq in project.Sequences)\n            {\n                chkLstSequences.Items.Add(seq, seq.IsActive);\n            }\n\n            if (chkLstSequences.Items.Count \u003E 0)\n            {\n                chkLstSequences.SelectedIndex = 0;\n            }\n\n            RefreshAutomationSequenceDropdowns();\n\n            chkLstScrapes.Items.Clear();\n            lstScrapeFields.Items.Clear();\n            pgScrapeFieldDetails.SelectedObject = null;\n            foreach (var scrape in project.Scrapes)\n            {\n                chkLstScrapes.Items.Add(scrape, scrape.IsActive);\n            }\n\n            if (chkLstScrapes.Items.Count \u003E 0)\n            {\n                chkLstScrapes.SelectedIndex = 0;\n            }\n            else\n            {\n                LoadSelectedScrapeToUi();\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void CtxDomNode_Opening(object? sender, System.ComponentModel.CancelEventArgs e)\n        {\n            mnuAddClickTo.DropDownItems.Clear();\n            mnuAddSetValueTo.DropDownItems.Clear();\n\n            if (chkLstSequences.Items.Count == 0)\n            {\n                mnuAddClickTo.DropDownItems.Add(new ToolStripMenuItem(\u0022(No lists available)\u0022) { Enabled = false });\n                mnuAddSetValueTo.DropDownItems.Add(new ToolStripMenuItem(\u0022(No lists available)\u0022) { Enabled = false });\n                return;\n            }\n\n            foreach (AutomationSequence seq in chkLstSequences.Items)\n            {\n                var clickItem = new ToolStripMenuItem(seq.Name);\n                clickItem.Click \u002B= (s, args) =\u003E AddStepToSequence(seq, AutomationActionType.Click);\n                mnuAddClickTo.DropDownItems.Add(clickItem);\n\n                var setValItem = new ToolStripMenuItem(seq.Name);\n                setValItem.Click \u002B= (s, args) =\u003E AddStepToSequence(seq, AutomationActionType.SetValue);\n                mnuAddSetValueTo.DropDownItems.Add(setValItem);\n            }\n        }\n==== REPLACE\n        private void CtxDomNode_Opening(object? sender, System.ComponentModel.CancelEventArgs e)\n        {\n            mnuAddClickTo.DropDownItems.Clear();\n            mnuAddSetValueTo.DropDownItems.Clear();\n\n            if (chkLstSequences.Items.Count == 0)\n            {\n                mnuAddClickTo.DropDownItems.Add(new ToolStripMenuItem(\u0022(No lists available)\u0022) { Enabled = false });\n                mnuAddSetValueTo.DropDownItems.Add(new ToolStripMenuItem(\u0022(No lists available)\u0022) { Enabled = false });\n            }\n            else\n            {\n                foreach (AutomationSequence seq in chkLstSequences.Items)\n                {\n                    var clickItem = new ToolStripMenuItem(seq.Name);\n                    clickItem.Click \u002B= (s, args) =\u003E AddStepToSequence(seq, AutomationActionType.Click);\n                    mnuAddClickTo.DropDownItems.Add(clickItem);\n\n                    var setValItem = new ToolStripMenuItem(seq.Name);\n                    setValItem.Click \u002B= (s, args) =\u003E AddStepToSequence(seq, AutomationActionType.SetValue);\n                    mnuAddSetValueTo.DropDownItems.Add(setValItem);\n                }\n            }\n\n            PopulateScrapeSubMenu(mnuAddScrapeFieldTo, scrape =\u003E AddFieldFromSelectedDomNode(scrape, matchAllElements: false));\n            PopulateScrapeSubMenu(mnuAddRepeatingFieldTo, scrape =\u003E AddFieldFromSelectedDomNode(scrape, matchAllElements: true));\n            PopulateScrapeSubMenu(mnuSetScrapeContainerFor, SetContainerFromSelectedDomNode);\n            PopulateScrapeSubMenu(mnuSetPaginationNextFor, SetPaginationNextFromSelectedDomNode);\n        }\n\n        private void PopulateScrapeSubMenu(ToolStripMenuItem parentMenu, Action\u003CScrapeDefinition\u003E onSelect)\n        {\n            parentMenu.DropDownItems.Clear();\n\n            foreach (ScrapeDefinition scrape in chkLstScrapes.Items)\n            {\n                var item = new ToolStripMenuItem(scrape.Name);\n                item.Click \u002B= (s, e) =\u003E onSelect(scrape);\n                parentMenu.DropDownItems.Add(item);\n            }\n\n            if (chkLstScrapes.Items.Count \u003E 0)\n            {\n                parentMenu.DropDownItems.Add(new ToolStripSeparator());\n            }\n\n            var createNewItem = new ToolStripMenuItem(\u0022(\u002B New Scrape List...)\u0022);\n            createNewItem.Click \u002B= (s, e) =\u003E\n            {\n                string defaultName = $\u0022Scrape {chkLstScrapes.Items.Count \u002B 1}\u0022;\n                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022New Scrape List\u0022, defaultName);\n                if (!string.IsNullOrWhiteSpace(name))\n                {\n                    var newScrape = new ScrapeDefinition { Name = name.Trim() };\n                    chkLstScrapes.Items.Add(newScrape, true);\n                    chkLstScrapes.SelectedItem = newScrape;\n                    onSelect(newScrape);\n                }\n            };\n            parentMenu.DropDownItems.Add(createNewItem);\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void MnuFileNew_Click(object? sender, EventArgs e)\n        {\n            chkMatchAnySite.Checked = true;\n            lstMatchUrls.Items.Clear();\n            chkLstSequences.Items.Clear();\n            lstSteps.Items.Clear();\n            Log(\u0022[SYS] Started new automation project.\u0022, Color.Cyan);\n        }\n==== REPLACE\n        private void MnuFileNew_Click(object? sender, EventArgs e)\n        {\n            chkMatchAnySite.Checked = true;\n            lstMatchUrls.Items.Clear();\n            chkLstSequences.Items.Clear();\n            lstSteps.Items.Clear();\n            chkLstScrapes.Items.Clear();\n            lstScrapeFields.Items.Clear();\n            pgScrapeFieldDetails.SelectedObject = null;\n            RefreshAutomationSequenceDropdowns();\n            LoadSelectedScrapeToUi();\n            Log(\u0022[SYS] Started new automation project.\u0022, Color.Cyan);\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnAddSequence_Click(object? sender, EventArgs e)\n        {\n            string name = PromptForValue(\u0022Enter new list name:\u0022, \u0022Add Automation List\u0022);\n            if (!string.IsNullOrWhiteSpace(name))\n            {\n                var seq = new AutomationSequence { Name = name };\n                chkLstSequences.Items.Add(seq, true);\n                chkLstSequences.SelectedItem = seq;\n            }\n        }\n\n        private void BtnRemoveSequence_Click(object? sender, EventArgs e)\n        {\n            if (chkLstSequences.SelectedItem != null)\n            {\n                chkLstSequences.Items.Remove(chkLstSequences.SelectedItem);\n            }\n        }\n==== REPLACE\n        private void BtnAddSequence_Click(object? sender, EventArgs e)\n        {\n            string name = PromptForValue(\u0022Enter new list name:\u0022, \u0022Add Automation List\u0022);\n            if (!string.IsNullOrWhiteSpace(name))\n            {\n                var seq = new AutomationSequence { Name = name };\n                chkLstSequences.Items.Add(seq, true);\n                chkLstSequences.SelectedItem = seq;\n                RefreshAutomationSequenceDropdowns();\n            }\n        }\n\n        private void BtnRemoveSequence_Click(object? sender, EventArgs e)\n        {\n            if (chkLstSequences.SelectedItem != null)\n            {\n                chkLstSequences.Items.Remove(chkLstSequences.SelectedItem);\n                RefreshAutomationSequenceDropdowns();\n            }\n        }\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n        private void BtnRenameSeq_Click(object? sender, EventArgs e)\n        {\n            if (chkLstSequences.SelectedItem is AutomationSequence seq)\n            {\n                string name = PromptForValue(\u0022Enter new list name:\u0022, \u0022Rename Automation List\u0022);\n                if (!string.IsNullOrWhiteSpace(name))\n                {\n                    seq.Name = name;\n                    int idx = chkLstSequences.SelectedIndex;\n                    bool isChecked = chkLstSequences.GetItemChecked(idx);\n                    chkLstSequences.Items[idx] = seq;\n                    chkLstSequences.SetItemChecked(idx, isChecked);\n                }\n            }\n        }\n\n        private async void BtnRunAutomation_Click(object? sender, EventArgs e)\n==== REPLACE\n        private void BtnRenameSeq_Click(object? sender, EventArgs e)\n        {\n            if (chkLstSequences.SelectedItem is AutomationSequence seq)\n            {\n                string name = PromptForValue(\u0022Enter new list name:\u0022, \u0022Rename Automation List\u0022, seq.Name);\n                if (!string.IsNullOrWhiteSpace(name))\n                {\n                    seq.Name = name;\n                    int idx = chkLstSequences.SelectedIndex;\n                    bool isChecked = chkLstSequences.GetItemChecked(idx);\n                    chkLstSequences.Items[idx] = seq;\n                    chkLstSequences.SetItemChecked(idx, isChecked);\n                    RefreshAutomationSequenceDropdowns();\n                }\n            }\n        }\n\n        private async void BtnRunAutomation_Click(object? sender, EventArgs e)\n\u003E\u003E\u003E\u003E\n\u003C\u003C\u003C\u003C SEARCH\n            try\n            {\n                await _runner.RunSequencesAsync(client, activeSequences);\n                Log(\u0022[SYS] Automation Run Completed.\u0022, Color.Lime);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Automation aborted: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnRunAutomation.Enabled = true;\n            }\n        }\n    }\n}\n==== REPLACE\n            try\n            {\n                _runner.SetScrapeDefinitions(chkLstScrapes.Items.Cast\u003CScrapeDefinition\u003E());\n                await _runner.RunSequencesAsync(client, activeSequences);\n                Log(\u0022[SYS] Automation Run Completed.\u0022, Color.Lime);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Automation aborted: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnRunAutomation.Enabled = true;\n            }\n        }\n\n        // --- Data Scraper UI \u0026 Point-and-Click Handlers ---\n\n        private void InitializeScraperTabUi()\n        {\n            var darkBg = Color.FromArgb(30, 30, 30);\n            var darkLine = Color.FromArgb(45, 45, 48);\n\n            var splitScraperMain = new SplitContainer\n            {\n                Dock = DockStyle.Fill,\n                SplitterDistance = 300\n            };\n\n            // Left Panel: Scrape Lists \u0026 Scrape-Level Options\n            var pnlScrapesTop = new Panel\n            {\n                Dock = DockStyle.Top,\n                Height = 86,\n                Padding = new Padding(5)\n            };\n\n            var btnAddScrape = new Button { Text = \u0022Add Scrape\u0022, Location = new Point(5, 5), Size = new Size(135, 34), UseVisualStyleBackColor = true };\n            var btnRemoveScrape = new Button { Text = \u0022Remove\u0022, Location = new Point(145, 5), Size = new Size(135, 34), UseVisualStyleBackColor = true };\n            var btnMoveScrapeUp = new Button { Text = \u0022Move Up\u0022, Location = new Point(5, 44), Size = new Size(85, 34), UseVisualStyleBackColor = true };\n            var btnMoveScrapeDown = new Button { Text = \u0022Move Down\u0022, Location = new Point(95, 44), Size = new Size(95, 34), UseVisualStyleBackColor = true };\n            var btnRenameScrape = new Button { Text = \u0022Rename\u0022, Location = new Point(195, 44), Size = new Size(85, 34), UseVisualStyleBackColor = true };\n\n            btnAddScrape.Click \u002B= BtnAddScrape_Click;\n            btnRemoveScrape.Click \u002B= BtnRemoveScrape_Click;\n            btnMoveScrapeUp.Click \u002B= BtnMoveScrapeUp_Click;\n            btnMoveScrapeDown.Click \u002B= BtnMoveScrapeDown_Click;\n            btnRenameScrape.Click \u002B= BtnRenameScrape_Click;\n\n            pnlScrapesTop.Controls.AddRange(new Control[] { btnAddScrape, btnRemoveScrape, btnMoveScrapeUp, btnMoveScrapeDown, btnRenameScrape });\n\n            chkLstScrapes = new CheckedListBox\n            {\n                Dock = DockStyle.Fill,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                BorderStyle = BorderStyle.FixedSingle,\n                IntegralHeight = false\n            };\n            chkLstScrapes.SelectedIndexChanged \u002B= ChkLstScrapes_SelectedIndexChanged;\n            chkLstScrapes.ItemCheck \u002B= ChkLstScrapes_ItemCheck;\n\n            var grpScrapeConfig = new GroupBox\n            {\n                Dock = DockStyle.Bottom,\n                Height = 235,\n                Text = \u0022Container \u0026 Automation Hooks\u0022,\n                Padding = new Padding(8),\n                ForeColor = Color.LightGray\n            };\n\n            var tlpConfig = new TableLayoutPanel\n            {\n                Dock = DockStyle.Fill,\n                ColumnCount = 2,\n                RowCount = 6\n            };\n            tlpConfig.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute, 115F));\n            tlpConfig.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100F));\n            for (int i = 0; i \u003C 6; i\u002B\u002B) tlpConfig.RowStyles.Add(new RowStyle(SizeType.AutoSize));\n\n            var lblContainer = new Label { Text = \u0022Container CSS:\u0022, AutoSize = true, Anchor = AnchorStyles.Left };\n            txtContainerSelector = new TextBox { Dock = DockStyle.Fill, BackColor = darkBg, ForeColor = Color.LightGray };\n            txtContainerSelector.TextChanged \u002B= ScrapeConfigControl_Changed;\n\n            var pnlContainerBtns = new FlowLayoutPanel { Dock = DockStyle.Fill, AutoSize = true, Margin = new Padding(0, 2, 0, 4) };\n            var btnGenContainer = new Button { Text = \u0022Generalize\u0022, AutoSize = true, UseVisualStyleBackColor = true };\n            var btnHlContainer = new Button { Text = \u0022Highlight\u0022, AutoSize = true, UseVisualStyleBackColor = true };\n            var btnClrContainer = new Button { Text = \u0022Clear\u0022, AutoSize = true, UseVisualStyleBackColor = true };\n            btnGenContainer.Click \u002B= BtnGeneralizeContainer_Click;\n            btnHlContainer.Click \u002B= BtnHighlightContainer_Click;\n            btnClrContainer.Click \u002B= (s, e) =\u003E txtContainerSelector.Text = string.Empty;\n            pnlContainerBtns.Controls.AddRange(new Control[] { btnGenContainer, btnHlContainer, btnClrContainer });\n\n            var lblPreSeq = new Label { Text = \u0022Pre-Automation:\u0022, AutoSize = true, Anchor = AnchorStyles.Left };\n            cmbPreScrapeSeq = new ComboBox { Dock = DockStyle.Fill, DropDownStyle = ComboBoxStyle.DropDownList, BackColor = darkBg, ForeColor = Color.LightGray };\n            cmbPreScrapeSeq.SelectedIndexChanged \u002B= ScrapeConfigControl_Changed;\n\n            var lblPostSeq = new Label { Text = \u0022Post-Automation:\u0022, AutoSize = true, Anchor = AnchorStyles.Left };\n            cmbPostScrapeSeq = new ComboBox { Dock = DockStyle.Fill, DropDownStyle = ComboBoxStyle.DropDownList, BackColor = darkBg, ForeColor = Color.LightGray };\n            cmbPostScrapeSeq.SelectedIndexChanged \u002B= ScrapeConfigControl_Changed;\n\n            chkEnablePagination = new CheckBox { Text = \u0022Paginate (Max):\u0022, AutoSize = true, Anchor = AnchorStyles.Left };\n            chkEnablePagination.CheckedChanged \u002B= ScrapeConfigControl_Changed;\n\n            numMaxPages = new NumericUpDown\n            {\n                Minimum = 1,\n                Maximum = 500,\n                Value = 3,\n                Width = 70,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray\n            };\n            numMaxPages.ValueChanged \u002B= ScrapeConfigControl_Changed;\n\n            var lblNextBtn = new Label { Text = \u0022Next Button CSS:\u0022, AutoSize = true, Anchor = AnchorStyles.Left };\n            txtNextPageSelector = new TextBox { Dock = DockStyle.Fill, BackColor = darkBg, ForeColor = Color.LightGray };\n            txtNextPageSelector.TextChanged \u002B= ScrapeConfigControl_Changed;\n\n            tlpConfig.Controls.Add(lblContainer, 0, 0);\n            tlpConfig.Controls.Add(txtContainerSelector, 1, 0);\n            tlpConfig.Controls.Add(pnlContainerBtns, 1, 1);\n            tlpConfig.Controls.Add(lblPreSeq, 0, 2);\n            tlpConfig.Controls.Add(cmbPreScrapeSeq, 1, 2);\n            tlpConfig.Controls.Add(lblPostSeq, 0, 3);\n            tlpConfig.Controls.Add(cmbPostScrapeSeq, 1, 3);\n            tlpConfig.Controls.Add(chkEnablePagination, 0, 4);\n            tlpConfig.Controls.Add(numMaxPages, 1, 4);\n            tlpConfig.Controls.Add(lblNextBtn, 0, 5);\n            tlpConfig.Controls.Add(txtNextPageSelector, 1, 5);\n\n            grpScrapeConfig.Controls.Add(tlpConfig);\n\n            splitScraperMain.Panel1.Controls.Add(chkLstScrapes);\n            splitScraperMain.Panel1.Controls.Add(pnlScrapesTop);\n            splitScraperMain.Panel1.Controls.Add(grpScrapeConfig);\n\n            // Right Panel: Top = Fields \u0026 PropertyGrid, Bottom = Results \u0026 Preview\n            var splitScraperRight = new SplitContainer\n            {\n                Dock = DockStyle.Fill,\n                Orientation = Orientation.Horizontal,\n                SplitterDistance = 210\n            };\n\n            var pnlFieldsToolbar = new Panel { Dock = DockStyle.Top, Height = 46, Padding = new Padding(4) };\n            var btnAddField = new Button { Text = \u0022Add Field\u0022, Dock = DockStyle.Left, Width = 90, UseVisualStyleBackColor = true };\n            var btnRemoveField = new Button { Text = \u0022Remove\u0022, Dock = DockStyle.Left, Width = 80, UseVisualStyleBackColor = true };\n            var btnFieldUp = new Button { Text = \u0022Up\u0022, Dock = DockStyle.Left, Width = 50, UseVisualStyleBackColor = true };\n            var btnFieldDown = new Button { Text = \u0022Down\u0022, Dock = DockStyle.Left, Width = 60, UseVisualStyleBackColor = true };\n            var btnGenField = new Button { Text = \u0022Generalize\u0022, Dock = DockStyle.Left, Width = 90, UseVisualStyleBackColor = true };\n            var btnHlField = new Button { Text = \u0022Highlight\u0022, Dock = DockStyle.Left, Width = 85, UseVisualStyleBackColor = true };\n\n            btnPreviewScrape = new Button { Text = \u0022Preview Scrape\u0022, Dock = DockStyle.Right, Width = 130, UseVisualStyleBackColor = true };\n            btnRunAllScrapes = new Button { Text = \u0022Run Active Scrapes\u0022, Dock = DockStyle.Right, Width = 145, UseVisualStyleBackColor = true };\n\n            btnAddField.Click \u002B= BtnAddScrapeField_Click;\n            btnRemoveField.Click \u002B= BtnRemoveScrapeField_Click;\n            btnFieldUp.Click \u002B= BtnMoveScrapeFieldUp_Click;\n            btnFieldDown.Click \u002B= BtnMoveScrapeFieldDown_Click;\n            btnGenField.Click \u002B= BtnGeneralizeScrapeField_Click;\n            btnHlField.Click \u002B= BtnHighlightScrapeField_Click;\n            btnPreviewScrape.Click \u002B= BtnPreviewScrape_Click;\n            btnRunAllScrapes.Click \u002B= BtnRunAllScrapes_Click;\n\n            pnlFieldsToolbar.Controls.AddRange(new Control[]\n            {\n                btnRunAllScrapes, btnPreviewScrape,\n                btnHlField, btnGenField, btnFieldDown, btnFieldUp, btnRemoveField, btnAddField\n            });\n\n            var splitFields = new SplitContainer { Dock = DockStyle.Fill, SplitterDistance = 220 };\n            lstScrapeFields = new ListBox\n            {\n                Dock = DockStyle.Fill,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                BorderStyle = BorderStyle.FixedSingle,\n                IntegralHeight = false\n            };\n            lstScrapeFields.SelectedIndexChanged \u002B= LstScrapeFields_SelectedIndexChanged;\n\n            pgScrapeFieldDetails = new PropertyGrid\n            {\n                Dock = DockStyle.Fill,\n                BackColor = darkBg,\n                CategoryForeColor = Color.LightGray,\n                CategorySplitterColor = darkLine,\n                CommandsBorderColor = darkLine,\n                CommandsForeColor = Color.LightGray,\n                DisabledItemForeColor = Color.FromArgb(127, 127, 127),\n                HelpBackColor = darkBg,\n                HelpBorderColor = darkLine,\n                HelpForeColor = Color.LightGray,\n                LineColor = darkLine,\n                ViewBackColor = darkBg,\n                ViewBorderColor = darkLine,\n                ViewForeColor = Color.LightGray\n            };\n            pgScrapeFieldDetails.PropertyValueChanged \u002B= PgScrapeFieldDetails_PropertyValueChanged;\n\n            splitFields.Panel1.Controls.Add(lstScrapeFields);\n            splitFields.Panel2.Controls.Add(pgScrapeFieldDetails);\n\n            splitScraperRight.Panel1.Controls.Add(splitFields);\n            splitScraperRight.Panel1.Controls.Add(pnlFieldsToolbar);\n\n            // Bottom Panel: Results Preview \u0026 Export\n            var pnlResultsToolbar = new Panel { Dock = DockStyle.Top, Height = 40, Padding = new Padding(4) };\n            lblScrapeStatus = new Label\n            {\n                Text = \u0022Scrape Results Preview (0 records)\u0022,\n                AutoSize = true,\n                Dock = DockStyle.Left,\n                TextAlign = ContentAlignment.MiddleLeft,\n                Padding = new Padding(4, 6, 0, 0)\n            };\n\n            var btnExportJson = new Button { Text = \u0022Export JSON...\u0022, Dock = DockStyle.Right, Width = 115, UseVisualStyleBackColor = true };\n            var btnExportCsv = new Button { Text = \u0022Export CSV...\u0022, Dock = DockStyle.Right, Width = 110, UseVisualStyleBackColor = true };\n            var btnCopyJson = new Button { Text = \u0022Copy JSON\u0022, Dock = DockStyle.Right, Width = 100, UseVisualStyleBackColor = true };\n\n            btnExportJson.Click \u002B= BtnExportScrapeJson_Click;\n            btnExportCsv.Click \u002B= BtnExportScrapeCsv_Click;\n            btnCopyJson.Click \u002B= BtnCopyScrapeJson_Click;\n\n            pnlResultsToolbar.Controls.AddRange(new Control[] { btnExportJson, btnExportCsv, btnCopyJson, lblScrapeStatus });\n\n            var tabPreview = new TabControl { Dock = DockStyle.Fill };\n            var tabTable = new TabPage(\u0022Table View\u0022) { BackColor = darkBg };\n            var tabJson = new TabPage(\u0022JSON View\u0022) { BackColor = darkBg };\n\n            dgvScrapePreview = new DataGridView\n            {\n                Dock = DockStyle.Fill,\n                BackgroundColor = darkBg,\n                ForeColor = Color.LightGray,\n                GridColor = darkLine,\n                BorderStyle = BorderStyle.FixedSingle,\n                ReadOnly = true,\n                AllowUserToAddRows = false,\n                AllowUserToDeleteRows = false,\n                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill,\n                RowHeadersVisible = false,\n                EnableHeadersVisualStyles = false,\n                SelectionMode = DataGridViewSelectionMode.FullRowSelect\n            };\n            dgvScrapePreview.ColumnHeadersDefaultCellStyle.BackColor = Color.FromArgb(45, 45, 48);\n            dgvScrapePreview.ColumnHeadersDefaultCellStyle.ForeColor = Color.White;\n            dgvScrapePreview.DefaultCellStyle.BackColor = darkBg;\n            dgvScrapePreview.DefaultCellStyle.ForeColor = Color.LightGray;\n            dgvScrapePreview.DefaultCellStyle.SelectionBackColor = Color.FromArgb(9, 71, 113);\n            dgvScrapePreview.DefaultCellStyle.SelectionForeColor = Color.White;\n\n            txtScrapeJsonPreview = new TextBox\n            {\n                Dock = DockStyle.Fill,\n                Multiline = true,\n                ReadOnly = true,\n                ScrollBars = ScrollBars.Both,\n                BackColor = darkBg,\n                ForeColor = Color.LightGray,\n                Font = new Font(\u0022Consolas\u0022, 10F)\n            };\n\n            tabTable.Controls.Add(dgvScrapePreview);\n            tabJson.Controls.Add(txtScrapeJsonPreview);\n            tabPreview.Controls.Add(tabTable);\n            tabPreview.Controls.Add(tabJson);\n\n            splitScraperRight.Panel2.Controls.Add(tabPreview);\n            splitScraperRight.Panel2.Controls.Add(pnlResultsToolbar);\n\n            splitScraperMain.Panel2.Controls.Add(splitScraperRight);\n            tabScraper.Controls.Add(splitScraperMain);\n\n            RefreshAutomationSequenceDropdowns();\n        }\n\n        private void RefreshAutomationSequenceDropdowns()\n        {\n            if (cmbPreScrapeSeq == null || cmbPostScrapeSeq == null) return;\n\n            _isUpdatingScrapeUi = true;\n            try\n            {\n                string prevPre = cmbPreScrapeSeq.SelectedItem as string ?? string.Empty;\n                string prevPost = cmbPostScrapeSeq.SelectedItem as string ?? string.Empty;\n\n                cmbPreScrapeSeq.Items.Clear();\n                cmbPostScrapeSeq.Items.Clear();\n\n                cmbPreScrapeSeq.Items.Add(\u0022(None)\u0022);\n                cmbPostScrapeSeq.Items.Add(\u0022(None)\u0022);\n\n                foreach (AutomationSequence seq in chkLstSequences.Items)\n                {\n                    cmbPreScrapeSeq.Items.Add(seq.Name);\n                    cmbPostScrapeSeq.Items.Add(seq.Name);\n                }\n\n                cmbPreScrapeSeq.SelectedItem = cmbPreScrapeSeq.Items.Contains(prevPre) ? prevPre : \u0022(None)\u0022;\n                cmbPostScrapeSeq.SelectedItem = cmbPostScrapeSeq.Items.Contains(prevPost) ? prevPost : \u0022(None)\u0022;\n\n                if (chkLstScrapes?.SelectedItem is ScrapeDefinition def)\n                {\n                    cmbPreScrapeSeq.SelectedItem = !string.IsNullOrWhiteSpace(def.PreScrapeSequenceName) \u0026\u0026 cmbPreScrapeSeq.Items.Contains(def.PreScrapeSequenceName)\n                        ? def.PreScrapeSequenceName\n                        : \u0022(None)\u0022;\n                    cmbPostScrapeSeq.SelectedItem = !string.IsNullOrWhiteSpace(def.PostScrapeSequenceName) \u0026\u0026 cmbPostScrapeSeq.Items.Contains(def.PostScrapeSequenceName)\n                        ? def.PostScrapeSequenceName\n                        : \u0022(None)\u0022;\n                }\n            }\n            finally\n            {\n                _isUpdatingScrapeUi = false;\n            }\n        }\n\n        private void LoadSelectedScrapeToUi()\n        {\n            _isUpdatingScrapeUi = true;\n            try\n            {\n                lstScrapeFields.Items.Clear();\n                pgScrapeFieldDetails.SelectedObject = null;\n\n                if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)\n                {\n                    txtContainerSelector.Text = scrape.ContainerSelector;\n                    cmbPreScrapeSeq.SelectedItem = !string.IsNullOrWhiteSpace(scrape.PreScrapeSequenceName) \u0026\u0026 cmbPreScrapeSeq.Items.Contains(scrape.PreScrapeSequenceName)\n                        ? scrape.PreScrapeSequenceName\n                        : \u0022(None)\u0022;\n                    cmbPostScrapeSeq.SelectedItem = !string.IsNullOrWhiteSpace(scrape.PostScrapeSequenceName) \u0026\u0026 cmbPostScrapeSeq.Items.Contains(scrape.PostScrapeSequenceName)\n                        ? scrape.PostScrapeSequenceName\n                        : \u0022(None)\u0022;\n                    chkEnablePagination.Checked = scrape.EnablePagination;\n                    numMaxPages.Value = Math.Clamp(scrape.MaxPages, (int)numMaxPages.Minimum, (int)numMaxPages.Maximum);\n                    txtNextPageSelector.Text = scrape.NextPageSelector;\n\n                    foreach (var field in scrape.Fields)\n                    {\n                        lstScrapeFields.Items.Add(field);\n                    }\n\n                    if (lstScrapeFields.Items.Count \u003E 0)\n                    {\n                        lstScrapeFields.SelectedIndex = 0;\n                    }\n                }\n                else\n                {\n                    txtContainerSelector.Text = string.Empty;\n                    cmbPreScrapeSeq.SelectedIndex = 0;\n                    cmbPostScrapeSeq.SelectedIndex = 0;\n                    chkEnablePagination.Checked = false;\n                    numMaxPages.Value = 1;\n                    txtNextPageSelector.Text = string.Empty;\n                }\n            }\n            finally\n            {\n                _isUpdatingScrapeUi = false;\n            }\n        }\n\n        private void ScrapeConfigControl_Changed(object? sender, EventArgs e)\n        {\n            if (_isUpdatingScrapeUi) return;\n            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape) return;\n\n            scrape.ContainerSelector = txtContainerSelector.Text.Trim();\n            string? pre = cmbPreScrapeSeq.SelectedItem as string;\n            scrape.PreScrapeSequenceName = pre == \u0022(None)\u0022 ? string.Empty : (pre ?? string.Empty);\n\n            string? post = cmbPostScrapeSeq.SelectedItem as string;\n            scrape.PostScrapeSequenceName = post == \u0022(None)\u0022 ? string.Empty : (post ?? string.Empty);\n\n            scrape.EnablePagination = chkEnablePagination.Checked;\n            scrape.MaxPages = (int)numMaxPages.Value;\n            scrape.NextPageSelector = txtNextPageSelector.Text.Trim();\n        }\n\n        private void ChkLstScrapes_SelectedIndexChanged(object? sender, EventArgs e)\n        {\n            LoadSelectedScrapeToUi();\n        }\n\n        private void ChkLstScrapes_ItemCheck(object? sender, ItemCheckEventArgs e)\n        {\n            if (chkLstScrapes.Items[e.Index] is ScrapeDefinition scrape)\n            {\n                scrape.IsActive = e.NewValue == CheckState.Checked;\n            }\n        }\n\n        private void BtnAddScrape_Click(object? sender, EventArgs e)\n        {\n            string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022Add Scrape List\u0022, $\u0022Scrape {chkLstScrapes.Items.Count \u002B 1}\u0022);\n            if (!string.IsNullOrWhiteSpace(name))\n            {\n                var scrape = new ScrapeDefinition { Name = name.Trim() };\n                chkLstScrapes.Items.Add(scrape, true);\n                chkLstScrapes.SelectedItem = scrape;\n            }\n        }\n\n        private void BtnRemoveScrape_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem != null)\n            {\n                chkLstScrapes.Items.Remove(chkLstScrapes.SelectedItem);\n                LoadSelectedScrapeToUi();\n            }\n        }\n\n        private void BtnMoveScrapeUp_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem != null \u0026\u0026 chkLstScrapes.SelectedIndex \u003E 0)\n            {\n                int idx = chkLstScrapes.SelectedIndex;\n                var item = chkLstScrapes.SelectedItem;\n                bool isChecked = chkLstScrapes.GetItemChecked(idx);\n\n                chkLstScrapes.Items.RemoveAt(idx);\n                chkLstScrapes.Items.Insert(idx - 1, item);\n                chkLstScrapes.SetItemChecked(idx - 1, isChecked);\n                chkLstScrapes.SelectedIndex = idx - 1;\n            }\n        }\n\n        private void BtnMoveScrapeDown_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem != null \u0026\u0026 chkLstScrapes.SelectedIndex \u003C chkLstScrapes.Items.Count - 1)\n            {\n                int idx = chkLstScrapes.SelectedIndex;\n                var item = chkLstScrapes.SelectedItem;\n                bool isChecked = chkLstScrapes.GetItemChecked(idx);\n\n                chkLstScrapes.Items.RemoveAt(idx);\n                chkLstScrapes.Items.Insert(idx \u002B 1, item);\n                chkLstScrapes.SetItemChecked(idx \u002B 1, isChecked);\n                chkLstScrapes.SelectedIndex = idx \u002B 1;\n            }\n        }\n\n        private void BtnRenameScrape_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)\n            {\n                string name = PromptForValue(\u0022Enter new scrape list name:\u0022, \u0022Rename Scrape List\u0022, scrape.Name);\n                if (!string.IsNullOrWhiteSpace(name))\n                {\n                    scrape.Name = name.Trim();\n                    int idx = chkLstScrapes.SelectedIndex;\n                    bool isChecked = chkLstScrapes.GetItemChecked(idx);\n                    chkLstScrapes.Items[idx] = scrape;\n                    chkLstScrapes.SetItemChecked(idx, isChecked);\n                }\n            }\n        }\n\n        private void BtnGeneralizeContainer_Click(object? sender, EventArgs e)\n        {\n            if (!string.IsNullOrWhiteSpace(txtContainerSelector.Text))\n            {\n                string generalized = SelectorHelper.GeneralizeSelector(txtContainerSelector.Text);\n                txtContainerSelector.Text = generalized;\n                if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape)\n                {\n                    scrape.SetContainerAndRelativizeFields(generalized);\n                    pgScrapeFieldDetails.Refresh();\n                }\n            }\n        }\n\n        private async void BtnHighlightContainer_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);\n                return;\n            }\n\n            string selector = txtContainerSelector.Text.Trim();\n            if (string.IsNullOrWhiteSpace(selector))\n            {\n                Log(\u0022[WARN] Container selector is empty.\u0022, Color.Orange);\n                return;\n            }\n\n            try\n            {\n                int count = await client.HighlightElementsAsync(selector, null, true);\n                Log($\u0022[SCRAPE] Highlighted {count} container element(s) matching \u0027{selector}\u0027.\u0022, Color.SpringGreen);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Failed to highlight container: {ex.Message}\u0022, Color.Red);\n            }\n        }\n\n        private void BtnAddScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape)\n            {\n                Log(\u0022[WARN] Please select or create a scrape list first.\u0022, Color.Orange);\n                return;\n            }\n\n            var field = new ScrapeField\n            {\n                Name = scrape.GetUniqueFieldName(\u0022Field\u0022)\n            };\n            scrape.Fields.Add(field);\n            lstScrapeFields.Items.Add(field);\n            lstScrapeFields.SelectedItem = field;\n        }\n\n        private void BtnRemoveScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape \u0026\u0026 lstScrapeFields.SelectedItem is ScrapeField field)\n            {\n                scrape.Fields.Remove(field);\n                lstScrapeFields.Items.Remove(field);\n                pgScrapeFieldDetails.SelectedObject = lstScrapeFields.SelectedItem;\n            }\n        }\n\n        private void BtnMoveScrapeFieldUp_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape \u0026\u0026 lstScrapeFields.SelectedItem is ScrapeField field)\n            {\n                int idx = lstScrapeFields.SelectedIndex;\n                if (scrape.MoveFieldUp(idx))\n                {\n                    lstScrapeFields.Items.RemoveAt(idx);\n                    lstScrapeFields.Items.Insert(idx - 1, field);\n                    lstScrapeFields.SelectedIndex = idx - 1;\n                }\n            }\n        }\n\n        private void BtnMoveScrapeFieldDown_Click(object? sender, EventArgs e)\n        {\n            if (chkLstScrapes.SelectedItem is ScrapeDefinition scrape \u0026\u0026 lstScrapeFields.SelectedItem is ScrapeField field)\n            {\n                int idx = lstScrapeFields.SelectedIndex;\n                if (scrape.MoveFieldDown(idx))\n                {\n                    lstScrapeFields.Items.RemoveAt(idx);\n                    lstScrapeFields.Items.Insert(idx \u002B 1, field);\n                    lstScrapeFields.SelectedIndex = idx \u002B 1;\n                }\n            }\n        }\n\n        private void BtnGeneralizeScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (lstScrapeFields.SelectedItem is ScrapeField field \u0026\u0026 !string.IsNullOrWhiteSpace(field.Selector))\n            {\n                DomNode? rootDom = tvDom.Nodes.Count \u003E 0 ? tvDom.Nodes[0].Tag as DomNode : null;\n                field.Selector = SelectorHelper.GeneralizeRepeatingFieldSelector(field.Selector, rootDom);\n                field.MatchAllElements = true;\n                pgScrapeFieldDetails.Refresh();\n                RefreshSelectedFieldItemText();\n            }\n        }\n\n        private async void BtnHighlightScrapeField_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);\n                return;\n            }\n\n            if (lstScrapeFields.SelectedItem is not ScrapeField field || string.IsNullOrWhiteSpace(field.Selector))\n            {\n                Log(\u0022[WARN] Please select a field with a valid selector first.\u0022, Color.Orange);\n                return;\n            }\n\n            string? containerSelector = (chkLstScrapes.SelectedItem as ScrapeDefinition)?.ContainerSelector;\n            try\n            {\n                int count = await client.HighlightElementsAsync(\n                    field.Selector,\n                    containerSelector,\n                    field.MatchAllElements || !string.IsNullOrWhiteSpace(containerSelector));\n                Log($\u0022[SCRAPE] Highlighted {count} element(s) for field \u0027{field.Name}\u0027.\u0022, Color.SpringGreen);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Highlight failed: {ex.Message}\u0022, Color.Red);\n            }\n        }\n\n        private void LstScrapeFields_SelectedIndexChanged(object? sender, EventArgs e)\n        {\n            pgScrapeFieldDetails.SelectedObject = lstScrapeFields.SelectedItem;\n        }\n\n        private void PgScrapeFieldDetails_PropertyValueChanged(object? s, PropertyValueChangedEventArgs e)\n        {\n            RefreshSelectedFieldItemText();\n        }\n\n        private void RefreshSelectedFieldItemText()\n        {\n            int idx = lstScrapeFields.SelectedIndex;\n            if (idx \u003E= 0)\n            {\n                var item = lstScrapeFields.Items[idx];\n                lstScrapeFields.Items[idx] = item;\n            }\n        }\n\n        private async void MnuQuickScrapeText_Click(object? sender, EventArgs e)\n        {\n            if (tvDom.SelectedNode?.Tag is DomNode domNode \u0026\u0026 !string.IsNullOrEmpty(domNode.Path) \u0026\u0026 lstClients.SelectedItem is BrowserClient client)\n            {\n                var extType = domNode.GetSuggestedExtractionType();\n                Log($\u0022[SCRAPE] Testing extraction ({extType}) on {domNode.Path}...\u0022, Color.SpringGreen);\n                try\n                {\n                    string? val = await client.ScrapeElementAsync(domNode.Path, extType);\n                    Log($\u0022[SCRAPE-RX] Extracted Value: {val}\u0022, Color.White);\n                }\n                catch (Exception ex)\n                {\n                    Log($\u0022[ERR] Quick scrape failed: {ex.Message}\u0022, Color.Red);\n                }\n            }\n        }\n\n        private void AddFieldFromSelectedDomNode(ScrapeDefinition scrape, bool matchAllElements)\n        {\n            if (tvDom.SelectedNode?.Tag is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            DomNode? rootDom = tvDom.Nodes.Count \u003E 0 ? tvDom.Nodes[0].Tag as DomNode : null;\n            var suggestedType = domNode.GetSuggestedExtractionType();\n            string baseName = domNode.GetSuggestedFieldName(suggestedType);\n            string uniqueName = scrape.GetUniqueFieldName(baseName);\n\n            var field = domNode.CreateScrapeField(\n                fieldName: uniqueName,\n                extractionType: suggestedType,\n                containerSelector: scrape.ContainerSelector,\n                matchAllElements: matchAllElements,\n                rootDom: rootDom);\n\n            scrape.Fields.Add(field);\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                lstScrapeFields.Items.Add(field);\n                lstScrapeFields.SelectedItem = field;\n            }\n\n            Log($\u0022[SCRAPE] Added field \u0027{field.Name}\u0027 ({field.ExtractionType}) to \u0027{scrape.Name}\u0027.\u0022, Color.SpringGreen);\n        }\n\n        private void SetContainerFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedNode?.Tag is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            string generalizedContainer = domNode.GetGeneralizedPath();\n            scrape.SetContainerAndRelativizeFields(generalizedContainer);\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                LoadSelectedScrapeToUi();\n            }\n\n            Log($\u0022[SCRAPE] Set repeating container for \u0027{scrape.Name}\u0027 to: {generalizedContainer}\u0022, Color.SpringGreen);\n        }\n\n        private void SetPaginationNextFromSelectedDomNode(ScrapeDefinition scrape)\n        {\n            if (tvDom.SelectedNode?.Tag is not DomNode domNode || string.IsNullOrEmpty(domNode.Path))\n                return;\n\n            scrape.EnablePagination = true;\n            scrape.NextPageSelector = domNode.Path;\n            if (scrape.MaxPages \u003C 2) scrape.MaxPages = 3;\n\n            if (chkLstScrapes.SelectedItem != scrape)\n            {\n                chkLstScrapes.SelectedItem = scrape;\n            }\n            else\n            {\n                LoadSelectedScrapeToUi();\n            }\n\n            Log($\u0022[SCRAPE] Set pagination Next button for \u0027{scrape.Name}\u0027 to: {domNode.Path}\u0022, Color.SpringGreen);\n        }\n\n        private async void BtnPreviewScrape_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);\n                return;\n            }\n\n            if (chkLstScrapes.SelectedItem is not ScrapeDefinition scrape)\n            {\n                Log(\u0022[WARN] Please select a scrape list to preview.\u0022, Color.Orange);\n                return;\n            }\n\n            if (scrape.Fields.Count == 0)\n            {\n                Log(\u0022[WARN] The selected scrape list has no fields defined.\u0022, Color.Orange);\n                return;\n            }\n\n            btnPreviewScrape.Enabled = false;\n            try\n            {\n                var sequences = chkLstSequences.Items.Cast\u003CAutomationSequence\u003E().ToList();\n                var result = await _scraper.RunScrapeAsync(client, scrape, sequences);\n                DisplayScrapeResult(result);\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Scrape preview failed: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnPreviewScrape.Enabled = true;\n            }\n        }\n\n        private async void BtnRunAllScrapes_Click(object? sender, EventArgs e)\n        {\n            if (lstClients.SelectedItem is not BrowserClient client)\n            {\n                Log(\u0022[WARN] Please select a connected client first.\u0022, Color.Orange);\n                return;\n            }\n\n            var project = BuildCurrentProjectFromUi();\n            if (!project.Scrapes.Any(s =\u003E s.IsActive))\n            {\n                Log(\u0022[WARN] No active scrape lists selected to run.\u0022, Color.Orange);\n                return;\n            }\n\n            btnRunAllScrapes.Enabled = false;\n            try\n            {\n                var results = await _scraper.RunProjectScrapesAsync(client, project);\n                if (results.Count \u003E 0)\n                {\n                    var combined = new ScrapeResult\n                    {\n                        ScrapeName = results.Count == 1 ? results[0].ScrapeName : \u0022Combined Active Scrapes\u0022,\n                        PagesScraped = results.Sum(r =\u003E r.PagesScraped)\n                    };\n                    foreach (var r in results)\n                    {\n                        combined.Merge(r);\n                    }\n                    DisplayScrapeResult(combined);\n                }\n            }\n            catch (Exception ex)\n            {\n                Log($\u0022[ERR] Active scrapes run aborted: {ex.Message}\u0022, Color.Red);\n            }\n            finally\n            {\n                btnRunAllScrapes.Enabled = true;\n            }\n        }\n\n        private void DisplayScrapeResult(ScrapeResult result)\n        {\n            _lastScrapeResult = result;\n            lblScrapeStatus.Text = $\u0022Results: {result.RecordCount} record(s) | Pages: {result.PagesScraped} | Source: {result.ScrapeName}\u0022;\n            dgvScrapePreview.DataSource = result.ToDataTable();\n            txtScrapeJsonPreview.Text = result.ToJson(true, true);\n        }\n\n        private void BtnCopyScrapeJson_Click(object? sender, EventArgs e)\n        {\n            if (_lastScrapeResult == null || _lastScrapeResult.RecordCount == 0)\n            {\n                Log(\u0022[WARN] No scrape results available to copy.\u0022, Color.Orange);\n                return;\n            }\n\n            Clipboard.SetText(_lastScrapeResult.ToJson(true, true));\n            Log(\u0022[SCRAPE] Copied scraped JSON records to clipboard.\u0022, Color.Lime);\n        }\n\n        private void BtnExportScrapeJson_Click(object? sender, EventArgs e)\n        {\n            if (_lastScrapeResult == null || _lastScrapeResult.RecordCount == 0)\n            {\n                Log(\u0022[WARN] No scrape results available to export.\u0022, Color.Orange);\n                return;\n            }\n\n            using var sfd = new SaveFileDialog\n            {\n                Filter = \u0022JSON Files (*.json)|*.json|All Files (*.*)|*.*\u0022,\n                Title = \u0022Export Scrape Results as JSON\u0022,\n                DefaultExt = \u0022json\u0022,\n                FileName = $\u0022{_lastScrapeResult.ScrapeName.Replace(\u0027 \u0027, \u0027_\u0027)}.json\u0022\n            };\n\n            if (sfd.ShowDialog() == DialogResult.OK)\n            {\n                try\n                {\n                    _lastScrapeResult.SaveToJsonFile(sfd.FileName, recordsOnly: true);\n                    Log($\u0022[SCRAPE] Exported {_lastScrapeResult.RecordCount} record(s) to {sfd.FileName}\u0022, Color.Lime);\n                }\n                catch (Exception ex)\n                {\n                    Log($\u0022[ERR] Failed to export JSON: {ex.Message}\u0022, Color.Red);\n                }\n            }\n        }\n\n        private void BtnExportScrapeCsv_Click(object? sender, EventArgs e)\n        {\n            if (_lastScrapeResult == null || _lastScrapeResult.RecordCount == 0)\n            {\n                Log(\u0022[WARN] No scrape results available to export.\u0022, Color.Orange);\n                return;\n            }\n\n            using var sfd = new SaveFileDialog\n            {\n                Filter = \u0022CSV Files (*.csv)|*.csv|All Files (*.*)|*.*\u0022,\n                Title = \u0022Export Scrape Results as CSV\u0022,\n                DefaultExt = \u0022csv\u0022,\n                FileName = $\u0022{_lastScrapeResult.ScrapeName.Replace(\u0027 \u0027, \u0027_\u0027)}.csv\u0022\n            };\n\n            if (sfd.ShowDialog() == DialogResult.OK)\n            {\n                try\n                {\n                    _lastScrapeResult.SaveToCsvFile(sfd.FileName);\n                    Log($\u0022[SCRAPE] Exported {_lastScrapeResult.RecordCount} record(s) to {sfd.FileName}\u0022, Color.Lime);\n                }\n                catch (Exception ex)\n                {\n                    Log($\u0022[ERR] Failed to export CSV: {ex.Message}\u0022, Color.Red);\n                }\n            }\n        }\n    }\n}\n\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060Anti-Agent v1.0\n\n### Summary of Remaining Changes\n\n1. **Models \u0026 Runner Integration (\u0060AutomationStep.cs\u0060, \u0060BrowserEventArgs.cs\u0060, \u0060DomNode.cs\u0060, \u0060AutomationRunner.cs\u0060)**:\n   - Added \u0060AutomationActionType.Scrape\u0060 to \u0060AutomationStep\u0060.\n   - Added \u0060ScrapeEventArgs\u0060 and \u0060ScrapePageEventArgs\u0060 to \u0060BrowserEventArgs.cs\u0060.\n   - Added point-and-click helper methods on \u0060DomNode\u0060 (\u0060GetGeneralizedPath\u0060, \u0060GetSuggestedExtractionType\u0060, \u0060GetSuggestedFieldName\u0060, \u0060CreateScrapeField\u0060).\n   - Updated \u0060AutomationRunner\u0060 to handle \u0060AutomationActionType.Scrape\u0060 steps (supporting both named \u0060ScrapeDefinition\u0060 execution and direct selector extraction).\n2. **Extensions \u0026 Browser Userscript (\u0060ReactExtensions.cs\u0060, \u0060ScriptGenerator.cs\u0060)**:\n   - Added \u0060ExecuteScrapeAsync\u0060, \u0060ExecuteProjectScrapesAsync\u0060, \u0060ScrapeElementAsync\u0060, \u0060ScrapeElementsAsync\u0060, \u0060ScrapeTableAsync\u0060, \u0060HighlightElementsAsync\u0060, and \u0060CreateScrape\u0060 extension methods on \u0060BrowserClient\u0060.\n   - Updated \u0060ScriptGenerator\u0060 with \u0060SCRAPE_DATA\u0060, \u0060SCRAPE_TABLE\u0060, and \u0060HIGHLIGHT_ELEMENTS\u0060 commands, multi-element highlight overlays, and relative container selector resolution.\n3. **TestBedApp Point-and-Click Scraper UI (\u0060MainForm.Designer.cs\u0060, \u0060MainForm.cs\u0060)**:\n   - Added right-click DOM Explorer menu options to test-scrape elements, add single or repeating scrape fields, set a repeating container, or set a pagination next button.\n   - Added the **Data Scraper** tab with scrape list management, container and automation hooks (pre-scrape, post-scrape, pagination), field PropertyGrid editor, live browser multi-element highlighting, Table/JSON result preview tabs, and CSV/JSON export.\n\n### How to Test\n\n1. Build and run the solution, start the server, and click **Generate \u0026 Copy Script** to update your browser userscript.\n2. Right-click elements in **DOM Explorer** to add fields or containers to a scrape list, then open the **Data Scraper** tab and click **Preview Scrape** or **Run Active Scrapes**.\n\n--CODESTART--\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\AutomationStep.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH    public enum AutomationActionType    {        Click,        SetValue,        EvaluateScript,        Custom    }==== REPLACE    public enum AutomationActionType    {        Click,        SetValue,        EvaluateScript,        Scrape,        Custom    }\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\BrowserEventArgs.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCH        public AutomationStepEventArgs(AutomationSequence? sequence, AutomationStep step, CommandResult? result = null, Exception? error = null)        {            Sequence = sequence;            Step = step;            Result = result;            Error = error;        }    }}==== REPLACE        public AutomationStepEventArgs(AutomationSequence? sequence, AutomationStep step, CommandResult? result = null, Exception? error = null)        {            Sequence = sequence;            Step = step;            Result = result;            Error = error;        }    }    public class ScrapeEventArgs : EventArgs    {        public ScrapeDefinition Definition { get; }        public ScrapeResult? Result { get; }        public Exception? Error { get; }        public ScrapeEventArgs(ScrapeDefinition definition, ScrapeResult? result = null, Exception? error = null)        {            Definition = definition;            Result = result;            Error = error;        }    }    public class ScrapePageEventArgs : EventArgs    {        public ScrapeDefinition Definition { get; }        public int PageNumber { get; }        public System.Collections.Generic.IReadOnlyList\u003CSystem.Collections.Generic.Dictionary\u003Cstring, string?\u003E\u003E PageRecords { get; }        public ScrapePageEventArgs(            ScrapeDefinition definition,            int pageNumber,            System.Collections.Generic.IReadOnlyList\u003CSystem.Collections.Generic.Dictionary\u003Cstring, string?\u003E\u003E pageRecords)        {            Definition = definition;            PageNumber = pageNumber;            PageRecords = pageRecords;        }    }}\u003E\u003E\u003E\u003E\n\u0060\u0060\u0060\n\n**C:\\Users\\Devtop1\\Documents\\GitHub\\baf\\BrowserAutomationFramework\\Models\\DomNode.cs**\n\n\u0060\u0060\u0060\ncs\u003C\u003C\u003C\u003C SEARCHusing System;using System.Collections.Generic;using System.Text;using System.Text.Json.Serialization;namespace BrowserAutomationFramework.Models==== REPLACEusing System;using System.Collections.Generic;using System.Linq;using System.Text;using System.Text.Json.Serialization;using BrowserAutomationFramework.Scraping;namespace BrowserAutomationFramework.Models\u003E\u003E\u003E\u003E\u003C\u003C\u003C\u003C SEARCH            return new AutomationStep            {                Name = $\u0022{actionLabel} \u003C{TagName}\u003E\u0022,                ActionType = actionType,                Selector = Path ?? string.Empty,                Value = value,                Overwrite = overwrite            };        }    }}==== REPLACE            return new AutomationStep            {                Name = $\u0022{actionLabel} \u003C{TagName}\u003E\u0022,                ActionType = actionType,                Selector = Path ?? string.Empty,                Value = value,                Overwrite = overwrite            };        }        /// \u003Csummary\u003E        /// Returns a generalized CSS selector for this node by stripping :nth-child(N) from the final segment.        /// \u003C/summary\u003E        public string GetGeneralizedPath()        {            return SelectorHelper.GeneralizeSelector(Path ?? string.Empty);        }        /// \u003Csummary\u003E        /// Determines the most appropriate default \u003Csee cref=\u0022ScrapeExtractionType\u0022/\u003E for this DOM element.        /// \u003C/summary\u003E        public ScrapeExtractionType GetSuggestedExtractionType()        {            string tag = (TagName ?? string.Empty).ToLowerInvariant();            return tag switch            {                \u0022img\u0022 or \u0022video\u0022 or \u0022audio\u0022 or \u0022source\u0022 or \u0022iframe\u0022 =\u003E ScrapeExtractionType.Src,                \u0022input\u0022 or \u0022textarea\u0022 or \u0022select\u0022 =\u003E ScrapeExtractionType.Value,                _ =\u003E ScrapeExtractionType.InnerText            };        }        /// \u003Csummary\u003E        /// Generates a clean, human-readable field name based on this element\u0027s attributes or tag name.        /// \u003C/summary\u003E        public string GetSuggestedFieldName(ScrapeExtractionType? extractionType = null)        {            var ext = extractionType ?? GetSuggestedExtractionType();            if (Attributes != null)            {                string[] candidateAttrs = { \u0022id\u0022, \u0022name\u0022, \u0022data-testid\u0022, \u0022aria-label\u0022, \u0022placeholder\u0022, \u0022title\u0022, \u0022alt\u0022 };                foreach (var key in candidateAttrs)                {                    if (Attributes.TryGetValue(key, out var val) \u0026\u0026 !string.IsNullOrWhiteSpace(val) \u0026\u0026 val.Length \u003C= 30)                    {                        return SanitizeFieldName(val);                    }       