  }                    }                    finally                    {                        _isUpdatingClientsList = false;                    }                    break;                }            }        }        private void UpdateExtensionStatusLabel(bool connected, int tabCount)        {            if (InvokeRequired)            {                Invoke(new Action(() =\u003E UpdateExtensionStatusLabel(connected, tabCount)));                return;            }            if (connected)            {                lblExtensionStatus.Text = $\u0022Extension: Connected ({tabCount} open tab{(tabCount == 1 ? \u0022\u0022 : \u0022s\u0022)})\u0022;                lblExtensionStatus.ForeColor = Color.LimeGreen;            }            else            {                lblExtensionStatus.Text = _server != null                    ? \u0022Extension: Waiting for connection...\u0022                    : \u0022Extension: Server stopped\u0022;                lblExtensionStatus.ForeColor = Color.Orange;            }        }        private void Server_OnExtensionConnected(object? sender, EventArgs e)        {            Log(\u0022[EXT] Chrome Extension connected to Automation Server!\u0022, Color.LimeGreen);            UpdateExtensionStatusLabel(true, _server?.GetExtensionTabs().Count ?? 0);        }        private void Server_OnExtensionDisconnected(object? sender, EventArgs e)        {            Log(\u0022[EXT] Chrome Extension disconnected.\u0022, Color.Orange);            UpdateExtensionStatusLabel(false, 0);        }        private void Server_OnExtensionTabsUpdated(object? sender, ExtensionTabsEventArgs e)        {            if (InvokeRequired)            {                Invoke(new Action(() =\u003E Server_OnExtensionTabsUpdated(sender, e)));                return;            }            UpdateExtensionStatusLabel(true, e.Tabs.Count);            RefreshBrowserTabsListUi();        }        private void RefreshBrowserTabsListUi()        {            if (_server == 